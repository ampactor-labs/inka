#!/usr/bin/env bash
# Mentl pre-commit — the FAIL-CLOSED thesis gate at commit time.
#
# Claude Code's PostToolUse runs drift-audit during editing, but THIS hook
# survives any editor, any model, any future tooling change: it REFUSES the
# commit when the Mentl thesis is violated, instead of merely surfacing it.
# It is the strongest pre-L1 shadow of the kernel's own verifier (the kernel
# internalizes this enforcement BY CONSTRUCTION once first-light closes).
#
# Two gates fire:
#
#   1. tools/drift-audit.sh on staged .mn — every drift mode is a syntactic
#      tell of the Carried-Truth Law violated.
#
#   2. tools/verify.sh when any compiler source is staged (src/*.mn,
#      lib/**/*.mn) — the micro battery compiles-and-runs green + the
#      census (informational). Stamped: an unchanged tree answers from
#      verify's green stamp instantly. This makes it impossible to COMMIT
#      a state that breaks the medium.
#
# The L1 byte-identity check (mentl2.wat == mentl3.wat) is the milestone gate,
# observed via tools/state.sh / tools/determinism-gate.sh — not per-commit
# (it cannot pass until L1, and a full double-compile per commit is wasteful).
#
# Enable: bash tools/setup-git-hooks.sh   (git config core.hooksPath .githooks)
# Bypass: --no-verify is for non-source emergency fixes ONLY. Never bypass for
# .mn sources — these gates ARE the discipline CLAUDE.md establishes.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
AUDIT="$REPO_ROOT/tools/drift-audit.sh"
VERIFY="$REPO_ROOT/tools/verify.sh"

# Staged source: .mn anywhere.
mapfile -t staged_src < <(
    git diff --cached --name-only --diff-filter=ACMR \
      | grep -E '\.mn$' || true
)

# ─── Gate 1: drift-audit ─────────────────────────────────────────────
if [[ -x "$AUDIT" && ${#staged_src[@]} -gt 0 ]]; then
    abspaths=()
    for f in "${staged_src[@]}"; do [[ -f "$REPO_ROOT/$f" ]] && abspaths+=("$REPO_ROOT/$f"); done
    if [[ ${#abspaths[@]} -gt 0 ]]; then
        echo "pre-commit: drift-audit on ${#abspaths[@]} staged source file(s)..."
        if ! bash "$AUDIT" "${abspaths[@]}"; then
            echo ""
            echo "pre-commit: DRIFT detected — the commit is BLOCKED."
            echo "Every drift mode is the Carried-Truth Law violated (re-derive / discard /"
            echo "fabricate / cache what the graph proved). Rewrite in residue form. A true"
            echo "false-positive may be suppressed with a trailing '# drift-audit: ignore'"
            echo "(only after verifying it is NOT one of the nine drift modes in disguise)."
            exit 1
        fi
    fi
fi

# ─── Gate 2: comment truth (a comment IS a graph edge) ───────────────
# SYNTAX §Comments: a `//` comment is graph content — a CommentReason edge the Why
# engine walks. A comment citing a symbol that exists nowhere is a FALSE edge, the
# Carried-Truth Law at the prose layer. tools/comment-audit.sh finds them; this
# gate keeps a commit from ADDING one (it caught me twice on 2026-07-16/17 — a
# stale process_wasmtime reference, a deleted-symbol note). Ratcheted, not
# absolute: the tree carries 554 legacy phantoms, so blocking every commit until
# all 554 die would stop work; the ratchet blocks only a RISE. This is the
# future-proof form the discipline asks for — new prose cannot cite a ghost, and
# the backlog falls monotonically toward the deletion of this gate (at 0,
# comment-audit gates directly; both dissolve into `mentl audit`).
RATCHET="$REPO_ROOT/tools/comment-ratchet.sh"
if [[ -x "$RATCHET" && ${#staged_src[@]} -gt 0 ]]; then
    echo "pre-commit: comment truth (no NEW phantom symbol)..."
    if ! bash "$RATCHET"; then
        echo ""
        echo "pre-commit: A NEW PHANTOM — the commit is BLOCKED."
        echo "A comment cites a symbol that exists nowhere in code: a false CommentReason"
        echo "edge the Why engine will walk a reader into. Fix the comment (or restore the"
        echo "symbol). Offenders: bash tools/comment-audit.sh"
        exit 1
    fi
fi

# ─── Gate 3: the thesis gate (compiler source staged) ────────────────
has_compiler_change=false
for f in "${staged_src[@]}"; do
    if [[ "$f" == src/*.mn || "$f" == lib/*.mn || "$f" == lib/*/*.mn ]]; then
        has_compiler_change=true; break
    fi
done

if [[ "$has_compiler_change" == "true" && -x "$VERIFY" ]]; then
    echo "pre-commit: thesis gate (tools/verify.sh — micros + the census ratchet)..."
    if ! bash "$VERIFY"; then
        echo ""
        echo "pre-commit: THE MENTL-THESIS GATE FAILED — the commit is BLOCKED."
        echo "The medium broke or the first-light ratchet regressed. Fix it; do not bypass."
        exit 1
    fi
fi

exit 0
