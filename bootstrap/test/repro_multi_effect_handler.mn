effect A { opa(Int) -> Int }
effect B { opb(Int, Int) -> Int }
handler hab {
  opa(v) => resume(v),
  opb(a, b) => resume(b)
}
fn d2(x) = {
  let p = perform opa(x)
  perform opb(x, p)
}
fn d1(x) = d2(x)
fn main(y) = { d1(y) } ~> hab
// Repro/guard: ONE handler covering TWO effects (multi-effect HANDLER),
// performed Tier-2 (handler not lexical at the perform site). Differing
// arity (opa 1 arg, opb 2) makes a wrong arm-dispatch trap visibly.
// Pre-fix: resolve_handler_state_for_ename matched only the handler's
// single-effect Handler(eff) scheme tag, missing the 2nd effect → wrong
// evidence forwarded → type mismatch. Fixed by $handler_covers_ename
// reading the graph-derived per-effect arm-groups. Must compile AND run clean.
