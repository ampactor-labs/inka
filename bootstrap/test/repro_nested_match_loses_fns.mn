// Hβ.first-light.parser-nested-match-loses-fns
//
// Repro fixture: when a match-arm body is itself a match expression,
// the parser corrupts state and drops all subsequent top-level
// fn declarations from the AST.
//
// Empirical (commit 39c9b93):
//   `cat repro_nested_match_loses_fns.mn | wasmtime run bootstrap/mentl.wasm`
//   emits ONLY $maybe_lookup, $process, $_start.
//   $after_one, $main are SILENTLY LOST — never enter the AST.
//
// Diagnostic shape: src/lower.mn loses 36 of 64 user-fns through
// this same propagation path; the bloat-style residue from before
// commit 39c9b93 was the malformed-fn cascade through emit's
// fn-table-and-globals walk.
//
// The substrate gap: parse_match_arms_full at parser_pat.wat:369
// calls parse_expr for the arm body. When the body is itself a
// match expression, parse_match_expr is recursively invoked and
// returns position past the inner `}`. Back in the outer arm-loop,
// position should land at the optional comma, then the next outer
// arm. Empirically it does not — the outer parse_program's loop
// advances past the rest of the file.
//
// What the ULTIMATE MEDIUM does at this site: parse_match_arms_full
// is a structural recursion. Each invocation owns its brace-pair.
// Inner-match's TRBrace is consumed by the inner invocation; outer
// match continues at the position the inner returns. Productive-
// under-error per kernel primitive 8 if any branch fails.

type Outer = OuterA(Int) | OuterB
type Result = SomeRes(Int) | NoRes

fn maybe_lookup(n) = SomeRes(n)

fn process(p) = match p {
  OuterA(name) => match maybe_lookup(name) {
    SomeRes(t) => t,
    NoRes      => -1
  },
  OuterB => 0
}

fn after_one() = 1

fn main() = process(OuterA(5))
