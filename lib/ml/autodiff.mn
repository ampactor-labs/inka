// Autodiff via algebraic effects.
// The Compute effect captures forward-pass operations;
// the handler records them on a tape for backward pass.

import ml/tensor

// ── Tape entries ────────────────────────────────────────────

type TapeEntry =
    TapeMatVecMul { w: List, x: List, out: List }
  | TapeVecAdd { a: List, b: List }
  | TapeRelu { input: List }
  | TapeSigmoid { out: List }

// ── Compute effect ──────────────────────────────────────────
// Type annotations are nominal — the checker uses them for
// unification but the runtime passes actual lists/matrices.

effect Compute {
  forward_mat_vec_mul(w: List, x: List) -> List
  forward_vec_add(a: List, b: List) -> List
  forward_relu(xs: List) -> List
  forward_sigmoid(xs: List) -> List
  get_tape() -> List
}

// ── compute_tape — the forward handler ──────────────────────
// Each forward op COMPUTES the result (via tensor.mn) AND records a
// TapeEntry, then resumes the value. `get_tape` resumes the state. The
// tape is the growing handler state — the forward pass IS performing
// Compute; the backward pass (below) is the reverse fold over this tape.
//
// THE GENERATIVE LEAP (W25, autodiff-as-multishot): the tape entries are
// a hand-rolled re-derivation of what multi-shot ALREADY captures — each
// forward op's continuation IS the resumable point the backward pass
// re-enters. The unsurpassable form (peer Hβ.ml.autodiff-as-multishot)
// drops the explicit TapeEntry: a MultiShot Compute handler captures each
// forward continuation in the bump image (the unified record, B3), and
// backward = resuming those continuations in reverse with the upstream
// gradient. Because the continuations are contiguous handle-addressed
// records, a training checkpoint is one memcpy (persistable via `~> Persist`,
// W08) — surpassing JAX/PyTorch (host-language explicit tape, no persist).
// The TapeEntry form below is the REAL, runnable today; the multishot form
// is the same graph read at the TIME altitude, sequenced behind W07's
// continuation producer (the .mn names it, the leap is not a hedge — it is
// the deeper read of this exact handler once the producer lands).

handler compute_tape with tape = [] {
  forward_mat_vec_mul(w, x) => {
    let out = mat_vec_mul(w, x)
    resume(out) with tape = push(tape, TapeMatVecMul({w: w, x: x, out: out}))
  },
  forward_vec_add(a, b) => {
    let out = vec_add(a, b)
    resume(out) with tape = push(tape, TapeVecAdd({a: a, b: b}))
  },
  forward_relu(xs) => {
    let out = relu_vec(xs)
    resume(out) with tape = push(tape, TapeRelu({input: xs}))
  },
  forward_sigmoid(xs) => {
    let out = sigmoid_vec(xs)
    resume(out) with tape = push(tape, TapeSigmoid({out: out}))
  },
  get_tape() => resume(tape),
}

// ── Backward pass ───────────────────────────────────────────
// Walks the tape in reverse, accumulating gradients.
// Returns list of (dw, db) gradient pairs for weight layers.

fn relu_grad(input, upstream) = {
  zip_with((x, g) => if x > 0.0 { g } else { 0.0 }, input, upstream)
}

fn sigmoid_grad(out, upstream) = {
  zip_with((o, g) => g * o * (1.0 - o), out, upstream)
}

fn backward_step(upstream, grad_pairs, entry) = {
  match entry {
    TapeSigmoid({out}) =>
      (sigmoid_grad(out, upstream), grad_pairs),
    TapeRelu({input}) =>
      (relu_grad(input, upstream), grad_pairs),
    TapeVecAdd({a, b}) =>
      (upstream, grad_pairs),
    TapeMatVecMul({w, x, out}) =>
      (mat_vec_mul(transpose(w), upstream),
       push(grad_pairs, (outer_product(upstream, x), upstream))),
  }
}

fn backward(tape, loss_grad) = {
  let result = fold((loss_grad, []), (acc, entry) =>
    match acc {
      (upstream, grad_pairs) => backward_step(upstream, grad_pairs, entry)
    }, reverse(tape))
  match result {
    (final_grad, pairs) => pairs
  }
}

