// imap — the ONE indexed-map primitive (Hβ.runtime.indexed-map-primitive, §5.O).
//
// A str_hash-bucketed String→value map. Five perf waypoints hand-rolled this
// exact shape independently (env / summary / esc / base / reach); region_index
// is its handle-keyed sibling. The value is opaque, so one primitive serves
// them all: smap, the String-keyed map family. Miss → None, distinguishing "absent"
// from a present empty value (Some []).
//
// Byte-identical to the linear scans it replaces: build reverse-inserts and
// prepends, so the smallest original index sits at the bucket front and
// smap_get returns the SAME first-match the O(n) scan did. The `name: String`
// pins carry the content-equality (str_eq inside the small bucket) — a bare
// `==` on the list-erased word would floor to pointer-eq, the very bug the
// crown gate shed. A name is a HANDLE; this is where the six copies converge.
fn smap_new() with Memory + Alloc = list_filled(4096, [])

fn smap_build(pairs) with Memory + Alloc = smap_build_from(pairs, len(pairs) - 1, smap_new())

fn smap_build_from(pairs, i, idx) with Memory + Alloc = if i < 0 {
  idx
} else {
  match list_index(pairs, i) {
    (name, val) => smap_build_from(pairs, i - 1, smap_add(idx, name, val)),
  }
}

fn smap_add(idx, name: String, val) with Memory + Alloc = {
  let b = i32_and(str_hash(name), 4095)
  list_set(idx, b, [(name, val)] ++ list_index(idx, b))
}

fn smap_get(ref idx, name: String) with Memory + Alloc = {
  let b = i32_and(str_hash(name), 4095)
  smap_bucket_scan(list_index(idx, b), name, 0)
}

fn smap_bucket_scan(ref bucket, name: String, i) with Memory + Alloc = if i >= len(bucket) {
  None
} else {
  match list_index(bucket, i) {
    (bn, val) => if bn == name { Some(val) } else { smap_bucket_scan(bucket, name, i + 1) },
  }
}
