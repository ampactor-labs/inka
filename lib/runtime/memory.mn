// memory.mn — Memory and Alloc effect declarations
//
// These are Mentl's substrate effects. The emitter recognizes each
// operation by name and lowers it directly to a WASM instruction.
// No handler is written in Mentl for these — the WASM runtime IS
// the handler. But the declarations exist here so:
//
//   1. The type checker knows the signatures.
//   2. The developer can read what operations exist.
//   3. They participate in the graph like every other effect.
//   4. Effect rows are honest — `with Memory` means "this function
//      performs store/load/xor operations on linear memory."
//
// This is the single source of truth for substrate operations.
// If an operation isn't declared here, it doesn't exist.

// Memory — linear memory read/write. Operations on WASM's linear
// memory. Each maps to one instruction. The developer writes the
// intent; the substrate emits the opcode.
effect Memory {
  // 32-bit store/load — full i32 word at address
  store_i32(Int, Int) -> ()   // (addr, value)
  load_i32(Int) -> Int   // (addr) -> value

  // 8-bit store/load — single byte at address
  store_i8(Int, Int) -> ()   // (addr, byte)
  load_i8(Int) -> Int   // (addr) -> byte (0-255)

  // Bulk memory copy — src to dst, n bytes
  mem_copy(Int, Int, Int) -> ()   // (dst, src, n)

  // The live world — the top of the install chain ($world_g; emit projects
  // the global read, the heap_mark shape). 0 = the empty world. A Memory
  // read, not an Alloc verb: the perform path reads it on every dispatch.
  world_top() -> Int

  // 64-bit float store/load — the WIDE-value boundary pair (§5.U): a wide
  // value crosses the word altitude BY REFERENCE (its address is a word, a
  // handle IS a word); these two ops are the deref/ref that cash the native
  // width at a typed site. Project 1:1 to f64.load / f64.store.
  store_f64(Int, Float) -> ()   // (addr, value)
  load_f64(Int) -> Float   // (addr) -> value

  // Integer XOR — two i32 values, returns i32
  // Lowers to WASM's i32.xor. Not a bitwise operator in the
  // language — a substrate primitive. Used by hash functions.
  i32_xor(Int, Int) -> Int   // (a, b) -> a XOR b

  // The XOR's siblings — i32.or / i32.and / i32.shl, the same substrate
  // projection. i32_or is the union-homomorphic world-tag join (a composed
  // continuation's world = the OR of its frames' tags, band B); i32_and +
  // i32_shl serve the tag's bit projection and the value-gate's subset
  // test ((k & ~live) == 0 admits — the world-widening resume).
  i32_or(Int, Int) -> Int    // (a, b) -> a OR b
  i32_and(Int, Int) -> Int   // (a, b) -> a AND b
  i32_shl(Int, Int) -> Int   // (a, n) -> a << (n mod 32)
}

// Alloc — heap allocation. Bump allocator in WASM linear memory.
// alloc(n) advances the heap pointer by n bytes (8-byte aligned)
// and returns the old pointer. No free. No GC. Region-based
// lifetime via ownership effects.
//
// Alloc is separate from Memory because a function can read/write
// existing memory without allocating (with Memory + !Alloc), and
// this distinction is load-bearing for real-time audio paths where
// allocation is forbidden.
effect Alloc {
  alloc(Int) -> Int   // (size) -> ptr
  // The REGION verbs — the arena's first grain (§5.O layer 3). A batch
  // boundary (one micro's compile inside `mentl test`, one decl inside the
  // future per-decl arena) marks the bump pointer, does its work, and resets:
  // everything the region allocated is dead by construction at the boundary,
  // and determinism IMPROVES — each region starts at the same watermark
  // regardless of its predecessors. Reset to a mark you did not take (or
  // with live handles above it) is the caller's ownership obligation — the
  // same contract every region system carries.
  heap_mark() -> Int
  heap_reset(Int)   // rewinds AND zeroes [mark, bump): the post-reset world is
                    // bit-identical to the never-allocated world, so every
                    // zero-read (the Option-niche slot_present, unwritten
                    // make_list slots) stays true under reuse — virginity is
                    // the reset's CONTRACT, not monotonicity's accident
}

// Pure — the empty effect row. Pure is not an effect with operations
// — it IS the absence of effects. `with Pure` means "this function
// performs no effects."
//
// In the row algebra:
//   Pure = EfRow([], [], EtClosed)  — the empty closed triple
//
// The type checker special-cases `Pure` as syntactic sugar for the
// empty closed row. No declaration needed — it's a keyword, not
// an effect. Documented here for completeness.
//
// fn add(a, b) with Pure = a + b
//   → performs nothing; row is the empty closed triple; type checker enforces
//     that the body contains no perform statements.

// ─── ev_lookup — the FORWARD-side keyed-evidence scan ───────────────────
// The identity-addressed frame-region READ: a fn's captured_evs region
// (based at `base` in its __state record) holds [key][entry-ptr] pairs
// terminated by a key=0 sentinel; `target` is the effect's INTERNED name
// offset (string constants dedup — W5 — so the key the caller PLACED and
// the key the callee SEEKS are the SAME offset, an i32.eq match). A
// sibling effect appearing shuffles NO key — the cure for
// position-as-the-bug. This is the FORWARD side only (LEvRef building a
// callee's pair from this frame, and the __resume k-channel): a miss is
// ROUTINE — capture sets over-approximate (escaping_row), so a caller
// legitimately lacks keys its callee never fires; 0 means the pair is
// written unfilled, tolerant by design. The PERFORM side no longer reads
// any frame region — it walks the live world chain (ev_perform_entry
// below, the world-as-value arc's R2; the miss-traps-loudly contract from
// the 2026-07-03 garbage-dispatch measurement carries over there).
fn ev_lookup(state, base, target) with Memory = ev_scan(state, base, target, 0)

fn ev_scan(state, base, target, j) with Memory = {
  let key = load_i32(state + base + 8 * j)
  if key == target { load_i32(state + base + 8 * j + 4) }
  else if key == 0 { 0 }
  else { ev_scan(state, base, target, j + 1) }
}

// The PERFORM-side read is the WORLD walk (the world-as-value arc's R2):
// the live install chain — [key@0][entry@4][parent@8][install_world@12]
// nodes consed by every install's $world_push — is walked from world_top()
// by interned-key i32.eq, and the perform dispatches through the FOUND
// NODE: node.entry is the same [record][base] view the install built;
// node.install_world is the world OUTSIDE that install, which the dispatch
// sets around the arm call (the deep-handler law, delivered dynamically —
// an arm's own performs resolve outer, never self). A computation
// therefore performs in the world where it is CALLED, not the world where
// its closure was minted — the mint-time evidence snapshot was a cache of
// this dynamic fact. ev_lookup/ev_scan above remain the FORWARD-side
// frame-region readers (LEvRef pair-building, the __resume k-channel);
// their miss is routine (capture sets over-approximate, an unfilled pair
// is legal). A perform miss is a BROKEN PROMISE and traps here, key in
// hand: the sought key's interned offset goes to scratch word 0 (the
// postmortem window), then a deterministic out-of-bounds load traps — the
// backtrace names the perform site, the scratch word the effect.
fn world_find_from(n, target) with Memory = {
  if n == 0 { 0 }
  else if load_i32(n) == target { n }
  else { world_find_from(load_i32(n + 8), target) }
}

// `top` arrives as an ARGUMENT — the perform site's emit passes
// (global.get $world_g) inline, so this source performs no world_top op
// (under the PRIOR pin's gate a new substrate op would floor as an
// unhandled Memory demand — the crossing constraint; world_top stays
// declared for wheel-source consumers once the pin carries its
// recognition).
fn ev_perform_node(top, target) with Memory = {
  let node = world_find_from(top, target)
  if node == 0 {
    store_i32(0, target)
    // 0 - 1 = 0xFFFFFFFF: a 4-byte load crossing 2^32 — out of bounds at
    // ANY wasm32 memory size, including the full 65536 pages. The prior
    // `0 - 8` went SILENT when memory grew to 4GB (2fc7544): 0xFFFFFFF8+4
    // is in bounds there, so a miss returned virgin 0 and the broken
    // promise cascaded to a garbage dispatch far from this site.
    load_i32(0 - 1)
  }
  else { node }
}

// The PRIOR generation's perform-side read — the frame-region scan the
// pinned boot's emitted call sites still name (m2 = boot(wheel) carries
// them). The new emit calls ev_perform_node; once the pin crosses, this
// fn has zero callers and reach prunes it from every emitted module —
// its deletion from source is the arc's write-side cleanup rung.
fn ev_perform_entry(state, base, target) with Memory = {
  let entry = ev_lookup(state, base, target)
  if entry == 0 {
    store_i32(0, target)
    store_i32(4, base)
    load_i32(0 - 1)
  }
  else { entry }
}
