// threading.mn — Thread + SharedMemory effects + parallel_compose handler (B.7 / TH)
//
// Per TH walkthrough §1: threading is an effect. Mentl has no
// thread keyword, no concurrent-runtime layer, no special syntax.
// `Thread` declares spawn/join; `SharedMemory` declares atomics;
// the `parallel_compose` handler intercepts BOTH `><` and `<|`
// branches and dispatches them to OS threads. Per SUBSTRATE.md
// §"`<|` vs `><`: Ownership Is the Structural Difference" the
// two verbs are both parallelism; the structural difference is
// input ownership (`<|` ref-borrows shared; `><` own-consumes
// independent), not serial-vs-parallel. Both lower as spawn/join
// per branch; same handler dispatches both.
//
// Per INSIGHTS L1346 ("Handler IS the Backend"): there are no
// backends, only handlers. The threading "library" is two effects
// + one handler over the existing `><` topology. Same source —
// single-threaded baseline OR multi-core scale-out — depending only
// on the `~>` chain.
//
// Per Q-B.7.1 (runtime SharedArrayBuffer detection; graceful
// sequential fallback) + Q-B.7.2 (OS threads direct for v1; pool_
// compose is peer handler post-first-light) + Q-B.7.3 (`><`
// output order preserved regardless of completion order — load-
// bearing for determinism).
//
// Composition with the multi-shot quartet:
// - parallel_compose × race (HC2 §7.3): forks GENUINELY execute
//   across cores when both installed; race's tiebreak preserves
//   determinism per Q-B.7.3.
// - parallel_compose × Choice (B.3 CE): backtrack's per-option
//   exploration could parallelize across threads when this handler
//   installed.
// - parallel_compose × arena_ms (B.5 AM): per-thread bump_allocator
//   is the substrate; replay_safe / fork_deny / fork_copy compose
//   with thread-local arenas.
//
// Authority:
// - TH-threading.md walkthrough §1.1 (Thread effect), §1.2
//   (SharedMemory + RmwOp), §1.3 (parallel_compose handler)
// - QA Q-B.7.1 + Q-B.7.2 + Q-B.7.3
// - HC2 §7.3 (race × parallel_compose composition)
// - lib/runtime/combinators.mn (commit 3da8d79 — race composes here)
// - INSIGHTS §"The Handler IS the Backend" L1346

import types

// Handle — opaque thread/task identity. Handler-held; consumers
// don't decode the Int. Per primitive #5 ownership: each Handle
// is `own` to the spawn site; passed `ref` to join.

type Handle = Handle(Int)

// Thread — the spawn/join/identity effect. spawn launches a
// task as a separate OS thread; join joins. current_id returns
// the running thread's id; num_cores returns runtime CPU count
// for tuning parallelism degree.
//
// Per primitive #2: both spawn and join are OneShot. Multi-shot
// would imply forking the continuation across multiple resumes —
// a different topology (race per HC2), not Thread.

effect Thread {
  spawn(task: () -> A) -> Handle
  thread_join(handle: Handle) -> A
  current_id() -> Int
  num_cores() -> Int
}

// SharedMemory — atomics + wait/notify. Separate effect so
// `!SharedMemory` proves single-threaded-memory (can still call
// spawn via Thread; tracks' local memory is unshared). `Pure +
// !SharedMemory` is the strictest parallelizable-no-sync contract.
//
// Per Q-B.7.1: runtime SharedArrayBuffer detection; graceful
// sequential fallback when SAB unavailable in browser context.

effect SharedMemory {
  atomic_load_i32(addr: Int) -> Int
  atomic_store_i32(addr: Int, val: Int) -> ()
  atomic_rmw(addr: Int, op: RmwOp, val: Int) -> Int
  wait_i32(addr: Int, expected: Int, timeout_ns: Int) -> WaitResult
  notify(addr: Int, count: Int) -> Int
  fence() -> ()
}

// RmwOp — read-modify-write opcodes per WASM atomic instructions.
// ADT not strings (drift mode 3 — Python-dict effect-name-set).
// WASM's atomic.rmw.<op>.<type> opcodes map from this ADT in
// emission.

type RmwOp
  = RmwAdd
  | RmwSub
  | RmwAnd
  | RmwOr
  | RmwXor
  | RmwXchg
  | RmwCmpxchg

// WaitResult — outcome of wait_i32. WOk = notified; WTimedOut =
// timeout fired; WNotEqual = expected mismatch at wait time. ADT
// for H6 exhaustive matching downstream.

type WaitResult
  = WOk
  | WTimedOut
  | WNotEqual

// parallel_compose — the `><` multi-core semantics handler. When
// installed, intercepts spawn/join effects from `><` branches and
// dispatches them to distinct OS threads via ffi_spawn / ffi_join.
// Per Q-B.7.3, output tuple order is preserved regardless of
// completion order — multi-core determinism by construction.
//
// Per drift mode 7 + kernel crystallization #9 (Records-Are-Handler-
// State-Shape): threads is [Handle], NOT ([Int],
// [ThreadState]) parallel arrays.

handler parallel_compose with threads = [] {
  spawn(task) => {
    let handle = ffi_spawn(task)
    resume(handle) with threads = push(threads, handle)
  },

  thread_join(handle) => resume(ffi_join(handle)),

  current_id() => resume(ffi_current_thread_id()),

  num_cores() => resume(ffi_num_cores())
}

// sequential_compose — fallback handler when SharedArrayBuffer
// isn't available (browser without cross-origin isolation, etc.).
// spawn runs the task synchronously; join is a no-op (the result
// is already computed). Per Q-B.7.1 graceful degradation.

handler sequential_compose with results = [] {
  spawn(task) => {
    let result = task()  // drift-audit: ignore — task() is effectful; result feeds the with-clause's push, not chain-position
    let handle = Handle(len(results))
    resume(handle) with results = push(results, result)
  },

  thread_join(handle) => {
    let Handle(idx) = handle
    resume(list_index(results, idx))
  },

  current_id() => resume(0),

  num_cores() => resume(1)
}

// ─── parallel_map — runtime-list parallel fold via `><` ─────────────
//
// The N-arity primitive that pair-forms (compile_pair_modules,
// format_pair, teach_pair, cursor_pair_at) accreted around the absence
// of. Per `feedback_fully_as_early.md`: binary pair-forms ARE the tell
// that an N-arity peer is missing; this IS that peer.
//
// Per Layer 3 framing (cursor IS the scheduler): parallelism IS handler
// interpretation of continuation-capture (kernel primitive #2). `><` IS
// the multi-cont OneShot fork at the kernel layer; parallel_map IS the
// runtime-list fold via binary `><`; `parallel_compose` interprets the
// forks SPATIALLY (across cores), `sequential_compose` interprets them
// TEMPORALLY. Same source — handler swap.
//
// Per CLAUDE.md ⌁ eight interrogations:
//   Graph?     recursive list-fold → LMatch + LCall(spawn/join) + LCons
//   Handler?   parallel_compose (or sequential_compose) installed upstream
//   Verb?      `><` is the binary step of the fold; `|>` is chain glue
//   Row?       Thread + (caller's row); HM widens at instantiation
//   Ownership? each list element consumed (`own`); list itself ref-borrowed
//   Refinement? length-preserving — peer follow-up (post-L1)
//   Gradient?  unlocks "sequential map → parallel_map for free" suggestion
//   Reason?    each spawn leaves Reason::ParallelComposeSpawn(branch_idx)
//
// Drift refused: 1 (no thread-pool / scheduler object — `><` IS the
// fanout); 6 (uniform N=0 to ∞; pair-forms collapse to
// `parallel_map(f, [a, b])`); 9 (no "sequential fallback for now" —
// sequential_compose is a peer HANDLER, not a deferred mode).
//
// Peer follow-ups (positive-form, structurally orthogonal):
// - Hβ.runtime.wasi-thread-spawn-seed — bootstrap/src/* substrate
//   importing wasi_thread_spawn + per-thread bump arena partition.
//   Without it, parallel_compose runs single-threaded via the
//   intrinsics below; with it, OS threads pin all cores cargo-style.
// - Hβ.driver.level-set-par-walk — Kahn-style topological levels in
//   src/driver.mn; modules in same level parallel_map; cross-level
//   sequential gates dep-installation.
// - Hβ.cursor.speculative-compile — Axis 2 multi-shot dispatched
//   spatially: Synth's MultiShot proposer captures cursor at "what
//   type for this hole?"; per-candidate compile on different cores;
//   results bubble back as gradient suggestions with full Reason chains.
// - Hβ.cursor.work-stealing-via-gradient — when N cores finish their
//   handles and ask "what next?", the cursor's gradient returns
//   argmax. The gradient IS the priority queue; no scheduler module.

fn parallel_map(f, xs) with Thread = {
  if len(xs) == 0 { [] }
  else {
    let h = list_head(xs)
    let t = list_tail(xs)
    let (head_result, tail_results) =
      (f(h))
          ><
      (parallel_map(f, t))
    [head_result] ++ tail_results
  }
}

// ─── FFI surface ────────────────────────────────────────────────────
//
// wasi-threads provides thread-spawn(start_arg) -> tid as the only
// import. join is synthesized over SharedMemory: each spawned thread
// sets a "done" flag in its thread-record slot before exit; ffi_join
// atomic-waits on that flag then reads the result. current_id reads
// from the thread-record slot the spawned thread loaded as start_arg;
// num_cores reads from a runtime-provided memory location populated
// at module-init.

// WasiThreads — Stage 3 collapsed substrate. The CLOSURE IS the
// thread record; no separate thread_record_* ops. wasi_thread_spawn
// receives the closure pointer; the host's $thread_start entry
// reads fn_idx from closure[0] and call_indirects. wasi_num_cores
// reports host CPU count for parallel-degree tuning. Per the
// realize: ONE record, FOUR roles, four-and-a-half — no parallel
// thread-record table.
effect WasiThreads {
  wasi_thread_spawn(Int) -> Int
  wasi_num_cores() -> Int
}

// ffi_spawn — Stage 3 substrate: the CLOSURE IS the thread record.
// Per the realize protocol's collapse: spawnable closures carry
// done/result fields after captures+ev_slots. The host's
// wasi_thread_spawn receives the closure pointer as start_arg;
// $thread_start (exported by the wheel-emit module) reads fn_idx
// from closure[0], call_indirect with closure-as-__state, stores
// result at closure[done_offset+4], atomic.store done=1 at
// closure[done_offset], atomic.notify on done addr. NO separate
// thread-record table, NO next_tid counter, NO partition arithmetic.
// One record, four roles, four-and-a-half (closure + thread context).
// Per protocol_handler_is_state_is_closure_is_evidence.md.
fn ffi_spawn(ref task) with WasiThreads = {
  let closure_ptr = closure_pointer(task)
  // The closure already exists in the heap (LMakeClosure emitted it).
  // wasi_thread_spawn(closure_ptr) gives the host the closure pointer;
  // host invokes $thread_start(closure_ptr) on a fresh OS thread.
  Handle(wasi_thread_spawn(closure_ptr))
}

fn ffi_join(handle) with WasiThreads + SharedMemory = {
  let Handle(closure_ptr) = handle
  // done_offset is layout-dependent: closure has 8 bytes header
  // (fn_idx + capture_count) + 4 * (captures+ev_slots) bytes; the
  // done_flag sits at the first slot past the captures region. Per
  // emit_module.wat layout for spawnable closures (peer-extension).
  // done addr projection: closure_done_addr reads the layout.
  let done_addr = closure_done_addr(closure_ptr)
  wait_i32(done_addr, 0, max_join_timeout())
  atomic_load_i32(closure_result_addr(closure_ptr))
}

// Compute done flag's absolute address in the closure record.
// Layout: [fn_idx@0][capture_count@4][captures@8..(8+4*nc)][done@8+4*nc]
fn closure_done_addr(closure_ptr) with Memory = {
  let nc = load_i32(closure_ptr + 4)
  closure_ptr + 8 + 4 * nc
}

// Result slot sits at done+4.
fn closure_result_addr(closure_ptr) with Memory = {
  closure_done_addr(closure_ptr) + 4
}

// Current thread identity — within Mentl, the closure-IS-state
// substrate makes "current thread" identical to "current closure
// __state pointer". For Thread-effect callers that want an Int tid,
// we project the start-arg the host passed when invoking $thread_start
// (which equals the closure pointer — the thread's own state).
fn ffi_current_thread_id() with WasiThreads = 0

fn ffi_num_cores() with WasiThreads = wasi_num_cores()

fn closure_pointer(ref task) with Pure = closure_pointer_intrinsic(task)

fn closure_pointer_intrinsic(ref task) with Pure = 0

fn max_join_timeout() with Pure = 1000000000

// ─── wasi_threads — handler for the WasiThreads effect ────────────────
//
// Each arm performs an intrinsic and resumes; no state. Runtime
// intrinsics come from the seed-side substrate per
// `Hβ.runtime.wasi-thread-spawn-seed` (positive-form named peer):
// bootstrap/src/* imports `wasi_thread_spawn` from the WASI threads
// runtime + partitions per-thread bump arenas + lowers thread-record
// allocation. Until that peer cascade lands, the intrinsics return
// single-thread sentinels; parallel_compose dispatches via these
// intrinsics and degrades to sequential-equivalent runtime behavior.
// Same handler, swap-via-substrate-cascade — the wheel describes
// parallel without depending on the seed.
//
// Per `protocol_parallelism_symmetry.md`: parallel_compose's ffi_spawn
// performs WasiThreads ops; without wasi_threads installed in the
// chain, the row stays open (E_HandlerUninstallable). Both handlers
// install together in main's `~>` chain.
//
// Drift refused: 1 (no thread-pool object); 6 (one handler covers all
// WasiThreads ops uniformly).

handler wasi_threads {
  wasi_thread_spawn(closure_ptr)   => resume(wasi_thread_spawn_intrinsic(closure_ptr)),
  wasi_num_cores()                 => resume(wasi_num_cores_intrinsic())
}

// Sentinel intrinsics — Stage 3 of `Hβ.runtime.wasi-thread-spawn-seed`
// (per protocol_bootstrap_wasi_threads_substrate.md) bridges
// wasi_thread_spawn_intrinsic to the WASM-level $wasi_thread_spawn
// import via emit-side recognition. Sentinel return keeps the
// parallel_compose handler's ffi_spawn / ffi_join runtime-correct
// under sequential dispatch (closure_ptr passes through as the Handle
// payload; ffi_join's atomic-wait on closure_done_addr returns
// immediately because no thread ever writes done=1 — single-thread
// degraded mode produces correct results because each parallel branch
// runs to completion in the spawn site's stack-frame). Same source,
// handler swap.
fn wasi_thread_spawn_intrinsic(start_arg)        with Pure = start_arg
// Legacy intrinsics retained for graceful-degrade only. The closure-
// IS-thread-record substrate (Stage 2) elides the separate thread-
// record table; these are now historical artifacts the wasi_threads
// handler no longer exposes via effect ops.
fn thread_record_alloc_intrinsic(closure_ptr)    with Pure = 0
fn thread_record_pack_task_intrinsic(slot, ptr)  with Pure = ()
fn thread_record_done_addr_intrinsic(tid)        with Pure = 0
fn thread_record_result_addr_intrinsic(tid)      with Pure = 0
fn thread_record_self_id_intrinsic()             with Pure = 0
fn wasi_num_cores_intrinsic()                    with Pure = 1

// ─── Connection to the kernel ─────────────────────────────────────────

// Primitive #1 (Graph + Env) — Thread + SharedMemory effects
// register in the effect catalog (per src/types.mn EffName).
//
// Primitive #2 (Handlers + resume discipline) — parallel_compose +
// sequential_compose are peer handlers; both are OneShot per the
// Thread effect's resume discipline. Per Q-B.7.2: OS threads
// direct for v1; pool_compose is peer handler post-first-light.
//
// Primitive #3 (Five verbs) — `><` AND `<|` are the parallel
// topologies (SUBSTRATE.md §"`<|` vs `><`: Ownership Is the
// Structural Difference"); parallel_compose is the handler that
// gives BOTH verbs multi-core semantics. Same source — single-
// threaded baseline OR multi-core scale-out — depending only
// on the installed handler. The two glyphs are ONE PFanout verb,
// discriminated by input ownership (`<|` = FanShare, ref-borrowed
// shared; `><` = FanDistribute, own-consumed independent), not a
// dispatch story. The Schedule (Seq default / Thread / Simd / Gpu)
// is read LIVE from the `~>` chain at lower; with this Thread
// handler installed, `lower_fanout` projects spawn-all-then-join-
// all over the strategy-neutral branch thunks in source order.
//
// Primitive #4 (Effect row algebra) — `Thread + !SharedMemory` for
// isolated tracks; `SharedMemory` for atomic-sync ops. `!Thread`
// proves single-threaded; `Pure + !SharedMemory` proves
// parallelizable-no-sync (the strictest contract).
//
// Primitive #5 (Ownership) — thread-local bump_allocator per spawn
// (TH §3); cross-thread data via Pack/Unpack bytes only (TH §4 —
// no shared mutable memory between threads except via SharedMemory's
// atomics + per-Handle ownership). Per kernel crystallization #8 —
// the heap has one story; per-thread heaps each go through
// emit_alloc with thread-local bump_ptr.
//
// Primitive #6 (Refinement) — could refine `Handle where 0 <= self
// < num_cores()` post-first-light; V1 leaves Handle opaque.
//
// Primitive #7 (Annotation gradient) — `~> parallel_compose`
// unlocks CParallelize capability; Mentl Teach surfaces when
// cursor's body has `><` and `parallel_compose` not yet installed.
//
// Primitive #8 (Reasons) — each spawn records
// Reason::ThreadSpawned(span); thread identity traceable through
// the Reason chain. Per Q-B.7.3 determinism: same source + same
// inputs → same outputs regardless of timing; Reason chains
// preserve "why this thread won the race?" for Why Engine.

// ─── What this substrate refuses ──────────────────────────────────────

// - Special concurrency keywords. Mentl has no language-level
//   keyword for spawning, joining, or yielding to other threads;
//   threading IS the effect; handlers compose. Per drift mode 24 —
//   concurrent execution is an effect, not a keyword.
// - Class-based threads (drift mode 21 — OOP / Python class).
//   Thread is an effect; Handle is an opaque ADT; no `class
//   Thread { ... }`.
// - Shared-mutable-state-by-default (Rust's Send/Sync trait reach,
//   Java's synchronized). SharedMemory is OPT-IN via row;
//   `!SharedMemory` is single-threaded-memory PROOF.
// - Hardcoded thread count. parallel_compose's degree comes from
//   num_cores() at install time; sequential_compose's degree is 1.
// - String-keyed RmwOp dispatch (drift mode 3). ADT-discriminated
//   per primitive #4 row algebra discipline.
// - Per-thread state via parallel arrays (drift mode 7). threads
//   is [Handle]; per-Handle state lives in the runtime's
//   thread-local-storage substrate (per TH §3).
// - Foreign-language drift — NOT Goroutines (Go's syntax-level
//   construct); NOT Java's synchronized; NOT Python's threading.
//   Threading in Mentl IS Thread + SharedMemory effects + the
//   parallel_compose handler over `><` topology.
