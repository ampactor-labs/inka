// Lux Test Framework — Testing IS a Handler Swap
//
// From DESIGN.md: "Testing Without a Framework — Effects make
// traditional testing frameworks obsolete."
//
// check() is an effect. The handler decides what happens.
// Same test code → test handler (pass/fail) → benchmark handler
// (timing) → property handler (random inputs).

// ─── The Test Effect ─────────────────────────────────────────

effect Test {
  check(condition: Bool, msg: String) -> ()
  get_results() -> (Int, Int)
}

// ─── Convenience ─────────────────────────────────────────────

fn expect_eq(actual, expected) = {
  check(actual == expected,
    "expected " ++ to_string(expected) ++ " got " ++ to_string(actual))
}

fn expect_ne(actual, expected) = {
  check(actual != expected,
    "expected not " ++ to_string(expected))
}

fn expect_true(value) = {
  check(value, "expected true")
}

fn expect_false(value) = {
  check(!value, "expected false")
}

// ─── run_tests: compact output ───────────────────────────────

fn run_tests(tests) = {
  // Each test is independent — its assertion counts compose by fold-sum
  // and its failure messages have no order dependency; map's tail loop
  // runs them, per-test (passed, failed) tuples accumulate via fold.
  // Cargo-class test parallelism is a `><` fanout under its own
  // `~> Thread` at this site (Hβ.lower.schedule-specialized-callee);
  // per-test output buffering rides peer Hβ.test.per-test-output-buffer
  // (a wat_to_string-style per-thread println buffer for a sequential
  // surface).
  let results = map((test) => {
    let (name, test_fn) = test
    handle {
      test_fn()
      get_results()
    } with counts = (0, 0) {
      check(cond, msg) => {
        let (passed, failed) = counts
        if cond {
          resume() with counts = (passed + 1, failed)
        } else {
          println("  FAIL [" ++ name ++ "]: " ++ msg)
          resume() with counts = (passed, failed + 1)
        }
      },
      get_results() => resume(counts),
    }
  }, tests)
  let totals = fold((0, 0), (acc, r) => {
    let (tp, tf) = acc
    let (p, f) = r
    (tp + p, tf + f)
  }, results)
  let (passed, failed) = totals
  let total = passed + failed
  if failed == 0 {
    println("✓ " ++ to_string(total) ++ " passed")
  } else {
    println("✗ " ++ to_string(passed) ++ "/" ++ to_string(total) ++ " passed")
  }
  totals
}

// ─── run_suite: verbose ✓/✗ per assertion ────────────────────

fn run_suite(tests) = {
  let totals = fold((0, 0), (acc, test) => {
    let (name, test_fn) = test
    println("── " ++ name ++ " ──")
    let (p, f) = handle {
      test_fn()
      get_results()
    } with counts = (0, 0) {
      check(cond, msg) => {
        let (passed, failed) = counts
        if cond {
          println("  ✓ " ++ msg)
          resume() with counts = (passed + 1, failed)
        } else {
          println("  ✗ " ++ msg)
          resume() with counts = (passed, failed + 1)
        }
      },
      get_results() => resume(counts),
    }
    let (tp, tf) = acc
    (tp + p, tf + f)
  }, tests)
  let (passed, failed) = totals
  let total = passed + failed
  if failed == 0 {
    println("✓ " ++ to_string(total) ++ " passed")
  } else {
    println("✗ " ++ to_string(passed) ++ "/" ++ to_string(total) ++ " passed")
  }
  totals
}
