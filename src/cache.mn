// cache.mn — incremental compilation cache (IC.1b — graph-native)
//
// Per-module .kai files in <project>/.mentl/cache/. Each file records
// the source hash that produced this cache entry plus the module's
// public env (the "envelope"); the driver compares hashes to decide
// cache hit vs miss, and on hit loads the env to skip re-inference.
//
// IC.1b: Binary persistence through Pack / Unpack effects. The graph
// projects itself — no text parsing, no split(), no string assembly.
// Every Ty variant gets a tag byte; the handler accumulates the bytes.
// Mentl solving Mentl: the substrate persists itself.
//
// Walkthrough: docs/specs/simulations/IC-incremental-compilation.md.

import types
import runtime/strings
import runtime/binary
import runtime/io

/// Per-module cache record. Fields sorted alphabetically (post-H2
/// parser invariant). Adding fields is additive — version mismatch
/// causes the cache entry to be treated as a miss and rebuilt.
///
/// - `compiler_version` — bumps when the binary format changes.
/// - `exported_entries` — `List<(String, Scheme, Reason, SchemeKind)>`.
/// - `imports` / `imports_hashes` — transitive dep paths + their hashes.
/// - `module_name` — qualified module path.
/// - `source_hash` — FNV-1a 32-bit hash of the source bytes.
type KaiFile = {
  compiler_version: Int,
  exported_entries: List,
  imports: List,
  imports_hashes: List,
  module_name: String,
  source_hash: Int
}

// Bumps when serialize/deserialize format changes. Old .kai files
// with mismatching version are treated as misses.
//   v1 — IC.1a header-only (text)
//   v2 — IC.1b full env serialization (text)
//   v3 — IC.2 binary Pack/Unpack
//   v4 — H7 LMakeContinuation variant added to LowExpr
//   v5 — B.9 LFeedback emit completed (load-prior + state-globals
//        prologue; cache invalidates because emitted WAT shape
//        differs at every LFeedback site)
//   v6 — SchemeKind canonicalization: CapabilityScheme(List) variant
//        added (env entries for `capability` decls round-trip through
//        Pack/Unpack with new tag byte 4)
//   v7 — EffectDeclKind(List) added: effect→ops mapping carried in
//        the graph as a first-class SchemeKind (tag byte 5)
//   v8 — TRefined serializes its Predicate (placeholder retired);
//        Reason/Predicate/PExpr/Span/BinOp serializers added — the
//        Why chain persists with the value (handler IS evidence)
fn cache_compiler_version() with Pure = 8

/// 32-bit FNV-1a hash of the source bytes. Non-cryptographic;
/// collision resistance is sufficient for cache invalidation.
fn hash_source(s) with Memory = {
  let n = byte_len(s)
  cache_hash_loop(s, 0, n, 2166136261)
}

fn cache_hash_loop(s, i, n, h) with Memory = {
  if i >= n { h }
  else {
    let b = byte_at(s, i)
    // XOR via Memory scratch — no ^ operator in SYNTAX.md.
    let xored = i32_xor(h, b)
    let mixed = xored * 16777619
    cache_hash_loop(s, i + 1, n, mixed)
  }
}

// XOR two integers. perform i32_xor(a, b) is a Memory-level
// intrinsic — the emitter recognizes it by name and lowers
// directly to WASM's `i32.xor` instruction. Same pattern as
// store_i32, load_i8, alloc, mem_copy: the developer writes
// the intent, the substrate emits the instruction.
//
// No bitwise operator in the language. No 64-op arithmetic
// decomposition. One perform, one WASM instruction.
fn i32_xor(a, b) with Memory = {
  perform i32_xor(a, b)
}

// Cache path conventions — all files under `.mentl/cache/`.
// Slash-flattened: `compiler/infer.mn` → `.mentl/cache/compiler__infer.mn.kai`.

fn cache_dir() with Pure = ".mentl/cache"

fn cache_path_for(module_name) = {
  cache_dir()
    |> str_concat("/")
    |> str_concat(cache_flatten(module_name))
    |> str_concat(".kai")
}

// Replace `/` with `__` so cache filenames stay flat.
fn cache_flatten(module_name) = {
  cache_flatten_loop(module_name, 0, byte_len(module_name), "")
}

fn cache_flatten_loop(s, i, n, acc) with Memory + Alloc = {
  if i >= n { acc }
  else {
    let b = byte_at(s, i)
    let segment = if b == 47 { "__" }     // '/' → '__'
                  else { str_of_single_byte(b) }
    cache_flatten_loop(s, i + 1, n, str_concat(acc, segment))
  }
}

// Binary serialization — Pack direction. Tag bytes per variant,
// exhaustive match, no text assembly.

// Magic bytes: "IKAI" (0x49, 0x4B, 0x41, 0x49) — Mentl KAI binary.
fn cache_pack_magic() with Pack + !Unpack = {
  perform pack_byte(73)    // 'I'
  perform pack_byte(75)    // 'K'
  perform pack_byte(65)    // 'A'
  perform pack_byte(73)    // 'I'
}

fn cache_pack(kai) with Pack + !Unpack = {
  cache_pack_magic()
  perform pack_i32(kai.compiler_version)
  perform pack_str(kai.module_name)
  perform pack_i32(kai.source_hash)
  // Imports
  perform pack_i32(len(kai.imports))
  cache_pack_string_list(kai.imports, 0, len(kai.imports))
  // Import hashes
  perform pack_i32(len(kai.imports_hashes))
  cache_pack_int_list(kai.imports_hashes, 0, len(kai.imports_hashes))
  // Entries
  perform pack_i32(len(kai.exported_entries))
  cache_pack_entries(kai.exported_entries, 0, len(kai.exported_entries))
}

fn cache_pack_string_list(lst, i, n) with Pack + !Unpack = {
  if i >= n { () }
  else {
    perform pack_str(list_index(lst, i))
    cache_pack_string_list(lst, i + 1, n)
  }
}

fn cache_pack_int_list(lst, i, n) with Pack + !Unpack = {
  if i >= n { () }
  else {
    perform pack_i32(list_index(lst, i))
    cache_pack_int_list(lst, i + 1, n)
  }
}

fn cache_pack_entries(entries, i, n) with Pack + !Unpack = {
  if i >= n { () }
  else {
    let (name, scheme, _reason, kind) = list_index(entries, i)
    perform pack_str(name)
    cache_pack_scheme(scheme)
    cache_pack_kind(kind)
    cache_pack_entries(entries, i + 1, n)
  }
}

fn cache_pack_scheme(scheme) with Pack + !Unpack = {
  let Forall(handles, ty) = scheme
  perform pack_i32(len(handles))
  cache_pack_int_list(handles, 0, len(handles))
  cache_pack_ty(ty)
}

// SchemeKind tags: 0=FnScheme, 1=ConstructorScheme, 2=EffectOpScheme,
//                  3=RecordSchemeKind, 4=CapabilityScheme,
//                  5=EffectDeclKind
fn cache_pack_kind(kind) with Pack + !Unpack = match kind {
  FnScheme => perform pack_byte(0),
  ConstructorScheme(tag, total) => {
    perform pack_byte(1)
    perform pack_i32(tag)
    perform pack_i32(total)
  },
  EffectOpScheme(effect_name) => {
    perform pack_byte(2)
    perform pack_str(effect_name)
  },
  RecordSchemeKind(fields) => {
    perform pack_byte(3)
    perform pack_i32(len(fields))
    cache_pack_fields(fields, 0, len(fields))
  },
  CapabilityScheme(eff_pairs) => {
    perform pack_byte(4)
    perform pack_i32(len(eff_pairs))
    cache_pack_eff_pairs(eff_pairs, 0, len(eff_pairs))
  },
  EffectDeclKind(op_names) => {
    perform pack_byte(5)
    perform pack_i32(len(op_names))
    cache_pack_string_list(op_names, 0, len(op_names))
  },
  // HandlerKind(handled_ename, residual_row_handle, config, state, arms). The
  // row handle is graph-relative; cross-compile handler-residual caching packs
  // the RESOLVED row (peer Hβ.cache.handler-residual-row, post-L1). The single-
  // file first-light path never round-trips this, so the raw handle is sound
  // here; config/state/arms are live-only (see below).
  HandlerKind(ename, row_handle, _, _, _) => {
    perform pack_byte(6)
    perform pack_str(ename)
    perform pack_i32(row_handle)
    // config/state/arms are live-only references to the decl (the env names the
    // node); not serialized — cross-file caching reconstructs them from source
    // (peer Hβ.cache.handler-decl-from-source, post-L1). First-light is single-
    // file and never round-trips this.
  }
}

// Ty tags: 0=TInt, 1=TFloat, 2=TString, 3=TUnit, 4=TList, 5=TTuple,
//          6=TFun, 7=TVar, 8=TName, 9=TRecord, 10=TRecordOpen,
//          11=TRefined, 12=TCont
fn cache_pack_ty(ty) with Pack + !Unpack = match ty {
  TInt    => perform pack_byte(0),
  TFloat  => perform pack_byte(1),
  TString => perform pack_byte(2),
  TUnit   => perform pack_byte(3),
  TList(elem) => {
    perform pack_byte(4)
    cache_pack_ty(elem)
  },
  TTuple(elems) => {
    perform pack_byte(5)
    perform pack_i32(len(elems))
    cache_pack_ty_list(elems, 0, len(elems))
  },
  TFun(params, ret, row) => {
    perform pack_byte(6)
    perform pack_i32(len(params))
    cache_pack_params(params, 0, len(params))
    cache_pack_ty(ret)
    cache_pack_effrow(row)
  },
  TVar(handle) => {
    perform pack_byte(7)
    perform pack_i32(handle)
  },
  TName(name, args) => {
    perform pack_byte(8)
    perform pack_str(name)
    perform pack_i32(len(args))
    cache_pack_ty_list(args, 0, len(args))
  },
  TRecord(fields) => {
    perform pack_byte(9)
    perform pack_i32(len(fields))
    cache_pack_fields(fields, 0, len(fields))
  },
  TRecordOpen(fields, v) => {
    perform pack_byte(10)
    perform pack_i32(len(fields))
    cache_pack_fields(fields, 0, len(fields))
    perform pack_i32(v)
  },
  TRefined(base, pred) => {
    perform pack_byte(11)
    cache_pack_ty(base)
    cache_pack_predicate(pred)
  },
  TCont(ret, disc) => {
    perform pack_byte(12)
    cache_pack_ty(ret)
    cache_pack_resume_disc(disc)
  }
}

fn cache_pack_ty_list(tys, i, n) with Pack + !Unpack = {
  if i >= n { () }
  else {
    cache_pack_ty(list_index(tys, i))
    cache_pack_ty_list(tys, i + 1, n)
  }
}

fn cache_pack_fields(fields, i, n) with Pack + !Unpack = {
  if i >= n { () }
  else {
    let (name, ty) = list_index(fields, i)
    perform pack_str(name)
    cache_pack_ty(ty)
    cache_pack_fields(fields, i + 1, n)
  }
}

fn cache_pack_params(params, i, n) with Pack + !Unpack = {
  if i >= n { () }
  else {
    let TParam(name, ty, authored, resolved) = list_index(params, i)
    perform pack_str(name)
    cache_pack_ty(ty)
    cache_pack_ownership(authored)
    cache_pack_ownership(resolved)
    cache_pack_params(params, i + 1, n)
  }
}

// Ownership tags: 0=Unmarked, 1=Own, 2=Ref
fn cache_pack_ownership(o) with Pack + !Unpack = match o {
  Unmarked => perform pack_byte(0),
  Own      => perform pack_byte(1),
  Ref      => perform pack_byte(2)
}

// ResumeDiscipline tags: 0=OneShot, 1=MultiShot, 2=Either
fn cache_pack_resume_disc(disc) with Pack + !Unpack = match disc {
  OneShot   => perform pack_byte(0),
  MultiShot => perform pack_byte(1),
  Either    => perform pack_byte(2)
}

// EffRow tags: 0=EfPure, 1=EfClosed, 2=EfOpen, 3=EfNeg,
//              4=EfSub, 5=EfInter
fn cache_pack_effrow(row) with Pack + !Unpack = match row {
  EfPure => perform pack_byte(0),
  EfClosed(names) => {
    perform pack_byte(1)
    perform pack_i32(len(names))
    cache_pack_effnames(names, 0, len(names))
  },
  EfOpen(names, v) => {
    perform pack_byte(2)
    perform pack_i32(len(names))
    cache_pack_effnames(names, 0, len(names))
    perform pack_i32(v)
  },
  EfNeg(inner) => {
    perform pack_byte(3)
    cache_pack_effrow(inner)
  },
  EfSub(a, b) => {
    perform pack_byte(4)
    cache_pack_effrow(a)
    cache_pack_effrow(b)
  },
  EfInter(a, b) => {
    perform pack_byte(5)
    cache_pack_effrow(a)
    cache_pack_effrow(b)
  }
}

fn cache_pack_effnames(names, i, n) with Pack + !Unpack = {
  if i >= n { () }
  else {
    cache_pack_effname(list_index(names, i))
    cache_pack_effnames(names, i + 1, n)
  }
}

// CapabilityScheme payload — `(EffName, Bool)` pairs. The trailing byte
// records whether the effect was declared negated within the bundle.
fn cache_pack_eff_pairs(pairs, i, n) with Pack + !Unpack = {
  if i >= n { () }
  else {
    let (name, negated) = list_index(pairs, i)
    cache_pack_effname(name)
    perform pack_byte(if negated { 1 } else { 0 })
    cache_pack_eff_pairs(pairs, i + 1, n)
  }
}

// EffName tags: 0=ENamed, 1=EParameterized
fn cache_pack_effname(name) with Pack + !Unpack = match name {
  ENamed(s) => {
    perform pack_byte(0)
    perform pack_str(s)
  },
  EParameterized(s, args) => {
    perform pack_byte(1)
    perform pack_str(s)
    perform pack_i32(len(args))
    cache_pack_effargs(args, 0, len(args))
  }
}

fn cache_pack_effargs(args, i, n) with Pack + !Unpack = {
  if i >= n { () }
  else {
    cache_pack_effarg(list_index(args, i))
    cache_pack_effargs(args, i + 1, n)
  }
}

// EffArg tags: 0=EAInt, 1=EAString
fn cache_pack_effarg(arg) with Pack + !Unpack = match arg {
  EAInt(n) => {
    perform pack_byte(0)
    perform pack_i32(n)
  },
  EAString(s) => {
    perform pack_byte(1)
    perform pack_str(s)
  }
}

// Span — four i32 words, no tag (the shape is fixed).
fn cache_pack_span(span) with Pack + !Unpack = {
  let Span(sl, sc, el, ec) = span
  pack_i32(sl)
  pack_i32(sc)
  pack_i32(el)
  pack_i32(ec)
}

// BinOp tags: 0=BAdd, 1=BSub, 2=BMul, 3=BDiv, 4=BMod, 5=BEq, 6=BNe,
//             7=BLt, 8=BGt, 9=BLe, 10=BGe, 11=BAnd, 12=BOr, 13=BConcat
fn cache_pack_binop(op) with Pack + !Unpack = match op {
  BAdd    => pack_byte(0),
  BSub    => pack_byte(1),
  BMul    => pack_byte(2),
  BDiv    => pack_byte(3),
  BMod    => pack_byte(4),
  BEq     => pack_byte(5),
  BNe     => pack_byte(6),
  BLt     => pack_byte(7),
  BGt     => pack_byte(8),
  BLe     => pack_byte(9),
  BGe     => pack_byte(10),
  BAnd    => pack_byte(11),
  BOr     => pack_byte(12),
  BConcat => pack_byte(13)
}

// PExpr tags: 0=PSelf, 1=PInt, 2=PFloat, 3=PString, 4=PEVar, 5=PApp.
// PFloat rides string transport (float_to_str / parse_float) — exact
// f64 round-trip per strings.mn's 17-significant-digit rendering.
fn cache_pack_pexpr(e) with Pack + !Unpack = match e {
  PSelf => pack_byte(0),
  PInt(n) => {
    pack_byte(1)
    pack_i32(n)
  },
  PFloat(f) => {
    pack_byte(2)
    pack_str(float_to_str(f))
  },
  PString(s) => {
    pack_byte(3)
    pack_str(s)
  },
  PEVar(name) => {
    pack_byte(4)
    pack_str(name)
  },
  PApp(name, args) => {
    pack_byte(5)
    pack_str(name)
    pack_i32(len(args))
    cache_pack_pexprs(args, 0, len(args))
  }
}

fn cache_pack_pexprs(exprs, i, n) with Pack + !Unpack = {
  if i >= n { () }
  else {
    cache_pack_pexpr(list_index(exprs, i))
    cache_pack_pexprs(exprs, i + 1, n)
  }
}

// Predicate tags: 0=PTrue, 1=PEq, 2=PLt, 3=PLeq, 4=PAnd, 5=POr,
//                 6=PNot, 7=PCall
fn cache_pack_predicate(p) with Pack + !Unpack = match p {
  PTrue => pack_byte(0),
  PEq(l, r) => {
    pack_byte(1)
    cache_pack_pexpr(l)
    cache_pack_pexpr(r)
  },
  PLt(l, r) => {
    pack_byte(2)
    cache_pack_pexpr(l)
    cache_pack_pexpr(r)
  },
  PLeq(l, r) => {
    pack_byte(3)
    cache_pack_pexpr(l)
    cache_pack_pexpr(r)
  },
  PAnd(a, b) => {
    pack_byte(4)
    cache_pack_predicate(a)
    cache_pack_predicate(b)
  },
  POr(a, b) => {
    pack_byte(5)
    cache_pack_predicate(a)
    cache_pack_predicate(b)
  },
  PNot(inner) => {
    pack_byte(6)
    cache_pack_predicate(inner)
  },
  PCall(name, args) => {
    pack_byte(7)
    pack_str(name)
    pack_i32(len(args))
    cache_pack_pexprs(args, 0, len(args))
  },
  PBoolNode(h) => {
    pack_byte(8)
    pack_i32(h)
  },
  PPatternMatch(_, h) => {
    // The wire carries the scrutinee handle; the pat re-derives from
    // the handle's owning module at the SMT tier (the cache
    // invalidates with the module hash — same trust boundary as
    // TVar handles).
    pack_byte(9)
    pack_i32(h)
  }
}

// Reason tags follow types.mn declaration order:
//  0=Declared, 1=Unmarked, 2=Fresh, 3=OpConstraint, 4=VarLookup,
//  5=FnReturn, 6=FnParam, 7=MatchBranch, 8=ListElement, 9=IfBranch,
// 10=LetBinding, 11=Unified, 12=Instantiation, 13=UnifyFailed,
// 14=Placeholder, 15=BinOpPlaceholder, 16=MissingVar, 17=Refinement,
// 18=Located, 19=InferredCallReturn, 20=InferredPipeResult,
// 21=FreshInContext, 22=DocstringReason
fn cache_pack_reason(r) with Pack + !Unpack = match r {
  Declared(s) => {
    pack_byte(0)
    pack_str(s)
  },
  Inferred(s) => {
    pack_byte(1)
    pack_str(s)
  },
  Fresh(h) => {
    pack_byte(2)
    pack_i32(h)
  },
  OpConstraint(name, a, b) => {
    pack_byte(3)
    pack_str(name)
    cache_pack_reason(a)
    cache_pack_reason(b)
  },
  VarLookup(name, inner) => {
    pack_byte(4)
    pack_str(name)
    cache_pack_reason(inner)
  },
  FnReturn(name, inner) => {
    pack_byte(5)
    pack_str(name)
    cache_pack_reason(inner)
  },
  FnParam(name, idx, inner) => {
    pack_byte(6)
    pack_str(name)
    pack_i32(idx)
    cache_pack_reason(inner)
  },
  MatchBranch(a, b) => {
    pack_byte(7)
    cache_pack_reason(a)
    cache_pack_reason(b)
  },
  ListElement(inner) => {
    pack_byte(8)
    cache_pack_reason(inner)
  },
  IfBranch(inner) => {
    pack_byte(9)
    cache_pack_reason(inner)
  },
  LetBinding(name, inner) => {
    pack_byte(10)
    pack_str(name)
    cache_pack_reason(inner)
  },
  Unified(a, b) => {
    pack_byte(11)
    cache_pack_reason(a)
    cache_pack_reason(b)
  },
  Instantiation(name, inner) => {
    pack_byte(12)
    pack_str(name)
    cache_pack_reason(inner)
  },
  UnifyFailed(a, b) => {
    pack_byte(13)
    cache_pack_ty(a)
    cache_pack_ty(b)
  },
  Placeholder(span) => {
    pack_byte(14)
    cache_pack_span(span)
  },
  BinOpPlaceholder(op) => {
    pack_byte(15)
    cache_pack_binop(op)
  },
  MissingVar(name) => {
    pack_byte(16)
    pack_str(name)
  },
  Refinement(expected, found) => {
    pack_byte(17)
    cache_pack_predicate(expected)
    cache_pack_predicate(found)
  },
  Located(span, inner) => {
    pack_byte(18)
    cache_pack_span(span)
    cache_pack_reason(inner)
  },
  InferredCallReturn(name, inner) => {
    pack_byte(19)
    pack_str(name)
    cache_pack_reason(inner)
  },
  InferredPipeResult(verb, inner) => {
    pack_byte(20)
    pack_str(verb)
    cache_pack_reason(inner)
  },
  FreshInContext(h, ctx) => {
    pack_byte(21)
    pack_i32(h)
    pack_str(ctx)
  },
  DocstringReason(text, span) => {
    pack_byte(22)
    pack_str(text)
    cache_pack_span(span)
  }
}

// Binary deserialization — Unpack direction. Mirrors pack: reads tag
// bytes, dispatches on tag, reconstructs values.

fn cache_unpack_magic() with Unpack + !Pack = {
  let b0 = perform unpack_byte()
  let b1 = perform unpack_byte()
  let b2 = perform unpack_byte()
  let b3 = perform unpack_byte()
  // "IKAI" = 73, 75, 65, 73
  b0 == 73 && b1 == 75 && b2 == 65 && b3 == 73
}

fn cache_unpack() with Unpack + !Pack = {
  let version = perform unpack_i32()
  let module_name = perform unpack_str()
  let source_hash = perform unpack_i32()
  // Imports
  let n_imports = perform unpack_i32()
  let imports = cache_unpack_string_list(n_imports, 0, make_list(n_imports))
  // Import hashes
  let n_hashes = perform unpack_i32()
  let imports_hashes = cache_unpack_int_list(n_hashes, 0, make_list(n_hashes))
  // Entries
  let n_entries = perform unpack_i32()
  let entries = cache_unpack_entries(n_entries, 0, make_list(n_entries))
  {
    compiler_version: version,
    exported_entries: entries,
    imports: imports,
    imports_hashes: imports_hashes,
    module_name: module_name,
    source_hash: source_hash
  }
}

fn cache_unpack_string_list(n, i, buf) with Unpack + !Pack = {
  if i >= n { slice(buf, 0, n) }
  else {
    let s = perform unpack_str()
    cache_unpack_string_list(n, i + 1, list_set(buf, i, s))
  }
}

fn cache_unpack_int_list(n, i, buf) with Unpack + !Pack = {
  if i >= n { slice(buf, 0, n) }
  else {
    let v = perform unpack_i32()
    cache_unpack_int_list(n, i + 1, list_set(buf, i, v))
  }
}

fn cache_unpack_entries(n, i, buf) with Unpack + !Pack = {
  if i >= n { slice(buf, 0, n) }
  else {
    let name = perform unpack_str()
    let scheme = cache_unpack_scheme()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let kind = cache_unpack_kind()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let reason = Inferred("loaded from cache")
    cache_unpack_entries(n, i + 1, list_set(buf, i, (name, scheme, reason, kind)))
  }
}

fn cache_unpack_scheme() with Unpack + !Pack = {
  let n_handles = perform unpack_i32()
  let handles = cache_unpack_int_list(n_handles, 0, make_list(n_handles))
  let ty = cache_unpack_ty()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
  Forall(handles, ty)
}

fn cache_unpack_kind() with Unpack + !Pack = {
  let tag = perform unpack_byte()
  if tag == 0 { FnScheme }
  else if tag == 1 {
    let tag_id = perform unpack_i32()
    let total = perform unpack_i32()
    ConstructorScheme(tag_id, total)
  }
  else if tag == 2 {
    let effect_name = perform unpack_str()
    EffectOpScheme(effect_name)
  }
  else if tag == 3 {
    let n_fields = perform unpack_i32()
    let fields = cache_unpack_fields(n_fields, 0, make_list(n_fields))
    RecordSchemeKind(fields)
  }
  else if tag == 4 {
    let n_pairs = perform unpack_i32()
    let pairs = cache_unpack_eff_pairs(n_pairs, 0, make_list(n_pairs))
    CapabilityScheme(pairs)
  }
  else if tag == 5 {
    let n_ops = perform unpack_i32()
    let op_names = cache_unpack_string_list(n_ops, 0, make_list(n_ops))
    EffectDeclKind(op_names)
  }
  else if tag == 6 {
    let ename = perform unpack_str()
    let row_handle = perform unpack_i32()
    // config/state/arms are live-only (reconstructed from source on cross-file
    // load — peer Hβ.cache.handler-decl-from-source); empty here, never read in
    // the single-file first-light path.
    HandlerKind(ename, row_handle, [], [], [])
  }
  else { FnScheme }
}

fn cache_unpack_ty() with Unpack + !Pack = {
  let tag = perform unpack_byte()
  if tag == 0 { TInt }
  else if tag == 1 { TFloat }
  else if tag == 2 { TString }
  else if tag == 3 { TUnit }
  else if tag == 4 {
    let elem = cache_unpack_ty()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    TList(elem)
  }
  else if tag == 5 {
    let n = perform unpack_i32()
    let elems = cache_unpack_ty_list(n, 0, make_list(n))
    TTuple(elems)
  }
  else if tag == 6 {
    let n = perform unpack_i32()
    let params = cache_unpack_params(n, 0, make_list(n))
    let ret = cache_unpack_ty()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let row = cache_unpack_effrow()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    TFun(params, ret, row)
  }
  else if tag == 7 {
    let handle = perform unpack_i32()
    TVar(handle)
  }
  else if tag == 8 {
    let name = perform unpack_str()
    let n_args = perform unpack_i32()
    let args = cache_unpack_ty_list(n_args, 0, make_list(n_args))
    TName(name, args)
  }
  else if tag == 9 {
    let n = perform unpack_i32()
    let fields = cache_unpack_fields(n, 0, make_list(n))
    TRecord(fields)
  }
  else if tag == 10 {
    let n = perform unpack_i32()
    let fields = cache_unpack_fields(n, 0, make_list(n))
    let v = perform unpack_i32()
    TRecordOpen(fields, v)
  }
  else if tag == 11 {
    let base = cache_unpack_ty()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let pred = cache_unpack_predicate()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    TRefined(base, pred)
  }
  else if tag == 12 {
    let ret = cache_unpack_ty()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let disc = cache_unpack_resume_disc()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    TCont(ret, disc)
  }
  else { TUnit }
}

fn cache_unpack_ty_list(n, i, buf) with Unpack + !Pack = {
  if i >= n { slice(buf, 0, n) }
  else {
    let ty = cache_unpack_ty()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    cache_unpack_ty_list(n, i + 1, list_set(buf, i, ty))
  }
}

fn cache_unpack_fields(n, i, buf) with Unpack + !Pack = {
  if i >= n { slice(buf, 0, n) }
  else {
    let name = perform unpack_str()
    let ty = cache_unpack_ty()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    cache_unpack_fields(n, i + 1, list_set(buf, i, (name, ty)))
  }
}

fn cache_unpack_params(n, i, buf) with Unpack + !Pack = {
  if i >= n { slice(buf, 0, n) }
  else {
    let name = perform unpack_str()
    let ty = cache_unpack_ty()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let authored = cache_unpack_ownership()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let resolved = cache_unpack_ownership()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    cache_unpack_params(n, i + 1, list_set(buf, i, TParam(name, ty, authored, resolved)))
  }
}

fn cache_unpack_ownership() with Unpack + !Pack = {
  let tag = perform unpack_byte()
  if tag == 0 { Unmarked }
  else if tag == 1 { Own }
  else { Ref }
}

fn cache_unpack_resume_disc() with Unpack + !Pack = {
  let tag = perform unpack_byte()
  if tag == 0 { OneShot }
  else if tag == 1 { MultiShot }
  else { Either }
}

fn cache_unpack_effrow() with Unpack + !Pack = {
  let tag = perform unpack_byte()
  if tag == 0 { EfPure }
  else if tag == 1 {
    let n = perform unpack_i32()
    let names = cache_unpack_effnames(n, 0, make_list(n))
    EfClosed(names)
  }
  else if tag == 2 {
    let n = perform unpack_i32()
    let names = cache_unpack_effnames(n, 0, make_list(n))
    let v = perform unpack_i32()
    EfOpen(names, v)
  }
  else if tag == 3 {
    let inner = cache_unpack_effrow()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    EfNeg(inner)
  }
  else if tag == 4 {
    let a = cache_unpack_effrow()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let b = cache_unpack_effrow()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    EfSub(a, b)
  }
  else if tag == 5 {
    let a = cache_unpack_effrow()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let b = cache_unpack_effrow()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    EfInter(a, b)
  }
  else { EfPure }
}

fn cache_unpack_effnames(n, i, buf) with Unpack + !Pack = {
  if i >= n { slice(buf, 0, n) }
  else {
    let name = cache_unpack_effname()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    cache_unpack_effnames(n, i + 1, list_set(buf, i, name))
  }
}

fn cache_unpack_eff_pairs(n, i, buf) with Unpack + !Pack = {
  if i >= n { slice(buf, 0, n) }
  else {
    let name = cache_unpack_effname()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let neg_byte = perform unpack_byte()
    let negated = neg_byte != 0
    cache_unpack_eff_pairs(n, i + 1, list_set(buf, i, (name, negated)))
  }
}

fn cache_unpack_effname() with Unpack + !Pack = {
  let tag = perform unpack_byte()
  if tag == 0 {
    let s = perform unpack_str()
    ENamed(s)
  }
  else {
    let s = perform unpack_str()
    let n = perform unpack_i32()
    let args = cache_unpack_effargs(n, 0, make_list(n))
    EParameterized(s, args)
  }
}

fn cache_unpack_effargs(n, i, buf) with Unpack + !Pack = {
  if i >= n { slice(buf, 0, n) }
  else {
    let arg = cache_unpack_effarg()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    cache_unpack_effargs(n, i + 1, list_set(buf, i, arg))
  }
}

fn cache_unpack_effarg() with Unpack + !Pack = {
  let tag = perform unpack_byte()
  if tag == 0 {
    let n = perform unpack_i32()
    EAInt(n)
  }
  else {
    let s = perform unpack_str()
    EAString(s)
  }
}

fn cache_unpack_span() with Unpack + !Pack = {
  let sl = unpack_i32()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
  let sc = unpack_i32()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
  let el = unpack_i32()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
  let ec = unpack_i32()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
  Span(sl, sc, el, ec)
}

fn cache_unpack_binop() with Unpack + !Pack = {
  let tag = unpack_byte()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
  if tag == 0 { BAdd }
  else if tag == 1 { BSub }
  else if tag == 2 { BMul }
  else if tag == 3 { BDiv }
  else if tag == 4 { BMod }
  else if tag == 5 { BEq }
  else if tag == 6 { BNe }
  else if tag == 7 { BLt }
  else if tag == 8 { BGt }
  else if tag == 9 { BLe }
  else if tag == 10 { BGe }
  else if tag == 11 { BAnd }
  else if tag == 12 { BOr }
  else { BConcat }
}

fn cache_unpack_pexpr() with Unpack + !Pack = {
  let tag = unpack_byte()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
  if tag == 0 { PSelf }
  else if tag == 1 {
    let n = unpack_i32()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    PInt(n)
  }
  else if tag == 2 {
    let s = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    PFloat(parse_float(s))
  }
  else if tag == 3 {
    let s = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    PString(s)
  }
  else if tag == 4 {
    let name = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    PEVar(name)
  }
  else {
    let name = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let n = unpack_i32()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let args = cache_unpack_pexprs(n, 0, make_list(n))
    PApp(name, args)
  }
}

fn cache_unpack_pexprs(n, i, buf) with Unpack + !Pack = {
  if i >= n { slice(buf, 0, n) }
  else {
    let e = cache_unpack_pexpr()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    cache_unpack_pexprs(n, i + 1, list_set(buf, i, e))
  }
}

fn cache_unpack_predicate() with Unpack + !Pack = {
  let tag = unpack_byte()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
  if tag == 0 { PTrue }
  else if tag == 1 {
    let l = cache_unpack_pexpr()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let r = cache_unpack_pexpr()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    PEq(l, r)
  }
  else if tag == 2 {
    let l = cache_unpack_pexpr()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let r = cache_unpack_pexpr()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    PLt(l, r)
  }
  else if tag == 3 {
    let l = cache_unpack_pexpr()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let r = cache_unpack_pexpr()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    PLeq(l, r)
  }
  else if tag == 4 {
    let a = cache_unpack_predicate()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let b = cache_unpack_predicate()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    PAnd(a, b)
  }
  else if tag == 5 {
    let a = cache_unpack_predicate()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let b = cache_unpack_predicate()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    POr(a, b)
  }
  else if tag == 6 {
    let inner = cache_unpack_predicate()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    PNot(inner)
  }
  else if tag == 7 {
    let name = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let n = unpack_i32()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let args = cache_unpack_pexprs(n, 0, make_list(n))
    PCall(name, args)
  }
  else if tag == 8 {
    let h = unpack_i32()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    PBoolNode(h)
  }
  else {
    // tag 9 — the pat re-derives at the SMT tier; the wire carries
    // the scrutinee handle.
    let h = unpack_i32()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    PPatternMatch(PWild, h)
  }
}

fn cache_unpack_reason() with Unpack + !Pack = {
  let tag = unpack_byte()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
  if tag == 0 {
    let s = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    Declared(s)
  }
  else if tag == 1 {
    let s = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    Inferred(s)
  }
  else if tag == 2 {
    let h = unpack_i32()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    Fresh(h)
  }
  else if tag == 3 {
    let name = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let a = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let b = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    OpConstraint(name, a, b)
  }
  else if tag == 4 {
    let name = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let inner = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    VarLookup(name, inner)
  }
  else if tag == 5 {
    let name = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let inner = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    FnReturn(name, inner)
  }
  else if tag == 6 {
    let name = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let idx = unpack_i32()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let inner = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    FnParam(name, idx, inner)
  }
  else if tag == 7 {
    let a = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let b = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    MatchBranch(a, b)
  }
  else if tag == 8 {
    let inner = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    ListElement(inner)
  }
  else if tag == 9 {
    let inner = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    IfBranch(inner)
  }
  else if tag == 10 {
    let name = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let inner = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    LetBinding(name, inner)
  }
  else if tag == 11 {
    let a = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let b = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    Unified(a, b)
  }
  else if tag == 12 {
    let name = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let inner = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    Instantiation(name, inner)
  }
  else if tag == 13 {
    let a = cache_unpack_ty()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let b = cache_unpack_ty()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    UnifyFailed(a, b)
  }
  else if tag == 14 {
    let span = cache_unpack_span()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    Placeholder(span)
  }
  else if tag == 15 {
    let op = cache_unpack_binop()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    BinOpPlaceholder(op)
  }
  else if tag == 16 {
    let name = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    MissingVar(name)
  }
  else if tag == 17 {
    let expected = cache_unpack_predicate()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let found = cache_unpack_predicate()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    Refinement(expected, found)
  }
  else if tag == 18 {
    let span = cache_unpack_span()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let inner = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    Located(span, inner)
  }
  else if tag == 19 {
    let name = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let inner = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    InferredCallReturn(name, inner)
  }
  else if tag == 20 {
    let verb = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let inner = cache_unpack_reason()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    InferredPipeResult(verb, inner)
  }
  else if tag == 21 {
    let h = unpack_i32()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let ctx = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    FreshInContext(h, ctx)
  }
  else {
    let text = unpack_str()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    let span = cache_unpack_span()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    DocstringReason(text, span)
  }
}

// Public API — serialize/deserialize and read/write via Filesystem + Pack/Unpack.

fn cache_serialize(kai) with Memory + Alloc = {
  cache_pack(kai)
  perform pack_finalize()
} ~> buffer_packer

fn cache_deserialize(bytes) with Memory + Alloc = {
  if !cache_unpack_magic() { None }
  else {
    let kai = cache_unpack()   // drift-audit: ignore (sequenced effectful read; CLAUDE.md Anchor 6)
    if kai.compiler_version != cache_compiler_version() { None }
    else { Some(kai) }
  }
} ~> buffer_unpacker(bytes)

fn cache_write(kai) with Memory + Alloc + Filesystem = {
  if !perform fs_exists(cache_dir()) {
    perform fs_mkdir(".mentl")
    perform fs_mkdir(cache_dir())
  }
  let path = cache_path_for(kai.module_name)
  let bytes = cache_serialize(kai)
  perform fs_write_file(path, bytes)
}

fn cache_read(module_name) with Memory + Alloc + Filesystem = {
  let path = cache_path_for(module_name)
  if !perform fs_exists(path) { None }
  else {
    let bytes = perform fs_read_file(path)
    cache_deserialize(bytes)
  }
}

fn cache_is_hit(kai, current_source) with Memory = {
  kai.compiler_version == cache_compiler_version() &&
  kai.source_hash == hash_source(current_source)
}
