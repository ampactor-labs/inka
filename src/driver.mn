// driver.mn — the module DAG walk
//
// Walks the import DAG from an entry module, visits each module once
// in dependency order (post-order: leaves before importers), and
// resolves each name to a path (driver_module_path — four homes, tried
// in order). driver_compile_entry concatenates the DAG into ONE program
// so the whole thing is parsed and inferred together and the diagnostics
// are whole-program truth, never per-module fragments missing their
// cross-module names.
//
// The header here described "cache hit detection" and "consults the .kai
// cache to skip re-inference on unchanged sources" for two weeks after
// the .kai layer was DELETED WHOLE (2026-07-02): it snapshotted env
// entries lossily, DROPPING Reason chains, and pinned an Inka-era wire
// format. There is no cache in this file. Cross-run skipping returns as
// image-persist (Hβ.persist.module-image-cache, PLAN §5.R band O) — the
// graph image memcpy'd whole, keyed by source + transitive dep hashes,
// never a second serializer.
//
// The per-module env overlay is still open: env install merges flat into
// env_handler and the graph chase walks one global graph
// (Hβ.driver.per-module-env-overlay).

import types
import parser
import lexer
import infer
import runtime/strings
import runtime/io
import verify

// Resolve a module name to a file path — four homes, tried in order:
//   the DIRECT read (an arg naming an existing file resolves as itself —
//     `mentl check foo` beside foo.mn in ANY directory; `sub/thing` and
//     absolute paths ride the same read),
//   `src/{name}.mn` then `lib/{name}.mn` (the repo layout),
//   `/mentl-home/{src,lib}/{name}.mn` — the well-known guest path when
//     running OUTSIDE the repo: the install shim (tools/install.sh) maps
//     $MENTL_HOME there, so a user project's `import prelude` reaches the
//     pinned boot's own vocabulary — and its transitive `import types` (the
//     substrate effect decls live in src/types.mn) — with zero
//     configuration (the shim is a pointer to the live boot; the mapping
//     is an address, not an env var). In-repo the src/lib homes win
//     first — byte-identical behavior; on a total miss the repo-relative
//     lib path returns so the E_MissingModule diagnostic stays as before.
fn driver_module_path(ref module_name) with Filesystem = {
  let direct = "{module_name}.mn"
  if fs_exists(direct) { direct }
  else {
    let src_path = "src/{module_name}.mn"
    if fs_exists(src_path) { src_path }
    else {
      let lib_path = "lib/{module_name}.mn"
      if fs_exists(lib_path) { lib_path }
      else {
        let home_src = "/mentl-home/src/{module_name}.mn"
        if fs_exists(home_src) { home_src }
        else {
          let home_lib = "/mentl-home/lib/{module_name}.mn"
          if fs_exists(home_lib) { home_lib } else { lib_path }
        }
      }
    }
  }
}

// Module DAG collection — depth-first post-order walk from entry.
// Leaves before importers; visited set prevents cycles.
//
// THE PRELUDE IS PRE-IMPORTED — that is what the word means. Every module
// speaks the prelude's vocabulary (map / fold / Option / FeedbackSpec)
// without an import line, so the DAG seeds with `prelude` before the
// entry: its own imports (the runtime floor) resolve first, and the
// post-order puts the whole standard vocabulary ahead of every user
// module. Without the seed, `mentl compile main` reached a DAG that
// omitted the vocabulary the concatenated-wheel build supplies and
// emitted a module that could not assemble ($ev_lookup undefined —
// Hβ.driver.wheel-imports-are-the-manifest, the fleet's measured
// finding).
fn driver_collect_dag(ref entry_module) with Memory + Alloc + Filesystem = {
  let buf = make_list(16)
  let visited = []
  // The seed is conditional on RESOLUTION: the prelude is pre-imported where
  // the stdlib is reachable (the repo, an installed MENTL_HOME); a bare
  // scratch context with no lib/ compiles bare programs — seeding an
  // unresolvable prelude there would hand the ARMED E_MissingModule a
  // phantom and refuse every driver-path compile.
  let (seeded, seeded_visited) =
    if fs_exists(driver_module_path("prelude")) {
      driver_collect_visit("prelude", (buf, 0), visited)
    } else { ((buf, 0), visited) }
  let ((final_buf, final_count), _final_visited) =
    driver_collect_visit(entry_module, seeded, seeded_visited)
  slice(final_buf, 0, final_count)
}

// collected is a (buf, count) pair threaded through DAG traversal.
// Post-order: append self AFTER visiting deps.
fn driver_collect_visit(ref module_name, own collected, own visited)
  with Memory + Alloc + Filesystem = {
  if set_contains(visited, module_name) {
    (collected, visited)
  } else {
    let visited2 = set_insert(visited, module_name)
    let path = driver_module_path(module_name)
    if !fs_exists(path) {
      // Module source missing — treat as terminal (no further deps).
      // Driver's per-module check will surface E_MissingModule when
      // it tries to process this name.
      let (buf, count) = collected
      let extended = list_extend_to(buf, count + 1)
      let written  = list_set(extended, count, module_name)
      ((written, count + 1), visited2)
    } else {
      let source = fs_read_file(path)
      let imports = driver_extract_imports(source)
      // Visit dependencies first, then add self (post-order).
      let (after_deps_collected, after_deps_visited) =
        driver_collect_visit_list(imports, collected, visited2)
      let (buf, count) = after_deps_collected
      let extended = list_extend_to(buf, count + 1)
      let written  = list_set(extended, count, module_name)
      ((written, count + 1), after_deps_visited)
    }
  }
}

fn driver_collect_visit_list(ref modules, own collected, own visited)
  with Memory + Alloc + Filesystem = {
  fold((collected, visited), (acc, m) => {
    let (c, v) = acc
    driver_collect_visit(m, c, v)
  }, modules)
}

// Lex + parse just enough of a source to extract its ImportStmt
// nodes. Full inference doesn't run here — we want module names
// only, no env work yet. The parser produces a top-level stmt list;
// flatten + map projects each ImportStmt's path; non-import stmts
// project [] and flatten collapses them out.
fn driver_extract_imports(ref source) with Memory + Alloc = {
  source
    |> lex
    |> parse_program
    |> driver_extract_imports_from_ast
}

fn driver_extract_imports_from_ast(ast) = {
  flatten(map((node) => {
  let N(body, _, _) = node
  match body {
    NStmt(ImportStmt(path)) => [path],
    _                        => []
  }
  }, ast))
}

// Infer one module: its exports install into env_handler as
// infer_program walks (the graph IS the record of what this module
// publishes — no snapshot, no side-file). Cross-run module skip is
// the §4④ image-persist peer (Hβ.persist.module-image-cache): the
// graph image memcpy'd whole, keyed by source + transitive dep
// hashes — never a second serializer.
fn driver_check_module(ref module_name)
  with Memory + Alloc + Filesystem + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + LookupTy + Verify + InferCtx = {
  let path = driver_module_path(module_name)
  if !fs_exists(path) {
    report(EMissingModule(module_name, path, span_zero()))
  } else {
    fs_read_file(path)
      |> lex
      |> parse_program
      |> infer_program
  }
}

// A module's exports live in env_handler because infer_program put
// them there — the graph carries them; there is no install step and
// no exported-entries snapshot. A qualified `module.name` reference
// resolves by following the import edge to the module env node
// (SYNTAX.md §Imports) — never a dotted-string-key alias re-resolved
// by name at each call site (Carried-Truth: that is the canonical
// re-derivation).

// ─── Topological-layer walk (cargo-class) ───────────────────────────
//
// `driver_collect_dag` produces modules in post-order; this layer
// peels them into topological levels. Layer 0 = leaves (no in-DAG
// deps); layer N = modules whose deepest in-DAG dep is in layer N-1.
// Modules WITHIN a layer are dep-independent; each walks a layer, and
// layers process sequentially: layer N completes (every module's
// exports install into env) BEFORE layer N+1 starts (so dependents
// see all their deps).
//
// The layer partition IS the topological half of
// `Hβ.driver.level-set-par-walk`; the multi-core half is a `><`
// fanout under its own `~> Thread` written at this site — the
// schedule is read at the fanout's install, never across a call
// (Hβ.lower.schedule-specialized-callee).

// Process the entry module and all its transitive dependencies.
// Each module either loads from cache or re-infers; envs install in
// dependency order so every imported name is in `env_handler` before
// the entry module's inference runs.
fn driver_check(ref entry_module)
  with Memory + Alloc + Filesystem + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + LookupTy + Verify + InferCtx = {
  entry_module
    |> driver_collect_dag_with_deps
    |> driver_partition_layers
    |> each((layer) => each(driver_check_module, layer))
}

// driver_check_entry — the compile path's check: infer every DEP of the
// entry (each installs into env_handler), then parse+infer the ENTRY
// ITSELF exactly ONCE and hand its inferred AST back so compile lowers
// the SAME graph it proved. The entry is never re-read or re-inferred
// downstream (Carried-Truth: compile's old second fs_read + frontend +
// infer_program was the canonical re-derivation this deletes — the entry
// is parsed+typed here, once, and lowered live).
// The COMPILE form of the entry read: an executable IS the one-namespace
// concatenation of its dep DAG — deps first, post-order, entry last — the
// exact form the wheel's own build proves daily (`find src lib | xargs
// cat`). Parsed and inferred as ONE program, so every dep's decls lower
// and emit with the entry (reachability prunes the unused) and the
// diagnostics are the whole-program truth, never per-module fragments
// missing their cross-module names. The per-module env overlay
// (Hβ.driver.per-module-env-overlay) is the sequenced refinement; the
// concatenation is the proven form.
// The one-namespace concatenation WITH its module-range map — the map is a
// fact of the fold that builds the source (each module's start line and
// line count in the concatenated coordinate space), computed exactly where
// the concatenation happens, once. The cursor-address transport renders
// every span back to file:line through it; driver_compile_entry is its
// map-dropping projection.
// The weave order is CANONICAL, never the discovery order. The pinned blob
// build concatenates `find src | sort` then `find lib | sort`; one-namespace
// pre-registration makes ANY order compile, but verdicts are not yet
// order-independent — a runtime fn declared before its prelude consumer
// meets the TIGHT inferred scheme where the canon's order met the loose
// pre-registered one, and three real latent mismatches surface (prelude's
// sum / chunk / trim under a leaves-first weave — the banked measurement,
// Hβ.infer.order-independent-verdicts). One canon, one truth: the DAG
// discovers the SET; the sort fixes the WEAVE to the blob's own order, so
// the two build paths read one input.
fn driver_canonical_order(modules) with Memory + Alloc + Filesystem = {
  let keyed = map((m) => (driver_module_order_key(m), m), modules)
  map((pair) => { let (_, m) = pair m }, driver_sort_keyed(keyed))
}

// src/ ranks before lib/ (the blob's find order); within a rank, the path's
// own byte order. The rank digit prefixes the resolved path as the key.
// The rank reads the src/ SEGMENT, not a position-0 prefix: under an
// installed mount the resolver returns /mentl-home/src/..., and a prefix
// test would re-rank every src module as lib (a mount-dependent weave).
fn driver_module_order_key(m) with Memory + Alloc + Filesystem = {
  let p = driver_module_path(m)
  if str_contains(p, "src/") { "0{p}" } else { "1{p}" }
}

fn driver_sort_keyed(pairs) with Memory + Alloc =
  fold([], (acc, p) => driver_insert_keyed(p, acc), pairs)

fn driver_insert_keyed(pair, sorted) with Memory + Alloc = {
  if len(sorted) == 0 { [pair] }
  else {
    let (k, _) = pair
    let (k0, _) = sorted[0]
    if str_lt(k, k0) { [pair] ++ sorted }
    else { [sorted[0]] ++ driver_insert_keyed(pair, rest(sorted)) }
  }
}

fn driver_entry_with_ranges(ref entry_module)
  with Memory + Alloc + Filesystem + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + LookupTy + Verify + InferCtx = {
  let modules = driver_canonical_order(driver_collect_dag(entry_module))
  let (source, _next_line, ranges) = fold(("", 1, []), (acc, m) => {
    let (src_acc, line_acc, r_acc) = acc
    let p = driver_module_path(m)
    // A module the resolver cannot find is REPORTED, never skipped. The
    // `else` that once dropped it silently made `mentl check` say
    // E_MissingModule while `mentl compile` on the same source said
    // nothing and shipped WAT — two verbs, two answers, one truth.
    if fs_exists(p) {
      let text = fs_read_file(p)
      let nlines = count_lines(text) + 1
      ("{src_acc}{text}\n", line_acc + nlines, push(r_acc, (m, p, line_acc, nlines)))
    }
    else {
      report(EMissingModule(m, p, span_zero()))
      acc
    }
  }, modules)
  let ast = parse_program(lex(source))
  infer_program(ast)
  // The weave carries its own MODULE STRUCTURE: each range entry minted as
  // an NModule node — the module's NAME, its weave span, and the top-level
  // decls the span contains. The fabric's NModule readers (same_module's
  // proximity decay, module_path_of_span, the import walks) were built
  // against this node and had ZERO writers, so every span resolved to the
  // "" module and the argmax's module-aware decay flattened to one tie
  // (the edit session focusing a prelude recovery hole instead of the
  // entry's own `??`). The range map held the same fact out-of-band; the
  // graph is its one home.
  each((r) => {
    let (m, _p, line_start, nlines) = r
    let mspan = Span(line_start, 0, line_start + nlines, 0)
    mint_node(NModule({
      path: m,
      decls: filter((n) => { let N(_, dsp, _) = n span_contains(mspan, dsp) }, ast),
      span: mspan
    }), mspan)
  }, ranges)
  (ast, ranges)
}

// Newlines in a flat string — the concatenation fold's line accountant.
fn count_lines(ref s) with Memory = count_lines_from(s, load_i32(s), 0, 0)

fn count_lines_from(ref s, n, i, acc) with Memory = {
  if i >= n { acc }
  else {
    let step = if load_i8(s + 8 + i) == 10 { 1 } else { 0 }
    count_lines_from(s, n, i + 1, acc + step)
  }
}

fn driver_compile_entry(ref entry_module)
  with Memory + Alloc + Filesystem + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + LookupTy + Verify + InferCtx = {
  let (ast, _ranges) = driver_entry_with_ranges(entry_module)
  ast
}

fn driver_check_entry(ref entry_module)
  with Memory + Alloc + Filesystem + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + LookupTy + Verify + InferCtx = {
  // Check the deps DAG (every module the entry imports) — not the entry.
  entry_module
    |> driver_collect_dag_with_deps
    |> filter((m_with_deps) => { let (m, _) = m_with_deps; m != entry_module })
    |> driver_partition_layers
    |> each((layer) => each(driver_check_module, layer))
  // Parse + infer the entry ONCE; its AST is what compile lowers live.
  let ast = parse_program(lex(fs_read_file(driver_module_path(entry_module))))
  infer_program(ast)
  ast
}

// Walk the post-order DAG and pair each module with its in-DAG deps.
// In-DAG: dep names that appear among the collected modules (filters
// out missing-module fallbacks that have no source). Returns
// `[(module_name, [dep_name])]` in post-order.
fn driver_collect_dag_with_deps(ref entry_module)
  with Memory + Alloc + Filesystem = {
  let modules = driver_collect_dag(entry_module)
  map((m) => (m, driver_module_in_dag_deps(m, modules)), modules)
}

// Extract the imports of one module, then filter to the in-DAG set.
// Out-of-DAG names (missing modules, vocabulary aliases the driver doesn't
// process) contribute nothing to the layer-partition's wait condition.
fn driver_module_in_dag_deps(ref module_name, ref dag_modules)
  with Memory + Alloc + Filesystem = {
  let path = driver_module_path(module_name)
  if !fs_exists(path) { [] }
  else {
    let source = fs_read_file(path)
    source
      |> driver_extract_imports
      |> filter((dep) => contains_module(dag_modules, dep))
  }
}

fn contains_module(ref modules, ref target) with Memory + Alloc = {
  any((m) => m == target, modules)
}

// Partition modules-with-deps into topological layers. Each pass
// peels off the "ready set" — modules whose deps are all processed.
// Iteration bound: DAG depth (typically ≤ 10 for a wheel-class graph).
fn driver_partition_layers(ref modules_with_deps) with Memory + Alloc = {
  driver_partition_peel(modules_with_deps, [], [])
}

// processed / layers_rev pinned (the Intent Boundary): both thread from []
// through the recursion, so their element types have no other source — an
// unpinned `processed ++ layer_names` floored the concat in m3's copy.
fn driver_partition_peel(ref remaining, ref processed: [String], ref layers_rev: [[String]])
  with Memory + Alloc = {
  if len(remaining) == 0 { reverse(layers_rev) }
  else {
    let layer_pairs = filter((m_with_deps) => {
      let (_, deps) = m_with_deps
      all((d) => contains_module(processed, d), deps)
    }, remaining)
    if len(layer_pairs) == 0 {
      // Cycle or unsatisfiable dep — process remaining sequentially
      // as a final layer to surface diagnostics at driver_check_module.
      let leftover_names = map(((m, _)) => m, remaining)
      reverse([leftover_names] ++ layers_rev)
    } else {
      let layer_names = map(((m, _)) => m, layer_pairs)
      let next_remaining = filter((m_with_deps) => {
        let (m, _) = m_with_deps
        !contains_module(layer_names, m)
      }, remaining)
      let next_processed = processed ++ layer_names
      driver_partition_peel(next_remaining, next_processed, [layer_names] ++ layers_rev)
    }
  }
}
