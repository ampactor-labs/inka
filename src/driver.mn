// driver.mn — incremental compilation driver (IC.2)
//
// Orchestrates per-module check/build with cache hit detection.
// Walks the import DAG from an entry-point module, processes each
// module exactly once in dependency order, consults the .kai cache
// to skip re-inference on unchanged sources, installs cached envs
// into the env_handler so importing modules can resolve names.
//
// IC.2 (this commit): single-entry recursive descent over imports
// with source-hash invalidation. Per-module env install merges
// flat into env_handler (no per-module overlay separation yet —
// the graph chase still walks one global graph). Per-module
// overlays land with IC.3's chase extension.
//
// Walkthrough: docs/specs/simulations/IC-incremental-compilation.md

import types
import cache
import parser
import lexer
import infer
import runtime/strings
import runtime/io

// Resolve a module name to a file path. Checks `src/` then `lib/`:
//   `"infer"` → `"src/infer.mn"`,
//   `"runtime/strings"` → `"lib/runtime/strings.mn"`.
fn driver_module_path(ref module_name) with Memory + Alloc + Filesystem = {
  let src_path = "src/{module_name}.mn"
  if fs_exists(src_path) {
    src_path
  } else {
    "lib/{module_name}.mn"
  }
}

// Module DAG collection — depth-first post-order walk from entry.
// Leaves before importers; visited set prevents cycles.

fn driver_collect_dag(ref entry_module) with Memory + Alloc + Filesystem = {
  let buf = make_list(16)
  let visited = []
  let ((final_buf, final_count), _final_visited) =
    driver_collect_visit(entry_module, (buf, 0), visited)
  slice(final_buf, 0, final_count)
}

// collected is a (buf, count) pair threaded through DAG traversal.
// Post-order: append self AFTER visiting deps.
fn driver_collect_visit(ref module_name, own collected, own visited)
  with Memory + Alloc + Filesystem = {
  if set_contains(visited, module_name) {
    (collected, visited)
  } else {
    let visited2 = set_insert(visited, module_name)
    let path = driver_module_path(module_name)
    if !fs_exists(path) {
      // Module source missing — treat as terminal (no further deps).
      // Driver's per-module check will surface E_MissingModule when
      // it tries to process this name.
      let (buf, count) = collected
      let extended = list_extend_to(buf, count + 1)
      let written  = list_set(extended, count, module_name)
      ((written, count + 1), visited2)
    } else {
      let source = fs_read_file(path)
      let imports = driver_extract_imports(source)
      // Visit dependencies first, then add self (post-order).
      let (after_deps_collected, after_deps_visited) =
        driver_collect_visit_list(imports, collected, visited2)
      let (buf, count) = after_deps_collected
      let extended = list_extend_to(buf, count + 1)
      let written  = list_set(extended, count, module_name)
      ((written, count + 1), after_deps_visited)
    }
  }
}

fn driver_collect_visit_list(ref modules, own collected, own visited)
  with Memory + Alloc + Filesystem = {
  fold(modules, (collected, visited), (acc, m) => {
    let (c, v) = acc
    driver_collect_visit(m, c, v)
  })
}

// Lex + parse just enough of a source to extract its ImportStmt
// nodes. Full inference doesn't run here — we want module names
// only, no env work yet. The parser produces a top-level stmt list;
// flatten + map projects each ImportStmt's path; non-import stmts
// project [] and flatten collapses them out.
fn driver_extract_imports(ref source) with Memory + Alloc = {
  source
    |> lex
    |> parse_program
    |> driver_extract_imports_from_ast
}

fn driver_extract_imports_from_ast(ast) = {
  flatten(map((node) => {
  let N(body, _, _) = node
  match body {
    NStmt(ImportStmt(path)) => [path],
    _                        => []
  }
  }, ast))
}

// Consult the cache; on miss run full inference for this module
// and write a fresh `.kai`. Returns the env entries this module
// publishes for the caller to install into `env_handler`.
fn driver_check_module(ref module_name)
  with Memory + Alloc + Filesystem + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + LookupTy + Verify + InferCtx = {
  let path = driver_module_path(module_name)
  if !fs_exists(path) {
    report(EMissingModule(module_name, path, span_zero()))
    []
  } else {
    let source = fs_read_file(path)
    let current_hash = hash_source(source)
    let cached = cache_read(module_name)
    match cached {
      Some(kai) => {
        // Read each dep's CURRENT hash live so cache_is_hit can verify
        // transitive freshness — a changed dependency invalidates this
        // module's cache (Carried-Truth: dep freshness read live from the
        // import DAG, not assumed from the module's own hash alone).
        let current_dep_hashes = driver_collect_dep_hashes(kai.imports)
        if cache_is_hit(kai, source, current_dep_hashes) {
          // Cache hit — install cached entries into env_handler.
          // No re-inference for this module: its source AND every dep
          // are byte-identical to the cache-write moment.
          driver_install_entries(kai.exported_entries)
          kai.exported_entries
        } else {
          // Cache miss (this module's source OR a dep changed) — re-infer.
          driver_infer_module(module_name, source, current_hash)
        }
      },
      None => driver_infer_module(module_name, source, current_hash)
    }
  }
}

fn driver_infer_module(ref module_name, ref source, ref source_hash)
  with Memory + Alloc + Filesystem + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + LookupTy + Verify + InferCtx = {
  let tokens = lex(source)
  let ast = parse_program(tokens)
  let imports = driver_extract_imports_from_ast(ast)
  let imports_hashes = driver_collect_dep_hashes(imports)
  // Snapshot env BEFORE inference so we can diff after to find
  // this module's exported entries.
  let env_before = env_snapshot()   // drift-audit: ignore — sequenced effectful read (stream-consumer/checkpoint), CLAUDE.md Anchor 6 exclusion
  let Env(entries_before) = env_before
  let n_before = len(entries_before)
  // Run inference.
  infer_program(ast)
  // Snapshot env AFTER; the new entries are this module's exports.
  let env_after = env_snapshot()   // drift-audit: ignore — sequenced effectful read (stream-consumer/checkpoint), CLAUDE.md Anchor 6 exclusion
  let Env(entries_after) = env_after
  let n_after = len(entries_after)
  // env_handler appends at the stack head (Mentl list_head reads the last
  // element), so the new exports are the newest entries.
  let new_count = n_after - n_before
  let exported = driver_take_first(entries_after, new_count)
  // The flat export names are already in env from infer_program. A
  // qualified `module.name` reference follows the import edge to the
  // module env node and reads `.name` there (SYNTAX.md §Imports) — no
  // dotted-string-key side-ledger to pre-mint (Carried-Truth; the dotted
  // key was the canonical re-derivation the surface explicitly rejects).
  // Write cache.
  let kai = {
    compiler_version: cache_compiler_version(),
    exported_entries: exported,
    imports: imports,
    imports_hashes: imports_hashes,
    module_name: module_name,
    source_hash: source_hash
  }
  cache_write(kai)
  exported
}

// Collect each dep's CURRENT source hash (used to record the
// cache-write moment so future invalidation can compare). For
// caches written now, "now's" hash is what we record.
fn driver_collect_dep_hashes(ref imports) with Memory + Alloc + Filesystem = {
  let n = len(imports)
  driver_collect_dep_hashes_loop(imports, 0, n, make_list(n))
}

fn driver_collect_dep_hashes_loop(ref imports, i, n, own buf)
  with Memory + Alloc + Filesystem =
  if i >= n { buf }
  else {
    let m = list_index(imports, i)
    let path = driver_module_path(m)
    let h = if fs_exists(path) {
      hash_source(fs_read_file(path))
    } else { 0 }
    driver_collect_dep_hashes_loop(imports, i + 1, n, list_set(buf, i, h))
  }

fn driver_take_first(ref entries, count) = {
  if count <= 0 { [] }
  else if len(entries) == 0 { [] }
  else { [list_head(entries)] ++ driver_take_first(list_tail(entries), count - 1) }
}

// Env install — push entries into env_handler for importing modules
// under their flat names. A qualified `module.name` reference resolves
// by following the import edge to the module env node (SYNTAX.md
// §Imports) — never a dotted-string-key alias re-resolved by name at
// each call site (Carried-Truth: that is the canonical re-derivation).

fn driver_install_entries(ref entries) with Memory + Alloc + EnvWrite = {
  driver_install_loop(entries, 0, len(entries))
}

fn driver_install_loop(ref entries, i, n) with Memory + Alloc + EnvWrite = {
  if i >= n { () }
  else {
    let entry = list_index(entries, i)
    let (name, scheme, reason, kind) = entry
    env_extend(name, scheme, reason, kind)
    driver_install_loop(entries, i + 1, n)
  }
}


// ─── Topological-layer parallel walk (cargo-class) ──────────────────
//
// `driver_collect_dag` produces modules in post-order; this layer
// peels them into topological levels. Layer 0 = leaves (no in-DAG
// deps); layer N = modules whose deepest in-DAG dep is in layer N-1.
// Modules WITHIN a layer are dep-independent — parallel_map fans them
// out via `><`. Layers process sequentially: layer N completes (every
// module's exports install into env) BEFORE layer N+1 starts (so
// dependents see all their deps).
//
// for_each over layers (sequential gates dep-installation) × per-layer
// parallel_map (genuine parallelism via Thread effect + parallel_compose)
// IS the cargo-equivalent topology. Handler swap decides spatial
// (parallel_compose → OS threads) vs temporal (sequential_compose → one
// thread) — same source.
//
// Per `Hβ.driver.level-set-par-walk` peer follow-up closure.

// Process the entry module and all its transitive dependencies.
// Each module either loads from cache or re-infers; envs install in
// dependency order so every imported name is in `env_handler` before
// the entry module's inference runs.
fn driver_check(ref entry_module)
  with Memory + Alloc + Filesystem + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + LookupTy + Verify + InferCtx = {
  entry_module
    |> driver_collect_dag_with_deps
    |> driver_partition_layers
    |> for_each((layer) => parallel_map(driver_check_module, layer))
}

// driver_check_entry — the compile path's check: infer every DEP of the
// entry (each installs into env_handler), then parse+infer the ENTRY
// ITSELF exactly ONCE and hand its inferred AST back so compile lowers
// the SAME graph it proved. The entry is never re-read or re-inferred
// downstream (Carried-Truth: compile's old second fs_read + frontend +
// infer_program was the canonical re-derivation this deletes — the entry
// is parsed+typed here, once, and lowered live).
fn driver_check_entry(ref entry_module)
  with Memory + Alloc + Filesystem + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + LookupTy + Verify + InferCtx = {
  // Check the deps DAG (every module the entry imports) — not the entry.
  entry_module
    |> driver_collect_dag_with_deps
    |> filter((m_with_deps) => { let (m, _) = m_with_deps; m != entry_module })
    |> driver_partition_layers
    |> for_each((layer) => parallel_map(driver_check_module, layer))
  // Parse + infer the entry ONCE; its AST is what compile lowers live.
  let ast = parse_program(lex(fs_read_file(driver_module_path(entry_module))))
  infer_program(ast)
  ast
}

// Walk the post-order DAG and pair each module with its in-DAG deps.
// In-DAG: dep names that appear among the collected modules (filters
// out missing-module fallbacks that have no source). Returns
// `[(module_name, [dep_name])]` in post-order.
fn driver_collect_dag_with_deps(ref entry_module)
  with Memory + Alloc + Filesystem = {
  let modules = driver_collect_dag(entry_module)
  map((m) => (m, driver_module_in_dag_deps(m, modules)), modules)
}

// Extract the imports of one module, then filter to the in-DAG set.
// Out-of-DAG names (missing modules, stdlib aliases the driver doesn't
// process) contribute nothing to the layer-partition's wait condition.
fn driver_module_in_dag_deps(ref module_name, ref dag_modules)
  with Memory + Alloc + Filesystem = {
  let path = driver_module_path(module_name)
  if !fs_exists(path) { [] }
  else {
    let source = fs_read_file(path)
    source
      |> driver_extract_imports
      |> filter((dep) => contains_module(dag_modules, dep))
  }
}

fn contains_module(ref modules, ref target) with Pure = {
  any((m) => m == target, modules)
}

// Partition modules-with-deps into topological layers. Each pass
// peels off the "ready set" — modules whose deps are all processed.
// Iteration bound: DAG depth (typically ≤ 10 for a wheel-class graph).
fn driver_partition_layers(ref modules_with_deps) with Memory + Alloc = {
  driver_partition_peel(modules_with_deps, [], [])
}

fn driver_partition_peel(ref remaining, ref processed, ref layers_rev)
  with Memory + Alloc = {
  if len(remaining) == 0 { reverse(layers_rev) }
  else {
    let layer_pairs = filter((m_with_deps) => {
      let (_, deps) = m_with_deps
      all((d) => contains_module(processed, d), deps)
    }, remaining)
    if len(layer_pairs) == 0 {
      // Cycle or unsatisfiable dep — process remaining sequentially
      // as a final layer to surface diagnostics at driver_check_module.
      let leftover_names = map((p) => { let (m, _) = p; m }, remaining)
      reverse([leftover_names] ++ layers_rev)
    } else {
      let layer_names = map((p) => { let (m, _) = p; m }, layer_pairs)
      let next_remaining = filter((m_with_deps) => {
        let (m, _) = m_with_deps
        !contains_module(layer_names, m)
      }, remaining)
      let next_processed = processed ++ layer_names
      driver_partition_peel(next_remaining, next_processed, [layer_names] ++ layers_rev)
    }
  }
}
