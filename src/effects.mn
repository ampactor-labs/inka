// effects.mn — Boolean algebra over effect rows (spec 01)
//
// The algebra. Pure functions on data. No handlers, no state, no
// effects. The proof engine that every compilation gate (`Pure`,
// `!IO`, `!Alloc`, `!Network`) and every handler install reduces to.
//
// types.mn owns the EffRow ADT and display; this file owns the
// algebra — normalize / union / diff / inter / neg / subsumes / unify
// / absorb / ground. One mechanism; four gates fall out.
//
// Research: Flix Boolean unification (OOPSLA 2024), Tang-Lindley
// Modal Effect Types (POPL 2025 / 2026), Abstracting Effect Systems
// (ICFP 2024). Decidable, sound, documented. None invented here.
// The artifact is that one row_subsumes call services every gate.

import types
import runtime/strings

// Smart constructors — sort invariant by construction
// Every EfClosed / EfOpen value in the system passes through these
// constructors. They canonicalize their input at the boundary so
// downstream consumers (set_union, set_diff, set_contains, equality
// checks) can assume sorted-flat input and run at substrate speed.
// Permanent overhead-at-call drops to a single set_canonicalize per
// construction; consumers can then drop their boundary canonicalize
// adapters entirely.
//
// DESIGN Ch 4 substrate discipline: the row IS the sorted set. The
// graph stores rows in the form they were constructed; constructors
// enforce the invariant the algebra depends on.

fn mk_ef_closed(ref names) with !Mutate = EfClosed(name_set_canonicalize(names))

fn mk_ef_open(ref names, v) with !Mutate = EfOpen(name_set_canonicalize(names), v)

// Record-field smart constructor: sort (field_name, ty) pairs by
// field name, dedup by name (last write wins). Empty list → empty
// (caller chooses TRecord vs TRecordOpen). Maintains the analog of
// the EffRow invariant for record types.
fn mk_record_open(ref fields, v) with !Mutate = {
  TRecordOpen(field_canonicalize(fields), v)
}

fn field_canonicalize(ref fields) with !Mutate = {
  let n = len(fields)
  field_canonicalize_loop(fields, 0, n, [])
}

fn field_canonicalize_loop(ref fields, i, n, own acc) with !Mutate = {
  if i >= n { acc }
  else {
    let (name, ty) = list_index(fields, i)
    field_canonicalize_loop(fields, i + 1, n, field_insert(acc, name, ty))
  }
}

// Insert (name, ty) into sorted-by-name list; if name already present,
// replace (last write wins).
fn field_insert(ref sorted, ref name: String, ref ty) with !Mutate = {
  let n = len(sorted)
  let pos = field_find_pos(sorted, name, 0, n)
  if pos < n {
    let (existing_name, _) = list_index(sorted, pos)
    if existing_name == name {
      // Replace at pos.
      let buf = make_list(n)
      let copied = list_copy_into(sorted, buf, 0, n)
      list_set(copied, pos, (name, ty))
    } else {
      // Insert at pos.
      let buf = make_list(n + 1)
      let prefix = list_copy_into(sorted, buf, 0, pos)
      let with_ins = list_set(prefix, pos, (name, ty))
      field_copy_suffix_shifted(sorted, with_ins, pos, pos, n)
    }
  } else {
    // Append.
    let buf = make_list(n + 1)
    let copied = list_copy_into(sorted, buf, 0, n)
    list_set(copied, n, (name, ty))
  }
}

// Field-NAME equality with the String proof pinned at the boundary. The
// bare `==` on two tuple-destructured names carries no type proof through
// the seed's weak inference, so it emitted POINTER-eq — decl-pass-interned
// "tier" never matched literal-pass-interned "tier", and byte-identical
// records refused to unify ({ w, tier } vs { w, tier }, the rp2 pin).
// One home for the compare; every record-field walk routes through it.
// Dissolves with band D (== reads the operand proof at the eq-fold).
fn field_name_eq(a: String, b: String) with Pure = a == b

fn field_find_pos(ref sorted, ref name, i, n) with !Mutate = {
  if i >= n { n }
  else {
    let (existing_name, _) = list_index(sorted, i)
    if str_lt(existing_name, name) {
      field_find_pos(sorted, name, i + 1, n)
    } else { i }
  }
}

fn field_copy_suffix_shifted(ref src, own dst, src_idx, dst_idx, n) with !Mutate = {
  if src_idx >= n { dst }
  else {
    field_copy_suffix_shifted(
      src, list_set(dst, dst_idx + 1, list_index(src, src_idx)),
      src_idx + 1, dst_idx + 1, n
    )
  }
}

// Normalization
// After normalize_row, every row is canonical:
//   EfPure  |  EfClosed(sorted_unique)  |  EfOpen(sorted_unique, v)
// EfNeg / EfSub / EfInter are intermediate and reduce before
// comparison or unification.

fn normalize_row(ref row) with !Mutate = {
  match row {
    EfPure => EfPure,
    EfClosed(names) =>
      names
        |> sort_unique
        |> closed_or_pure,
    EfOpen(names, v) =>
      EfOpen(sort_unique(names), v),
    EfNeg(inner) =>
      inner
        |> normalize_row
        |> normalize_neg,
    EfSub(a, b) =>
      // A - B ≡ A & !B — De Morgan reduction
      EfInter(a, EfNeg(b))
        |> normalize_row,
    EfInter(a, b) =>
      normalize_inter(normalize_row(a), normalize_row(b))
  }
}

fn normalize_neg(ref row) with Pure = {
  match row {
    EfPure           => EfNeg(EfPure),        // !Pure = everything
    EfClosed(names)  => EfNeg(EfClosed(names)),
    EfOpen(names, v) => EfNeg(EfOpen(names, v)),
    EfNeg(inner)     => inner,                // double negation
    _                => EfNeg(row)
  }
}

fn normalize_inter(ref a, ref b) with !Mutate = {
  match a {
    EfPure => EfPure,                         // Pure ∩ X = Pure
    EfClosed(na) =>
      match b {
        EfPure => EfPure,
        EfClosed(nb) =>
          na
            |> list_intersect(??, nb)
            |> closed_or_pure,
        EfOpen(nb, _) =>
          na
            |> list_intersect(??, nb)
            |> closed_or_pure,
        EfNeg(inner) =>
          match inner {
            EfClosed(neg_names) =>
              // Closed(A) & !Closed(B) = Closed(A - B)
              na
                |> list_diff_str(??, neg_names)
                |> closed_or_pure,
            _ => EfInter(a, b)
          },
        _ => EfInter(a, b)
      },
    EfOpen(na, va) =>
      match b {
        EfPure => EfPure,
        EfClosed(nb) =>
          na
            |> list_intersect(??, nb)
            |> closed_or_pure,
        EfOpen(nb, vb) =>
          // Both open: intersect known names, keep first var.
          // Unification later constrains vars.
          EfOpen(list_intersect(na, nb), va),
        EfNeg(inner) =>
          match inner {
            EfClosed(neg_names) =>
              EfOpen(list_diff_str(na, neg_names), va),
            _ => EfInter(a, b)
          },
        _ => EfInter(a, b)
      },
    _ => EfInter(a, b)
  }
}

fn closed_or_pure(ref names) with !Mutate = {
  if len(names) == 0 { EfPure }
  else { EfClosed(names) }
}

// A recursive fn's row equation R = names ∪ R takes its LEAST solution: the
// self-edge contributes nothing (μR. names ∪ R = names), so a var-tail that
// lands on the fn's OWN row handle cuts to the closed names at exit-bind.
// Without the cut the bind writes a row containing its own handle; every
// reader's chase cycles out empty and call sites see a BARE callee — the
// recursive-callee evidence miss (t-rec exit 134; iterate_from's shape).
// resolve_row folds bound tails first, so the compare sees the terminal var.
fn row_without_self(row, self_h) with !Mutate = match resolve_row(row) {
  EfOpen(names, v) => if v == self_h { closed_or_pure(names) }
                      else { EfOpen(names, v) },
  other            => other
}

// Union row (`+`): E + F = the row of all effects in E or F. TOTAL over the
// six row forms — negation IS a normal form (¬X survives normalize_row), so
// the old "normalize b and retry" arms re-entered themselves forever on any
// Closed ∪ Neg pair: the pass-2 512MB/2GB OOB deaths and the 4GB
// wrapped-allocator `unreachable` were ONE loop here, detonating at the
// wheel's first mixed declared row (`Cursor + IC + !Mutate`). Every arm now
// REDUCES: Sub rewrites once by De Morgan, Inter distributes over strictly
// smaller operands, Neg meets its unions in closed form:
//
//   Closed[a] ∪ ¬X = ¬(X ∖ a)            (the complement absorbs the names)
//   ¬X ∪ ¬Y        = ¬(X ∩ Y)
//   c ∪ (P ∩ Q)    = (c ∪ P) ∩ (c ∪ Q)   (distribute, then re-reduce)
//   c ∪ (P − Q)    = (c ∪ P) ∩ (c ∪ ¬Q)  (De Morgan, then distribute)
fn union_row(ref a, ref b) with !Mutate = {
  match a {
    EfPure => b,
    EfClosed(na) =>
      match b {
        EfPure => a,
        EfClosed(nb) =>
          name_set_union(na, nb)
            |> closed_or_pure,
        EfOpen(nb, v) =>
          name_set_union(na, nb)
            |> (merged) => EfOpen(merged, v),
        EfNeg(x) => neg_minus_names(x, na),
        EfSub(p, q) =>
          a
            |> union_row(??, neg_row(q))
            |> normalize_inter(??, union_row(a, p)),
        EfInter(p, q) =>
          a
            |> union_row(??, q)
            |> normalize_inter(??, union_row(a, p))
      },
    EfOpen(na, va) =>
      match b {
        EfPure => a,
        EfClosed(nb) =>
          name_set_union(na, nb)
            |> (merged) => EfOpen(merged, va),
        EfOpen(nb, _) =>
          name_set_union(na, nb)
            |> (merged) => EfOpen(merged, va),
        EfNeg(x) => neg_minus_names(x, na),
        EfSub(p, q) =>
          a
            |> union_row(??, neg_row(q))
            |> normalize_inter(??, union_row(a, p)),
        EfInter(p, q) =>
          a
            |> union_row(??, q)
            |> normalize_inter(??, union_row(a, p))
      },
    EfNeg(x) =>
      match b {
        EfPure => a,
        EfClosed(nb) => neg_minus_names(x, nb),
        EfOpen(nb, _) => neg_minus_names(x, nb),
        EfNeg(y) => EfNeg(normalize_inter(normalize_row(x), normalize_row(y))),
        EfSub(p, q) =>
          a
            |> union_row(??, neg_row(q))
            |> normalize_inter(??, union_row(a, p)),
        EfInter(p, q) =>
          a
            |> union_row(??, q)
            |> normalize_inter(??, union_row(a, p))
      },
    EfSub(_, _) =>
      a
        |> normalize_row
        |> union_row(??, b),
    EfInter(p, q) =>
      p
        |> union_row(??, b)
        |> normalize_inter(??, union_row(q, b))
  }
}

// ¬X ∪ names = ¬(X ∖ names): names already admitted leave the forbidden set;
// an empty remainder is ¬Pure (the universe — {IO} ∪ !IO admits everything).
// A non-closed X keeps its whole ban: dropping admitted names from an open
// forbidden set would shrink the ban unsoundly, and the conservative form
// only ever makes the subsumption gate LOUDER. An open ADMITTED tail under
// negation likewise takes its least solution here — the band-A world-index
// owns the refined form (PLAN §5.R).
fn neg_minus_names(ref x, ref names) with !Mutate = {
  match normalize_row(x) {
    EfPure => EfNeg(EfPure),
    EfClosed(nx) =>
      EfNeg(closed_or_pure(list_diff_str(nx, names))),
    other => EfNeg(other)
  }
}

// Difference row (`-`): handler absorption uses this — `(body_row - handled_row) + arm_row`.
fn diff_row(ref a, ref b) with !Mutate = {
  EfSub(a, b)
    |> normalize_row
}

// Intersection row (`&`).
fn inter_row(ref a, ref b) with !Mutate = {
  EfInter(a, b)
    |> normalize_row
}

// Negation row (`!`): `!E` proves absence — the load-bearing novelty of Mentl's algebra.
fn neg_row(ref a) with !Mutate = {
  EfNeg(a)
    |> normalize_row
}

// Subsumption check: `body_row ⊆ gate_row`? One call services every compilation gate
// and every handler installation. No per-gate bit-flags. No intrinsic knowledge of
// effect-name semantics. The gates are subsumption queries applied at codegen:
//
//   Pure     → memoize / parallelize / compile-time evaluate
//   !IO      → safe for compile-time evaluation
//   !Alloc   → real-time / GPU / kernel
//   !Network → sandbox
//
// The same call services user-defined negations: `with !Logging` is one call away.
fn row_subsumes(ref body_row, ref gate_row) with !Mutate = {
  match gate_row {
    EfPure =>
      match body_row {
        EfPure => true,
        EfClosed(names) => len(names) == 0,
        _ => false
      },
    EfClosed(gate_names) =>
      match body_row {
        EfPure => true,
        EfClosed(body_names) => list_subset_str(body_names, gate_names),
        _ => false
      },
    EfOpen(gate_names, _) =>
      match body_row {
        EfPure => true,
        EfClosed(body_names) => list_subset_str(body_names, gate_names),
        EfOpen(body_names, _) => list_subset_str(body_names, gate_names),
        _ => false
      },
    EfNeg(inner) =>
      // body ⊆ !inner means body ∩ inner = ∅
      match body_row {
        EfPure => true,
        EfClosed(body_names) =>
          match inner {
            EfClosed(neg_names) => list_disjoint(body_names, neg_names),
            EfPure => true,     // body ⊆ !Pure: body has no Pure effects — vacuously true
            _ => false
          },
        _ => false
      },
    EfSub(_, _) =>
      // Intermediate form — normalize to resolved shape, then re-check.
      // Both sides must normalize: body_row may also carry intermediates.
      row_subsumes(normalize_row(body_row), normalize_row(gate_row)),
    EfInter(_, _) =>
      // Intermediate form — same: normalize both, then re-check.
      row_subsumes(normalize_row(body_row), normalize_row(gate_row))
  }
}

// Unify two effect rows, writing bindings through `graph_bind_row` (spec 04 / spec 01).
// Spec 01 unification table:
//
//   Pure/Pure           → ok
//   Pure/Closed(∅)      → ok
//   Pure/Closed(≠∅)     → E_PurityViolated
//   Pure/Open(∅,v)      → bind v to EfPure
//   Closed(A)/Closed(B) → ok iff A = B as sets
//   Closed(A)/Open(B,v) → bind v to Closed(A - B)
//   Open(A,v1)/Open(B,v2) → if v1=v2, unify names; else bind v1 to Open(B-A, v2)
//   Neg / Sub / Inter   → normalize first, re-dispatch
fn unify_row(ref a, ref b, ref span, ref reason) with !Mutate = {
  unify_row_canonical(normalize_row(resolve_row(a)),
                      normalize_row(resolve_row(b)), span, reason)
}

// UNIFY IS UNION-FIND at the row sort too (b4a98e2 landed the law for
// types; rows never got it). An EfOpen whose var is already BOUND must
// resolve to its ROOT before any arm runs — the old surface-bind
// OVERWROTE a bound var's row (walk3's 8629: Closed[It3] from the
// declared enforcement, clobbered at drive3's call-site unification
// with a residual built from inline names only — It3 discarded, chase
// running to a free terminal, escaping rows empty, bare calls, the
// strict scan's trap). Resolution folds the chain's names forward and
// lands on the terminal var, so binds only ever hit FREE terminals.
fn resolve_row(row) with !Mutate = match row {
  EfOpen(names, v) => {
    let GNode(kind, _) = graph_chase(v)
    match kind {
      NRowBound(inner) => match resolve_row(inner) {
        EfPure           => closed_or_pure(names),
        EfClosed(more)   => closed_or_pure(name_set_union(names, more)),
        EfOpen(more, v2) => EfOpen(name_set_union(names, more), v2),
        other            => other
      },
      _ => row
    }
  },
  _ => row
}

fn unify_row_canonical(ref a, ref b, ref span, ref reason) with !Mutate = {
  match a {
    EfPure =>
      match b {
        EfPure => (),
        EfClosed(names) =>
          if len(names) == 0 { () }
          else { report_purity_mismatch(b, span) },
        EfOpen(names, v) =>
          if len(names) == 0 {
            graph_bind_row(v, EfPure, Located(span, reason))
          } else {
            report_purity_mismatch(b, span)
          },
        _ => unify_row_canonical(a, normalize_row(b), span, reason)
      },
    EfClosed(na) =>
      match b {
        EfPure =>
          if len(na) == 0 { () }
          else { report_purity_mismatch(a, span) },
        EfClosed(nb) =>
          if list_eq_str(na, nb) { () }
          else { report_effect_mismatch(a, b, span) },
        EfOpen(nb, v) => {
          // Closed(A) ~ Open(B, v) → bind v to Closed(A - B)
          let residual = list_diff_str(na, nb) |> closed_or_pure
          graph_bind_row(v, residual, Located(span, reason))
        },
        _ => unify_row_canonical(a, normalize_row(b), span, reason)
      },
    EfOpen(na, va) =>
      match b {
        EfPure =>
          if len(na) == 0 {
            graph_bind_row(va, EfPure, Located(span, reason))
          } else {
            report_purity_mismatch(a, span)
          },
        EfClosed(nb) => {
          // Open(A, v) ~ Closed(B) → bind v to Closed(B - A)
          let residual = list_diff_str(nb, na) |> closed_or_pure
          graph_bind_row(va, residual, Located(span, reason))
        },
        EfOpen(nb, vb) =>
          if va == vb {
            if list_eq_str(na, nb) { () }
            else { report_effect_mismatch(a, b, span) }
          } else {
            let residual_names = list_diff_str(nb, na)
            graph_bind_row(va, EfOpen(residual_names, vb), Located(span, reason))
          },
        EfNeg(inner) =>
          // Open(A, v) ~ !B: the open tail must equal the negative capability
          // `!B` (universe-minus-B). SOUND modal closure (PLAN §4③) realized
          // through the row representation, NOT a patch to unify: bind v to the
          // NEGATION itself (`EfNeg(B)`), so the var CARRIES the forbidden set
          // forward — generalize quantifies it, instantiate freshens it (the
          // graph already crosses EfNeg in free_in_row/subst_row), and a
          // downstream unification that tries to widen v to include an effect
          // in B fails at the EfNeg arm. A's known names must be disjoint from
          // B (A holds no forbidden effect), else the `!B` stance is violated
          // at the install — the higher-order leak Koka omits negation to dodge.
          bind_open_to_neg(va, na, inner, span, reason),
        _ => unify_row_canonical(a, normalize_row(b), span, reason)
      },
    EfNeg(inner_a) =>
      match b {
        EfNeg(inner_b) =>
          // !A ~ !B => A ~ B
          unify_row_canonical(inner_a, inner_b, span, reason),
        // `!A ~ Open(B, v)`: symmetric to the open-against-neg case above —
        // bind v to carry the negation; the open tail becomes the negative
        // capability. The known names B must be disjoint from A.
        EfOpen(nb, vb) => bind_open_to_neg(vb, nb, inner_a, span, reason),
        // `!A` is universe-minus-A — an infinite set; a finite Closed/Pure row
        // can never EQUAL it (unification is structural equality, not
        // subsumption). The forbidden-set check is the subsumption gate
        // (row_subsumes), not unify.
        EfPure => report_effect_mismatch(a, b, span),
        EfClosed(_) => report_effect_mismatch(a, b, span),
        _ => unify_row_canonical(a, normalize_row(b), span, reason)
      },
    _ => unify_row_canonical(normalize_row(a), b, span, reason)
  }
}

// `Open(known, v) ~ !inner`: bind the open row var to the negation so the
// var CARRIES the forbidden set forward (the modal lexical-capability stance,
// PLAN §4③, threaded through the existing EfOpen var — the graph is the
// ROUTE). The known names must be disjoint from inner's forbidden set, else
// the row already holds an effect `!inner` forbids — surface it, never bind a
// contradictory capability. `inner` is normalized before reading its names so
// EfSub/EfInter reduce to the forbidden closed set first.
fn bind_open_to_neg(va, ref known, ref inner, ref span, ref reason) with !Mutate = {
  let forbidden = row_forbidden_names(normalize_row(inner))
  if list_disjoint(known, forbidden) {
    graph_bind_row(va, EfNeg(normalize_row(inner)), Located(span, reason))
  } else {
    report_effect_mismatch(EfOpen(known, va), EfNeg(inner), span)
  }
}

// The effect names a negation `!inner` forbids. EfPure forbids none (`!Pure`
// is the universe); a closed/open inner forbids its known names. A nested
// negation (`!!E`) double-collapses in normalize before this is reached.
fn row_forbidden_names(ref inner) with !Mutate = {
  match inner {
    EfPure          => [],
    EfClosed(names) => names,
    EfOpen(names, _) => names,
    EfNeg(_)        => [],
    EfSub(_, _)     => [],
    EfInter(_, _)   => []
  }
}

// The effect names a row ADMITS at a position — the positive companion to
// row_forbidden_names. A closed/open row admits its known names; a negation
// `!inner` admits NONE of inner's names (it forbids them — read those via
// row_forbidden_names); a difference/intersection reduces in normalize_row
// before this is reached. The synth gate (Context's live row, PLAN §4⑥) reads
// admit via this and forbid via row_forbidden_names — both projections of the
// ONE row the graph bound, no lossy [EffName] re-derivation at the cursor.
fn row_admits(ref row) with !Mutate = {
  match normalize_row(row) {
    EfPure          => [],
    EfClosed(names) => names,
    EfOpen(names, _) => names,
    EfNeg(_)        => [],
    EfSub(a, _)     => row_admits(a),
    EfInter(a, _)   => row_admits(a)
  }
}

fn report_purity_mismatch(ref actual, ref span) with !Mutate =
  report(EPurityViolated(actual, span))

fn report_effect_mismatch(ref a, ref b, ref span) with !Mutate =
  report(EEffectMismatch(a, b, span))

// Handler absorption: `handle { body with E } { arms for F }` normalizes to
// `(E - F) + arm_row`. Algebra falls out.
//
// Flow-edge: `union_row` keeps the FIRST open arg's rowvar. `extra_row` (the
// handler's residual) carries the polymorphic escaping tail (its config effects);
// `(body − handled)`'s rowvar carries the now-HANDLED body effects. The residual
// goes FIRST so the poly tail survives and the handled-effect rowvar is dropped —
// else the installing fn's row reads live as the handled effect and loses its
// argument's effect (the higher-order-effect trap).
fn absorb_row(ref body_row, ref handled_row, ref extra_row) with !Mutate = {
  body_row
    |> diff_row(??, handled_row)
    |> (handled_residue) => union_row(extra_row, handled_residue)
}

// Ground-row predicate: a row with no unresolved row variables. Ground rows let lowering
// emit direct `call $h_op` (spec 05); non-ground rows take the evidence-passing path.
fn row_is_ground(ref row) with Pure = {
  match row {
    EfPure           => true,
    EfClosed(_)      => true,
    EfOpen(_, _)     => false,
    EfNeg(inner)     => row_is_ground(inner),
    EfSub(a, b)      => row_is_ground(a) && row_is_ground(b),
    EfInter(a, b)    => row_is_ground(a) && row_is_ground(b)
  }
}

// Set operations on sorted string lists
// All operate on sorted, deduplicated string lists (effect name sets).
// Local to this module; kept here because the algebra depends on
// exactly this set model.

// Effect-name set ops — sorted-flat substrate (W8.2)
// All effect-name set arithmetic routes through std/runtime/strings.mn
// sorted-set primitives. The local names below are thin adapters that
// canonicalize at the boundary (sort + dedup) so callers don't need
// to audit upstream constructors. Once every EffRow builder maintains
// the sort invariant by construction, the canonicalize calls drop
// out and the substrate runs at O(N+M) with O(log N) membership.

// Phase-A2: every EffRow construction routes through mk_ef_closed /
// mk_ef_open, so name lists arriving at these adapters are
// sort-invariant by construction. The boundary canonicalize calls
// have been dropped — adapters delegate directly to the substrate
// primitives at full O(N+M) merge / O(log N) membership.
//
// `sort_unique` retains its name as a documentation handle (it IS
// set_canonicalize, used by external callers like normalize_row when
// raw input arrives from the parser). For invariant-maintaining
// algebraic ops (union/intersect/diff/etc.), use the set_* names
// directly.

// (string-set adapters retained for non-row callers — none today)

fn sort_unique(ref names) with !Mutate = name_set_canonicalize(names)

fn list_intersect(ref a, ref b) with !Mutate = name_set_intersect(a, b)
fn list_diff_str(ref a, ref b) with !Mutate = name_set_diff(a, b)
fn list_subset_str(ref sub, ref sup) with !Mutate = name_set_subset(sub, sup)
fn list_disjoint(ref a, ref b) with !Mutate = name_set_disjoint(a, b)
fn list_eq_str(ref a, ref b) with !Mutate = name_set_eq(a, b)
fn string_in_list(ref lst, ref s) with !Mutate = name_set_contains(lst, s)

// EffName equality is the ONE structural `==` (the value-layer fold's sum-eq
// leaf, §5.U) — type-dispatched at emit, total over the five node-kinds, so
// `ENamed`'s string / `EParameterized`'s (name, args) / `EPure` all compare by
// shape with no hand-rolled comparator. The former eff_name_eq / eff_args_eq /
// eff_arg_eq were its drift-7 twins (and their `match a` fell through to a trap
// on a null the fold tag-compares past). One equality; per SYNTAX §Parameterized
// effect (structural for compound args). A parameterized effect carries ONE
// shared type var per instance (register_one_op / register_effect_ops), so a row
// never holds two different-var `Iterate` entries — `==` dedups them exactly as
// the old EAType-always-equal boundary did. (peer Hβ.effects.parameterized-
// effect-row-dedup verifies the shared-var invariant at the value gate.)

// Row-name set algebra
// [EffName] SET ops — a row IS a set, so membership (name_set_contains, a
// linear eff_name_eq scan) is the ONE operation: subset / subsumption /
// equality (len + mutual-subset) and dedup all read through it, order-
// independent. No canonical order is imposed because no consumer reads one —
// equality is order-free (name_set_eq) and ev-slots are key-addressed, not
// positional (lower.mn derive_ev_slots). So the sorted insert (make_list(n+1)
// + copy + shift + eff_name_lt — the null's trap site) is DISSOLVED: the
// drift-7 twin of runtime/strings.mn's string-set collapses to one membership,
// and the sort — a canonical order no reader consumes — is the re-derivation
// the Carried-Truth Law deletes (§4①: one ordered-keyed-set operation).

// Set builds are BUFFER-COUNTER (§9): one make_list at the max size, a
// write-cursor appends, one slice at the end. The insert-per-element form
// copied the whole accumulator per step — at row sizes the asymptotics are
// moot (rows are small), but the copy VOLUME ran millions of times per
// pass; this family is on the inf_add_row hot path.
fn name_set_canonicalize(ref names) with !Mutate = {
  let n = len(names)
  name_set_dedup_into(names, 0, n, make_list(n), 0)
}

fn name_set_dedup_into(ref names, i, n, own buf, count) with !Mutate = {
  if i >= n { slice(buf, 0, count) }
  else {
    let x = list_index(names, i)
    if name_set_prefix_contains(buf, count, x) {
      name_set_dedup_into(names, i + 1, n, buf, count)
    } else {
      name_set_dedup_into(names, i + 1, n, list_set(buf, count, x), count + 1)
    }
  }
}

// Membership against the WRITTEN PREFIX of a buffer under construction.
fn name_set_prefix_contains(ref buf, count, ref name) with !Mutate = {
  name_set_prefix_contains_loop(buf, name, 0, count)
}

fn name_set_prefix_contains_loop(ref buf, ref name, i, n) with !Mutate = {
  if i >= n { false }
  else if list_index(buf, i) == name { true }
  else { name_set_prefix_contains_loop(buf, name, i + 1, n) }
}

// Insert = dedup-then-append; the one remaining single-element write (the
// bulk paths below build whole sets in one buffer).
fn name_set_insert(ref sorted, ref name) with !Mutate =
  if name_set_contains(sorted, name) { sorted }
  else {
    let n = len(sorted)
    list_set(list_copy_into(sorted, make_list(n + 1), 0, n), n, name)
  }

fn name_set_union(ref a, ref b) with !Mutate = {
  let na = len(a)
  let nb = len(b)
  let buf = make_list(na + nb)
  let ca = name_set_dedup_count(a, 0, na, buf, 0)
  name_set_union_rest(b, 0, nb, buf, ca)
}

// Phase 1 of union: dedup a into the buffer, RETURN the raw (buf-mutating)
// count — the caller continues appending into the same buffer.
fn name_set_dedup_count(ref names, i, n, own buf, count) with !Mutate = {
  if i >= n { count }
  else {
    let x = list_index(names, i)
    if name_set_prefix_contains(buf, count, x) {
      name_set_dedup_count(names, i + 1, n, buf, count)
    } else {
      name_set_dedup_count(names, i + 1, n, list_set(buf, count, x), count + 1)
    }
  }
}

fn name_set_union_rest(ref b, i, n, own buf, count) with !Mutate = {
  if i >= n { slice(buf, 0, count) }
  else {
    let x = list_index(b, i)
    if name_set_prefix_contains(buf, count, x) {
      name_set_union_rest(b, i + 1, n, buf, count)
    } else {
      name_set_union_rest(b, i + 1, n, list_set(buf, count, x), count + 1)
    }
  }
}

fn name_set_intersect(ref a, ref b) with !Mutate = {
  let n = len(a)
  name_set_intersect_into(a, b, 0, n, make_list(n), 0)
}

fn name_set_intersect_into(ref a, ref b, i, n, own buf, count) with !Mutate = {
  if i >= n { slice(buf, 0, count) }
  else {
    let x = list_index(a, i)
    if name_set_contains(b, x) {
      name_set_intersect_into(a, b, i + 1, n, list_set(buf, count, x), count + 1)
    } else {
      name_set_intersect_into(a, b, i + 1, n, buf, count)
    }
  }
}

fn name_set_diff(ref a, ref b) with !Mutate = {
  let n = len(a)
  name_set_diff_into(a, b, 0, n, make_list(n), 0)
}

fn name_set_diff_into(ref a, ref b, i, n, own buf, count) with !Mutate = {
  if i >= n { slice(buf, 0, count) }
  else {
    let x = list_index(a, i)
    if name_set_contains(b, x) {
      name_set_diff_into(a, b, i + 1, n, buf, count)
    } else {
      name_set_diff_into(a, b, i + 1, n, list_set(buf, count, x), count + 1)
    }
  }
}

fn name_set_subset(ref sub, ref sup) with !Mutate = {
  name_set_subset_loop(sub, sup, 0, len(sub))
}

fn name_set_subset_loop(ref sub, ref sup, i, n) with !Mutate = {
  if i >= n { true }
  else if name_set_contains(sup, list_index(sub, i)) {
    name_set_subset_loop(sub, sup, i + 1, n)
  } else { false }
}

fn name_set_disjoint(ref a, ref b) with !Mutate = {
  name_set_disjoint_loop(a, b, 0, len(a))
}

fn name_set_disjoint_loop(ref a, ref b, i, n) with !Mutate = {
  if i >= n { true }
  else if name_set_contains(b, list_index(a, i)) { false }
  else { name_set_disjoint_loop(a, b, i + 1, n) }
}

fn name_set_eq(ref a, ref b) with !Mutate = {
  if len(a) != len(b) { false }
  else { name_set_subset(a, b) }
}

fn name_set_contains(ref set, ref name) with !Mutate = {
  name_set_contains_loop(set, name, 0, len(set))
}

fn name_set_contains_loop(ref set, ref name, i, n) with !Mutate = {
  if i >= n { false }
  // Structural `==` (the value-layer fold's sum-eq leaf, §5.U) — the ONE
  // equality, type-dispatched at emit; the hand-rolled eff_name_eq was its
  // drift-7 twin (and its `match a` fell through to a trap on a null, where the
  // fold tag-compares). EffName IS a sum; `==` recurses ENamed's string /
  // EParameterized's args / EPure by shape.
  else if list_index(set, i) == name { true }
  else { name_set_contains_loop(set, name, i + 1, n) }
}

// Statically proves FV.1.γ (Lone Effect Negation). Declares `with !Mutate`; the
// compiler's own type inference infers its row as EfNeg(Closed([Mutate])) rather than
// collapsing to EfPure. The compiler type-checking itself is the test.
fn test_mutate_freeze(buffer: ValidSpan) with !Mutate = buffer
