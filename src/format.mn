// format.mn — canonical-render handler · the medium handles formatting
//
// The substrate-honest answer to "what about indent / tabs / 2-space-
// vs-4-space?": the formatter renders the cursor's projection back to
// disk in canonical form. The developer types meaning; the editor
// renders properly; the file on disk is canonical regardless of what
// the developer typed. Same source, same bytes, every save.
//
// Layout is projection, never contract (chain-link-5): the parser
// tolerates any structurally-
// valid indent (relative ordering of verb-vs-operand suffices); the
// formatter normalizes column counts. Indent is a render decision, not
// a parse contract — the same chain-link-5 realization at the layout
// layer that earlier closed `with EXPR` parsing and the seed's
// ident-fabrication.
//
// The formatter IS a `~>` handler on the cursor — same kernel primitive
// as every other tentacle. Composes:
//
//   keystroke
//     |> tokenize
//     |> parse_to_graph
//     ~> format_default        // canonical render before display
//     ~> render_to_transport   // terminal / LSP frame / web
//       <~ accumulate(graph)   // IC re-renders on next keystroke
//
// Five verbs realized inside the formatter itself: each rendering
// pipeline composes |> sequentially, ~> attaches per-form handlers,
// <| fans out per-form rendering, >< parallelizes independent
// sub-renders, <~ closes on stability (canonical form is a fixpoint —
// running format twice IS the same as running once).
//
// SYNTAX.md §1185 governs the canonical layout. Authority:
// - SYNTAX.md §342-389 (per-verb layout rules)
// - SYNTAX.md §1142-1186 (layout enforcement)
// - protocol_cursor_is_argmax.md
// - protocol_parse_is_eager_graph_projection.md

import types
import effects
import graph

// ─── The Format effect ──────────────────────────────────────────────
//
// Three ops:
//   format_program — render the whole AST as canonical String
//   format_at_handle — render one node + canonical-spaced surroundings
//   format_chain — render a single |> / ~> / <| / >< / <~ chain
//
// Resume cardinality is INFERRED from arm body structure per Phase B
// substrate (CLAUDE.md ⌁ Mentl's anchor — interrogation #2).
// format_default arms call resume exactly once → OneShot.

effect Format {
  format_program([Node]) -> String
  format_at_handle(Int) -> String
  format_chain(Node) -> String
}

// ─── format_default — canonical render handler ──────────────────────
//
// `with !Mutate` — read-only over graph + AST; same constraint as
// cursor_default + interrogate_default per the read-only-projection
// discipline.
//
// Each arm composes the five verbs in its own rendering logic:
//   <|  per-node-kind branches (each NodeBody variant gets its own
//       render branch; the eight aspects of the cursor's projection
//       fan out into eight render-aspect branches)
//   ><  parallel sub-render (independent siblings render concurrently)
//   |>  sequential through tokenize → indent → emit
//   ~>  buffer handler attaches output sink
//   <~  fixpoint check (running format twice = running once)
//
// Drift refused: 1 (no dispatch table; render IS graph projection); 6
// (no primitive special-case — each NodeBody variant is one branch
// of the same fanout); 7 (one record per RenderResult, not parallel-
// arrays); 9 (every NodeBody variant bodied; no "later").

handler format_default with !Mutate {

  // ─── format_program — top-level render ────────────────────────────
  //
  // The whole AST renders by walking top-level statements through |>,
  // each statement individually formatted via format_at_handle, and
  // the results joined with newline separators. Pure rendering — no
  // graph mutation, no side effects beyond the output String.

  format_program(ast) => {
    let stmts = ast_top_level_stmts(ast)
    let rendered =
      stmts
        |> map((s) => format_one_stmt(s))
    resume(join_lines(rendered))
  },

  // ─── format_at_handle — render one node ───────────────────────────
  //
  // The render-aspects of the formatter at one position fan out via <|.
  // `(node, kind, ctx)` is borrowed (read-only) to SEVEN render-aspect
  // branches: tokens, indent, line_break, comment, span, reason, sibling.
  // "doc" is NOT a separate aspect — `//`-vs-`///` dissolved to ONE comment
  // (SYNTAX.md comment-dissolution), so prose is the single `comment` aspect.
  // This IS the eight-arms-of-one-read (PLAN §2) projected to render: not
  // every kernel arm produces a distinct render branch. Outputs tuple
  // together; assemble_render composes them into the canonical String.

  format_at_handle(handle) => {
    // Handle-based throughout: the body reads via graph_node_body (the
    // same projection the parent scan uses) — the old `graph_node_at(h)`
    // one-arg call typechecked against an op binding while the
    // direct-call tier emitted the two-arg raw fn, an op/fn name
    // collision that only surfaced when this arm gained its first
    // installer (the fmt verb).
    let body = graph_node_body(handle)
    let ctx = render_context_at(handle)
    let pos = (body, handle, ctx)
    let (tokens, indent, line_break, comment, span, reason, sibling) =
      pos
        <| (
          ((b, _, _))  => render_body_tokens(b),                     // 1. tokens
          ((b, _, c))  => render_indent_for(b, c),                   // 2. indent (canonical)
          ((b, _, _))  => render_line_break_after(b),                // 3. line break
          ((_, h, _))  => render_comment_at(h),                      // 4. the one comment, read live from the weave
          ((_, _, _))  => "",                                        // 5. span (debug only)
          ((_, h, _))  => render_reason_at(h),                       // 6. reason (debug)
          ((_, _, c))  => render_sibling_separator(c)                // 7. sibling glue
        )
    let assembled = assemble_render(tokens, indent, line_break, comment, span, reason, sibling)
    resume(assembled)
  },

  // ─── format_chain — render one verb-chain ─────────────────────────
  //
  // Distinguishes the five verb-classes; each gets canonical layout
  // per SYNTAX.md §342-389. `<|` opens-tuple-on-same-line with branches
  // indented. `><` alone-on-line at indented center between paren-
  // pipelines. `<~` indented center, optionally inline. `|>` and `~>`
  // at left edge with stages on indented lines.

  format_chain(chain_node) => {
    let kind = ast_kind_of(chain_node)
    // ast_kind_of projects the NodeBody altitude — the Expr sits one
    // constructor in (NExpr(PipeExpr(..))); the bare-Expr arms never
    // matched and every chain fell to the non-chain render (order-masked;
    // the order-independent judge named it, 2026-07-25).
    let rendered = match kind {
      NExpr(PipeExpr(PForward, l, r))            => render_converge_chain(l, r),  // |>
      // `<|`/`><` are ONE PFanout; the formatter projects the glyph from
      // the ownership aspect — FanShare → `<|`, FanDistribute → `><` (the
      // surface keeps both authored glyphs as intent).
      NExpr(PipeExpr(PFanout(FanShare), l, r))      => render_diverge_chain(l, r),   // <|
      NExpr(PipeExpr(PFanout(FanDistribute), l, r)) => render_compose_chain(l, r),   // ><
      NExpr(PipeExpr(PTee, l, r))        => render_tee(l, r),             // ~>
      NExpr(PipeExpr(PFeedback, l, r))   => render_feedback_chain(l, r),  // <~
      _                            => render_non_chain(chain_node)
    }
    resume(rendered)
  }
}

// ─── Canonical layout constants (SYNTAX.md §1185) ───────────────────
//
// 2-space indent for left-edge verbs (|>, ~>, <|).
// 4-space indent for indented-center convergent verbs (><, <~).
// Tabs convert to spaces at format time.

fn left_edge_indent() with Pure = 2
fn indented_center() with Pure = 4

// ─── Render a |> chain — sequential left-edge ───────────────────────
//
// canonical layout per SYNTAX.md §342-346:
//
//   input
//     |> stage_a
//     |> stage_b
//
// Input on its own line at base indent; |> at base + 2; stages on
// the same line as their |>. The chain reads top-to-bottom = data flow.

fn render_converge_chain(left, right) with Format + !Mutate = {
  let left_str = format_chain(left)
  let right_str = format_chain(right)
  "{left_str}\n{spaces(left_edge_indent())}|> {right_str}"
}

// ─── Render a <| chain — divergence with branch tuple ───────────────
//
// Canonical per SYNTAX.md §362-368:
//
//   input
//     <| (
//       branch_a,
//       branch_b,
//       branch_c,
//     )
//
// Input on its own line; <| on the next line at +2 indent with `(`
// on the same line; branches at +4 indent with trailing commas; `)`
// at +2 indent (aligned with <|). The shape draws the fanout topology.

fn render_diverge_chain(input, branches_tuple) with Format + !Mutate + Memory + Alloc = {
  let input_str = format_chain(input)
  let branches = render_branch_tuple(branches_tuple)
  "{input_str}\n{spaces(left_edge_indent())}<| (\n{branches}\n{spaces(left_edge_indent())})"
}

// ─── Render a >< chain — parallel composition ───────────────────────
//
// Canonical per SYNTAX.md §390-405:
//
//   (pipeline_a)
//       ><
//   (pipeline_b)
//
// Each branch parenthesized at base indent; >< alone on its line at
// indented center (4-space). The shape is two columns met at center —
// the parallel-merge topology.

fn render_compose_chain(left, right) with Format + !Mutate = {
  let left_str = format_chain(left)
  let right_str = format_chain(right)
  "{parenthesize(left_str)}\n{spaces(indented_center())}><\n{parenthesize(right_str)}"
}

// ─── Render a ~> chain — handler-attach ────────────────────────────
//
// One PTee node; layout is the formatter's projection of the LHS
// shape (layout is never semantics — SYNTAX.md §~>). A chain body
// earns the block layout, ~> on its own line at left-edge indent:
//
//   source
//     |> lex
//     |> parse
//     ~> env_handler          // governs the whole prior chain
//     ~> diagnostics_handler  // outermost — sandbox boundary
//
// A single-stage body renders inline — same tree, same scope:
//
//   (try_fn()) ~> catch_abort

fn render_tee(body, handler_expr) with Format + !Mutate = {
  let body_str = format_chain(body)
  let handler_str = format_chain(handler_expr)
  match ast_kind_of(body) {
    NExpr(PipeExpr(_, _, _)) =>
      "{body_str}\n{spaces(left_edge_indent())}~> {handler_str}",
    _ =>
      "{body_str} ~> {handler_str}"
  }
}

// ─── Render a <~ chain — feedback / iterative ──────────────────────
//
// Canonical per SYNTAX.md §483-489:
//
//   signal
//       <~ delay(3)
//
// <~ at indented center (4-space) with the FeedbackSpec on the same
// line. Requires iterative context (Sample / Tick / Clock / IC handler
// installed upstream); without it, parser rejects with E_FeedbackNoContext.

fn render_feedback_chain(input, spec) with Format + !Mutate = {
  let input_str = format_chain(input)
  let spec_str = format_chain(spec)
  "{input_str}\n{spaces(indented_center())}<~ {spec_str}"
}

// ─── Multi-source format — map over an AST list ─────────────────────
//
// The DELETED format_pair (binary special-case) was erased per
// `feedback_fully_as_early.md`: callers compose
// `map(format_program, asts)` directly. `format_program` itself
// already maps over top-level statements (line 93); the same stage
// composes at the multi-source level. Drift 6 erasure.

// ─── format_ic_loop — `<~` IC fixpoint on canonical-form stability ─
//
// The formatter's idempotency: format(format(x)) == format(x). The IC
// loop closes when the rendered form stabilizes (one iteration after
// initial — canonical IS the fixpoint). Per protocol_oracle_is_ic.md:
// build IS the <~ loop. Composing format with IC means save-time
// auto-formatting is just one iteration of this loop.

fn format_ic_loop(initial_ast) with Format + IC + !Mutate = {
  initial_ast
    |> (ast) => format_program(ast)
    ~> format_default
      <~ accumulate(empty_render())
}

fn empty_render() with Pure = ""

// ─── Helper functions — pure transforms over String ────────────────

fn spaces(n) with Pure = {
  if n == 0 { "" }
  else { " {spaces(n - 1)}" }
}

fn parenthesize(s) with Pure = {
  "({s})"
}

// Head-first join: parser lists are source-ordered (built `[x] ++ rest`),
// so iteration walks index 0 upward — the last/drop_last form rendered
// every list REVERSED, unseen because this module had zero callers.
fn join_lines(lines) with Memory = join_lines_from(lines, 0)

fn join_lines_from(ref lines, i) with Memory = {
  if i >= len(lines) { "" }
  else if i == len(lines) - 1 { lines[i] }
  else { "{lines[i]}\n{join_lines_from(lines, i + 1)}" }
}

// ─── Render-aspect helpers — one per cursor-projection lens ────────

// render_tokens_for IS the parser's inverse: a per-NodeBody projection that
// emits the canonical token text the parser would re-consume to the SAME graph
// (format∘parse = identity). Each AST variant reads its child nodes live and
// renders them recursively — the formatter shares the surface SYNTAX.md binds,
// so the bytes round-trip. No "node@42" placeholder.
fn render_tokens_for(node) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  let N(body, _, _) = node
  render_body_tokens(body)
}

fn render_body_tokens(body) with GraphRead + Memory + Alloc + !Mutate + Intern = match body {
  NExpr(e)     => render_expr_tokens(e),
  NStmt(s)     => render_stmt_tokens(s),
  NPat(p)      => render_pat_tokens(p),
  NHole(_)     => "??",
  NModule(m)   => "// module {m.path}",
  NTypeAnn(ty) => show_type(ty)
}

fn render_expr_tokens(e) with GraphRead + Memory + Alloc + !Mutate + Intern = match e {
  LitInt(n)        => int_to_str(n),
  LitFloat(f)      => float_to_str(f),
  LitString(s)     => "\"{escape_string_content(s)}\"",
  LitBool(b)       => if b { "true" } else { "false" },
  LitUnit          => "()",
  VarRef(name)     => name,
  BinOpExpr(op, l, r) =>
    "{render_operand(l, binop_prec(op), false)} {binop_to_str(op)} {render_operand(r, binop_prec(op), true)}",
  UnaryOpExpr(op, x) => "{unary_op_glyph(op)}{render_operand(x, 90, true)}",
  CallExpr(callee, args) =>
    "{render_tokens_for(callee)}({render_node_list(args, ", ")})",
  LabeledArg(label, v) => "{label} = {render_tokens_for(v)}",
  FieldExpr(recv, field) => "{render_tokens_for(recv)}.{field}",
  IndexExpr(recv, idx)   => "{render_tokens_for(recv)}[{render_tokens_for(idx)}]",
  PipeExpr(verb, l, r) =>
    "{render_tokens_for(l)} {show_pipe_kind(verb)} {render_tokens_for(r)}",
  IfExpr(c, t, el) =>
    "if {render_tokens_for(c)} \{ {render_tokens_for(t)} \} else \{ {render_tokens_for(el)} \}",
  MakeListExpr(elems)  => "[{render_node_list(elems, ", ")}]",
  MakeTupleExpr(elems) => "({render_node_list(elems, ", ")})",
  ExprPlaceholder      => "??",
  BlockExpr(stmts, final) =>
    "\{\n{render_block_stmts(stmts, 0)}  {render_tokens_for(final)}\n\}",
  LambdaExpr(params, body) =>
    "({render_param_list(params)}) => {render_tokens_for(body)}",
  MakeRecordExpr(fields) => "\{{render_field_inits(fields, 0)\}}",
  NamedRecordExpr(tname, fields) =>
    "{tname}\{{render_field_inits(fields, 0)\}}",
  RecordUpdateExpr(base, fields) =>
    "\{...{render_tokens_for(base)}, {render_field_inits(fields, 0)\}}",
  // Interpolation is the parse's inverse: literal chunks re-escape,
  // every other fragment renders as a live splice.
  MakeStringExpr(parts) => "\"{render_string_parts(parts, 0)}\"",
  MatchExpr(scrut, arms) =>
    "match {render_tokens_for(scrut)} \{\n{render_match_arms(arms, 0)\}}",
  ResumeExpr(v, updates) =>
    "{render_resume_head(v)}{render_state_updates(updates, 0)}"
}

fn render_stmt_tokens(s) with GraphRead + Memory + Alloc + !Mutate + Intern = match s {
  FnStmt(name, params, _retty, effs, body) =>
    "fn {name}({render_param_list(params)}){render_with_clause(effs)} = {render_tokens_for(body)}",
  ImportStmt(path)   => "import {path}",
  ExprStmt(e)        => render_tokens_for(e),
  AliasStmt(name, ty) => "type {name} = {show_type(ty)}",
  LetStmt(pat, value, ann) =>
    "let {render_pat_tokens(pat)}{render_let_ann(ann)} = {render_tokens_for(value)}",
  TypeDefStmt(name, variants) =>
    "type {name} = {render_variants(variants, 0)}",
  // Op param NAMES are parse-consumed (the ADT stores types only), and
  // bare types parse in op position — the render is the parse's inverse
  // over what the graph carries.
  EffectDeclStmt(name, ops) =>
    "effect {name} \{\n{render_effect_ops(ops, 0)\}}",
  HandlerDeclStmt(hname, _ename, config, states, arms) =>
    "handler {hname}{render_config_params(config)}{render_state_inits(states, 0)} \{\n{render_handler_arms(arms, 0)\}}",
  RefineStmt(name, ty, pred) =>
    "type {name} = {show_type(ty)} where {show_predicate(pred)}"
}

fn render_pat_tokens(p) with GraphRead + Memory + Alloc + !Mutate = match p {
  PVar(name)     => name,
  PWild          => "_",
  PCon(name, ps) =>
    if len(ps) == 0 { name }
    else { "{name}({render_pat_list(ps, ", ")})" },
  PLit(lv)       => render_lit_value(lv),
  PTuple(ps)     => "({render_pat_list(ps, ", ")})",
  PList(ps, rest) => "[{render_plist_inner(ps, rest)}]",
  PRecord(fields) => "\{{render_pat_fields(fields, 0)\}}",
  PAlt(ps)       => render_pat_list(ps, " | ")
}

// Every list renderer walks HEAD-FIRST (index 0 upward): parser lists are
// source-ordered, so the old last/drop_last walks rendered them reversed —
// unseen while this module had zero callers.
fn render_node_list(ref nodes, sep) with GraphRead + Memory + Alloc + !Mutate + Intern =
  render_node_list_from(nodes, 0, sep)

fn render_node_list_from(ref nodes, i, sep) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  if i >= len(nodes) { "" }
  else if i == len(nodes) - 1 { render_tokens_for(nodes[i]) }
  else { "{render_tokens_for(nodes[i])}{sep}{render_node_list_from(nodes, i + 1, sep)}" }
}

fn render_pat_list(ref pats, sep) with GraphRead + Memory + Alloc + !Mutate =
  render_pat_list_from(pats, 0, sep)

fn render_pat_list_from(ref pats, i, sep) with GraphRead + Memory + Alloc + !Mutate = {
  if i >= len(pats) { "" }
  else if i == len(pats) - 1 { render_pat_tokens(pats[i]) }
  else { "{render_pat_tokens(pats[i])}{sep}{render_pat_list_from(pats, i + 1, sep)}" }
}

// A param renders its AUTHORED intent boundaries — the ownership marker
// (TParam's authored slot, never the resolved one), the annotation when
// one was written (an unannotated param's ty is the parse-minted TVar —
// the structural discriminator), and the default. Dropping any of these
// on round-trip would change semantics the affine/refinement checks read.
fn render_param_list(ref params) with GraphRead + Memory + Alloc + !Mutate + Intern =
  render_param_list_from(params, 0)

fn render_param_list_from(ref params, i) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  if i >= len(params) { "" }
  else if i == len(params) - 1 { render_one_param(params[i]) }
  else { "{render_one_param(params[i])}, {render_param_list_from(params, i + 1)}" }
}

fn render_one_param(p) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  let marker = match param_authored(p) {
    Own      => "own ",
    Ref      => "ref ",
    Unmarked => ""
  }
  let ann = match param_ty(p) {
    TVar(_) => "",
    ty      => ": {show_type(ty)}"
  }
  let dflt = match param_default(p) {
    Some(d) => " = {render_tokens_for(d)}",
    None    => ""
  }
  "{marker}{param_name(p)}{ann}{dflt}"
}

// ─── Precedence-inverse parenthesization ────────────────────────────
//
// The render is the parse's inverse under the ONE precedence table
// (SYNTAX §Operator precedence), so an operand whose own precedence is
// LOOSER than its parent's — or equal on the right of a left-assoc
// operator — re-wraps in the parens the parse consumed. Without this,
// (a + b) * c re-rendered as a + b * c: both typecheck, only behavior
// tells — the fmt gate runs the program pre/post and compares exits.

fn render_operand(child, parent_prec, is_right) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  let cp = expr_prec_of(child)
  if cp < parent_prec || (cp == parent_prec && is_right) {
    "({render_tokens_for(child)})"
  } else {
    render_tokens_for(child)
  }
}

fn expr_prec_of(node) with GraphRead + Memory + !Mutate = match ast_kind_of(node) {
  NExpr(BinOpExpr(op, _, _)) => binop_prec(op),
  NExpr(PipeExpr(k, _, _))   => pipe_prec(k),
  NExpr(UnaryOpExpr(_, _))   => 90,
  NExpr(IfExpr(_, _, _))     => 15,
  NExpr(MatchExpr(_, _))     => 15,
  NExpr(LambdaExpr(_, _))    => 15,
  _                          => 100
}

// The literal SYNTAX table integers (op_prec's own values — one table,
// this is its render-side projection).
fn binop_prec(op) with Pure = match op {
  BMul    => 10,
  BDiv    => 10,
  BMod    => 10,
  BAdd    => 9,
  BSub    => 9,
  BConcat => 8,
  BLt     => 7,
  BGt     => 7,
  BLe     => 7,
  BGe     => 7,
  BEq     => 6,
  BNe     => 6,
  BAnd    => 5,
  BOr     => 4
}

fn pipe_prec(k) with Pure = match k {
  PForward    => 3,
  PFanout(_)  => 2,
  PFeedback   => 2,
  PTee        => 1
}

// ─── The totality helpers — one per structural form ─────────────────

// Re-escape string content to the surface escape set: the parse stored
// resolved bytes; the render is the parse's inverse, so a quote, brace,
// backslash, or control byte re-escapes (without this, format∘parse =
// identity was FALSE for any string carrying one — the wheel's own
// wat_emit lines included).
fn escape_string_content(s) with Memory + Alloc = {
  s
    |> (x) => replace(x, "\\", "\\\\")
    |> (x) => replace(x, "\"", "\\\"")
    |> (x) => replace(x, "\n", "\\n")
    |> (x) => replace(x, "\t", "\\t")
    |> (x) => replace(x, "{", "\\{")
    |> (x) => replace(x, "}", "\\}")
}

// Interior comments are graph content (the weave attaches them to the
// following statement) — the block render carries each statement's prose
// or the formatter would destroy it. A trailing same-line comment
// re-renders as a leading block: movement, not loss, and stable from the
// second pass (it re-parses as a leading comment).
fn render_block_stmts(ref stmts, i) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  if i >= len(stmts) { "" }
  else {
    let c = graph_comment_at(node_handle(stmts[i]))
    let cline = if c == "" { "" } else { "  //{replace(c, "\n", "\n  //")}\n" }
    "{cline}  {render_tokens_for(stmts[i])}\n{render_block_stmts(stmts, i + 1)}"
  }
}

fn render_field_inits(ref fields, i) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  if i >= len(fields) { "" }
  else {
    let (fname, v) = fields[i]
    let one = "{fname}: {render_tokens_for(v)}"
    if i == len(fields) - 1 { one }
    else { "{one}, {render_field_inits(fields, i + 1)}" }
  }
}

fn render_string_parts(ref parts, i) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  if i >= len(parts) { "" }
  else {
    let one = match ast_kind_of(parts[i]) {
      NExpr(LitString(s)) => escape_string_content(s),
      _                   => "\{{render_tokens_for(parts[i])\}}"
    }
    "{one}{render_string_parts(parts, i + 1)}"
  }
}

fn render_match_arms(ref arms, i) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  if i >= len(arms) { "" }
  else {
    let (pat, body) = arms[i]
    "  {render_pat_tokens(pat)} => {render_tokens_for(body)},\n{render_match_arms(arms, i + 1)}"
  }
}

fn render_resume_head(v) with GraphRead + Memory + Alloc + !Mutate + Intern = match ast_kind_of(v) {
  NExpr(LitUnit) => "resume()",
  _              => "resume({render_tokens_for(v)})"
}

fn render_state_updates(ref updates, i) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  if i >= len(updates) { "" }
  else {
    let u = updates[i]
    let one = "{u.name} = {render_tokens_for(u.init)}"
    let lead = if i == 0 { " with " } else { ", " }
    "{lead}{one}{render_state_updates(updates, i + 1)}"
  }
}

fn render_let_ann(ann) with GraphRead + Memory + Alloc + !Mutate + Intern = match ast_kind_of(ann) {
  NTypeAnn(ty) => ": {show_type(ty)}",
  _            => ""   // drift-audit: ignore — the ADT's own absence sentinel: LetStmt's ann node is LitUnit when unannotated (the LetStmt decl comment); any non-NTypeAnn body IS that absence, rendered as no clause
}

fn render_variants(ref variants, i) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  if i >= len(variants) { "" }
  else {
    let (vname, tys) = variants[i]
    let one = if len(tys) == 0 { vname } else { "{vname}({render_ty_list(tys, 0)})" }
    if i == len(variants) - 1 { one }
    else { "{one} | {render_variants(variants, i + 1)}" }
  }
}

fn render_ty_list(ref tys, i) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  if i >= len(tys) { "" }
  else if i == len(tys) - 1 { show_type(tys[i]) }
  else { "{show_type(tys[i])}, {render_ty_list(tys, i + 1)}" }
}

fn render_effect_ops(ref ops, i) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  if i >= len(ops) { "" }
  else {
    let (oname, ptys, rty) = ops[i]
    let ret = match rty {
      TUnit => "",
      t     => " -> {show_type(t)}"
    }
    "  {oname}({render_ty_list(ptys, 0)}){ret}\n{render_effect_ops(ops, i + 1)}"
  }
}

// Config is [TParam] — render each field as `name` or `name = default`
// (the product's default is authored surface, carried back verbatim;
// format∘parse identity over SYNTAX §«Default parameter values»).
fn render_config_params(ref config) with GraphRead + Intern + Memory + Alloc + !Mutate = {
  if len(config) == 0 { "" }
  else { "({render_config_list(config, 0)})" }
}

fn render_config_list(ref config, i) with GraphRead + Memory + Alloc + !Mutate = {
  if i >= len(config) { "" }
  else {
    let p = config[i]
    let one = match param_default(p) {
      Some(d) => "{param_name(p)} = {render_tokens_for(d)}",
      None    => param_name(p)
    }
    if i == len(config) - 1 { one }
    else { "{one}, {render_config_list(config, i + 1)}" }
  }
}

fn render_name_list(ref names, i) with Memory + Alloc = {
  if i >= len(names) { "" }
  else if i == len(names) - 1 { names[i] }
  else { "{names[i]}, {render_name_list(names, i + 1)}" }
}

fn render_state_inits(ref states, i) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  if i >= len(states) { "" }
  else {
    let st = states[i]
    let one = "{st.name} = {render_tokens_for(st.init)}"
    let lead = if i == 0 { " with " } else { ", " }
    "{lead}{one}{render_state_inits(states, i + 1)}"
  }
}

fn render_handler_arms(ref arms, i) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  if i >= len(arms) { "" }
  else {
    let a = arms[i]
    "  {a.op_name}({render_name_list(a.args, 0)}) => {render_tokens_for(a.body)},\n{render_handler_arms(arms, i + 1)}"
  }
}

fn render_lit_value(lv) with Memory + Alloc = match lv {
  LVInt(n)    => int_to_str(n),
  LVFloat(f)  => float_to_str(f),
  LVString(s) => "\"{escape_string_content(s)}\"",
  LVBool(b)   => if b { "true" } else { "false" }
}

fn render_plist_inner(ref ps, rest) with GraphRead + Memory + Alloc + !Mutate = {
  let prefix = render_pat_list(ps, ", ")
  match rest {
    Some(rname) =>
      if len(ps) == 0 { "...{rname}" } else { "{prefix}, ...{rname}" },
    None => prefix
  }
}

fn render_pat_fields(ref fields, i) with GraphRead + Memory + Alloc + !Mutate = {
  if i >= len(fields) { "" }
  else {
    let (fname, p) = fields[i]
    // Punning is the canonical form when the pattern binds the field's
    // own name (SYNTAX §records).
    let one = match p {
      PVar(n) => if n == fname { fname } else { "{fname}: {n}" },
      other   => "{fname}: {render_pat_tokens(other)}"
    }
    if i == len(fields) - 1 { one }
    else { "{one}, {render_pat_fields(fields, i + 1)}" }
  }
}

// The declared with-clause, rendered via the ONE canonical show_effrow. A Pure
// row carries no clause (the identity element — SYNTAX.md §175).
fn render_with_clause(effs) with GraphRead + Memory + Alloc + !Mutate + Intern = {
  if len(effs) == 0 { "" }
  else { " with {show_effrow(build_row_from_effs(effs))}" }
}

// effs is the parser's [EffName] list; the canonical row is the closed triple
// over it (mk_ef_closed canonicalizes the set — the Memory row is that dedup).
fn build_row_from_effs(effs) with Memory = mk_ef_closed(effs)

fn render_indent_for(kind, ctx) with Pure = {
  // Canonical indent depth per node kind. Match-arm bodies +2; let-
  // value at same indent as let; fn body +2 from fn signature; etc.
  // Each kind's indent is the PARENT's indent + verb-class offset.
  spaces(canonical_indent_depth(kind, ctx))
}

fn render_line_break_after(kind) with Pure = match kind {
  NStmt(_)              => "\n",
  NExpr(_)              => "",
  NPat(_)               => "",
  NHole(_)              => "",
  NModule(_)            => "\n",
  NTypeAnn(_)           => ""
}

// The one comment, read LIVE from the comment weave at the node's handle
// (graph_comment_at) — never a copied string. The weave stores the prose with
// leading // stripped, contiguous lines joined by \n; render restores the //
// prefix on every line (re-prefixing each internal newline via `replace`) and a
// trailing newline so the block leads the declaration. Empty string when the
// node carries no comment (an honest read, not a stub).
fn render_comment_at(h) with GraphRead + Memory + Alloc + !Mutate = {
  let text = graph_comment_at(h)
  if text == "" { "" }
  else { "//{replace(text, "\n", "\n//")}\n" }
}

// The reason aspect of the formatter's fanout: the handle chases to its
// GNode; the Reason renders via the ONE canonical show_reason (types.mn) —
// never a second compressed walk. Debug aspect — assemble_render decides
// placement (today: dropped from the assembled text).
fn render_reason_at(h) with GraphRead + !Mutate + Alloc + Memory + Intern = {
  let GNode(_, reason) = graph_chase(h)
  show_reason(reason)
}

// Sibling glue is a projection of RenderContext; the default context
// carries no sibling info (render_context_at's parent-walk substrate),
// so its separator is empty — an honest read, not a placeholder.
fn render_sibling_separator(ctx) with Pure = match ctx {
  RenderContextDefault  => "",
  RenderContextChain(_) => "",
  RenderContextBlock(_) => "",
  RenderContextTuple(_) => ""
}

// The row + Reason text projections are the ONE canonical renderers in
// types.mn (show_effrow / show_reason / show_eff_name / show_eff_arg /
// show_list) — never a second, weaker copy here. The format.mn duplicates
// were DELETED (show_row / show_reason_compressed / show_effname /
// show_effarg / show_joined): two renderers for one graph fact is the
// Carried-Truth violation at the render layer. LSP hover reads the canonical
// pair directly; the reason aspect above reads show_reason. "Compressed" is
// show_reason at a tighter register, not a second walk.

// render_context_at reads the node's PARENT live from the AST-in-graph fabric:
// the enclosing node is the weave entry whose body references this handle, so
// the chain/block/tuple depth is a live read of that edge chain (the parent IS
// an edge, not a missing index). canonical_indent_depth / sibling_separator
// project the 2-/4-space layout from this real position.
fn render_context_at(handle) with GraphRead + !Mutate + Memory = {
  let snapshot = graph_snapshot()   // drift-audit: ignore — sequenced effectful read (stream-consumer/checkpoint), CLAUDE.md Anchor 6 exclusion
  let Graph(next, _spans) = snapshot
  scan_for_render_parent(handle, 0, next)
}

fn scan_for_render_parent(target, i, n) with GraphRead + !Mutate + Memory = {
  if i >= n { RenderContextDefault }
  else {
    match render_context_from_parent(target, graph_node_body(i)) {
      RenderContextDefault => scan_for_render_parent(target, i + 1, n),
      found                => found
    }
  }
}

// Project the render context from a candidate parent body: a PipeExpr parent
// puts the target in a chain; a BlockExpr in a block; a tuple/list literal in
// a tuple. Depth is the parent's own enclosing depth + 1 (read by recursion at
// render time; the first enclosing edge is sufficient for the indent step).
fn render_context_from_parent(target, body) with Memory = match body {
  NExpr(PipeExpr(_, l, r)) =>
    if child_is(target, l) || child_is(target, r) {
      RenderContextChain(1)
    } else { RenderContextDefault },
  NExpr(BlockExpr(_, final)) =>
    if child_is(target, final) { RenderContextBlock(1) }
    else { RenderContextDefault },
  NExpr(MakeTupleExpr(elems)) =>
    if any_child_is(target, elems) { RenderContextTuple(1) }
    else { RenderContextDefault },
  _ => RenderContextDefault
}

fn child_is(target, node) with Pure = {
  let N(_, _, h) = node
  h == target
}

fn any_child_is(target, nodes) with Memory = {
  if len(nodes) == 0 { false }
  else if child_is(target, last(nodes)) { true }
  else { any_child_is(target, drop_last(nodes)) }
}

fn render_branch_tuple(branches) with Format + Alloc + Memory + !Mutate = {
  if len(branches) == 0 { "" }
  else {
    let head = last(branches)
    let tail = drop_last(branches)
    let head_str = format_chain(head)
    let head_line = spaces(indented_center())
      ++ head_str
      ++ ","
    if len(tail) == 0 { head_line }
    else {
      head_line
        ++ "\n"
        ++ render_branch_tuple(tail)
    }
  }
}

fn render_non_chain(node) with Format + !Mutate = {
  format_at_handle(node_handle(node))
}

// String intent boundaries: the seven-fan's tuple elements reach here as
// free vars (the branch returns don't ground the destructure), and `++`
// on an unproven element is the loud floor — the annotations carry the
// proof the concat dispatch reads (the §9 pointer-eq law's sibling).
fn assemble_render(tokens: String, indent: String, line_break: String, comment: String, span: String, reason: String, sibling: String) with Alloc + Memory = {
  // The one comment renders as a leading block above the declaration (the
  // verbatim //-prefixed prose from the weave); then indent, tokens, glue.
  comment
    ++ indent
    ++ tokens
    ++ line_break
    ++ sibling
}

fn format_one_stmt(stmt) with Format + !Mutate = {
  format_at_handle(node_handle(stmt))
}

fn ast_top_level_stmts(ast) with Pure = ast

fn ast_kind_of(node) with Pure = {
  let N(body, _, _) = node
  body
}

// node_handle() — see src/infer.mn (canonical Node-handle accessor).

fn canonical_indent_depth(kind, ctx) with Pure = match kind {
  NStmt(_) => 0,
  NExpr(_) => left_edge_indent(),
  _        => 0
}

type RenderContext
  = RenderContextDefault
  | RenderContextChain(Int)        // current chain depth
  | RenderContextBlock(Int)        // inside { ... } at depth
  | RenderContextTuple(Int)        // inside (...) at depth

// The unary operator glyph per SYNTAX.md — `-` negate, `!` logical-not.
fn unary_op_glyph(op) with Pure = match op {
  UNeg => "-",
  UNot => "!"
}
