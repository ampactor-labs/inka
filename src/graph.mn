// graph.mn — Graph machinery (spec 00)
//
// The substrate. One live graph, all variables. Paged storage,
// O(1) chase amortized, epoch-monotonic, trail-backed for rollback.
// Every TVar(id) is a handle into this graph; every observer chases
// via graph_chase; only inference writes.
//
// types.mn owns the vocabulary (NodeKind, GNode, Graph, Mutation,
// GraphRead, GraphWrite). This file owns the mechanism:
// graph_handler (the live state), the SpinePage record (the paged
// storage), chase_node (the read primitive), occurs_in (cycle
// detection), the revert walkers (speculative rollback).
//
// THE PAGED SPINE. A handle's whole row — its union-find cell, its
// AST body, its attached prose, its e-class edge, its narrowing, its
// executable boundary — lives in ONE SpinePage record: band =
// handle / spine_slots, slot = handle % spine_slots. Pages allocate
// WHOLE at band-open (all six columns) and NEVER MOVE — the only
// mutation is an in-place cell write, so a checkpoint carries no
// spine copies: the open-band count is the whole guard, and
// rollback restores the COUNT. Cells and band-table slots
// above a restored count are stale and get overwritten at the next
// mint/band-open — the trail's own logical-length discipline, one
// level up. This shape deletes the doubling copy (the old
// graph_extend_to), the NFree gap-fill, and the seventeen-field
// checkpoint snapshot that moving spines forced: a page that never
// relocates cannot dangle, so the fork-spine class (the boundaries[23]
// stale-spine trap) is unconstructible, and a snapshot of the band
// table stays valid across mints.
//
// The trail keeps the flat-buffer shape — append O(1) amortized,
// rollback O(M) exact, entries above trail_len stale-and-overwritten.
// Mentl's oracle (spec 09) depends on that O(M) guarantee to explore
// hundreds of candidate patches per second.
//
// Overlays share the flat substrate. Per-module handle tracking
// lives in three parallel flat arrays — overlay_names, overlay_bufs,
// overlay_lens — with an overlay_count and current_overlay_idx. A
// fresh allocation's cost is O(1) amortized: one list_index into
// each array + one list_extend_to on the current handles buffer +
// one list_set. graph_fork scans names only when entering a module
// (rare); cross-module snapshot builds slice-views (O(1) per overlay).

import types
import effects
import runtime/strings

// graph_handler — the substrate handler
// State:
//   spine               — band table: SpinePage records, one per open band
//   spine_open          — count of open bands (cells above are stale)
//   trail               — flat mutation buffer (append forward, walk back on rollback)
//   trail_len           — logical length of trail (entries above are stale)
//   epoch               — bumps on every bind; query observers key (handle, epoch)
//   next                — next fresh handle to allocate
//   overlay_names       — flat String buffer, one entry per module
//   overlay_bufs        — flat buffer of handles-buffer pointers
//   overlay_lens        — flat buffer of logical lengths for each handles-buffer
//   overlay_count       — logical length of the three overlay arrays
//   current_overlay_idx — index into overlay_* for the active module
//
// Threaded through the pipeline via ~>. Installed once at compile
// entry. Every downstream pass (infer, lower, query, teach, emit,
// mentl) sees the same live graph through the same effect discipline.
//
// This is the canonical demonstration of Mentl's handler-state pattern:
// state is internal to the handler; callers never see Graph as
// a value; access is only through perform.

// Reverse projection over the comment-ref pairs: which comment owners
// reference this node. Linear over the pair list — the pair count is the
// program's authored cross-references, small by construction.
fn comment_ref_owners(ref pairs, referent, i, acc) with Memory + Alloc =
  if i >= len(pairs) { acc }
  else {
    let (o, r) = list_index(pairs, i)
    comment_ref_owners(pairs, referent, i + 1, if r == referent { acc ++ [o] } else { acc })
  }

// ─── The paged spine — six columns, one page record per band ─────────────
// Column absent-contracts (a virgin cell is word 0 — the allocator's
// virginity contract IS the column's): the nodes column is MINT-DENSE
// (every handle below the mint bound was written at its own mint, so reads
// guard by the bound and never see a virgin cell); the program and comments
// columns guard the cell's word face (addr(cell) == 0 — the Cast
// vocabulary's read) and answer the absent value; the canon and narrowing
// columns read 0 as "no edge"; a boundaries cell's 0 IS NoBoundary (nullary
// tag 0) natively. The page is a STRUCTURAL record — mechanism, not a
// branded domain value — so field access unifies (nominal TName refuses the
// open-row field demand), and spine_page's return annotation is the shape's
// one home.

// One truth for the band width. 16384 slots sizes the page to the measured
// mint distribution (max 2,305 mints per decl on the wheel, p99 331 — 7×
// headroom for the per-decl banding this page structure carries next).
let spine_slots = 16384

fn spine_band(h) = h / spine_slots
fn spine_slot(h) = h % spine_slots

// The one page read — callers guarantee the band is open (mint-density for
// nodes; a spine_open guard for the sparse columns). A closed-band index
// beyond the table is the loud OOB trap, never a silent default. The return
// annotation is the Intent Boundary that CLOSES the record: an inferred open
// {nodes, ...} receiver computes field offsets over the partial demanded set
// (the trecordopen-wrong-field class — measured here as `.nodes` reading
// offset 0, the boundaries column, before the annotation).
fn spine_page(ref spine, h)
  -> {boundaries: [ExecutableBoundary], canon: [Int], comments: [(String, Span)],
      narrowing: [Int], nodes: [GNode], program: [NodeBody]}
  with Memory = list_index(spine, spine_band(h))

// Open bands through band b — the MINT path only: every other write lands
// at an already-minted handle, whose band is open by construction. Returns
// the (possibly grown) table and the new open count; the table grows by
// list_extend_to (rare — once per 16384 mints), the pages themselves never
// move.
fn spine_ensure(own spine, spine_open, b) with Memory + Alloc =
  if b < spine_open { (spine, spine_open) }
  else { spine_open_loop(list_extend_to(spine, b + 1), spine_open, b) }

fn spine_open_loop(own spine, opened, b) with Memory + Alloc =
  if opened > b { (spine, opened) }
  else {
    let page = {
      boundaries: make_list(spine_slots),
      canon: make_list(spine_slots),
      comments: make_list(spine_slots),
      narrowing: make_list(spine_slots),
      nodes: make_list(spine_slots),
      program: make_list(spine_slots),
    }
    spine_open_loop(list_set(spine, opened, page), opened + 1, b)
  }

// In-place cell writes — the page never moves, so no write returns a new
// spine and no handler-state rebind rides a cell store.
fn spine_put_node(ref spine, h, own node) with Memory = {
  let _ = list_set(spine_page(spine, h).nodes, spine_slot(h), node)
  ()
}

fn spine_put_body(ref spine, h, own body) with Memory = {
  let _ = list_set(spine_page(spine, h).program, spine_slot(h), body)
  ()
}

fn spine_put_comment(ref spine, h, own cell) with Memory = {
  let _ = list_set(spine_page(spine, h).comments, spine_slot(h), cell)
  ()
}

fn spine_put_canon(ref spine, h, to) with Memory = {
  let _ = list_set(spine_page(spine, h).canon, spine_slot(h), to)
  ()
}

fn spine_put_narrowing(ref spine, h, pred) with Memory = {
  let _ = list_set(spine_page(spine, h).narrowing, spine_slot(h), pred)
  ()
}

fn spine_put_boundary(ref spine, h, own boundary) with Memory = {
  let _ = list_set(spine_page(spine, h).boundaries, spine_slot(h), boundary)
  ()
}

// The sparse-column reads, each answering its absent-contract for a closed
// band or a virgin cell.
fn spine_body_at(ref spine, spine_open, h) with Memory + Cast =
  if spine_band(h) >= spine_open { NHole(0) }
  else {
    let cell = list_index(spine_page(spine, h).program, spine_slot(h))
    if addr(cell) == 0 { NHole(0) } else { cell }
  }

fn spine_comment_at(ref spine, spine_open, h) with Memory + Cast =
  if spine_band(h) >= spine_open { ("", span_zero()) }
  else {
    let cell = list_index(spine_page(spine, h).comments, spine_slot(h))
    if addr(cell) == 0 { ("", span_zero()) } else { cell }
  }

fn spine_canon_at(ref spine, spine_open, h) with Memory =
  if spine_band(h) >= spine_open { h }
  else {
    let to = list_index(spine_page(spine, h).canon, spine_slot(h))
    if to == 0 { h } else { to }
  }

fn spine_narrowing_at(ref spine, spine_open, h) with Memory =
  if spine_band(h) >= spine_open { 0 }
  else { list_index(spine_page(spine, h).narrowing, spine_slot(h)) }

fn spine_boundary_at(ref spine, spine_open, h) with Memory =
  if spine_band(h) >= spine_open { NoBoundary }
  else { list_index(spine_page(spine, h).boundaries, spine_slot(h)) }

// Config: a BRANCH CURSOR (the parallel fan's per-thread instance) installs
// over the SHARED spine with a private planned range — the root install is
// bare and the defaults are the empty graph. Handler state records live in
// shared heap; the install chain stays per-instance, correctly private.
handler graph_handler(spine0, spine_open0, next0, limit0)
  with spine = spine0, spine_open = spine_open0,
       trail = [], trail_len = 0,
       epoch = 0, next = next0,
       mint_limit = limit0, mint_high = 0,
       overlay_names = ["global"],
       overlay_bufs = [[]],
       overlay_lens = [0],
       overlay_count = 1,
       current_overlay_idx = 0,
       span_index = [],
       checkpoint_stack = [],
       comment_refs = [] {

  // checkpoint_stack tracks active speculation depth. Each
  // graph_push_checkpoint pushes the current trail_len; each
  // graph_rollback pops. When the stack is empty, writes are at the
  // OUTERMOST commit boundary — perform graph_mutated so the IC fixpoint
  // (the oracle's project_queue_merger re-projects, src/oracle.mn) bumps
  // its epoch only on real graph state changes. Speculative writes
  // (Mentl's oracle exploration between push+rollback) leave the stack
  // non-empty and never emit graph_mutated — otherwise infinite recursion
  // (Mentl would subscribe to her own speculations).

  // ─── Read ops ────────────────────────────────────────────────────

  graph_chase(handle) => {
    resume(chase_node(spine, next, handle, 0))
  },

  graph_chase_handle(handle) => {
    resume(chase_handle(spine, next, handle, 0))
  },

  graph_epoch() => {
    resume(epoch)
  },

  graph_next() => resume(next),

  graph_reason_edge(h1, h2) => {
    let GNode(_, r1) = chase_node(spine, next, h1, 0)
    let GNode(_, r2) = chase_node(spine, next, h2, 0)
    resume(Unified(r1, r2))
  },

  graph_reason_at(handle) => {
    let GNode(_, r) = graph_node_at(spine, next, handle)
    resume(r)
  },

  graph_snapshot() => {
    let overlays_view =
      overlays_to_pairs(overlay_names, overlay_bufs, overlay_lens, overlay_count)
    resume(Graph(next, overlays_view, span_index))
  },

  graph_node_body(handle) => {
    resume(spine_body_at(spine, spine_open, handle))
  },

  // The checkpoint is the fork's STATE VALUE — but pages never move, so the
  // spine contributes two words (the band-table pointer, for the rare
  // in-fork table growth, and the open count) instead of six spine copies.
  // The append-only logs (trail, span_index, comment_refs) and the overlay
  // family restore wholesale exactly as before; per-cell truth restores by
  // walking the trail backward IN PLACE (pages are stable, so every inverse
  // lands on its live cell — the boundaries[23] stale-spine trap is
  // unconstructible in this representation). The record allocates BEFORE
  // the fork pair's heap_mark, so it survives the region.
  graph_push_checkpoint() => {
    resume(trail_len)
      with checkpoint_stack = push(checkpoint_stack,
        {comment_refs, current_overlay_idx, next,
         overlay_bufs, overlay_count, overlay_lens, overlay_names,
         span_index, spine, spine_open, trail, trail_len})
  },

  // ─── Write ops ───────────────────────────────────────────────────
  // Each write appends a Mutation to the trail. The trail is the
  // inverse log — on rollback we walk it backwards. Every fresh
  // allocation also registers in the CURRENT overlay so Arc F.7
  // (incremental compilation) can key per-module recomputation.

  // A mint at a planned range's ceiling jumps to the open space above the
  // plan and clears the limit — the decl finishes there, deterministically
  // (decl order is). mint_limit 0 is the unlimited sequential mode (the
  // Option-niche word: 0 = no ceiling, the slot_present precedent).
  graph_fresh_ty(reason) => {
    let overflow = mint_limit > 0 && next >= mint_limit
    let handle = if overflow { mint_high } else { next }
    let (sp, so) = spine_ensure(spine, spine_open, spine_band(handle))
    spine_put_node(sp, handle, GNode(NFree(epoch), reason))
    let (new_bufs, new_lens) =
      overlay_register_at(overlay_bufs, overlay_lens, current_overlay_idx, handle)
    let new_trail = trail_append(trail, trail_len, MFreshNode(handle))
    if len(checkpoint_stack) == 0 {
      graph_mutated(epoch, MFreshNode(handle))
    }
    resume(handle)
      with spine = sp,
           spine_open = so,
           next = handle + 1,
           mint_limit = if overflow { 0 } else { mint_limit },
           trail = new_trail,
           trail_len = trail_len + 1,
           overlay_bufs = new_bufs,
           overlay_lens = new_lens
  },

  graph_fresh_row(reason) => {
    let overflow = mint_limit > 0 && next >= mint_limit
    let handle = if overflow { mint_high } else { next }
    let (sp, so) = spine_ensure(spine, spine_open, spine_band(handle))
    spine_put_node(sp, handle, GNode(NRowFree(epoch), reason))
    let (new_bufs, new_lens) =
      overlay_register_at(overlay_bufs, overlay_lens, current_overlay_idx, handle)
    let new_trail = trail_append(trail, trail_len, MFreshNode(handle))
    if len(checkpoint_stack) == 0 {
      graph_mutated(epoch, MFreshNode(handle))
    }
    resume(handle)
      with spine = sp,
           spine_open = so,
           next = handle + 1,
           mint_limit = if overflow { 0 } else { mint_limit },
           trail = new_trail,
           trail_len = trail_len + 1,
           overlay_bufs = new_bufs,
           overlay_lens = new_lens
  },

  // ─── The planned mint — the deterministic handle partition ─────────
  // The final pass pre-assigns each stmt a dense range sized by the
  // trial's measured counts (types.mn's op doc carries the contract).
  // plan(top) seeds the overflow target above every planned base; each
  // at(base, limit) raises the high-water past the range it leaves so an
  // overflow never lands inside any planned range; seal() resumes
  // sequential minting at the high-water mark. None of the three touch
  // the trail: the plan is numbering, not mutation — rollback semantics
  // ride `next` exactly as before.
  graph_mint_plan(top) => {
    resume()
      with mint_high = if top > mint_high { top } else { mint_high }
  },

  graph_mint_at(base, limit) => {
    resume()
      with next = base,
           mint_limit = limit,
           mint_high = if next > mint_high { next } else { mint_high }
  },

  graph_mint_seal() => {
    let high = if next > mint_high { next } else { mint_high }
    resume()
      with next = high,
           mint_limit = 0,
           mint_high = high
  },

  // Edge-link a node's body into the one graph at its handle — the program
  // COLUMN of the handle's own SpinePage. Every AST node registers here at
  // construction, so any handle resolves to its body live (graph_node_body).
  // The parse-written program projection, distinct from the mutable
  // union-find type cell in the same page's nodes column — one handle, one
  // page, six columns. In-place cell write: no trail, no state rebind.
  graph_register_node(handle, body) => {
    spine_put_body(spine, handle, body)
    resume()
  },

  // The comment column — parse-attached prose in the handle's own page. A
  // comment is graph content (SYNTAX.md Comments): the parser attaches each
  // contiguous // block to the handle of the decl it precedes; the Why
  // engine / formatter / cursor project it live (graph_comment_at). A
  // SEPARATE column, not the node's single Reason slot: graph_bind
  // overwrites that slot at infer with the inference Reason, so a
  // parse-written comment Reason would be clobbered.
  graph_attach_comment(handle, text, span) => {
    // Blank-separated comment blocks share a following declaration: the
    // nested arm attaches the LATER block first, so an existing entry
    // merges BEHIND the incoming earlier text — source order, one home,
    // the blank line surviving as the paragraph break.
    let (existing, _) = spine_comment_at(spine, spine_open, handle)
    let merged = if byte_len(existing) > 0 { "{text}\n\n{existing}" } else { text }
    spine_put_comment(spine, handle, (merged, span))
    resume()
  },

  // A virgin cell reads as ("", zero span) — the same absent-contract every
  // column read shares.
  graph_comment_at(handle) => {
    let (text, _) = spine_comment_at(spine, spine_open, handle)
    resume(text)
  },

  graph_comment_span_at(handle) => {
    let (_, span) = spine_comment_at(spine, spine_open, handle)
    resume(span)
  },

  // The comment-REFERENCE edges: a resolved backticked reference is a
  // real edge (owner comment's node -> referent decl's node), drawn at
  // the infer tail once the env is whole. Comments heal under rename
  // because the edge carries the identity and the NAME is a projection;
  // the audit's referenced-by line is the reverse read.
  graph_attach_comment_ref(owner, referent) => {
    resume() with comment_refs = comment_refs ++ [(owner, referent)]
  },

  graph_comment_refs_of(referent) => {
    resume(comment_ref_owners(comment_refs, referent, 0, []))
  },

  // The e-graph equivalence weave — union-find as a fabric EDGE, a column of
  // the handle's own page beside the program/comments/nodes columns (the TVar
  // union-find precedent). `graph_canon_set(from, to)` draws the equivalence edge `from ≡
  // to`; `graph_canon_at(handle)` reads the one-step pointer (the node's
  // e-class root pointer, or the handle itself if it is its own root). The
  // rule that records the pair guarantees `to` is the cheaper node, so
  // chasing the edge always descends toward the simplest form — egraph_extract
  // (egraph.mn) follows it live. No side-ledger: an already-rooted `from`
  // overwrites its one cell, so saturation never grows an O(N²) pair-list (the
  // OOM the snoc-list ledger caused). No trail: saturation is a `|>` stage
  // between infer and lower, before speculation, so rollback never touches it.
  graph_canon_set(from, to) => {
    spine_put_canon(spine, from, to)
    resume()
  },

  // A handle with no edge (absent, or a self-pointer) is its own e-class root —
  // the extracted term. A virgin cell holds 0, and handle 0 is the synthetic
  // Module root (never an expr operand), so a 0 cell reads as "no edge" ⇒
  // return the handle itself.
  graph_canon_at(handle) => {
    resume(spine_canon_at(spine, spine_open, handle))
  },

  // The refinement-narrowing column — in the handle's page beside canon.
  // graph_narrow_set(handle, pred_handle) records that the path-predicate at
  // bool-node `pred_handle` is proven to hold AT program-point `handle` (§4⑥).
  // graph_narrow_at reads it back — 0 = no narrowing proven (the default for
  // every handle, so an un-narrowed program is byte-identical: lower elides
  // nothing). One cell per handle (idempotent), no side-ledger, no trail — the
  // narrowing is a `|>` stage at infer, read by lower's verify-obligation.
  graph_narrow_set(handle, pred_handle) => {
    spine_put_narrowing(spine, handle, pred_handle)
    resume()
  },

  graph_narrow_at(handle) => {
    resume(spine_narrowing_at(spine, spine_open, handle))
  },

  // The executable-boundary weave: one O(1) read per fanout site, containing
  // its ordered branch edges. Unlike parse-only program/comments and post-
  // infer canon/narrowing, inference writes this weave while the oracle may be
  // under a checkpoint, so every replacement is trailed and rolls back with
  // the type nodes it names.
  graph_boundary_at(site_handle) => {
    resume(spine_boundary_at(spine, spine_open, site_handle))
  },

  graph_boundary_set(site_handle, boundary) => {
    let old_boundary = spine_boundary_at(spine, spine_open, site_handle)
    spine_put_boundary(spine, site_handle, boundary)
    let mutation = MSetBoundary(site_handle, old_boundary)
    let new_trail = trail_append(trail, trail_len, mutation)
    let new_epoch = epoch + 1
    if len(checkpoint_stack) == 0 {
      graph_mutated(new_epoch, mutation)
    }
    resume()
      with epoch = new_epoch,
           trail = new_trail,
           trail_len = trail_len + 1
  },

  graph_bind(handle, ty, reason) => {
    if occurs_in(handle, ty) {
      // A real infinite type deserves its coordinates: the bind's Reason
      // carries the Located span when the caller had one (SYNTAX principle 5 —
      // diagnostics carry coordinates; 0:0 only when genuinely unlocated).
      report(EOccursCheck(handle, ty, reason_span_or_zero(reason)))
      resume()
    } else {
      let old_node = graph_node_at(spine, next, handle)
      spine_put_node(spine, handle, GNode(NBound(ty), reason))
      let new_trail = trail_append(trail, trail_len, MSetNode(handle, old_node))
      let new_epoch = epoch + 1
      if len(checkpoint_stack) == 0 {
        graph_mutated(new_epoch, MSetNode(handle, old_node))
      }
      resume()
        with epoch = new_epoch,
             trail = new_trail,
             trail_len = trail_len + 1
    }
  },

  // The productive-under-error poison write (infer.mn:24's law, given its
  // graph op): the node becomes an OBSERVED FAILURE. No occurs check — a hole
  // carries no type to cycle through. Trail-backed like every write, so a
  // speculative checkpoint rolls a poison back with everything else.
  graph_bind_hole(handle, reason) => {
    let old_node = graph_node_at(spine, next, handle)
    spine_put_node(spine, handle, GNode(NErrorHole(reason), reason))
    let new_trail = trail_append(trail, trail_len, MSetNode(handle, old_node))
    let new_epoch = epoch + 1
    if len(checkpoint_stack) == 0 {
      graph_mutated(new_epoch, MSetNode(handle, old_node))
    } else { () }
    resume()
      with epoch = new_epoch,
           trail = new_trail,
           trail_len = trail_len + 1
  },

  graph_bind_row(handle, row, reason) => {
    // A row is a SET, so a row var referencing itself (v = names ∪ v) is
    // idempotent — the least fixed point is `names`, v contributes nothing new,
    // and there is no infinite row (the effect universe is finite). Binding the
    // growing self-reference is what spins subst_row/subst_ty forever (the
    // result()->r cycle: r's Iterate payload names r's own row). Union-find never
    // unions a root with itself; the row sort is no different — leave the tail
    // free, resolve_row folds the names forward. NOT reported: unlike a type
    // occurs (a real infinite type), a row self-loop is benign set-idempotence.
    if occurs_in_row(handle, row) {
      resume()
    } else {
      let old_node = graph_node_at(spine, next, handle)
      spine_put_node(spine, handle, GNode(NRowBound(row), reason))
      let new_trail = trail_append(trail, trail_len, MSetRow(handle, old_node))
      let new_epoch = epoch + 1
      if len(checkpoint_stack) == 0 {
        graph_mutated(new_epoch, MSetRow(handle, old_node))
      }
      resume()
        with epoch = new_epoch,
             trail = new_trail,
             trail_len = trail_len + 1
    }
  },

  // The record-row residual bind — a `...R` rest's remaining fields, under
  // its OWN node kind (NRecordRowBound). Binding residuals under NRowBound
  // made the row slot an untagged EffRow-or-Ty union every row walk's
  // catch-all silently crossed. The occurs guard is the TYPE-side check over
  // each field ty (a residual's self-reference is a real infinite type).
  graph_bind_record_row(handle, fields, reason) => {
    if occurs_in_record_fields(handle, fields) {
      resume()
    } else {
      let old_node = graph_node_at(spine, next, handle)
      spine_put_node(spine, handle, GNode(NRecordRowBound(fields), reason))
      let new_trail = trail_append(trail, trail_len, MSetRow(handle, old_node))
      let new_epoch = epoch + 1
      if len(checkpoint_stack) == 0 {
        graph_mutated(new_epoch, MSetRow(handle, old_node))
      }
      resume()
        with epoch = new_epoch,
             trail = new_trail,
             trail_len = trail_len + 1
    }
  },

  graph_fork(module_name) => {
    // Enter the named module's overlay. If it already exists (re-entry
    // during incremental recompile), point current_overlay_idx at it;
    // otherwise append a new (name, empty-handles, 0) triple to the
    // three parallel arrays via list_extend_to. Subsequent fresh
    // allocations register into the current overlay in O(1).
    let existing_idx = overlay_find(overlay_names, overlay_count, module_name)
    if existing_idx < overlay_count {
      resume()
        with current_overlay_idx = existing_idx
    } else {
      let new_names = list_set(list_extend_to(overlay_names, overlay_count + 1), overlay_count, module_name)
      let new_bufs = list_set(list_extend_to(overlay_bufs, overlay_count + 1), overlay_count, make_list(0))
      let new_lens = list_set(list_extend_to(overlay_lens, overlay_count + 1), overlay_count, 0)
      resume()
        with overlay_names = new_names,
             overlay_bufs = new_bufs,
             overlay_lens = new_lens,
             overlay_count = overlay_count + 1,
             current_overlay_idx = overlay_count
    }
  },

  // ─── Rollback — the oracle's undo ────────────────────────────────
  // Walk the trail backwards from trail_len down to target. Each
  // mutation has a precise inverse, applied IN PLACE (pages never move):
  //   MSetNode(h, old) → restore the nodes cell at h to old
  //   MSetRow(h, old)  → restore the nodes cell at h to old
  //   MSetBoundary(h, old) -> restore the boundaries cell at h
  //   MFreshNode(h)    → decrement next (un-allocate)
  // Reset trail_len = target; entries above are stale and get
  // overwritten on next append — no slicing, no allocation. Epoch is
  // NOT rolled back — it stays monotonic so query observers keyed on
  // (handle, epoch) correctly see invalidation without reordering.

  graph_index_span(span, handle) => {
    resume() with span_index = push(span_index, (span, handle))
  },

  graph_rollback(target_idx) => {
    let n = len(checkpoint_stack)
    if n == 0 {
      // Unpaired rollback (no snapshot on the stack): the per-slot walk
      // undoes every trailed write in place — pages are stable, so each
      // inverse lands on its live cell — and MFreshNode entries count next
      // back down. Bands stay open (cells above the restored next are
      // stale-and-overwritten at re-mint, the logical-length discipline).
      let new_next =
        revert_trail(spine, spine_open, trail, trail_len, target_idx, next)
      resume()
        with next = new_next,
             trail_len = target_idx
    } else {
      // Walk the CURRENT trail backward, undoing each write in place into
      // the fork-time table. Backward order makes the oldest trailed
      // old-value win per slot; an entry whose band opened only during the
      // fork is skipped (its page dies with the region). Then every
      // wholesale field — including the two spine words: the band table
      // (for the rare in-fork table growth) and the open count, which
      // closes in-fork bands by COUNT (their table cells are stale above
      // it and get overwritten at the next band-open).
      let cp = last(checkpoint_stack)
      revert_trail_into(cp.spine, cp.spine_open, trail, trail_len, target_idx)
      resume()
        with spine = cp.spine,
             spine_open = cp.spine_open,
             next = cp.next,
             trail = cp.trail,
             trail_len = target_idx,
             span_index = cp.span_index,
             comment_refs = cp.comment_refs,
             overlay_bufs = cp.overlay_bufs,
             overlay_lens = cp.overlay_lens,
             overlay_names = cp.overlay_names,
             overlay_count = cp.overlay_count,
             current_overlay_idx = cp.current_overlay_idx,
             // drop_last, never slice: the pop runs BEFORE the caller's
             // heap_reset, so a slice node minted here dies with the
             // region and the next fork walks a zeroed cell. On the
             // always-snoc stack drop_last is the parent READ — the pop
             // allocates nothing and the surviving value is pre-fork.
             checkpoint_stack = drop_last(checkpoint_stack)
    }
  }
}

// The Mutate effect's no-subscriber floor. graph_handler's write arms
// perform graph_mutated at every outermost commit; subscribers are a
// handler-swap surface (the IC loop's project_queue_merger re-projects on
// the bumped epoch, MV-LSP.push streams diagnostics). One-shot compile
// paths have no subscriber — this sink acknowledges the event and
// resumes. Installed OUTSIDE graph_handler in every chain that has no
// live subscriber; the IC loop swaps it for the oracle's re-projection.
handler mutate_sink {
  graph_mutated(_epoch, _mutation) => resume()
}

// Pure graph operations — the mechanism
// Internal machinery the handler delegates to. All pure; all
// deterministic; no effects.

// Follow NBound / NRowBound links until terminal. Amortized O(1) —
// chains shallow in practice, depth-limited for cycle safety.
fn chase_node(ref spine, mint_bound, handle, depth) with !Mutate = {
  if depth > 100 {
    GNode(NErrorHole(Inferred("chase depth exceeded")), Fresh(handle))
  } else {
    let GNode(kind, reason) = graph_node_at(spine, mint_bound, handle)
    match kind {
      NBound(ty) =>
        match ty {
          TVar(next) => chase_node(spine, mint_bound, next, depth + 1),
          _          => GNode(kind, reason)
        },
      NRowBound(row) =>
        match row {
          EfRow(names, _, EtVar(next)) =>
            chase_node(spine, mint_bound, next, depth + 1)
              |> merge_chased_row(??, names, next),
          _ => GNode(kind, reason)
        },
      _ => GNode(kind, reason)
    }
  }
}

// chase_handle — union-find `find`: follow the TVar chain to the
// canonical ROOT handle (the integer), not the node. unify unions the
// roots; binding a surface alias instead strands the canonical var
// free. Mirror of chase_node's NBound(TVar) arm, returning the handle.
fn chase_handle(ref spine, mint_bound, handle, depth) with !Mutate = {
  if depth > 100 { handle }
  else {
    let GNode(kind, _) = graph_node_at(spine, mint_bound, handle)
    match kind {
      NBound(ty) =>
        match ty {
          TVar(next) => chase_handle(spine, mint_bound, next, depth + 1),
          _          => handle
        },
      // Row aliases: unify_row links open row vars as `va → EfRow(_, _, EtVar(vb))`.
      // find follows them to the canonical root var, exactly as it follows
      // TVar — so generalize/instantiate quantify a buried row tail (the row
      // mirror of the type-var find). Type handles never reach this arm.
      NRowBound(row) =>
        match row {
          EfRow(_, _, EtVar(next)) => chase_handle(spine, mint_bound, next, depth + 1),
          _               => handle
        },
      _ => handle
    }
  }
}

// When chasing a var-tailed row that points to another row handle,
// fold the known names forward through the chain. free_handle is the
// handle we chased INTO — needed to reconstruct the var-tailed triple
// when the chain terminates at NRowFree (the free variable).
fn merge_chased_row(ref chased, ref names, free_handle) with !Mutate = {
  let GNode(ck, cr) = chased
  match ck {
    NRowFree(_) =>
      // Preserve the accumulated names with the free variable.
      // Without this, EfRow([Memory, IO], [], EtVar(v)) where v → NRowFree
      // would lose [Memory, IO].
      if len(names) == 0 { chased }
      else { GNode(NRowBound(mk_ef_open(names, free_handle)), cr) },
    NRowBound(inner) => GNode(NRowBound(merge_row(names, inner)), cr),
    _ => chased
  }
}

fn merge_row(ref names, ref row) with !Mutate = {
  let EfRow(p, a, t) = row
  match t {
    // A universal tail (a var bound to `!E` — the sound modal stance):
    // the accumulated names were proven DISJOINT from the absent set at
    // the bind, so universe-minus-E already contains them; the negation
    // subsumes the known presents and carries forward.
    EtAll => row,
    _     => ef_make(name_set_union(names, p), a, t)
  }
}

// The one nodes read. Every minted handle's cell was written at its own
// mint, so below the bound only PLAN GAPS are unwritten (a planned range's
// final mints running under its trial measure — the cell stays virgin);
// the word-face guard answers those and any never-minted defensive read
// with the synthesized NFree, and a live handle reads its cell directly.
fn graph_node_at(ref spine, mint_bound, idx) with Memory + Cast = {
  if idx >= mint_bound { GNode(NFree(0), Fresh(idx)) }
  else {
    let cell = list_index(spine_page(spine, idx).nodes, spine_slot(idx))
    if addr(cell) == 0 { GNode(NFree(0), Fresh(idx)) } else { cell }
  }
}

// Occurs check
// Before graph_bind(h, ty, r): walk ty for free handles containing h.
// If found, inference emits E_OccursCheck and refuses. No silent
// binding. No cycle except through explicit <~ feedback.
//
// Iteration uses flat-indexed loops on list_to_flat'd inputs — snoc
// inputs materialize once at entry, flat inputs pass through. Walks
// short-circuit on first hit.

// H6: exhaustive Ty enumeration. A wildcard arm here silently
// misses a new Ty variant's containment check — the most
// dangerous site in the compiler because a missed occurs-check
// admits infinite types. Every current Ty variant is named; any
// future variant fails to compile until its containment semantics
// are decided explicitly.
fn occurs_in(handle, ref ty) with !Mutate = {
  match ty {
    TInt             => false,
    TFloat           => false,
    TUnit            => false,
    TByte            => false,
    // The leaf answers "does handle occur in the type GRAPH reachable from
    // here" — three tiers, each a hole the selfapply fixture found trapping
    // the compiler (f(f) spun chase_deep/subst_ty to stack exhaustion with
    // ZERO occurs reports): (1) the raw handle; (2) the ROOT (unify IS
    // union-find — the indirect cycle a ~ (b -> r) with b's root already a
    // passed a raw compare); (3) the root's BINDING, recursed — bind
    // graph_bind(a, TFun([b], r)) first (b free, passes), then close the
    // cycle with graph_bind(b, TVar(a)):
    // no handle comparison sees that cycle, only descending a's bound
    // structure does. Termination is the guarded-write invariant itself:
    // every bind runs this check, so the graph stays acyclic and the
    // recursion always bottoms out (chase_deep's depth tripwire is the
    // belt behind this suspender).
    TVar(id)         =>
      if id == handle { true }
      else {
        let root = graph_chase_handle(id)
        if root == handle { true }
        else {
          match graph_chase(root) {
            GNode(NBound(inner), _) => occurs_in(handle, inner),
            GNode(NRecordRowBound(fields), _) => occurs_in_fields(handle, fields),
            _ => false
          }
        }
      },
    TList(elem)      => occurs_in(handle, elem),
    TTuple(elems)    => occurs_in_list(handle, elems),
    TFun(params, ret, eff) =>
      occurs_in_params(handle, params) || occurs_in(handle, ret) || occurs_in_row(handle, eff),
    TName(_, args)   => occurs_in_list(handle, args),
    TRecord(fields)  => occurs_in_fields(handle, fields),
    TRecordOpen(fields, v) => {
      if v == handle || occurs_in_fields(handle, fields) { true }
      else {
        let vroot = graph_chase_handle(v)
        if vroot == handle { true }
        else {
          match graph_chase(vroot) {
            GNode(NRecordRowBound(rest), _) => occurs_in_fields(handle, rest),
            _ => false
          }
        }
      }
    },
    TRefined(base, _) => occurs_in(handle, base),
    TCont(input, answer, _, world) =>
      occurs_in(handle, input) || occurs_in(handle, answer) || occurs_in_row(handle, world),
    TAlias(_, inner)  => occurs_in(handle, inner)
  }
}

fn occurs_in_params(handle, ref params) with !Mutate = {
  let flat = list_to_flat(params)
  occurs_in_params_loop(handle, flat, 0, len(flat))
}

fn occurs_in_params_loop(handle, ref params, i, n) with !Mutate = {
  if i >= n { false }
  else {
    let ty = param_ty(list_index(params, i))
    if occurs_in(handle, ty) { true }
    else { occurs_in_params_loop(handle, params, i + 1, n) }
  }
}

fn occurs_in_list(handle, ref tys) with !Mutate = {
  let flat = list_to_flat(tys)
  occurs_in_list_loop(handle, flat, 0, len(flat))
}

fn occurs_in_list_loop(handle, ref tys, i, n) with !Mutate = {
  if i >= n { false }
  else {
    if occurs_in(handle, list_index(tys, i)) { true }
    else { occurs_in_list_loop(handle, tys, i + 1, n) }
  }
}

fn occurs_in_fields(handle, ref fields) with !Mutate = {
  let flat = list_to_flat(fields)
  occurs_in_fields_loop(handle, flat, 0, len(flat))
}

fn occurs_in_fields_loop(handle, ref fields, i, n) with !Mutate = {
  if i >= n { false }
  else {
    let (_, ty) = list_index(fields, i)
    if occurs_in(handle, ty) { true }
    else { occurs_in_fields_loop(handle, fields, i + 1, n) }
  }
}

// The occurs-check twin of free_in_row: does `handle` appear in the row's
// parameterized-effect payload types (Iterate(a) carries a)? subst_ty freshens
// these payloads via subst_row, so the check MUST see them or a var bound to a
// type carrying itself in a row (result() -> r) escapes the check and subst_ty
// loops. One traversal shape across free_in_row / subst_row / here — they read
// the SAME structure; drift between them IS the bug this closes.
fn occurs_in_row(handle, ref eff) with !Mutate = {
  // ONE triple, one walk: the names on both fields plus the tail var —
  // the three vars-of-a-row walks (free/occurs/subst) agree by having
  // one shape to agree about.
  let EfRow(p, a, t) = eff
  if occurs_in_eff_names(handle, p) { true }
  else {
    if occurs_in_eff_names(handle, a) { true }
    else {
      match t {
        // A BOUND tail hides structure the write would embed: subst_row's
        // merge arm traverses into the binding, so the cycle guard must
        // reach the same leaves (the trio law over rows, through the tail).
        EtVar(v) => {
          let r = graph_chase_handle(v)
          if v == handle || r == handle { true }
          else {
            match graph_chase(r) {
              GNode(NRowBound(inner), _) => occurs_in_row(handle, inner),
              _                          => false
            }
          }
        },
        _        => false
      }
    }
  }
}

fn occurs_in_record_fields(handle, ref fields) with !Mutate = {
  if len(fields) == 0 { false }
  else {
    let (_, ty) = last(fields)
    occurs_in(handle, ty) || occurs_in_record_fields(handle, drop_last(fields))
  }
}

fn occurs_in_eff_names(handle, ref names) with !Mutate = {
  let flat = list_to_flat(names)
  occurs_in_eff_names_loop(handle, flat, 0, len(flat))
}

fn occurs_in_eff_names_loop(handle, ref names, i, n) with !Mutate = {
  if i >= n { false }
  else {
    let occ = match list_index(names, i) {
      ENamed(_)               => false,
      EPure                   => false,
      EParameterized(_, args) => occurs_in_eff_args(handle, args)
    }
    if occ { true }
    else { occurs_in_eff_names_loop(handle, names, i + 1, n) }
  }
}

fn occurs_in_eff_args(handle, ref args) with !Mutate = {
  let flat = list_to_flat(args)
  occurs_in_eff_args_loop(handle, flat, 0, len(flat))
}

fn occurs_in_eff_args_loop(handle, ref args, i, n) with !Mutate = {
  if i >= n { false }
  else {
    let occ = match list_index(args, i) {
      EAInt(_)    => false,
      EAFloat(_)  => false,
      EAString(_) => false,
      EAType(ty)  => occurs_in(handle, ty),
      EANode(_)   => false
    }
    if occ { true }
    else { occurs_in_eff_args_loop(handle, args, i + 1, n) }
  }
}

// Trail buffer — flat array + length counter
// Mirrors the nodes buffer substrate (DESIGN Ch 4 Salsa 3.0 shape).
// Append via list_extend_to + list_set — O(1) amortized. Revert is
// a backward flat-array loop, one list_set per step — O(M) exact.
// Rollback resets trail_len; entries above the counter are stale
// and get overwritten on next append. No snoc, no concat, no linked
// walk. This is the substrate on which Mentl's oracle runs.

// The snapshot-path walker: undo the trail backward IN PLACE into the
// fork-time table. Pages never move, so every inverse lands on its live
// cell (backward order makes the oldest old-value per slot the pre-fork
// one); an entry whose band opened only during the fork is skipped by the
// open-count guard — its page dies with the region, and writing into it
// would resurrect the doomed-allocation class. MFreshNode needs no step
// here: the checkpoint restores `next` wholesale.
fn revert_trail_into(ref spine, spine_open, ref trail, current, target) with Memory = {
  if current <= target { () }
  else {
    let idx = current - 1
    let mutation = trail[idx]
    match mutation {
      MSetNode(h, old) => {
        if spine_band(h) < spine_open { spine_put_node(spine, h, old) }
        revert_trail_into(spine, spine_open, trail, idx, target)
      },
      MSetRow(h, old) => {
        if spine_band(h) < spine_open { spine_put_node(spine, h, old) }
        revert_trail_into(spine, spine_open, trail, idx, target)
      },
      MSetBoundary(h, old) => {
        if spine_band(h) < spine_open { spine_put_boundary(spine, h, old) }
        revert_trail_into(spine, spine_open, trail, idx, target)
      },
      MFreshNode(_) =>
        revert_trail_into(spine, spine_open, trail, idx, target)
    }
  }
}

// The unpaired walker: same in-place undo (every touched band is open —
// the guard is kept uniform as the belt), with MFreshNode counting `next`
// back down.
fn revert_trail(ref spine, spine_open, ref trail, current, target, next_handle) with Memory = {
  if current <= target { next_handle }
  else {
    let idx = current - 1
    let mutation = trail[idx]
    match mutation {
      MSetNode(h, old) => {
        if spine_band(h) < spine_open { spine_put_node(spine, h, old) }
        revert_trail(spine, spine_open, trail, idx, target, next_handle)
      },
      MSetRow(h, old) => {
        if spine_band(h) < spine_open { spine_put_node(spine, h, old) }
        revert_trail(spine, spine_open, trail, idx, target, next_handle)
      },
      MSetBoundary(h, old) => {
        if spine_band(h) < spine_open { spine_put_boundary(spine, h, old) }
        revert_trail(spine, spine_open, trail, idx, target, next_handle)
      },
      MFreshNode(_) =>
        revert_trail(spine, spine_open, trail, idx, target, next_handle - 1)
    }
  }
}

fn trail_append(own trail, trail_len, own mutation) = {
  list_set(list_extend_to(trail, trail_len + 1), trail_len, mutation)
}

// Overlay registration — flat-substrate per-module handle set
// Three parallel arrays — names, bufs, lens — keyed by overlay index.
// overlay_register_at writes into the current overlay's handles_buf
// in O(1) amortized; overlay_find scans names only on graph_fork.
// overlays_to_pairs reconstructs List[(name, handles_view)] for
// graph_snapshot / F11 cross-module consumers using slice views (no
// copying of the handle buffers).

fn overlay_register_at(own overlay_bufs, own overlay_lens, idx, handle) = {
  let handles_buf = list_index(overlay_bufs, idx)
  let handles_len = list_index(overlay_lens, idx)
  let new_handles = list_set(list_extend_to(handles_buf, handles_len + 1), handles_len, handle)
  let new_bufs = list_set(overlay_bufs, idx, new_handles)
  let new_lens = list_set(overlay_lens, idx, handles_len + 1)
  (new_bufs, new_lens)
}

fn overlay_find(ref names, count, ref target) with !Mutate = {
  overlay_find_loop(names, count, target, 0)
}

// Not-found sentinel is `count` (one past the last valid index).
// Callers test `existing_idx < count` to branch on found/missing.
fn overlay_find_loop(ref names, count, ref target, i) with !Mutate = {
  if i >= count { count }
  else if list_index(names, i) == target { i }
  else { overlay_find_loop(names, count, target, i + 1) }
}

fn overlays_to_pairs(ref names, ref bufs, ref lens, count) with !Mutate = {
  overlays_to_pairs_loop(names, bufs, lens, count, 0, make_list(count))
}

fn overlays_to_pairs_loop(ref names, ref bufs, ref lens, count, i, own acc) = {
  if i >= count { acc }
  else {
    let handles_view = slice(list_index(bufs, i), 0, list_index(lens, i))
    let pair = (list_index(names, i), handles_view)
    overlays_to_pairs_loop(
      names, bufs, lens, count, i + 1,
      list_set(acc, i, pair)
    )
  }
}

// Effect-name set ops (H3.1)
// merge_row routes through `name_set_union` from effects.mn — the
// row entries are EffName values, not strings. Smart constructors
// (mk_ef_closed, mk_ef_open) enforce sort invariant at construction,
// so no boundary canonicalize is needed. The local string-set
// adapters are gone — string-set primitives still serve own.mn and
// other linear-binding consumers.

// ── DAG-homed here (the import-truth sweep, 2026-07-23): each fn below
// moved from a module DOWNSTREAM of its users so every user reaches it
// through a forward import edge — the manifest tells the truth.

fn node_handle(node) = {
  let N(_, _, h) = node
  h
}

// Mint TParam list for handler config-params. Each name gets a
// fresh tyvar handle (via mint), wrapped as TParam(name, TVar(h),
// Unmarked, Unmarked) — Ownership is Unmarked (no authored marker;
// arm-body usage may constrain). Per Hβ.first-light.handler-scheme-
// tfun-shape (2026-05-06). Drift refused: 7 (one list of TParam
// records, not (names, types) parallel arrays); 8 (TParam is the
// established positional shape, not name-keyed map).

// The MINT span of a handle — the reverse read of the span_index weave
// (fresh_handle writes (span, handle) at every mint). A node's REASON span
// can be overwritten by a later bind (a hole's reason becomes its binder's
// "declared as ..."), so a patch target must read the weave, never the
// reason. O(n) scan at felt cadence (once per accepted action); the O(1)
// form is the handle-indexed span weave (the §5.O name-is-handle sibling).
fn parse_span_of(handle) with Memory + Alloc + GraphRead = {
  let Graph(_, _, span_index) = graph_snapshot()
  match find((pair) => { let (_, h) = pair h == handle }, span_index) {
    Some(pair) => { let (span, _) = pair span },
    None       => span_zero()
  }
}


