// infer.mn — Hindley-Milner, one walk, graph-direct (spec 04)
//
// The engine. A single recursive walk over the typed AST that writes
// bindings directly into the Graph and effects into Env through
// effect-mediated access. Three operations: infer_expr, infer_stmt,
// generalize. No sidecar subst. No (env, subst) tuple threaded. The
// graph IS the subst; env IS ambient; both are performed.
//
// Effects required:
//   GraphRead + GraphWrite   — live graph mutation
//   EnvRead + EnvWrite                 — scoped bindings
//   Diagnostic                         — Hazel marked holes
//   FreshHandle                        — instantiate (one fn, two handlers)
//   Verify                             — refinement obligations
//   Consume                            — ownership at own-parameter use
//   InferCtx                           — infer-local: fn-row accumulation
//
// The effect row of a function is accumulated in InferCtx handler
// state during body inference, then bound into the graph on exit.
// This is the clean way: graph_bind is one-write-per-handle, so rows
// grow in handler state and write once.
//
// Classic Damas-Milner. Productive under error (Hazel): a mismatch
// binds NErrorHole and continues; ten mismatches yield ten error
// holes, not one-and-halt.

import graph
import effects
import types

/// Infer-local effect for row accumulation.
/// Each `FnStmt` / `LambdaExpr` pushes a `(row_handle, accumulated_row)`
/// frame. Every `PerformExpr` inside the body adds its effect to the
/// accumulated row. On scope exit, the accumulated row binds to the
/// handle via `graph_bind_row`. One write; no conflict.
effect InferCtx {
  inf_enter_fn(Int, Span) -> ()
  inf_exit_fn() -> ()
  inf_add_effect(String) -> ()
  inf_add_row(EffRow) -> ()
  inf_current_row() -> EffRow
  inf_set_declared(List) -> ()
  inf_declared_effs() -> List
  inf_push_handler(String) -> ()
  inf_pop_handler() -> ()
  inf_handler_stack() -> List
  inf_handler_provider(String) -> Option
}

// handler_stack (W4 prep, C4) — insertion-ordered stack of handler
// names currently installed at this inference point. HandleExpr and
// PTeeBlock / PTeeInline sites push when entering their body, pop on exit. W4's
// monomorphic dispatch reads this to know which handler position
// to target; today it's a bookkeeping surface with no consumer but
// the shape it captures is load-bearing for evidence reification.
handler infer_ctx with stack = [], declared = [], handler_stack = [] {
  // stack = [InferFrame, ...] where each InferFrame is a record:
  //   {accumulated_row: EffRow, fn_span: Span, row_handle: Int}
  // declared = [(EffName, negated)] — the current FnStmt's annotation
  // handler_stack = [handler_name, ...] — outer-to-inner installation order

  inf_enter_fn(h, fn_span) => {
    let frame = {accumulated_row: EfPure, fn_span: fn_span, row_handle: h}
    resume()
      with stack = [frame] ++ stack
  },

  inf_exit_fn() => {
    if stack.len == 0 { resume() }
    else {
      let frame = list_head(stack)
      perform graph_bind_row(frame.row_handle, frame.accumulated_row,
        Located(frame.fn_span, Inferred("fn effect row")))
      resume()
        with stack = list_tail(stack)
    }
  },

  inf_add_effect(name) => {
    if stack.len == 0 { resume() }
    else {
      let frame = list_head(stack)
      // `name` is a String (legacy callers); wrap as bare ENamed.
      // Parameterized effects flow through inf_add_row instead.
      let extended = union_row(frame.accumulated_row, mk_ef_closed([ENamed(name)]))
      let updated = {
        accumulated_row: extended,
        fn_span: frame.fn_span,
        row_handle: frame.row_handle
      }
      resume()
        with stack = [updated] ++ list_tail(stack)
    }
  },

  inf_add_row(row) => {
    if stack.len == 0 { resume() }
    else {
      let frame = list_head(stack)
      let extended = union_row(frame.accumulated_row, row)
      let updated = {
        accumulated_row: extended,
        fn_span: frame.fn_span,
        row_handle: frame.row_handle
      }
      resume()
        with stack = [updated] ++ list_tail(stack)
    }
  },

  inf_current_row() => {
    if stack.len == 0 { resume(EfPure) }
    else {
      let frame = list_head(stack)
      resume(frame.accumulated_row)
    }
  },

  inf_set_declared(effs) => {
    resume() with declared = effs
  },

  inf_declared_effs() => {
    resume(declared)
  },

  inf_push_handler(name) => {
    resume() with handler_stack = [name] ++ handler_stack
  },

  inf_pop_handler() => {
    if handler_stack.len == 0 { resume() }
    else { resume() with handler_stack = list_tail(handler_stack) }
  },

  inf_handler_stack() => {
    resume(handler_stack)
  },

  inf_handler_provider(op_name) => {
    match perform env_lookup(op_name) {
      None => resume(None),
      Some(entry) => {
        let (_, _, kind) = entry
        match kind {
          EffectOpScheme(ename) =>
            resume(find_handler_for_effect(handler_stack, ename)),
          _ => resume(None)
        }
      }
    }
  }
}

fn find_handler_for_effect(stack, ename) = {
  if stack.len == 0 { None }
  else {
    let hname = list_head(stack)
    match perform env_lookup(hname) {
      Some(entry) => {
        let (scheme, _, _) = entry
        let Forall(_, ty) = scheme
        match ty {
          TName("Handler", args) => {
            if args.len == 1 {
              match list_head(args) {
                TName(hename, _) =>
                  if str_eq(hename, ename) { Some(hname) }
                  else { find_handler_for_effect(list_tail(stack), ename) },
                _ => find_handler_for_effect(list_tail(stack), ename)
              }
            } else { find_handler_for_effect(list_tail(stack), ename) }
          },
          _ => find_handler_for_effect(list_tail(stack), ename)
        }
      },
      None => find_handler_for_effect(list_tail(stack), ename)
    }
  }
}


/// Entry point — wraps the walk in `infer_ctx` so row accumulation is automatic.
fn infer_program(stmts) = {
  handle {
    pre_register_fn_sigs(stmts)
    infer_stmt_list(stmts)
  } with infer_ctx
}

fn pre_register_fn_sigs(stmts) = for_each(pre_register_stmt, stmts)

fn pre_register_stmt(ref node) = {
  let N(body, span, handle) = node
  match body {
    NStmt(FnStmt(name, params, _ret_ann, _effs, _body_node)) =>
      pre_register_fn_sig(name, params, handle, span),
    NStmt(Documented(_, inner_node)) =>
      pre_register_stmt(inner_node),
    _ => ()
  }
}

fn pre_register_fn_sig(name, params, handle, span: ValidSpan) = {
  let param_handles = mint_param_placeholders(params, name)
  let ret_handle = perform mint(FnReturn(name, Inferred("return of '" |> str_concat(name) |> str_concat("'")))) // drift-audit: ignore — |> inside string-build arg, not a pipe verb
  let row_handle = perform graph_fresh_row(Inferred("effects of '" |> str_concat(name) |> str_concat("'")))
  let fn_ty = TFun(
    build_param_types(params, param_handles),
    TVar(ret_handle),
    mk_ef_open([], row_handle)
  )
  perform graph_bind(handle, fn_ty, Located(span, Declared(name)))
  perform env_extend(name, Forall([], fn_ty), Declared(name), FnScheme)
}

fn infer_stmt_list(stmts) = for_each(infer_stmt, stmts)

// Statement inference

fn infer_stmt(ref node) = {
  let N(body, span, handle) = node
  match body {
    NStmt(LetStmt(pat, expr)) => {
      infer_expr(expr)
      let N(_, _, eh) = expr
      infer_pat(pat, eh, span)
    },

    NStmt(FnStmt(name, params, ret_ann, effs, body_node)) => {
      perform inf_set_declared(effs)
      infer_fn(name, params, body_node, handle, span)
      perform inf_set_declared([])
    },

    NStmt(TypeDefStmt(name, args, variants)) =>
      register_type_constructors(name, args, variants),

    NStmt(EffectDeclStmt(name, ops)) =>
      register_effect_ops(name, ops),

    NStmt(CapabilityDeclStmt(name, effs)) => {
      perform env_extend(name, Forall([], TTuple([])), Declared(name), CapabilityScheme(effs))
    },

    NStmt(HandlerDeclStmt(hname, ename, config, state, arms)) =>
      register_handler(hname, ename, config, state, arms),

    NStmt(ExprStmt(expr)) =>
      infer_expr(expr),

    NStmt(ImportStmt(_)) => (),

    NStmt(RefineStmt(name, base_ty, pred)) => {
      // RN.1 — wrap in TAlias so the authored name travels with the type
      let aliased = TAlias(name, TRefined(base_ty, pred))
      perform env_extend(name, Forall([], aliased), Declared(name), FnScheme)
      perform verify(span, pred, Refinement(pred, PTrue))
    },

    // DS.3 — unwrap docstring, infer the inner declaration, then
    // re-extend the declared name's env entry with the docstring Reason.
    // The docstring becomes a graph-queryable edge via DocstringReason.
    NStmt(Documented(doc, inner_node)) => {
      infer_stmt(inner_node)
      // Thread the docstring into the env as an additional reason
      // for the declared name (if the inner is a FnStmt/TypeDefStmt/etc.)
      let N(inner_body, inner_span, _) = inner_node
      match inner_body {
        NStmt(FnStmt(name, _, _, _, _)) =>
          match perform env_lookup(name) {
            Some(entry) => {
              let (scheme, reason, kind) = entry
              let enriched = Located(inner_span, DocstringReason(doc, span))
              perform env_extend(name, scheme, enriched, kind)
            },
            None => ()
          },
        _ => ()
      }
    },

    _ => ()
  }
}

/// Classic let-generalization: allocate fresh handles for params,
/// bind them in env, enter `InferCtx` for row accumulation, infer body,
/// exit (which binds the row), generalize, re-extend env with scheme.
fn infer_fn(name, params, body_node, handle, span: ValidSpan) = {
  perform env_scope_enter()

  let param_handles = mint_params(params, name)
  let ret_handle = perform mint(FnReturn(name, Inferred("return of '" |> str_concat(name) |> str_concat("'")))) // drift-audit: ignore — |> inside string-build arg, not a pipe verb
  let row_handle = perform graph_fresh_row(Inferred("effects of '" |> str_concat(name) |> str_concat("'")))

  let fn_ty = TFun(
    build_param_types(params, param_handles),
    TVar(ret_handle),
    mk_ef_open([], row_handle)
  )

  // Bind the name BEFORE body so recursive calls resolve.
  let existing = perform graph_chase(handle)
  match existing {
    GNode(NBound(existing_ty), _) =>
      unify_types(existing_ty, fn_ty, span, Declared(name)),
    _ => {
      perform env_extend(name, Forall([], fn_ty), Declared(name), FnScheme)
      perform graph_bind(handle, fn_ty, Located(span, Declared(name)))
    }
  }

  // Enter the row-accumulation scope and infer body.
  perform inf_enter_fn(row_handle, span)
  infer_expr(body_node)
  perform inf_exit_fn()

  // Unify body's type with the declared return.
  let N(_, _, body_handle) = body_node
  unify(body_handle, ret_handle, span, FnReturn(name, Inferred("body")))

  // H4: every fn return is an escape boundary. The body's return
  // value (and its embedded fields, recursively) must not carry a
  // region tag that's no longer live. region_tracker compares the
  // tagged region against region_stack; mismatches surface as
  // E_RegionEscape with the install-span.
  perform check_escape(body_handle, span)

  // ─── Declared effects enforcement (gap 1 + 2) ──────────────────
  // If the FnStmt carries a declared effect row, verify the inferred
  // body's row is subsumed by it. If so, rebind row_handle to the
  // declared row so callers see the API contract. If not, emit
  // E_EffectMismatch (body does more than the declaration admits).
  // The declared row IS the gate — row_subsumes is the proof engine.

  let declared_effs = perform inf_declared_effs()
  if declared_effs.len > 0 {
    // D3 — `with Pure` is absolute: body row must be EfPure (not
    // merely ⊆ some sugar row named Pure). When Pure appears
    // anywhere in declared_effs, the declared row collapses to
    // EfPure and any other declared names are a contradiction (a
    // single warning surfaces them precisely in the contradiction
    // diagnostic).
    let has_pure = has_pure_declared(declared_effs)
    let declared_row =
      if has_pure { EfPure }
      else        { build_declared_row(declared_effs) }
    let bound = perform graph_chase(row_handle)
    match bound {
      GNode(NRowBound(body_row), _) => {
        if row_subsumes(body_row, declared_row) {
          // D2 — when body_row is STRICTLY narrower than declared_row
          // (body ⊆ declared and declared ⊄ body), the fn is
          // over-declared — it reserves more capabilities than it
          // uses. Emit T_OverDeclared as a teaching warning so the
          // author can tighten the signature and unlock the tighter
          // row's capabilities (memoization for EfPure, real-time
          // for !Alloc, etc.).
          if row_subsumes(declared_row, body_row) { () }
          else {
            perform report("infer", "T_OverDeclared", "warning",
              "function '"
                |> str_concat(name)
                |> str_concat("' declares ")
                |> str_concat(show_effrow(declared_row))
                |> str_concat(" but body only uses ")
                |> str_concat(show_effrow(body_row))
                |> str_concat(" — tighten the signature to unlock capabilities"),
              span, "MachineApplicable")
          }
          perform graph_bind_row(row_handle, declared_row,
            Located(span, Declared(name)))
        } else {
          let code = if has_pure { "E_PurityViolated" } else { "E_EffectMismatch" }
          let summary = if has_pure {
            "function '"
              |> str_concat(name)
              |> str_concat("' declares Pure but body performs ")
              |> str_concat(show_effrow(body_row))
          } else {
            "function '"
              |> str_concat(name)
              |> str_concat("' declares ")
              |> str_concat(show_effrow(declared_row))
              |> str_concat(" but body inferred ")
              |> str_concat(show_effrow(body_row))
          }
          perform report("infer", code, "error", summary, span, "MachineApplicable")
        }
      },
      _ => ()
    }
  }

  perform env_scope_exit()

  // Generalize and re-extend.
  let scheme = generalize(handle)
  perform env_extend(name, scheme, Declared(name), FnScheme)
}

// H4 helper — does a CallExpr's callee resolve to an alloc-returning
// scheme? Constructors (ConstructorScheme) emit LMakeVariant which
// heap-allocates; nominal records (RecordSchemeKind, H2.3) reach
// here only via degenerate CallExpr — canonical form is
// NamedRecordExpr. Either way the result handle deserves region
// tracking.
fn call_is_alloc_returning(func) = {
  let N(body, _, _) = func
  match body {
    NExpr(VarRef(name)) => match perform env_lookup(name) {
      Some(entry) => {
        let (_, _, kind) = entry
        match kind {
          ConstructorScheme(_, _) => true,
          RecordSchemeKind(_)     => true,
          _                       => false
        }
      },
      None => false
    },
    _ => false
  }
}

// H4 helper — does an EffName list include the Alloc effect name?
// region_enter fires only for HandleExprs that absorb Alloc (the
// load-bearing alloc-tracking case; non-Alloc handlers don't open
// regions).
fn names_include_alloc(names) = {
  names_include_alloc_loop(names, 0, names.len)
}

fn names_include_alloc_loop(names, i, n) = {
  if i >= n { false }
  else {
    let name = list_index(names, i)
    let s = match name {
      ENamed(s)              => s,
      EParameterized(s, _)   => s
    }
    if str_eq(s, "Alloc") { true }   // drift-audit: ignore — real drift mode 8 (EffName should have EAlloc variant, not ENamed(string)); tracked for item 11.B EffName refactor
    else { names_include_alloc_loop(names, i + 1, n) }
  }
}

/// Build an `EffRow` from a declared `(name, negated)` list. Negated
/// names produce `EfNeg(EfClosed([name]))` and compose with intersection;
/// positive names union. Normalization reduces to canonical form.
fn build_declared_row(effs) = {
  let expanded_effs = expand_capabilities(effs)
  let (pos, neg) = partition_declared(expanded_effs, [], [])
  build_from_partition(pos, neg)
}

fn expand_capabilities(effs) = {
  flatten(map((eff) => {
    let (name, negated) = eff
    match name {
      ENamed(s) => match perform env_lookup(s) {
        Some(entry) => {
          let (_, _, _, kind) = entry
          match kind {
            CapabilityScheme(cap_effs) => {
              if negated {
                perform report("infer", "E_CannotNegateCapability", "error", "cannot negate capability bundle " |> str_concat(s), span_zero(), "MachineApplicable")
                cap_effs
              } else { cap_effs }
            },
            _ => [(name, negated)]
          }
        },
        None => [(name, negated)]
      },
      _ => [(name, negated)]
    }
  }, effs))
}

fn has_pure_declared(effs) = any((eff) => {
  let (name, _) = eff
  match name {
    ENamed(s) => str_eq(s, "Pure"),   // drift-audit: ignore — real drift mode 8 (EffName should have EPure variant, not ENamed(string)); tracked for item 11.B EffName refactor
    _         => false
  }
}, effs)

fn partition_declared(effs, pos_init, neg_init) = {
  fold(effs, (pos_init, neg_init), (acc, eff) => {
    let (pos, neg) = acc
    let (name, negated) = eff
    if negated { (pos, push(neg, name)) }
    else       { (push(pos, name), neg) }
  })
}

fn build_from_partition(pos, neg) = {
  if pos.len == 0 && neg.len == 0 { EfPure }
  else if pos.len == 0 { neg_row(mk_ef_closed(neg)) }
  else {
    let base = mk_ef_closed(pos)
    fold_negations(neg, base)
  }
}

fn fold_negations(neg, own acc) = {
  if neg.len == 0 { acc }
  else {
    let n = list_head(neg)
    let next = inter_row(acc, neg_row(mk_ef_closed([n])))
    fold_negations(list_tail(neg), next)
  }
}

// Expression inference

fn infer_expr(ref node) = {
  let N(body, span, handle) = node
  match body {
    NExpr(LitInt(_))    => perform graph_bind(handle, TInt,    Located(span, Inferred("int literal"))),
    NExpr(LitFloat(_))  => perform graph_bind(handle, TFloat,  Located(span, Inferred("float literal"))),
    NExpr(LitString(_)) => perform graph_bind(handle, TString, Located(span, Inferred("string literal"))),
    NExpr(LitBool(_))   => perform graph_bind(handle, TName("Bool", []), Located(span, Inferred("bool literal"))),
    NExpr(LitUnit)      => perform graph_bind(handle, TUnit,   Located(span, Inferred("unit"))),

    NExpr(VarRef(name)) => infer_var_ref(name, handle, span),

    NExpr(BinOpExpr(op, left, right)) => {
      infer_expr(left)
      infer_expr(right)
      let N(_, _, lh) = left
      let N(_, _, rh) = right
      infer_binop(handle, op, lh, rh, span)
    },

    NExpr(UnaryOpExpr(op, inner)) => {
      infer_expr(inner)
      let N(_, _, ih) = inner
      infer_unaryop(handle, op, ih, span)
    },

    NExpr(CallExpr(func, args)) => {
      infer_expr(func)
      infer_expr_list(args)
      infer_call(func, args, handle, span)
      // H4: constructor calls allocate a heap record. Tag the
      // resulting handle so check_escape at fn return can verify
      // the value doesn't outlive its region. H4.1: constructor
      // ARGS ARE the fields — the resulting record's region pins
      // to the deepest field region.
      if call_is_alloc_returning(func) {
        perform tag_alloc_join(handle, collect_handles(args))
      }
    },

    NExpr(IfExpr(cond, then_e, else_e)) => {
      infer_expr(cond)
      infer_expr(then_e)
      infer_expr(else_e)
      let N(_, _, ch) = cond
      let N(_, _, th) = then_e
      let N(_, _, eh) = else_e
      let N(else_body, _, _) = else_e
      perform graph_bind(ch, TName("Bool", []), Located(span, IfBranch(Inferred("condition"))))
      // E_IfMissingElse per SYNTAX.md: detect synthesized-LitUnit else
      // (parser produces LitUnit when no else clause — src/parser.mn:1275).
      // If the then-branch produces a non-unit value, the missing else
      // is structurally invalid: the if would have to "produce nothing"
      // on the false path. Emit before unify so user sees the structural
      // cause, not the downstream E_TypeMismatch.
      let else_is_synthesized_unit = match else_body {
        NExpr(LitUnit) => true,
        _              => false
      }
      if else_is_synthesized_unit {
        let then_ty = perform lookup_ty(th)
        match then_ty {
          TName("Unit", _) => (),
          _ => perform report("infer", "E_IfMissingElse", "TypeError",
            "if-without-else expects unit-valued then-branch; add `else { ... }` or make then-branch evaluate to unit",
            span, "MachineApplicable")
        }
      }
      unify(th, eh, span, IfBranch(Inferred("branches must match")))
      perform graph_bind(handle, TVar(th), Located(span, IfBranch(Inferred("if result"))))
    },

    NExpr(BlockExpr(stmts, final_expr)) => {
      perform env_scope_enter()
      infer_stmt_list(stmts)
      infer_expr(final_expr)
      let N(_, _, fh) = final_expr
      perform graph_bind(handle, TVar(fh), Located(span, Inferred("block result")))
      perform env_scope_exit()
    },

    NExpr(MatchExpr(scrutinee, arms)) => {
      infer_expr(scrutinee)
      let N(_, _, sh) = scrutinee
      infer_match_arms(arms, sh, handle, span)
    },

    NExpr(MakeListExpr(elems)) => {
      infer_expr_list(elems)
      if elems.len == 0 {
        let elem_h = perform mint(Inferred("empty list element"))
        perform graph_bind(handle, TList(TVar(elem_h)), Located(span, Inferred("empty list")))
      } else {
        let first = list_head(elems)
        let N(_, _, fh) = first
        unify_list_elems(list_tail(elems), fh, span)
        perform graph_bind(handle, TList(TVar(fh)), Located(span, Inferred("list literal")))
      }
      // H4.1: list elements may carry inner-region pointers; join.
      perform tag_alloc_join(handle, collect_handles(elems))
    },

    NExpr(MakeTupleExpr(elems)) => {
      infer_expr_list(elems)
      perform graph_bind(handle, TTuple(collect_tvar_types(elems)), Located(span, Inferred("tuple literal")))
      perform tag_alloc_join(handle, collect_handles(elems))
    },

    NExpr(IndexExpr(receiver, index)) => {
      // Per #139 — semantic subscript. Infer receiver + index; the
      // result type chases receiver. List<A>[Int] → A; (a, b, c)[Int]
      // → element type at the index (compile-time slot); record[Int]
      // → field type at int-key. Today's bootstrap form binds result
      // to a fresh TVar and dispatches list-shape unconditionally;
      // post-Show-typeclass / tuple-const-index (peer Hβ.infer.index-
      // expr-dispatch), the cursor narrows further from receiver's
      // chase-deep Ty.
      infer_expr(receiver)
      infer_expr(index)
      let N(_, _, rh) = receiver
      let N(_, _, ih) = index
      perform graph_bind(ih, TInt, Located(span, Inferred("index value")))
      let elem_h = perform mint(Inferred("subscript element"))
      perform graph_bind(rh, TList(TVar(elem_h)), Located(span, Inferred("subscript receiver")))
      perform graph_bind(handle, TVar(elem_h), Located(span, Inferred("subscript result")))
    },

    NExpr(MakeStringExpr(fragments)) => {
      // Per #138 — interpolation fragments alternate literal-strings
      // + splice-exprs. Infer each fragment; each splice must be
      // Showable. Today: the substrate concretizes Show as TString
      // (every fragment's type unifies to TString) which matches the
      // bootstrap str_concat lowering. Post-L1 (peer Hβ.infer.show-
      // typeclass): non-String splices register a Show obligation
      // discharged via verify_ledger; gradient narrates each splice's
      // ascent toward Show-able.
      infer_expr_list(fragments)
      unify_string_fragments(fragments, span)
      perform graph_bind(handle, TString, Located(span, Inferred("string interpolation")))
    },

    NExpr(MakeRecordExpr(fields)) => {
      // Each field's value is inferred; the record's type is
      // TRecord((field_name, TVar(value_handle))) sorted by name.
      // Parser already sorted; lower / emit honor the same order.
      infer_record_field_values(fields)
      let field_types = build_record_field_types(fields)
      perform graph_bind(handle, TRecord(field_types),
        Located(span, Inferred("record literal")))
      // H4.1: record fields may carry inner-region pointers; join.
      perform tag_alloc_join(handle, record_field_handles(fields))
    },

    NExpr(NamedRecordExpr(type_name, fields)) => {
      // H2.3: nominal record literal. Look up the type name's
      // RecordSchemeKind to validate the field set and unify each
      // value against the declared field type. Bind the handle to
      // TName(type_name, []).
      infer_record_field_values(fields)
      match perform env_lookup(type_name) {
        None =>
          perform report("infer", "E_MissingVariable", "MissingVariable",
            "record type: " |> str_concat(type_name),
            span, "MaybeIncorrect"),
        Some(entry) => {
          let (_, _, kind) = entry
          match kind {
            RecordSchemeKind(declared) => {
              check_nominal_record_fields(declared, fields, type_name, span)
              perform graph_bind(handle, TName(type_name, []),
                Located(span, Inferred("nominal record literal")))
            },
            _ =>
              perform report("infer", "E_NotARecordType", "TypeError",
                type_name |> str_concat(" is not a record type"),
                span, "MaybeIncorrect")
          }
        }
      }
      perform tag_alloc_join(handle, record_field_handles(fields))
    },

    NExpr(PerformExpr(op_name, args)) => {
      infer_expr_list(args)
      infer_perform(op_name, args, handle, span)
    },

    NExpr(HandleExpr(body_node, arms)) => {
      // ─── Gap 3: handler absorption ──────────────────────────────
      // Push a nested row scope for the body so its effects do NOT
      // leak into the enclosing function's accumulated row. After
      // body inference, compute (body_row - handled_names) + arm_row
      // via effects.mn's absorb_row, then add the RESULT to the
      // outer fn's row tracker. The handler IS the subtraction gate.
      //
      // handler_stack (C4) — push an anonymous handler marker while
      // the body is being inferred so W4's monomorphic dispatch can
      // read the current handler position. The marker encodes the
      // handled names so downstream consumers can look up which
      // handler absorbs which effect.

      let handled_names = collect_handled_effects(arms)
      perform inf_push_handler(handler_stack_tag(handled_names))

      // H4: HandleExprs that absorb Alloc open a new region. Every
      // allocation inside the body is tagged with this region; on
      // body exit the region pops, and any value that escapes to
      // the enclosing scope must NOT be region-tagged with this
      // popped id (check_escape catches it at fn return).
      let opens_region = names_include_alloc(handled_names)
      let region_id = if opens_region {
        perform region_enter(span)
      } else { 0 }

      let body_row_h = perform graph_fresh_row(Inferred("handle body row"))
      perform inf_enter_fn(body_row_h, span)
      infer_expr(body_node)
      perform inf_exit_fn()

      if opens_region { perform region_exit(region_id) }

      let N(_, _, bh) = body_node

      // Arms inference in their own nested row scope
      let arm_row_h = perform graph_fresh_row(Inferred("handle arms row"))
      perform inf_enter_fn(arm_row_h, span)
      infer_handler_arms(arms, bh, span)
      perform inf_exit_fn()

      let body_row = read_bound_row(body_row_h)
      let arm_row  = read_bound_row(arm_row_h)
      let result_row = absorb_row(body_row, mk_ef_closed(handled_names), arm_row)

      // Handler-install subsumption (C4). If the enclosing FnStmt
      // carries a declared row, the handler's arm_row must be ⊆
      // declared (the arms execute in the enclosing context, so
      // anything they perform must be admitted there). Emitting
      // E_HandlerUninstallable at the install span gives a tighter
      // diagnostic than waiting for E_EffectMismatch at fn exit.
      let declared_effs = perform inf_declared_effs()
      if declared_effs.len > 0 {
        let declared_row = build_declared_row(declared_effs)
        if row_subsumes(arm_row, declared_row) { () }
        else {
          perform report("infer", "E_HandlerUninstallable", "error",
            "handler arms require effects not admitted by the enclosing declaration ("
              |> str_concat(show_effrow(arm_row))
              |> str_concat(" ⊄ ")
              |> str_concat(show_effrow(declared_row))
              |> str_concat(")"),
            span, "MachineApplicable")
        }
      }

      perform inf_add_row(result_row)
      perform inf_pop_handler()

      // Handle expression's TYPE is the body's type.
      perform graph_bind(handle, TVar(bh), Located(span, Inferred("handle result")))
    },

    NExpr(ResumeExpr(val, state_updates)) => {
      infer_expr(val)
      let N(_, _, vh) = val
      perform graph_bind(handle, TUnit, Located(span, Inferred("resume")))
    },

    NExpr(FieldExpr(rec, field)) => {
      // Dotted-name resolution: when the left side is a bare VarRef
      // AND the assembled dotted name resolves in env, treat the
      // FieldExpr as a qualified env lookup (e.g., `graph.chase`).
      // This is how dot-access on imported modules works — driver
      // installs each export under BOTH flat and `module.export`
      // keys at load time. On miss, fall through to the
      // record-field-access path for struct-record dot-access.
      let N(rbody, _, _) = rec
      match rbody {
        NExpr(VarRef(left_name)) => {
          let qualified = left_name |> str_concat(".") |> str_concat(field)
          match perform env_lookup(qualified) {
            Some(_) => infer_var_ref(qualified, handle, span),
            None    => infer_field_access_record(rec, field, handle, span)
          }
        },
        _ => infer_field_access_record(rec, field, handle, span)
      }
    },

    NExpr(LambdaExpr(params, body_node)) => {
      perform env_scope_enter()
      let param_handles = mint_params(params, "lambda")
      let row_handle = perform graph_fresh_row(Inferred("lambda effects"))
      perform inf_enter_fn(row_handle, span)
      infer_expr(body_node)
      perform inf_exit_fn()
      let N(_, _, bh) = body_node
      perform graph_bind(handle, TFun(
        build_param_types(params, param_handles),
        TVar(bh),
        mk_ef_open([], row_handle)
      ), Located(span, Inferred("lambda")))
      // H4: every lambda allocates a closure record on the heap.
      perform tag_alloc(handle)
      perform env_scope_exit()
    },

    NExpr(PipeExpr(kind, left, right)) => {
      // Branching verbs install affine-ledger snapshots around their
      // sub-infers so parallel branches cannot silently consume the
      // same own-name. Non-branching verbs use the straight-through
      // infer-both-sides / then-infer_pipe pattern.
      match kind {
        PCompose    => infer_compose(left, right, handle, span),
        PDiverge    => infer_diverge(left, right, handle, span),
        PForward    => { infer_expr(left); infer_expr(right); infer_pipe(kind, left, right, handle, span) },
        PTeeBlock   => { infer_expr(left); infer_expr(right); infer_pipe(kind, left, right, handle, span) },
        PTeeInline  => { infer_expr(left); infer_expr(right); infer_pipe(kind, left, right, handle, span) },
        PFeedback   => { infer_expr(left); infer_expr(right); infer_pipe(kind, left, right, handle, span) }
      }
    },

    NExpr(ExprPlaceholder) => (),  // ? — handle already NFree at parse

    NHole(_)  => (),               // Hazel marked hole — inference leaves NFree
    NStmt(_)  => (),               // statement at expression position — parser
                                   // should have wrapped in ExprStmt; no-op
                                   // is the safe fallback
    NPat(_)   => ()                // pattern at expression position — degenerate;
                                   // parser emits in match-arm contexts only
  }
}

/// Factored out of the `FieldExpr` match arm so the qualified-name
/// fallback path (modules-as-env-entries) can share this without
/// duplication. The record-open unification is unchanged from its
/// original arm form.
fn infer_field_access_record(rec, field, handle, span: ValidSpan) = {
  infer_expr(rec)
  let N(_, _, rh) = rec
  let field_h = perform mint(Inferred("field type"))
  let row_h = perform graph_fresh_row(Inferred("record row"))
  let expected = mk_record_open([(field, TVar(field_h))], row_h)
  let expected_h = perform mint(Inferred("record access"))
  perform graph_bind(expected_h, expected, Located(span, Inferred("expected record")))
  unify(rh, expected_h, span, Inferred("field access"))
  perform graph_bind(handle, TVar(field_h), Located(span, Inferred("field type")))
}

/// Instantiate the scheme from env, bind the handle, then consume
/// if the binding is an `own` parameter. The affine-ledger handler
/// in `own.mn` decides which names are own-marked; `check_consume_at_use`
/// performs unconditionally and lets the handler decide.
fn infer_var_ref(name, handle, span: ValidSpan) = {
  match perform env_lookup(name) {
    None => {
      perform report("infer", "E_MissingVariable", "MissingVariable", name, span, "MaybeIncorrect")
      perform graph_bind(handle, TVar(handle), Located(span, MissingVar(name)))
    },
    Some(entry) => {
      let (scheme, reason, _kind) = entry
      let ty = instantiate(scheme)
      perform graph_bind(handle, ty, Located(span, VarLookup(name, reason)))
      // If this binding is an `own` parameter, performing consume.
      // The affine_ledger handler enforces linearity.
      check_consume_at_use(name, span)
    }
  }
}

fn check_consume_at_use(name, span: ValidSpan) = {
  // Convention: consume is always performed at VarRef; affine_ledger
  // in own.mn distinguishes which bindings are own-marked via its
  // own state (populated at FnStmt entry). Performing unconditionally
  // lets the handler make the decision.
  perform consume(name, span)
}

/// RX.4 — extract callee name from func node for Why chain.
fn callee_name(func_node) with Pure = {
  let N(body, _, _) = func_node
  match body {
    NExpr(VarRef(name)) => name,
    NExpr(FieldExpr(_, field)) => field,
    _ => "<expr>"
  }
}

fn infer_call(func, args, handle, span: ValidSpan) = {
  let N(_, _, fh) = func
  let cname = callee_name(func)
  let arg_handles = collect_handles(args)
  let ret_h = perform mint(InferredCallReturn(cname, Inferred("return"))) // drift-audit: ignore — "return" is a Reason string, not an imperative keyword
  let row_h = perform graph_fresh_row(InferredCallReturn(cname, Inferred("effects")))

  let expected = TFun(
    build_inferred_params(arg_handles),
    TVar(ret_h),
    mk_ef_open([], row_h)
  )
  let expected_h = perform mint(InferredCallReturn(cname, Inferred("expected function type")))
  perform graph_bind(expected_h, expected, Located(span, InferredCallReturn(cname, Inferred("expected"))))

  unify(fh, expected_h, span, InferredCallReturn(cname, Inferred("unification")))
  perform graph_bind(handle, TVar(ret_h), Located(span, InferredCallReturn(cname, Inferred("result"))))

  // The callee's effect row flows into the caller's row.
  // After unification, row_h is bound to the callee's row;
  // chase it and add to InferCtx.
  let row_node = perform graph_chase(row_h)
  match row_node {
    GNode(NRowBound(row), _) => perform inf_add_row(row),
    _ => ()
  }
}

/// Adds the op's effect to the caller's accumulated row.
/// Looks up the op's scheme in env, instantiates, unifies args against
/// declared params, binds the handle to the return type, and calls
/// `inf_add_row` with the op's effect row so the enclosing fn accumulates it.
fn infer_perform(op_name, args, handle, span: ValidSpan) = {
  match perform env_lookup(op_name) {
    None => {
      perform report("infer", "E_MissingVariable", "MissingVariable",
        "effect op: " |> str_concat(op_name),
        span, "MaybeIncorrect")
      perform graph_bind(handle, TVar(handle), Located(span, MissingVar(op_name)))
    },
    Some(entry) => {
      let (scheme, reason, _kind) = entry
      let op_ty = instantiate(scheme)
      match op_ty {
        TFun(params, ret, row) => {
          // Unify args with op's params
          unify_args_to_params(args, params, span)
          perform graph_bind(handle, ret, Located(span, VarLookup(op_name, reason)))
          // Add the op's effect row to the caller's accumulated row.
          perform inf_add_row(row)
        },
        _ => {
          perform graph_bind(handle, op_ty, Located(span, VarLookup(op_name, reason)))
        }
      }
    }
  }
}

fn unify_args_to_params(args, params, span: ValidSpan) = {
  if args.len == 0 && params.len == 0 { () }
  else if args.len == 0 || params.len == 0 {
    // Arity mismatch: one list exhausted before the other.
    perform report(
      "infer", "E_TypeMismatch", "error",
      "arity mismatch in function call: expected "
        |> str_concat(int_to_str(params.len))
        |> str_concat(" argument(s) but got ")
        |> str_concat(int_to_str(args.len)),
      span, "MachineApplicable")
  } else {
    let N(_, _, ah) = list_head(args)
    let TParam(_, pty, _, _) = list_head(params)
    let expected_h = perform mint(Inferred("arg param"))
    perform graph_bind(expected_h, pty, Located(span, Inferred("expected param type")))
    unify(ah, expected_h, span, Inferred("arg to param"))
    unify_args_to_params(list_tail(args), list_tail(params), span)
  }
}

/// The five verbs, each inferred by its topology.
/// `PDiverge` and `PCompose` are handled BEFORE `infer_pipe` fires
/// (see `PipeExpr` arm in `infer_expr`); their arms here are unreachable stubs.
fn infer_pipe(kind, left, right, handle, span: ValidSpan) = {
  let N(_, _, lh) = left
  let N(_, _, rh) = right
  match kind {
    // |> converge — right applied to left. Transparent wire;
    // unification pairs slots structurally (Parameters ARE tuples).
    PForward => {
      let ret_h = perform mint(InferredPipeResult("|>", Inferred("return"))) // drift-audit: ignore — "return" is a Reason string; "|>" is a string literal key, not a pipe verb
      let row_h = perform graph_fresh_row(InferredPipeResult("|>", Inferred("effects")))
      let expected = TFun(
        [TParam("_", TVar(lh), Inferred, Inferred)],
        TVar(ret_h),
        mk_ef_open([], row_h)
      )
      let expected_h = perform mint(InferredPipeResult("|>", Inferred("expected fn")))
      perform graph_bind(expected_h, expected, Located(span, InferredPipeResult("|>", Inferred("expected"))))
      unify(rh, expected_h, span, InferredPipeResult("|>", Inferred("target")))
      perform graph_bind(handle, TVar(ret_h), Located(span, InferredPipeResult("|>", Inferred("result"))))
      // callee's row flows into caller's row
      let row_node = perform graph_chase(row_h)
      match row_node {
        GNode(NRowBound(row), _) => perform inf_add_row(row),
        _ => ()
      }
    },

    // PDiverge and PCompose are now handled BEFORE infer_pipe fires
    // (see PipeExpr arm in infer_expr). Their branches run under a
    // branching-ledger scope so parallel consumes collide correctly.
    PDiverge => (),    // unreachable; handled in infer_diverge
    PCompose => (),    // unreachable; handled in infer_compose

    // ~> tee — handler attachment. Result type = body type. Row:
    // row(expr ~> h) = (row(expr) - handled(h)) + row(h). Today we
    // don't have handler-value typing so arm_row can't be extracted
    // from RHS; the result-type binding is the same for both block
    // and inline forms (the parser has already built the correct
    // tree shape — block wraps whole chain, inline wraps one stage).
    // handler_stack push/pop (C4) tracks the installation site for
    // W4's monomorphic dispatch — the RHS handler value's name isn't
    // resolvable here without handler-value typing, so the generic
    // "pipe_tee" tag marks the frame. W4 will refine this to carry
    // the concrete handler identity once evidence reification lands.
    PTeeBlock => {
      perform inf_push_handler(callee_name(right))
      perform graph_bind(handle, TVar(lh),
        Located(span, InferredPipeResult("~>", Inferred("handler attachment (block)"))))
      perform inf_pop_handler()
    },
    PTeeInline => {
      perform inf_push_handler(callee_name(right))
      perform graph_bind(handle, TVar(lh),
        Located(span, InferredPipeResult("~>", Inferred("handler attachment (inline)"))))
      perform inf_pop_handler()
    },

    // <~ feedback — requires iterative context (Clock/Sample/Tick).
    // Absence is a type error at this site.
    PFeedback => {
      let ctx = perform check_iterative_context()
      match ctx {
        None => {
          perform report("infer", "E_FeedbackNoContext", "error",
            "<~ requires an iterative context (Clock, Sample, or Tick handler)",
            span, "MachineApplicable")
          perform graph_bind(handle, TVar(lh), Located(span, InferredPipeResult("<~", Inferred("no context"))))
        },
        Some(_) => {
          unify(lh, rh, span, InferredPipeResult("<~", Inferred("feedback wiring")))
          perform graph_bind(handle, TVar(lh), Located(span, InferredPipeResult("<~", Inferred("feedback"))))
        }
      }
    }
  }
}

/// Branching-verb inference (W2 · W3). `><` and `<|` run their
/// sub-branches inside an `affine_ledger` branching frame
/// (`branch_enter` / `branch_divider` / `branch_exit`). The handler
/// pairwise-checks cross-branch consumes at `branch_exit`, reporting
/// `E_OwnershipViolation` for any name consumed in two or more parallel
/// branches. Result types:
///   `><` — `TTuple([left_ty, right_ty])`
///   `<|` — `TTuple` of each branch's return type (tuple-of-branches form)
///           or a single branch's type (single-branch form).
fn infer_compose(left, right, handle, span: ValidSpan) = {
  perform branch_enter()
  infer_expr(left)
  perform branch_divider(span)
  infer_expr(right)
  perform branch_exit(span)
  let N(_, _, lh) = left
  let N(_, _, rh) = right
  perform graph_bind(handle, TTuple([TVar(lh), TVar(rh)]),
    Located(span, Inferred(">< parallel compose — branches affinity-checked")))
  // `><` × Thread row contribution. Per threading.mn §"parallel_compose"
  // and primitives #2 (handlers) + #4 (row algebra): the compose verb's
  // semantics ARE the chosen handler. parallel_compose dispatches each
  // branch to a real OS thread via ffi_spawn / ffi_join; sequential_
  // compose runs synchronously; same source, two semantics. The row
  // constraint enforces the choice at compile time — `><` without
  // either handler installed produces E_HandlerUninstallable. Drift 1
  // closure: no vtable; the chain IS the dispatch.
  perform inf_add_row(mk_ef_closed([ENamed("Thread")]))
}

fn infer_diverge(left, right, handle, span: ValidSpan) = {
  // Input is inferred once; each branch receives a BORROW of the
  // input's value. Branches run under the branching ledger so any
  // two branches that consume the same outer-scope own collide.
  infer_expr(left)
  let N(rbody, _, _) = right
  match rbody {
    NExpr(MakeTupleExpr(branches)) => {
      let n = branches.len
      if n == 0 {
        infer_expr(right)    // degenerate: <| () — empty branch tuple
      } else {
        perform branch_enter()
        infer_diverge_branches(branches, span, 0, n)
        perform branch_exit(span)
        let N(_, _, rh) = right
        perform graph_bind(rh, TTuple(collect_tvar_types(branches)),
          Located(span, Inferred("<| diverge — tuple of branch outputs")))
      }
    },
    _ => infer_expr(right)   // single-branch form — no branching ledger needed
  }
  let N(_, _, rh) = right
  perform graph_bind(handle, TVar(rh),
    Located(span, Inferred("<| diverge — result type is branch-tuple type")))
}

fn infer_diverge_branches(branches, span: ValidSpan, i, n) = {
  if i >= n { () }
  else {
    infer_expr(list_index(branches, i))
    if i + 1 < n { perform branch_divider(span) }
    infer_diverge_branches(branches, span, i + 1, n)
  }
}

/// Unification — graph-direct, Hazel-productive.
/// Every unification carries the span of the AST site that triggered
/// it. `span` threads through the recursive walk; `graph_bind` writes
/// store `Located(span, reason)` so `graph_reason_edge` naturally
/// returns `Unified(Located, Located)` per DESIGN Ch 8.

fn unify(h_a, h_b, span: ValidSpan, reason) = {
  if h_a == h_b { () }
  else {
    let na = perform graph_chase(h_a)
    let nb = perform graph_chase(h_b)
    let GNode(ka, _) = na
    let GNode(kb, _) = nb
    match ka {
      NFree(_) =>
        perform graph_bind(h_a, TVar(h_b), Located(span, reason)),
      NBound(ta) =>
        match kb {
          NFree(_)       => perform graph_bind(h_b, TVar(h_a), Located(span, reason)),
          NBound(tb)     => unify_types(ta, tb, span, reason),
          NErrorHole(_)  => (),
          _              => ()
        },
      NErrorHole(_) => (),
      _             => ()
    }
  }
}

fn unify_types(ref a, ref b, span: ValidSpan, reason) = {
  match a {
    TInt    => expect_same(a, b, span, reason),
    TFloat  => expect_same(a, b, span, reason),
    TString => expect_same(a, b, span, reason),
    TUnit   => expect_same(a, b, span, reason),

    TVar(ha) =>
      match b {
        TVar(hb) => unify(ha, hb, span, reason),
        _ => {
          if occurs_in(ha, b) {
            perform report("infer", "E_OccursCheck", "error",
              "circular type", span, "MaybeIncorrect")
          } else {
            perform graph_bind(ha, b, Located(span, reason))
          }
        }
      },

    TList(ea) =>
      match b {
        TList(eb)  => unify_types(ea, eb, span, ListElement(reason)),
        TVar(_)    => unify_types(b, a, span, reason),
        _          => type_mismatch(a, b, span, reason)
      },

    TTuple(ea) =>
      match b {
        TTuple(eb) => unify_type_lists(ea, eb, span, reason),
        TVar(_)    => unify_types(b, a, span, reason),
        _          => type_mismatch(a, b, span, reason)
      },

    TFun(pa, ra, ea) =>
      match b {
        TFun(pb, rb, eb) => {
          // DESIGN Ch 2 Insight 7: parameters ARE tuples. When arities
          // match, pair positionally. When one side has a single-param
          // TTuple(N) and the other has N params, decompose and pair
          // element-wise. When one side has a single TVar param, bind
          // it to a TTuple of the other side's param types. The same
          // rule handles `fn f(a, b) = ...` called via `|>` with a
          // 2-tuple — no splat operator, no adapter, just structural
          // pairing that the graph already knows how to do.
          pair_fn_params(pa, pb, span, reason)
          unify_types(ra, rb, span, FnReturn("fn", reason))
          unify_row(ea, eb, span, reason)
        },
        TVar(_) => unify_types(b, a, span, reason),
        _       => type_mismatch(a, b, span, reason)
      },

    TName(na, aa) =>
      match b {
        TName(nb, ab) =>
          if str_eq(na, nb) {
            unify_type_lists(aa, ab, span, reason)
          } else { type_mismatch(a, b, span, reason) },
        TVar(_) => unify_types(b, a, span, reason),
        _       => type_mismatch(a, b, span, reason)
      },

    TRecord(fa) =>
      match b {
        TRecord(fb) => unify_record_fields_closed(fa, fb, span, reason),
        TRecordOpen(fb, vb) =>
          unify_record_open_against_closed(fa, fb, vb, span, reason),
        TVar(_) => unify_types(b, a, span, reason),
        _       => type_mismatch(a, b, span, reason)
      },

    TRecordOpen(fa, va) =>
      match b {
        TRecord(fb) =>
          unify_record_open_against_closed(fb, fa, va, span, reason),
        TRecordOpen(fb, vb) =>
          unify_two_open_records(fa, va, fb, vb, span, reason),
        TVar(_) => unify_types(b, a, span, reason),
        _       => type_mismatch(a, b, span, reason)
      },

    TRefined(base_a, pred_a) =>
      match b {
        TRefined(base_b, pred_b) => {
          unify_types(base_a, base_b, span, reason)
          perform verify(span, PAnd(pred_a, pred_b), Refinement(pred_a, pred_b))
        },
        _ => {
          unify_types(base_a, b, span, reason)
          perform verify(span, pred_a, Refinement(pred_a, PTrue))
        }
      },

    TCont(ra, da) =>
      match b {
        TCont(rb, db) => unify_types(ra, rb, span, reason),
        TVar(_)       => unify_types(b, a, span, reason),
        _             => type_mismatch(a, b, span, reason)
      },

    // RN.2 — Unification alias preservation
    TAlias(name, inner_a) =>
      match b {
        TVar(_) => unify_types(b, a, span, reason),
        TAlias(_, inner_b) => unify_types(inner_a, inner_b, span, reason),
        _ => unify_types(inner_a, b, span, reason)
      },

    _ =>
      match b {
        TVar(_) => unify_types(b, a, span, reason),
        TAlias(_, inner_b) => unify_types(a, inner_b, span, reason),
        _       => type_mismatch(a, b, span, reason)
      }
  }
}

fn expect_same(ref a, ref b, span: ValidSpan, reason) = {
  match b {
    TVar(hb) => perform graph_bind(hb, a, Located(span, reason)),
    _ =>
      if same_ground(a, b) { () }
      else { type_mismatch(a, b, span, reason) }
  }
}

// H6: exhaustive Ty enumeration. Ground scalars match their same-
// variant; compound types are structurally equal only if their
// sub-parts are unified separately (that's unify_types' job, not
// same_ground's). A new scalar Ty must be added here explicitly.
fn same_ground(ref a, ref b) with Pure = match a {
  TInt    => match b { TInt    => true, _ => false },
  TFloat  => match b { TFloat  => true, _ => false },
  TString => match b { TString => true, _ => false },
  TUnit   => match b { TUnit   => true, _ => false },
  // Compound types: same_ground rejects; unify_types handles structurally
  TVar(_)            => false,
  TList(_)           => false,
  TTuple(_)          => false,
  TFun(_, _, _)      => false,
  TName(_, _)        => false,
  TRecord(_)         => false,
  TRecordOpen(_, _)  => false,
  TRefined(_, _)     => false,
  TCont(_, _)        => false,
  TAlias(_, inner)   => is_concrete(inner)
}

fn unify_type_lists(as_list, bs_list, span: ValidSpan, reason) = {
  if as_list.len == 0 && bs_list.len == 0 { () }
  else if as_list.len == 0 || bs_list.len == 0 {
    // Arity mismatch: tuple/list lengths differ.
    perform report(
      "infer", "E_TypeMismatch", "error",
      "type list arity mismatch: "
        |> str_concat(int_to_str(as_list.len))
        |> str_concat(" vs ")
        |> str_concat(int_to_str(bs_list.len)),
      span, "MachineApplicable")
  } else {
    unify_types(list_head(as_list), list_head(bs_list), span, reason)
    unify_type_lists(list_tail(as_list), list_tail(bs_list), span, reason)
  }
}

/// Both field lists arrive sorted by name (parser invariant + smart
/// constructor `mk_record_open`). Closed×closed: pointwise field
/// equality (length match + name match + type unify). Closed×open:
/// the closed record must include every open-side field; remaining
/// fields bind the open's row variable. Open×open: intersect known
/// fields; bind one variable to the residual relative to the other.
fn unify_record_fields_closed(fa, fb, span: ValidSpan, reason) = {
  if fa.len != fb.len {
    type_mismatch(TRecord(fa), TRecord(fb), span, reason)
  } else {
    unify_record_fields_loop(fa, fb, 0, fa.len, span, reason)
  }
}

fn unify_record_fields_loop(fa, fb, i, n, span: ValidSpan, reason) = {
  if i >= n { () }
  else {
    let (na, ta) = list_index(fa, i)
    let (nb, tb) = list_index(fb, i)
    if str_eq(na, nb) {
      unify_types(ta, tb, span, reason)
      unify_record_fields_loop(fa, fb, i + 1, n, span, reason)
    } else {
      type_mismatch(TRecord(fa), TRecord(fb), span, reason)
    }
  }
}

fn unify_record_open_against_closed(closed_fields, open_fields, open_var, span: ValidSpan, reason) = {
  // Every open-side field must appear in the closed side. Unify
  // matched fields' types; bind the row variable to the remainder.
  unify_record_open_subset(open_fields, closed_fields, span, reason)
  let residual = record_fields_diff(closed_fields, open_fields)
  perform graph_bind_row(open_var, mk_record_row_residual(residual),
    Located(span, reason))
}

fn unify_record_open_subset(needed, available, span: ValidSpan, reason) = {
  if needed.len == 0 { () }
  else {
    let (n, t) = list_head(needed)
    let pos = find_record_field_pos(available, n)
    if pos < 0 {
      type_mismatch(TRecord(needed), TRecord(available), span, reason)
    } else {
      let (_, t2) = list_index(available, pos)
      unify_types(t, t2, span, reason)
      unify_record_open_subset(list_tail(needed), available, span, reason)
    }
  }
}

fn unify_two_open_records(fa, va, fb, vb, span: ValidSpan, reason) = {
  // Intersect known fields (unify shared types); bind va to a
  // record-residual carrying fb's exclusive fields, mirror for vb.
  // Two row variables collapse to one when they're already linked;
  // otherwise both narrow to the union of known fields.
  let shared = intersect_record_fields(fa, fb)
  unify_record_fields_loop_shared(fa, fb, shared, span, reason)
  let extra_a = record_fields_diff(fa, fb)
  let extra_b = record_fields_diff(fb, fa)
  if va == vb {
    if extra_a.len == 0 && extra_b.len == 0 { () }
    else { type_mismatch(TRecordOpen(fa, va), TRecordOpen(fb, vb), span, reason) }
  } else {
    perform graph_bind_row(va, mk_record_row_residual(extra_b),
      Located(span, reason))
    perform graph_bind_row(vb, mk_record_row_residual(extra_a),
      Located(span, reason))
  }
}

fn unify_record_fields_loop_shared(fa, fb, names, span: ValidSpan, reason) = {
  if names.len == 0 { () }
  else {
    let n = list_head(names)
    let pa = find_record_field_pos(fa, n)
    let pb = find_record_field_pos(fb, n)
    if pa >= 0 && pb >= 0 {
      let (_, ta) = list_index(fa, pa)
      let (_, tb) = list_index(fb, pb)
      unify_types(ta, tb, span, reason)
    }
    unify_record_fields_loop_shared(fa, fb, list_tail(names), span, reason)
  }
}

fn intersect_record_fields(fa, fb) = {
  let n = fa.len
  let (buf, count) = intersect_record_fields_loop(fa, fb, 0, n, make_list(n), 0)
  slice(buf, 0, count)
}

fn intersect_record_fields_loop(fa, fb, i, n, own buf, count) = {
  if i >= n { (buf, count) }
  else {
    let (name, _) = list_index(fa, i)
    let (next_buf, next_count) = if find_record_field_pos(fb, name) >= 0 {
      let extended = list_extend_to(buf, count + 1)
      let written  = list_set(extended, count, name)
      (written, count + 1)
    } else {
      (buf, count)
    }
    intersect_record_fields_loop(fa, fb, i + 1, n, next_buf, next_count)
  }
}

fn record_fields_diff(left, right) = {
  let n = left.len
  let (buf, count) = record_fields_diff_loop(left, right, 0, n, make_list(n), 0)
  slice(buf, 0, count)
}

fn record_fields_diff_loop(left, right, i, n, own buf, count) = {
  if i >= n { (buf, count) }
  else {
    let entry = list_index(left, i)
    let (name, _) = entry
    let (next_buf, next_count) = if find_record_field_pos(right, name) < 0 {
      let extended = list_extend_to(buf, count + 1)
      let written  = list_set(extended, count, entry)
      (written, count + 1)
    } else {
      (buf, count)
    }
    record_fields_diff_loop(left, right, i + 1, n, next_buf, next_count)
  }
}

fn find_record_field_pos(fields, name) = {
  find_record_field_pos_loop(fields, name, 0, fields.len)
}

fn find_record_field_pos_loop(fields, name, i, n) = {
  if i >= n { -1 }
  else {
    let (existing, _) = list_index(fields, i)
    if str_eq(existing, name) { i }
    else { find_record_field_pos_loop(fields, name, i + 1, n) }
  }
}

fn mk_record_row_residual(fields) = {
  if fields.len == 0 { TRecord([]) }
  else { TRecord(fields) }
}

/// Infer each field's value expression; result handles are used by
/// callers to build `TRecord` field-type lists and region-join sets.
fn infer_record_field_values(fields) = {
  if fields.len == 0 { () }
  else {
    let (_, value) = list_head(fields)
    infer_expr(value)
    infer_record_field_values(list_tail(fields))
  }
}

fn build_record_field_types(fields) = map((fld) => {
  let (name, value) = fld
  let N(_, _, vh) = value
  (name, TVar(vh))
}, fields)

// H4.1 projection — pull the value handles out of a record-field list
// for region-join lookup. Field names aren't needed for region
// tracking; only the per-value handles matter.
fn record_field_handles(fields) = map((fld) => {
  let (_, value) = fld
  let N(_, _, vh) = value
  vh
}, fields)

// H2.3: validate a nominal record literal's fields against the
// declared schema. Both lists arrive sorted by field name (parser
// sort + RecordSchemeKind sort invariant). Pointwise check:
//   - missing declared field    → E_RecordFieldMissing
//   - extra unknown field       → E_RecordFieldExtra
//   - matched name              → unify value's handle with declared ty
fn check_nominal_record_fields(declared, provided, type_name, span: ValidSpan) = {
  check_nominal_record_loop(declared, provided, type_name, span, 0, 0,
    declared.len, provided.len)
}

fn check_nominal_record_loop(declared, provided, type_name, span: ValidSpan, i, j, ni, nj) = {
  if i >= ni && j >= nj { () }
  else if i >= ni {
    // Provided has extras
    let (extra, _) = list_index(provided, j)
    perform report("infer", "E_RecordFieldExtra", "TypeError",
      "record literal has unknown field '"
        |> str_concat(extra)
        |> str_concat("' for type ") // drift-audit: ignore — |> in string-build chain
        |> str_concat(type_name),
      span, "MaybeIncorrect")
    check_nominal_record_loop(declared, provided, type_name, span, i, j + 1, ni, nj)
  } else if j >= nj {
    let (missing, _) = list_index(declared, i)
    perform report("infer", "E_RecordFieldMissing", "TypeError",
      "record literal missing field '"
        |> str_concat(missing)
        |> str_concat("' for type ") // drift-audit: ignore — |> in string-build chain
        |> str_concat(type_name),
      span, "MaybeIncorrect")
    check_nominal_record_loop(declared, provided, type_name, span, i + 1, j, ni, nj)
  } else {
    let (dn, dt) = list_index(declared, i)
    let (pn, pv) = list_index(provided, j)
    if str_eq(dn, pn) {
      let N(_, _, vh) = pv
      let expect_h = perform mint(Inferred("record field type"))
      perform graph_bind(expect_h, dt,
        Located(span, Inferred("declared field type")))
      unify(vh, expect_h, span,
        OpConstraint("record field", Inferred("declared"), Inferred("provided")))
      check_nominal_record_loop(declared, provided, type_name, span, i + 1, j + 1, ni, nj)
    } else if str_lt(dn, pn) {
      perform report("infer", "E_RecordFieldMissing", "TypeError",
        "record literal missing field '"
          |> str_concat(dn)
          |> str_concat("' for type ") // drift-audit: ignore — |> in string-build chain
          |> str_concat(type_name),
        span, "MaybeIncorrect")
      check_nominal_record_loop(declared, provided, type_name, span, i + 1, j, ni, nj)
    } else {
      perform report("infer", "E_RecordFieldExtra", "TypeError",
        "record literal has unknown field '"
          |> str_concat(pn)
          |> str_concat("' for type ") // drift-audit: ignore — |> in string-build chain
          |> str_concat(type_name),
        span, "MaybeIncorrect")
      check_nominal_record_loop(declared, provided, type_name, span, i, j + 1, ni, nj)
    }
  }
}

fn unify_param_lists(ref a, ref b, span: ValidSpan, reason) = {
  if a.len == 0 || b.len == 0 { () }
  else {
    let TParam(_, ta, _, _) = list_head(a)
    let TParam(_, tb, _, _) = list_head(b)
    unify_types(ta, tb, span, reason)
    unify_param_lists(list_tail(a), list_tail(b), span, reason)
  }
}

/// Parameters ARE tuples (DESIGN Ch 2 Insight 7). The one unification
/// rule that lets `|>` deliver a tuple to an N-ary function without a
/// splat operator. Three cases:
///
///   `pa.len == pb.len`          — pair positionally (the ordinary path)
///   `pa.len == 1`, head is tuple — decompose, pair element-wise
///   `pa.len == 1`, head is TVar  — bind TVar to TTuple(pb param types)
///   symmetric for pb; otherwise   — arity mismatch
///
/// Inference reads the shape and pairs structurally — the same discipline
/// that pairs TInt with TInt or TList(a) with TList(b).
fn pair_fn_params(pa, pb, span: ValidSpan, reason) = {
  let la = pa.len
  let lb = pb.len
  if la == lb { unify_param_lists(pa, pb, span, reason) }
  else if la == 1 { try_tuple_decompose(list_head(pa), pb, span, reason) }
  else if lb == 1 { try_tuple_decompose(list_head(pb), pa, span, reason) }
  else { arity_mismatch(la, lb, span) }
}

/// Given a single param whose type is either a `TTuple` or a `TVar`,
/// reconcile it against a multi-param list.
///   `TTuple(elems)` of matching arity — pair element-wise with params
///   `TVar(_)`                         — unify TVar with TTuple of param types
///   otherwise                         — arity mismatch
fn try_tuple_decompose(single_param, many_params, span: ValidSpan, reason) = {
  let TParam(_, pty, _, _) = single_param
  let lm = many_params.len
  match pty {
    TTuple(elems) =>
      if elems.len == lm {
        unify_tuple_elems_with_params(elems, many_params, span, reason, 0, lm)
      } else {
        arity_mismatch(elems.len, lm, span)
      },
    TVar(_) => {
      let tup_ty = TTuple(param_types_flat(many_params))
      unify_types(pty, tup_ty, span, reason)
    },
    _ => arity_mismatch(1, lm, span)
  }
}

/// Pair tuple element i with param i, flat-indexed to avoid snoc-walk
/// allocation on either input.
fn unify_tuple_elems_with_params(elems, params, span: ValidSpan, reason, i, n) = {
  if i >= n { () }
  else {
    let e = list_index(elems, i)
    let TParam(_, pt, _, _) = list_index(params, i)
    unify_types(e, pt, span, reason)
    unify_tuple_elems_with_params(elems, params, span, reason, i + 1, n)
  }
}

/// Extract param types into a fresh flat list — O(1) amortized per
/// element via `list_set` into a pre-sized buffer. The resulting list
/// is tag=0 (flat); any subsequent `list_index` on it is O(1).
fn param_types_flat(params) = {
  let n = params.len
  param_types_loop(params, 0, n, make_list(n))
}

fn param_types_loop(params, i, n, own acc) = {
  if i >= n { acc }
  else {
    let TParam(_, t, _, _) = list_index(params, i)
    param_types_loop(params, i + 1, n, list_set(acc, i, t))
  }
}

fn arity_mismatch(la, lb, span: ValidSpan) = {
  perform report("infer", "E_TypeMismatch", "TypeMismatch",
    "function arity mismatch: "
      |> str_concat(int_to_str(la))
      |> str_concat(" param(s) vs ")
      |> str_concat(int_to_str(lb))
      |> str_concat(" param(s)"),
    span, "MachineApplicable")
}

fn type_mismatch(ref a, ref b, span: ValidSpan, reason) = {
  perform report("infer", "E_TypeMismatch", "TypeMismatch",
    show_type(a)
      |> str_concat(" vs ")
      |> str_concat(show_type(b)),
    span, "MachineApplicable")
}

/// `BinOp` / `UnaryOp` inference — dispatched on `BinOpKind`.
/// `binop_kind` (declared in `types.mn`) maps each `BinOp` to one of four
/// `BinOpKind` variants — the behavior class used for inference rules.
/// Two orthogonal axes: `BinOp` carries specific operator identity
/// (14 variants, surfaced at Reason/emit boundaries); `BinOpKind`
/// carries semantic behavior class (arith, cmp, bool, concat). No
/// `String` intermediary at any dispatch site.

fn infer_binop(handle, op, lh, rh, span: ValidSpan) = {
  let lbl = binop_to_str(op)
  match binop_kind(op) {
    BKArith => {
      unify(lh, rh, span, OpConstraint(lbl, Inferred("left"), Inferred("right")))
      perform graph_bind(handle, TVar(lh), Located(span, OpConstraint(lbl, Inferred("result"), Inferred("operand"))))
    },
    BKCmp => {
      unify(lh, rh, span, OpConstraint(lbl, Inferred("left"), Inferred("right")))
      perform graph_bind(handle, TName("Bool", []), Located(span, OpConstraint(lbl, Inferred("comparison"), Declared("bool"))))
    },
    BKBool => {
      perform graph_bind(lh, TName("Bool", []), Located(span, OpConstraint(lbl, Inferred("left"), Declared("bool"))))
      perform graph_bind(rh, TName("Bool", []), Located(span, OpConstraint(lbl, Inferred("right"), Declared("bool"))))
      perform graph_bind(handle, TName("Bool", []), Located(span, OpConstraint(lbl, Inferred("result"), Declared("bool"))))
    },
    BKConcat => {
      unify(lh, rh, span, OpConstraint(lbl, Inferred("left"), Inferred("right")))
      perform graph_bind(handle, TVar(lh), Located(span, OpConstraint(lbl, Inferred("concat"), Inferred("operand"))))
    }
  }
}

fn infer_unaryop(handle, op, ih, span: ValidSpan) = match op {
  "Neg" =>
    perform graph_bind(handle, TVar(ih), Located(span, OpConstraint(op, Inferred("negate"), Inferred("operand")))),
  "Not" => {
    perform graph_bind(ih, TName("Bool", []), Located(span, OpConstraint(op, Inferred("not"), Declared("bool"))))
    perform graph_bind(handle, TName("Bool", []), Located(span, OpConstraint(op, Inferred("result"), Declared("bool"))))
  },
  _ =>
    perform graph_bind(handle, TVar(ih), Located(span, Inferred("unary op")))
}

// Pattern inference

fn infer_pat(ref pat, handle, span: ValidSpan) = match pat {
  PVar(name) =>
    perform env_extend(name, Forall([], TVar(handle)),
      Located(span, LetBinding(name, Inferred("pattern"))),
      FnScheme),

  PWild => (),

  PLit(v) => {
    let ty = match v {
      LVInt(_)    => TInt,
      LVFloat(_)  => TFloat,
      LVString(_) => TString,
      LVBool(_)   => TName("Bool", [])
    }
    perform graph_bind(handle, ty, Located(span, Inferred("literal pattern")))
  },

  PCon(name, sub_pats) =>
    match perform env_lookup(name) {
      None =>
        perform report("infer", "E_MissingVariable", "MissingVariable",
          "constructor: " |> str_concat(name),
          span, "MaybeIncorrect"),
      Some(entry) => {
        // ConstructorScheme bindings carry one of two ty shapes:
        //   nullary  → TName(type_name, args)         — bind scrutinee to it
        //   fielded  → TFun(params, TName(...), Pure) — bind scrutinee to RETURN,
        //                                                 sub_pats to PARAMS.
        // FnScheme bindings reaching here are user-level matches on a
        // plain function value — degenerate but harmless; bind the
        // scrutinee to the looked-up type and skip sub-pat plumbing.
        let (scheme, reason, _kind) = entry
        let ty = instantiate(scheme)
        match ty {
          TFun(params, ret_ty, _row) => {
            perform graph_bind(handle, ret_ty,
              Located(span, VarLookup(name, reason)))
            bind_pcon_subpats(params, sub_pats, span, reason, name)
          },
          _ => {
            perform graph_bind(handle, ty,
              Located(span, VarLookup(name, reason)))
          }
        }
      }
    },

  PTuple(pats) => infer_pat_tuple(pats, handle, span),

  // H6: PList stub remains until list-pattern destructure lands (the
  // runtime/lists tag dispatch surfaces during emit; inference treats
  // the scrutinee as TList(elem) with each sub-pat against elem).
  PList(_pats)   => (),

  PRecord(flds) => {
    // Bind scrutinee to TRecordOpen of the named fields with a
    // fresh row variable — the pattern accepts any record with AT
    // LEAST these fields. Each sub-pattern infers against a fresh
    // handle of the field's type; field-puning patterns are PVar
    // and bind into env via infer_pat's recursion.
    let row_h = perform graph_fresh_row(Inferred("record pattern row"))
    let field_specs = build_pat_record_field_specs(flds, span)
    let pat_ty = mk_record_open(field_specs, row_h)
    perform graph_bind(handle, pat_ty,
      Located(span, Inferred("record pattern")))
    infer_pat_record_subs(flds, field_specs, span)
  }
}

fn build_pat_record_field_specs(flds, span: ValidSpan) = map((fld) => {
  let (name, _) = fld
  let h = perform mint(Inferred("record pattern field"))
  (name, TVar(h))
}, flds)

fn infer_pat_record_subs(flds, specs, span: ValidSpan) = {
  for_each((pair) => {
    let ((_, sub_pat), (_, ty)) = pair
    match ty {
      TVar(h) => infer_pat(sub_pat, h, span),
      _       => ()
    }
  }, zip(flds, specs))
}

fn infer_pat_tuple(pats, parent_handle, span: ValidSpan) = {
  for_each((p) => {
    let sub_h = perform mint(Inferred("tuple pattern element"))
    infer_pat(p, sub_h, span)
  }, pats)
}

// Bind each PCon sub-pattern to its corresponding constructor param
// type. Mints a fresh handle per sub-pat so PVar bindings carry a
// distinct entry into env. Param-list / sub-pat length mismatch falls
// through silently — surfaced separately as E_ConstructorArity (TODO).
fn bind_pcon_subpats(params, sub_pats, span: ValidSpan, reason, ctor_name) = {
  for_each((pair) => {
    let (TParam(_, pty, _, _), sub_pat) = pair
    let sub_h = perform mint(VarLookup(ctor_name, reason))
    perform graph_bind(sub_h, pty,
      Located(span, VarLookup(ctor_name, reason)))
    infer_pat(sub_pat, sub_h, span)
  }, zip(params, sub_pats))
}

fn infer_match_arms(arms, scrut, result_h, span: ValidSpan) = {
  infer_match_arm_iter(arms, scrut, result_h, span)
  // Exhaustiveness check (H3): if no wildcard arm covers the
  // remainder, every constructor of the scrutinee's declaring type
  // must appear among the arms. ConstructorScheme(_, total_variants)
  // makes this a graph read — no per-type registry needed.
  let covered = collect_arm_tags(arms, [])
  let total = arms_total_variants(arms)
  let has_wild = arms_have_wildcard(arms)
  if total > 0 && covered.len < total && !has_wild {
    perform report("infer", "E_PatternInexhaustive", "PatternInexhaustive",
      "match misses "
        |> str_concat(int_to_str(total - covered.len))
        |> str_concat(" of ")
        |> str_concat(int_to_str(total))
        |> str_concat(" variants — add the missing arms or a wildcard"),
      span, "MachineApplicable")
  }
}

fn infer_match_arm_iter(arms, scrut, result_h, span: ValidSpan) = {
  for_each((arm) => {
    let (pat, body) = arm
    perform env_scope_enter()
    infer_pat(pat, scrut, span)
    infer_expr(body)
    let N(_, _, bh) = body
    unify(bh, result_h, span, MatchBranch(Inferred("arm body"), Inferred("result")))
    perform env_scope_exit()
  }, arms)
}

// Walk arms, gathering each PCon's tag_id (deduped via set_insert).
// Non-PCon arms (wildcards, vars, lits) contribute no tag.
fn collect_arm_tags(arms, own init) = {
  fold(arms, init, (acc, arm) => {
    let (pat, _body) = arm
    match pat {
      PCon(name, _) => match perform env_lookup(name) {
        Some(entry) => {
          let (_, _, kind) = entry
          match kind {
            ConstructorScheme(tag, _) => set_insert(acc, int_to_str(tag)),
            _                         => acc
          }
        },
        None => acc
      },
      _ => acc
    }
  })
}

// Read total_variants from any one PCon arm's ConstructorScheme.
// All variants of a single declaring type carry the same total; the
// FIRST hit is sufficient. Returns 0 when no PCon arm is present
// (e.g., literal-only match) — the exhaustiveness check skips.
fn arms_total_variants(arms) = {
  if arms.len == 0 { 0 }
  else {
    let (pat, _body) = list_head(arms)
    match pat {
      PCon(name, _) => match perform env_lookup(name) {
        Some(entry) => {
          let (_, _, kind) = entry
          match kind {
            ConstructorScheme(_, total) => total,
            _                           => arms_total_variants(list_tail(arms))
          }
        },
        None => arms_total_variants(list_tail(arms))
      },
      _ => arms_total_variants(list_tail(arms))
    }
  }
}

// Wildcard detection: PWild or PVar at the top level catches
// everything the prior arms don't.
fn arms_have_wildcard(arms) = any((arm) => {
  let (pat, _body) = arm
  match pat {
    PWild   => true,
    PVar(_) => true,
    _       => false
  }
}, arms)

/// Handler arm inference — each arm's body is inferred; its type
/// unifies with the body's type so the `handle` expression has a
/// single consistent result type.
fn infer_handler_arms(arms, body_h, span: ValidSpan) = {
  for_each((arm) => {
    perform env_scope_enter()
    infer_expr(arm.body)
    let N(_, _, abh) = arm.body
    unify(abh, body_h, span, Inferred("handler arm result"))
    perform env_scope_exit()
  }, arms)
}

/// Generalization — Damas-Milner let-gen.
/// Quantify handles that are free in the body but NOT free in env.

// H6: exhaustive NodeKind enumeration. Fabricated-value danger:
// a wildcard arm returning Forall([], TVar(handle)) silently
// fabricates a monotype for every non-NBound kind — CLAUDE.md
// Session Zero names this as a dangerous wildcard. Each non-bound
// kind gets its own arm with the same fallback spelled out; if a
// new NodeKind is added, this function fails to compile until its
// generalization semantic is decided.
fn generalize(handle) = {
  let node = perform graph_chase(handle)
  let GNode(kind, _) = node
  match kind {
    NBound(ty) => {
      let body_ty = chase_deep(ty)
      let body_free = free_in_ty(body_ty)
      // env_free_vars is optional — if unavailable, treat as empty.
      // Conservatively: quantify all body-free handles.
      Forall(body_free, body_ty)
    },
    NFree(_)      => Forall([], TVar(handle)),    // unresolved — monotype stays
    NRowBound(_)  => Forall([], TVar(handle)),    // row handle — not a Ty; monotype
    NRowFree(_)   => Forall([], TVar(handle)),    // unresolved row — monotype
    NErrorHole(_) => Forall([], TVar(handle))     // error — preserve handle for diagnostics
  }
}

// H6: exhaustive Ty enumeration. Scalars terminate; aggregates
// recurse. Identity for unresolved TVars (when graph_chase lands
// on a non-NBound kind). A new Ty with embedded sub-types that
// could contain TVars would need its own recursive arm — fails
// to compile here until the decision is made.
fn chase_deep(ty) = match ty {
  TInt    => ty,
  TFloat  => ty,
  TString => ty,
  TUnit   => ty,
  TVar(h) => {
    let node = perform graph_chase(h)
    let GNode(kind, _) = node
    match kind {
      NBound(inner) => chase_deep(inner),
      NFree(_)      => ty,   // unresolved — stays as TVar
      NRowBound(_)  => ty,   // row handle used as Ty — stays
      NRowFree(_)   => ty,   // unresolved row handle — stays
      NErrorHole(_) => ty    // error node — preserve TVar for diagnostics
    }
  },
  TList(elem) => TList(chase_deep(elem)),
  TTuple(elems) => TTuple(map_chase_ty(elems)),
  TFun(params, ret, eff) =>
    TFun(chase_params(params), chase_deep(ret), eff),
  TName(name, args) => TName(name, map_chase_ty(args)),
  TRecord(fields) => TRecord(chase_fields(fields)),
  TRecordOpen(fields, v) => mk_record_open(chase_fields(fields), v),
  TRefined(base, pred) => TRefined(chase_deep(base), pred),
  TCont(ret, disc)     => TCont(chase_deep(ret), disc),
  TAlias(name, inner)  => TAlias(name, chase_deep(inner))
}

fn map_chase_ty(tys) = map(chase_deep, tys)

fn chase_params(params) = map((p) => {
  let TParam(name, ty, auth, res) = p
  TParam(name, chase_deep(ty), auth, res)
}, params)

fn chase_fields(fields) = map((fld) => {
  let (name, ty) = fld
  (name, chase_deep(ty))
}, fields)

// H6: exhaustive Ty enumeration. Scalars have no free handles;
// aggregates recurse; TVar IS a free handle; TRecordOpen's row
// var is free. A new Ty containing TVars would need its own arm —
// `_ => []` would silently miss them.
fn free_in_ty(ty) = match ty {
  TInt                   => [],
  TFloat                 => [],
  TString                => [],
  TUnit                  => [],
  TVar(id)               => [id],
  TList(elem)            => free_in_ty(elem),
  TTuple(elems)          => free_in_list(elems),
  TFun(params, ret, _)   => free_in_params(params) ++ free_in_ty(ret),
  TName(_, args)         => free_in_list(args),
  TRecord(fields)        => free_in_fields(fields),
  TRecordOpen(fields, v) => [v] ++ free_in_fields(fields),
  TRefined(base, _)      => free_in_ty(base),
  TCont(ret, _)          => free_in_ty(ret),
  TAlias(_, inner)       => free_in_ty(inner)
}

fn free_in_list(tys) = flatten(map(free_in_ty, tys))

fn free_in_params(params) = flatten(map((p) => {
  let TParam(_, ty, _, _) = p
  free_in_ty(ty)
}, params))

fn free_in_fields(fields) = flatten(map((fld) => {
  let (_, ty) = fld
  free_in_ty(ty)
}, fields))

/// Instantiation — one function, two handlers.
/// inference handler: `mint(r) => resume(perform graph_fresh_ty(r))`
/// query handler:     `mint(r) => resume(next_display_id(r))`
/// Same function; different semantics via handler swap.

fn instantiate(scheme) = {
  let Forall(qs, ty) = scheme
  if qs.len == 0 { ty }
  else {
    let mapping = build_inst_mapping(qs)
    subst_ty(ty, mapping)
  }
}

fn build_inst_mapping(qs) = map((old) => {
  let fresh = perform mint(Instantiation("inst", Fresh(old)))
  (old, fresh)
}, qs)

// H6: exhaustive Ty enumeration. Scalars pass through;
// aggregates recurse. Substitution is identity for unresolved
// sites where mapping doesn't have the handle.
fn subst_ty(ty, mapping) = match ty {
  TInt    => ty,
  TFloat  => ty,
  TString => ty,
  TUnit   => ty,
  TVar(id) => {
    let replacement = find_mapping(mapping, id)
    if replacement >= 0 { TVar(replacement) } else { ty }
  },
  TList(elem) => TList(subst_ty(elem, mapping)),
  TTuple(elems) => TTuple(subst_list(elems, mapping)),
  TFun(params, ret, eff) => TFun(
    subst_params(params, mapping),
    subst_ty(ret, mapping),
    eff
  ),
  TName(name, args) => TName(name, subst_list(args, mapping)),
  TRecord(fields) => TRecord(subst_fields(fields, mapping)),
  TRecordOpen(fields, v) => mk_record_open(subst_fields(fields, mapping), v),
  TRefined(base, pred) => TRefined(subst_ty(base, mapping), pred),
  TCont(ret, disc)      => TCont(subst_ty(ret, mapping), disc),
  TAlias(name, inner)   => TAlias(name, subst_ty(inner, mapping))
}

fn subst_list(tys, mapping) = map((t) => subst_ty(t, mapping), tys)

fn subst_params(params, mapping) = map((p) => {
  let TParam(name, ty, auth, res) = p
  TParam(name, subst_ty(ty, mapping), auth, res)
}, params)

fn subst_fields(fields, mapping) = map((fld) => {
  let (name, ty) = fld
  (name, subst_ty(ty, mapping))
}, fields)

fn find_mapping(mapping, id) = {
  let hits = filter((entry) => {
    let (old, _) = entry
    old == id
  }, mapping)
  if hits.len == 0 { -1 }
  else {
    let (_, fresh) = head(hits)
    fresh
  }
}

// Registration — ADT constructors, effect ops, handlers

fn mint_param_placeholders(params, owner_name) = map((indexed) => {
  let (idx, _) = indexed
  perform mint(FnParam(owner_name, idx, Inferred("param of '" |> str_concat(owner_name) |> str_concat("'"))))
}, enumerate(params))

fn mint_params(params, owner_name) = map((indexed) => {
  let (idx, p) = indexed
  let TParam(name, _, _, _) = p
  let h = perform mint(FnParam(owner_name, idx, Inferred("param of '" |> str_concat(owner_name) |> str_concat("'"))))
  perform env_extend(name, Forall([], TVar(h)), Declared(name), FnScheme)
  h
}, enumerate(params))

fn build_param_types(params, handles) = map((pair) => {
  let (TParam(name, _, auth, res), h) = pair
  TParam(name, TVar(h), auth, res)
}, zip(params, handles))

fn build_inferred_params(handles) = map((h) =>
  TParam("_", TVar(h), Inferred, Inferred), handles)

fn register_type_constructors(type_name, type_args, variants) = {
  let total = variants.len
  for_each((indexed) => {
    let (tag_id, variant) = indexed
    register_one_variant(type_name, type_args, variant, tag_id, total)
  }, enumerate(variants))
}

fn register_one_variant(type_name, type_args, variant, tag_id, total) = {
  let (ctor_name, field_types) = variant
  let result_ty = TName(type_name, type_args)
  // H2.3 nominal record: a single-variant type whose body is a
  // TRecord registers as RecordSchemeKind, not ConstructorScheme.
  // The env entry binds the type's name to TName directly (no
  // function arrow); NamedRecordExpr inference reads the
  // RecordSchemeKind to validate and lower constructions.
  if total == 1 &&
     field_types.len == 1 &&
     str_eq(ctor_name, type_name) &&
     is_record_ty(list_index(field_types, 0)) {
    let TRecord(declared_fields) = list_index(field_types, 0)
    perform env_extend(ctor_name, Forall([], result_ty),
      Declared(ctor_name),
      RecordSchemeKind(declared_fields))
  } else {
    let kind = ConstructorScheme(tag_id, total)
    if field_types.len == 0 {
      perform env_extend(ctor_name, Forall([], result_ty),
        Declared(ctor_name), kind)
    } else {
      let params = build_ctor_params(field_types, 0)
      perform env_extend(ctor_name,
        Forall([], TFun(params, result_ty, EfPure)),
        Declared(ctor_name), kind)
    }
  }
}

fn is_record_ty(ty) with Pure = match ty {
  TRecord(_)        => true,
  _                 => false
}

fn build_ctor_params(field_types, base_idx) = map((indexed) => {
  let (i, ty) = indexed
  TParam("_" |> str_concat(int_to_str(base_idx + i)), ty, Inferred, Inferred)
}, enumerate(field_types))

fn register_effect_ops(effect_name, ops) = {
  for_each((op) => register_one_op(effect_name, op), ops)
}

fn register_one_op(effect_name, op) = {
  let (op_name, param_types, ret_type) = op
  let params = build_ctor_params(param_types, 0)
  // The op's row is the bare effect name; install-time `with Name(args)`
  // attaches args at the install site, not at op declaration. Op-level
  // params binding to install args is a v2 extension.
  perform env_extend(op_name,
    Forall([], TFun(params, ret_type, mk_ef_closed([ENamed(effect_name)]))),
    Declared(op_name),
    EffectOpScheme(effect_name))
}

fn register_handler(hname, ename, config, state, arms) = {
  // Handlers are first-class values. Per Hβ.first-light.handler-
  // scheme-tfun-shape (2026-05-06): when the handler decl has
  // config-params, its scheme is `TFun([config_tys], Handler<E>,
  // pure_row)` so install-site calls `~> h(arg1, arg2)` unify
  // each arg's type against the corresponding config-param tyvar.
  // Without the TFun shape, `let h: Handler<E>` mismatches
  // `h(args): fn(...) -> ?` at install — the bug surfaced by the
  // minimal `handler h(x) { op() => x }; perform op() ~> h(42)`
  // empirical (E_TypeMismatch at handle 20). Empty-config handlers
  // keep the bare Handler<E> scheme since `~> h` (no parens) is
  // direct application without intermediate call.
  //
  // Per protocol_cursor_is_the_substrate.md (2026-05-07) Phase B:
  // each arm's resume cardinality is INFERRED from the body via
  // $infer_resume_cardinality below; results attach to the
  // corresponding op's TCont in the EffectOpScheme so lower picks
  // Tier 1 (OneShot direct call) vs Tier 3 (heap continuation) per
  // proven cardinality. There is no @resume= annotation; the body
  // IS the contract.
  let handler_ty = TName("Handler", [TName(ename, [])])
  let scheme_body = if config.len == 0 {
    handler_ty
  } else {
    let config_tparams = mint_handler_config_tparams(config, hname, 0)
    TFun(config_tparams, handler_ty, mk_ef_closed([]))
  }
  perform env_extend(hname,
    Forall([], scheme_body),
    Declared(hname),
    FnScheme)
  // Phase B: infer per-arm resume cardinality and bind onto each
  // op's continuation type. The cursor walks each arm body; counts
  // resume call sites under control-flow ancestry; produces
  // ResumeDiscipline. Same projection pattern as $collect_used_wasi_ops
  // in the seed: walk + predicate-filter + project.
  list_iter(arms, (arm) => {
    let kind = infer_resume_cardinality(arm.body)
    perform graph_bind_resume_kind(arm.op_name, ename, kind,
      Located(span_of_node(arm.body), Inferred("resume cardinality from arm body")))
  })
}

/// $infer_resume_cardinality — Phase B substrate. Replaces the
/// @resume= annotation that was erased from all effect declarations
/// across the wheel — cardinality is a graph property of the arm
/// body, not an authored annotation. Per
/// protocol_cursor_is_the_substrate.md (2026-05-07).
///
/// Walks the arm body collecting ResumeExpr handles; classifies via
/// control-flow detection (loop ancestry) + branch disjointness:
///
///   • zero resume sites               → OneShot (catch_abort shape)
///   • one site, not under loop        → OneShot
///   • one site under loop ancestor    → MultiShot
///   • multiple sites, branch-disjoint → OneShot (one per path)
///   • multiple sites, not disjoint    → MultiShot
///
/// Drift refused: 1 (no vtable; structural NodeKind walk); 6 (no
/// primitive-type-special-case for resume — every arm body classified
/// uniformly); 8 (no count-as-string; ResumeDiscipline IS the ADT).
fn infer_resume_cardinality(arm_body) with GraphRead = {
  let resume_sites = collect_resume_sites(arm_body)
  if resume_sites.len == 0 { OneShot }
  else if resume_sites.len == 1 {
    let site = list_head(resume_sites)
    if has_loop_ancestor(site, arm_body) { MultiShot }
    else { OneShot }
  }
  else if all_disjoint_branches(resume_sites, arm_body) { OneShot }
  else { MultiShot }
}

/// Walk arm body's NExpr collecting ResumeExpr handles. Buffer<Handle>
/// per Hβ.runtime.buffer-substrate; freeze to clean List on return.
/// Drift refused: 7 (one Buffer, not parallel arrays); 9 (every
/// container NExpr arm enumerated explicitly, no _ wildcard
/// fabricating ()).
fn collect_resume_sites(arm_body) with GraphRead = {
  let buf = make_buffer(8)
  collect_resume_walk(buf, arm_body)
  buf_freeze(buf)
}

fn collect_resume_walk(buf, node) with GraphRead = {
  let N(body, _, h) = node
  match body {
    NExpr(ResumeExpr(_, _)) => buf_push(buf, h),
    NExpr(BlockExpr(stmts, final)) => {
      list_iter(stmts, (s) => collect_resume_walk(buf, s))
      collect_resume_walk(buf, final)
    },
    NExpr(IfExpr(c, t, e)) => {
      collect_resume_walk(buf, c)
      collect_resume_walk(buf, t)
      collect_resume_walk(buf, e)
    },
    NExpr(MatchExpr(scrut, arms)) => {
      collect_resume_walk(buf, scrut)
      list_iter(arms, (a) => collect_resume_walk(buf, a.body))
    },
    NExpr(CallExpr(f, args)) => {
      collect_resume_walk(buf, f)
      list_iter(args, (a) => collect_resume_walk(buf, a))
    },
    NExpr(BinOpExpr(_, l, r)) => {
      collect_resume_walk(buf, l)
      collect_resume_walk(buf, r)
    },
    NExpr(UnaryOpExpr(_, x)) => collect_resume_walk(buf, x),
    NExpr(LambdaExpr(_, body)) => collect_resume_walk(buf, body),
    NExpr(PerformExpr(_, args)) =>
      list_iter(args, (a) => collect_resume_walk(buf, a)),
    NExpr(MakeListExpr(elems)) =>
      list_iter(elems, (e) => collect_resume_walk(buf, e)),
    NExpr(MakeTupleExpr(elems)) =>
      list_iter(elems, (e) => collect_resume_walk(buf, e)),
    NExpr(MakeRecordExpr(fields)) =>
      list_iter(fields, (f) => collect_resume_walk(buf, f.value)),
    NExpr(NamedRecordExpr(_, fields)) =>
      list_iter(fields, (f) => collect_resume_walk(buf, f.value)),
    NExpr(FieldExpr(b, _)) => collect_resume_walk(buf, b),
    NExpr(PipeExpr(_, l, r)) => {
      collect_resume_walk(buf, l)
      collect_resume_walk(buf, r)
    },
    NExpr(HandleExpr(b, h_arms)) => {
      collect_resume_walk(buf, b)
      list_iter(h_arms, (a) => collect_resume_walk(buf, a.body))
    },
    NStmt(LetStmt(_, v)) => collect_resume_walk(buf, v),
    NStmt(ExprStmt(e)) => collect_resume_walk(buf, e),
    // Leaves: literals, var refs, holes, placeholders, unit — no
    // children carry a body that could contain ResumeExpr.
    NExpr(LitInt(_))    => (),
    NExpr(LitFloat(_))  => (),
    NExpr(LitString(_)) => (),
    NExpr(LitBool(_))   => (),
    NExpr(LitUnit)      => (),
    NExpr(VarRef(_))    => (),
    NExpr(ExprPlaceholder) => (),
    NHole(_) => (),
    NPat(_)  => (),
    NModule(_) => ()
  }
}

/// Loop-ancestry detection. Mentl has LoopExpr (lib/runtime/iterate.mn
/// surface) but in the type-graph it surfaces via tail-recursion in
/// CallExpr — a fn that calls itself in tail position with the
/// resume site inside its body produces effective MultiShot
/// cardinality. Today: structural NLoopExpr ancestor; tail-recursion
/// detection is the gradient-undecided case, peer follow-up
/// `Hβ.infer.tail-recursion-resume-cardinality`.
fn has_loop_ancestor(target_handle, node) with GraphRead = {
  let N(body, _, h) = node
  if h == target_handle { false }
  else { match body {
    NExpr(BlockExpr(stmts, final)) =>
      any(stmts, (s) => has_loop_ancestor(target_handle, s)) ||
      has_loop_ancestor(target_handle, final),
    NExpr(IfExpr(c, t, e)) =>
      has_loop_ancestor(target_handle, c) ||
      has_loop_ancestor(target_handle, t) ||
      has_loop_ancestor(target_handle, e),
    NExpr(MatchExpr(scrut, arms)) =>
      has_loop_ancestor(target_handle, scrut) ||
      any(arms, (a) => has_loop_ancestor(target_handle, a.body)),
    NExpr(LambdaExpr(_, body)) => has_loop_ancestor(target_handle, body),
    NStmt(LetStmt(_, v)) => has_loop_ancestor(target_handle, v),
    NStmt(ExprStmt(e)) => has_loop_ancestor(target_handle, e),
    _ => false
  } }
}

/// Multiple resume sites — disjoint-branch check. Pairwise: each
/// pair lies in disjoint branches of some common If/Match ancestor.
/// O(N²) over resume sites; N is bounded small (typical handler
/// arm has ≤ a few resume sites).
fn all_disjoint_branches(sites, root) with GraphRead = {
  pairwise_disjoint_loop(sites, root)
}

fn pairwise_disjoint_loop(sites, root) with GraphRead = {
  if sites.len <= 1 { true }
  else {
    let head = list_head(sites)
    let tail = list_tail(sites)
    all(tail, (s) => disjoint_branches(head, s, root)) &&
    pairwise_disjoint_loop(tail, root)
  }
}

fn disjoint_branches(a, b, root) with GraphRead = {
  let lca = lowest_common_ancestor(a, b, root)
  let N(body, _, _) = lca
  match body {
    NExpr(IfExpr(_, t, e)) =>
      (contains_handle(t, a) && contains_handle(e, b)) ||
      (contains_handle(t, b) && contains_handle(e, a)),
    NExpr(MatchExpr(_, arms)) => {
      let arm_a = arm_index_containing(arms, a)
      let arm_b = arm_index_containing(arms, b)
      arm_a != arm_b
    },
    NExpr(BlockExpr(_, _)) => false,    // sequential — not disjoint
    _ => false
  }
}

/// Helpers for branch-disjointness detection. Each is a small graph
/// walk; named peer `Hβ.infer.resume-cardinality-helpers` covers the
/// production substrate (lowest-common-ancestor + handle-containment +
/// arm-index-containing). For Phase B today the helpers exist as
/// dream-code interfaces; their bodies fold into named peers as the
/// inference cascade matures past simple OneShot/MultiShot binary.
fn contains_handle(node, target_handle) with GraphRead = {
  let N(body, _, h) = node
  if h == target_handle { true }
  else { match body {
    NExpr(BlockExpr(stmts, final)) =>
      any(stmts, (s) => contains_handle(s, target_handle)) ||
      contains_handle(final, target_handle),
    NExpr(IfExpr(c, t, e)) =>
      contains_handle(c, target_handle) ||
      contains_handle(t, target_handle) ||
      contains_handle(e, target_handle),
    NExpr(MatchExpr(scrut, arms)) =>
      contains_handle(scrut, target_handle) ||
      any(arms, (a) => contains_handle(a.body, target_handle)),
    NExpr(CallExpr(f, args)) =>
      contains_handle(f, target_handle) ||
      any(args, (a) => contains_handle(a, target_handle)),
    NExpr(BinOpExpr(_, l, r)) =>
      contains_handle(l, target_handle) ||
      contains_handle(r, target_handle),
    NExpr(UnaryOpExpr(_, x)) => contains_handle(x, target_handle),
    NExpr(LambdaExpr(_, body)) => contains_handle(body, target_handle),
    NExpr(PerformExpr(_, args)) =>
      any(args, (a) => contains_handle(a, target_handle)),
    NExpr(ResumeExpr(_, _)) => false,   // leaf for our purposes
    NStmt(LetStmt(_, v)) => contains_handle(v, target_handle),
    NStmt(ExprStmt(e)) => contains_handle(e, target_handle),
    _ => false
  } }
}

fn lowest_common_ancestor(a, b, root) with GraphRead = {
  // Find the deepest node that contains both a and b. If a child
  // of root contains both, recurse into that child; else root is
  // the LCA. O(N) per call; root walks once.
  let N(body, _, _) = root
  let descendant_lca = match body {
    NExpr(BlockExpr(stmts, final)) =>
      lca_among_children(append_one(stmts, final), a, b),
    NExpr(IfExpr(c, t, e)) => lca_among_children([c, t, e], a, b),
    NExpr(MatchExpr(scrut, arms)) =>
      lca_among_children([scrut] ++ map(arms, (arm) => arm.body), a, b),
    NExpr(CallExpr(f, args)) => lca_among_children([f] ++ args, a, b),
    NExpr(BinOpExpr(_, l, r)) => lca_among_children([l, r], a, b),
    NExpr(UnaryOpExpr(_, x)) => lca_among_children([x], a, b),
    NExpr(LambdaExpr(_, body)) => lca_among_children([body], a, b),
    NExpr(PerformExpr(_, args)) => lca_among_children(args, a, b),
    NStmt(LetStmt(_, v)) => lca_among_children([v], a, b),
    NStmt(ExprStmt(e)) => lca_among_children([e], a, b),
    _ => None
  }
  match descendant_lca {
    Some(child_lca) => child_lca,
    None => root
  }
}

fn lca_among_children(children, a, b) with GraphRead = {
  if children.len == 0 { None }
  else {
    let head = list_head(children)
    let tail = list_tail(children)
    if contains_handle(head, a) && contains_handle(head, b) {
      Some(lowest_common_ancestor(a, b, head))
    } else {
      lca_among_children(tail, a, b)
    }
  }
}

fn arm_index_containing(arms, target_handle) with GraphRead = {
  arm_index_loop(arms, target_handle, 0)
}

fn arm_index_loop(arms, target_handle, idx) with GraphRead = {
  if arms.len == 0 { -1 }
  else {
    let arm = list_head(arms)
    if contains_handle(arm.body, target_handle) { idx }
    else { arm_index_loop(list_tail(arms), target_handle, idx + 1) }
  }
}

/// The inference primitive — every emergent property is cursor-
/// projected from body structure, never authored as annotation. Per
/// protocol_cursor_is_the_substrate.md: "annotations declare INPUTS
/// to the cursor; never the emergent property itself."
///
/// Three companion substrates land alongside Phase B's resume-
/// cardinality inference, completing the chain of cursor-projected
/// emergent properties:
///
///   • Effect-row inference (Peer 1) — operational at infer_fn:343-420.
///     Body's perform sites accumulate via inf_add_row; declared row
///     compared against inferred via row_subsumes; T_OverDeclared
///     warns when authored row is wider than inferred. Authored row
///     is a CONSTRAINT (must contain inferred), never a contract.
///
///   • Ownership inference (Peer 2) — operational at own.mn's
///     infer_ownership. `Inferred`-marked params get classify_usage
///     which counts var-uses in the body: 0 → Inferred; 1 → Own
///     (affine consume); ≥2 → Ref (borrowed). Authored `own`/`ref`
///     is a constraint over the inferred form.
///
///   • Refinement narrowing (Peer 3 — this section) — flow-sensitive
///     predicate inference. Each narrowing site (if/match/assert)
///     adds a path-conditional predicate; the medium tracks per-
///     program-point refinement maps so lower's verify obligations
///     elide checks the path already proves.
///
/// All four (resume + row + ownership + refinement) follow the same
/// substrate pattern: WALK body structure, PREDICATE-FILTER witness
/// sites, PROJECT aggregated value. Same shape as
/// $collect_used_wasi_ops in the seed. The cursor IS the inference
/// primitive.
///
/// What this enables: the developer writes WHAT THEY MEAN — body
/// structure + ground value types + effect names. Everything else
/// (resume cardinality, effect rows, ownership, refinement bounds)
/// is cursor-projected. Authored declarations BECOME CONSTRAINTS the
/// inference verifies — never contracts the inference must reverse-
/// engineer. The user-facing surface shrinks toward the irreducible.

/// $infer_refinement_narrowing — Phase B.3 substrate. Flow-sensitive
/// refinement inference; per-program-point refinement maps. Each
/// narrowing site adds a path-conditional predicate to the relevant
/// variable's refinement; downstream Verify obligations elide checks
/// that the path already proves.
///
/// Narrowing sites:
///   • `if pred { branch }`        — pred narrows scope of branch
///   • `if pred { } else { branch }` — !pred narrows else branch
///   • `match x { pat => body }`   — pat narrows x's type in body
///   • `assert(pred); rest`        — pred narrows rest of block
///   • function call with refinement-typed param — param's pred holds
///     in the called body's scope
///
/// Result: Map<Handle, Predicate> per program-point. Lower's
/// verify_obligations consult this to elide redundant checks.
///
/// Drift refused: 1 (no vtable; structural NodeKind walk); 6 (no
/// primitive-type-special-case for refinement); 7 (one Map<H,Pred>,
/// not parallel arrays); 8 (Predicate is the ADT — no string-keyed
/// pred-name flag); 9 (every NarrowingSite NExpr arm enumerated;
/// no wildcard fabricating ()).
fn infer_refinement_narrowing(body) with GraphRead = {
  walk_refinement(empty_refinement_map(), body, PTrue)
}

fn walk_refinement(map, node, path_pred) with GraphRead = {
  let N(body, _, _) = node
  match body {
    NExpr(IfExpr(c, t, e)) => {
      let cond_pred = predicate_of_bool_expr(c)
      let map_c = walk_refinement(map, c, path_pred)
      let map_t = walk_refinement(map_c, t, conjunction(path_pred, cond_pred))
      walk_refinement(map_t, e, conjunction(path_pred, negation_of(cond_pred)))
    },
    NExpr(MatchExpr(scrut, arms)) => {
      let map_s = walk_refinement(map, scrut, path_pred)
      walk_refinement_arms(map_s, scrut, arms, path_pred)
    },
    NExpr(BlockExpr(stmts, final)) =>
      walk_refinement_block(map, stmts, final, path_pred),
    NExpr(CallExpr(f, args)) => {
      let map_f = walk_refinement(map, f, path_pred)
      walk_refinement_args_with_param_preds(map_f, f, args, path_pred)
    },
    NExpr(BinOpExpr(_, l, r)) =>
      walk_refinement(walk_refinement(map, l, path_pred), r, path_pred),
    NExpr(UnaryOpExpr(_, x)) =>
      walk_refinement(map, x, path_pred),
    NExpr(LambdaExpr(_, lb)) =>
      walk_refinement(map, lb, PTrue),
    NExpr(PerformExpr(_, args)) =>
      walk_refinement_list(map, args, path_pred),
    NExpr(ResumeExpr(v, _)) =>
      walk_refinement(map, v, path_pred),
    NExpr(MakeListExpr(elems)) =>
      walk_refinement_list(map, elems, path_pred),
    NExpr(MakeTupleExpr(elems)) =>
      walk_refinement_list(map, elems, path_pred),
    NExpr(MakeRecordExpr(fields)) =>
      walk_refinement_fields(map, fields, path_pred),
    NExpr(NamedRecordExpr(_, fields)) =>
      walk_refinement_fields(map, fields, path_pred),
    NExpr(FieldExpr(b, _)) =>
      walk_refinement(map, b, path_pred),
    NExpr(PipeExpr(_, l, r)) =>
      walk_refinement(walk_refinement(map, l, path_pred), r, path_pred),
    NExpr(HandleExpr(b, _)) =>
      walk_refinement(map, b, path_pred),
    NStmt(LetStmt(_, v)) =>
      walk_refinement(map, v, path_pred),
    NStmt(ExprStmt(e)) =>
      walk_refinement(map, e, path_pred),
    NExpr(LitInt(_))    => map,
    NExpr(LitFloat(_))  => map,
    NExpr(LitString(_)) => map,
    NExpr(LitBool(_))   => map,
    NExpr(LitUnit)      => map,
    NExpr(VarRef(_))    => map,
    NExpr(ExprPlaceholder) => map,
    NHole(_) => map,
    NPat(_)  => map,
    NModule(_) => map
  }
}

/// Walk a Match — each arm gets its scrut narrowed by the arm's pattern
/// before walking the arm body. The narrowing is per-arm-scope; once
/// the arm body is walked, its refinement contributions don't leak
/// to other arms (they're branch-disjoint; map-per-arm semantics).
fn walk_refinement_arms(map, scrut, arms, path_pred) with GraphRead = {
  if arms.len == 0 { map }
  else {
    let arm = list_head(arms)
    let arm_pred = pattern_predicate_for(arm.pat, scrut)
    let arm_map = walk_refinement(map, arm.body, conjunction(path_pred, arm_pred))
    walk_refinement_arms(arm_map, scrut, list_tail(arms), path_pred)
  }
}

/// Block walking — stmts may include `assert(pred)` which narrows the
/// rest of the block. Threads path_pred through; each assert
/// strengthens the predicate for subsequent stmts + final expression.
fn walk_refinement_block(map, stmts, final, path_pred) with GraphRead = {
  if stmts.len == 0 { walk_refinement(map, final, path_pred) }
  else {
    let stmt = list_head(stmts)
    let strengthened = strengthen_path_pred(path_pred, stmt)
    let map_s = walk_refinement(map, stmt, path_pred)
    walk_refinement_block(map_s, list_tail(stmts), final, strengthened)
  }
}

fn strengthen_path_pred(path_pred, stmt) with GraphRead = {
  let N(body, _, _) = stmt
  match body {
    NStmt(ExprStmt(e)) => {
      let N(ebody, _, _) = e
      match ebody {
        NExpr(CallExpr(callee, args)) =>
          if is_assert_call(callee) {
            conjunction(path_pred, predicate_of_assert_arg(args))
          } else { path_pred },
        _ => path_pred
      }
    },
    _ => path_pred
  }
}

/// Function-arg walking — each arg's refinement type (if any) provides
/// a predicate that holds in the called body's scope. The caller-side
/// inference doesn't add the predicate to the caller's path_pred (the
/// callee's body is independently walked); the relationship surfaces
/// via signature unification at call site.
fn walk_refinement_args_with_param_preds(map, f, args, path_pred) with GraphRead = {
  walk_refinement_list(map, args, path_pred)
}

fn walk_refinement_list(map, nodes, path_pred) with GraphRead = {
  if nodes.len == 0 { map }
  else {
    let head = list_head(nodes)
    let map_h = walk_refinement(map, head, path_pred)
    walk_refinement_list(map_h, list_tail(nodes), path_pred)
  }
}

fn walk_refinement_fields(map, fields, path_pred) with GraphRead = {
  if fields.len == 0 { map }
  else {
    let field = list_head(fields)
    let map_f = walk_refinement(map, field.value, path_pred)
    walk_refinement_fields(map_f, list_tail(fields), path_pred)
  }
}

/// Helpers — peer-named substrate. Each is a small graph walk; the
/// production-quality bodies fold into named peers as the inference
/// cascade matures past the basic flow-narrowing form.
///
/// $predicate_of_bool_expr — extract Predicate from boolean expression.
/// Operates on graph-typed Bool nodes; converts BinOpExpr (==, <, >,
/// &&, ||) and CallExpr (refinement predicates returning Bool) into
/// Predicate ADT instances. Peer follow-up
/// `Hβ.infer.predicate-from-bool-expression` covers the full case
/// enumeration.
fn predicate_of_bool_expr(node) with GraphRead = {
  PBoolNode(node_handle(node))
}

fn negation_of(pred) = PNot(pred)

fn conjunction(p, q) = PAnd(p, q)

fn empty_refinement_map() = []

fn pattern_predicate_for(pat, scrut) with GraphRead = {
  PPatternMatch(pat, node_handle(scrut))
}

fn is_assert_call(callee) with GraphRead = {
  let N(body, _, _) = callee
  match body {
    NExpr(VarRef(name)) => str_eq(name, "assert"),
    _ => false
  }
}

fn predicate_of_assert_arg(args) with GraphRead = {
  if args.len == 0 { PTrue }
  else { predicate_of_bool_expr(list_head(args)) }
}

fn node_handle(node) = {
  let N(_, _, h) = node
  h
}

/// Mint TParam list for handler config-params. Each name gets a
/// fresh tyvar handle (via mint), wrapped as TParam(name, TVar(h),
/// Inferred, Inferred) — Ownership is Inferred (no authored marker;
/// arm-body usage may constrain). Per Hβ.first-light.handler-scheme-
/// tfun-shape (2026-05-06). Drift refused: 7 (one list of TParam
/// records, not (names, types) parallel arrays); 8 (TParam is the
/// established positional shape, not name-keyed map).
fn mint_handler_config_tparams(config, hname, base_idx) = map((indexed) => {
  let (i, name) = indexed
  let idx = base_idx + i
  let h = perform mint(FnParam(hname, idx, Inferred("config-param of '" |> str_concat(hname) |> str_concat("'"))))   // drift-audit: ignore — |> inside string-build arg, not a pipe verb
  TParam(name, TVar(h), Inferred, Inferred)
}, enumerate(config))

// Utilities

fn infer_expr_list(ref nodes) = for_each(infer_expr, nodes)

fn collect_handles(ref nodes) = map((node) => {
  let N(_, _, h) = node
  h
}, nodes)

fn collect_tvar_types(ref nodes) = map((node) => {
  let N(_, _, h) = node
  TVar(h)
}, nodes)

fn unify_list_elems(elems, target_h, span: ValidSpan) = {
  for_each((elem) => {
    let N(_, _, eh) = elem
    unify(eh, target_h, span, ListElement(Inferred("list element")))
  }, elems)
}

// Each string-interpolation fragment binds to TString. Today's
// bootstrap form unifies every fragment to TString directly;
// post-Show-typeclass (peer Hβ.infer.show-typeclass), non-String
// splices register a Show obligation that verify_ledger discharges.
fn unify_string_fragments(fragments, span: ValidSpan) = {
  for_each((frag) => {
    let N(_, _, fh) = frag
    perform graph_bind(fh, TString, Located(span, Inferred("interpolation fragment")))
  }, fragments)
}

// Handler absorption helpers — used by HandleExpr inference. The
// "handled effects" are the effect NAMES whose ops the arms handle.
// For each arm's op_name, we look up its declaring effect via env
// (an effect op's TFun row carries its effect name, set by
// register_one_op). Missing ops contribute nothing; the subtraction
// is conservative.

/// C4 — derives a short marker for the handler frame from its handled
/// names, e.g. `[IO, Alloc]` → `"handle:IO|Alloc"`. The tag identifies
/// the install position for W4's monomorphic dispatch. Concrete
/// handler-value identity arrives with evidence reification; the
/// handled-name set is the marker H1.4 preserves as a fallback.
fn handler_stack_tag(handled_names) = {
  "handle:" |> str_concat(show_list(handled_names, show_eff_name, "|"))
}

fn collect_handled_effects(arms) = {
  collect_handled_from(arms, [])
}

fn collect_handled_from(arms, own acc) = {
  if arms.len == 0 { acc }
  else {
    let arm = list_head(arms)
    let names = effect_names_of_op(arm.op_name)
    collect_handled_from(list_tail(arms), acc ++ names)
  }
}

fn effect_names_of_op(op_name) = {
  match perform env_lookup(op_name) {
    None => [],
    Some(entry) => {
      let (scheme, _, _) = entry
      let Forall(_, ty) = scheme
      match ty {
        TFun(_, _, row) => row_names(row),
        _               => []
      }
    }
  }
}

fn row_names(row) with Pure = match row {
  EfPure           => [],
  EfClosed(names)  => names,
  EfOpen(names, _) => names,
  _                => []
}

fn read_bound_row(handle) = {
  match perform graph_chase(handle) {
    GNode(NRowBound(row), _) => row,
    _                        => EfPure
  }
}
