// lower.mn — LowIR from live graph observation (spec 05)
//
// The projection. Lowers typed AST into LowIR by reading types LIVE
// from Graph through LookupTy. No cached types in LowExpr. No
// subst threading. An unresolved handle at lower time is a build
// failure, not a fallback.
//
// Declares: with GraphRead + EnvRead + LookupTy + Diagnostic.
// NO GraphWrite — structural isolation via effect row. A stray
// perform graph_bind would fail at handler install.
//
// Handler elimination (the dispatch gradient, PLAN §6):
//   TailResumptive (~85%)  → direct call to the arm's own fn
//   static singleton       → direct call against the handler's state global
//   polymorphic            → call_indirect via the evidence entry
//   MultiShot              → heap continuation record + re-execution driver
// Classification reads TCont's discipline. Monomorphic detection is a
// graph read (row_is_ground), not a sidecar table.
//
// Pipe desugarings (spec 10):
//   left |> right   →  LCall(h, right, [left])
//   left <| (fs)    →  LMakeTuple(h, [f(left) for f in fs])
//   left >< right   →  LMakeTuple(h, [left, right])
//   left ~> right   →  LHandleWith(h, left, right)
//   left <~ spec    →  LFeedback(h, left, spec) — requires iterative ctx

import graph
import types
import runtime/imap
import runtime/persist
import runtime/search
import effects

// Hβ.first-light.resume-with-state-mutation — handler-arm-state context.
// `lower_handler_arms_as_decls` installs `arm_state_ctx(state, disc)` around
// each arm body's lower_expr call; ResumeExpr reads `current_state_fields()`
// to resolve `with field = NEW` updates' slot offsets AND
// `current_resume_discipline()` to pick its representation (OneShot →
// LReturn floor, byte-identical; MultiShot → the LMakeContinuation record).
// The discipline is carried LIVE on the context — read at the resume site,
// never re-derived from a side-ledger (the deleted `resume_kinds`, Anchor 1).
// Config-param-only handler (no state-fields), so it works regardless of
// resume-with-state-update lowering — bootstrap-safe per
// protocol_resume_state_mutation_substrate.md.

effect ArmStateContext {
  current_state_fields() -> [String]
  current_resume_discipline() -> ResumeDiscipline
  current_arm_handler() -> String   // band B M2b — the enclosing arm's handler name; the resume flag-arm names $op___redrive_<hname> with it ("" outside arms)
}

handler arm_state_ctx(fields, disc, hname) {
  current_state_fields()     => resume(fields),
  current_resume_discipline() => resume(disc),
  current_arm_handler()      => resume(hname)
}

// There is NO second handler. The non-arm default ([], OneShot, "") is the
// pipeline BOUNDARY install `~> arm_state_ctx([], OneShot, "")` — so the op
// edge is UNIQUE and every arm-context read dispatches through the singleton
// tier's LIVE `$arm_state_ctx_state_g` (the bracket-scoped global every
// install saves/restores — S1's home). The context is a DYNAMIC fact; its
// one home is the innermost live bracket. The DELETED `arm_state_default`
// twin made the op AMBIGUOUS, pushing these reads to the lexical evidence
// floor — clone-chain threading for a dynamically-scoped truth — and the
// row math (install absorption) then correctly told callers NOT to thread
// it: the give-arm resume read a starved pair four hops from its live
// bracket (the rw4 trap, 2026-07-12). One handler, one home, read live.

// The handler's static shape — config, state, arms — read LIVE from the
// env's HandlerKind (register_handler populates it). No side-ledger, no
// pre-register pass: the graph already names the handler's node, so an
// install resolves its handler's decl directly (Anchor 1 — Carried-Truth).
// The DISSOLVED handler_state_inits_registry re-derived into a name-keyed
// ledger exactly what env_lookup holds live, and its own by-name scan
// (find_registry_field → filter) ran inside a handler arm — re-triggering
// the nested-arm evidence gap it was a workaround for. The LHandleWith emit
// arm stores each state-init at offset 8+i*4 of the freshly-allocated state
// record per protocol_handler_is_state_is_closure_is_evidence.md.
fn handler_decl_of(hname) =
  match env_lookup(hname) {
    Some(entry) => {
      let (_, _, kind) = entry
      match kind {
        HandlerKind(_, config, state, arms) => Some((config, state, arms)),
        _                                      => None
      }
    },
    None => None
  }

// The handler's MultiShot-classified ops as (name, arity) pairs, projected
// live from its decl arms + the op scheme's disc (band B k1/M1.4 — the ONE
// decider the emit's locals walk (walk_lemit) and the LHandleWith emit read; the
// arity drives the driver's $yield_args loads). [] for an unknown/anonymous
// name, so an ungated install keeps the existing emission byte-for-byte
// (Law 7); the anonymous-install-of-a-MultiShot-handler form is the named
// floor Hβ.lower.multishot-anonymous-install (its yield trips the _start
// backstop, loud, never a silent dummy).
fn multishot_ops_of(hname) =
  match handler_decl_of(hname) {
    Some((_, _, arms)) =>
      arms
        |> filter((a) => match op_resume_discipline(handler_arm_op_name(a)) {
             MultiShot => true,
             Abandon   => true,   // M4 — an abandon op needs the driver too: it delivers the arm value on flag-clear (the redrive's existing behaviour IS abandon)
             _         => false
           })
        |> map((a) => (handler_arm_op_name(a), handler_arm_arity(a))),
    None => []
  }

// Lowered state-field inits for a handler, projected live from its decl.
fn lookup_handler_state_inits_of(hname) =
  match handler_decl_of(hname) {
    Some((config, state, _)) => lower_state_field_inits(config, state),
    None                     => []
  }

// Per-effect arm-name groups for a handler, projected live from its decl.
fn lookup_handler_arm_names_of(hname) =
  match handler_decl_of(hname) {
    Some((_, _, arms)) => build_handler_arm_names(hname, arms),
    None               => []
  }

// The arm-ev ledger entry's typed projections ({evs, name}, minted at
// arm_ev_end) — the boundary pin for the generic filter/project flow.
fn registry_entry_name(e: {evs: [String], name: String}) -> String = e.name
fn registry_entry_evs(e: {evs: [String], name: String}) -> [String] = e.evs

fn find_registry_field(name: String, ledger, project) = {
  let hits = filter((entry) => registry_entry_name(entry) == name, ledger)
  if len(hits) == 0 { [] }
  else { project(head(hits)) }
}

// ─── Lower-phase handler-stack ─────────────────────────────────────
// Pushed at each `~>` / handle install (before the body lowers), popped
// after. A Tier-1 perform inside the body resolves the innermost handler
// installed for its op AND that install's handle — so emit threads the
// SAME state record (`__hstate_<h>`) the arm was installed against, not
// the caller's __state misread as state. The handler stack IS a Mentl
// effect (handler IS state); the install handle is
// graph-carried, never re-derived (Anchor 1).
effect LowerHandlerStack {
  lower_handler_push(String, Int) -> Int
  lower_handler_pop() -> Int
  lower_handler_stack_now() -> [{name: String, handle: Int}]
}

handler lower_handler_stack_ctx with stack = [] {
  lower_handler_push(name, install_handle) => {
    resume(0) with stack = stack ++ [{name: name, handle: install_handle}]   // drift-audit: ignore — O(1) push at the end last/drop_last read (the one stack law)
  },
  lower_handler_pop() => {
    if len(stack) == 0 { resume(0) }
    else { resume(0) with stack = drop_last(stack) }
  },
  // Head-first = innermost-first; resolution walks it as a plain fn.
  lower_handler_stack_now() => resume(stack)
}

// The lexical evidence FENCE. A Tier-1 resolution names an `__hstate_<h>`
// LOCAL — a slot of the fn frame the install lowered in. A new fn frame
// (named fn, lambda, handler arm, fanout thunk, reified k) is a NEW WASM
// function: the enclosing frame's locals do not exist there, so lexical
// resolution STOPS at the frame boundary and the perform falls to the
// singleton/evidence tiers (derive_ev_slots already threads enclosing
// evidence through captures — transparent forwarding). Surfaced when THE
// CUT flipped the wheel's choose/enumerate MultiShot and reify_frame_k
// re-lowered pipeline remainders inside fresh k frames while the lexical
// stack still held compile_source's installs (a reified k frame's dangling
// per-install state global); the each-with-effects lambda gap is the
// same hole. The fence entry is name "" — no handler is nameless, so it
// can never shadow a real install.
fn lower_frame_fence_push() = lower_handler_push("", 0)
fn lower_frame_fence_pop() = lower_handler_pop()

// ─── Arm-body evidence ledger ──────────────────────────────────────
// While a handler's arm bodies lower, their Tier-2 performs NOTE the effects
// they dispatch through — the SET, never an order (keying made order
// meaningless). The install threads a keyed [effect][record][base] entry per
// noted effect; the arm fn's LEvPerform KEY-SCANS for it. Closed per
// discriminator into the hev registry so install sites read the set back.
// Hβ.emit.handler-record-ev-capture; the seed's own copy died with it.
effect ArmEvLedger {
  arm_ev_begin() -> Int
  arm_ev_note(String) -> Int
  arm_ev_end(String) -> Int
  lookup_handler_arm_ev_names(String) -> [String]
}

handler arm_ev_ledger_ctx with active = false, names = [], entries = [] {
  arm_ev_begin()  => resume(0) with active = true, names = [],
  arm_ev_note(ename) => {
    // Append-once into the SET the install threads keyed entries for. The
    // arm's read key-scans, so no positional index must be kept stable (the
    // cure for position-as-the-bug). Outside an arm (inactive) → no-op.
    if active && index_of_name(names, ename, 0) < 0 {
      resume(0) with names = list_concat(names, [ename])
    } else { resume(0) }
  },
  arm_ev_end(discriminator) => {
    resume(0)
      with entries = entries ++ [{name: discriminator, evs: names}],   // drift-audit: ignore — O(1) push at the end last/drop_last read
           active  = false,
           names   = []
  },
  lookup_handler_arm_ev_names(hname) => {
    if hname == "" { resume([]) }
    else { resume(find_registry_field(hname, entries, registry_entry_evs)) }
  }
}

fn index_of_name(names: [String], target: String, i) = {
  if i >= len(names) { -1 }
  else if names[i] == target { i }
  else { index_of_name(names, target, i + 1) }
}

// A compiler-created executable edge can fail only by violating one of these
// graph/lower contracts. Keep the failure typed through LowIR; the backend may
// render it, but cannot reinterpret it as a value-producing expression.
type BoundaryInvariant
  = MissingFanoutBoundary
  | WrongFanoutBoundaryKind
  | MissingFanoutEdge(Int)              // expected branch ordinal
  | UnresolvedBoundaryThunk(Int)        // thunk graph handle
  | MissingContinuationBoundary
  | UnfinalizedContinuationBoundary(Int) // continuation graph handle
  | WrongContinuationBoundaryKind
  | NonMultiShotContinuation(ResumeDiscipline)
  | PartialEffectfulCallee(Int)          // callee handle — Hβ.lower.partial-effectful-callee
  | PartialCalleeShape(Int)              // callee handle — Hβ.lower.partial-local-callee
  // A VarRef whose name is in NO env entry. infer already proved it missing
  // (E_MissingVariable, MissingVar Reason); the lowering must not then GUESS
  // it into `(global.get $name)` — the guess is a fabrication of the one fact
  // the graph most clearly holds, and it emits WAT that no assembler accepts,
  // so the medium's own precise diagnostic surfaces 350k lines later as a
  // wat2wasm error about a symbol the developer never wrote. This is the
  // VALUE-path twin of LUnresolvedEvidence: same class, same fix, one site
  // it never reached.
  | MissingName(String)                  // the unbound name

fn show_boundary_invariant(invariant) with Memory + Alloc = match invariant {
  MissingFanoutBoundary          => "missing fanout boundary",
  WrongFanoutBoundaryKind        => "wrong boundary kind at fanout",
  MissingFanoutEdge(i)           => "missing fanout edge at ordinal {int_to_str(i)}",
  UnresolvedBoundaryThunk(h)     => "unresolved boundary thunk {int_to_str(h)}",
  MissingContinuationBoundary    => "missing continuation boundary",
  UnfinalizedContinuationBoundary(h) => "pending continuation boundary {int_to_str(h)}",
  WrongContinuationBoundaryKind  => "wrong boundary kind at continuation",
  NonMultiShotContinuation(disc) => "non-multishot continuation: {show_discipline(disc)}",
  PartialEffectfulCallee(h)      => "partial over effectful callee {int_to_str(h)} — evidence capture at the mint unbuilt",
  PartialCalleeShape(h)          => "partial over non-global callee shape {int_to_str(h)}",
  MissingName(name)              => "unbound name {name} — infer proved it missing; the lowering will not guess it into a global"
}

// Every value-bearing variant carries a source TypeHandle (Int), never a cached Ty.
// Type reads go through `perform lookup_ty(h)`. Emit consumes this IR;
// the handle is the live bridge back to the graph.
type LowExpr
  = LConst(Int, LowValue)
  | LLocal(Int, String)                        // handle, local name (matches LLet storage)
  | LGlobal(Int, String)                       // handle, name
  | LLet(Int, String, LowExpr)
  | LUpval(Int, Int)
  | LBinOp(Int, BinOp, LowExpr, LowExpr)
  | LUnaryOp(Int, UnaryOp, LowExpr)
  | LCall(Int, LowExpr, [LowExpr])             // monomorphic direct call
  | LTailCall(Int, LowExpr, [LowExpr])
  | LReturn(Int, LowExpr)
  | LMakeClosure(Int, LowFn, [LowExpr], [LowExpr]) // handle, fn, captures, ev_slots
  // VALUE-position reference to an EXISTING named fn that DISPATCHES effects —
  // the evidence-capturing twin of LGlobal (which carries NO ev region) and the
  // dispatch-less twin of LSuspend (which CALLS). Builds the unified record
  // [fn_ptr@0][capture_count=0@4][key,ev pairs @8+8*j] for `$<name>_idx` so a fn passed as a
  // value (`each(infer_stmt, stmts)`) carries its evidence into the record
  // the callee reads as __state — Carried-Truth: the two divergent fn-value
  // paths (bare LGlobal vs evidence-bearing LMakeClosure) unified into ONE
  // capture. Emits NO body (the fn is emitted at its own declaration). A pure
  // fn-value stays bare LGlobal (len(ev)==0, Law 7); the CALLEE position stays
  // bare LGlobal (lower_callee_ref collapses an LFnRef callee).
  | LFnRef(Int, String, [LowExpr])               // handle, fn-name, ev_slots
  // The YIELD of a MultiShot perform (band B, continuation-reification k1):
  // (frame, op_name, args, k). The frame = the REWRITTEN
  // FRAME's tail node — the yield's dummy returns through the frame's own
  // result width (never the perform's; a Float-tailed frame keeps its f64
  // ft). args (band B M1.4, bank Ruling 3) = the op's lowered arg exprs,
  // evaluated at the yield site in the enclosing frame (the
  // already-computed prefix) and shipped as a TRANSIENT heap record in
  // $yield_args, consumed once by the matching driver dispatch inside the
  // same unwind — k is durable (immutable, called N times, composed onto);
  // args are not. [] on every floor and on argless yields (an argless
  // yield's emitted bytes are unchanged). k_expr = LMakeContinuation (the
  // real yield: k → $yield_k, interned op → $yield_op, 1 → $yield_flag,
  // width-aware dummy) or LConst(_, LInt(0)) (the LOUD floor — off-spine
  // perform / off-spine k2 boundary / arm-state / re-yield: a
  // comment-marked unreachable, censusable; k2/k3's named homes
  // Hβ.lower.continuation-callboundary-bubble /
  // Hβ.lower.multishot-reyield-composition / .multishot-arm-state-commit).
  | LYield(Int, String, [LowExpr], LowExpr)
  // band B M1.3 — the k2 call-boundary's yield path (the bank Ruling 5): a
  // non-tail can-yield call returned with $yield_flag still raised, so this
  // frame's remainder composes onto the unwinding k and the unwind
  // propagates. handle = the FRAME's tail node (the dummy's width source —
  // the same width law LYield's dummy follows); the LowExpr = the frame_k
  // record (an LMakeContinuation, the remainder-with-hole reified). Emit:
  // push frame_k, `call $__k_extend` ($yield_k becomes compose($yield_k,
  // frame_k) — M1.2's pair), then the width-honest dummy WITH $yield_flag
  // AND $yield_op untouched — pure dataflow, no control transfer: the dummy
  // flows to whatever consumes the frame value (the fn return, or the
  // install driver's parked $__hres), which is what makes the check correct
  // INSIDE an install body (a `(return)` here would skip the driver bracket).
  | LKExtend(Int, LowExpr)
  | LMakeContinuation(Int, LowFn, [LowExpr], [LowExpr], Int, Int, Int)
  // H7 — multi-shot continuation record per the H7 walkthrough §1.2.
  // handle, resume-fn, captures, ev_slots, state_index, ret_slot,
  // world_tag. Heap-allocated through emit_alloc (one allocator per kernel
  // crystallization #8 — the heap has one story); fn_index field
  // points to the synthesized __resume function registered in the
  // WASM funcref table; state_index discriminates which perform site
  // resumed; ret_slot reserves the local slot for the resumed value;
  // world_tag is the legacy 32-bit effect-name fingerprint. It is carried for
  // layout compatibility only: collisions, parameter erasure, open tails, and
  // missing activation identity make it unsuitable as a resume proof.
  // Composes with LMakeClosure's capture/ev-store loops; emit shares
  // the per-field store helpers (per H7 §4.2).
  | LDeclareFn(LowFn)                            // module-level fn declaration (handler arm) — no runtime slot
  | LIf(Int, LowExpr, [LowExpr], [LowExpr])
  | LBlock(Int, [LowExpr])
  | LMakeList(Int, [LowExpr])
  | LMakeTuple(Int, [LowExpr])
  // SIMD lane pack — the `~> Simd` cash-out of a `><` f32 fanout (W13). The N
  // branch results (each an f32-repr value) become the N lanes of a v128: emit
  // a zeroed `v128.const f32x4` base, then `f32x4.replace_lane i` for each
  // branch. The branch thunks are the SAME strategy-neutral closures Seq/Thread
  // run — only the COLLECTOR differs (lanes, not a tuple). The result is one
  // v128 the lane ops (emit_binop_v128) operate on in parallel — the value
  // layer (RV128 repr) meeting the `><` parallel verb at the SPACE axis.
  | LSimdLanes(Int, [LowExpr])                 // handle, [lane_value] (≤4 f32 branch results → v128)
  | LMakeRecord(Int, [LowExpr])                // handle, [field_value] sorted by field name
  | LMakeVariant(Int, TagId, [LowExpr])        // handle, tag_id, field exprs
  | LMatch(Int, LowExpr, [(LowPat, LowExpr)])
  | LSuspend(Int, Int, LowExpr, [LowExpr], [LowExpr], Bool)   // handle, op_h, fn_expr, args, ev_slots, tail — mark_tail is the ONE writer of tail=true; emit renders return_call_indirect (the seed's clone-then-tail-call form; without it every evidence-threading recursion burned a frame per step — m3's iterate_from stack exhaustion, 2026-07-09)
  // ~> desugaring. ONE handler record (handler IS state IS closure IS
  // evidence): [_@0][nstate FENCE@4][state@8..][arms per-effect-contiguous][captured_evs].
  //   4th = handler_name ("" for anonymous — no per-handler state global).
  //   5th = the state inits ([LowExpr], source-order; written at 8+i*4).
  //   6th = arm_names — per-effect groups of (effect name, arm-fn names), op-decl
  //         order within each effect; emit lays each group contiguously and
  //         builds a thin [record, base] evidence-entry per effect.
  //   7th = captured_evs ([LowExpr]) — the install-site evidence the arm
  //         bodies perform through, resolved at THIS position; written after
  //         the arms so the arm fn's LowFn fence lands its LEvPerform reads.
  // Per protocol_handler_is_state_is_closure_is_evidence.md +
  // Hβ.lower.multi-effect-ev-index-map (Part 2) + Hβ.emit.handler-record-ev-capture.
  | LHandleWith(Int, LowExpr, LowExpr, String, [LowExpr], [{arms: [String], ename: String}], [LowExpr])
  | LFeedback(Int, LowExpr, LowExpr)           // <~ desugaring (iterative ctx required)
  // (LF.B) the prior-iteration output of feedback handle h, read LIVE from the
  // $__fb_prev_<h> local the LFeedback emit declares + loads. A `<~` lambda
  // param (`(prev) => ...`) lowers to THIS — the recurrence y[n]=f(x[n],y[n-1])
  // is expressed, not commented. Carried-Truth: the feedback NODE is the value;
  // no register copy, no snapshot — emit reads the one local the cycle writes.
  | LFeedbackPrior(Int)                        // handle of the enclosing <~ site
  // effect op invocation — Tier-1 direct-call form. 4th = state_local: the
  // install-LOCAL name "__hstate_<h>" of the lexically-enclosing handler the
  // arm runs against ("" sentinel = use caller __state). Threads the handler's
  // STATE RECORD as the arm-call's __state per handler-IS-state.
  | LPerform(Int, String, [LowExpr], String)
  // Tier-2 evidence-dispatched perform (handler comes from the caller via
  // an evidence slot on __state — handler IS evidence). The ev-slot holds
  // a per-effect entry [record ptr, base]; the arm runs against that RECORD
  // as its __state. The effect is addressed by its decl-IDENTITY (the effect
  // name as key), NEVER by a position in this fn's row — position shifts under
  // any row delta (the mn-eq→str_concat miscompile, proven). op_slot stays a
  // position: it indexes the effect's OWN immutable decl-order op-list (a
  // stable identity, not a row position). emit reads via a KEY-SCAN of the
  // self-describing captured_evs region [key@0][record@4][base@8] entries:
  //   entry  = scan __state captured_evs for str_eq(entry.key, the effect key)
  //   record = entry[record];  base = entry[base]
  //   arm    = record[8 + 4*record[4] + 4*(base + op_slot)]  (fence-relative
  //            off the record's OWN nstate@4) — an interior read, never a
  //            static body-captures guess.
  | LEvPerform(Int, String, String, Int, [LowExpr]) // handle, op_name, effect-key, op_slot, args
  // Forward THIS fn's evidence for an effect (the handler record the caller
  // threaded into __state) by IDENTITY (effect_key) into a deeper callee's
  // record or an install's captured-ev region — the caller fills the SAME key,
  // so adding/removing a sibling effect shuffles nothing (the position-as-the-
  // -bug cure). The polymorphic-scope companion of derive_ev_slots' keyed entries.
  | LEvRef(Int, String)                        // handle, effect_key (the effect name)
  // The typed-absence bottom: an effect with NO resolvable handler anywhere up
  // the install chain (a genuine E_HandlerUninstallable). NOT slot-0 — slots no
  // longer exist, so the fabrication is unsayable; this carries a Located Reason.
  | LUnresolvedEvidence(Int, String)           // handle, effect_key
  // A keyed captured-ev entry: the effect's IDENTITY (key) paired with its
  // resolved evidence (LLocal / LGlobal / LEvRef). emit writes [key][record][base];
  // a perform's key-scan matches `key` by str_eq. The list of these IS the
  // self-describing captured_evs region — its ORDER carries no meaning (the cure
  // for position-as-the-bug: a sibling effect appearing shuffles no key).
  | LEvEntry(String, LowExpr)                  // effect_key, resolved evidence
  // W6: handle, record, SELECTOR. The byte offset is a PROJECTION of the
  // receiver's resolved type (prefix-sum of repr_width over the sorted
  // fields) and projects at EMIT under the active specialization bracket —
  // never a lower-time bake, so a generic body's field read heals when its
  // call site's instantiation closes the record (the LShow precedent, one
  // layer deeper). FByName selects a record field; FByIndex a positional
  // product slot.
  | LFieldLoad(Int, LowExpr, FieldSel)
  // W11: a REAL machine int<->float conversion — the gradient's coercion arm.
  // float_of_int / float_to_int are NOT identity stubs that reinterpret bits
  // (a silent miscompile); they are a value-changing convert: i32->f64 is
  // f64.convert_i32_s, f64->i32 (truncating toward zero) is i32.trunc_f64_s.
  // The kind is an ADT (never a string flag); emit projects the one WASM op.
  | LConvert(Int, ConvertKind, LowExpr)        // handle, direction, operand
  // Hβ.first-light.resume-with-state-mutation: `resume(val) with field =
  // expr` per SUBSTRATE.md L660-694 lowers each (field, value) update to
  // an LStateSlotStore preceding the LReturn. slot_offset is field source-
  // order * 4 per §IX "Records Are The Handler-State Shape" L1282; the
  // arm fn's __state IS the handler's state record per
  // protocol_handler_is_state_is_closure_is_evidence.md, so the store
  // mutates handler state across resume calls.
  | LStateSlotStore(Int, Int, LowExpr, String)  // handle, slot_offset, value, record home ("" = the arm's $__state — byte-frozen OneShot; else $<name>_state_g, the bracket-scoped singleton a closure context reaches — the lambda's own $__state is its closure record, the measured 32-not-46 silent state loss)
  | LShow(Int, LowExpr)             // to_string — operand type read at EMIT under the active
                                    //   specialization bracket (show_node_of, backends/wasm.mn —
                                    //   the one dispatch home; emit_binop_for's altitude)
  | LHash(Int, LowExpr)             // hash — the same emit-time read (eq/hash agreement in twins)
  // Typed terminal for a compiler-created executable-edge invariant. It has no
  // value representation and no recovery arm; emit projects only `unreachable`.
  | LInvariantFailure(Int, BoundaryInvariant)
  // Stage 4a: direct WASM-level import call. perform-form recognized at
  // lower-time when op_name matches a known WASI import (wasi_thread_spawn,
  // wasi_num_cores, fd_write, fd_read, path_open, etc.) bridges
  // through this variant so emit produces `(call $<import_name> args)`
  // directly — bypassing the LPerform/$op_<name> handler-arm dispatch
  // (which would require a wrapper fn). The import IS the bridge; no
  // wrapper. Per protocol_bootstrap_wasi_threads_substrate.md Stage 4.
  | LWasiCall(Int, String, [LowExpr])          // handle, import name (no $ prefix), args

// The two directions of int<->float conversion. An ADT, not a string/int flag
// (drift 8): each direction projects exactly one signed WASM convert op.
type ConvertKind
  = IntToFloat       // f64.convert_i32_s — i32 value widened to its f64
  | FloatToInt       // i32.trunc_f64_s   — f64 truncated toward zero to i32

type LowValue
  = LInt(Int)
  | LFloat(Float)
  | LString(String)
  | LBool(Bool)

type LowFn
  = LFn(String, Int, [String], [LowExpr], EffRow, Int)
                  // name, arity, param names, body stmts, effect row, fence.
                  // fence = where this fn's __state evidence region starts,
                  // in slots past the 8-byte header: closures pass their
                  // capture count; handler arm fns pass nstate+total_arms
                  // (the record's captured-evs sit after state AND arms);
                  // plain top-level fns pass 0. emit_fn_body installs it as
                  // the body-context so every LEvPerform/LEvRef key-scans the
                  // captured_evs region based at 8+4*fence — one rule across all three fn shapes.

type FieldSel
  = FByName(String)
  | FByIndex(Int)

type LowPat
  = LPVar(String)
  | LPWild
  | LPCon(String, TagId, [LowPat])   // name, tag_id (from ConstructorScheme), sub-pats
  | LPUnresolvedCon(String, [LowPat]) // a pattern naming a ctor no declaration proves — infer already reported the miss; the match test is FALSE (no tag exists to compare) and the sub-binders still declare so the dead arm body assembles. Replaces the fabricated tag -1, which violated TagId's own 0..255 refinement — the armed E_RefinementRejected caught it on the wheel the hour the class armed.
  | LPTuple([(Int, Ty, LowPat)])     // [(offset_bytes: Int, elem_ty: Ty, sub_pat: LowPat)]
                                     // positional product: width-summed offset +
                                     // the element's proven Ty (emit reads
                                     // repr_of(ty) for the leaf load width — RI32
                                     // for a pointer element, RF64 for an f64)
  | LPLit(LowValue)
  | LPList([LowPat], Option(String), SeqRep)  // prefix pats, optional rest name,
                                             // the scrutinee's PROVEN representation
                                             // (SRFlat licenses raw element loads)
  | LPRecord([(String, Int, LowPat)]) // [(field_name: String, offset_bytes: Int, sub_pat: LowPat)]
  | LPAlt([LowPat])                  // alternation branches; arm matches if ANY
                                     // branch matches (predicate = OR); branches
                                     // bind the same names (infer's law)

// Extract the source TypeHandle from any `LowExpr` variant.
// One arm per variant, no fallback — new variants surface at compile time.
fn lexpr_handle(e) with Pure = match e {
  LConst(h, _)            => h,
  LLocal(h, _)            => h,
  LGlobal(h, _)           => h,
  LLet(h, _, _)           => h,
  LUpval(h, _)            => h,
  LBinOp(h, _, _, _)      => h,
  LUnaryOp(h, _, _)       => h,
  LCall(h, _, _)          => h,
  LTailCall(h, _, _)      => h,
  LReturn(h, _)           => h,
  LMakeClosure(h, _, _, _) => h,
  LFnRef(h, _, _)         => h,
  LShow(h, _)             => h,
  LHash(h, _)             => h,
  LMakeContinuation(h, _, _, _, _, _, _) => h,
  LYield(h, _, _, _)      => h,
  LKExtend(h, _)          => h,
  LDeclareFn(_)            => 0,
  LIf(h, _, _, _)         => h,
  LBlock(h, _)            => h,
  LMakeList(h, _)         => h,
  LMakeTuple(h, _)        => h,
  LSimdLanes(h, _)        => h,
  LMakeRecord(h, _)       => h,
  LMakeVariant(h, _, _)   => h,
  LMatch(h, _, _)         => h,
  LSuspend(h, _, _, _, _, _) => h,
  LHandleWith(h, _, _, _, _, _, _) => h,
  LFeedback(h, _, _)      => h,
  LFeedbackPrior(h)       => h,
  LPerform(h, _, _, _)    => h,
  LEvPerform(h, _, _, _, _) => h,
  LEvRef(h, _)            => h,
  LUnresolvedEvidence(h, _) => h,
  LEvEntry(_, ev)         => lexpr_handle(ev),
  LFieldLoad(h, _, _)     => h,
  LConvert(h, _, _)       => h,
  LStateSlotStore(h, _, _, _) => h,
  LInvariantFailure(h, _) => h,
  LWasiCall(h, _, _)      => h
}

// to_string / hash are STRUCTURAL nodes (LShow / LHash) — their type
// dispatch lives at EMIT (show_node_of / hash_node_of, backends/wasm.mn),
// where the operand's type is read live under whatever specialization
// bracket is active. Lower used to read the type HERE and bake a renderer
// NAME into the tree — the one pair of type-directed decisions an emit-time
// bracket could not re-make (a twin's to_string on its instantiated var
// rendered the ADDRESS; its hash used the pointer). The reach projections
// (show_reach_names / hash_reach_names, beside wide_binop_seed) mirror the
// same dispatch so the prune keeps what emit will mint.

// Hβ.lower.tail-call-mark-pass — rewrite LCall→LTailCall in tail position.
// Tail position is a structural property: branches of LIf, last stmt of
// LBlock, arm bodies of LMatch. LHandleWith / LFeedback do NOT
// propagate tail (their cleanup runs after the body's last expression).
// Without this, lex_from / scan_decimal recursive calls compile as
// regular call_indirect and exhaust the WASM stack on long inputs.
// Called by FnStmt / LambdaExpr / handler-arm-body lowering after lower_expr.
fn mark_tail(e) with Memory + Alloc = match e {
  LCall(h, fn_, args)         => LTailCall(h, fn_, args),
  // An evidence-threading call in tail position stays LSuspend — the sst_
  // clone is argument computation — but the dispatch becomes a TAIL call.
  // Without this arm the wildcard kept it plain and every effectful
  // recursion (iterate_from over the 36k-line wheel) burned a frame per
  // step: m3's m4-generation stack exhaustion, 2026-07-09.
  LSuspend(h, o, f, args, ev, _) => LSuspend(h, o, f, args, ev, true),
  LIf(h, cond, then_b, else_b) =>
    LIf(h, cond, mark_tail_last_in(then_b), mark_tail_last_in(else_b)),
  LBlock(h, stmts) => LBlock(h, mark_tail_last_in(stmts)),
  LMatch(h, scrut, arms) => LMatch(h, scrut, mark_tail_arms(arms)),
  _ => e
}

// Return a fresh flat list with the last element replaced by mark_tail(last).
// Materializes via list_to_flat so callers can pass any list shape (concat,
// slice, snoc) — substrate-honest per list_set's tag=0 contract.
fn mark_tail_last_in(stmts) with Memory + Alloc = {
  let n = len(stmts)
  if n == 0 { stmts }
  else {
    let flat = list_to_flat(stmts)
    let last_idx = n - 1
    list_set(flat, last_idx, mark_tail(list_index(flat, last_idx)))
  }
}

fn mark_tail_arms(arms) with Memory + Alloc = map((arm) => {
  let (pat, body) = arm
  (pat, mark_tail(body))
}, arms)

// When the callee's effect row is ground AND pure (the empty closed
// triple), emit `LCall` (direct). A ground non-empty row like
// `EfRow([Iterate], [], EtClosed)` still needs evidence — the callee performs
// effects whose handler comes from the caller. The row IS the
// evidence contract: non-empty row → evidence threading required.
fn monomorphic_at(h) with LookupTy = {
  match lookup_ty(h) {
    TFun(_, _, row) => row_is_ground(row) && row_is_effectless(row),
    _               => true
  }
}

// True when the row carries no effect names — the callee performs
// nothing, so no handler evidence is needed at the call site.
fn row_is_effectless(row) = {
  let EfRow(p, _, t) = row
  match t {
    EtClosed => len(p) == 0,
    _        => false
  }
}

// Read the construction-origin metadata an env entry carries.
// `None` when the name isn't bound (a missing-var diagnostic has
// already fired at infer time; lower's path falls through to the
// default `LGlobal`/`LCall` shape).
fn env_kind_of(name) = {
  match env_lookup(name) {
    None        => None,
    Some(entry) => {
      let (_, _, kind) = entry
      Some(kind)
    }
  }
}

// Default-fill, labeled-arg reorder, and label resolution are now ONE read —
// resolve_call_args (types.mn), called by both infer and lower so they see the
// identical positional product order. The former lower-only trailing-default
// fill (lower_args_with_defaults / callee_params_of / lower_default_fills)
// dissolved into it: a call constructs its arg product positionally, by field,
// or mixed, with absent fields drawing their param default — one machinery.

// The callee's name for resolve_call_args — a VarRef / field / nested config
// CallExpr names a declared fn with params; any other callee expr has no
// declared params (resolution is positional passthrough), so "" suffices.
fn lower_callee_name(fbody) = match fbody {
  NExpr(VarRef(name))        => name,
  NExpr(FieldExpr(_, field)) => field,
  NExpr(CallExpr(callee, _)) => {
    let N(cb, _, _) = callee
    lower_callee_name(cb)
  },
  _ => ""  // drift-audit: ignore — "" = callee has no declared name (positional passthrough)
}

// The `CallExpr` dispatch falls back to this when the callee isn't a
// `SchemeKind`-recognized constructor or effect op. Monomorphic case:
// direct `LCall` (callee's row is ground; no evidence needed).
// Polymorphic case: `LSuspend` with `ev_slots` derived from the callee's
// row — each unground op resolves to the global handler arm's `fn_idx`
// via the `op_<name>` naming convention H1.4 established.
// THE callee-position read: a fn being CALLED stays BARE. The value-position
// consumer (VarRef RGlobal arm) now mints LFnRef for an effectful named-fn
// VALUE; a CALLEE provides its evidence through __state threading (LSuspend) or
// is monomorphic (LCall), so it must NOT carry a value-record. Collapse an
// LFnRef callee back to the bare LGlobal it was before — byte-identical (LFnRef
// carries the SAME handle+name the pre-split LGlobal held). The split that keeps
// every effectful direct call's bytes untouched (Law 7).
fn lower_callee_ref(f) = match lower_expr(f) {
  LFnRef(h, n, _) => LGlobal(h, n),
  lo              => lo
}

fn lower_call_default(handle, f, fh, lo_args) = {
  let lo_f = lower_callee_ref(f)
  // The fork reads the SAME projection the threading fills: derive_ev_slots
  // (the callee's escaping row, resolved in this caller's scope). Entries
  // present ⇒ the callee's performs key-scan for them ⇒ thread the transient
  // (LSuspend). Empty ⇒ bare call. The old monomorphic_at fork read the CALL
  // node's type (the result — rarely a TFun) and called GROUND rows
  // "monomorphic", so every effectful prelude call (Closed[Iterate]) went
  // BARE and the callee's strict scan met an empty region — the 0/34 floor.
  // Groundness is a row-VARIABLE fact; evidence need is an ESCAPING-ROW fact.
  let ev_slots = derive_ev_slots(fh)
  // THE CUT (bank Ruling 2/A3): a call to a resume-BOUND fn from a
  // MultiShot context threads the "__resume" k evidence — the arm's
  // lexical __k, a closure's captured __k, or a bound fn's own forwarded
  // entry, all through the ONE resolve_resume_k ladder. The callee's
  // resumes read it back by the same keyed scan every perform uses.
  let ev_slots2 =
    if resume_bind_target(fh) {
      ev_slots ++ [LEvEntry("__resume", resolve_resume_k(handle))]   // drift-audit: ignore — one entry per call site, not a loop
    } else { ev_slots }
  if len(ev_slots2) == 0 {
    LCall(handle, lo_f, lo_args)
  } else {
    LSuspend(handle, fh, lo_f, lo_args, ev_slots2, false)
  }
}

// The saturated call's ONE dispatch body — two callers project through it:
// lower_expr's CallExpr arm (behind the partial fork) and lower_pipe_complete
// (fork-free by construction: the pipe owns its hole and completes it by the
// inline splice, so a pipe-right hole-bearing call must never mint a partial
// closure — the splice is the zero-record, evidence-correct projection of
// the same hole-filling semantics).
fn lower_call_dispatch(handle, f, fh, fbody, r_args) = {
  let lo_args = lower_expr_list(r_args)
  match fbody {
      NExpr(VarRef(name)) =>
        if name == "to_string" && len(r_args) == 1 {
          LShow(handle, last(lo_args))
        } else if name == "hash" && len(r_args) == 1 {
          // hash(x) IS the HASH leaf of the structural fold — dispatched at
          // EMIT from the node's live type (hash_node_of), never a name baked
          // here, so a twin's bracket re-answers it (eq/hash agreement).
          LHash(handle, last(lo_args))
        } else if name == "float_of_int" && len(r_args) == 1 {
          // W11: the gradient's coercion arm — a REAL i32->f64 widen
          // (f64.convert_i32_s), never an identity stub reinterpreting bits.
          LConvert(handle, IntToFloat, last(lo_args))
        } else if name == "float_to_int" && len(r_args) == 1 {
          // f64->i32 truncating toward zero (i32.trunc_f64_s) — the value-
          // faithful inverse, replacing the bit-reinterpreting identity stub.
          LConvert(handle, FloatToInt, last(lo_args))
        } else if is_substrate_mem_op(name) {
          // Memory / Alloc ops ARE the instruction set — "the WASM runtime
          // IS the handler" (lib/runtime/memory.mn). They project to raw
          // instructions, never through evidence: routing them Tier-2 made
          // the evidence scan's own loads dispatch through the evidence
          // scan (ev_perform_entry ⇄ ev_scan, the handler rung's runtime
          // stack overflow). LWasiCall is the direct-substrate node; emit
          // dispatches the name to its instruction.
          LWasiCall(handle, name, lo_args)
        } else { match env_kind_of(name) {
        Some(ConstructorScheme(tag_id, _)) =>
          LMakeVariant(handle, tag_id, lo_args),
        Some(RecordSchemeKind(_)) =>
          // Nominal-record CALL-form construction `Pri({...})`: the runtime
          // representation IS the bare record (NamedRecordExpr's own arm
          // lowers to LMakeRecord — type identity is type-system-only, no
          // tag). The single argument already IS that record; the wrapper
          // is the identity at this layer. Arity is the infer gate's
          // business (the ctor-pattern arrow view unifies one param); a
          // zero-arg call (already reported there) lowers to the empty
          // record, never a garbage read past an empty args list.
          if len(lo_args) == 0 { LMakeRecord(handle, []) } else { list_index(lo_args, 0) },
        Some(EffectOpScheme(_, _, _, _)) =>
          // Row-guided dispatch per SUBSTRATE.md §"Three Tiers of
          // Effect Compilation". The row IS the evidence contract:
          //   - Effect in declared row → Tier 2: LEvPerform (handler
          //     comes from caller via evidence slot on __state)
          //   - Effect NOT in row → Tier 1: LPerform (handler is
          //     locally installed, direct call)
          // A WASI import op bridges directly to the WASM-level import
          // (no $op_<name> handler arm) — the import IS the bridge.
          if is_wasi_import_op(name) {
            LWasiCall(handle, name, lo_args)
          } else {
            lower_perform_dispatch(handle, name, lo_args)
          },
        _ => lower_call_default(handle, f, fh, lo_args)
      } },
      _ => lower_call_default(handle, f, fh, lo_args)
  }
}

// The partial fork's ONE decider — the lower mirror of infer_call's dispatch
// (the same call_hole_index read, the same is_seq_op precedence, the same
// fn-typed-callee gate): Some(n) = the callee declares n params and the
// resolved args carry an authored `??` slot; None = saturated, or not a
// fn-typed callee (infer's own saturated fallback, mirrored). The decider's
// proof — the declared arity — travels to the mint; it is never re-derived
// there. The AUTHORED hole is the one reliable signal: the bare positional
// prefix k<n also types as a partial at infer, but under productive-under-
// error a recovered callee's TFun arity is a guess, and flooring every
// arity-mismatched recovered call collapses the module — the prefix form
// mints only from proven arity (Hβ.lower.partial-prefix-arity, gated on the
// recovered-inference population).
fn partial_unfilled(cname, fh, r_args) =
  if is_seq_op(cname) { None }
  else if call_hole_index(r_args, 0) < 0 { None }
  else { match lookup_ty(fh) {
    TFun(ps, _, _) =>
      // Over-application (more args than params — a recovered arity error)
      // dispatches as before: the mint's slot walk stops at the param count
      // and would silently drop the surplus args' evaluation, so it never
      // fires there.
      if len(r_args) <= len(ps) { Some(len(ps)) } else { None },
    _              => None
  } }

// The partial's declaration-order slots — ONE walk, each arg visited once
// (O(1) per slot; the flat r_args indexes O(1)), producing all three
// projections in the same descent: (captures, param_names, body_args).
// A supplied slot's arg lowers HERE, in arg order (evaluation-once —
// product fields are constructed at the product's mint, filling a hole
// RESUMES and never re-evaluates), rides the closure record, and is read
// back by its capture ordinal (LUpval). An unfilled slot (authored `??`,
// or a hole-adjacent short tail) becomes a param of the synthesized fn
// (LLocal), typed by the hole's own handle (infer bound each hole to its
// declaration-order param type; a tail slot carries the partial node's
// handle — its width residue joins the callsite-result-width family).
fn partial_split(r_args, n_args, n_ps, handle, i, ci) =
  if i >= n_ps { ([], [], []) }
  else if i >= n_args {
    let pn = "__part_{int_to_str(i)}"
    let (caps, names, bargs) = partial_split(r_args, n_args, n_ps, handle, i + 1, ci)
    (caps, [pn] ++ names, [LLocal(handle, pn)] ++ bargs)
  } else {
    let arg = list_index(r_args, i)
    let N(b, _, ah) = arg
    match b {
      NHole(_) => {
        let pn = "__part_{int_to_str(i)}"
        let (caps, names, bargs) = partial_split(r_args, n_args, n_ps, handle, i + 1, ci)
        (caps, [pn] ++ names, [LLocal(ah, pn)] ++ bargs)
      },
      _ => {
        let e = lower_expr(arg)
        let (caps, names, bargs) = partial_split(r_args, n_args, n_ps, handle, i + 1, ci + 1)
        ([e] ++ caps, names, [LUpval(lexpr_handle(e), ci)] ++ bargs)
      }
    }
  }

// The callee shapes a partial can synthesize a body for: a top-level fn
// (direct LCall) and ADT construction (LMakeVariant) — for both, infer's
// dispatch provably took the partial fork too (their schemes pre-register
// as fn types), so type and lowering agree by construction. A local /
// closure callee (its value captured at slot 0 + the W7 call), the
// intrinsic projections (to_string / hash / float_of_int / substrate ops),
// and effect ops are the named remainder — Hβ.lower.partial-local-callee —
// floored typed, never called wrong.
fn partial_callee_form(handle, fbody, fh) = match fbody {
  NExpr(VarRef(name)) =>
    // The name-keyed intrinsic projections (the show/hash fold leaves, the
    // gradient's converts) and the substrate/wasi instruction ops have no
    // global fn to LCall — a partial over one floors typed with the rest of
    // the unbuilt shapes, never a call past the projection.
    if is_substrate_mem_op(name) || is_wasi_import_op(name) ||
        name == "to_string" || name == "hash" ||
        name == "float_of_int" || name == "float_to_int" { None }
    else { match env_kind_of(name) {
      Some(FnScheme)                     => Some((bargs) => LCall(handle, LGlobal(fh, name), bargs)),
      Some(ConstructorScheme(tag_id, _)) => Some((bargs) => LMakeVariant(handle, tag_id, bargs)),
      _                                  => None
    } },
  _ => None
}

// PARTIAL APPLICATION AS A VALUE — the mint. The record is LambdaExpr's
// exactly (fn_ptr@0, nc@4, captures@8; emit's deep walk lifts the LFn, the
// caller dispatches through the same W7 closure-call convention), built by
// the k1 lower-time LFn-synthesis precedent. The closure's evidence region
// is derive_ev_slots(handle) — the partial node's own TFun row; a nonempty
// region means the callee's performs would read evidence this mint does not
// yet capture into the synthesized frame, so it floors typed
// (Hβ.lower.partial-effectful-callee) instead of ever calling wrong.
fn lower_call_partial(handle, fbody, fh, r_args, n_ps) =
  match partial_callee_form(handle, fbody, fh) {
    None => LInvariantFailure(handle, PartialCalleeShape(fh)),
    Some(form) => {
      let evs = derive_ev_slots(handle)
      if len(evs) != 0 { LInvariantFailure(handle, PartialEffectfulCallee(fh)) }
      else {
        let flat_args = list_to_flat(r_args)
        let (captures, param_names, body_args) =
          partial_split(flat_args, len(flat_args), n_ps, handle, 0, 0)
        let fn_ir = LFn(
          "partial_{int_to_str(handle)}",
          len(param_names),
          param_names,
          [form(body_args)],
          mk_ef_pure(),
          len(captures))
        LMakeClosure(handle, fn_ir, captures, evs)
      }
    }
  }

// Is this callee a resume-bound fn called from a MultiShot context? Both
// reads are live (the bindings registered at lower_program; the discipline
// from the ambient arm context — which a bound fn's own wrap installs, so
// deep chains forward the entry hop by hop).
fn resume_bind_target(callee_handle) = {
  let name = callee_name_of_handle(callee_handle)
  if name == "" { false }
  else {
    if ls_resume_bind_of(name) == "" { false }
    else {
      match current_resume_discipline() {   // drift-audit: ignore — sequenced effectful arm-context read
        MultiShot => true,
        _         => false
      }
    }
  }
}

// THE DISPATCHED-ROW PROJECTION (master plan §6 1★). The single read of a fn's
// dispatched effect-row names — canonical order, builtins filtered. `derive_ev_slots`
// (caller, building a callee's __state) and the keyed captured_evs read (callee)
// both project through THIS ONE truth; evidence is then addressed by effect
// IDENTITY (a key-scan over [key][record][base]), so the two sides agree BY THE
// KEY, never a positional slot. The live form reads the flow-closure (escaping_row
// — walk the body/call-edges, subtract installs), recovering forward-ref-dropped
// effects the frozen TFun row lost (docs/specs/simulations/polymorphism-as-flow-edges.md §8).
fn effects_of(fn_ty) = match fn_ty {
  TFun(_, _, row) => effects_of_row(row),
  TCont(_, _, _, world) => effects_of_row(world),
  _               => []
}

fn effects_of_row(row) = {
  // The dispatched names of the WHOLE row: the present field inline,
  // the tail chased and folded (a var carries the rest of the row —
  // discarding it read [] and starved the escaping rows, the pinned
  // seam). The absent field masks tail contributions.
  let EfRow(names, ab, t) = row
  let inline = row_dispatched_names(eff_names_of(names))
  match t {
    EtVar(v) => {
      let GNode(kind, _) = graph_chase(v)
      match kind {
        NRowBound(inner) =>
          set_canonicalize(names_concat(inline,
            names_diff_strs(effects_of_row(inner), eff_names_of(ab)))),
        _ => inline
      }
    },
    _ => inline
  }
}

fn names_diff_strs(ref xs, ref mask) = filter((n) => !string_in_list(mask, n), xs)


// The per-effect evidence the caller threads into a polymorphic callee's
// __state record. ONE ev per effect in the callee's row — the ev is a RECORD
// POINTER (handler IS state IS closure IS evidence), NOT a fn-index global
// (drift 5), PAIRED with the effect's IDENTITY (the key). Each effect resolves
// to the lexically-installed handler's state record (`LLocal "__hstate_<h>"`)
// or a forward of THIS frame's own evidence by IDENTITY (`LEvRef` carries the
// key, never a row position). The callee reads each back by KEY-SCAN, so the
// row is consumed as a SET — order carries no meaning; a sibling effect shuffles
// nothing (the cure for position-as-the-bug). The row is read from THE GRAPH
// at the call site: lookup_ty(callee_handle) is the callee expression's
// instantiated TFun, whose row the EtVar chase reads through bound vars —
// per-call-site precision (an effect-polymorphic callee's row var is bound to
// THIS call's concrete row by the time lower runs; inference is complete).
// Named fn or lambda, ONE read; the name-keyed esc-map query this replaces
// was a side-ledger re-derivation of the same live fact (Anchor 1).
fn derive_ev_slots(callee_handle) = {
  map((ename) => {
    let ev = resolve_ev_for_ename(ename)
    // The arm's ev-region must carry every effect the arm THREADS to a callee,
    // not only the ones it performs directly (the arm_ev_note at the perform
    // tier). When the effect resolves to an LEvRef — a keyed lookup INTO the
    // arm's captured_evs, because no handler is lexically in scope here — the
    // install must have written that entry, so note it. (A lexical LLocal is
    // threaded from its own install, never the arm's region.) Without this, an
    // arm that only CALLS a stateful-effect function — `verify_pending_at`,
    // whose row carries Verify — through a `<|` fanout branch left its
    // captured_evs missing that key, so the callee got a garbage record
    // (the felt-read ev-seam: target=Verify, record=32, scan → OOB).
    note_threaded_ev(ename, ev)
    LEvEntry(ename, ev)
  }, evidence_effects_of(callee_handle))
}

fn note_threaded_ev(ename, ev) = match ev {
  LEvRef(_, _) => arm_ev_note(ename),
  _            => 0
}

// The effects a caller threads evidence for: the per-call-site instantiated row
// (`effects_of(lookup_ty)` — concrete, a higher-order arg's effect is bound
// here) UNIONED with the callee's FLOW-CLOSURE (`escaping_row` — recovering the
// forward-ref effects the frozen leaf drops: a callee bound AFTER its caller
// generalized never entered the row, so the leaf reads [] and the callee's
// strict `ev_perform_entry` key-scan meets an empty region → the ev-seam). Both
// are needed — the leaf alone drops the forward-ref first-order case
// (mint_param_placeholders, the m3 pre_register trap); the flow-closure alone
// drops a higher-order arg whose effect is per-call-site. Keyed identity
// (a key-scan, not a positional slot) makes over-placement forward-tolerant, so
// the union never harms. This COMPLETES escaping_row's own seam (its doc names
// derive_ev_slots as the consumer that was never wired). The deeper ultimate
// form (order-free live inference) makes the leaf equal the flow-closure and
// dissolves the union — peer Hβ.infer.order-free-live-row.
fn evidence_effects_of(callee_handle) = {
  let name = callee_name_of_handle(callee_handle)
  let flow = if len(name) == 0 { lambda_escaping_row(callee_handle) } else { escaping_row(name) }
  set_canonicalize(names_concat(effects_of(lookup_ty(callee_handle)), flow))
}

// ─── band B M1.3 — the A1 prove-absence gate (the bank Ruling 5) ─────────
// can_yield(fh): may a yield unwind THROUGH a call to this callee? The k2
// boundary check is inserted UNLESS the callee's row PROVES absence of every
// MultiShot-graded effect — the project's own stance applied to the gate:
// prove the negative, never assume it. The call-side twin of
// multishot_ops_of (the install-side decider); keep them in view together.
//
// The proof ladder, cheapest first:
//   1. The program declares NO MultiShot-graded op anywhere ⇒ nothing can
//      ever yield ⇒ absence proven globally (ls_program_may_yield, computed
//      once at lower_program). Pre-cut this is the wheel's whole story —
//      zero wraps, bytes identical (Law 7).
//   2. Any MultiShot-graded effect in the callee's KNOWN names (the leaf row
//      ∪ the flow-closure — the same union derive_ev_slots threads, so a
//      MultiShot effect fully handled INSIDE the callee has already
//      subtracted out and the gate goes quiet) ⇒ check.
//   3. The leaf row's TAIL: a closed row (or an open one whose chase grounds
//      to closed) with no MultiShot name PROVES absence ⇒ skip; a free tail,
//      a negation/intersection form (¬X admits everything but X), or a
//      non-TFun callee type is UNPROVEN ⇒ check — the one-global.get cost is
//      the price of the A1 hole (a free row var at the callee's one lowering
//      hid try_fn's yield from every name read).
fn can_yield(callee_handle) = {
  if !ls_program_may_yield() { false }
  else {
    let name = callee_name_of_handle(callee_handle)
    let flow = if len(name) == 0 { lambda_escaping_row(callee_handle) } else { escaping_row(name) }
    if names_have_multishot(flow) { true }
    else {
      match lookup_ty(callee_handle) {
        TFun(_, _, row) => row_may_multishot(row),
        _               => true
      }
    }
  }
}



// A row MAY carry a MultiShot-graded effect: its known names say so, or its
// tail is unproven. Total over the six row forms — the unproven forms answer
// true (check), never a fabricated "safe".
fn row_may_multishot(row) = {
  let EfRow(names, _, t) = row
  if names_have_multishot(eff_names_of(names)) { true }
  else {
    match t {
      EtClosed => false,
      EtAll    => true,
      EtVar(v) => {
        let GNode(kind, _) = graph_chase(v)
        match kind {
          NRowBound(inner) => row_may_multishot(inner),
          _                => true
        }
      }
    }
  }
}

fn names_have_multishot(enames) = any(effect_has_multishot_op, enames)

// The effect→ops edge lives in the env (EffectDeclKind, register_effect_ops);
// each op's resume grade lives on its EffectOpScheme (inference joined the
// handler arms' Usage grades). Two live reads — no side registry.
fn effect_has_multishot_op(ename) = match env_lookup(ename) {
  Some(entry) => {
    let (_, _, kind) = entry
    match kind {
      EffectDeclKind(op_names) =>
        any((op) => match op_resume_discipline(op) {
          MultiShot => true,
          Abandon   => true,   // M4 — an abandon op yields, so its row can_yield: the caller treats the call as a k2 boundary and propagates the flag (risky → Some(risky) → the install)
          _         => false
        }, op_names),
      _ => false
    }
  },
  None => false
}

fn resume_bind_assoc(binds, name: String, i) = {
  if i >= len(binds) { "" }
  else {
    let (n, h) = list_index(binds, i)
    if n == name { h } else { resume_bind_assoc(binds, name, i + 1) }
  }
}

// THE CUT (bank Ruling 6 + A3) — the resume-capability bindings: from each
// handler arm whose op grades MultiShot, the transitive closure of called
// resume-bearing fns (summary ≥ UOne — the classifier's fixpoint, re-run
// here over the same stmts; collect_free_vars over-approximates the call
// edge, which only ever binds a dormant wrap). Each bound fn lowers under
// its handler's arm context (disc MultiShot, the redrive's hname, the
// state fields read live from the decl) and every call to it from a
// MultiShot context threads the "__resume" k evidence. A fn reached from
// arms of TWO handlers is E_ResumeAmbiguousOp — narrow the call graph;
// the first binding stands (productive-under-error).
fn resume_bindings(stmts) = {
  let summaries = classify_fixpoint(stmts)
  let decls = collect_fn_decls_list(stmts, [])
  bind_from_handlers(stmts, summaries, decls, [])
}

fn bind_from_handlers(stmts, summaries, decls, binds) = {
  if len(stmts) == 0 { binds }
  else {
    let N(b, _, _) = last(stmts)
    let binds2 = match b {
      NStmt(HandlerDeclStmt(hname, _, _, _, arms)) =>
        bind_from_arms(arms, hname, summaries, decls, binds),
      _ => binds
    }
    bind_from_handlers(drop_last(stmts), summaries, decls, binds2)
  }
}

fn bind_from_arms(arms, hname, summaries, decls, binds) = {
  if len(arms) == 0 { binds }
  else {
    let arm = last(arms)
    let binds2 = match op_resume_discipline(handler_arm_op_name(arm)) {
      MultiShot => bind_closure(collect_free_vars(handler_arm_body(arm), []),
                                hname, summaries, decls, binds),
      _         => binds
    }
    bind_from_arms(drop_last(arms), hname, summaries, decls, binds2)
  }
}

// Worklist closure: bind each marked free name, then its body's marked
// frees, until no new name binds.
fn bind_closure(names, hname, summaries, decls, binds) = {
  if len(names) == 0 { binds }
  else {
    let n = last(names)
    let rest = drop_last(names)
    if usage_is_marked(usage_summary_lookup(summaries, n, 0)) {
      let bound = resume_bind_assoc(binds, n, 0)
      if bound == "" {
        let deeper = collect_free_vars_of_decl(decls, n)
        bind_closure(free_vars_merge(rest, deeper), hname, summaries, decls,
                     [(n, hname)] ++ binds)   // drift-audit: ignore — decl-count-bounded cons, not a hot loop
      } else {
        if bound == hname { bind_closure(rest, hname, summaries, decls, binds) }
        else {
          report(EResumeAmbiguousOp(n, span_zero()))
          bind_closure(rest, hname, summaries, decls, binds)
        }
      }
    } else { bind_closure(rest, hname, summaries, decls, binds) }
  }
}

fn usage_is_marked(u) = match u {
  UZero => false,
  UOne  => true,
  UMany => true
}

fn collect_free_vars_of_decl(decls, name: String) = {
  let hits = filter((nb) => {
    let (n, _) = nb
    n == name
  }, decls)
  if len(hits) == 0 { [] }
  else {
    let (_, body) = head(hits)
    collect_free_vars(body, [])
  }
}

// The global short-circuit's one writer: walk the program's effect decls and
// ask each for a MultiShot-graded op. Runs once at lower_program, before any
// body lowers.
fn program_may_yield(stmts) =
  any((node) => {
    let N(body, _, _) = node
    match body {
      NStmt(EffectDeclStmt(ename, _)) => effect_has_multishot_op(ename),
      _                               => false
    }
  }, stmts)

// One ev per effect: the installed handler's record (LLocal) when a handler is
// lexically in scope on the live `~>` stack, else a forward of THIS frame's own
// evidence for the effect — by IDENTITY (LEvRef carries the key), never a row
// position. The caller fills the same key; the chain bottoms at the `~>` install
// where the handler resolves lexically. Both derive_ev_slots and an install's
// captured_evs read through this one projection.
fn resolve_ev_for_ename(ename) = {
  let state_local = lower_resolve_handler_state_for_ename(ename)
  if state_local == "" {
    LEvRef(0, ename)
  } else {
    LLocal(0, state_local)
  }
}

// Effect-row names as bare strings, in the row's (already-canonical) order.
// EPure is the union identity and never enters a row name-set (consumed to
// the pure row at build_declared_row), so its arm is the unreachable-but-total case:
// the empty name (it contributes no evidence slot — it is never present here).
// The old `name == 0` null guard is gone WITH its class: the name-set ops
// whose slack slots once leaked nulls (the dissolved sorted insert) are
// buffer-counter builds now, slicing to their exact count — no null element
// survives to this projection (the battery + self-compile arbitrated the
// guard's removal).
fn eff_names_of(names) = flatten(map((name) =>
  match name {
    ENamed(s)            => [s],
    EParameterized(s, _) => [s],
    EPure                => []
  }, names))

// Builtin effects have no handler record — the raw substrate IS their
// handler (wasm instruction / WASI import). Drop them from the evidence
// layout so user effects keep their correct indices. The builtin set is
// carried as DATA (one membership projection), not an inline `== "X"`
// chain. The ultimate form carries builtin-ness STRUCTURALLY as an
// EffectDeclKind variant (BuiltinEffect vs UserEffect) read from the
// graph; that touches the effect-declaration substrate in both layers
// (peer Hβ.row.builtin-effect-kind) and changes no evidence bytes —
// the membership result is identical, so it composes after L1.
fn row_dispatched_names(names) =
  filter((n) => !is_builtin_effect(n), names)

fn is_builtin_effect(ename) =
  index_of_name(["Memory", "Alloc", "WASI"], ename, 0) >= 0   // drift-audit: ignore — byte-parity requires the SAME name set the seed filters (row_dispatched_names data segs 6496/6512/6528); a structural BuiltinEffect EffectDeclKind variant must change both layers together (peer Hβ.row.builtin-effect-kind, post-L1) or the evidence layout diverges from m2's.

// op_name → its declaring effect's name via EffectOpScheme ("" if not an
// effect op in scope — productive-under-error). The graph carries the
// op→effect edge; read it, never a side registry.
fn lower_effect_name_of_op(op_name) = match lookup_parent_effect(op_name) {
  Some(en) => en,
  None     => ""
}

// op's index WITHIN its own effect (op-decl order). The per-effect arm
// region is laid out in this order, so op_slot indexes it directly.
fn lower_compute_ev_slot_for_op(op_name) = match lookup_parent_effect(op_name) {
  Some(ename) => clamp_index(index_of_name(lookup_effect_op_names(ename), op_name, 0)),
  None        => 0
}

// The positional ev-INDEX apparatus is DELETED — evidence is now read by
// effect IDENTITY (a key-scan over the self-describing captured_evs region),
// so there is no row index to compute, dispatch on, or keep place==read stable
// (the cure for position-as-the-bug: a sibling effect shuffles no key). What
// remains is the op-DECL index (op_slot), a STABLE position into an effect's
// immutable op-list — never a row position. `clamp_index` is its defensive
// floor: an op absent from its own effect's op-list is structurally impossible
// (the op→effect edge proves membership), so -1 never arises here.
// A -1 here means an op missing from its own effect's registered list —
// with index_of_name's String proof landed the live cause (pointer-eq on
// the op name: every multi-op effect's ops all clamped to slot 0, result
// overwriting yield in the install record) is gone; the clamp's floor is
// named residue until the diagnostic path reaches this site.
fn clamp_index(i) = if i < 0 { 0 } else { i }

// ─── THE FLOW-CLOSURE (master plan §6 1★ Stage 1) ───────────────────────
// escaping_row(name): the dispatched effects that ESCAPE fn `name` — the
// ones a caller must thread evidence for. The forward-ref class (a mutually-
// recursive callee bound AFTER `name` generalized, so its effect never
// entered `name`'s row — `emit_module` losing `WasmOut` via `emit_header`)
// is recovered by reading the effect off the CALL-EDGES live, not off the
// frozen generalized scheme. derive_ev_slots (caller) reads THIS projection to
// place keyed [key][ev] entries; the callee reads them back by KEY-SCAN, so the
// two sides agree BY THE EFFECT KEY, never a positional slot
// (docs/specs/simulations/polymorphism-as-flow-edges.md §8).
//
//   escaping(name) = ( own_dispatched(name)
//                      ∪ ⋃ { escaping(c) | c ∈ static_callees(name) } )
//                    − handled_locally(name)
//
// `own_dispatched` is the leaf (today's `effects_of` of the generalized
// scheme — RETAINED, never deleted). `handled_locally` subtracts every
// effect a `~> h` install in the body absorbs (so `WasmOut` does NOT escape
// `compile_stdin`, which installs `~> wat_stdout`). Monotone union over the
// finite dispatched-effect lattice ⇒ the fixpoint converges (mutual
// recursion included); precomputed ONCE per program at lower_program (the
// cached cursor / IC), then read by name.

// own_dispatched leaf: the fn's generalized-scheme dispatched row. The SAME
// read the old seam used — never deleted; it is the flow-closure's base case.
fn own_dispatched_row(name: String) = match env_lookup(name) {
  Some(entry) => {
    let (scheme, _, _) = entry
    let Forall(_, ty) = scheme
    effects_of(ty)
  },
  None => []
}

fn set_difference(a, b) = filter((x) => !set_contains(b, x), a)

// The flow-closure read at a use site: the precomputed escaping row by name
// (Some for a top-level fn), else the leaf (nested fn / lambda / unknown —
// identical to the pre-flow-closure behaviour, so closures stay byte-stable).
// The whole escaping family speaks canonical NAME-SETS ([EffName] — the form
// escaping_fixpoint computes over and ev derivation consumes); the old
// `-> Option(EffRow)` op declaration was the family's one row-speaker, and
// its instantiation at this match was the List-vs-EffRow census error.
fn escaping_row(name) = match ls_escaping_of(name) {
  Some(names) => names,
  None        => own_dispatched_row(name)
}

// An anonymous lambda has no name in the esc map, so its closure-evidence row
// would be read off the LEAF (`effects_of(lookup_ty(h))` — the frozen
// generalized own-row), which suffers EXACTLY the forward-ref drop escaping_row
// exists to fix. The named-fn seam already reads the flow-closure; the lambda
// seam must too, or its PLACE/READ are internally consistent but TOO SMALL —
// the body forwards a callee's full escaping row while only the leaf's slots
// were placed, reading __state past the fence into uninitialized bump-heap.
// So route the lambda's own-row through its body's flow-closure, read LIVE off
// the already-precomputed top-level escaping map in ONE union round (a lambda
// is anonymous ⇒ cannot sit in a name-cycle ⇒ no new fixpoint, no snapshot).
// Carried-Truth: delete the frozen-leaf re-derivation in favour of the
// flow-closure the graph already proves. The `_` arm is NOT a degraded path —
// it is the flow-closure's BASE CASE: a non-lambda-seam handle has no
// body-callees to propagate, so its escaping row IS its own row. (The deeper
// ultimate form dissolves this fn entirely: with order-free live inference the
// own-row leaf would already equal the flow-closure — escaping_row exists only
// to recover what generalize() snapshots away; peer Hβ.infer.order-free-live-row.)
fn lambda_escaping_row(h) = match graph_node_body(h) {
  NExpr(LambdaExpr(_, body_node)) => {
    let (callees, handled) = flow_edges(body_node)
    let own_effs   = effects_of(lookup_ty(h))
    let propagated = flatten(map(escaping_row, set_canonicalize(callees)))
    set_difference(set_canonicalize(own_effs ++ propagated), set_canonicalize(handled))
  },
  _ => effects_of(lookup_ty(h))
}

// callee name for derive_ev_slots' handle: the AST fabric resolves any
// handle to its node body live; a VarRef/CallExpr callee yields its name, an
// anonymous lambda/resume body yields "" (→ the lookup_ty own-evidence path).
fn callee_name_of_handle(h) = lower_callee_name(graph_node_body(h))

// Static call + install edges of a fn body, walked once: (callee_names,
// installed_handled_enames). A `~> h` records the effect h's HandlerKind
// absorbs; every other node just unions its children's edges.
fn flow_edges(node) = {
  let N(body, _, _) = node
  match body {
    NExpr(e) => flow_edges_expr(e),
    NStmt(s) => flow_edges_stmt(s),
    NPat(_)  => ([], []),
    NHole(_) => ([], []),
    NModule(_)  => ([], []),  // a module handle carries no call/install edges of its own — decls are separate handles, walked individually
    NTypeAnn(_) => ([], [])   // a type annotation is not executable — no callees, no installs
  }
}

// The escaping-path's name-list concat, its element type PINNED (an
// Intent Boundary, SYNTAX §"The Intent Boundary Rule"): the operands
// arrive through tuple destructures whose bare type vars carry no
// sequence constructor, so an unpinned `++` cannot prove its
// representation to the emit dispatch — the silent string-path
// miscompile (count-valid, tag-garbage lists). The pin IS the proof;
// the proof becomes the dispatch. Dissolves with the one-sequence
// ontology (PLAN §4①, roadmap band D).
fn names_concat(xs: [String], ys: [String]) -> [String] = xs ++ ys

// LowerScope frame fields are projected out of an untyped record value at the
// handler boundary. Pin the element proof before appending, so `++` emits the
// list representation instead of the unresolved concat floor.
fn handle_list_append(xs: [Int], x: Int) -> [Int] = xs ++ [x]   // drift-audit: ignore — real drift 11, pre-existing at the frame appends; buffer-counter needs the frame-record restructure (local_handles + local_order paired by slot), tracked for 11.C.2; this fn adds only the element proof

fn name_list_append(xs: [String], x: String) -> [String] = xs ++ [x]   // drift-audit: ignore — paired with handle_list_append; same 11.C.2 frame-record restructure

fn flow_join(a, b) = {
  let (ca, ha) = a
  let (cb, hb) = b
  (names_concat(ca, cb), names_concat(ha, hb))
}

fn flow_edges_list(nodes) =
  fold(([], []), (acc, n) => flow_join(acc, flow_edges(n)), nodes)

fn flow_edges_expr(e) = match e {
  LitInt(_)    => ([], []),
  LitFloat(_)  => ([], []),
  LitString(_) => ([], []),
  LitBool(_)   => ([], []),
  LitUnit      => ([], []),
  // VarRef contributes its name to the availability set — a value-referenced
  // global FnScheme makes the enclosing fn's escaping row gain the slot the
  // committed LFnRef forwards, so derive_ev_slots resolves to REAL evidence
  // content (the §7-thread availability half, peer
  // Hβ.lower.value-fn-availability-edge, now LIVE). Names that resolve to a
  // local or a non-effecting global add nothing (the env lookup is empty), so
  // the set stays bounded by distinct effect-forwarding fns. The transitive-
  // fixpoint inflation that once overflowed the seed's arm-ev capture is rooted:
  // lower_arm_ev_index_for reads its own logical counter, not the
  // capacity-as-length list header (the Carried-Truth substrate fix).
  VarRef(name) => ([name], []),
  BinOpExpr(_, l, r) => flow_join(flow_edges(l), flow_edges(r)),
  UnaryOpExpr(_, inner) => flow_edges(inner),
  CallExpr(f, args) => {
    let N(fbody, _, _) = f
    let nm = lower_callee_name(fbody)
    let here = if nm == "" { ([], []) } else { ([nm], []) }
    flow_join(here, flow_join(flow_edges(f), flow_edges_list(args)))
  },
  IfExpr(c, t, el) =>
    flow_join(flow_edges(c), flow_join(flow_edges(t), flow_edges(el))),
  BlockExpr(stmts, final_e) =>
    flow_join(flow_edges_list(stmts), flow_edges(final_e)),
  MatchExpr(scrut, arms) =>
    flow_join(flow_edges(scrut), flow_edges_match_arms(arms)),
  MakeListExpr(elems)  => flow_edges_list(elems),
  MakeTupleExpr(elems) => flow_edges_list(elems),
  MakeStringExpr(frags) => flow_edges_list(frags),
  IndexExpr(r, i) => flow_join(flow_edges(r), flow_edges(i)),
  MakeRecordExpr(flds) => flow_edges_fields(flds),
  RecordUpdateExpr(base, flds) =>
    flow_join(flow_edges(base), flow_edges_fields(flds)),
  NamedRecordExpr(_, flds) => flow_edges_fields(flds),
  LambdaExpr(_, b) => flow_edges(b),
  ResumeExpr(v, su) => flow_join(flow_edges(v), flow_edges_state_updates(su)),
  FieldExpr(rec, _) => flow_edges(rec),
  PipeExpr(kind, l, r) => {
    let inner = flow_join(flow_edges(l), flow_edges(r))
    match kind {
      PTee => {
        let N(rbody, _, _) = r
        let hd = installed_handled_ename(rbody)
        if hd == "" { inner } else {
          let (cs, hs) = inner
          (cs, names_concat(hs, [hd]))   // drift-audit: ignore — one append per ~> node (visited once), not a loop accumulator; set_canonicalize dedupes at collect_fn_bases
        }
      },
      _ => inner
    }
  },
  ExprPlaceholder  => ([], []),
  LabeledArg(_, v) => flow_edges(v)
}

fn flow_edges_stmt(s) = match s {
  LetStmt(_, expr, _)            => flow_edges(expr),
  FnStmt(_, _, _, _, body_node)  => flow_edges(body_node),
  ExprStmt(expr)                 => flow_edges(expr),
  TypeDefStmt(_, _)              => ([], []),
  EffectDeclStmt(_, _)           => ([], []),
  HandlerDeclStmt(_, _, _, _, _) => ([], []),
  ImportStmt(_)                  => ([], []),
  RefineStmt(_, _, _)            => ([], []),
  AliasStmt(_, _)                => ([], [])
}

fn flow_edges_match_arms(arms) =
  fold(([], []), (acc, arm) => {
    let (_, body) = arm
    flow_join(acc, flow_edges(body))
  }, arms)

fn flow_edges_fields(flds) =
  fold(([], []), (acc, fld) => {
    let (_, value) = fld
    flow_join(acc, flow_edges(value))
  }, flds)

fn flow_edges_state_updates(updates) =
  fold(([], []), (acc, upd) => flow_join(acc, flow_edges(state_field_init(upd))), updates)

// The effect a `~> h` install absorbs: h's HandlerKind handled_ename. "" when
// the RHS is not a named handler decl (a value-forwarded handler — the row
// passes through, nothing subtracted).
fn installed_handled_ename(handler_body) = {
  let hname = lower_callee_name(handler_body)
  if hname == "" { "" } else {
    match env_lookup(hname) {
      Some(entry) => {
        let (_, _, kind) = entry
        match kind {
          // The absorbed effect is a live projection of the arms (§2), not a field.
          HandlerKind(_, _, _, arms) => derive_handler_ename(arms, hname),
          _                          => ""  // drift-audit: ignore — "" = RHS is not a named handler decl (nothing absorbed)
        }
      },
      None => ""
    }
  }
}

// One base per top-level fn: (name, own-leaf, sorted callees, sorted handled).
fn collect_fn_bases(stmts) =
  flatten(map((stmt) => {
    let N(sb, _, _) = stmt
    match sb {
      NStmt(FnStmt(name, _, _, _, body_node)) => {
        let (callees, handled) = flow_edges(body_node)
        [(name, own_dispatched_row(name),
          set_canonicalize(callees), set_canonicalize(handled))]
      },
      _ => []
    }
  }, stmts))

// The flow-closure map (name → escaping row) is the shared smap indexed-map
// (lib/runtime/imap.mn): esc_rows = smap_build(map) at ls_register_escaping,
// smap_get(esc_rows, name) per call site. None = "not a top-level fn" (→ the
// leaf); Some [] = "a fn with empty flow-closure". The old esc_index_* family
// (a linear-scan read-side that was 72% of the post-esc-setup self-compile,
// perf 2026-07-14) was esc_index generalized — dissolved into smap.

// The name→index edge, drawn ONCE (Carried-Truth): each base's callee names
// resolve to base POSITIONS at collect time, so the fixpoint rounds read
// rows by list_index — no name scan, no allocation in the hot loop. The old
// per-round assoc_row scan allocated ~2GB PER ROUND on the full wheel
// (2,500 fns × ~20 callees × a 2,500-step drop_last scan minting a slice
// per step) and wrapped the bump pointer past 2^32 — face 7's root. A
// callee with no base (a prelude intrinsic, an effect op) contributed the
// empty row on every lookup of every round; now it is dropped once, here.
// The name→index edge, drawn ONCE and O(1) (Carried-Truth): build a str_hash
// index (name → base position) once, then resolve every callee in O(1). The old
// base_index_find was an O(N) linear scan per callee, and indexed_bases maps it
// over every base → O(N² × callees) — 85% of the post-region self-compile (perf,
// 2026-07-14; the esc_assoc O(n²) §5.O named). Reverse-inserted so a name's FIRST
// base position (lowest index) is returned, byte-identical to the old scan.
// The callee-name → base-position index: the shared smap (lib/runtime/imap.mn).
// Keeps its own build (the position IS the list index i, extracted from each
// base's 4-tuple — not a field), calling smap_new/smap_add; the primitive is
// smap. base names are unique, so first-match is byte-identical.
fn build_base_index(bases) with Memory + Alloc =
  build_base_index_from(bases, len(bases) - 1, smap_new())

fn build_base_index_from(bases, i, idx) with Memory + Alloc = {
  if i < 0 { idx }
  else {
    let (name, _, _, _) = list_index(bases, i)
    build_base_index_from(bases, i - 1, smap_add(idx, name, i))
  }
}

fn resolve_callee_indices(idx, callees) =
  flatten(map((c) => match smap_get(idx, c) {
    Some(i) => [i],
    None    => []
  }, callees))

fn indexed_bases(bases) = {
  let idx = build_base_index(bases)
  map((b) => {
    let (name, own_effs, callees, handled) = b
    (name, own_effs, resolve_callee_indices(idx, callees), handled)
  }, bases)
}

// One monotone round over rows-only (base order): row = (own ∪ ⋃ callee rows) − handled.
fn escaping_round(ibases, cur) =
  map((b) => {
    let (_, own_effs, callee_idxs, handled) = b
    let propagated = flatten(map((ci) => list_index(cur, ci), callee_idxs))
    set_difference(set_canonicalize(names_concat(own_effs, propagated)), handled)
  }, ibases)

fn rows_equal(a, b) =
  len(a) == len(b) && fold2_equal(a, b, 0)

fn fold2_equal(a, b, i) =
  if i >= len(a) { true }
  else if list_index(a, i) == list_index(b, i) { fold2_equal(a, b, i + 1) }
  else { false }

fn esc_rows_lists_equal(cur, next, i) =
  if i >= len(cur) { true }
  else if rows_equal(list_index(cur, i), list_index(next, i)) { esc_rows_lists_equal(cur, next, i + 1) }
  else { false }

// Fixpoint over the finite dispatched-effect lattice. Early-stops on a
// stable round; the cap is the safety bound (effect chains are shallow).
fn escaping_fixpoint(ibases, cur, iters) =
  if iters >= 32 { cur }
  else {
    let next = escaping_round(ibases, cur)
    if esc_rows_lists_equal(cur, next, 0) { next }
    else { escaping_fixpoint(ibases, next, iters + 1) }
  }

fn compute_escaping_rows(stmts) = {
  let bases = collect_fn_bases(stmts)
  let ibases = indexed_bases(bases)
  let seed = map((b) => {
    let (_, own_effs, _, handled) = b
    set_difference(set_canonicalize(own_effs), handled)
  }, ibases)
  let final_rows = escaping_fixpoint(ibases, seed, 0)
  // The name-keyed view the ls_escaping_of consumer reads — rebuilt ONCE
  // at the end, never per round.
  zip(map((b) => { let (n, _, _, _) = b n }, bases), final_rows)
}

// ─── Lexical handler resolution (lower-phase, install-handle-bearing) ──
// Walk the lower-handler-stack innermost-first; return the discriminated
// arm target "<handler>_<op>" and the install handle of the first stacked
// handler whose effect-groups cover op_name's effect. None when no lexical
// handler handles it — the Tier-2 evidence path. The install handle gives
// emit the `__hstate_<h>` record the arm runs against.
fn lower_resolve_handler_for_op(op_name) = {
  let ename = lower_effect_name_of_op(op_name)
  resolve_in_stack(op_name, ename, lower_handler_stack_now())
}

// Typed projections for the install-stack entry ({handle, name}, pushed
// at the ~> install ledger) and the resolve result ({handle, target},
// minted below) — the boundary pins that keep every generic read proven.
fn stack_entry_name(e: {handle: Int, name: String}) -> String = e.name
fn stack_entry_handle(e: {handle: Int, name: String}) -> Int = e.handle
fn resolve_target(r: {handle: Int, target: String}) -> String = r.target
fn resolve_handle(r: {handle: Int, target: String}) -> Int = r.handle

fn resolve_in_stack(op_name, ename, stack) = {
  if ename == "" || len(stack) == 0 { None }
  else {
    let e = last(stack)
    if field_name_eq(stack_entry_name(e), "") { None }   // the frame fence — enclosing installs live in another WASM frame
    else if handler_covers_effect(stack_entry_name(e), ename) {
      Some({target: "{stack_entry_name(e)}_{op_name}", handle: stack_entry_handle(e)})
    } else {
      resolve_in_stack(op_name, ename, drop_last(stack))
    }
  }
}

// A handler covers an effect iff one of its arm-name groups keys on that
// effect — read from the same registry emit lays the arms by (one truth).
fn handler_covers_effect(hname: String, ename: String) =
  any((g) => group_ename(g) == ename, lookup_handler_arm_names_of(hname))

// The execution strategy a fanout (`<|`/`><`) runs under — read LIVE
// from the installed `~>` chain, NEVER baked into the verb. A verb
// draws an edge; it does not schedule (the deleted Thread-inject was
// the category error). `Schedule` is an ADT of scheduler classes —
// never a `mode==0/1/2` int (drift 8). NO scheduler installed → `Seq`,
// the invisible default: branches evaluate inline, in source order,
// results tupled — deterministic, zero spawn cost. `~> Thread` →
// `Thread`: each branch thunk dispatched to wasi-threads (the relocated
// spawn/join body), spawn-ALL-then-join-ALL in source order so results
// tuple deterministically regardless of completion order. `Simd` packs the
// f32 branch results into v128 lanes (the value layer's RV128 repr meeting the
// verb); `Gpu` projects the same thunks to a device-kernel host import (the one
// legitimate external-transport boundary, "the handler IS the backend");
// `Persist` checkpoints each branch thunk to disk for crash-survivable parallel
// execution (parallelism = durability, §4④). All five read LIVE from the `~>`
// chain — never baked into the verb.
type Schedule
  = Seq
  | Threaded
  | Simd
  | Gpu
  | Persisted

// One projection of infer's ExecutableBoundary edge. Every field keeps its
// graph identity through LowIR: the thunk closure, semantic result, boundary-
// local carrier, and the two scheduler-specific transient tickets.
type ScheduledBoundary
  = ScheduledBoundary(LowExpr, Int, Int, Int, Int)
  | InvalidScheduledBoundary(Int, BoundaryInvariant)

// Read the fanout's execution strategy from the installed `~>` chain —
// the SAME `lower_handler_stack_now()` + `handler_covers_effect`
// machinery every `perform` resolves through (`resolve_in_stack`). The
// innermost handler covering a scheduler-class effect (`Thread`/`Simd`/
// `Gpu`) wins; with none installed the strategy is `Seq` — the net-new
// default the old hardwired `Thread` inject made unsayable (a bare `><`
// was `E_HandlerUninstallable`; now it just runs single-threaded).
// `!Thread` proves the negative: a region with `Thread` subtracted from
// its row provably runs `Seq` (a real-time-DSP guarantee).
fn lower_fanout_schedule() = schedule_in_stack(lower_handler_stack_now())

fn schedule_in_stack(stack) =
  if len(stack) == 0 { Seq }
  else {
    let e = last(stack)
    if field_name_eq(stack_entry_name(e), "") { Seq }   // the frame fence — "the schedule is read at the fanout's own install site, never across a call boundary" (SYNTAX §Vocabulary)
    else if handler_covers_effect(stack_entry_name(e), "Thread") { Threaded }
    else if handler_covers_effect(stack_entry_name(e), "Simd") { Simd }
    else if handler_covers_effect(stack_entry_name(e), "Gpu") { Gpu }
    else if handler_covers_effect(stack_entry_name(e), "Persist") { Persisted }
    else { schedule_in_stack(drop_last(stack)) }
  }

// Same, keyed by effect name (derive_ev_slots / captured_evs path), but
// resolving to the per-effect ENTRY local "__hstate_<h>_<ename>" (the thin
// [record, base] view the ev-slot forwards) — NOT the bare record. Resolve
// through the effect's first op to find the install handle.
fn lower_resolve_handler_state_for_ename(ename) = {
  let ops = lookup_effect_op_names(ename)
  if len(ops) == 0 { "" }
  else {
    match lower_resolve_handler_for_op(last(ops)) {
      Some(r) => "__hstate_{int_to_str(resolve_handle(r))}_{ename}",
      None    => ""
    }
  }
}

// The install-site evidence a handler's arm bodies perform through,
// resolved at THIS install position, PAIRED with each effect's IDENTITY (the
// key). Emit writes these after the record's arm region as the self-describing
// [key][record][base] captured_evs region; the arm fn's LEvPerform KEY-SCANS
// it for the effect-key. Symmetric with derive_ev_slots — both the install's
// captured_evs and a callee's threaded ev_slots are ONE keyed-entry shape, so
// a sibling effect appearing shuffles no key (the position-as-the-bug cure).
fn lower_captured_evs_for(hname) =
  map((ename) => LEvEntry(ename, resolve_ev_for_ename(ename)),
      lookup_handler_arm_ev_names(hname))

// Per-effect arm-fn-name groups [(ename, [arm_fn_name])], op-decl order
// within each effect. A handler can cover multiple effects (graph_handler:
// GraphWrite + GraphRead); op-slot is op-decl-relative WITHIN an effect, so
// a flat region would collide (each effect's op 0 wants slot 0). Grouping
// by effect (read from the graph via lower_effect_name_of_op) lets emit lay
// each group contiguously and build a thin per-effect [record, base] entry.
fn build_handler_arm_names(hname, arms) = {
  let placements = map((arm) => {
    let op = handler_arm_op_name(arm)
    let ename = lower_effect_name_of_op(op)
    {ename: if ename == "" { op } else { ename },
     slot:  lower_compute_ev_slot_for_op(op),
     name:  "op_{hname}_{op}"}
  }, arms)
  fold([], place_arm_in_groups, placements)
}

// Place one arm at its op-slot in its effect-group's arm_list, find-or-
// create the group. The arm_list is dense [0, max_slot] with the empty-
// string gap sentinel for ops this handler doesn't implement; emit skips
// gaps but counts the length, so the per-effect base advances correctly.
// The group/arm record types are Intent Boundaries: they arrive as the
// fold's generic state, and unresolved record types hit the emit's loud
// field-load floor (the place_arm_in_groups unreachable). The pin is the
// proof — same class as names_concat / ls_find_str_local.
fn place_arm_in_groups(groups: [{arms: [String], ename: String}], arm: {ename: String, name: String, slot: Int}) = {
  let (before, grp, after) = split_group_by_ename(groups, arm.ename)
  let filled = set_at_extend(group_arms(grp), arm.slot, arm.name)
  list_concat(before, [{ename: arm.ename, arms: filled}] ++ after)
}

// The group's arms, read through an annotated projection: `grp` arrives
// off a tuple destructure whose element type the seed's inference does
// not carry across the return boundary, so a direct `grp.arms` hits the
// emit's loud unresolved-field floor. The call-site unification with the
// declared param IS the pin (the env_find precedent at the record layer).
fn group_arms(grp: {arms: [String], ename: String}) -> [String] = grp.arms
fn group_ename(grp: {arms: [String], ename: String}) -> String = grp.ename

// ename: String pins — the same pointer-eq-lie class as ls_find_str_local.
fn split_group_by_ename(groups: [{arms: [String], ename: String}], ename: String) =
  split_group_loop([], groups, ename)

fn split_group_loop(before: [{arms: [String], ename: String}], rest: [{arms: [String], ename: String}], ename: String) = {
  if len(rest) == 0 {
    (before, {ename: ename, arms: []}, [])
  } else if last(rest).ename == ename {
    (before, last(rest), drop_last(rest))
  } else {
    split_group_loop(list_concat(before, [last(rest)]), drop_last(rest), ename)
  }
}

// Functional set arms[slot] = name. Replace in place when slot is in
// range; else grow with "" gaps and append. Tree-safe (slice + concat,
// not flat list_set) — the arm_list may be a concat-tree.
fn set_at_extend(arms: [String], slot: Int, name: String) = {
  if slot < len(arms) {
    list_concat(slice(arms, 0, slot),
                [name] ++ slice(arms, slot + 1, len(arms)))
  } else {
    list_concat(grow_to_with_gaps(arms, slot), [name])
  }
}

fn grow_to_with_gaps(arms: [String], n: Int) = {
  if len(arms) >= n { arms }
  else { grow_to_with_gaps(list_concat(arms, [""]), n) }
}

// Look up the op names for an effect by reading the graph.
// EffectDeclKind(op_names) carries effect→ops as a first-class
// fact — registered at EffectDeclStmt by register_effect_ops.
fn lookup_effect_op_names(eff_name) = {
  match env_lookup(eff_name) {
    Some(entry) => {
      let (_, _, kind) = entry
      match kind {
        EffectDeclKind(op_names) => op_names,
        // A non-effect entry under this name (a same-named TYPE shadowing the
        // effect — the Cursor/Patch collision class, healed by the
        // Graph/GraphRead naming convention; Sample still pairs by DSP
        // doctrine). Fabricating [eff_name] here turned that shadowing into a
        // wrong op list, a "" ename, and a silent keyed-tier fall-through that
        // detonated as a runtime evidence OOB three layers away. No ops known
        // is the honest answer.
        _ => []
      }
    },
    None => []
  }
}
// Perform dispatch — the single decision point, lexical-install first.
//   - A handler is lexically installed for the op's effect → Tier 1:
//     LPerform-with-state, a direct `$op_<handler>_<op>` call against the
//     install's OWN state record (`__hstate_<h>`), the SAME record the arm
//     was installed against.
//   - Else → Tier 2: LEvPerform, evidence-passing. The caller threads the
//     handler record into __state's captured_evs keyed by the effect's
//     IDENTITY; the read KEY-SCANS for it (no row position to shift). op_slot
//     stays a position — the op's index in its effect's IMMUTABLE decl-order
//     op-list (a stable identity, not a row position).
// M4 — divergence: an expression that ALWAYS yields (unwinds and never
// returns to its own position). An Abandon-op perform is the leaf; an
// if/match whose every branch diverges diverges; a block diverges if a
// statement diverges or its value does. Code after a diverging expression
// in a block is DEAD (the deaden in lower_expr's BlockExpr arm). A call to
// a fn that always aborts is NOT caught here (inter-procedural — the named
// follow-up Hβ.lower.diverging-callee-analysis; rare, and the flag still
// propagates via the caller's k2 boundary, only the local dead code isn't
// pruned).
fn expr_diverges(node) = {
  let N(b, _, _) = node
  match b {
    // Statements wrap their expression — a block's stmts are NStmt(...), so
    // first_diverging must unwrap to reach the perform.
    NStmt(ExprStmt(e))        => expr_diverges(e),
    NStmt(LetStmt(_, init, _)) => expr_diverges(init),
    NExpr(CallExpr(f, _)) => {
      let N(fb, _, _) = f
      match fb {
        NExpr(VarRef(name)) => match op_resume_discipline(name) {
          Abandon => true,
          _       => false
        },
        _ => false
      }
    },
    NExpr(IfExpr(_, t, e))    => expr_diverges(t) && expr_diverges(e),
    NExpr(MatchExpr(_, arms)) => all_arms_diverge(arms, 0),
    NExpr(BlockExpr(stmts, final)) =>
      match first_diverging(stmts, 0) {
        Some(_) => true,
        None    => expr_diverges(final)
      },
    _ => false
  }
}

fn all_arms_diverge(arms, i) =
  if i >= len(arms) { true }
  else {
    let (_, body) = list_index(arms, i)
    if expr_diverges(body) { all_arms_diverge(arms, i + 1) } else { false }
  }

// The index of the first diverging statement, if any — everything past it
// in the block is dead.
fn first_diverging(stmts, i) =
  if i >= len(stmts) { None }
  else if expr_diverges(list_index(stmts, i)) { Some(i) }
  else { first_diverging(stmts, i + 1) }

// Lexical install wins over the keyed forward (a nested handler shadows the
// caller's evidence) — the seed's $lower_perform order, byte-faithful.
fn lower_perform_dispatch(handle, op_name, lo_args) =
  match op_resume_discipline(op_name) {
    // A MultiShot perform NEVER calls the arm — it YIELDS (band B k1). The
    // on-spine sites are consumed by lower_body_reified, which constructs
    // the real k; one reaching the ordinary dispatch is OFF-spine (an
    // if/match/nested-call interior, or args-bearing) — the LOUD floor,
    // k2's composition home. The floor carries the EMPTY op name (the emit
    // floors on op == "", NEVER on the k value — an abandon yield's k is
    // also a bare LConst, so op-name is the discriminator).
    MultiShot => LYield(handle, "", [], LConst(handle, LInt(0))),
    // M4 — an Abandon perform yields from ANY position with a DEAD k (the
    // arm never resumes, so the continuation is abandoned). The k slot is a
    // bare LConst(0) → the emit stores $yield_k = 0 (never read) and takes
    // the real-yield path (op non-empty): set op/args/flag, return the
    // width-honest dummy. The driver runs the arm, the arm returns without
    // calling k, the loop exits flag-clear delivering the arm value as the
    // install's — abandon by construction. The perform's own frame deadens
    // its remainder (lower_expr's BlockExpr arm — an Abandon perform
    // diverges); everything up the stack propagates via the EXISTING k2
    // call-boundary check (never a bare return, which would skip an
    // install's driver bracket — the M1.3 finding).
    Abandon => LYield(handle, op_name, lo_args, LConst(handle, LInt(0))),
    _ => lower_perform_tiers(handle, op_name, lo_args)
  }

fn lower_perform_tiers(handle, op_name, lo_args) =
  match lower_resolve_handler_for_op(op_name) {
    Some(r) =>
      LPerform(handle, resolve_target(r), lo_args, "__hstate_{int_to_str(resolve_handle(r))}"),
    None =>
      // Tier 1-GLOBAL — no lexical install covers the op, but a UNIQUE handler
      // declares it (the op→handler edge drawn at register_handler). Read that
      // singleton's record LIVE from its $<hname>_state_g home and direct-call
      // the arm, never thread a copy of a once-installed record through the
      // ev-region (Carried-Truth). The route-infra handlers (graph/env/…) land
      // here; it dissolves the deep-chain evidence trap at fresh_handle. Only a
      // genuinely unknown or ambiguous handler keeps the evidence floor below.
      match lower_op_default_handler(op_name) {
        Some(hname) => lower_singleton_perform(handle, op_name, hname, lo_args),
        None => {
          let ename = lower_effect_name_of_op(op_name)
          arm_ev_note(ename)
          LEvPerform(handle, op_name, ename, lower_compute_ev_slot_for_op(op_name), lo_args)
        }
      }
  }

// The op's UNIQUE default handler, read from the EffectOpScheme edge drawn at
// register_handler — None when unset (no handler declares it) or ambiguous
// (≥2 do → thread evidence, no static singleton to read).
fn lower_op_default_handler(op_name) =
  match env_lookup(op_name) {
    Some(entry) => {
      let (_, _, kind) = entry
      match kind {
        EffectOpScheme(_, default_handler, ambiguous, _) =>
          // field_name_eq forces str_eq (a bare `== ""` is pointer-eq under the
          // seed — §9 name-compare class); default_handler "" ⇒ unset.
          if ambiguous || field_name_eq(default_handler, "") { None } else { Some(default_handler) },
        _ => None
      }
    },
    None => None
  }

// Read the singleton's record from its $<hname>_state_g home into a per-node
// local, then direct-call $op_<hname>_<op> against it — the SAME record the arm
// was installed with (handler IS state), reached live at its one home instead
// of via a threaded ev-slot. Reuses LPerform's Tier-1 emit with the global read
// standing in for the lexical __hstate local.
fn lower_singleton_perform(handle, op_name, hname, lo_args) = {
  let rec_local = "_{int_to_str(handle)}"
  LBlock(handle, [
    LLet(handle, rec_local, LGlobal(handle, "{hname}_state_g")),
    LPerform(handle, "{hname}_{op_name}", lo_args, rec_local)
  ])
}

// Look up which effect an op belongs to via EffectOpScheme.
fn lookup_parent_effect(op_name) = {
  match env_lookup(op_name) {
    Some(entry) => {
      let (_, _, kind) = entry
      match kind {
        EffectOpScheme(ename, _, _, _) => Some(ename),
        _ => None
      }
    },
    None => None
  }
}

// The op's resume cardinality, PROJECTED off its EffectOpScheme — inference
// wrote it (draw_op_edges joined every handler arm's Usage grade); lower reads
// it live here, the TIME-axis twin of resume_world_of reading the world off the
// arm fn's row. An op with no scheme (should not happen for a real perform)
// floors to OneShot — the direct-return fast path, sound because a genuine
// multi-shot arm always carries a MultiShot scheme by the monotone join.
fn op_resume_discipline(op_name) =
  match env_lookup(op_name) {
    Some(entry) => {
      let (_, _, kind) = entry
      match kind {
        EffectOpScheme(_, _, _, disc) => disc,
        _ => OneShot
      }
    },
    None => OneShot
  }


// Lower walk — exhaustive, live

// lower reads the fabric: before lowering, resolve the node's CANONICAL
// form from the e-graph (egraph_extract = the e-class root, the simplest
// proven-equivalent term). For an un-rewritten node the root is the node
// itself, so this is identity on the common path; for x + 0 the root IS x
// and lower emits x — optimization as a cursor read, not a separate pass.
// The canonical handle carries the type lookups, since a rewrite preserves
// the type (and, for a dropping rewrite, the effect row — the gate proved it).
fn lower_expr(node) = {
  let N(obody, span, handle) = node
  // An AUTHORED hole's identity lives on its own node — the id and the
  // authored span the executable gate and the cursor read (authored_hole).
  // Its union-find class root is often an absent-default mint (NHole(0):
  // the fn-return var a body hole unified with, a let's value var), so
  // canonicalizing first discards the authored truth and the surviving
  // hole slips the gate. The hole keeps its handle; every other body
  // reads canonically as before (same class ⇒ same lookup_ty chase ⇒
  // same repr — byte-identical).
  match obody {
    NHole(_) => LConst(handle, LInt(0)),
    _ => {
      let canon = egraph_extract(handle)
      let body = if canon == handle { obody } else { graph_node_body(canon) }
      match body {
        NExpr(e)     => lower_expr_body(e, canon, span),
        NStmt(s)     => lower_stmt_as_expr(s, canon, span),
        NPat(_)      => LConst(canon, LInt(0)),   // patterns don't lower as expr
        NHole(_)     => LConst(canon, LInt(0)),   // the class root is a hole-default mint; nothing authored to carry
        NModule(_)   => LConst(canon, LInt(0)),   // never an expr position — module entity, not a value
        NTypeAnn(_)  => LConst(canon, LInt(0))    // never an expr position — an authored return annotation, not a value
      }
    }
  }
}

fn lower_expr_body(e, handle, span) = match e {
  LitInt(v)    => LConst(handle, LInt(v)),
  LitFloat(v)  => LConst(handle, LFloat(v)),
  LitString(s) => LConst(handle, LString(s)),
  LitBool(b)   => {
    // HB: True/False are nullary ConstructorScheme entries. Lower
    // routes through LMakeVariant so emit picks the sentinel path
    // (i32.const tag) — no allocation, full ADT semantics.
    let tag = if b { 1 } else { 0 }
    LMakeVariant(handle, tag, [])
  },
  LitUnit      => LConst(handle, LInt(0)),

  VarRef(name) => {
    let (res, local_h) = ls_resolve(name)
    // For LLocal/LUpval the LowExpr's handle should describe the
    // captured value's type (the local's handle from binding time),
    // not the VarRef's own handle. Fall back to VarRef's handle for
    // RGlobal where there's no separate local-binding handle.
    //
    // A GROUND binding (ty_handle_of returns 0 — a ctor's TFloat
    // payload, a tuple's TString element) has no binding-time handle;
    // the USE node's own handle carries the same truth (infer_var_ref
    // bound it to the resolved type, and a local is monomorphic), so
    // the type-directed reads (the eq/binop gradient, ++'s element
    // dispatch) read the graph instead of the h=0 word floor — zero
    // new writes, the handle the graph already holds.
    //
    // SchemeKind dispatch (H3): a VarRef whose env entry is a
    // nullary ConstructorScheme is a value-position constructor
    // reference (`None`, `True`, `False`). Lower it as
    // LMakeVariant(handle, tag, []) — emit emits the sentinel
    // i32.const form for nullary tags.
    match res {
      RLocal       => LLocal(if local_h == 0 { handle } else { local_h }, name),
      RUpval(slot) => LUpval(if local_h == 0 { handle } else { local_h }, slot),
      // (LF.B) a `<~` lambda param resolves to the feedback site's prior local,
      // read LIVE — the recurrence's y[n-1] term IS this node.
      RFbPrior(fb_h) => LFeedbackPrior(fb_h),
      RGlobal      => match env_kind_of(name) {
        Some(ConstructorScheme(tag_id, _)) =>
          LMakeVariant(handle, tag_id, []),
        // A named-fn VALUE reference (FnScheme tag-0 — excludes HandlerKind,
        // the PTee guard). When the fn DISPATCHES effects, capture its evidence
        // into the unified record (LFnRef) so the consumer (`each(f, xs)`)
        // reads it live as __state — the asymmetry with LambdaExpr's
        // LMakeClosure(..., derive_ev_slots) closed. A PURE fn-value stays bare
        // LGlobal (len(evs)==0 → byte-identical, Law 7).
        Some(FnScheme) => {
          let evs = derive_ev_slots(handle)
          if len(evs) == 0 { LGlobal(handle, name) }
          else { LFnRef(handle, name, evs) }
        },
        // Found, some other kind (a value binding, an op, a record) — the
        // global read is the right projection.
        Some(_) => LGlobal(handle, name),
        // NOT FOUND. `_ => LGlobal(handle, name)` stood here and conflated
        // these two: it guessed an unbound name into `(global.get $name)`,
        // fabricating the one fact infer had just proved false. The guess is
        // never reachable code — it is WAT no assembler accepts — so it did
        // not "keep going"; it moved the medium's own precise, spanned
        // E_MissingVariable to a wat2wasm error hundreds of thousands of
        // lines away, about a symbol the developer never wrote.
        None => LInvariantFailure(handle, MissingName(name))
      }
    }
  },

  // The boolean verbs are CONTROL, not arithmetic: `a && b` IS
  // `if a { b } else { false }`, `a || b` IS `if a { true } else { b }`.
  // The eager i32.and lowering evaluated both operands, so every guard
  // protecting a read (`pos < n && str_eq(set[pos], …)`) ran the read it
  // guards — three latent OOB sites in the wheel's own runtime and infer
  // (set_insert, cache_filter_loop, register_one_variant), all surfaced the
  // hour list_index gained its SYNTAX-promised bounds trap. Those three
  // sites keep explicit control-flow guards for the transition generation
  // (an m2 body compiled by the still-eager boot meets the checked
  // list_index in the same binary).
  BinOpExpr(op, left, right) =>
    match binop_kind(op) {
      BKBool => match op {
        BAnd => LIf(handle, lower_expr(left),
                    [lower_expr(right)],
                    [LConst(handle, LInt(0))]),
        _    => LIf(handle, lower_expr(left),
                    [LConst(handle, LInt(1))],
                    [lower_expr(right)])
      },
      _ => LBinOp(handle, op, lower_expr(left), lower_expr(right))
    },

  UnaryOpExpr(op, inner) =>
    LUnaryOp(handle, op, lower_expr(inner)),

  CallExpr(f, args) => {
    // SchemeKind dispatch (H3): when the callee is a VarRef whose
    // env entry is a ConstructorScheme, the call is value-side
    // ADT instantiation — emit LMakeVariant with the registered
    // tag_id, not LCall through a non-existent fn-table entry.
    // EffectOpScheme dispatch lowers an effect-op call. SYNTAX.md
    // §«Invoking effect operations»: an op is a BARE call — there is
    // no PerformExpr path (dissolved); `op(args)` IS the canonical and
    // only form, dispatched here by the env's EffectOpScheme. Plain
    // function calls fall through.
    let N(fbody, _, fh) = f
    // Resolve the arg PRODUCT to the callee's positional param order — labeled
    // args reordered by field name, absent fields filled by their param
    // defaults — the ONE read both infer + lower call (identical order by
    // construction). For an intrinsic / constructor / fn-param callee with no
    // declared params, resolution is positional passthrough (LabeledArg
    // wrappers stripped). This subsumes the old trailing-only default fill.
    let r_args = resolve_call_args(lower_callee_name(fbody), args)
    // PARTIAL APPLICATION AS A VALUE (SYNTAX §«Partial application — the
    // product with a hole»): resolved args leaving declaration-order params
    // unfilled — an authored `??` slot — IS the lambda the surface law names
    // (`add3(10, ??, 30)` ≡ `(x) => add3(10, x, 30)`), supplied fields
    // evaluated ONCE at construction. The fork mirrors infer_call's dispatch:
    // (same call_hole_index read, same is_seq_op precedence); the mint
    // precedes lo_args so hole slots never lower. Pipe-right calls never
    // reach this fork — lower_pipe_complete dispatches them fork-free (the
    // pipe owns its hole; the inline splice is the zero-record projection
    // of the same hole-filling).
    match partial_unfilled(lower_callee_name(fbody), fh, r_args) {
      Some(n_ps) => lower_call_partial(handle, fbody, fh, r_args, n_ps),
      None       => lower_call_dispatch(handle, f, fh, fbody, r_args)
    }
  },

  IfExpr(cond, then_e, else_e) =>
    LIf(handle, lower_expr(cond),
        [lower_expr(then_e)],
        [lower_expr(else_e)]),
  BlockExpr(stmts, final_e) => {
    let cp = ls_push_scope()   // drift-audit: ignore — sequenced effectful scope checkpoint (LowerScope)
    // M4 — an Abandon perform DIVERGES (it always yields, unwinding to its
    // install's driver), so any statement/expression after it is DEAD. The
    // block's value IS the diverging statement's yield; the remainder deadens
    // (never lowered), so post-abort EFFECTFUL code cannot run. Without this
    // the abort's LYield stands but `s; abort(); print(x)` would raise the
    // flag and STILL run print before the frame propagates (the crucibles'
    // pure `0` hid it). The prefix statements up to the divergence lower
    // and drop as usual; the diverging one lowers as the block VALUE (not
    // dropped, so its yield is the block's result the enclosing frame
    // propagates).
    let result = match first_diverging(stmts, 0) {
      Some(i) => {
        let lo_prefix = lower_stmt_list(take(i, stmts))
        let lo_diverge = lower_expr(list_index(stmts, i))
        LBlock(handle, list_concat(lo_prefix, [lo_diverge]))
      },
      None => {
        let lo_stmts = lower_stmt_list(stmts)
        let lo_final = lower_expr(final_e)
        LBlock(handle, list_concat(lo_stmts, [lo_final]))
      }
    }
    ls_pop_scope(cp)
    result
  },

  MatchExpr(scrutinee, arms) => {
    let N(_, _, sh) = scrutinee
    LMatch(handle, lower_expr(scrutinee), lower_match_arms(sh, arms))
  },

  MakeListExpr(elems) =>
    LMakeList(handle, lower_expr_list(elems)),

  MakeTupleExpr(elems) =>
    LMakeTuple(handle, lower_expr_list(elems)),

  MakeStringExpr(fragments) =>
    // Per #138: MakeStringExpr is the semantic-preserving form of
    // string interpolation (alternating literal + splice fragments).
    // Lower projects it to a left-fold of str_concat calls at this
    // cursor — the runtime substrate is the str_concat composition.
    // Post-Mentl-ultimate-strings (peer Hβ.runtime.zero-copy-string-
    // view's view-substrate), the fold materializes to one alloc per
    // concat node; the view-substrate ensures zero byte-copy through
    // each splice's lex-produced view operand.
    lower_string_interpolation(handle, lower_expr_list(fragments)),

  IndexExpr(receiver, index) =>
    // Subscript dispatch at lower-time — the proof becomes the dispatch.
    // A tuple IS a positional product (L1); indexing it at a CONSTANT is a
    // field load read live from the proven Ty: lower emits LFieldLoad at the
    // width-summed prefix-sum to element i (tuple_elem_offset — the SAME fold
    // records run), the load width is the index handle's own repr
    // (LFieldLoad reads repr_of(lookup_ty(h)), so an f64 element loads f64).
    // Bounds are discharged at compile time (the const is in range or the
    // offset is -1 → the LFieldLoad unprovable floor, never a fabricated 0).
    // Tuple construction (emit_field_stores_acc) and LPTuple match-bind read
    // the SAME offset fold — the three move in lock-step (Law 7: a half-
    // migration mis-offsets an f64 tuple). A genuinely-runtime-variable index,
    // or a list receiver, stays the runtime list_index call.
    lower_index(handle, receiver, index),

  MakeRecordExpr(fields) =>
    LMakeRecord(handle, lower_record_field_values(fields)),

  NamedRecordExpr(_type_name, fields) =>
    // H2.3: nominal records lower identically to bare record
    // literals — type identity is type-system-only, runtime sees
    // raw fields. The type name is preserved in the AST for
    // diagnostics and IDE projection but doesn't reach LIR.
    LMakeRecord(handle, lower_record_field_values(fields)),

  RecordUpdateExpr(base, overrides) =>
    // {...base, f: v} — non-destructive update. The RESULT record's
    // field set is PROVEN by infer (base's fields ∪ overrides), read
    // live via lookup_ty(handle); each result field is either an
    // override value or a field-load COPIED from base at its proven
    // offset — never re-derived, never a runtime field-copy loop. The
    // base is evaluated once into a temp local (LLet) and field-loaded
    // N times (LLocal) — the share the spread semantics demand.
    lower_record_update(handle, base, overrides),

  LambdaExpr(params, body_node) => {
    // DESIGN Ch 1: lambdas close over their free variables. Each
    // lambda gets a unique name derived from its AST handle, so
    // emit's deep walk lifts every LMakeClosure — top-level or
    // inline — into a WASM function entry in the `$fns` table.
    // Param + capture HANDLES are threaded into the frame so VarRef
    // resolution returns the local's actual type handle (Phase-A1).
    let lambda_name = "lambda_{int_to_str(handle)}"
    let param_names_list = lower_param_names(params)
    let param_handles_list = param_handles_of(handle, params)
    let free_names = collect_free_vars(body_node, param_names_list)
    let (captures_names, captures_exprs, captures_handles) =
      resolve_captures_outer(free_names, handle)
    // Lambda is anonymous — empty fn_name; ls_outer_fn_name skips it.
    // lambda_h = THIS lambda's own handle (the SAME handle derive_ev_slots /
    // LMakeClosure use below), so the in-body ev READ indexes the lambda's own
    // row — read==place by construction.
    ls_enter_frame(
      "",
      param_names_list, param_handles_list,
      captures_names, captures_handles,
      handle
    )
    lower_frame_fence_push()
    let lo_body = k2_guard(mark_tail(lower_body_reified(body_node)))   // Hβ.lower.tail-call-mark-pass — lambda body is in tail; MultiShot spine → the k1 yield; k2_guard floors off-spine boundaries (M1.3)
    lower_frame_fence_pop()
    ls_exit_frame()
    let fn_ir = LFn(
      lambda_name,
      len(params),
      param_names_list,
      [lo_body],
      mk_ef_pure(),
      len(captures_exprs)   // closure fence = capture count
    )
    // A closure IS state IS evidence: the lambda captures the evidence for
    // the effects ITS BODY performs (derive_ev_slots reads the lambda's row),
    // resolved at THIS definition site (where those effects' handlers are in
    // scope). Without it the closure's evidence region is empty and a perform
    // inside the lambda reads a bad slot when the closure is called elsewhere
    // (e.g. a higher-order fn's arm calling `f(x)`). This is the per-closure
    // mirror of a handler arm's captured_evs — the same record, four roles.
    LMakeClosure(handle, fn_ir, captures_exprs, derive_ev_slots(handle))
  },

  ResumeExpr(val, state_updates) =>
    // The cursor reads the op's proven cardinality LIVE (the body IS the
    // contract; current_resume_discipline() projects it from the enclosing
    // arm context) and picks the representation — the gradient at the resume
    // site, the TIME-axis twin of the function-dispatch gradient. The
    // continuation is the unified heap record's fifth role: minted ONLY when
    // the body actually resumes more than once.
    match current_resume_discipline() {   // drift-audit: ignore — sequenced effectful arm-context read (LowerScope)
      // OneShot (~85%): the zero-cost stack return — BYTE-IDENTICAL to the
      // pre-producer floor. Hβ.first-light.resume-with-state-mutation
      // (SUBSTRATE.md L660-694): the resume value AND every `with field = NEW`
      // RHS read the PRE-update state; lower_resume_snapshot commits the stores
      // after evaluating all RHS into scratch locals in source order.
      OneShot   => lower_resume_oneshot(handle, val, state_updates),
      Either    => lower_resume_oneshot(handle, val, state_updates),
      // MultiShot: resume(v) CALLS the k record the driver bound to the
      // arm's __k param — the W7 closure convention on fn_ptr@0, N times
      // (k is immutable data; the reification happened at the PERFORMING
      // frame's yield, lower_body_reified). The catching handler
      // (in-memory / oracle-rollback / persist) is the swap.
      MultiShot => lower_resume_callk(handle, val, state_updates),
      // M4 — a resume inside a pure-Abandon op's arm is the MIXED case (the
      // op has an abandon arm AND a resume arm). It does not occur in the
      // wheel or crucibles: abort/fail are single-handler UZero, so a
      // resume under an Abandon-graded op is unreachable-by-construction (a
      // UZero arm has no resume). If it ever arises, the op must reify k at
      // the perform (become MultiShot — the abandon perform's dead k=0
      // would trap here, loud, never silent): Hβ.lower.abandon-with-resume-arm.
      Abandon   => lower_resume_callk(handle, val, state_updates)
    },

  FieldExpr(rec, field) => {
    // W6: the field NAME rides the node; the offset projects at emit from
    // the receiver's live type under the bracket.
    LFieldLoad(handle, lower_expr(rec), FByName(field))
  },

  PipeExpr(kind, left, right) =>
    lower_pipe(kind, left, right, handle),

  ExprPlaceholder =>
    LConst(handle, LInt(0)),   // ? — emit lowers to unreachable via NHole check

  // A labeled arg is resolved to positional by resolve_call_args before
  // lower_expr sees it; reaching here means one leaked outside a call's arg
  // list. Lower the value through (productive-under-error) — infer has already
  // surfaced the E_UnknownArgLabel diagnostic at this node.
  LabeledArg(_, v) =>
    lower_expr(v)
}

// `|>` is HOLE-COMPLETION (SYNTAX.md §«Partial application — the product
// with a hole»), never a positional rewrite: the piped value fills the
// right call's one remaining hole — the authored `??` slot when present,
// else the first unfilled declaration-order param (the trailing hole of a
// positional-prefix partial). A SATURATED call is a closure-producing
// stage; the piped value applies to its result. The callee's arity is
// read LIVE from its graph type (lookup_ty → TFun) — Carried-Truth,
// never a second arity table. Factored from PForward so the k remainder
// builder can complete a stage with the RESUME HOLE as the piped value
// (band B M1.3) — one completion, two callers.
fn lower_pipe_complete(lo_l, right, handle) = {
  let N(rbody, _, rfh) = right
  // A pipe-right CALL dispatches fork-free (lower_call_dispatch): the pipe
  // owns its hole and completes it below by inline splice, so a raw
  // hole-bearing call in stage position never mints a partial closure.
  let lo_r = match rbody {
    NExpr(CallExpr(f2, args2)) => {
      let N(fbody2, _, fh2) = f2
      // The same LFnRef→LGlobal callee-position collapse lower_callee_ref
      // applies (a record-ctor identity can surface its arg's LFnRef) —
      // byte-parity with the pre-extraction path.
      match lower_call_dispatch(rfh, f2, fh2, fbody2,
        resolve_call_args(lower_callee_name(fbody2), args2)) {
        LFnRef(h2, n2, _) => LGlobal(h2, n2),
        lo2               => lo2
      }
    },
    _ => lower_callee_ref(right)
  }
  let hole_at = match rbody {
    NExpr(CallExpr(_, cargs)) => pipe_hole_index(cargs, 0),
    _                         => -1
  }
  let is_partial = match rbody {
    NExpr(CallExpr(f, cargs)) => len(cargs) < callee_arity_of(f),
    _                         => false
  }
  match lo_r {
    LCall(ch, fn_, args) =>
      if hole_at >= 0      { LCall(ch, fn_, splice_at(args, hole_at, lo_l)) }
      else if is_partial   { LCall(ch, fn_, args ++ [lo_l]) }   // drift-audit: ignore — one completion per pipe node, not a loop accumulator
      else                 { LCall(handle, lo_r, [lo_l]) },
    LSuspend(sh, oph, fnx, args, evs, tl) =>
      if hole_at >= 0      { LSuspend(sh, oph, fnx, splice_at(args, hole_at, lo_l), evs, tl) }
      else if is_partial   { LSuspend(sh, oph, fnx, args ++ [lo_l], evs, tl) }   // drift-audit: ignore — one completion per pipe node
      else                 { LCall(handle, lo_r, [lo_l]) },
    LMakeVariant(vh, tag, vargs) =>
      if hole_at >= 0      { LMakeVariant(vh, tag, splice_at(vargs, hole_at, lo_l)) }
      else if is_partial   { LMakeVariant(vh, tag, vargs ++ [lo_l]) }   // drift-audit: ignore — one completion per pipe node
      else                 { LCall(handle, lo_r, [lo_l]) },
    _ => {
      // A bare fn-VALUE stage (`7 |> outer`): the completion call runs the
      // SAME evidence fork every call runs — this arm minted a bare LCall
      // and an effectful piped stage's callee starved (ev4's 134; ev2's
      // block spelling of the same program was green). The already-lowered
      // callee is reused; the fork reads the stage node's own type.
      let evs = derive_ev_slots(rfh)
      let evs2 =
        if resume_bind_target(rfh) {
          evs ++ [LEvEntry("__resume", resolve_resume_k(handle))]   // drift-audit: ignore — one entry per stage, not a loop
        } else { evs }
      if len(evs2) == 0 { LCall(handle, lo_r, [lo_l]) }
      else              { LSuspend(handle, rfh, lo_r, [lo_l], evs2, false) }
    }
  }
}

fn lower_pipe(kind, left, right, handle) = match kind {
  // `<|`/`><` — ONE parallel-fanout topology, discriminated by input
  // ownership (the FanOwnership aspect). The verb draws the independence
  // edge + tuples the branch results; it does NOT schedule. HOW the
  // branches run is read LIVE from the installed `~>` chain
  // (`lower_fanout_schedule()` → Seq/Thread/Simd/Gpu) — the same handler
  // stack every `perform` resolves through. NO scheduler → Seq (the
  // invisible default): branches evaluate inline, tupled in source order.
  // Drift 1 closure: the handler chain IS the dispatch; no vtable. Drift
  // 5 closure: any per-thread state lives in the chosen handler's `with`,
  // never an ad-hoc parallel struct.
  PFanout(fan_own) =>
    lower_fanout(handle, fan_own, left, right),

  PForward => lower_pipe_complete(lower_expr(left), right, handle),

  PTee => {
    // ~> tee — handler attachment. One precedence, one kind: the parser's
    // table already scoped the handler over the whole chain to its left.
    // Push the handler onto the lower-stack BEFORE lowering the body so a
    // Tier-1 perform inside resolves to it AND learns the install handle
    // (→ `__hstate_<h>`, the SAME record the arm runs against). Pop after.
    //
    // The ONE handler record (protocol_handler_is_state_is_closure_is_evidence)
    // carries config args (from `~> handler(args)`, written FIRST) then
    // state inits at 8+i*4, the per-effect arm groups, and the arm-bodies'
    // captured evidence — resolved at THIS install position (handler popped,
    // so they route to the enclosing scope, not self).
    let lo_r = lower_expr(right)
    let hname = extract_handler_name(right)
    lower_handler_push(hname, handle)
    // The install body takes the k1 split too — upstream of tier selection,
    // so an inline `{ pick() } ~> twice` spelling yields instead of baking a
    // lexical-tier arm call the driver could never intercept.
    let lo_l = lower_body_reified(left)
    lower_handler_pop()
    let config_inits = extract_handler_config_args(right) |> map(lower_expr)
    let all_inits = config_inits ++ lookup_handler_state_inits_of(hname)
    LHandleWith(handle, lo_l, lo_r, hname, all_inits,
                lookup_handler_arm_names_of(hname),
                lower_captured_evs_for(hname))
  },

  PFeedback => {
    // <~ feedback — requires iterative context. The LFeedback emit declares
    // and loads $__fb_prev_<h> (the prior-iteration output), so the body can
    // read it LIVE. (LF.B) When the LHS is `(prev) => body`, `prev` binds to
    // THIS feedback handle's prior node and the recurrence y[n]=f(x[n],y[n-1])
    // is expressed — not commented. The lambda is INLINED (its body lowers
    // directly into the cycle), never a closure: the prior is a register read,
    // and a `<~` recurrence allocating a closure per tick would defeat !Alloc.
    let lo_l = lower_feedback_body(left, handle)
    let lo_r = lower_expr(right)
    LFeedback(handle, lo_l, lo_r)
  }
}

// (LF.B) Lower the LHS of a `<~`. A single-param lambda `(prev) => body`
// The `??` hole's declaration-order index among a call's RAW args — the
// pipe's completion target (SYNTAX §«Partial application»: `x |> clamp(0,
// ??, 255)` names the hole; the first authored hole is the one completed).
fn pipe_hole_index(args, i) =
  if i >= len(args) { -1 }
  else {
    let N(b, _, _) = list_index(args, i)
    match b {
      NHole(_) => i,
      _        => pipe_hole_index(args, i + 1)
    }
  }

// The callee's declared arity, read LIVE from its inferred TFun (the graph
// already proves it — never a second arity table). -1 when the graph holds
// no fn type at the callee (the unresolved callee already carries its own
// diagnostic); the pipe then treats the right side as a saturated stage.
fn callee_arity_of(f) = {
  let N(_, _, fh) = f
  match lookup_ty(fh) {
    TFun(ps, _, _) => len(ps),
    _              => -1
  }
}

// Replace the completed hole's slot in a lowered args list — the product's
// one absent field filled by the piped value.
fn splice_at(xs, i, v) =
  slice(xs, 0, i) ++ [v] ++ slice(xs, i + 1, len(xs))   // drift-audit: ignore — one three-way splice per completed hole, not a loop accumulator

// binds `prev` to the feedback site's prior local and inlines the body —
// the recurrence reads y[n-1] live. Any other LHS lowers as-is (a bare
// expression computes on the current input only, the structural form).
fn lower_feedback_body(left, fb_handle) = {
  let N(lbody, _, _) = left
  match lbody {
    NExpr(LambdaExpr(params, body)) =>
      if len(params) == 1 {
        ls_bind_fb_prior(feedback_param_name(last(params)), fb_handle)
        let lo = lower_expr(body)
        ls_unbind_fb_prior()
        lo
      } else { lower_expr(left) },
    _ => lower_expr(left)
  }
}

// The bound name of a `<~` lambda's single param (the prior-output binder).
// TParam's first field IS the name string (a wildcard `(_)` lowers it to "_",
// which never resolves — a feed-forward body simply leaves the prior
// unreferenced). One destructure, read live — no pattern re-classification.
fn feedback_param_name(p) = param_name(p)

// Extract the handler-name string from the AST node on the right side
// of a `body ~> handler` pipe. Recognized shapes:
//   VarRef(name)                  — `~> map_h`
//   CallExpr(VarRef(name), args)  — `~> map_h(f)` (handler-decl with config)
// Returns "" for anonymous handle-expressions or unrecognized shapes
// (productive-under-error per Hazel; emit checks "" sentinel and
// skips global-set for anonymous handlers).
//
// Drift refused:
// - 7 parallel-rep: returning a record `{kind, name}` would duplicate
//   info already encoded in the AST shape. String + "" sentinel IS the
//   canonical projection.
// - 8 string-keyed-when-structured: name is genuinely a String here
//   (handler symbol resolved at install); this is NOT a mode-int.
// - 9 deferred-by-omission: the wheel-side mirror of seed's
//   $extract_handler_name (bootstrap/src/lower/walk_handle.wat:638).
// The install's handler NAME, read through the node wrapper (every AST
// node is N(body, span, h); the body carries NExpr(...) — matching
// VarRef against the bare N record silently fell to the "" sentinel,
// so every install m2 lowered was anonymous: no arm groups, no lexical
// Tier-1 resolve, the arm container unreached, the record's arm slot
// zero, and the perform's strict scan trapping in main). "" remains
// the MEANINGFUL sentinel for a genuinely anonymous install expression.
fn extract_handler_name(node) = {
  let N(body, _, _) = node
  match body {
    NExpr(VarRef(name)) => name,
    NExpr(CallExpr(callee, _args)) => {
      let N(cb, _, _) = callee
      match cb {
        NExpr(VarRef(name)) => name,
        _ => ""  // drift-audit: ignore — "" = genuinely anonymous install (the meaningful sentinel)
      }
    },
    _ => ""  // drift-audit: ignore — "" = genuinely anonymous install (the meaningful sentinel)
  }
}

// Config args from `~> handler(arg1, arg2)` — the parameterized-handler
// factory's arguments, lowered and written FIRST into the install record
// (before state inits). A bare `~> handler` (VarRef) has none.
fn extract_handler_config_args(node) = {
  let N(body, _, _) = node
  match body {
    NExpr(CallExpr(_callee, args)) => args,
    _                              => []
  }
}

// Fanout lowering — ONE path for `<|` and `>< `, discriminated by the
// FanOwnership aspect. The verb produces strategy-NEUTRAL branch thunks
// (each a 0-arg closure, the unified heap record — handler = state =
// closure = evidence = continuation, §6 — so a branch is portable
// across a thread boundary, packable into a SIMD lane, shippable to a
// device, or persisted mid-flight: four backends, four readings of ONE
// record shape). HOW they run is read LIVE from the installed `~>`
// chain via `lower_fanout_schedule()` — never baked into the verb.
//
//   `FanDistribute` (`><`) — BINARY: two independent owned-input
//       branches, each a `synthesize_branch_thunk`.
//   `FanShare` (`<|`) — one input ref-borrowed: bind the input once as
//       a let-local, then N shared-input thunks each applying their
//       branch fn to it (the `__fanout_input` capture).
//
// `effects_of(fanout) = ⋃ branch rows` (the Thread inject is deleted at
// infer); ownership affinity (own values cannot flow through `<|`) is
// proven at infer (E_OwnershipViolation), trusted here.
//
// All four backends are LIVE (W13, this batch — the strategy-neutral thunks
// read four ways): `~> Simd` packs the f32 branch results into v128 lanes
// (LSimdLanes, the value layer's RV128 repr meeting the verb); `~> Gpu`
// projects the same thunks to a device-kernel host import (the one legitimate
// external-transport boundary, "the handler IS the backend" — the host-import
// binding is peer Hβ.lower.fanout-gpu-host-import); `~> Persist` checkpoints
// each branch thunk to disk via persist_branch/join_persist for crash-
// survivable parallel execution (§4④ — parallelism and durable execution are
// the same arm). Each is a `~> handler` choice over the one pure-topology verb.
fn lower_fanout(handle, fan_own, left, right) = {
  // Infer owns the ordered executable edges at the fanout site. Project them
  // directly; tuple types prove the result shape but are not an identity index.
  match fanout_boundaries(handle) {
  Ok(boundaries) => match fan_own {
  FanDistribute => {
    let N(_, _, lh) = left
    let N(_, _, rh) = right
    let l_boundary = fanout_boundary_at(boundaries, 0, lh)
    let r_boundary = fanout_boundary_at(boundaries, 1, rh)
    let branches = [ synthesize_branch_thunk(handle, "l", left, l_boundary),
                     synthesize_branch_thunk(handle, "r", right, r_boundary) ]
    run_fanout_thunks(handle, branches)
  },
  FanShare => {
    let lo_input = lower_expr(left)
    let input_local_name = "__fanout_input_{int_to_str(handle)}"
    let N(_, _, input_h) = left
    let N(rbody, _, _) = right
    let branch_nodes = match rbody {
      NExpr(MakeTupleExpr(elems)) => elems,
      _                            => [right]
    }
    let branches = synthesize_diverge_thunks(
      handle, input_h, input_local_name, branch_nodes, boundaries, 0)
    // Bind the shared input ONCE, then run the thunks (each captures it).
    LBlock(handle, [
      LLet(input_h, input_local_name, lo_input),
      run_fanout_thunks(handle, branches)
    ])
  }
  },
  Err(invariant) => LInvariantFailure(handle, invariant)
  }
}

// Inference is the sole writer of executable boundaries. Missing here means
// lower was asked to project a graph whose fanout topology has no executable
// edge: a compiler error, surfaced before the productive-under-error fallback.
fn fanout_boundaries(handle) = match graph_boundary_at(handle) {
  FanoutBoundary(edges) => Ok(edges),
  PendingContinuationBoundary(_, _, _, _) => {
    report(EUnresolvedType(handle, graph_epoch(), parse_span_of(handle)))
    Err(WrongFanoutBoundaryKind)
  },
  ContinuationBoundary(_) => {
    report(EUnresolvedType(handle, graph_epoch(), parse_span_of(handle)))
    Err(WrongFanoutBoundaryKind)
  },
  NoBoundary => {
    report(EUnresolvedType(handle, graph_epoch(), parse_span_of(handle)))
    Err(MissingFanoutBoundary)
  }
}

fn fanout_boundary_at(boundaries, i, fallback_h) =
  if i < len(boundaries) { Ok(list_index(boundaries, i)) }
  else {
    report(EUnresolvedType(fallback_h, graph_epoch(), parse_span_of(fallback_h)))
    Err(MissingFanoutEdge(i))
  }

fn executable_boundary_row(thunk_h) = match lookup_ty(thunk_h) {
  TFun(_, _, row) => Ok(row),
  _ => {
    report(EUnresolvedType(thunk_h, graph_epoch(), parse_span_of(thunk_h)))
    Err(UnresolvedBoundaryThunk(thunk_h))
  }
}

// Run the exact zero-argument boundary and immediately project its one-field
// carrier back to the semantic result representation. The scheduler only ever
// transports the carrier pointer; f64/f32/v128 remain unboxed in field 0.
fn invoke_scheduled_boundary(branch) = match branch {
  ScheduledBoundary(thunk, result_h, carrier_h, _, _) =>   // drift-audit: ignore — positional destructure/construction of the ONE BoundaryEdge/ContinuationEdge record — the record exists; these are its named fields, not parallel arrays
    LFieldLoad(result_h, LCall(carrier_h, thunk, []), FByIndex(0)),
  InvalidScheduledBoundary(handle, invariant) => LInvariantFailure(handle, invariant)
}

// Project the strategy-neutral branch thunks through the schedule read
// LIVE from the installed `~>` chain. `prelude` are statements that must
// run before the thunks (the `<|` input let-local); the result is the
// branch-result tuple in SOURCE order — determinism is the verb's, not
// the scheduler's. NO scheduler → Seq (the invisible default the old
// hardwired Thread inject made unsayable): each thunk runs inline (a
// 0-arg closure call), results tupled in source order. `~> Thread` →
// spawn-ALL-then-join-ALL in source order (true-parallel-ordered, not
// the spawn-join-each interleave that serialized). `~> Simd` packs the f32
// branch results into v128 lanes (LSimdLanes); `~> Gpu` projects the thunks
// to a device-kernel host import (external-transport boundary); `~> Persist`
// checkpoints each branch thunk to disk (persist_branch/join_persist). All
// read the SAME strategy-neutral thunks — only the collector differs.
fn run_fanout_thunks(handle, branches) = match lower_fanout_schedule() {
  Seq => LMakeTuple(handle, map(invoke_scheduled_boundary, branches)),
  Threaded => {
    // Spawn ALL branches, THEN join ALL — true parallelism with
    // source-order collection (the spawn-join-each interleave
    // serialized). The spawn handles bind as let-locals so the joins
    // read them after every spawn has launched.
    let spawn_lets = map((indexed) => {
      let (i, branch) = indexed
      match branch {
        ScheduledBoundary(thunk, _, _, thread_ticket_h, _) =>
          LLet(thread_ticket_h, "__fanout_spawn_{int_to_str(i)}_{int_to_str(handle)}",
            lower_perform_dispatch(thread_ticket_h, "spawn", [thunk])),
        InvalidScheduledBoundary(boundary_h, invariant) =>
          LLet(boundary_h, "__fanout_spawn_invalid_{int_to_str(i)}_{int_to_str(handle)}",
            LInvariantFailure(boundary_h, invariant))
      }
    }, enumerate(branches))
    let joins = map((indexed) => {
      let (i, branch) = indexed
      match branch {
        ScheduledBoundary(_, result_h, carrier_h, thread_ticket_h, _) => {   // drift-audit: ignore — positional destructure/construction of the ONE BoundaryEdge/ContinuationEdge record — the record exists; these are its named fields, not parallel arrays
          let joined = lower_perform_dispatch(carrier_h, "thread_join",
            [LLocal(thread_ticket_h, "__fanout_spawn_{int_to_str(i)}_{int_to_str(handle)}")])
          LFieldLoad(result_h, joined, FByIndex(0))
        },
        InvalidScheduledBoundary(boundary_h, invariant) =>
          LInvariantFailure(boundary_h, invariant)
      }
    }, enumerate(branches))
    LBlock(handle, list_concat(spawn_lets, [LMakeTuple(handle, joins)]))
  },
  // `~> Simd` — the SPACE-axis cash-out at the value layer's RV128 altitude:
  // the N branch results ARE the v128 lanes. Each thunk evaluates to an f32
  // (the branch's repr, read live by emit); LSimdLanes packs them via
  // f32x4.replace_lane over a zeroed base, so the fanout's VALUE is one v128 the
  // lane ops (emit_binop_v128: f32x4.add/mul) process four-at-once. The thunks
  // are the SAME strategy-neutral closures Seq/Thread call — only the COLLECTOR
  // differs (lanes vs tuple), proving the verb is pure topology (PLAN §4 STEP 4).
  Simd => LSimdLanes(handle, map(invoke_scheduled_boundary, branches)),
  // `~> Gpu` — "the handler IS the backend" (PLAN: infer/lower/emit/native/GPU
  // are the projected cursor, each aspect → a target token). The WASM substrate
  // has no in-process GPU dispatch instruction — a device kernel crosses the
  // external-transport boundary (the ONE legitimate external-surface exception,
  // like wasmtime/WABT, PLAN §6). The structurally-correct lowering is a host
  // import call carrying the branch thunks as the kernel grid; until a host
  // gpu-dispatch import is bound, it routes through the SAME strategy-neutral
  // thunks Seq runs (a correct sequential execution of the kernel body), and the
  // device offload is the host-import swap at that boundary — named peer
  // Hβ.lower.fanout-gpu-host-import (the transport binding, not a Mentl gap).
  Gpu  => LMakeTuple(handle, map(invoke_scheduled_boundary, branches)),
  // `~> Persist` — parallelism and durable execution are the SAME arm (PLAN
  // §4④): each branch thunk is a continuation record (handler = state = closure
  // = evidence = continuation, §6), so a Persist scheduler spawns each branch
  // AND checkpoints its thunk to disk — a crashed/forked branch re-runs from its
  // memcpy'd record. The catch is the Persist handler (lib/runtime/persist.mn,
  // B3): each thunk is dispatched via `persist_branch` (spawn + checkpoint),
  // joined via `join_persist` (resume from disk if the live result is absent).
  // The thunks are the same strategy-neutral closures — only the CATCHER differs
  // (a persisting handler vs a thread pool vs inline), the §4④ unification made
  // real at the fanout layer.
  Persisted => {
    let spawn_lets = map((indexed) => {
      let (i, branch) = indexed
      match branch {
        ScheduledBoundary(thunk, _, _, _, persist_ticket_h) =>
          LLet(persist_ticket_h, "__fanout_persist_{int_to_str(i)}_{int_to_str(handle)}",
            lower_perform_dispatch(persist_ticket_h, "persist_branch", [thunk])),
        InvalidScheduledBoundary(boundary_h, invariant) =>
          LLet(boundary_h, "__fanout_persist_invalid_{int_to_str(i)}_{int_to_str(handle)}",
            LInvariantFailure(boundary_h, invariant))
      }
    }, enumerate(branches))
    let joins = map((indexed) => {
      let (i, branch) = indexed
      match branch {
        ScheduledBoundary(_, result_h, carrier_h, _, persist_ticket_h) => {   // drift-audit: ignore — positional destructure/construction of the ONE BoundaryEdge/ContinuationEdge record — the record exists; these are its named fields, not parallel arrays
          let joined = lower_perform_dispatch(carrier_h, "join_persist",
            [LLocal(persist_ticket_h, "__fanout_persist_{int_to_str(i)}_{int_to_str(handle)}")])
          LFieldLoad(result_h, joined, FByIndex(0))
        },
        InvalidScheduledBoundary(boundary_h, invariant) =>
          LInvariantFailure(boundary_h, invariant)
      }
    }, enumerate(branches))
    LBlock(handle, list_concat(spawn_lets, [LMakeTuple(handle, joins)]))
  }
}

// Walk branch_nodes producing one LMakeClosure per branch. Each thunk body is
// the ordinary call projection of the branch stage applied to the shared
// input, carrying inference's result_h through LCall/LSuspend. Captures begin
// with the shared input and then include the branch's free variables.
//
// Per H.2.e (lower-lambda-capture-substrate): the closure
// machinery used here is the same machinery that lowers user-
// written lambdas; compiler-synthesized thunks reuse it.
fn synthesize_diverge_thunks(parent_handle, input_h, input_local_name, branch_nodes, boundaries, base_idx) = map((indexed) => {
  let (i, branch_node) = indexed
  let N(_, _, branch_h) = branch_node
  match fanout_boundary_at(boundaries, base_idx + i, branch_h) {
  Ok(boundary) => {
  let BoundaryEdge(result_h, thunk_h, carrier_h, thread_ticket_h, persist_ticket_h) = boundary   // drift-audit: ignore — positional destructure/construction of the ONE BoundaryEdge/ContinuationEdge record — the record exists; these are its named fields, not parallel arrays
  let thunk_name = "diverge_{int_to_str(base_idx + i)}_{int_to_str(parent_handle)}"
  // A diverge thunk is a closure exactly like a branch thunk (`><`,
  // synthesize_branch_thunk) — ONE closure-synthesis discipline, not two.
  // It captures EVERY free var it needs: the shared input (a synthetic
  // capture with no source VarRef, riding slot 0) AND every free var the
  // branch itself references (a lambda branch's `k`), resolved against the
  // parent frame. Inside the thunk each reads as an upval off __state. The
  // old form captured only the input and referenced it as a bare local —
  // the parent's let-local, undefined in the thunk (the input miss); and it
  // captured NONE of the branch's frees (the `k` miss). Both were invisible
  // because no micro exercised `<|` — only `><`.
  let free_names = collect_free_vars(branch_node, [])
  let (b_names, b_exprs, b_handles) = resolve_captures_outer(free_names, parent_handle)
  let captures_names   = [input_local_name] ++ b_names
  let captures_exprs   = [LLocal(input_h, input_local_name)] ++ b_exprs
  let captures_handles = [input_h] ++ b_handles
  ls_enter_frame("", [], [], captures_names, captures_handles, -1)
  lower_frame_fence_push()
  // This is an ordinary call projected from an implicit application edge.
  // Reuse the normal call lowering so effectful stages take LSuspend and pure
  // stages take LCall; result_h is the application output infer minted.
  let branch_value = lower_call_default(
    result_h, branch_node, branch_h, [LUpval(input_h, 0)])
  let thunk_body = k2_guard(LMakeTuple(carrier_h, [branch_value]))
  lower_frame_fence_pop()
  ls_exit_frame()
  match executable_boundary_row(thunk_h) {
  Ok(thunk_row) => {
  let fn_ir = LFn(thunk_name, 0, [], [thunk_body],
                  thunk_row, len(captures_exprs))
  // The captured evidence IS the branch's — a `<|` branch that performs a
  // STATEFUL effect (verify_pending_at → Verify, teach_gradient → Teach) reads
  // it live through the thunk's [key][record][base] region, exactly as a real
  // lambda does (the `derive_ev_slots(handle)` sites above). The old `[]` gave
  // the thunk no effect evidence, so a stateful-effect perform inside a branch
  // met the strict ev_perform_entry miss (only singleton `!Mutate` handlers,
  // dispatched off their `$..._state_g` global, resolved) — invisible until the
  // felt read drove the eight-arm fanout through Verify/Teach.
  ScheduledBoundary(
    LMakeClosure(thunk_h, fn_ir, captures_exprs, derive_ev_slots(thunk_h)),
    result_h, carrier_h, thread_ticket_h, persist_ticket_h)   // drift-audit: ignore — positional destructure/construction of the ONE BoundaryEdge/ContinuationEdge record — the record exists; these are its named fields, not parallel arrays
  },
  Err(invariant) => InvalidScheduledBoundary(thunk_h, invariant)
  }
  },
  Err(invariant) => InvalidScheduledBoundary(branch_h, invariant)
  }
}, enumerate(branch_nodes))

// Branch-as-thunk synthesis. Mirrors LambdaExpr's lowering above —
// collect_free_vars over an EMPTY bound-set (a thunk has no params,
// so every name referenced in the body is a capture), resolve via
// outer frame, lower body under a fresh frame, wrap as LMakeClosure.
// The synthesized fn_name encodes parent_handle + side so emit's
// fn_idx-globals walk lifts each thunk into a distinct WASM function.
// Per H.2.e (lower-lambda-capture-substrate): the same machinery that
// lowers user-written lambdas covers compiler-synthesized thunks.
// Drift 6 closure: same closure substrate — no special-case for
// "compiler-synthesized" thunks vs. user-written ones.
fn synthesize_branch_thunk(parent_handle, side_label, branch_node, boundary) = {
  let N(_, _, branch_h) = branch_node
  match boundary {
  Ok(edge) => {
  let BoundaryEdge(result_h, thunk_h, carrier_h, thread_ticket_h, persist_ticket_h) = edge   // drift-audit: ignore — positional destructure/construction of the ONE BoundaryEdge/ContinuationEdge record — the record exists; these are its named fields, not parallel arrays
  let thunk_name = "compose_{side_label}_{int_to_str(parent_handle)}"
  let free_names = collect_free_vars(branch_node, [])
  let (captures_names, captures_exprs, captures_handles) =
    resolve_captures_outer(free_names, parent_handle)
  // Synthetic parallel-thunk: empty fn_name; not a named fn declaration; not a
  // lambda (lambda_h = -1 → ev READ falls through to the named-fn/block path).
  ls_enter_frame("", [], [], captures_names, captures_handles, -1)
  lower_frame_fence_push()
  let lo_body = k2_guard(LMakeTuple(carrier_h, [lower_expr(branch_node)]))
  lower_frame_fence_pop()
  ls_exit_frame()
  match executable_boundary_row(thunk_h) {
  Ok(thunk_row) => {
  let fn_ir = LFn(
    thunk_name,
    0,
    [],
    [lo_body],
    thunk_row,
    len(captures_exprs)   // closure fence = capture count
  )
  ScheduledBoundary(
    LMakeClosure(thunk_h, fn_ir, captures_exprs, derive_ev_slots(thunk_h)),
    result_h, carrier_h, thread_ticket_h, persist_ticket_h)   // drift-audit: ignore — positional destructure/construction of the ONE BoundaryEdge/ContinuationEdge record — the record exists; these are its named fields, not parallel arrays
  },
  Err(invariant) => InvalidScheduledBoundary(thunk_h, invariant)
  }
  },
  Err(invariant) => InvalidScheduledBoundary(branch_h, invariant)
  }
}

// W6 — resolve a field's byte offset from the record's live type.
// Fields are sorted (field-canonicalize invariants in `effects.mn`), so the
// field's index in `TRecord(fields)` / `TRecordOpen(fields, _)` maps directly
// to `4 * idx`. There is NO graceful degrade: if `lookup_ty` returns a
// non-record type (the receiver's type mis-resolved) or the field is absent,
// return -1 — `emit_lfieldload` guards `offset < 0` and emits a LOUD
// `(unreachable)` with a Located Reason. The former silent `0` read the node's
// word-0 as the field value (a graph pointer) and `wat_emit` dumped the heap:
// the emit corruption. The ultimate form refuses to guess an offset it cannot
// prove; the loud trap names the unresolved receiver instead of masking it.
fn resolve_field_offset(rec_handle, field_name) = {
  match lookup_ty(rec_handle) {
    TRecord(fields)        => field_byte_offset(fields, field_name, 0, len(fields)),
    TRecordOpen(fields, _) => field_byte_offset(fields, field_name, 0, len(fields)),
    // H2.3: nominal records — chase TName through env to its
    // RecordSchemeKind for the field schema. Same offset arithmetic
    // (sorted-by-name, 4 bytes per i32-erased slot).
    TName(name, _)         => match env_lookup(name) {
      Some(entry) => {
        let (_, _, kind) = entry
        match kind {
          RecordSchemeKind(fields) =>
            field_byte_offset(fields, field_name, 0, len(fields)),
          _ => -1
        }
      },
      None => -1
    },
    _                      => -1
  }
}

// A field's byte offset is the prefix-sum of repr_width over the canonically-
// sorted fields preceding it — NOT 4*i. The width is the field's PROVEN repr
// (repr_of of its Ty, read live): an i32/pointer field is 4, an f64/i64 field
// is 8, a v128 lane field is 16. For an all-i32 record this is exactly 4*i
// (Law 7 byte-identity); a float field genuinely occupies 8 inline bytes.
fn field_byte_offset(fields, target, i, n) =
  field_byte_offset_acc(fields, target, i, n, 0)

fn field_byte_offset_acc(fields, target, i, n, acc) = {
  if i >= n { -1 }   // field absent — unprovable offset, NOT a silent 0
  else {
    let (name, ty) = list_index(fields, i)
    if field_name_eq(name, target) { align_for(acc, repr_of(ty)) }
    else {
      let here = align_for(acc, repr_of(ty))
      field_byte_offset_acc(fields, target, i + 1, n,
                            here + repr_width(repr_of(ty)))
    }
  }
}

// v128 lanes want 16-byte alignment for aligned loads/stores; every other
// width is naturally aligned by the prefix-sum (4/8 byte fields). Pad the
// running offset up to the field's alignment before placing it.
fn align_for(off, r) with Pure = match r {
  RV128 => { let m = off % 16; if m == 0 { off } else { off + (16 - m) } },
  _     => off
}

// tuple_elem_offset — a tuple IS a positional product (L1); element `i`'s byte
// offset is the prefix-sum of repr_width over the elements 0..i, the IDENTICAL
// width-summed fold field_byte_offset_acc runs for records. The elements are
// the TTuple's positional Tys (each a resolved TVar — read live via
// repr_of_resolved, the chase). For an all-i32 tuple this is exactly 4*i (Law 7);
// an f64 element genuinely occupies 8 inline bytes. Carried-Truth: construction (emit_field_stores_acc
// over the tuple elems) and the index/match-bind read the SAME offset fold —
// they cannot disagree on where element i lives.
fn tuple_elem_offset(elems, target, i, off) = {
  if i >= len(elems) { -1 }   // index out of range — unprovable, NOT a silent 0
  else {
    let r = repr_of_resolved(list_index(elems, i))
    let here = align_for(off, r)
    if i == target { here }
    else { tuple_elem_offset(elems, target, i + 1, here + repr_width(r)) }
  }
}

// Statement lowering

fn lower_stmt_list(stmts) = {
  let n = len(stmts)
  let initial_capacity = if n < 4 { 4 } else { n }
  let buf = make_list(initial_capacity)
  let (final_buf, final_count) = lower_stmt_list_loop(stmts, 0, n, buf, 0)
  slice(final_buf, 0, final_count)
}

// Buffer-counter loop per Ω.3 discipline. Replaces the prior
// `[lower_stmt(head)] ++ list_concat(lower_stmt_list(tail))` form
// which was non-tail-recursive: each frame held list_concat's
// continuation, so deep stmt lists (the wheel-source's hundreds of
// fns at top level) blew the wasm stack. Tail recursion via
// (buf, count) threading; one allocation per stmt; O(N) total.
fn lower_stmt_list_loop(stmts, i, n, buf, count) = {
  if i >= n { (buf, count) }
  else {
    let lo = lower_stmt(list_index(stmts, i))
    let extended = list_extend_to(buf, count + 1)
    let written  = list_set(extended, count, lo)
    lower_stmt_list_loop(stmts, i + 1, n, written, count + 1)
  }
}

// H6: exhaustive NodeBody enumeration. NPat and NHole at
// statement position are degenerate; lowering to LConst(0)
// is the "unreachable-in-well-formed-source" fallback. Named
// explicitly so a new NodeBody variant surfaces at compile time.
fn lower_stmt(node) = {
  let N(body, span, handle) = node
  match body {
    NStmt(s) => lower_stmt_body(s, handle, span),
    NExpr(e) => lower_expr_body(e, handle, span),
    NPat(_)  => LConst(handle, LInt(0)),   // pattern at stmt position — degenerate
    NHole(_) => LConst(handle, LInt(0)),   // Hazel hole at stmt position — unreachable trap at emit
    NModule(_)  => LConst(handle, LInt(0)), // module entity at stmt position — degenerate
    NTypeAnn(_) => LConst(handle, LInt(0))  // type annotation at stmt position — degenerate
  }
}

fn lower_stmt_body(s, handle, span) = match s {
  LetStmt(pat, expr, _) => {
    let lo = lower_expr(expr)
    match pat {
      PVar(name) => {
        // Register the name in the current scope (a local for subsequent
        // VarRef lookups; the bound expr's handle IS the local's type handle).
        let N(_, _, expr_h) = expr
        ls_bind_local(name, expr_h)
        LLet(handle, name, lo)
      },
      // PWild / PLit: evaluate for effect, no binding. DESTRUCTURE patterns
      // (PTuple/PCon/PList/PRecord) never reach here — the parser desugars
      // `let pat = v; rest` to `match v { pat => rest }` at the node's birth
      // (desugar_block), so LetStmt is PVar-only by construction. Binding +
      // field-load + nesting all come from the ONE match projection
      // (lower_match_arms → bind_pat_locals), no parallel destructure
      // re-derivation. (protocol_one_graph_two_operations.)
      _ => lo
    }
  },

  FnStmt(name, params, _ret_ann, _effs, body_node) => {
    // Bind the fn's name in the enclosing frame; the fn's handle is
    // the type handle (TFun bound to handle by infer).
    ls_bind_local(name, handle)
    let param_names_list = lower_param_names(params)
    let param_handles_list = param_handles_of(handle, params)
    let free_names = collect_free_vars(body_node, param_names_list)
    let (captures_names, captures_exprs, captures_handles) =
      resolve_captures_outer(free_names, handle)
    // Per Hβ.first-light.nested-fn-name-discriminator (2026-05-06):
    // query the closest enclosing named-fn BEFORE entering this fn's
    // own frame. Empty string ⇒ top-level (use bare name). Non-empty
    // ⇒ nested (mint <outer>_<inner>). Symmetric with $op_<handler>_<op>
    // — both use semantic prefixes, NOT handle-ints. Reason chain
    // walks back through the qualified name; Why-Engine reads it.
    // Top-level fns keep bare name so `_start → $main` resolves;
    // emit invariant preserved. Drift refused: 1 (no vtable lookup,
    // direct semantic name composition); 8 (the discriminator is a
    // composed name string, not a mode-int); 9 (lands the named
    // peer — symmetric with handler-arm-fn-name-discriminator's
    // third-instance abstraction-earned shape).
    let outer = ls_outer_fn_name()   // drift-audit: ignore — sequenced effectful handler-state read (LowerScope)
    let fn_name = if outer == "" { name }
      else { "{outer}_{name}" }
    ls_enter_frame(
      fn_name,
      param_names_list, param_handles_list,
      captures_names, captures_handles,
      -1   // named fn — not a lambda; the ev READ uses escaping_row(fn_name)
    )
    lower_frame_fence_push()
    // THE CUT (bank A3): a resume-BOUND fn's body lowers under its
    // handler's arm context — resumes inside it take the MultiShot
    // discipline (lower_resume_callk), resolve their k through the
    // evidence tier (resolve_resume_k's RGlobal arm → LEvRef "__resume",
    // threaded by every MultiShot-context caller), commit state through
    // the bracket-scoped singleton (S1), and re-dispatch owned re-yields
    // through $op___redrive_<hname> (M2b). The install is UNCONDITIONAL —
    // an unbound fn carries the boundary install's exact answers ([],
    // OneShot, "") — because a conditional `~>` here poisons the WHEEL'S
    // OWN evidence: boot lowers the install-body's call sites with the
    // lexical __hstate local as their ArmStateContext evidence, and on
    // the unwrapped branch that local is never assigned — every unbound
    // fn's clone shipped an uninitialized record and the callee's keyed
    // scan walked garbage (the probe: rec=89504 — the key's own address —
    // nstate="ArmS" as bytes, fn_idx 0; the rw4 let-arm trap's root).
    let bind_h = ls_resume_bind_of(name)   // drift-audit: ignore — sequenced effectful handler-state read (LowerScope)
    let bind_fields =
      if bind_h == "" { [] }
      else {
        match handler_decl_of(bind_h) {
          Some((config, state, _)) => config ++ state_field_names_of(state),   // drift-audit: ignore — one-shot name-list build
          None => []
        }
      }
    let bind_disc = if bind_h == "" { OneShot } else { MultiShot }
    let lo_body =
      k2_guard(mark_tail({ lower_body_reified(body_node) } ~> arm_state_ctx(bind_fields, bind_disc, bind_h)))   // Hβ.lower.tail-call-mark-pass — fn body is in tail; MultiShot spine → the k1 yield; k2_guard floors off-spine boundaries (M1.3)
    lower_frame_fence_pop()
    ls_exit_frame()
    let fn_ir = LFn(
      fn_name,
      len(params),
      param_names_list,
      [lo_body],
      mk_ef_pure(),   // row resolved live via lookup_ty(handle)
      len(captures_exprs)   // closure fence = capture count
    )
    LLet(handle, name, LMakeClosure(handle, fn_ir, captures_exprs, derive_ev_slots(handle)))
  },

  TypeDefStmt(_name, _variants)             => LConst(handle, LInt(0)),
  EffectDeclStmt(_name, _ops)               => LConst(handle, LInt(0)),
  HandlerDeclStmt(name, _ename, config, state, arms)       => {
    // H1.4: each handler arm becomes a callable wasm function. With
    // the Hβ.first-light.handler-arm-fn-name-discriminator landing,
    // arm fns are named `op_<handler_name>_<op_name>` — unique even
    // when multiple handlers handle the same op (lib/prelude.mn has
    // many handlers all defining `yield`-arms for the Iterate effect).
    // Pre-substrate the unprefixed `op_<op_name>` collided across them.
    // emit_fns_expr's deep walk picks up LDeclareFn entries and emits
    // each as a wasm function with a registered fn_idx global.
    //
    // Per Hβ.first-light.handler-config-state-substrate (2026-05-06):
    // config-params + state-field-names are bound as arm-scope locals
    // before lowering each arm body so their references resolve to
    // captures (config) or state-loads (state). Threaded through
    // lower_handler_arms_as_decls.
    //
    // The handler's (config, state, arms) is in the env's HandlerKind
    // (register_handler), so an install in an earlier-sorted module resolves
    // a handler whose decl follows it, and lower_handler_arms_as_decls reads
    // the arm-name groups for its fence live (handler_decl_of) — order-free
    // with no pre-register pass. Here we only lower the arms to their
    // `op_<handler>_<op>` fn declarations.
    let arm_decls = lower_handler_arms_as_decls(arms, name, config, state)
    LBlock(handle, list_concat(arm_decls, [LConst(handle, LInt(0))]))
  },
  ImportStmt(_module)                       => LConst(handle, LInt(0)),
  RefineStmt(_name, _ty, _pred)             => LConst(handle, LInt(0)),
  // Transparent alias: type-level only, no runtime presence — the alias
  // and its underlying type unify at infer; emit erases (like RefineStmt).
  AliasStmt(_name, _ty)                     => LConst(handle, LInt(0)),

  ExprStmt(expr) => lower_expr(expr)
}

fn lower_stmt_as_expr(s, handle, span) = {
  lower_stmt_body(s, handle, span)
}

// Pattern lowering

fn lower_match_arms(scrut_h, arms) = {
  // ONE scrutinee, ONE license — hoisted out of the per-arm map (the chase
  // is per-value, never per-arm).
  let srep = seq_pat_rep(scrut_h)
  map((arm) => {
  let (pat, body) = arm
  let cp = ls_push_scope()   // drift-audit: ignore — sequenced effectful scope checkpoint (LowerScope)
  bind_pat_locals(pat, lookup_ty(scrut_h))
  let lo_body = lower_expr(body)
  ls_pop_scope(cp)
  // The pattern's value type is the scrutinee's, read live — a tuple pattern
  // resolves its element offsets as the width-summed prefix-sum (the SAME fold
  // tuple construction + index run), not a uniform 4*i. Carried-Truth: the
  // bind/predicate offsets and the construction stores read ONE offset fold.
  (lower_pat_typed(pat, lookup_ty(scrut_h), srep), lo_body)
}, arms)
}

// Bind every `PVar` in the pattern as a local, carrying its element's TYPE
// HANDLE read live from the scrutinee's type — so a String destructure local's
// THE one "handle of a Ty (0 if ground)" projection — read by tparam_handle
// and lower_param_handles (Carried-Truth: one home, N readers, never a
// re-derived copy). A Ty is TVar(handle) only while un-ground; every ground
// type carries no handle, so the 0 sentinel is EXPLICIT per variant, not a
// wildcard that would silently absorb a future Ty. (The env_find self-host
// blocker: handle-0 made `k == name` compare op-key POINTERS, so `==`
// dispatches to str_eq, never pointer i32.eq.) H6: exhaustive Ty enumeration.
fn ty_handle_of(ty) = match ty {
  TVar(handle)        => handle,
  TInt                => 0,
  TFloat              => 0,
  TString             => 0,
  TUnit               => 0,
  TByte               => 0,
  TList(_)            => 0,
  TTuple(_)           => 0,
  TFun(_, _, _)       => 0,
  TName(_, _)         => 0,
  TRecord(_)          => 0,
  TRecordOpen(_, _)   => 0,
  TRefined(_, _)      => 0,
  TCont(_, _, _, _)   => 0,
  TAlias(_, _)        => 0
}

fn bind_pat_locals(pat, ty) = match pat {
  PVar(name) => {
    ls_bind_local(name, ty_handle_of(ty))
    ()
  },
  PCon(_, sub_pats) => bind_pat_locals_floor(sub_pats),
  PTuple(sub_pats)  => match tuple_pat_strip(ty) {
    TTuple(elems) => bind_pat_locals_zip(sub_pats, elems, 0),
    _             => bind_pat_locals_floor(sub_pats)
  },
  PList(sub_pats, rest) => {
    bind_pat_locals_floor(sub_pats)
    bind_pat_rest(rest)
  },
  PRecord(flds)     => bind_pat_locals_fields(flds),
  // Alternation branches bind the same names (the alternation law);
  // the first branch's binds are the arm's. Face 10 — the inner
  // PTuple-match's wildcard fooled the flat census; this outer match
  // had no PAlt arm.
  PAlt(branches)    => bind_pat_locals(list_index(branches, 0), ty),
  PWild             => (),
  PLit(_)           => ()
}

// Each PTuple sub-pattern lands with its element TYPE (read live from the
// stripped TTuple); a String element's local then carries a String-resolving
// handle. Elements past the known list floor to unresolved TVar(0).
fn bind_pat_locals_zip(subs, elems, i) = {
  if i >= len(subs) { () }
  else {
    let elem_ty = if i < len(elems) { list_index(elems, i) } else { TVar(0) }
    bind_pat_locals(list_index(subs, i), elem_ty)
    bind_pat_locals_zip(subs, elems, i + 1)
  }
}

// PCon-payload / PList-element / PRecord-field sub-pattern types are the named
// peer Hβ.lower.bind-handle-typed-subpattern (additive, same TVar->handle
// carry); they floor to TVar(0) = i32.eq, byte-identical to the prior sentinel
// — never a silent wrong type.
fn bind_pat_locals_floor(pats) = each((p) => bind_pat_locals(p, TVar(0)), pats)

fn bind_pat_rest(rest) = match rest {
  None => (),
  Some(name) => {
    if field_name_eq(name, "_") { () }
    else {
      ls_bind_local(name, 0)
      ()
    }
  }
}

fn bind_pat_locals_fields(flds) = each((fld) => {
  let (_, sub_pat) = fld
  bind_pat_locals(sub_pat, TVar(0))
}, flds)

// ─── the sequence-representation chase ──────────────────────────────
//
// seq_rep_of projects the representation the value was BORN with: the
// graph holds the construction (a MakeListExpr is flat, a ++ node is a
// rope, a push call is snoc, a slice call is a view), and the LowerScope
// binding edge (ls_bind_local: name -> the init expression's handle)
// carries it through local lets — no new state, no side-ledger, a pure
// projection over two edges the graph already draws. Joins widen: equal
// reps survive a merge; different reps degrade to SRUnknown, the honest
// floor where the runtime tag branch is genuine information. Params,
// captures, and polymorphic flow read SRUnknown until the spec bracket
// learns to carry rep pairs (the twins' next axis).

// Fuel bounds the descent: a chase step through a binding, a join arm, or
// a block tail spends one, and exhaustion degrades to SRUnknown — always
// sound (the total reader), never a deep tree re-walk per pattern.
fn seq_rep_of(h) = seq_rep_of_fuel(h, 8)

fn seq_rep_of_fuel(h, fuel) = {
  if fuel <= 0 { SRUnknown }
  else {
    match graph_node_body(h) {
      NExpr(MakeListExpr(_))          => SRFlat,
      NExpr(LitString(_))             => SRFlat,
      NExpr(MakeStringExpr(_))        => SRFlat,
      NExpr(BinOpExpr(op, _, _))      => match op { BConcat => SRRope, _ => SRUnknown },
      NExpr(CallExpr(f, _))           => {
        let N(fb, _, _) = f
        match fb {
          NExpr(VarRef(cname)) => seq_rep_of_call(cname),
          _                    => SRUnknown
        }
      },
      NExpr(IfExpr(_, t, e))          => {
        let N(_, _, th) = t
        let N(_, _, eh) = e
        seq_rep_join(seq_rep_of_fuel(th, fuel - 1), seq_rep_of_fuel(eh, fuel - 1))
      },
      NExpr(MatchExpr(_, arms))       => seq_rep_arms(arms, 0, SRUnknown, true, fuel - 1),
      NExpr(BlockExpr(_, final_e))    => {
        let N(_, _, fh) = final_e
        seq_rep_of_fuel(fh, fuel - 1)
      },
      NExpr(VarRef(name))             => {
        let (res, local_h) = ls_resolve(name)
        match res {
          RLocal => if local_h == 0 { SRUnknown } else { seq_rep_of_fuel(local_h, fuel - 1) },
          _      => SRUnknown
        }
      },
      _                               => SRUnknown
    }
  }
}

// The runtime constructors' return representations — the same named set
// is_seq_op already recognizes as the substrate boundary. Anything not in
// the set is the honest unknown (a per-fn rep summary is the
// interprocedural completion).
fn seq_rep_of_call(ref cname: String) =
  if cname == "make_list" { SRFlat }
  else { if cname == "list_to_flat" { SRFlat }
  else { if cname == "push" { SRSnoc }
  else { if cname == "slice" { SRSlice }
  else { if cname == "str_slice" { SRSlice }
  else { SRUnknown } } } } }

fn seq_rep_join(a, b) = if a == b { a } else { SRUnknown }

fn seq_rep_arms(ref arms, i, acc, first, fuel) = {
  if i >= len(arms) { acc }
  else {
    let (_, body) = list_index(arms, i)
    let N(_, _, bh) = body
    let r = seq_rep_of_fuel(bh, fuel)
    seq_rep_arms(arms, i + 1, if first { r } else { seq_rep_join(acc, r) }, false, fuel)
  }
}

// The pattern LICENSE: SRFlat survives only when the element stride is the
// word (a byte-packed or wide-element flat list still needs the total
// reader). A licensed scrutinee's list pattern emits the raw POff loads —
// the exact bytes the pre-PIdx emitter assumed, now proven per receiver.
fn seq_pat_rep(scrut_h) = {
  match seq_rep_of(scrut_h) {
    SRFlat => match seq_elem_stride_word(lookup_ty(scrut_h)) {
      true  => SRFlat,
      false => SRUnknown
    },
    _ => SRUnknown
  }
}

fn seq_elem_stride_word(ty) = match fold_strip(ty) {
  TList(elem) => stride_of(elem) == 4,
  _           => false
}

// lower_pat_typed — pattern lowering carrying the value's PROVEN type, so a
// tuple pattern resolves its element offsets as the width-summed prefix-sum
// (a tuple IS a positional product). The type is read live (chased through
// TVar/alias/refinement); only PTuple consumes it (its element offsets depend
// on element widths). Every other pattern's offsets are type-independent in the
// current substrate (PCon variant-payload + PList use their own const strides —
// the variant-payload-f64 width rides item (b)'s eq/store/bind agreement, a
// named peer at the emit layer; PRecord pre-resolves field offsets), so they
// delegate to lower_pat unchanged (Law 7 byte-identity).
fn lower_pat_typed(pat, ty, srep) = match pat {
  PTuple(sub) => match tuple_pat_strip(ty) {
    TTuple(elems) => LPTuple(lower_pat_tuple_elems(sub, elems, 0, 0)),
    // Not a known tuple type (genuinely-unresolved scrutinee): fall back to the
    // uniform stride — productive-under-error, not a fabricated width.
    _             => LPTuple(lower_pat_tuple_uniform(sub, 0))
  },
  // The scrutinee's proven representation rides the TOP list pattern —
  // nested sequences are reached through elements (rep unknown) and stay
  // on the total reader.
  PList(sub, rest) => LPList(lower_pats(sub), rest, srep),
  _ => lower_pat(pat)
}

// Strip alias/refinement and chase a top-level TVar to its bound type so a
// tuple scrutinee typed as `TVar -> TTuple` resolves to its element list.
fn tuple_pat_strip(ty) with GraphRead = match ty {
  TVar(h)           => match graph_chase(h) {
    GNode(NBound(inner), _) => tuple_pat_strip(inner),
    _                       => ty
  },
  TAlias(_, inner)  => tuple_pat_strip(inner),
  TRefined(base, _) => tuple_pat_strip(base),
  _                 => ty
}

// Each sub-pattern lands at its element's width-summed offset (the SAME
// tuple_elem_offset fold construction + index run) and recurses with its
// element TYPE — so a tuple-of-tuples resolves offsets at every depth.
fn lower_pat_tuple_elems(subs, elems, i, off) = {
  if i >= len(subs) { [] }
  else {
    let elem_ty = if i < len(elems) { list_index(elems, i) } else { TVar(0) }
    let r = repr_of_resolved(elem_ty)
    let here = align_for(off, r)
    [(here, elem_ty, lower_pat_typed(list_index(subs, i), elem_ty, SRUnknown))]
      ++ lower_pat_tuple_elems(subs, elems, i + 1, here + repr_width(r))
  }
}

// Uniform-stride fallback when the tuple's element types are unresolved: 4*i,
// the all-i32 instance (byte-identical to the pre-migration form). The element
// type is TVar(0) — repr_of reads RI32, the word floor the uniform stride uses.
fn lower_pat_tuple_uniform(subs, i) = {
  if i >= len(subs) { [] }
  else {
    [(i * 4, TVar(0), lower_pat(list_index(subs, i)))]
      ++ lower_pat_tuple_uniform(subs, i + 1)
  }
}

fn lower_pat(pat) = match pat {
  PVar(name)       => LPVar(name),
  PWild            => LPWild,
  PLit(v)          => LPLit(lower_lit_value(v)),
  PCon(name, sub)  => {
    // Resolve the constructor's tag_id at lower time. Emit dispatches
    // on the int tag without re-walking the env. A name without an
    // env entry (already a missing-var diagnostic from infer) gets
    // tag = -1; emit treats that arm as never-match.
    match env_kind_of(name) {
      Some(ConstructorScheme(t, _)) => LPCon(name, t, lower_pats(sub)),
      Some(RecordSchemeKind(_)) =>
        // Nominal-record pattern `Pri(pa)`: the runtime value IS the bare
        // record (no tag word) — the ctor wrapper is the identity in
        // pattern position exactly as in construction (the call-form arm
        // above). The single sub-pattern matches the scrutinee itself:
        // always-match, no tag test, the record layout untouched. The
        // BARE spelling `Pri =>` carries no sub-pattern — it matches any
        // value of the type and binds nothing: LPWild (face 12 — the
        // unguarded list_index read garbage and fed a non-LowPat to
        // emit's walk_locals).
        if len(sub) == 0 { LPWild } else { lower_pat(list_index(sub, 0)) },
      _ => LPUnresolvedCon(name, lower_pats(sub))
    }
  },
  PTuple(sub)      => LPTuple(lower_pat_tuple_uniform(sub, 0)),
  PList(sub, rest) => LPList(lower_pats(sub), rest, SRUnknown),
  PRecord(flds)    => LPRecord(lower_pat_record_fields(flds, 0)),
  PAlt(branches)   => LPAlt(lower_pats(branches))
}

// Pattern fields are sorted-by-name (parser invariant); position
// IS the byte offset (`4 * index`) per `LMakeRecord`'s untagged layout.
// No tag prefix to skip — offset 0 is the first field.
fn lower_pat_record_fields(flds, base) = map((indexed) => {
  let (i, fld) = indexed
  let (name, sub_pat) = fld
  (name, (base + i) * 4, lower_pat(sub_pat))
}, enumerate(flds))

fn lower_lit_value(v) with Pure = match v {
  LVInt(n)    => LInt(n),
  LVFloat(f)  => LFloat(f),
  LVString(s) => LString(s),
  LVBool(b)   => LBool(b)
}

fn lower_pats(pats) = map(lower_pat, pats)

// H1.4 — lower handler arms to `LDeclareFn` entries: pure module-level
// fn declarations, no runtime allocation. Each arm body becomes a wasm
// function `op_<op_name>` taking the arm's args (plus the implicit
// `__state` per the calling convention). Stateful handlers (with state
// slots) land with H1.6's evidence wiring.
fn lower_handler_arms_as_decls(arms, discriminator, config, state) = {
  // The arm fn's __state IS the handler record [_, nstate FENCE, state..,
  // arms.., evs..]; its captured-ev region starts past state AND arms, so
  // fence = nstate + total_arms — summed from the SAME registered arm-name
  // groups the install's emit lays the arms by (the two sides agree by
  // construction). Inline handle-exprs have no decl in env → 0 arms.
  let nstate = len(config) + len(state)
  let fence = nstate + sum_group_arm_lens(lookup_handler_arm_names_of(discriminator))
  // Open the arm-body evidence ledger: Tier-2 performs in the arm bodies
  // record their effects (first-encounter order); the indices ARE the
  // captured-ev slots the install writes after the arms.
  arm_ev_begin()
  let decls = map((arm) => lower_one_arm_decl(arm, discriminator, config, state, fence), arms)
  arm_ev_end(discriminator)
  decls
}

fn lower_one_arm_decl(arm: {args: [String], body: Node, op_name: String}, discriminator, config, state, fence) = {
  let fn_name = "op_{discriminator}_{arm.op_name}"
  // Hβ.first-light.arm-body-fresh-frame: each handler-arm body is
  // its own WASM function with __state IS the handler state record
  // (per protocol_handler_is_state_is_closure_is_evidence.md). The
  // arm body needs a FRESH frame so state-field references (e.g.
  // `frames`, `globals`) resolve to LUpval(0..N-1), emitting
  // `(local.get $__state)(i32.load offset=8 + idx*4)` — the
  // canonical closure-record layout.
  //
  // captures_names = config_names ++ state_field_names (sources
  // for closure-record slots at install time). args go as locals
  // (arm fn params at WASM call-arity). zero handles per
  // bind_names_as_locals convention.
  let config_names = config
  let state_field_names = state_field_names_of(state)
  let captures_names = config_names ++ state_field_names
  let captures_handles = zeros_of_len(len(captures_names))
  // The cardinality, PROJECTED off the op's EffectOpScheme — inference wrote
  // it (draw_op_edges joined every handler arm's resume_grade); lower reads
  // the proven fact live, the way it reads repr off a type or world off a
  // row. Read BEFORE the frame: a MultiShot arm's signature carries the k
  // record as its leading param (the driver pushes (record, k); resume(v)
  // calls __k — band B k1). OneShot arms keep their params, arity, and
  // fence byte-identically (Law 7).
  let disc = op_resume_discipline(arm.op_name)
  let arm_params = match disc {
    MultiShot => ["__k"] ++ arm.args,
    Abandon   => ["__k"] ++ arm.args,   // M4 — the driver pushes (record, k) uniformly; an Abandon arm takes __k and ignores it (it never resumes), returning its value flag-clear so the driver delivers it as the install's
    _         => arm.args
  }
  let locals_handles = zeros_of_len(len(arm_params))
  ls_enter_frame(
    fn_name,
    arm_params, locals_handles,
    captures_names, captures_handles,
    -1   // handler arm — not a lambda; the ev READ uses the arm's captured set / escaping_row
  )
  lower_frame_fence_push()
  // Hβ.first-light.resume-with-state-mutation: install arm_state_ctx
  // around arm body lowering so lower_expr's ResumeExpr arm resolves
  // `with field = NEW` updates' slot offsets via current_state_fields()
  // AND its representation via current_resume_discipline().
  let lo_body = k2_guard(mark_tail({ lower_expr(arm.body) } ~> arm_state_ctx(captures_names, disc, discriminator)))   // Hβ.lower.tail-call-mark-pass — handler arm body is in tail; k2_guard floors off-spine boundaries (M1.3)
  lower_frame_fence_pop()
  ls_exit_frame()
  // fence = nstate + total_arms; the arm's LEvPerform reads land on the
  // record's captured-ev region (past state AND arms).
  let fn_ir = LFn(fn_name, len(arm_params), arm_params, [lo_body], mk_ef_pure(), fence)
  LDeclareFn(fn_ir)
}

// Sum each effect-group's arm-list length — the handler record's total
// arm-slot count, contiguous per effect.
fn sum_group_arm_lens(groups: [{arms: [String], ename: String}]) = fold(0, (acc, g) => acc + len(group_arms(g)), groups)

// Extract just the `name` field from each state-fields record.
// Per parse_handler_state_fields, each entry is `{name, init}`.
fn state_field_names_of(state: [{init: Node, name: String}]) = map(state_field_name, state)

// state_field_name / state_field_init live at the record's mint
// (parser.mn, beside parse_handler_state_fields) — one home per truth.

// Lower each state-field's init expression to LowExpr in source order.
// The returned list[i] is the LowExpr for the i-th state field's init.
// emit_lhandlewith stores list[i] at offset 8 + i*4 of the freshly-
// allocated state record at handler-install per
// protocol_handler_is_state_is_closure_is_evidence.md.
//
// `with field = init` is written in the scope of the handler's config
// params. When the init IS exactly a config-arg reference, the state slot
// reads that config slot of the SAME handler record (config is written
// first) — LUpval(config_slot), which emit reads record-relative. Handler
// IS state IS closure IS evidence: one record reading itself, resolved
// STRUCTURALLY (the config slot is known by name — carried truth, not
// re-derived) rather than via a frame the install must thread evidence
// for. Other inits (literals, `make_list(16)`, `0`) lower normally.
// A config ref nested inside a larger expression (`acc = init + 1`) is a
// peer: it needs the config-capture frame, which needs evidence-complete
// effect propagation through the ~> install chain; the wheel has none.
fn lower_state_field_inits(config, state) =
  map((field) => lower_state_init(config, field), state)

fn lower_state_init(config, field: {init: Node, name: String}) = {
  let N(body, _, _) = field.init
  match body {
    NExpr(VarRef(name)) => {
      let slot = index_of_name(config, name, 0)
      if slot >= 0 { LUpval(0, slot) } else { lower_expr(field.init) }
    },
    _ => lower_expr(field.init)
  }
}

// Build a list of n zero handles. Used as the handle-list for arm
// captures and locals where lower-time has no type-handle info.
fn zeros_of_len(n) = map((_) => 0, range(0, n))

fn bind_names_as_locals(names) = {
  // Handler-arm args don't carry separate type handles at lower
  // time; the op's signature gives them inferentially. 0 is the
  // sentinel — capture-handle correctness here is bounded by
  // future reach into op-arg type plumbing (Phase D evidence).
  each((name) => ls_bind_local(name, 0), names)
}

// OneShot resume — the zero-cost stack return, byte-identical to the
// pre-producer floor. No state updates: the value flows straight to
// LReturn (~85% of arms). With updates: the snapshot writeback, reading
// the enclosing arm's state-fields live from the ArmStateContext handler.
fn lower_resume_oneshot(handle, val, state_updates) = {
  if len(state_updates) == 0 {
    LReturn(handle, lower_expr(val))
  } else {
    let fields = current_state_fields()   // drift-audit: ignore — sequenced effectful handler-state read (LowerScope)
    lower_resume_snapshot(handle, val, state_updates, fields)
  }
}
// The OneShot commit's record home: the arm's own $__state ("" — the
// byte-frozen pre-S1 form; a OneShot resume lowers in the arm frame where
// $__state IS the install record).

// ── MultiShot: the reified k (band B k1, continuation-reification codegen) ──
//
// A MultiShot perform never calls the arm — the PERFORMING FRAME yields: its
// remainder-after-the-perform reifies as the continuation record k (handler =
// state = closure = evidence = CONTINUATION, one shape), the install's driver
// binds k to the arm, and resume(v) CALLS the record — N times, it is
// immutable data. The prior producer (deleted here) reified the WRONG side:
// k minted at the RESUME site from the arm's snapshot prologue — the arm
// bound record POINTERS to a/b and nothing ever called them (the measured
// invalid-exit). The capture/world recipe it carried lives on below, at the
// correct side (the perform's frame).

// resume(v) in a MultiShot arm = call the k record through the W7 closure
// convention (park k, push k as __state, push v, call_indirect fn_ptr@0).
// The post-call flag check (band B M2b — the owned-op re-dispatch, the
// twice-refuted correction of the bank's "driver re-entry" sketch, which
// ABANDONED the outer arm): a raised flag means the remainder yielded
// again mid-resume. An OWNED op re-enters this handler's own dispatch —
// $op___redrive_<hname>, the install driver's loop factored to ONE home —
// and the dispatched arm's return IS this resume's value (the deep-handler
// equation handle(E[perform]) = arm(k = λv. handle(E[v])), independently
// re-derived: pick()+pick()*10 under twice = 66, never the abandonment's
// 32). A FOREIGN op still flagged after the redrive keeps the LOUD floor
// (arm-remainder composition is A4/M3 territory). With state updates (band
// B M1.5, bank Ruling 4): the SAME commit prefix OneShot uses — snapshot,
// then the slot stores COMMIT — runs BEFORE the k-call, and the k-call
// takes the SNAPSHOTTED val local (the ev8d race). One prefix, two tails.
fn lower_resume_callk(handle, val, state_updates) = {
  let kr = "__kr_{int_to_str(handle)}"
  let kr2 = "__kr2_{int_to_str(handle)}"
  let hname = current_arm_handler()   // drift-audit: ignore — sequenced effectful arm-context read (LowerScope)
  let (prefix, val_name) =
    if len(state_updates) == 0 { ([], "") }
    else {
      let fields = current_state_fields()   // drift-audit: ignore — sequenced effectful handler-state read (LowerScope)
      // The MultiShot commit's record home is the bracket-scoped singleton
      // $<hname>_state_g — the SAME record as the arm's $__state at arm
      // level (the bracket set it), and the ONLY reachable home inside a
      // closure (whose own $__state is its closure record — the measured
      // 32-not-46 silent state loss, S1's unmasking gate).
      resume_commit_prefix(handle, val, state_updates, fields, hname)
    }
  let val_lo =
    if len(state_updates) == 0 { lower_expr(val) }
    else { LLocal(handle, val_name) }
  LBlock(handle, prefix ++ [
    LLet(handle, kr, LCall(handle, resolve_resume_k(handle), [val_lo])),
    LLet(handle, kr2,
      LIf(handle, LGlobal(handle, "yield_flag"),
          [LBlock(handle, [
            LLet(handle, "__rd_{int_to_str(handle)}",
                 LPerform(handle, "__redrive_{hname}", [LLocal(handle, kr)], "")),
            // The redrive LOOPS this handler's OWN ops (dispatch-until-clear),
            // so a flag STILL raised after it is a FOREIGN op — M4 made abort
            // an Abandon yield, so a resumed continuation that aborts bubbles
            // its yield back through here (backtrack's try-fn resume feeding
            // my_catch). It must PROPAGATE to the enclosing driver, NOT floor:
            // __rd (a flagged dummy) flows up with the flag intact, the
            // caller's driver/composer catches it, and a genuinely-unhandled
            // foreign op still traps LOUDLY at the _start backstop. Flooring
            // here (the pre-M4 form) trapped the legitimate foreign crossing.
            LLocal(handle, "__rd_{int_to_str(handle)}")
          ])],
          [LLocal(handle, kr)])),
    LLocal(handle, kr2)
  ])   // drift-audit: ignore — one-shot stmt-list concat, no loop
}

// The resume-resolution LADDER (band B M1.6, bank Ruling 2 as amended by
// A3) — the k channel mirrors the perform's dispatch gradient exactly:
//   lexical  — "__k" is the arm's own leading param (the k1 fast path,
//              KEPT; arm params bind handle 0, so the node handle carries
//              the type — byte-identical to the pre-ladder form).
//   capture  — "__k" was captured into this lambda's record (the
//              ResumeExpr free-vars arm reports it; resolve_captures_outer
//              threaded it) — the LUpval read, N frames deep.
//   evidence — the "__resume" keyed entry (delimited-continuation
//              semantics: the nearest enclosing prompt), threaded by the
//              MultiShot arm's sst_ clone at its interior effectful call
//              sites. THE WRITER LANDS AT THE CUT (A3: the capability mark
//              — pre-cut it would change wheel bytes); until then this
//              tier is unreachable (a called-fn resume lowers OneShot
//              under the classifier gap), and an early arrival meets the
//              strict keyed scan's LOUD miss, never a silent dummy.
fn resolve_resume_k(handle) = {
  let (res, lh) = ls_resolve("__k")
  match res {
    RLocal       => LLocal(if lh == 0 { handle } else { lh }, "__k"),
    RUpval(slot) => LUpval(if lh == 0 { handle } else { lh }, slot),
    RFbPrior(_)  => LEvRef(handle, "__resume"),
    RGlobal      => LEvRef(handle, "__resume")
  }
}

// The k1 SPINE: the position that evaluates FIRST in the frame body — a
// MultiShot op call of ANY arity (band B M1.4 lifted the argless gate; the
// args ride the yield as the $yield_args packet, evaluated in the frame
// before the unwind), possibly wrapped in a left-BinOp chain or a
// statement-free brace block. op-ness + cardinality are ONE env read
// (op_resume_discipline returns MultiShot only for a genuine MultiShot op;
// every non-op floors OneShot).
fn ms_op_of_call(node) = {
  let N(b, _, _) = node
  match b {
    NExpr(CallExpr(f, args)) => {
      let N(fb, _, _) = f
      match fb {
        NExpr(VarRef(name)) =>
          match op_resume_discipline(name) {
            MultiShot => Some((name, args)),
            _         => None
          },
        _ => None
      }
    },
    _ => None
  }
}

// THE AGREEMENT LAW: the spine TESTER (k_spine_next — k1 performs, run
// OUTSIDE the k frame and again INSIDE each reified level), the
// call-boundary tester (k2_spine_call), the containment probe
// (k_subs_inside), the triviality probe (k_trivial), and the ONE remainder
// BUILDER (k_remainder) all walk the SAME spine grammar — bare position,
// BinOp with left-descent-or-trivial-left-right-descent, statement-free
// block, and (k2) PForward-left + the bare-VarRef pipe stage. Keep them
// adjacent; a form added to one without the others is the
// free_in_ty/subst_ty divergence bug at the split.

// The FIRST MultiShot perform on the extended spine, skipping positions
// already substituted (band B M2a). The extension over the k1 grammar: a
// BinOp whose LEFT is pure-and-trivial lets the spine descend RIGHT — so a
// second perform in a k remainder (`hole1 + pick2*10`) is a REAL nested
// yield site, at any depth (the depth-3 gate: `(h1*h2)*pick3` descends
// through two trivial hole reads).
fn k_spine_next(node, subs) = {
  match k_sub_for(subs, node) {
    Some(_) => None,
    None => match ms_op_of_call(node) {
      Some((op, args)) => {
        let N(_, _, ph) = node
        Some((op, ph, args))
      },
      None => {
        let N(b, _, _) = node
        match b {
          NExpr(BinOpExpr(_, l, r)) =>
            match k_spine_next(l, subs) {
              Some(hit) => Some(hit),
              None      => if k_trivial(l, subs) { k_spine_next(r, subs) } else { None }
            },
          NExpr(BlockExpr(stmts, final)) =>
            if len(stmts) == 0 { k_spine_next(final, subs) } else { None },
          _ => None
        }
      }
    }
  }
}

// Pure-and-trivial given the live substitution points: re-evaluable inside
// a k with zero effects — a hole read, a literal, a value VarRef (every
// Mentl local is an immutable binding; a global name in value position is
// a pure read), and arithmetic over those. A call or perform is never
// trivial (the A-H4 ruling: VarRefs are exactly as pure as literals, and
// their captures are the part of the recipe that already works).
fn k_trivial(node, subs) = {
  match k_sub_for(subs, node) {
    Some(_) => true,
    None => {
      let N(b, _, _) = node
      match b {
        NExpr(LitInt(_))            => true,
        NExpr(LitFloat(_))          => true,
        NExpr(LitBool(_))           => true,
        NExpr(LitString(_))         => true,
        NExpr(LitUnit)              => true,
        NExpr(VarRef(_))            => true,
        NExpr(BinOpExpr(_, l, r))   => k_trivial(l, subs) && k_trivial(r, subs),
        NExpr(UnaryOpExpr(_, x))    => k_trivial(x, subs),
        _                           => false
      }
    }
  }
}


// The k2 spine: the first-evaluated position chain, descended for a
// CAN-YIELD CALL boundary (band B M1.3, the bank Ruling 5). Returns the
// DEEPEST boundary — the first yield to cross at runtime. Two boundary
// shapes this increment: a direct call with a trivial (VarRef, non-op)
// callee, and a `|>` stage whose right is a bare VarRef (the :bare-value
// completion — its LSuspend carries the PIPE node's handle, so the check
// wrap and the mint agree on the key by construction). A PTee is a
// BOUNDARY, never descended — the install's driver guards its body; the
// composition that crosses an install is A4's re-install-in-k (its
// crucible mn-resume-across-install arbitrates, M2). Off-spine can-yield
// calls are NOT silent: k2_floor_guard wraps them with the loud floor.
fn k2_spine_call(node) = {
  let N(b, _, _) = node
  match b {
    NExpr(BinOpExpr(_, l, _))      => k2_spine_call(l),
    NExpr(BlockExpr(stmts, final)) =>
      if len(stmts) == 0 { k2_spine_call(final) } else { None },
    NExpr(PipeExpr(kind, l, r))    => match kind {
      PForward => match k2_spine_call(l) {
        Some(deeper) => Some(deeper),
        None         => {
          let N(rb, _, rfh) = r
          match rb {
            NExpr(VarRef(_)) => if can_yield(rfh) { Some(node) } else { None },
            _                => None
          }
        }
      },
      _ => None
    },
    NExpr(CallExpr(f, args))       => {
      let N(fb, _, fh) = f
      match fb {
        NExpr(VarRef(name)) =>
          // An effect op is k1's business (its MultiShot form yields at the
          // perform itself); a k2 boundary is an ordinary CALL whose callee
          // may carry a yield out.
          if lower_effect_name_of_op(name) == "" && can_yield(fh) { Some(node) }
          // M4 — the callee doesn't yield, but an ARG might: the first
          // can-yield arg is the boundary (`Some(risky())`). ONLY for a
          // CONSTRUCTOR callee — k_remainder can rebuild the variant with
          // the arg substituted, but a FN-call remainder (evidence, arity)
          // is unbuilt (Hβ.lower.k2-remainder-fncall), so descending there
          // would floor a genuine yield AND mis-reify an over-approximated
          // can-yield arg (parse `at`'s `kind_eq(_, token_kind_at())` — the
          // m3-trap the divergence pinner caught). A fn-call arg's yield
          // stays k2_floor_guard's business (floored off-spine, loud).
          else if callee_is_constructor(name) { k2_spine_in_args(args, 0) }
          else { None },
        _ => None
      }
    },
    _ => None
  }
}

// M4 — is this name a value CONSTRUCTOR (an ADT variant, `Some`/`Branch`)?
// The env's ConstructorScheme is the one truth (the same read lower_expr
// dispatches construction on); a fn / effect-op / unknown name is not.
fn callee_is_constructor(name) = match env_lookup(name) {
  Some(entry) => {
    let (_, _, kind) = entry
    match kind { ConstructorScheme(_, _) => true, _ => false }
  },
  None => false
}

// M4 — find the first can-yield ARG (evaluation order left-to-right). An
// arg carrying a k2 boundary IS the boundary; a TRIVIAL arg (literal /
// VarRef, re-evaluable in the remainder) passes through to the next; a
// non-trivial non-yielding prefix arg cannot be re-evaluated in the k, so
// it floors (Hβ.lower.k2-nontrivial-prefix-arg — the crucibles are
// single-arg `Some(call)`, no prefix).
fn k2_spine_in_args(args, i) =
  if i >= len(args) { None }
  else {
    let arg = list_index(args, i)
    match k2_spine_call(arg) {
      Some(hit) => Some(hit),
      None      => if k_trivial(arg, []) { k2_spine_in_args(args, i + 1) } else { None }
    }
  }

// The substitution for a node, by handle identity. subs = [(ph, read_lo)]
// — the innermost hole reads the k fn's own param, an enclosing level's
// hole reads its CAPTURE (built inside the entered frame, k_hole_read), a
// nested spine perform substitutes its whole LYield, and the inline
// residency reads the parked __kr local. One environment, four read kinds.
fn k_sub_for(subs, node) = {
  let N(_, _, h) = node
  let hits = filter(((ph, _)) => ph == h, subs)
  if len(hits) == 0 { None }
  else {
    let (_, read) = head(hits)
    Some(read)
  }
}

// Does any substitution point sit inside this subtree? Over the spine
// grammar's reachable positions only (a sub ph is a spine node by
// construction; handles are unique, so both-sides BinOp descent
// over-approximates nothing).
fn k_subs_inside(node, subs) = {
  match k_sub_for(subs, node) {
    Some(_) => true,
    None => {
      let N(b, _, _) = node
      match b {
        NExpr(BinOpExpr(_, l, r))      => k_subs_inside(l, subs) || k_subs_inside(r, subs),
        NExpr(BlockExpr(stmts, final)) =>
          if len(stmts) == 0 { k_subs_inside(final, subs) } else { false },
        NExpr(PipeExpr(_, l, _))       => k_subs_inside(l, subs),
        NExpr(CallExpr(_, args))       => any((a) => k_subs_inside(a, subs), args),   // M4 — a sub inside a constructor/call arg (the `Some(call)` boundary)
        _                              => false
      }
    }
  }
}

// Build the remainder-with-substitutions (band B M2a — the hole-SET form;
// the single-hole (ph, name) pair could not express a nested k's TWO live
// holes, and a same-named param SHADOWED the outer hole's capture: the
// diagonal-substitution refutation). Untouched subtrees lower ONCE via
// lower_expr (the containment probe keeps single-lowering); a substitution
// point inside an off-grammar subtree is the LOUD floor — with multiple
// live holes a fabricated identity read is a silent wrong VALUE, never a
// trap, so the fallback refuses (the A-H3 ruling).
fn k_remainder(node, subs) = {
  match k_sub_for(subs, node) {
    Some(read) => read,
    None =>
      if !k_subs_inside(node, subs) { lower_expr(node) }
      else {
        let N(b, _, h) = node
        match b {
          NExpr(BinOpExpr(op2, l, r)) =>
            LBinOp(h, op2, k_remainder(l, subs), k_remainder(r, subs)),
          NExpr(BlockExpr(_, final))  => k_remainder(final, subs),
          NExpr(PipeExpr(_, l, r))    => lower_pipe_complete(k_remainder(l, subs), r, h),
          // M4 — a boundary inside a CONSTRUCTOR arg (`Some(risky())`): the
          // remainder is the variant rebuilt with the arg substituted. The
          // tag is read LIVE from the ConstructorScheme (never re-derived).
          // A fn-CALL boundary reconstruction (evidence, arity resolution)
          // is the named floor Hβ.lower.k2-remainder-fncall — loud, unbuilt.
          NExpr(CallExpr(f, args)) => {
            let N(fbody, _, _) = f
            match fbody {
              NExpr(VarRef(name)) =>
                match env_lookup(name) {
                  Some((_, _, ConstructorScheme(tag, _))) =>
                    LMakeVariant(h, tag, map((a) => k_remainder(a, subs), args)),
                  _ => LYield(h, "", [], LConst(h, LInt(0)))
                },
              _ => LYield(h, "", [], LConst(h, LInt(0)))
            }
          },
          _ => LYield(h, "", [], LConst(h, LInt(0)))
        }
      }
  }
}

// An enclosing level's hole, read INSIDE the entered k frame: the name is
// a local of the enclosing k frame (its param), so it resolves RLocal one
// frame up = a CAPTURE here (RUpval). A hole name that resolves nowhere is
// a walker-divergence bug — the loud floor, never a fabricated read.
fn k_hole_read(ph, name) = {
  let (res, lh) = ls_resolve(name)
  match res {
    RLocal       => LLocal(if lh == 0 { ph } else { lh }, name),
    RUpval(slot) => LUpval(if lh == 0 { ph } else { lh }, slot),
    RFbPrior(_)  => LYield(ph, "", [], LConst(ph, LInt(0))),
    RGlobal      => LYield(ph, "", [], LConst(ph, LInt(0)))
  }
}

// The per-level hole name. Per-SITE, never shared: a shared "__resume_in"
// made every nested k's param SHADOW its ancestors' holes (LLocal emits by
// NAME), silently substituting the diagonal — the refuted form.
fn k_hole_name(ph) = "__resume_in_{int_to_str(ph)}"

// Reify a frame's remainder-after-ph as the continuation record (band B
// k1/M2a — the recursive hole-set form): the k fn's captures resolve in
// the ENCLOSING frame (prefix locals become capture loads, outer upvals
// re-capture; the LambdaExpr recipe verbatim, ONE mechanism four roles),
// with the ENCLOSING LEVELS' hole names SEEDED into the free set — the
// AST at those positions is still the perform call (its only free name is
// the op, RGlobal-fenced), so the walk alone can never surface them (the
// diagonal refutation's root). A further MultiShot perform on this
// remainder's extended spine reifies RECURSIVELY: its k captures this
// level's hole through the same seeded recipe; its yield substitutes
// mid-expression at the OP node's own width (never the frame's), minted
// only when this k RUNS — fresh per call, live captures. state_idx /
// ret_slot stay the spine-site handle; world_tag = the canonical row's
// union-homomorphic bitmask (W06). Shared by the k1 yield producer and
// the k2 boundary composition — one reifier.
fn reify_frame_k(body_node, ph, outer_holes) = {
  match continuation_boundary_at(ph) {
  Ok(edge) => reify_frame_k_at(body_node, ph, outer_holes, edge),
  Err(invariant) => LInvariantFailure(ph, invariant)
  }
}

fn reify_frame_k_at(body_node, ph, outer_holes, edge) = {
  let ContinuationEdge(resume_input_h, answer_h, continuation_h, disc, world) = edge   // drift-audit: ignore — positional destructure/construction of the ONE BoundaryEdge/ContinuationEdge record — the record exists; these are its named fields, not parallel arrays
  let hole = k_hole_name(ph)
  let free_names = free_vars_merge(map(((_, n)) => n, outer_holes),
                                   collect_free_vars(body_node, [hole]))
  let (captures_names, captures_exprs, captures_handles) =
    resolve_captures_outer(free_names, ph)
  ls_enter_frame("", [hole], [resume_input_h], captures_names, captures_handles, continuation_h)
  lower_frame_fence_push()
  let subs = map(((p, n)) => (p, k_hole_read(p, n)), outer_holes)
             ++ [(ph, LLocal(resume_input_h, hole))]   // drift-audit: ignore — one-shot env build, no loop
  let subs2 = match k_spine_next(body_node, subs) {
    None => subs,
    Some((op2, ph2, args2)) => {
      let lo_args2 = map(lower_expr, args2)
      let nested = reify_frame_k(body_node, ph2, outer_holes ++ [(ph, hole)])   // drift-audit: ignore — one-shot env build, no loop
      // Every spine perform BEYOND ph2 is DEAD in this residency — a
      // MultiShot perform always yields, so control never passes ph2 here;
      // each deeper level substitutes its own real yield (the depth-3
      // gate's lesson: lowering it inline floored a position no execution
      // can reach). The dummy is an i32 word; a float-result op chain
      // meets the loud assembly mismatch (the compose-width-floor family).
      k_deaden_rest(body_node,
        subs ++ [(ph2, LYield(ph2, op2, lo_args2, nested))])   // drift-audit: ignore — one-shot env build, no loop
    }
  }
  let k_body = k2_floor_guard(mark_tail(k_remainder(body_node, subs2)), false)
  lower_frame_fence_pop()
  ls_exit_frame()
  let k_fn = LFn("__k_{int_to_str(ph)}", 1, [hole], [k_body],
                 world, len(captures_exprs))
  if disc == MultiShot {
    LMakeContinuation(continuation_h, k_fn, captures_exprs,
                      derive_ev_slots(continuation_h),
                      ph, resume_input_h, world_tag_of_row(world))
  } else {
    report(EResumeWorldMismatch(disc, MultiShot, span_zero()))
    LInvariantFailure(ph, NonMultiShotContinuation(disc))
  }
}

fn continuation_boundary_at(site_h) = match graph_boundary_at(site_h) {
  ContinuationBoundary(edge) => Ok(edge),
  PendingContinuationBoundary(_, _, continuation_h, _) => {
    report(EUnresolvedType(continuation_h, graph_epoch(), parse_span_of(continuation_h)))
    Err(UnfinalizedContinuationBoundary(continuation_h))
  },
  FanoutBoundary(_) => {
    report(EUnresolvedType(site_h, graph_epoch(), parse_span_of(site_h)))
    Err(WrongContinuationBoundaryKind)
  },
  NoBoundary => {
    report(EUnresolvedType(site_h, graph_epoch(), parse_span_of(site_h)))
    Err(MissingContinuationBoundary)
  }
}

// Substitute every remaining spine perform with a dead dummy word — the
// positions a MultiShot yield upstream makes unreachable in THIS residency.
// Terminates: each step adds a substitution at a fresh handle and the walk
// skips substituted positions.
fn k_deaden_rest(body_node, subs) = match k_spine_next(body_node, subs) {
  None => subs,
  Some((_, ph_dead, _)) =>
    k_deaden_rest(body_node, subs ++ [(ph_dead, LConst(ph_dead, LInt(0)))])   // drift-audit: ignore — bounded by the body's perform count, not a hot loop
}

// Lower a frame body with continuation reification. THREE arms, priority
// ordered (runs INSIDE the enclosing frame — FnStmt / LambdaExpr / PTee
// install-body — upstream of tier selection, so the lexical and singleton
// tiers cannot bake an arm call for a spine perform):
//   k1 — a MultiShot perform on the (extended) spine: the WHOLE body
//        becomes the yield (its remainder reified as k, nested performs
//        reified recursively); the frame's value IS the yield's dummy, so
//        the unwind is pure dataflow.
//   k2 — a can-yield CALL on the spine (band B M1.3, Ruling 5): the DUAL
//        RESIDENCY check — the call runs inline and parks width-honest in
//        __kr_<ph> (llet_repr reads the call's own type); a raised
//        $yield_flag composes the reified remainder onto the unwinding k
//        (LKExtend → $__k_extend, $yield_op untouched) and the frame's
//        width-honest dummy flows out through the SAME value position the
//        fast path uses (no control transfer — correct inside install
//        bodies, where a return would skip the driver bracket); a clear
//        flag runs the SAME remainder inline with the parked result (the
//        one walker, the parked-local substitution — "the check block
//        holds both").
//   else — verbatim lowering (the byte-identical path, Law 7).
fn lower_body_reified(body_node) =
  match k_spine_next(body_node, []) {
    Some((op_name, ph, arg_nodes)) => {
      let N(_, _, frame_h) = body_node
      // The op's args evaluate at the yield site, in the ENCLOSING frame —
      // the already-computed prefix; the k's hole replaces the whole
      // perform call, so the remainder never re-evaluates them.
      let lo_args = map(lower_expr, arg_nodes)
      LYield(frame_h, op_name, lo_args, reify_frame_k(body_node, ph, []))
    },
    None => match k2_spine_call(body_node) {
      Some(spine_node) => {
        let N(_, _, frame_h) = body_node
        let N(_, _, ph) = spine_node
        let kr = "__kr_{int_to_str(ph)}"
        let c_inline = k_remainder(body_node, [(ph, LLocal(ph, kr))])
        match c_inline {
          // Identity remainder: the boundary IS the frame tail — the flag
          // propagates through the frame's own return (mark_tail keeps the
          // return_call), and the caller's check (or the driver, or the
          // composer) is the boundary. No wrap, no reification.
          LLocal(_, _) => lower_expr(body_node),
          _ => LBlock(frame_h, [
            LLet(ph, kr, lower_expr(spine_node)),
            LIf(ph, LGlobal(ph, "yield_flag"),
                [LKExtend(frame_h, reify_frame_k(body_node, ph, []))],
                [c_inline])
          ])
        }
      },
      None => lower_expr(body_node)
    }
  }

// ─── band B M1.3 — the invariant walk (Ruling 5's last sentence) ─────────
// "EVERY non-tail can-yield call site carries the check, else a frame
// computes on the dummy." The spine split composes the boundary it can
// express; THIS walk makes every remaining one LOUD: a non-tail can-yield
// LSuspend off the spine parks its result and traps at a raised flag (the
// comment-marked yield floor — censusable, never a silent dummy). Skips,
// each a real boundary elsewhere:
//   tail == true            — return_call propagates; the CALLER's check
//                             (or driver, or composer) is the boundary.
//   terminus of an install  — the driver loop right after the body IS the
//     body                    check (owned op → dispatch; foreign → the
//                             parked dummy + flag exit the bracket to the
//                             enclosing check). Wrapping here would trap
//                             every owned yield before its own driver.
//   under LReturn           — the fn's exit is the propagation the caller
//                             checks; a wrap would trap a legitimate unwind.
//   a "__kr_" park          — the spine split's own composed check; its
//                             CHILDREN still walk (an off-spine suspend
//                             inside the parked call's args must floor).
//   LFn bodies              — frame boundaries; each frame guards itself
//                             (the four seams + reify_frame_k).
// The terminus flag propagates exactly where a value position propagates:
// block-last, if-branches, match-arm bodies — the same spine mark_tail
// walks, here for the install driver's sake rather than return_call's.
// The per-seam entry: a program with no MultiShot-graded op cannot yield,
// so the walk is skipped whole — the pre-cut wheel pays zero rebuild and
// keeps byte-identity by construction (Law 7).
fn k2_guard(e) = if ls_program_may_yield() { k2_floor_guard(e, true) } else { e }

// M4 — does the install body's TERMINUS yield a FOREIGN op (one this handler
// does not cover)? Walks only the value-propagating positions (a yield, a
// block's last, an if/match branch, a k2 boundary's dummy path) — NOT into
// calls or fn bodies (separate frames whose yields are their own concern).
// A foreign terminus yield means the driver bubbles it but the enclosing
// remainder is not in the k → the install is not guarded for that crossing.
fn body_has_foreign_yield(e, hname) = match e {
  LYield(_, op, _, _) =>
    op != "" && !handler_covers_effect(hname, lower_effect_name_of_op(op)),
  LBlock(_, stmts)      => len(stmts) > 0 && body_has_foreign_yield(last(stmts), hname),
  LIf(_, _, t, el)      =>
    (len(t) > 0 && body_has_foreign_yield(last(t), hname))
    || (len(el) > 0 && body_has_foreign_yield(last(el), hname)),
  LMatch(_, _, arms)    => any((pb) => { let (_, body) = pb; body_has_foreign_yield(body, hname) }, arms),
  LKExtend(_, k)        => body_has_foreign_yield(k, hname),
  _                     => false
}

fn k2_floor_guard(e, terminus) = match e {
  LSuspend(h, o, f, args, ev, tail) => {
    let walked = LSuspend(h, o, k2_floor_guard(f, false),
                          k2_floor_list(args), k2_floor_list(ev), tail)
    if tail || terminus || !can_yield(o) { walked }
    else { k2_floor_wrap(h, walked) }
  },
  LLet(h, name, init) =>
    if k2_is_park(name) { LLet(h, name, k2_park_children(init)) }
    else { LLet(h, name, k2_floor_guard(init, false)) },
  LBlock(h, stmts)      => LBlock(h, k2_floor_last(stmts, terminus)),
  LIf(h, c, t, el)      => LIf(h, k2_floor_guard(c, false),
                               k2_floor_last(t, terminus),
                               k2_floor_last(el, terminus)),
  LMatch(h, s, arms)    => LMatch(h, k2_floor_guard(s, false),
                                  map((arm) => {
                                    let (pat, body) = arm
                                    (pat, k2_floor_guard(body, terminus))
                                  }, arms)),
  LHandleWith(h, b, hn, hname, inits, an, evs) => {
    // The body's terminus is driver-guarded when a driver exists
    // (multishot_ops_of != []) AND the driver handles the body's OWN yield.
    // A DRIVERLESS install's yield exits the bracket as a flagged dummy; in a
    // non-propagating position the enclosing code would compute on it
    // silently (the measured 9-not-29 install-crossing value loss), so the
    // whole install wraps in the loud floor — the dormant A4 gate:
    // re-install-in-k flips it to composition. M4 added the second clause:
    // an install whose body yields a FOREIGN op (one the driver does not
    // cover — `{ pick() + 3 } ~> mycatch` where mycatch handles only abort)
    // is NOT guarded for that crossing (the driver bubbles the foreign op,
    // but the enclosing remainder is not in the k). Without it, mycatch's
    // new abandon-driver defeated this floor and silently computed the
    // incomplete 9 (Hβ.lower.stateful-install-crossing-yield stays the
    // stateful floor; the foreign-crossing re-installs in the k at A4).
    let has_driver = len(multishot_ops_of(hname)) > 0 && !body_has_foreign_yield(b, hname)
    let rebuilt = LHandleWith(h, k2_floor_guard(b, has_driver),
                              k2_floor_guard(hn, false), hname,
                              k2_floor_list(inits), an, k2_floor_list(evs))
    if has_driver || terminus { rebuilt } else { k2_floor_wrap(h, rebuilt) }
  },
  LReturn(h, inner)     => LReturn(h, k2_floor_guard(inner, true)),
  LCall(h, f, args)     => LCall(h, k2_floor_guard(f, false), k2_floor_list(args)),
  LShow(h, x)           => LShow(h, k2_floor_guard(x, false)),
  LHash(h, x)           => LHash(h, k2_floor_guard(x, false)),
  LTailCall(h, f, args) => LTailCall(h, k2_floor_guard(f, false), k2_floor_list(args)),
  LBinOp(h, op, l, r)   => LBinOp(h, op, k2_floor_guard(l, false), k2_floor_guard(r, false)),
  LUnaryOp(h, op, x)    => LUnaryOp(h, op, k2_floor_guard(x, false)),
  LMakeClosure(h, fn_, caps, ev)  => LMakeClosure(h, fn_, k2_floor_list(caps), k2_floor_list(ev)),
  LMakeContinuation(h, fn_, caps, ev, si, rs, wt) =>
    LMakeContinuation(h, fn_, k2_floor_list(caps), k2_floor_list(ev), si, rs, wt),
  LYield(h, op, args, k) => LYield(h, op, k2_floor_list(args), k2_floor_guard(k, false)),
  LKExtend(h, k)        => LKExtend(h, k2_floor_guard(k, false)),
  LFnRef(h, n, ev)      => LFnRef(h, n, k2_floor_list(ev)),
  LDeclareFn(fn_)       => LDeclareFn(fn_),
  LMakeList(h, es)      => LMakeList(h, k2_floor_list(es)),
  LMakeTuple(h, es)     => LMakeTuple(h, k2_floor_list(es)),
  LSimdLanes(h, ls)     => LSimdLanes(h, k2_floor_list(ls)),
  LMakeRecord(h, fs)    => LMakeRecord(h, k2_floor_list(fs)),
  LMakeVariant(h, t, fs) => LMakeVariant(h, t, k2_floor_list(fs)),
  LFeedback(h, b, s)    => LFeedback(h, k2_floor_guard(b, false), k2_floor_guard(s, false)),
  LPerform(h, n, args, r) => LPerform(h, n, k2_floor_list(args), r),
  LEvPerform(h, n, ev, s, args) => LEvPerform(h, n, ev, s, k2_floor_list(args)),
  LWasiCall(h, n, args) => LWasiCall(h, n, k2_floor_list(args)),
  LFieldLoad(h, rec, o) => LFieldLoad(h, k2_floor_guard(rec, false), o),
  LConvert(h, k, x)     => LConvert(h, k, k2_floor_guard(x, false)),
  LStateSlotStore(h, o, v, home) => LStateSlotStore(h, o, k2_floor_guard(v, false), home),
  LEvEntry(n, ev)       => LEvEntry(n, k2_floor_guard(ev, false)),
  LConst(_, _)          => e,
  LLocal(_, _)          => e,
  LGlobal(_, _)         => e,
  LUpval(_, _)          => e,
  LEvRef(_, _)          => e,
  LFeedbackPrior(_)     => e,
  LUnresolvedEvidence(_, _) => e,
  LInvariantFailure(_, _) => e
}

fn k2_floor_list(es) = map((x) => k2_floor_guard(x, false), es)

// Block statements: only the LAST carries the terminus flag through.
fn k2_floor_last(stmts, terminus) = {
  let n = len(stmts)
  map((ix) => {
    let (i, s) = ix
    k2_floor_guard(s, if i == n - 1 { terminus } else { false })
  }, enumerate(stmts))
}

// The spine split's park local — its init is the one already-composed
// suspend; children still walk.
fn k2_is_park(name: String) = len(name) >= 5 && str_slice(name, 0, 5) == "__kr_"

fn k2_park_children(init) = match init {
  LSuspend(h, o, f, args, ev, tail) =>
    LSuspend(h, o, k2_floor_guard(f, false), k2_floor_list(args), k2_floor_list(ev), tail),
  other => k2_floor_guard(other, false)
}

// The loud floor: park width-honest, trap at a raised flag, else the value.
// The trap is the SAME comment-marked LYield floor the census greps — the
// off-spine k2 boundary's positive-form home until its spine form lands
// with its crucible.
fn k2_floor_wrap(h, s) = {
  let kf = "__kf_{int_to_str(h)}"
  LBlock(h, [
    LLet(h, kf, s),
    LIf(h, LGlobal(h, "yield_flag"),
        [LYield(h, "", [], LConst(h, LInt(0)))],
        [k2_floor_dummy(h)]),
    LLocal(h, kf)
  ])
}

// The floor if's else value is DROPPED — its one job is width-agreeing
// with the if node's declared repr (h = the wrapped call). An i32 word
// under an f64 call was the m3 assembly face at score_one_position's
// proximity weight (the compose-width-floor family arriving exactly
// where it was named). RI64/RF32/RV128 dummies keep the word form and
// meet the same LOUD assembly mismatch if a call of that width ever
// parks here — censusable, never silent (band D width work).
fn k2_floor_dummy(h) = match repr_of(lookup_ty(h)) {
  RF64 => LConst(h, LFloat(0.0)),
  _    => LConst(h, LInt(0))
}

// world_tag_of_row - legacy effect-row fingerprint projected to a
// union-homomorphic i32 bitmask. Each effect NAME
// projects to one bit (its FNV-1a hash folded to a position mod 32); the
// row's tag is the OR of its names' bits. The homomorphism is the point:
// tag(A ∪ B) == i32_or(tag(A), tag(B)), so a COMPOSED continuation's world
// is one i32.or at compose time — a hash-of-hashes cannot union (the
// semantics refuter's kill of the head-only form), a bit-union always can.
// A subset check over this value is UNSOUND as a capability gate: if required
// A and unrelated live B collide, B satisfies A's bit. Parameter arguments and
// activation identities are absent, and an open row tail contributes nothing.
// Keep this only as a deterministic compatibility fingerprint until the graph
// carries exact effect and handler-install identities.
fn world_tag_of_row(row) = {
  // The fingerprint folds referenced names regardless of polarity —
  // documented as an unsound-for-gating compatibility hash; both fields
  // contribute.
  let EfRow(p, a, _) = row
  i32_or(world_tag_or_names(eff_names_of(p), 0, 0),
         world_tag_or_names(eff_names_of(a), 0, 0))
}

fn world_tag_or_names(names, i, acc) = {
  if i >= len(names) { acc }
  else {
    let name = list_index(names, i)
    let h = world_tag_hash_bytes(name, 0, byte_len(name), 2166136261)
    world_tag_or_names(names, i + 1,
      i32_or(acc, i32_shl(1, i32_and(h, 31))))
  }
}

fn world_tag_hash_bytes(s, i, n, h) = {
  if i >= n { h }
  else {
    let mixed = i32_xor(h, byte_at(s, i)) * 16777619
    world_tag_hash_bytes(s, i + 1, n, mixed)
  }
}

// Lower a ResumeExpr's value + state updates with SNAPSHOT semantics:
// the resume value and every update RHS evaluate against the arm's
// PRE-update state, in source order, into per-site scratch locals;
// only then do the slot stores commit, and the saved value returns.
// Without the snapshot, `resume(ctr + n) with ctr = ctr + 1` returned
// the NEW ctr + n — the writeback raced the value (ev8d, 58-not-57).
// Slot offsets come from the field's source-order position in the
// enclosing arm's state-fields (resolved via the ArmStateContext
// handler). Updates whose field name is not in scope lower to
// LStateSlotStore(handle, -1, value) — emit time skips negative
// offsets per protocol_resume_state_mutation_substrate.md
// productive-under-error.
fn lower_resume_snapshot(handle, val, updates, fields) = {
  let (prefix, val_name) = resume_commit_prefix(handle, val, updates, fields, "")
  LBlock(handle,
    prefix ++ [LReturn(handle, LLocal(handle, val_name))])  // drift-audit: ignore — one-shot stmt-list concat, no loop
}

// The COMMIT PREFIX — the snapshot semantics shared by BOTH resume
// disciplines (band B M1.5, bank Ruling 4): the resume value and every
// update RHS evaluate against the arm's PRE-update state, in source order,
// into per-site scratch locals; only then do the slot stores COMMIT.
// Returns (stmts, val_name) — the tail differs per discipline: OneShot
// returns the snapshotted value (LReturn); MultiShot calls the k with it
// (commit BEFORE k(v), so the resumed remainder re-enters against
// committed state — LStateSlotStore writes through the arm's __state,
// which IS the install record the driver pushed, and every arm state read
// is a LIVE load through that record, so the next resume in the same arm
// sees the committed value).
fn resume_commit_prefix(handle, val, updates, fields, home) = {
  let val_name = "__resume_val_{int_to_str(handle)}"
  let val_let = LLet(handle, val_name, lower_expr(val))
  let lets = map((upd) =>
    LLet(handle, resume_upd_local(upd, handle),
         lower_expr(state_field_init(upd))), updates)
  let stores = map((upd) =>
    LStateSlotStore(handle, resolve_state_slot_offset(state_field_name(upd), fields),
                    LLocal(handle, resume_upd_local(upd, handle)), home), updates)
  ([val_let] ++ lets ++ stores, val_name)   // drift-audit: ignore — one-shot stmt-list concat, no loop
}

// The update's minted local — keyed by the field NAME (unique per
// record by construction; an enumerate index would re-derive an
// identity the name already carries) + the resume site's handle. Both
// map lambdas above mint through this one home, so the LLet and its
// LLocal read can never drift apart.
fn resume_upd_local(upd: {init: Node, name: String}, handle) =
  "__resume_upd_{upd.name}_{int_to_str(handle)}"

// Resolve a field name to its byte offset in the handler state
// record. `fields` is the slot-order NAME list — config ++ state in
// declaration order, the SAME list captures_names lays slots out by
// and install writes inits to (one heap record, four roles, per
// protocol_handler_is_state_is_closure_is_evidence.md:
// [fn_ptr@0, count@4, slot_0@8, slot_1@12, ...]). A state-only list
// here was a parallel half-truth: `buf` resolved to slot 0 — the
// config param's slot — and the next dispatch called the buffer as
// a closure. Returns -1 when name is not in fields
// (productive-under-error).
fn resolve_state_slot_offset(name: String, fields) = {
  let hits = filter((indexed) => {
    let (_, field) = indexed
    field == name
  }, enumerate(fields))
  if len(hits) == 0 { 0 - 1 }
  else {
    let (idx, _) = head(hits)
    8 + idx * 4
  }
}

// Walk free vars through a `resume() with` updates list. Each update's
// init expression may reference outer-scope names (e.g., a freshly-built
// `[frame] ++ frames` where `frame` is a let-bound local in the arm
// body). cfv reports those that aren't in `bound`.
fn free_vars_state_updates(updates, bound) = {
  fold([], (acc, upd) =>
    free_vars_merge(acc, collect_free_vars(state_field_init(upd), bound)), updates)
}

// Parameter name lowering (for LFn metadata)

fn lower_param_names(params) = map(param_name, params)

// Each param's graph handle for the LowerScope frame — read from the fn's
// INFERRED type, the live graph proof. infer mints a fresh handle per param
// and `build_param_types` records it as `TParam(name, TVar(h), …)` in the
// fn's `TFun`; that handle carries the param's resolved type. The parsed
// `TParam.ty` caches the resolved type and loses the handle, so reading it
// (lower_param_handles) returns 0 for any concrete-typed param and the
// lowered local goes type-blind. Reading the TFun keeps the handle: the
// local then live-chases its type via lookup_ty, so type-dispatched ops
// (==, ++, to_string) see the type the graph proved. (Discipline: never
// cache the resolved Ty; carry the handle and chase — types.mn.)
fn param_handles_of(fn_handle, params) = match lookup_ty(fn_handle) {
  TFun(tparams, _, _) =>
    if len(tparams) == len(params) { map(tparam_handle, tparams) }
    else { lower_param_handles(params) },
  _ => lower_param_handles(params)
}

fn tparam_handle(tp) = ty_handle_of(param_ty(tp))

// Fallback when the fn's type isn't a resolved TFun: reads each param's parsed
// type through the one ty_handle_of projection (TVar → handle; ground → 0).
// param_handles_of reads the inferred TFun instead.
fn lower_param_handles(params) = map((p) => ty_handle_of(param_ty(p)), params)

// W7 phase 1 — walks a lambda body collecting every `VarRef` whose
// name is not in the lambda's local scope. Nested lambdas augment
// `bound` with their own params during the walk, so references
// resolved inside the nested frame are excluded from the OUTER
// lambda's free set.
//
// Returns `List[String]` — names only, deduplicated. At emit time,
// closure record slot N stores the value of `captures[N]` from the
// enclosing scope; the lambda body reads them as `LUpval(h, N)`.
// H6: exhaustive NodeBody enumeration. Patterns and holes
// contribute no free variable references (they're terminal AST
// forms). Named explicitly so new NodeBody variants decide
// whether they can contain VarRefs.
fn collect_free_vars(node, bound) = {
  let N(body, _, _) = node
  match body {
    NExpr(e) => free_vars_expr(e, bound),
    NStmt(s) => free_vars_stmt(s, bound),
    NPat(_)  => [],
    NHole(_) => [],
    NModule(_)  => [],   // a module entity contains no VarRef of its own
    NTypeAnn(_) => []    // an authored type annotation contains no VarRef
  }
}

fn free_vars_expr(e, bound) = match e {
  LitInt(_)    => [],
  LitFloat(_)  => [],
  LitString(_) => [],
  LitBool(_)   => [],
  LitUnit      => [],

  VarRef(name) =>
    if free_vars_contains(bound, name) { [] }
    else { [name] },

  BinOpExpr(_, l, r) =>
    free_vars_merge(collect_free_vars(l, bound), collect_free_vars(r, bound)),

  UnaryOpExpr(_, inner) =>
    collect_free_vars(inner, bound),

  CallExpr(f, args) =>
    free_vars_merge(collect_free_vars(f, bound), free_vars_list(args, bound)),

  IfExpr(c, t, e) =>
    free_vars_merge(
      collect_free_vars(c, bound),
      free_vars_merge(collect_free_vars(t, bound), collect_free_vars(e, bound))
    ),

  BlockExpr(stmts, final_e) => {
    let (frees, bound_after) = free_vars_stmts(stmts, bound, [])
    free_vars_merge(frees, collect_free_vars(final_e, bound_after))
  },

  MatchExpr(scrut, arms) =>
    free_vars_merge(collect_free_vars(scrut, bound), free_vars_match_arms(arms, bound)),

  MakeListExpr(elems)  => free_vars_list(elems, bound),
  MakeTupleExpr(elems) => free_vars_list(elems, bound),
  MakeStringExpr(fragments) => free_vars_list(fragments, bound),
  IndexExpr(receiver, index) =>
    free_vars_merge(collect_free_vars(receiver, bound),
              collect_free_vars(index, bound)),
  MakeRecordExpr(flds)        => free_vars_record_fields(flds, bound),
  RecordUpdateExpr(base, flds) =>
    free_vars_merge(collect_free_vars(base, bound),
                    free_vars_record_fields(flds, bound)),
  NamedRecordExpr(_, flds)    => free_vars_record_fields(flds, bound),

  LambdaExpr(params, body) => {
    let inner_bound = free_vars_merge(bound, free_vars_param_names(params))
    collect_free_vars(body, inner_bound)
  },

  ResumeExpr(val, state_updates) =>
    // band B M1.6 (bank Ruling 2/A3): a resume USES the enclosing arm's k,
    // so "__k" is one of its free names. A lambda inside a MultiShot arm
    // thereby CAPTURES the k record like any local — the capture tier of
    // the resume-resolution ladder (lower_resume_callk walks it). Anywhere
    // __k is NOT an arm-frame local — a OneShot arm's lambda, a k-fn build,
    // an ordinary fn — "__k" resolves RGlobal and the phantom-capture fence
    // DROPS it: zero captures added, bytes identical (Law 7 holds on the
    // wheel's own backtrack, whose resume-in-lambda sits under the
    // OneShot-misclassified choose until the cut).
    free_vars_merge(["__k"],
      free_vars_merge(collect_free_vars(val, bound),
                free_vars_state_updates(state_updates, bound))),
  FieldExpr(rec, _)    => collect_free_vars(rec, bound),

  PipeExpr(_, l, r) =>
    free_vars_merge(collect_free_vars(l, bound), collect_free_vars(r, bound)),

  ExprPlaceholder      => [],

  // A labeled arg's value can reference free vars (closure capture must see
  // them); the label is a param name, not a value-position var.
  LabeledArg(_, v)     => collect_free_vars(v, bound),

  // H6: exhaustive Expr enumeration. Literals contribute no
  // free vars. Named explicitly so new Expr variants must decide
  // their free-var contribution (critical for closure capture).
  LitInt(_)    => [],
  LitFloat(_)  => [],
  LitString(_) => [],
  LitBool(_)   => [],
  LitUnit      => []
}

// H6: exhaustive Stmt enumeration. Type/effect/handler
// declarations and imports contribute no value-level free vars
// to closure capture. Refinement stmts similarly. Named
// explicitly so new Stmt variants decide their cfv behavior.
fn free_vars_stmt(s, bound) = match s {
  LetStmt(_, expr, _)           => collect_free_vars(expr, bound),
  FnStmt(_, _, _, _, body_node) => collect_free_vars(body_node, bound),
  ExprStmt(expr)                => collect_free_vars(expr, bound),
  TypeDefStmt(_, _)             => [],
  EffectDeclStmt(_, _)          => [],
  HandlerDeclStmt(_, _, _, _, _) => [],
  ImportStmt(_)                 => [],
  RefineStmt(_, _, _)           => [],
  AliasStmt(_, _)               => []
}

fn free_vars_list(nodes, bound) = {
  fold([], (acc, node) =>
    free_vars_merge(acc, collect_free_vars(node, bound)), nodes)
}

// Free variables in a record-literal expression: union of frees in
// each field's value. Field names are not value-position references
// (the parser already desugared pun-syntax to `VarRef` nodes).
fn free_vars_record_fields(flds, bound) = {
  fold([], (acc, fld) => {
    let (_, value) = fld
    free_vars_merge(acc, collect_free_vars(value, bound))
  }, flds)
}

// Walk a statement list, threading `bound` through `LetStmt`s so
// subsequent statements see the new bindings. Returns
// `(accumulated_frees, final_bound)`.
fn free_vars_stmts(stmts, bound, acc_frees) = {
  if len(stmts) == 0 { (acc_frees, bound) }
  else {
    let stmt = last(stmts)
    let N(stmt_body, _, _) = stmt
    match stmt_body {
      NStmt(LetStmt(pat, expr, _)) => {
        let frees = collect_free_vars(expr, bound)
        let new_bound = free_vars_merge(bound, free_vars_pat_binds(pat))
        free_vars_stmts(
          drop_last(stmts),
          new_bound,
          free_vars_merge(acc_frees, frees)
        )
      },
      NStmt(FnStmt(name, _, _, _, body_node)) => {
        // Nested named fn — its name is in scope for siblings and the
        // final expression (recursive / mutual references resolve via env).
        let frees = collect_free_vars(body_node, bound)
        let new_bound = free_vars_merge(bound, [name])
        free_vars_stmts(
          drop_last(stmts),
          new_bound,
          free_vars_merge(acc_frees, frees)
        )
      },
      _ => {
        let frees = collect_free_vars(stmt, bound)
        free_vars_stmts(drop_last(stmts), bound, free_vars_merge(acc_frees, frees))
      }
    }
  }
}

fn free_vars_match_arms(arms, bound) = {
  fold([], (acc, arm) => {
    let (pat, body) = arm
    let arm_bound = free_vars_merge(bound, free_vars_pat_binds(pat))
    free_vars_merge(acc, collect_free_vars(body, arm_bound))
  }, arms)
}

fn free_vars_param_names(params) = map(param_name, params)

// H6: exhaustive Pat enumeration. PVar is the only leaf that
// binds a name; compound patterns recurse into sub-patterns.
// PWild / PLit bind nothing. New Pat variants must decide their
// binder-name contribution explicitly.
fn free_vars_pat_binds(pat) = match pat {
  PVar(name)         => [name],
  PCon(_, sub_pats)  => free_vars_pat_binds_list(sub_pats),
  PTuple(sub_pats)   => free_vars_pat_binds_list(sub_pats),
  PList(sub_pats, rest) =>
    free_vars_merge(free_vars_pat_binds_list(sub_pats), free_vars_pat_rest_binds(rest)),
  PRecord(flds)      => free_vars_pat_binds_fields(flds),
  // Alternation branches bind the SAME name set by law (SYNTAX
  // §"Pattern alternation" — E_PatternAlternationBindingMismatch
  // enforces it), so the first branch's binders ARE the arm's.
  // Face 9: this was the one Pat walker missing the arm; the testing
  // lib's alternation matches hit the floor at the input's tail.
  PAlt(branches)     => free_vars_pat_binds(list_index(branches, 0)),
  PWild              => [],
  PLit(_)            => []
}

fn free_vars_pat_rest_binds(rest) = match rest {
  None => [],
  Some(name) => if field_name_eq(name, "_") { [] } else { [name] }
}

// Extract binder names from record-pattern fields `[(name, Pat)]`.
// Each field contributes its sub-pat's binders.
fn free_vars_pat_binds_fields(flds) = {
  fold([], (acc, fld) => {
    let (_, sub_pat) = fld
    free_vars_merge(acc, free_vars_pat_binds(sub_pat))
  }, flds)
}

fn free_vars_pat_binds_list(pats) = {
  fold([], (acc, p) => free_vars_merge(acc, free_vars_pat_binds(p)), pats)
}

fn free_vars_merge(a, b) = {
  if len(b) == 0 { a }
  else {
    let x = last(b)
    let rest = drop_last(b)
    if free_vars_contains(a, x) { free_vars_merge(a, rest) }
    else { free_vars_merge(list_concat(a, [x]), rest) }   // drift-audit: ignore — real drift 11 in free_vars_* set-union family; buffer-counter rewrite adds Memory+Alloc to row rippling through callers; tracked for item 11.B buffer-counter sweep. Explicit list_concat (was `a ++ [x]`) — BConcat's emit dispatches via lookup_ty which returned NFree at infer-time, falling to str_concat and trapping in mentl2's runtime when list arms walked the bytes as elements. Direct call avoids the dispatch.
  }
}

fn free_vars_contains(lst, s) = any((x) => x == s, lst)

// Stage 4a: WASI import-name predicate. Recognized op names bridge
// to the WASM-level import via LWasiCall instead of LPerform's
// $op_<name> handler-arm dispatch. Per
// protocol_bootstrap_wasi_threads_substrate.md — the import IS the
// bridge; no wrapper function required.
// The seven substrate ops memory.mn declares — the boundary where the
// language meets the instruction set (the wasi-import list's sibling;
// the op names ARE the identity, declared in one home).
fn is_substrate_mem_op(name: String) with Pure = {
  name == "store_i32"
    || name == "load_i32"
    || name == "store_i8"
    || name == "load_i8"
    || name == "store_f64"
    || name == "load_f64"
    || name == "mem_copy"
    || name == "i32_xor"
    || name == "i32_or"
    || name == "i32_and"
    || name == "i32_shl"
    || name == "alloc"
    || name == "heap_mark"
    || name == "heap_reset"
}

fn is_wasi_import_op(name) with Pure = {
  // wasi_num_cores is ABSENT by design: it has a wasi_threads handler arm
  // (threading.mn — `wasi_num_cores() => resume(wasi_num_cores_intrinsic())`),
  // so it is an effect-op PERFORM routed through the handler (the else branch,
  // lower_perform_dispatch), never a raw import. Listing it here bridged it to
  // a `(call $wasi_num_cores)` with no import and no arm — a dangling call.
  // Only ops with NO handler arm (raw host imports + atomic instructions) belong.
  name == "wasi_thread_spawn"
    || name == "fd_write"
    || name == "fd_read"
    || name == "fd_close"
    || name == "fd_prestat_get"
    || name == "fd_prestat_dir_name"
    || name == "fd_fdstat_get"
    || name == "path_open"
    || name == "path_create_directory"
    || name == "path_filestat_get"
    || name == "path_unlink_file"
    || name == "path_rename"
    || name == "fd_readdir"
    || name == "sock_accept"
    || name == "poll_oneoff"
    || name == "args_sizes_get"
    || name == "args_get"
    || name == "proc_exit"
    || name == "atomic_load_i32"
    || name == "atomic_store_i32"
    || name == "atomic_rmw"
    || name == "wait_i32"
    || name == "notify"
    || name == "fence"
}

// lower_index — `xs[i]` dispatched on the RECEIVER's proven type (the proof IS
// the dispatch, the ++/== precedent). A TTuple receiver with a CONSTANT index
// is a positional-product field load: LFieldLoad at the width-summed offset
// (tuple_elem_offset). Everything else — a list receiver, or a runtime-variable
// index — stays the genuinely-runtime list_index call. The index's constant-ness
// is read live from its AST body (NExpr(LitInt n)); a tuple indexed by a non-
// constant is still a list_index (an open question the type system would refine
// to ValidIndex, but the const case is the one a positional product answers at
// compile time).
fn lower_index(handle, receiver, index) = {
  let N(_, _, rh) = receiver
  let N(idx_body, _, _) = index
  match lookup_ty(rh) {
    TTuple(elems) => match idx_body {
      NExpr(LitInt(n)) =>
        LFieldLoad(handle, lower_expr(receiver), FByIndex(n)),
      _ => lower_index_runtime(handle, receiver, index)
    },
    _ => lower_index_runtime(handle, receiver, index)
  }
}

// A list index lowers to the runtime list_index call. When infer proved the
// index in-range (the refinement-narrowing weave carries a path-predicate at the
// index handle — graph_narrow_at ≠ 0), the access is a PROVEN-valid load:
// list_index_proven, the elision variant that skips the redundant bounds path
// the proof already discharged (§4⑥; SYNTAX.md «Indexing»: "the compiler elides
// the bounds check"). Carried-Truth: the proof is READ live from the graph, never
// re-derived; an un-narrowed index (the 0 default) stays the checked list_index,
// byte-identical to the prior form.
fn lower_index_runtime(handle, receiver, index) = {
  let N(_, _, ih) = index
  let callee = if graph_narrow_at(ih) != 0 { "list_index_proven" } else { "list_index" }
  LCall(handle, LGlobal(handle, callee),
        [lower_expr(receiver), lower_expr(index)])
}

// String interpolation lowering. Reduce a list of LowExpr fragments
// (alternating literal-chunks + spliced-exprs) to a left-fold of
// LCall(VarRef("str_concat"), [acc, next]). Per Mentl-substrate's
// runtime-strings-substrate (Hβ.runtime.zero-copy-string-view): each
// concat allocates ONE flat result; view-substrate makes literal
// chunks zero-copy reads from source. Empty list → empty string;
// singleton → that fragment unchanged.
fn lower_string_interpolation(handle, lowered_fragments) = {
  // Empty literal fragments (the "" edges the parser keeps for the
  // alternation invariant) elide before the fold — the canonical form
  // is also the efficient form (no str_concat with "" at runtime).
  // The seed's $lower_make_string elides IDENTICALLY (fixpoint parity).
  let fragments = filter((f) => !is_empty_lconst_string(f), lowered_fragments)
  if len(fragments) == 0 {
    LConst(handle, LString(""))
  } else if len(fragments) == 1 {
    last(fragments)
  } else {
    // Left-assembly from the FIRST fragment: acc ++ frag in source order.
    // head = last(fragments) baked the FINAL fragment first — every
    // interpolation m2 lowered into m3 came out rotated ("$ft_{codes}_{rc}"
    // rendered d$ft_iiiid_, m4.wat line 13's assembly failure once m4
    // existed at all, 2026-07-10). The seed's own $lower_make_string
    // assembles source-order, so m2's OWN strings were fine and the
    // wheel's copy was never order-gated (mn-interp-order now gates it).
    let head = list_index(fragments, 0)
    let rest = slice(fragments, 1, len(fragments))
    fold(head, (acc, frag) =>
      LCall(handle, LGlobal(handle, "str_concat"), [acc, frag]), rest)
  }
}

fn is_empty_lconst_string(frag) = match frag {
  LConst(_, LString(s)) => byte_len(s) == 0,
  _                     => false
}

// Expression list

fn lower_expr_list(nodes) = map(lower_expr, nodes)

// Lower each value in a record-literal field list. Fields arrive
// sorted-by-name (parser invariant); position IS layout. The lowered
// list is in field-name sort order — emit reads it as the byte
// layout directly, no per-field lookup.
fn lower_record_field_values(flds) = map((fld) => {
  let (_, value) = fld
  lower_expr(value)
}, flds)

// {...base, f: v} — lower a non-destructive record update. The result
// record's field set is read LIVE from the inferred type at `handle`
// (infer proved it = base's fields ∪ overrides); the base is bound once
// to a temp local, then each result field is filled either from the
// override expr (carried by name) or by copying the base's proven field
// (LFieldLoad at base's offset). No runtime copy loop, no re-derivation —
// the proof IS the layout (Carried-Truth at the record layer).
fn lower_record_update(handle, base, overrides) = {
  let result_fields = record_fields_of_handle(handle)
  let tmp = "__upd_{int_to_str(handle)}"
  let base_lo = lower_expr(base)
  // The copy-load's receiver carries BASE's handle: the emit projects the
  // offset from the receiver's live type, and base's layout is the one the
  // copied field lives in (the result may ADD fields — two layouts).
  let N(_, _, bh) = base
  let field_exprs = map((rf) => {
    let (fname, _) = rf
    match find_override(overrides, fname) {
      Some(v) => lower_expr(v),
      None    => LFieldLoad(handle, LLocal(bh, tmp), FByName(fname))
    }
  }, result_fields)
  LBlock(handle, [
    LLet(handle, tmp, base_lo),
    LMakeRecord(handle, field_exprs)
  ])
}

// The sorted field list of the record type inferred at a handle —
// TRecord / TRecordOpen carry it directly; a nominal TName chases the
// env to its RecordSchemeKind (same shape resolve_field_offset reads).
fn record_fields_of_handle(handle) = match lookup_ty(handle) {
  TRecord(fields)        => fields,
  TRecordOpen(fields, _) => fields,
  TName(name, _)         => match env_lookup(name) {
    Some(entry) => {
      let (_, _, kind) = entry
      match kind {
        RecordSchemeKind(fields) => fields,
        _                        => []
      }
    },
    None => []
  },
  _ => []
}

// The byte offset of `field` within the record inferred at `base`'s
// handle — base's own field layout (the source we copy from), distinct
// from the result layout. Reuses resolve_field_offset's proven offset.

fn find_override(overrides, target: String) = match overrides {
  []            => None,
  [(n, v), ...t] => if n == target { Some(v) } else { find_override(t, target) }
}

// W7.1 — called at `LambdaExpr` / `FnStmt` lower-time, BEFORE entering
// the new frame. Each free name is resolved against the CURRENT (enclosing)
// scope via `ls_resolve`:
//   `RLocal`      — name is a local of the enclosing frame; capture loads its slot value.
//   `RUpval(slot)` — name was itself captured; capture loads through `__state` offset.
//   `RGlobal`     — name is a top-level symbol; NOT captured. Dropped from the list.
//
// Returns `(captures_names, captures_exprs, captures_handles)` — parallel
// triples. `captures_names` feeds `ls_enter_frame`; `captures_exprs` feeds
// `LMakeClosure`'s heap-record materialization at emit time.
fn resolve_captures_outer(names, owner_h) = {
  if len(names) == 0 { ([], [], []) }
  else {
    let name = last(names)
    let (res, local_h) = ls_resolve(name)
    let (rest_names, rest_exprs, rest_handles) =
      resolve_captures_outer(drop_last(names), owner_h)
    match res {
      RGlobal => (rest_names, rest_exprs, rest_handles),
      RLocal => (
        [name] ++ rest_names,
        [LLocal(local_h, name)] ++ rest_exprs,
        [local_h] ++ rest_handles
      ),
      RUpval(slot) => (
        [name] ++ rest_names,
        [LUpval(local_h, slot)] ++ rest_exprs,
        [local_h] ++ rest_handles
      ),
      RFbPrior(fb_h) => (
        [name] ++ rest_names,
        [LFeedbackPrior(fb_h)] ++ rest_exprs,
        [local_h] ++ rest_handles
      )
    }
  }
}

// Pre-pass: collect every top-level name (`FnStmt`, `LetStmt`) and
// register as globals via `ls_register_globals`. Then walk stmts; each
// `FnStmt` / `LambdaExpr` pushes its own frame. `VarRef` resolution in
// lambda bodies correctly distinguishes local/upval/global.
fn lower_program(stmts) = {
  let globals = collect_top_level_names(stmts)
  ls_register_globals(globals)
  // The flow-closure, computed ONCE (the cached cursor): name → escaping row.
  // Read live by THE SEAM's two consumers; the env is fully typed here (infer
  // ran), so own_dispatched + the call-edge fixpoint are both available.
  ls_register_escaping(compute_escaping_rows(stmts))
  // band B M1.3 — the A1 gate's global short-circuit: does any declared
  // effect carry a MultiShot-graded op? No ⇒ nothing can yield ⇒ can_yield
  // is false everywhere and the k2 machinery contributes zero bytes (Law 7).
  ls_register_may_yield(program_may_yield(stmts))
  // THE CUT — the resume-capability bindings (dormant when no op grades
  // MultiShot: zero arms seed the closure, the list is empty).
  ls_register_resume_binds(resume_bindings(stmts))
  // No pre-register pass: every handler decl's (config, state, arms) is
  // already in the env's HandlerKind (register_handler), so an install
  // resolves its handler's decl live (handler_decl_of) regardless of source
  // order. The lower-handler-stack tracks lexical installs; the arm-ev ledger
  // collects each handler's arm-body evidence.
  lower_stmt_list(stmts)
    ~> arm_ev_ledger_ctx
    ~> lower_handler_stack_ctx
}

// Ω.3 — top-level name collection uses the buffer substrate. The number
// of top-level statements is bounded by N (file size), so O(N) total
// allocation via `list_extend_to` + `list_set` + counter + `slice` —
// avoiding the O(N²) recursive accumulator pattern. The buffer threads
// through tail-recursion as `(buf, count)` because `list_extend_to`
// may return a fresh allocation if the current capacity is exceeded.
fn collect_top_level_names(stmts) = {
  let n = len(stmts)
  let initial_capacity = if n < 4 { 4 } else { n }
  let buf = make_list(initial_capacity)
  let (final_buf, final_count) = collect_top_level_names_loop(stmts, 0, n, buf, 0)
  slice(final_buf, 0, final_count)
}

fn collect_top_level_names_loop(stmts, i, n, buf, count) = {
  if i >= n { (buf, count) }
  else {
    let N(body, _, _) = list_index(stmts, i)
    let (new_buf, new_count) = match body {
      NStmt(FnStmt(name, _, _, _, _))            => push_name(buf, count, name),
      NStmt(LetStmt(PVar(name), _, _))           => push_name(buf, count, name),
      // A handler decl IS a top-level name — `~> h` references it as a
      // global, never a captured upvalue (the phantom-capture fence lie:
      // each install counted as a capture inflated the ev-region base by
      // 4×installs while every caller built the record at ncap=0).
      NStmt(HandlerDeclStmt(name, _, _, _, _))   => push_name(buf, count, name),
      _                                          => (buf, count)
    }
    collect_top_level_names_loop(stmts, i + 1, n, new_buf, new_count)
  }
}

fn push_name(buf, count, name) = {
  let extended = list_extend_to(buf, count + 1)
  let written  = list_set(extended, count, name)
  (written, count + 1)
}

// W7.1 lexical frame stack. State:
//   `frames`  — list of frame records (head = current). Each frame is one
//               lambda / fn body with locals + captures.
//   `globals` — top-level name strings registered by `lower_program` at entry.
//
// `ls_resolve(name)`: search current frame's locals (innermost-first via
// push/pop checkpoint truncation). If not found, current frame's captures.
// Otherwise `RGlobal`. Frames below the head are NEVER searched — they
// belong to the enclosing lambda, which is opaque at this lexical level.
// Names referenced across frame boundaries MUST be captured.
// Frame shape (Ω.5): one record per frame, six fields. Sorted-set
// for O(log N) membership; parallel insertion-ordered list for slot
// positioning (LLocal / LUpval need positional indices). Same data
// as the prior parallel-arrays form, structurally consolidated:
//
//   locals       — sorted set of local names (membership)
//   local_order  — insertion-ordered list (slot index = position)
//   local_handles — parallel to local_order, type handles per slot
//   captures, capture_order, capture_handles — same shape, capture side
//
// Field-sort discipline (parser + mk_record): records are stored
// alphabetically, so the WAT layout is captures(0), capture_handles(4),
// capture_order(8), locals(12), local_handles(16), local_order(20).
// Mentl source reads via .field — physical layout irrelevant.
handler lower_scope with frames = [], globals = [], fb_priors = [], esc_rows = smap_new(), may_yield = false, resume_binds = [] {
  // THE FLOW-CLOSURE map (name → escaping row), computed once at lower_program
  // and read live by THE SEAM. Some(row) for a top-level fn; None (→ the leaf)
  // for a nested fn / lambda / unknown name.
  ls_register_escaping(map) => resume() with esc_rows = smap_build(map),

  ls_escaping_of(name) => resume(smap_get(esc_rows, name)),

  // band B M1.3 — the A1 gate's global short-circuit, computed once at
  // lower_program from the declared effects × their ops' inferred disciplines.
  ls_register_may_yield(b) => resume() with may_yield = b,

  ls_program_may_yield() => resume(may_yield),

  // THE CUT (bank A3) — the resume-capability bindings: fn name → the
  // handler whose MultiShot arm's call graph reaches it.
  ls_register_resume_binds(bs) => resume() with resume_binds = bs,

  ls_resume_bind_of(name) => resume(resume_bind_assoc(resume_binds, name, 0)),

  ls_enter_frame(fn_name, locals_in, locals_h, captures_in, captures_h, lambda_h) => {   // drift-audit: ignore — pre-existing frame-record paired-arrays (locals_h/captures_h); same restructure tracked for 11.C.2
    // Per Hβ.first-light.nested-fn-name-discriminator (2026-05-06):
    // fn_name carries the named-fn discriminator for nested-fn naming
    // (lambda + synthetic frames pass ""). lambda_h carries the LambdaExpr's
    // own handle for an anonymous-lambda frame (-1 otherwise), so the in-body
    // ev-slot READ indexes the lambda's OWN row — the SAME effects_of(lookup_ty)
    // projection derive_ev_slots PLACED against (place==read by construction).
    // Field-sort discipline keeps the frame record alphabetical: capture_handles,
    // capture_order, captures, fn_name, lambda_h, local_handles, local_order, locals.
    let frame = {
      capture_handles: captures_h,
      capture_order: captures_in,
      captures: set_canonicalize(captures_in),
      fn_name: fn_name,
      lambda_h: lambda_h,
      local_handles: locals_h,
      local_order: locals_in,
      locals: set_canonicalize(locals_in)
    }
    resume() with frames = frames ++ [frame]   // drift-audit: ignore — O(1) push at the end last/drop_last read
  },

  ls_exit_frame() => {
    if len(frames) == 0 { resume() }
    else {
      resume()
        with frames = drop_last(frames)
    }
  },

  ls_push_scope() => {
    if len(frames) == 0 { resume(0) }
    else {
      let frame = last(frames)
      resume(len(frame.local_order))
    }
  },

  ls_pop_scope(checkpoint) => {
    if len(frames) == 0 { resume() }
    else {
      let frame = last(frames)
      let truncated_order = take(checkpoint, frame.local_order)
      let truncated_handles = take(checkpoint, frame.local_handles)
      let updated = {
        capture_handles: frame.capture_handles,
        capture_order: frame.capture_order,
        captures: frame.captures,
        fn_name: frame.fn_name,
        lambda_h: frame.lambda_h,
        local_handles: truncated_handles,
        local_order: truncated_order,
        locals: set_canonicalize(truncated_order)
      }
      resume()
        with frames = drop_last(frames) ++ [updated]   // drift-audit: ignore — replace the END frame last() read
    }
  },

  ls_bind_local(name, h) => {
    if len(frames) == 0 { resume(0) }
    else {
      let frame = last(frames)
      let slot = len(frame.local_order)
      let updated = {
        capture_handles: frame.capture_handles,
        capture_order: frame.capture_order,
        captures: frame.captures,
        fn_name: frame.fn_name,
        lambda_h: frame.lambda_h,
        local_handles: handle_list_append(frame.local_handles, h),
        local_order: name_list_append(frame.local_order, name),
        locals: set_insert(frame.locals, name)
      }
      resume(slot)
        with frames = drop_last(frames) ++ [updated]   // drift-audit: ignore — replace the END frame last() read
    }
  },

  // (LF.B) The `<~` lambda param shadows everything for the recurrence body:
  // it names the prior-iteration output, a feedback NODE read live. Pushed
  // innermost-first so a nested `<~` resolves to its own prior. The pair is
  // (name, fb_handle); resolution returns RFbPrior(fb_handle).
  ls_bind_fb_prior(name, h) =>
    resume() with fb_priors = fb_priors ++ [(name, h)],   // drift-audit: ignore — O(1) push at the end last/drop_last read

  ls_unbind_fb_prior() =>
    if len(fb_priors) == 0 { resume() }
    else { resume() with fb_priors = drop_last(fb_priors) },

  ls_resolve(name) => {
    // Feedback-prior bindings shadow frame locals (the recurrence body's
    // `prev` IS the prior node — Carried-Truth, read live from $__fb_prev_<h>).
    let prior_h = fb_prior_handle_of(fb_priors, name)
    if prior_h >= 0 {
      resume((RFbPrior(prior_h), 0))
    } else if len(frames) == 0 {
      resume((RGlobal, 0))
    } else {
      let frame = last(frames)
      // O(log N) membership; slot lookup falls back to the order list
      // only when the name is actually present (the common case for
      // an enclosed reference is local-or-capture, not global).
      if set_contains(frame.locals, name) {
        let local_idx = ls_find_in_order(frame.local_order, name, 0)
        resume((RLocal, list_index(frame.local_handles, local_idx)))
      } else if set_contains(frame.captures, name) {
        let cap_idx = ls_find_in_order(frame.capture_order, name, 0)
        resume((RUpval(cap_idx), list_index(frame.capture_handles, cap_idx)))
      } else {
        resume((RGlobal, 0))
      }
    }
  },

  ls_register_globals(names) => {
    resume() with globals = names
  },

  // Per Hβ.first-light.nested-fn-name-discriminator (2026-05-06):
  // walks frames innermost-first, returns the first non-empty fn_name
  // field. The closest enclosing named declaration; lambda frames have
  // empty fn_name and are skipped. Empty string when top-level (no
  // enclosing named-fn frame). Symmetric with $op_<handler>_<op> — both
  // use semantic prefixes, NOT handle-ints. Drift refused: 1 (no
  // vtable, direct field read); 8 (returns the actual name string,
  // not a mode-keyed lookup); 9 (lands the discriminator-as-name
  // peer alongside the handler-arm fn-name-discriminator's
  // third-instance abstraction-earned shape).
  ls_outer_fn_name() => resume(ls_outer_fn_name_loop(frames)),

  // The innermost enclosing lambda frame's own handle (-1 if a named-fn
  // frame is hit first, or none). The in-lambda ev-slot READ uses this to
  // index the lambda's OWN row (effects_of(lookup_ty(lh))) — the SAME
  // projection derive_ev_slots PLACED against, so read==place by construction.
  // Peer of ls_outer_fn_name; ls_outer_fn_name itself stays untouched.
  ls_current_lambda_handle() => resume(ls_current_lambda_handle_loop(frames))
}

// Walk frames innermost-first; return first non-empty fn_name.
// Lambda + block frames carry empty fn_name and are transparent;
// only named-fn frames contribute. Returns empty string when no
// named-fn frame exists (top-level). Drift refused: 7 (frames is one
// list; we read it sequentially, not as parallel arrays).
fn ls_outer_fn_name_loop(frames) = {
  if len(frames) == 0 { "" }
  else {
    let frame = last(frames)
    if frame.fn_name == "" { ls_outer_fn_name_loop(drop_last(frames)) }
    else { frame.fn_name }
  }
}

// Walk frames innermost-first; return the first lambda frame's own handle.
// A named-fn frame hit before any lambda stops the walk at -1 (named fns read
// escaping_row(fn_name), not their own lookup_ty row). Block / synthetic-thunk
// frames are transparent (lambda_h = -1, fn_name = "") and recurse. -1 when no
// enclosing lambda. Peer of ls_outer_fn_name_loop; one list, read sequentially
// (drift 7 refused). The handle indexes the lambda's own row at the ev READ —
// the SAME effects_of(lookup_ty) projection PLACE used (read==place by build).
fn ls_current_lambda_handle_loop(frames) = {
  if len(frames) == 0 { -1 }
  else {
    let frame = last(frames)
    if frame.lambda_h >= 0 { frame.lambda_h }
    else if frame.fn_name != "" { -1 }
    else { ls_current_lambda_handle_loop(drop_last(frames)) }
  }
}

// (LF.B) Resolve a name to its feedback-prior handle, innermost-first.
// Each entry is `(name, fb_handle)` — the `<~` site whose prior local this
// name binds. Returns the handle on match, -1 when the name is not a
// `<~`-bound prior (so `ls_resolve` falls through to frame locals). Read
// sequentially over one list (drift 7 refused); no parallel arrays.
fn fb_prior_handle_of(priors, name: String) = {
  if len(priors) == 0 { -1 }
  else {
    match last(priors) {
      (n, h) => if n == name { h } else { fb_prior_handle_of(drop_last(priors), name) }
    }
  }
}

// Slot-index lookup once `set_contains` has confirmed membership.
// The set vouches the name is present; this loop locates its insertion
// position (slot index for `LLocal` / `LUpval`). Linear because order
// is insertion-keyed, not sort-keyed; bounded by frame size in practice.
// Only fires after a positive `set_contains`, so worst case is O(N)
// but expected case hits early since recently-bound names dominate.
fn ls_find_in_order(lst, target: String, i) = {
  ls_find_in_order_loop(lst, target, i, len(lst))
}

fn ls_find_in_order_loop(lst, target: String, i, n) = {
  if i >= n { -1 }
  else if list_index(lst, i) == target { i }
  else { ls_find_in_order_loop(lst, target, i + 1, n) }
}

// ─── Reachability — an executable's emission projects the MAIN-ROOTED
// subgraph ─────────────────────────────────────────────────────────────
// The graph never forgot the call edges; emission reads them. The seed
// has projected exactly this since its first build (reachability-from-
// main drops the unused); the wheel now reads the same edges, so a rung
// carries only the code it reaches, an uncalled generic's unresolvable
// fold leaf ($compare_nUNRESOLVED) is never minted, and both compilers
// converge on the same emitted set (fixpoint parity, not divergence).
// One pure acc-walk — no effects, so the evidence layer is untouched
// (the ~>-visitor extension of walk_lemit is the deeper form, gated on
// the ev-slot seam close). A module with no `main` is a LIBRARY and
// emits whole (SYNTAX §Top-level program structure).

fn reach_names_list(stmts, acc) = {
  if len(stmts) == 0 { acc }
  else { reach_names_list(drop_last(stmts), reach_names_expr(last(stmts), acc)) }
}

fn reach_arm_group_names(groups, acc) = {
  if len(groups) == 0 { acc }
  else { reach_arm_group_names(drop_last(groups), group_arms(last(groups)) ++ acc) }
}

fn reach_match_arms(arms, acc) = {
  if len(arms) == 0 { acc }
  else {
    let (_, body) = last(arms)
    reach_match_arms(drop_last(arms), reach_names_expr(body, acc))
  }
}

fn reach_names_expr(expr, acc) = match expr {
  LGlobal(_, n)             => [n] ++ acc,
  LFnRef(_h, n, ev)         => reach_names_list(ev, [n] ++ acc),
  // emit calls `$op_<target>` (the arm fn), so reach the arm fn by its emitted
  // name — the un-prefixed `target` matched nothing (installed handlers survived
  // via their reached decl-container, but a singleton dispatch to an UNINSTALLED
  // handler is the arm fn's only reference).
  LPerform(_h, target, args, _) => reach_names_list(args, ["op_{target}"] ++ acc),
  LHandleWith(_h, b, hn, _hname, inits, arm_names, evs) =>
    reach_names_list(evs,
      reach_names_list(inits,
        reach_names_expr(hn,
          reach_names_expr(b, reach_arm_group_names(arm_names, acc))))),
  LLet(_h, _n, inner)       => reach_names_expr(inner, acc),
  LMakeClosure(_h, LFn(_n, _a, _p, body, _r, _f), caps, ev) =>
    reach_names_list(ev, reach_names_list(caps, reach_names_list(body, acc))),
  LMakeContinuation(_h, LFn(_n, _a, _p, body, _r, _f), caps, ev, _, _, _) =>
    reach_names_list(ev, reach_names_list(caps, reach_names_list(body, acc))),
  // A yield reaches through its k record (the __k fn's body + captures + ev);
  // the ARM reaches through the install's arm groups, the existing channel.
  LYield(_h, _op, args, k)  => reach_names_expr(k, reach_names_list(args, acc)),
  // A k2 boundary reaches through its frame_k record the same way.
  LKExtend(_h, k)           => reach_names_expr(k, acc),
  LDeclareFn(LFn(_n, _a, _p, body, _r, _f)) => reach_names_list(body, acc),
  LBlock(_h, stmts)         => reach_names_list(stmts, acc),
  LIf(_h, c, t, e)          =>
    reach_names_list(e, reach_names_list(t, reach_names_expr(c, acc))),
  // ==/ordering on a wide-element sequence mints list_eq_f64/list_compare_f64
  // (emit_eq_for_ty / emit_cmp_for_ty); contribute it where emit reads it.
  LBinOp(_h, op, l, r)      => reach_names_expr(r, reach_names_expr(l, wide_binop_seed(op, l) ++ acc)),
  LUnaryOp(_h, _op, x)      => reach_names_expr(x, acc),
  LCall(_h, f, args)        => reach_names_list(args, reach_names_expr(f, acc)),
  // show/hash contribute the names emit will mint, projected from the SAME
  // live type read the emit dispatch makes (the visitor-walk projection the
  // runtime-contract comment names) — including the generated aggregate
  // leaf's interior renderers, which reach previously never kept (the
  // minimal-module undefined-$int_to_str break, gate mn-aggregate-show).
  LShow(_h, x)              => reach_names_expr(x, show_reach_names(x) ++ acc),
  LHash(_h, x)              => reach_names_expr(x, hash_reach_names(x) ++ acc),
  LTailCall(_h, f, args)    => reach_names_list(args, reach_names_expr(f, acc)),
  LReturn(_h, x)            => reach_names_expr(x, acc),
  LMakeList(_h, elems)      => reach_names_list(elems, acc),
  LMakeTuple(_h, elems)     => reach_names_list(elems, acc),
  LSimdLanes(_h, lanes)     => reach_names_list(lanes, acc),
  LMakeRecord(_h, fs)       => reach_names_list(fs, acc),
  LMakeVariant(_h, _t, fs)  => reach_names_list(fs, acc),
  LMatch(_h, s, arms)       => reach_match_arms(arms, reach_names_expr(s, acc)),
  // op_h (field 2) is an Int op-handle, NOT a reachable name — the callee is
  // reached via f (fn_expr). Prepending [o] enqueued a raw Int as a "name"; the
  // scan-based reach_decl_refs tolerated it (str_eq rejects on a length mismatch
  // before reading the garbage), but the O(1) index's str_hash iterates ALL
  // byte_len(o) bytes — o read as a string pointer lands in low scratch memory,
  // byte_len there is ~1.8e9, and str_hash hangs. Dropping [o] is byte-identical
  // (an Int is never a decl name, so it was always a dead no-op leaf).
  LSuspend(_h, _o, f, args, ev, _) =>
    reach_names_list(ev,
      reach_names_list(args, reach_names_expr(f, acc))),
  LFeedback(_h, b, s)       => reach_names_expr(s, reach_names_expr(b, acc)),
  LWasiCall(_h, _n, args)   => reach_names_list(args, acc),
  LEvPerform(_h, _n, _e, _s, a) => reach_names_list(a, acc),
  LEvRef(_h, _e)            => acc,
  LEvEntry(_, ev)           => reach_names_expr(ev, acc),
  LUnresolvedEvidence(_, _) => acc,
  LInvariantFailure(_, _)   => acc,
  LFieldLoad(_h, rec, _off) => reach_names_expr(rec, acc),
  LConvert(_h, _, operand)  => reach_names_expr(operand, acc),
  LStateSlotStore(_h, _o, v, _) => reach_names_expr(v, acc),
  LConst(_, _)              => acc,
  LLocal(_, _)              => acc,
  LFeedbackPrior(_)         => acc,
  LUpval(_, _)              => acc,
}

// The decl's emitted name — "" for statements that are not named fns
// (module value lets stay unconditionally; they run in __init_lets).
fn reach_decl_name(stmt) = match stmt {
  LDeclareFn(LFn(n, _, _, _, _, _))                  => n,
  LLet(_, n, LMakeClosure(_, _, _, _))               => n,
  LLet(_, n, LMakeContinuation(_, _, _, _, _, _, _)) => n,
  _                                                  => ""  // drift-audit: ignore — "" = stmt is not a named fn (module value lets run in __init_lets)
}

// The reached set and the frontier are flat buffer-counter pairs —
// membership is scanned per enqueue, so the reads must be O(1) flat
// indexing, never a concat-chain walk (the mode-11 law).
fn reach_has(buf, count, target: String) = reach_has_loop(buf, count, target, 0)

fn reach_has_loop(buf, count, target: String, i) = {
  if i >= count { false }
  else if list_index(buf, i) == target { true }
  else { reach_has_loop(buf, count, target, i + 1) }
}

fn reach_grow(index, rbuf, rn, fbuf, fcount) = {
  if fcount == 0 { (rbuf, rn) }
  else {
    let name = list_index(fbuf, fcount - 1)
    let refs = match smap_get(index, name) { Some(r) => r, None => [] }
    let rbuf2 = list_set(list_extend_to(rbuf, rn + 1), rn, name)
    let (fbuf2, fcount2) = reach_enqueue(refs, rbuf2, rn + 1, fbuf, fcount - 1)
    reach_grow(index, rbuf2, rn + 1, fbuf2, fcount2)
  }
}

// name → its outgoing edges, built ONCE over lowered (build_reach_index), read
// O(1) per frontier name (reach_index_get). The old reach_decl_refs LINEAR-
// SCANNED the whole lowered list per name AND re-walked each decl's nested
// bodies — O(N² × body), perf-pinned at 58.66% of the compile (2026-07-14).
// The container-keep truth it carried (reaching one arm reaches every sibling,
// so no fn-value edge dangles — emission == reachability) lives here: each arm
// name maps to its own refs ++ the container's full nested-name set. Unknown
// name → [] (the old len==0 fallthrough). The esc-proven build-then-read
// str_hash index; the deletion-ultimate is Hβ.lower.esc-row-on-node (a reach
// edge on the node), generalized by Hβ.perf.name-is-handle (§5.O).
// The name → outgoing-edges index is the shared smap (lib/runtime/imap.mn);
// a miss is [] (the old len==0 fallthrough), unwrapped from smap's Option.
// The tree-walk builders below keep their reach-specific shape (each arm name
// maps to its refs ++ the container's nested-name set), calling smap_new/add.

// ONE pass over lowered: each top-level decl's name → its refs, then every
// nested arm name → its refs ++ the container's nested-name set. Mirrors the
// exact structure reach_nested_refs/reach_nested_names walked per-lookup.
fn build_reach_index(lowered) with LookupTy + EnvRead + Memory + Alloc =
  build_reach_index_from(lowered, 0, smap_new())

fn build_reach_index_from(lowered, i, idx) with LookupTy + EnvRead + Memory + Alloc = {
  if i >= len(lowered) { idx }
  else {
    let d = list_index(lowered, i)
    let nm = reach_decl_name(d)
    let idx1 = if nm == "" { idx } else { smap_add(idx, nm, reach_names_expr(d, [])) }
    build_reach_index_from(lowered, i + 1, reach_index_add_children(d, reach_nested_names(d, []), idx1))
  }
}

// Walk INTO a decl (skipping its own top-level name — the top-level pass
// already added it without cnames) recording every nested arm fn.
fn reach_index_add_children(d, cnames, idx) with LookupTy + EnvRead + Memory + Alloc = match d {
  LDeclareFn(LFn(_n, _, _, body, _, _)) => reach_index_add_nested_list(body, cnames, idx),
  LBlock(_h, stmts)   => reach_index_add_nested_list(stmts, cnames, idx),
  LLet(_h, _n, inner) => reach_index_add_children(inner, cnames, idx),
  LIf(_h, _c, t, e)   => reach_index_add_nested_list(e, cnames, reach_index_add_nested_list(t, cnames, idx)),
  LHandleWith(_h, b, _hn, _hname, _inits, _an, _evs) => reach_index_add_children(b, cnames, idx),
  _ => idx
}

// A nested statement that may BE an arm fn: add it (body refs ++ cnames), then
// recurse into its body for deeper nesting.
fn reach_index_add_nested(stmt, cnames, idx) with LookupTy + EnvRead + Memory + Alloc = match stmt {
  LDeclareFn(LFn(n, _, _, body, _, _)) =>
    reach_index_add_nested_list(body, cnames,
      smap_add(idx, n, reach_names_list(body, []) ++ cnames)),
  LBlock(_h, stmts)   => reach_index_add_nested_list(stmts, cnames, idx),
  LLet(_h, _n, inner) => reach_index_add_nested(inner, cnames, idx),
  LIf(_h, _c, t, e)   => reach_index_add_nested_list(e, cnames, reach_index_add_nested_list(t, cnames, idx)),
  LHandleWith(_h, b, _hn, _hname, _inits, _an, _evs) => reach_index_add_nested(b, cnames, idx),
  _ => idx
}

fn reach_index_add_nested_list(stmts, cnames, idx) with LookupTy + EnvRead + Memory + Alloc = {
  if len(stmts) == 0 { idx }
  else { reach_index_add_nested_list(drop_last(stmts), cnames, reach_index_add_nested(last(stmts), cnames, idx)) }
}

// Every nested decl name a container holds — the container LIVES iff
// any of them was reached (installing a handler makes every arm
// dispatchable, so arms keep whole-container).
fn reach_nested_names(d, acc) = match d {
  LDeclareFn(LFn(n, _, _, body, _, _)) =>
    reach_nested_names_list(body, [n] ++ acc),
  LBlock(_h, stmts)   => reach_nested_names_list(stmts, acc),
  LLet(_h, _n, inner) => reach_nested_names(inner, acc),
  LIf(_h, _c, t, e)   => reach_nested_names_list(e, reach_nested_names_list(t, acc)),
  LHandleWith(_h, b, _hn, _hname, _inits, _an, _evs) =>
    reach_nested_names(b, acc),
  _ => acc
}

fn reach_nested_names_list(stmts, acc) = {
  if len(stmts) == 0 { acc }
  else { reach_nested_names_list(drop_last(stmts), reach_nested_names(last(stmts), acc)) }
}

fn reach_any_reached(names, rbuf, rn) = {
  if len(names) == 0 { false }
  else if reach_has(rbuf, rn, last(names)) { true }
  else { reach_any_reached(drop_last(names), rbuf, rn) }
}

// Queue each ref not already reached or queued — the set stays a set.
fn reach_enqueue(refs, rbuf, rn, fbuf, fcount) = {
  if len(refs) == 0 { (fbuf, fcount) }
  else {
    let n = last(refs)
    if reach_has(rbuf, rn, n) || reach_has(fbuf, fcount, n) {
      reach_enqueue(drop_last(refs), rbuf, rn, fbuf, fcount)
    } else {
      reach_enqueue(drop_last(refs), rbuf, rn,
        list_set(list_extend_to(fbuf, fcount + 1), fcount, n), fcount + 1)
    }
  }
}

// The surviving-hole census over the REACHABLE emitted tree — the executable
// gate's one read (pipeline.mn executable_gate). Survival IS value-position
// by construction: a call-arg hole became a partial param (the fork), a
// pipe-stage hole was spliced over (lower_pipe_complete), so an authored
// NHole still riding an LConst in the tree is exactly the hole the
// executable cannot carry (SYNTAX §«Partial application» — productive,
// never executable). One pass, O(1) per node (authored_hole is one graph
// read); the arm set mirrors singleton_hnames_expr — the two walk in
// lockstep with LowExpr.
// The gate's hole classifier reads the WEAVE span (parse_span_of) — the
// parse truth no unification overwrites: a body/let-init hole unifies with
// its binder's fresh var, the class root becomes that unlocated mint, and
// the reason-flavored caret collapses to span_zero (the miss that let
// `fn main() = ??` slip the gate). The compile tree is a SINGLE parse
// generation, so the session-weave multiplicity that forces the cursor's
// authored_hole onto the caret test (cursor.mn) cannot occur here; the two
// reads re-unify under Hβ.cursor.session-weave-epoch-scope.
fn executable_hole(handle) with GraphRead + !Mutate = match graph_node_body(handle) {
  NHole(id) => id != 0 && !span_eq(parse_span_of(handle), span_zero()),
  _         => false
}

fn collect_value_holes_list(stmts, acc) = {
  if len(stmts) == 0 { acc }
  else { collect_value_holes_list(drop_last(stmts), collect_value_holes_expr(last(stmts), acc)) }
}

fn collect_value_holes_expr(expr, acc) = match expr {
  LConst(h, _)              => if executable_hole(h) { [h] ++ acc } else { acc },
  LShow(_h, x)              => collect_value_holes_expr(x, acc),
  LHash(_h, x)              => collect_value_holes_expr(x, acc),
  LHandleWith(_h, b, hn, _hname, inits, _an, evs) =>
    collect_value_holes_list(evs,
      collect_value_holes_list(inits,
        collect_value_holes_expr(hn, collect_value_holes_expr(b, acc)))),
  LLet(_h, _n, inner)       => collect_value_holes_expr(inner, acc),
  LMakeClosure(_h, LFn(_n, _a, _p, body, _r, _f), caps, ev) =>
    collect_value_holes_list(ev, collect_value_holes_list(caps, collect_value_holes_list(body, acc))),
  LMakeContinuation(_h, LFn(_n, _a, _p, body, _r, _f), caps, ev, _, _, _) =>
    collect_value_holes_list(ev, collect_value_holes_list(caps, collect_value_holes_list(body, acc))),
  LYield(_h, _op, args, k)  => collect_value_holes_expr(k, collect_value_holes_list(args, acc)),
  LKExtend(_h, k)           => collect_value_holes_expr(k, acc),
  LDeclareFn(LFn(_n, _a, _p, body, _r, _f)) => collect_value_holes_list(body, acc),
  LBlock(_h, stmts)         => collect_value_holes_list(stmts, acc),
  LIf(_h, c, t, e)          =>
    collect_value_holes_list(e, collect_value_holes_list(t, collect_value_holes_expr(c, acc))),
  LBinOp(_h, _op, lx, r)    => collect_value_holes_expr(r, collect_value_holes_expr(lx, acc)),
  LUnaryOp(_h, _op, x)      => collect_value_holes_expr(x, acc),
  LCall(_h, f, args)        => collect_value_holes_list(args, collect_value_holes_expr(f, acc)),
  LTailCall(_h, f, args)    => collect_value_holes_list(args, collect_value_holes_expr(f, acc)),
  LReturn(_h, x)            => collect_value_holes_expr(x, acc),
  LMakeList(_h, elems)      => collect_value_holes_list(elems, acc),
  LMakeTuple(_h, elems)     => collect_value_holes_list(elems, acc),
  LSimdLanes(_h, lanes)     => collect_value_holes_list(lanes, acc),
  LMakeRecord(_h, fs)       => collect_value_holes_list(fs, acc),
  LMakeVariant(_h, _t, fs)  => collect_value_holes_list(fs, acc),
  LMatch(_h, s, arms)       => collect_value_holes_arms(arms, collect_value_holes_expr(s, acc)),
  LSuspend(_h, _o, f, args, ev, _) =>
    collect_value_holes_list(ev, collect_value_holes_list(args, collect_value_holes_expr(f, acc))),
  LFeedback(_h, b, s)       => collect_value_holes_expr(s, collect_value_holes_expr(b, acc)),
  LPerform(_h, _n, args, _) => collect_value_holes_list(args, acc),
  LWasiCall(_h, _n, args)   => collect_value_holes_list(args, acc),
  LEvPerform(_h, _n, _e, _s, a) => collect_value_holes_list(a, acc),
  LEvRef(_h, _e)            => acc,
  LEvEntry(_, ev)           => collect_value_holes_expr(ev, acc),
  LUnresolvedEvidence(_, _) => acc,
  LInvariantFailure(_, _)   => acc,
  LFieldLoad(_h, rec, _off) => collect_value_holes_expr(rec, acc),
  LConvert(_h, _, operand)  => collect_value_holes_expr(operand, acc),
  LStateSlotStore(_h, _o, v, _) => collect_value_holes_expr(v, acc),
  LFnRef(_h, _n, ev)        => collect_value_holes_list(ev, acc),
  LLocal(_, _)              => acc,
  LFeedbackPrior(_)         => acc,
  LGlobal(_, _)             => acc,
  LUpval(_, _)              => acc,
}

fn collect_value_holes_arms(arms, acc) = {
  if len(arms) == 0 { acc }
  else {
    let (_, body) = last(arms)
    collect_value_holes_arms(drop_last(arms), collect_value_holes_expr(body, acc))
  }
}

fn collect_value_holes_decls(lowered) =
  collect_value_holes_list(lowered, [])

// A type NAMES a wide-element sequence — directly or nested — when some
// reachable sub-shape is a sequence whose element face (chased through any
// binding, §4①) rides a stride >= 8 (the f64/i64/v128 slot that crosses the
// generic layer by reference). The recursion mirrors eq_subtys' aggregate
// descent, so a {xs: [Float]} record or an ADT with a [Float] payload counts:
// emit's generated eq/show/hash leaf recurses to that field and mints the same
// f64 runtime call the flat case does. `seen` guards recursive ADTs.
fn ty_has_wide_seq(t, seen) = match fold_strip(t) {
  TList(e)               => stride_of(seq_elem_face(e)) >= 8 || ty_has_wide_seq(e, seen),
  TRecord(fields)        => any((f) => { let (_n, fty) = f; ty_has_wide_seq(fty, seen) }, fields),
  TRecordOpen(fields, _) => any((f) => { let (_n, fty) = f; ty_has_wide_seq(fty, seen) }, fields),
  TTuple(elems)          => any((x) => ty_has_wide_seq(x, seen), elems),
  TName(name, _) =>
    if ls_find_str_local(seen, name, 0) >= 0 { false }
    else { any((s) => { let (_tag, payloads) = s
                        any((p) => ty_has_wide_seq(p, [name] ++ seen), payloads) },
               variant_specs_of(name)) },
  _ => false
}

// The wide runtime family is emit-minted BY NAME at the SAME sites emit reads a
// type's structural op: an ==/ordering LBinOp mints list_eq_f64/list_compare_f64
// (emit_eq_for_ty / emit_cmp_for_ty), a show/hash call mints float_to_str /
// list_hash_f64. Seeding the reach frontier from the operand's live type at
// those nodes is the visitor-walk projection the runtime-contract comment names
// (backends/wasm.mn) — the reach walk reads what emit will mint, never a hand-
// copied guess, and a float-free program contributes nothing.
fn wide_binop_seed(op, l) =
  if ty_has_wide_seq(lookup_ty(lexpr_handle(l)), []) {
    match op {
      BEq => ["list_eq_f64"],      BNe => ["list_eq_f64"],
      BLt => ["list_compare_f64"], BGt => ["list_compare_f64"],
      BLe => ["list_compare_f64"], BGe => ["list_compare_f64"],
      _   => []
    }
  } else { [] }

// The show/hash reach projections — the exact names emit's show_node_of /
// hash_node_of will mint for this operand's type, plus the generated
// aggregate leaf's INTERIOR renderers (str_concat rides the runtime
// contract; int_to_str / float_to_str do not, and the aggregate body calls
// them directly). sig_has_d reads the fold signature for a float ANYWHERE
// in the shape — the same one-scan the leaf generators key on.
fn sig_has_d(sig, i) with Memory =
  if i >= byte_len(sig) { false }
  else if byte_at(sig, i) == 100 { true }
  else { sig_has_d(sig, i + 1) }

fn show_reach_names(x) with LookupTy + Memory + Alloc = {
  let ty = fold_strip(lookup_ty(lexpr_handle(x)))
  match ty {
    TString            => [],
    TList(TByte)       => [],
    TFloat             => ["float_to_str"],
    TList(_)           => show_agg_reach(ty),
    TTuple(_)          => show_agg_reach(ty),
    TName(_, _)        => show_agg_reach(ty),
    TRecord(_)         => show_agg_reach(ty),
    TRecordOpen(_, _)  => show_agg_reach(ty),
    _                  => ["int_to_str"]
  }
}

fn show_agg_reach(ty) with Memory + Alloc = {
  let sig = fold_sig(ty)
  if sig_has_d(sig, 0) { ["float_to_str", "int_to_str"] } else { ["int_to_str"] }
}

fn hash_reach_names(x) with LookupTy + Memory + Alloc = {
  let ty = fold_strip(lookup_ty(lexpr_handle(x)))
  match ty {
    TString            => ["str_hash"],
    TList(e)           =>
      if stride_of(seq_elem_face(e)) >= 8 { ["list_hash_f64", "float_to_str", "str_hash"] }
      else { ["list_hash"] },
    TFloat             => ["float_to_str", "str_hash"],
    TRecord(_)         => hash_agg_reach(ty),
    TRecordOpen(_, _)  => hash_agg_reach(ty),
    TTuple(_)          => hash_agg_reach(ty),
    TName(_, _)        => hash_agg_reach(ty),
    _                  => []
  }
}

fn hash_agg_reach(ty) with Memory + Alloc = {
  let sig = fold_sig(ty)
  if sig_has_d(sig, 0) { ["float_to_str", "str_hash", "list_hash"] }
  else { ["str_hash", "list_hash"] }
}

// ─── Named-generic specialization — monomorphization by repr key ─────────
//
// A named generic fn compiles ONCE at the word floor. The word protocol makes
// that floor CORRECT for plumbing (a fold shell shuttles wide references
// untouched), but WRONG the moment the body OPERATES on a quantified var at a
// wide instantiation: the i32-floored `<=`/`+` reads the f64 references as
// words, so prelude sort returns its input in ALLOCATION order and
// `reduce(xs, min)` picks by address (tests/frontier/mn-generic-float-*).
//
// The fix is a TWIN emission of the same body under the site's instantiation —
// and the instantiation is a PROJECTION, never a record: the unifier already
// merged each call's argument classes into the scheme's var classes, so
// walking the scheme's type (its TVar leaves are the quantified roots —
// generalize chase-deeps first) against the site's instantiated type in
// parallel reads the var→type mapping live off the union-find (Carried-Truth:
// zero new storage, zero infer changes). The twin itself is the SAME emit
// under the spec_wty state: the LookupTy handler answers lookup_ty through the
// mapping, so every repr read downstream — param widths, binop dispatch,
// element faces — specializes untouched, and interior call sites project
// their keys UNDER the substitution, keeping a web (sort → merge → merge)
// in-key transitively with no recursion special-case.
//
// The key is the repr digit vector over the scheme's quantified vars, sorted
// by root handle — tiny, and maximally shared: every word instantiation IS
// the floor emission ([Int], String, records — byte-identical, Law 7); only
// a genuinely wide var mints a twin ($min$sp2 = min with its one var at f64).

fn spec_pairs_find(pairs, root) with Memory = {
  match find((p) => { let (v, _) = p; v == root }, pairs) {
    Some(p) => { let (_, t) = p; Some(t) },
    None    => None
  }
}

fn spec_pairs_add(pairs, root, t) with Memory + Alloc = match spec_pairs_find(pairs, root) {
  Some(_) => pairs,             // first binding wins; the unifier proved consistency
  None    => [(root, t)] ++ pairs
}

// Deep site-type resolution THROUGH the LookupTy effect — under the spec_wty state
// a substituted var resolves to its concrete, so interior sites in a twin
// project their keys against the specialized truth.
fn spec_resolve(t) with LookupTy + Memory + Alloc = match t {
  TVar(h) => match lookup_ty(h) {
    TVar(h2) => TVar(h2),       // genuinely free — the floor terminal
    other    => spec_resolve(other)
  },
  TList(e)          => TList(spec_resolve(e)),
  TTuple(es)        => TTuple(map((x) => spec_resolve(x), es)),
  TFun(ps, r, eff)  => TFun(map((p) => param_with_ty(p, spec_resolve(param_ty(p))), ps),
                            spec_resolve(r), eff),
  TName(n, args)    => TName(n, map((x) => spec_resolve(x), args)),
  TRecord(fs)       => TRecord(map((f) => { let (n, ft) = f; (n, spec_resolve(ft)) }, fs)),
  TRecordOpen(fs, v) => mk_record_open(map((f) => { let (n, ft) = f; (n, spec_resolve(ft)) }, fs), v),
  TRefined(b, p)    => TRefined(spec_resolve(b), p),
  TAlias(n, i)      => TAlias(n, spec_resolve(i)),
  TCont(i, a, d, w) => TCont(spec_resolve(i), spec_resolve(a), d, w),
  _ => t                        // scalars (TInt/TFloat/TString/TUnit/TByte)
}

// The parallel walk: scheme side vs site side, same shape by construction
// (the unifier made them agree); a shape mismatch is an error path already
// reported — collect nothing there, the floor stands (never fabricate).
fn spec_pairs_walk(st0, it0, acc) with LookupTy + GraphRead + Memory + Alloc = {
  let st = fold_strip(st0)
  match st {
    TVar(v) => spec_pairs_add(acc, graph_chase_handle(v), it0),
    TList(e) => match fold_strip(it0) {
      TList(ie) => spec_pairs_walk(e, ie, acc), _ => acc },
    TTuple(es) => match fold_strip(it0) {
      TTuple(ies) => spec_pairs_walk_list(es, ies, acc), _ => acc },
    TFun(ps, r, _) => match fold_strip(it0) {
      TFun(ips, ir, _) => spec_pairs_walk(r, ir, spec_pairs_walk_params(ps, ips, acc)),
      _ => acc },
    TName(_, args) => match fold_strip(it0) {
      TName(_, iargs) => spec_pairs_walk_list(args, iargs, acc), _ => acc },
    TRecord(fs) => match fold_strip(it0) {
      TRecord(ifs) => spec_pairs_walk_fields(fs, ifs, acc),
      TRecordOpen(ifs, _) => spec_pairs_walk_fields(fs, ifs, acc), _ => acc },
    TRecordOpen(fs, _) => match fold_strip(it0) {
      TRecord(ifs) => spec_pairs_walk_fields(fs, ifs, acc),
      TRecordOpen(ifs, _) => spec_pairs_walk_fields(fs, ifs, acc), _ => acc },
    TCont(i1, a1, _, _) => match fold_strip(it0) {
      TCont(i2, a2, _, _) => spec_pairs_walk(a1, a2, spec_pairs_walk(i1, i2, acc)),
      _ => acc },
    _ => acc                    // scalars carry no vars
  }
}

fn spec_pairs_walk_list(sts, its, acc) with LookupTy + GraphRead + Memory + Alloc = {
  if len(sts) == 0 || len(its) == 0 { acc }
  else { spec_pairs_walk_list(rest(sts), rest(its),
           spec_pairs_walk(sts[0], its[0], acc)) }
}

fn spec_pairs_walk_params(ps, ips, acc) with LookupTy + GraphRead + Memory + Alloc = {
  if len(ps) == 0 || len(ips) == 0 { acc }
  else { spec_pairs_walk_params(rest(ps), rest(ips),
           spec_pairs_walk(param_ty(ps[0]), param_ty(ips[0]), acc)) }
}

// Fields pair by NAME (both sides parse-sorted); a missing partner is an
// error path — skip, never fabricate.
fn spec_pairs_walk_fields(fs, ifs, acc) with LookupTy + GraphRead + Memory + Alloc = {
  if len(fs) == 0 { acc }
  else {
    let (n, ft) = fs[0]
    let acc2 = match find((g) => { let (gn, _) = g; field_name_eq(gn, n) }, ifs) {
      Some(g) => { let (_, gt) = g; spec_pairs_walk(ft, gt, acc) },
      None    => acc
    }
    spec_pairs_walk_fields(rest(fs), ifs, acc2)
  }
}

// Sorted by root handle — the canonical order the enc digits read.
fn spec_pairs_sorted_insert(sorted, p) with Memory + Alloc = {
  if len(sorted) == 0 { [p] }
  else {
    let (v, _) = p
    let (v0, _) = sorted[0]
    if v <= v0 { [p] ++ sorted }
    else { [sorted[0]] ++ spec_pairs_sorted_insert(rest(sorted), p) }
  }
}

fn spec_pairs_sort(pairs) with Memory + Alloc = fold([], (acc, p) => spec_pairs_sorted_insert(acc, p), pairs)

fn spec_repr_digit(t) with Memory = match repr_of(t) {
  RI32 => "0", RI64 => "1", RF64 => "2", RF32 => "3", RV128 => "4"
}

// A pair's enc code: wide scalars keep their repr digits (existing twin
// names stay stable — Law 7), and a STRUCTURED concrete — record, tuple,
// string, list, named sum — encodes as its fold_sig, the deterministic
// name-safe type signature. A repr digit cannot say WHICH record closed
// the var, and the all-'0' floor test was silently ejecting every
// structure-bound site from candidacy (the field-heal gate).
fn spec_pair_code(t) with Memory + Alloc = match fold_strip(t) {
  TInt  => spec_repr_digit(t),
  TByte => spec_repr_digit(t),
  TUnit => spec_repr_digit(t),
  TFloat => spec_repr_digit(t),
  TVar(_) => spec_repr_digit(t),
  _ => fold_sig(t)
}

fn spec_enc(pairs) with Memory + Alloc = fold("", (acc, p) => { let (_, t) = p; acc ++ spec_pair_code(t) }, pairs)

fn spec_enc_is_floor(enc) with Memory = spec_enc_floor_loop(enc, 0, byte_len(enc))

fn spec_enc_floor_loop(enc, i, n) with Memory = {
  if i >= n { true }
  else if byte_at(enc, i) != 48 { false }   // '0'
  else { spec_enc_floor_loop(enc, i + 1, n) }
}

fn spec_mangle(name, enc) with Memory + Alloc = "{name}$sp{enc}"

// The site's instantiation pairs — [] when the name is not generic: a value
// let, a monomorphic fn, or an internal synthesized name. The scheme's
// quantified vars are the roots; the site's chased type carries the bindings.
fn spec_site_pairs_resolved(name: String, rt) with EnvRead + LookupTy + GraphRead + Memory + Alloc = match env_lookup(name) {
  None => [],
  Some(entry) => {
    let (scheme, _r, kind) = entry
    match kind {
      FnScheme => match scheme {
        Forall(qs, sty) =>
          if len(qs) == 0 { [] }
          else { spec_pairs_sort(spec_pairs_walk(sty, rt, [])) }
      },
      _ => []                   // ctor / record / effect-op / value schemes never specialize
    }
  }
}

fn spec_site_pairs(h, name: String) with EnvRead + LookupTy + GraphRead + Memory + Alloc =
  spec_site_pairs_resolved(name, spec_resolve(lookup_ty(h)))

// The ONE naming projection every reference-emitting arm reads: the site's
// key, mangled when any var lands wide, the plain name at the floor.
fn spec_global_name(h, name: String) with EnvRead + LookupTy + GraphRead + Memory + Alloc = {
  let pairs = spec_site_pairs(h, name)
  if len(pairs) == 0 { name }
  else {
    let enc = spec_enc(pairs)
    if spec_enc_is_floor(enc) { name } else { spec_mangle(name, enc) }
  }
}

// Exact root-keyed substitution — the twin's one rule. Sound since the
// subscript fracture fix (Force = UNIFY at IndexExpr): a generic body's
// element classes and the scheme's quantified vars are ONE union-find root,
// so a free leaf answers its OWN root's binding in the site's instantiation
// pairs — and a free var whose root is NOT in the pairs stays the honest
// floor TVar. This is the precision the interim free-leaf rule (every free =
// the one wide type) could not have, and it lifts the one-wide-type demand
// guard: multi-type generics (a := Float, b := Int) twin correctly.
fn spec_pair_or_var(u, pairs) with GraphRead + Memory + Alloc =
  match spec_pairs_find(pairs, graph_chase_handle(u)) {
    Some(c) => c,
    None    => TVar(u)
  }

fn spec_subst_pairs(t, pairs) with GraphRead + Memory + Alloc = match t {
  TVar(u) => {
    let GNode(kind, _r) = graph_chase(u)
    match kind {
      NBound(t2)         => spec_subst_pairs(t2, pairs),
      NFree(_)           => spec_pair_or_var(u, pairs),
      NErrorHole(_)      => spec_pair_or_var(u, pairs),
      NRowBound(_)       => t,
      NRecordRowBound(_) => t,
      NRowFree(_)        => t
    }
  },
  TList(e)          => TList(spec_subst_pairs(e, pairs)),
  TTuple(es)        => TTuple(map((x) => spec_subst_pairs(x, pairs), es)),
  TFun(ps, r, eff)  => TFun(map((p) => param_with_ty(p, spec_subst_pairs(param_ty(p), pairs)), ps),
                            spec_subst_pairs(r, pairs), eff),
  TName(n, args)    => TName(n, map((x) => spec_subst_pairs(x, pairs), args)),
  TRecord(fs)       => TRecord(map((f) => { let (n, ft) = f; (n, spec_subst_pairs(ft, pairs)) }, fs)),
  TRecordOpen(fs, v) => mk_record_open(map((f) => { let (n, ft) = f; (n, spec_subst_pairs(ft, pairs)) }, fs), v),
  TRefined(b, p)    => TRefined(spec_subst_pairs(b, pairs), p),
  TAlias(n, i)      => TAlias(n, spec_subst_pairs(i, pairs)),
  TCont(i, a, d, w) => TCont(spec_subst_pairs(i, pairs), spec_subst_pairs(a, pairs), d, w),
  _ => t
}

// ONE scan, two projections: the named-reference sites (LGlobal / LFnRef,
// with their handles — the key-projection inputs) and the repr-sensitive
// operand handles (arith / comparison / equality operands — the floor-is-
// wrong witnesses the worthiness predicate reads). acc = (sites, ophs).
fn spec_scan_expr(expr, acc) with Memory + Alloc = match expr {
  LGlobal(h, n)             => { let (s, o) = acc; ([(h, n)] ++ s, o) },
  LFnRef(h, n, ev)          => { let (s, o) = spec_scan_list(ev, acc); ([(h, n)] ++ s, o) },
  LPerform(_h, _t, args, _) => spec_scan_list(args, acc),
  LHandleWith(_h, b, hn, _hname, inits, _arms, evs) =>
    spec_scan_list(evs, spec_scan_list(inits, spec_scan_expr(hn, spec_scan_expr(b, acc)))),
  LLet(_h, _n, inner)       => spec_scan_expr(inner, acc),
  LMakeClosure(_h, LFn(_n, _a, _p, body, _r, _f), caps, ev) =>
    spec_scan_list(ev, spec_scan_list(caps, spec_scan_list(body, acc))),
  LMakeContinuation(_h, LFn(_n, _a, _p, body, _r, _f), caps, ev, _, _, _) =>
    spec_scan_list(ev, spec_scan_list(caps, spec_scan_list(body, acc))),
  LYield(_h, _op, args, k)  => spec_scan_expr(k, spec_scan_list(args, acc)),
  LKExtend(_h, k)           => spec_scan_expr(k, acc),
  LDeclareFn(LFn(_n, _a, _p, body, _r, _f)) => spec_scan_list(body, acc),
  LBlock(_h, stmts)         => spec_scan_list(stmts, acc),
  LIf(_h, c, t, e)          => spec_scan_list(e, spec_scan_list(t, spec_scan_expr(c, acc))),
  LShow(_h, x)              => {
    let (s, o) = spec_scan_expr(x, acc)
    (s, [lexpr_handle(x)] ++ o)
  },
  LHash(_h, x)              => {
    let (s, o) = spec_scan_expr(x, acc)
    (s, [lexpr_handle(x)] ++ o)
  },
  LBinOp(_h, op, l, r)      => {
    let acc2 = match op {
      BAdd | BSub | BMul | BDiv | BMod | BEq | BNe | BLt | BGt | BLe | BGe => {
        let (s, o) = acc
        (s, [lexpr_handle(l)] ++ ([lexpr_handle(r)] ++ o))
      },
      _ => acc
    }
    spec_scan_expr(r, spec_scan_expr(l, acc2))
  },
  LUnaryOp(_h, _op, x)      => spec_scan_expr(x, acc),
  LCall(_h, f, args)        => spec_scan_list(args, spec_scan_expr(f, acc)),
  LTailCall(_h, f, args)    => spec_scan_list(args, spec_scan_expr(f, acc)),
  LReturn(_h, x)            => spec_scan_expr(x, acc),
  LMakeList(_h, elems)      => spec_scan_list(elems, acc),
  LMakeTuple(_h, elems)     => spec_scan_list(elems, acc),
  LSimdLanes(_h, lanes)     => spec_scan_list(lanes, acc),
  LMakeRecord(_h, fs)       => spec_scan_list(fs, acc),
  LMakeVariant(_h, _t, fs)  => spec_scan_list(fs, acc),
  LMatch(_h, s, arms)       => spec_scan_arms(arms, spec_scan_expr(s, acc)),
  LSuspend(_h, _o, f, args, ev, _) =>
    spec_scan_list(ev, spec_scan_list(args, spec_scan_expr(f, acc))),
  LFeedback(_h, b, s)       => spec_scan_expr(s, spec_scan_expr(b, acc)),
  LWasiCall(_h, _n, args)   => spec_scan_list(args, acc),
  LEvPerform(_h, _n, _e, _s, a) => spec_scan_list(a, acc),
  LEvRef(_h, _e)            => acc,
  LEvEntry(_, ev)           => spec_scan_expr(ev, acc),
  LUnresolvedEvidence(_, _) => acc,
  LInvariantFailure(_, _)   => acc,
  // A field-load receiver is a STRUCTURE witness: a var-rooted receiver
  // bound at a site to a concrete record/tuple heals under that site's twin.
  LFieldLoad(_h, rec, _sel) => {
    let (s2, o) = spec_scan_expr(rec, acc)
    (s2, [lexpr_handle(rec)] ++ o)
  },
  LConvert(_h, _, operand)  => spec_scan_expr(operand, acc),
  LStateSlotStore(_h, _o, v, _) => spec_scan_expr(v, acc),
  LConst(_, _)              => acc,
  LLocal(_, _)              => acc,
  LFeedbackPrior(_)         => acc,
  LUpval(_, _)              => acc,
}

fn spec_scan_list(exprs, acc) with Memory + Alloc = fold(acc, (a, e) => spec_scan_expr(e, a), exprs)

fn spec_scan_arms(arms, acc) with Memory + Alloc = fold(acc, (a, arm) => { let (_, b) = arm; spec_scan_expr(b, a) }, arms)

// The wide runtime family a twin's emission can mint that its floor did not
// (the same names wide_binop_seed / show_reach_names contribute at concrete
// sites). Seeded whenever ANY site projects a wide key — a cheap, precise-
// enough over-approximation in the emit_runtime_contract tradition; a
// program with no wide instantiation adds nothing.
fn spec_wide_family() with Memory + Alloc = ["float_to_str", "list_compare_f64", "list_eq_f64", "list_hash_f64"]

fn spec_site_is_wide(site) with EnvRead + LookupTy + GraphRead + Memory + Alloc = {
  let (h, n) = site
  let pairs = spec_site_pairs(h, n)
  if len(pairs) == 0 { false } else { !spec_enc_is_floor(spec_enc(pairs)) }
}

fn spec_reach_seed(lowered) with EnvRead + LookupTy + GraphRead + Memory + Alloc = {
  let (sites, _ophs) = fold(([], []), (a, d) => spec_scan_expr(d, a), lowered)
  if any(spec_site_is_wide, sites) { spec_wide_family() } else { [] }
}

fn reachable_from_main(lowered) = {
  let has_main = any((d) => reach_decl_name(d) == "main", lowered)
  if !has_main { lowered }   // a library emits whole
  else {
    // Roots: main + every value-let init's references (they RUN before
    // main in __init_lets, so their callees are live by construction).
    let init_refs = fold([], (acc, d) => match d {
      LLet(_, _, LMakeClosure(_, _, _, _))               => acc,
      LLet(_, _, LMakeContinuation(_, _, _, _, _, _, _)) => acc,
      LLet(_, _, init)                                   => reach_names_expr(init, acc),
      _                                                  => acc
    }, lowered)
    let index = build_reach_index(lowered)   // name → edges, ONE pass, O(1) read
    // _start reads live argv via wasi_args ONLY when main takes it
    // (Hβ.emit.wasi-argv-in-start); root it just then, so a 0-param main()
    // (the micros, which don't link io.mn) never pulls an undefined $wasi_args.
    let argv_root = if main_param_count(lowered) > 0 { ["wasi_args"] } else { [] }
    // The wide runtime family (the f64 leaves + float renderer) is contributed
    // by reach_names_expr AT its mint sites (the ==/ordering LBinOp, the
    // show/hash call), so it flows through the index like every other edge — no
    // separate root, and a float-free program adds nothing.
    // A wide-keyed generic site means emit may mint twins whose bodies mint
    // the f64 structural family the floor never referenced — seed it here so
    // the prune keeps what the twins will call (spec_reach_seed: [] when no
    // wide instantiation exists anywhere).
    let (fbuf0, fc0) = reach_enqueue(init_refs ++ emit_runtime_contract() ++ argv_root
        ++ spec_reach_seed(lowered),
      make_list(16), 0,
      list_set(list_extend_to(make_list(16), 1), 0, "main"), 1)
    let (rbuf, rn) = reach_grow(index, make_list(16), 0, fbuf0, fc0)
    filter((d) => {
      let n = reach_decl_name(d)
      if n == "" {
        // A name-less statement is a value let (always runs) or a
        // handler-decl container: the container lives iff any nested
        // arm was reached; with no nested decls it is unconditionally
        // live (its init executes).
        let nested = reach_nested_names(d, [])
        len(nested) == 0 || reach_any_reached(nested, rbuf, rn)
      } else { reach_has(rbuf, rn, n) }
    }, lowered)
  }
}
