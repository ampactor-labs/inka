// main.mn — the executable manifest (per EH-entry-handlers.md §1.4
// + CLI-canonical-vocabulary.md). One file. One function. The `~>`
// chain IS the manifest. What the program has access to is visible
// on the page. No JSON config. No TOML lockfile. The type system
// IS the package manager.
//
// IC.4: compile / check / etc take entry-MODULE names (e.g.
// "compiler/main") instead of raw sources. The driver walks
// imports, consults .kai caches, re-infers only what changed.
//
// CLI canonical vocabulary (per docs/specs/simulations/CLI-canonical-vocabulary.md):
//
//   mentl                       → bare; defaults to teach_run
//   mentl edit [path] [--port=N] → canonical Web IDE (browser-WASM holographic)
//   mentl doc [path]             → documentation projection (F.1 substrate)
//   mentl serve                  → LSP transport on stdio
//   mentl compile <path>         → emit WAT to stdout
//   mentl run <path>             → compile + wasmtime execute
//   mentl check <path>           → diagnostics; no emit
//   mentl test [path]            → test handler chain
//   mentl audit <path>           → capability set + severance suggestions
//   mentl query <path> <q>       → structured ad-hoc query
//   mentl teach [path]           → terminal voice surface; gradient narration
//   mentl repl                   → line REPL over current env
//   mentl new <name>             → scaffold new project from lib/tutorial/00-hello.mn
//   mentl --with <handler>       → universal escape hatch; resolves by env_lookup
//
// Drift 38 (mascot-as-tentacle-prefix per CLAUDE.md red-flag table):
// project-action verbs are canonical (the binary IS named Mentl;
// subcommand prefix is structural like `git commit` / `cargo build`).
// Tentacle-named verbs (Trace / Why / Propose / Unlock / Verify /
// Topology) that shadow at-cursor projections would be drift 38 —
// see tools/drift-patterns.tsv mode 38 + CLI-canonical-vocabulary.md
// §3.3 for the line. `teach` and `query` are project-action peer
// transports (canonical) for terminal users — those tentacle names
// have legitimate CLI semantics that the per-cursor projection
// inside the medium does not duplicate.
//
// Module names map to paths: `main` → `src/main.mn`. Strip `src/` or
// `lib/` prefixes and `.mn` suffix from a path to get the module name.
//
// The outermost handlers — diagnostics, wat_stdout, wasi_filesystem,
// terminal_transport — are the sandbox boundary. Every inward
// handler receives narrower capability.

import pipeline
import query
import infer
import backends/wasm
import dsp/clock
import voice
import lsp
import driver
import cursor
import cursor_transport
import cursor_cache
import gradient_delta
import synth_proposer
import eight_loop
import oracle
import test
import runtime/io

// ─── EntryVerb ADT — the verb carries its target where required ───────
//
// Each variant IS the entry-handler, structured. A target-requiring verb
// (Compile/Run/Check/Audit/Query) carries its module name as a NON-OPTION
// field — so "compile with no target" is unrepresentable; no `""` sentinel
// can flow downstream (Anchor 2: the illegal state is deleted at the type
// level, not fabricated and re-checked). Verbs with an optional target
// (Edit/Doc/Teach/Test) carry an Option; verbs with none (Serve/Repl) carry
// nothing. Dispatch matches the ADT structurally — never a string re-compare
// (drift 8): parse_cli_args proved the verb, and dispatch reads that proof.

type EntryVerb
  = VEdit(Option(String))            // target optional → default "main"
  | VDoc(Option(String))
  | VServe
  | VCompile(String)                 // target REQUIRED — carried non-optionally
  | VCompileStdin
  | VRun(String)
  | VCheck(String)
  | VTest(Option(String))
  | VAudit(String)
  | VQuery(String, String)           // target, question — both required
  | VTeach(Option(String))
  | VRepl
  | VNew(String)                     // project name — required
  | VWith(String, Option(String))    // handler name, optional target

type EntryHandlerInvocation
  = Invocation(EntryVerb)
  | ParseError(String)

// ─── argv parsing ─────────────────────────────────────────────────
//
// Projects argv to the EntryVerb ADT at the ONE boundary. Bare `mentl` →
// VCompileStdin (Unix `cmd <input`). `--with <name>` is the universal
// escape hatch. A target-requiring verb given no target is a ParseError
// here (the one boundary), never a fabricated "" downstream.

fn parse_cli_args(argv) with Pure = {
  if len(argv) < 2 { Invocation(VCompileStdin) }
  else {
    let mode = argv[1]
    if mode == "edit" {
      Invocation(VEdit(optional_target(argv, 2)))
    } else if mode == "doc" {
      Invocation(VDoc(optional_target(argv, 2)))
    } else if mode == "serve" {
      Invocation(VServe)
    } else if mode == "compile" && len(argv) >= 3 {
      Invocation(VCompile(path_to_module(argv[2])))
    } else if mode == "run" && len(argv) >= 3 {
      Invocation(VRun(path_to_module(argv[2])))
    } else if mode == "check" && len(argv) >= 3 {
      Invocation(VCheck(path_to_module(argv[2])))
    } else if mode == "test" {
      Invocation(VTest(optional_target(argv, 2)))
    } else if mode == "audit" && len(argv) >= 3 {
      Invocation(VAudit(path_to_module(argv[2])))
    } else if mode == "query" && len(argv) >= 4 {
      Invocation(VQuery(path_to_module(argv[2]), argv[3]))
    } else if mode == "teach" {
      Invocation(VTeach(optional_target(argv, 2)))
    } else if mode == "repl" {
      Invocation(VRepl)
    } else if mode == "new" && len(argv) >= 3 {
      Invocation(VNew(argv[2]))
    } else if mode == "--with" && len(argv) >= 3 {
      Invocation(VWith(argv[2], optional_target(argv, 3)))
    } else {
      ParseError("unrecognized or under-specified command: " ++ mode)
    }
  }
}

// optional_target — for verbs where target is optional (edit / doc
// / teach / test). Returns Some(module-name) when present; None
// otherwise. Strips src/ / lib/ prefixes + .mn suffix per
// path_to_module.

fn optional_target(argv, idx) with Pure = {
  if len(argv) > idx { Some(path_to_module(argv[idx])) }
  else { None }
}

// path_to_module — accept either a module name ("main") or a file
// path ("src/main.mn"). Strip "src/" or "lib/" prefix and ".mn"
// suffix when present. Idempotent on bare module names.

fn path_to_module(arg) with Pure = {
  let stripped_prefix = if starts_with(arg, "src/") {
    str_slice(arg, 4, byte_len(arg))
  } else if starts_with(arg, "lib/") {
    str_slice(arg, 5, byte_len(arg))
  } else { arg }
  if ends_with(stripped_prefix, ".mn") {
    str_slice(stripped_prefix, 0, byte_len(stripped_prefix) - 3)
  } else { stripped_prefix }
}

// ─── Entry — argv → Invocation → dispatch ─────────────────────────
//
// Per EH §1.4: argv parses into EntryHandlerInvocation; dispatch
// resolves the named entry-handler and runs it. Per Insight #1
// (handler chain IS capability stack): each entry-handler's chain
// places the surface adapter (terminal_transport / lsp_adapter /
// wat_stdout) OUTERMOST = least trusted = sandbox boundary.

fn main(argv) = match parse_cli_args(argv) {
  ParseError(msg) =>
    print_error_and_help(msg),
  Invocation(verb) =>
    dispatch_invocation(verb)
}

/// dispatch_invocation — the cargo-class default substrate. parallel_
/// compose + wasi_threads install ONCE here at the outermost dispatch
/// boundary; every verb inherits multi-threading without per-*_run
/// repetition. The default IS parallelism — same as `cargo build` using
/// all cores by default. Opt-out: install `~> sequential_compose`
/// INSIDE a specific verb's chain to override (innermost handler wins).
///
/// Per protocol_parallelism_symmetry.md: parallel_compose IS the
/// substrate-honest default; sequential_compose IS the deterministic-
/// output override (test harness verbose mode, reproducible-bisect
/// debugging, etc.). The medium's reflexive: parallelism is the WORLD;
/// single-thread is the EXCEPTION.
///
/// The substrate handlers (env/graph/diagnostics) install at this SAME
/// boundary: the program boundary IS an install site (EH). Every verb
/// path — including import-parse, which runs BEFORE compile_source's
/// per-compile chain — performs against a rooted handler stack; the
/// evidence chain from main downward forwards real entries, never a
/// bare closure record. Inner per-compile installs shadow these
/// (innermost wins), giving each compile_source fresh graph state.
fn dispatch_invocation(verb) = {
  {
    match verb {
      VEdit(target)        => edit_run(target),
      VDoc(target)         => doc_run(target),
      VServe               => serve_run(),
      VCompile(target)     => compile_run(target),
      VCompileStdin        => compile_stdin_run(),
      VRun(target)         => run_run(target),
      VCheck(target)       => check_run(target),
      VTest(target)        => test_run(target),
      VAudit(target)       => audit_run(target),
      VQuery(target, q)    => query_run(target, q),
      VTeach(target)       => teach_run(target),
      VRepl                => repl_run(),
      VNew(name)           => new_project(name),
      VWith(handler, target) => with_run(handler, target)
    }
  }
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> diagnostics_handler
    ~> parallel_compose
    ~> wasi_threads
}

// ─── edit_run — canonical Web IDE (browser-WASM; per IE walkthrough)
//
// Six Phase μ peer handlers compose: the medium running on the
// developer's surface. cursor_session opens the bus-compressor loop;
// each iteration reads the gradient argmax, projects the eight-aspect
// CursorView, surfaces it via terminal_transport, receives an action,
// applies (echoed via patch_echo today; full filesystem rewrite is
// the named follow-up `Hμ.cursor.transport.patch-to-file`),
// advances. Silence ONLY when the project queue is empty — gradient
// at top.
//
// Browser-WASM transport (per IE §0): same kernel, different transport
// adapter. Named follow-up: Hμ.cursor.transport.browser-wasm.

fn edit_run(target_opt) = {
  let entry_module = match target_opt {
    Some(t) => t,
    None    => "main"  // default project entry
  }
  mentl_edit_session(entry_module)
    ~> patch_to_file
    ~> terminal_transport
    ~> cursor_cache_default
    ~> delta_default
    ~> synth_default
    ~> interrogate_default
    ~> mentl_default
    ~> wasi_filesystem
    ~> verify_ledger
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

fn mentl_edit_session(entry_module) = {
  driver_check(entry_module)
  patch_set_target(entry_module)
  cursor_session(Caret(0, Inferred("mentl edit session start")))
}

// ─── serve_run — LSP transport on stdio
//
// vim / helix / VSCode (with Mentl extension) consume this. The
// kernel is identical to edit_run; the surface adapter (lsp_adapter)
// is OUTERMOST. Per MV-LSP-adapter.md substrate.

fn serve_run() = {
  mentl_lsp_session()
    ~> lsp_adapter
    ~> mentl_voice_filesystem
    ~> mentl_voice_default
    ~> query_default          // consult/run_query bubble Query.ask here — the live forensic read
    ~> env_handler            // query_default's env_lookup / env_snapshot
    ~> wasi_filesystem
    ~> no_iter_context
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

fn mentl_lsp_session() = {
  // Reads JSON-RPC frames from stdin; routes to Query / Teach /
  // Synth via lsp_adapter; writes responses to stdout. Per MV-LSP-adapter.
  lsp_session()
}

// ─── doc_run — documentation projection (F.1 substrate)
//
// Per F.1-mentl-doc.md: doc_handler reads the same graph the compile
// handler proves on; render handlers (md / html / llms / terminal)
// project per --target flag; transport handlers emit per stdout /
// file_io / http_serve.
//
// Named follow-up: Hβ.f1.doc-handler-substrate (the lib/doc/ chunks
// per F.1 §13 file-creation order). Today this routes through
// mentl_default + diagnostics for the projection-only mode; the
// dedicated doc_handler is gated.

fn doc_run(target_opt) = {
  let entry_module = match target_opt {
    Some(t) => t,
    None    => "main"
  }
  doc_project(entry_module)
    ~> stdout_console
    ~> wasi_filesystem
    ~> mentl_default
    ~> verify_ledger
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

fn doc_project(entry_module) = {
  // Today: minimal projection — module signature + `///` Reasons
  // surfaced verbatim per DS-docstring-edge substrate. Full F.1
  // render handlers (md / html / llms) gated on
  // Hβ.f1.doc-handler-substrate.
  driver_check(entry_module)
  doc_emit_for_module(entry_module)
}

// ─── compile_run / run_run — emit WAT / compile + execute
//
// compile_run emits WAT to stdout (CI use case; shell pipeline).
// run_run = compile + a Process handler that execs the emitted module —
// `mentl run` IS compile `~> process_wasmtime`, a handler swap over the
// SAME compile graph (not a re-invoked toolchain). The process_exec op is
// the ONLY external surface (the wasmtime wire, peer of the browser/nvim
// wires) — its handler body crosses out of the medium into the host
// process boundary, named Hβ.cli.process-exec-wire.

fn compile_run(target) = {
  compile(target)
    ~> wat_stdout
    ~> wasi_filesystem
    ~> no_iter_context
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

// Per Hβ.first-light.compile-stdin-substrate: stdin-source compile entry.
// `mentl` with no args reads stdin via WASI fd_read (canonical Unix
// `cmd <input` semantics). compile_stdin (pipeline.mn) carries its own
// handler chain — wat_stdout for emit + wasi_filesystem (stdin via fd 0
// goes through the same handler) + the substrate stack.
fn compile_stdin_run() = {
  compile_stdin()
    ~> no_iter_context
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

// Process — the execute-the-compiled-module effect. process_exec is the
// ONE external-boundary op (the host process surface); process_wasmtime
// is its handler. run = compile then ~> process_wasmtime catches the
// process_exec the run pipeline performs over the SAME compile graph (no
// re-invoked toolchain). The op carries the entry module; the compiled
// artifact is handle-addressed (the compile emitted it), so the host wire
// reads it by entry — no fabricated WAT string threaded out of compile.
// The handler body crossing into the host (wasmtime spawn) is the
// external wire, peer of the web/nvim wires — Hβ.cli.process-exec-wire.

effect Process {
  process_exec(entry: String) -> Int   // exit code
}

handler process_wasmtime {
  process_exec(entry) => {
    // The host runner is reached at the WASI process boundary. The wire
    // (wasmtime spawn over the entry's emitted artifact) is
    // Hβ.cli.process-exec-wire; the handler dispatches the entry to that
    // boundary and returns the exit code the run reports.
    eprint_string("mentl run: dispatched {entry} to process boundary\n")
    resume(0)
  }
}

fn run_run(target) = {
  // run IS compile then process_exec ~> process_wasmtime — one handler
  // swap over the SAME compile graph. compile emits the module; the run
  // performs process_exec(entry); process_wasmtime projects it to the
  // host runner; the exit code returns.
  {
    compile(target)
    process_exec(target)
  }
    ~> process_wasmtime
    ~> wat_stdout
    ~> wasi_filesystem
    ~> no_iter_context
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

// ─── check_run — diagnostics; no emit
//
// Incremental cache hits via .mentl/cache/*.kai (per IC walkthrough).
// Same handler chain as compile_run minus wat_stdout — the diagnostic
// pipeline is the value; emission is suppressed.

fn check_run(target) = {
  check(target)
    ~> wasi_filesystem
    ~> no_iter_context
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

// ─── test_run — Test effect handler chain
//
// Per EH §1.3 + lib/test.mn: assert / assert_eq / assert_near
// dispatch through assert_reporter (runtime) + verify_assert
// (compile-time lifting). Named follow-up: Hβ.test.lib-test-mn-substrate.

// test = the Test effect handler chain over the checked graph. The test
// module is checked (its assertions typecheck against the one graph), then
// its check arms dispatch through assert_reporter — assert/assert_eq are
// the Test effect's ops, the handler decides pass/fail (lib/test.mn: "the
// handler decides what happens"). The reporter is a handler swap: the same
// test source runs under assert_reporter (pass/fail counts) or a benchmark
// handler (timing). Execution of the test fns reaches the process boundary
// (Hβ.cli.process-exec-wire, shared with run); the check + reporter chain
// is the structural form, real now.

fn test_run(target_opt) = {
  let entry_module = match target_opt {
    Some(t) => t,
    None    => "test"  // default test entry module
  }
  check(entry_module)
    ~> assert_reporter
    ~> stdout_console
    ~> wasi_filesystem
    ~> no_iter_context
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

// assert_reporter — the Test effect's pass/fail reporter handler. Each
// check(cond, msg) folds into (passed, failed); get_results projects the
// tally. The handler IS the test framework (no framework needed —
// lib/test.mn). State threads the counts; a failing assertion surfaces its
// message at the WASI boundary.
handler assert_reporter with passed = 0, failed = 0 {
  check(cond, msg) =>
    if cond {
      resume() with passed = passed + 1
    } else {
      eprint_string("  FAIL: {msg}\n")
      resume() with failed = failed + 1
    },
  get_results() => resume((passed, failed))
}

// ─── audit_run — capability set + severance suggestions
//
// Walks the ~> chain; collects effect rows transitively; emits
// AuditReport. Per DESIGN §9.1 + traces/a-day §1400.

fn audit_run(target) = {
  audit(target)
    ~> stdout_console
    ~> wasi_filesystem
    ~> mentl_default
    ~> verify_ledger
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

// ─── query_run — structured ad-hoc query
//
// `mentl query <module> "<question>"` — read-only query against
// the substrate. Per traces/a-day §0800 + DESIGN §8 mentl query.

fn query_run(target, question) = {
  query(target, question)
    ~> stdout_console
    ~> wasi_filesystem
    ~> mentl_default
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

// ─── with_run — the universal escape hatch (env_lookup resolution)
//
// `mentl --with <handler> [path]` installs an arbitrary user-defined
// entry-handler resolved by env_lookup — the SAME mechanism every
// built-in verb uses (the env IS the dispatch table; the type system IS
// the package manager, §5). The handler name resolves against the
// checked program's env; a built-in and a user verb are one lookup.
// Resolution of the handle into the install site is the named peer
// Hβ.cli.user-defined-entry-handler-resolution — the env overlay it
// reads is the per-module env the driver populates (driver IC.3 chase).

fn with_run(handler_name, target_opt) = {
  let entry_module = match target_opt {
    Some(t) => t,
    None    => "main"
  }
  check(entry_module)
  match env_lookup(handler_name) {
    None    => eprint_string("mentl --with: no handler named {handler_name} in the checked env\n"),
    Some(_) => eprint_string("mentl --with {handler_name}: resolved; install via Hβ.cli.user-defined-entry-handler-resolution\n")
  }
}

// ─── teach_run — terminal voice surface (default)
//
// Bare `mentl` defaults here per EH. Gradient narration; one
// suggestion per turn; Mentl's voice in the terminal for
// vim/helix/terminal-only users.

fn teach_run(target_opt) = {
  let entry_module = match target_opt {
    Some(t) => t,
    None    => "main"
  }
  teach(entry_module)
    ~> stdout_console
    ~> wasi_filesystem
    ~> mentl_voice_default
    ~> query_default          // mentl_voice_default's consult/run_query bubble Query.ask here
    ~> env_handler            // query_default's env_lookup / env_snapshot
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

// ─── repl_run — the line-eval cursor
//
// The REPL IS the cursor reading one line at a time: each line is a
// frontend |> infer projection, the result spoken through the voice
// surface (the same teach projection, scoped to one entry). It is the
// `<~` edit loop (cursor_transport) with the line as the caret event —
// one cursor, the terminal transport, fed line-by-line. The stdin line
// reader is the host boundary (Hβ.repl.line-read-wire, peer of the
// process/web/nvim wires); the eval-and-project chain is real now.

fn repl_run() = {
  repl_eval_line(read_stdin_line())
    ~> stdout_console
    ~> wasi_filesystem
    ~> mentl_voice_default
    ~> query_default
    ~> env_handler
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

// repl_eval_line — one cursor read of a source line: lex |> parse |> infer,
// then project the inferred shape through the voice surface. Empty line is
// the empty projection (the cursor at rest), never a fabricated value.
fn repl_eval_line(line) = {
  if byte_len(line) == 0 { "" }
  else {
    let ast = line |> frontend
    infer_program(ast)
    render_query_result(ask(parse_query_string("type main")))
  }
}

// ─── new_project — the Filesystem scaffold handler
//
// new IS a Filesystem projection: fs_mkdir the project tree, then read the
// tutorial seed and fs_write_file it into the new src/main.mn. fs_mkdir /
// fs_read_file / fs_write_file are all Filesystem ops (types.mn) — no
// external wire; the whole scaffold is the cursor reading one file and
// writing another. wasi_filesystem performs the syscalls at the boundary.

fn new_project(name) = {
  scaffold_project(name)
    ~> wasi_filesystem
    ~> no_iter_context
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

fn scaffold_project(name) = {
  fs_mkdir(name)
  fs_mkdir("{name}/src")
  let seed = fs_read_file("lib/tutorial/00-hello.mn")
  let dest = "{name}/src/main.mn"
  fs_write_file(dest, seed)
  eprint_string("mentl new {name}: scaffolded {dest} from lib/tutorial/00-hello.mn\n")
}

// ─── help + error surface ─────────────────────────────────────────

fn print_error_and_help(msg) = {
  eprint_string("mentl: ")
  eprint_string(msg)
  eprint_string("\n\n")
  print_help()
}

fn print_help() = {
  eprint_string("mentl — the medium between intent and execution\n\n")
  eprint_string("usage:\n")
  eprint_string("  mentl                          — terminal voice surface (default = teach_run)\n")
  eprint_string("  mentl edit [path]              — canonical Web IDE (browser-WASM holographic)\n")
  eprint_string("  mentl doc [path]               — documentation projection (handler chain)\n")
  eprint_string("  mentl serve                    — LSP transport on stdio\n")
  eprint_string("  mentl compile <path>           — emit WAT to stdout (incremental)\n")
  eprint_string("  mentl run <path>               — compile + wasmtime execute\n")
  eprint_string("  mentl check <path>             — diagnostics; no emit (incremental)\n")
  eprint_string("  mentl test [path]              — test handler chain\n")
  eprint_string("  mentl audit <path>             — capability set + severance suggestions\n")
  eprint_string("  mentl query <path> <question>  — structured ad-hoc query\n")
  eprint_string("  mentl teach [path]             — terminal voice; gradient narration\n")
  eprint_string("  mentl repl                     — line REPL\n")
  eprint_string("  mentl new <name>               — scaffold from lib/tutorial/00-hello.mn\n")
  eprint_string("  mentl --with <handler> [path]  — universal escape hatch (env_lookup)\n")
  eprint_string("\n")
  eprint_string("module names map to src/ or lib/ paths — paths accepted too.\n")
  eprint_string("incremental modes consult .mentl/cache/*.kai for cache hits.\n")
  eprint_string("\n")
  eprint_string("see docs/specs/simulations/CLI-canonical-vocabulary.md for the full catalog\n")
  eprint_string("see docs/specs/simulations/EH-entry-handlers.md for substrate (--with resolution)\n")
}
