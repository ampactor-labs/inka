// main.mn — the executable manifest (per EH-entry-handlers.md §1.4
// + CLI-canonical-vocabulary.md). One file. One function. The `~>`
// chain IS the manifest. What the program has access to is visible
// on the page. No JSON config. No TOML lockfile. The type system
// IS the package manager.
//
// IC.4: compile / check / etc take entry-MODULE names (e.g.
// "compiler/main") instead of raw sources. The driver walks the
// import DAG in dependency layers and infers each module; cross-run
// module skip is the §4④ image-persist peer
// (Hβ.persist.module-image-cache), never a side-file serializer.
//
// CLI canonical vocabulary (per docs/specs/simulations/CLI-canonical-vocabulary.md):
//
//   mentl                       → bare: the directory PROJECTION on a tty;
//                                 a pipe/file on fd 0 compiles stdin
//   mentl edit [path] [--port=N] → canonical Web IDE (browser-WASM holographic)
//   mentl doc [path]             → documentation projection (F.1 substrate)
//   mentl serve                  → LSP transport on stdio
//   mentl compile <path>         → emit WAT to stdout
//   mentl run <path>             → compile; the shim executes (WASI has no exec)
//   mentl check <path>           → diagnostics; no emit
//   mentl test [path]            → test handler chain
//   mentl audit <path>           → capability set + severance suggestions
//   mentl query <path> <q>       → structured ad-hoc query
//   mentl teach [path]           → terminal voice surface; gradient narration
//   mentl repl                   → line REPL over current env
//   mentl new <name>             → write <name>.mn here (one file; imports are the manifest)
//   mentl --with <handler>       → universal escape hatch; resolves by env_lookup
//
// Drift 38 (mascot-as-tentacle-prefix per CLAUDE.md red-flag table):
// project-action verbs are canonical (the binary IS named Mentl;
// subcommand prefix is structural like `git commit` / `cargo build`).
// Tentacle-named verbs (Trace / Why / Propose / Unlock / Verify /
// Topology) that shadow at-cursor projections would be drift 38 —
// see tools/drift-patterns.tsv mode 38 + CLI-canonical-vocabulary.md
// §3.3 for the line. `teach` and `query` are project-action peer
// transports (canonical) for terminal users — those tentacle names
// have legitimate CLI semantics that the per-cursor projection
// inside the medium does not duplicate.
//
// Module names map to paths: `main` → `src/main.mn`. Strip `src/` or
// `lib/` prefixes and `.mn` suffix from a path to get the module name.
//
// The outermost handlers — diagnostics, wat_stdout, wasi_filesystem,
// terminal_transport — are the sandbox boundary. Every inward
// handler receives narrower capability.

import pipeline
import own
import query
import infer
import backends/wasm
import dsp/clock
import voice
import lsp
import driver
import cursor
import cursor_transport
import gradient_delta
import synth_proposer
import eight_loop
import oracle
import test
import runtime/io
// The shipped surface — the stdlib the medium's binary carries whether or
// not the compiler's own body reaches it: format's verb substrate, the DSP
// vocabulary, the runtime families a user program may import. The DAG that
// builds the medium IS the manifest of what the medium ships.
import format
import dsp/feedback
import dsp/signal
import dsp/spectral
import ml/tensor
import runtime/math
import runtime/net
import runtime/tuples

// ─── EntryVerb ADT — the verb carries its target where required ───────
//
// Each variant IS the entry-handler, structured. A target-requiring verb
// (Compile/Run/Check/Audit/Query) carries its module name as a NON-OPTION
// field — so "compile with no target" is unrepresentable; no `""` sentinel
// can flow downstream (Anchor 2: the illegal state is deleted at the type
// level, not fabricated and re-checked). Verbs with an optional target
// (Edit/Doc/Teach/Test) carry an Option; verbs with none (Serve/Repl) carry
// nothing. Dispatch matches the ADT structurally — never a string re-compare
// (drift 8): parse_cli_args proved the verb, and dispatch reads that proof.

type EntryVerb
  = VEdit(Option(String))            // target optional → default "main"
  | VDoc(Option(String))
  | VServe
  | VSpace
  | VTighten(Option(String))
  | VFmt(String)
  | VCompile(String)                 // target REQUIRED — carried non-optionally
  | VCompileStdin
  | VRun(String)
  | VCheck(String)
  | VAt(String, Int, Int)            // the cursor-address form — `mentl lib/tutorial/09-all.mn:40:20`: target, line, col (0 = whole-line). Drift-38's endpoint: the address IS the surface; verbs are transports
  | VTest(Option(String))
  | VAudit(String)
  | VQuery(String, String)           // target, question — both required
  | VTeach(Option(String))
  | VRepl
  | VNew(String)                     // project name — required
  | VWith(String, Option(String))    // handler name, optional target
  | VWelcome                         // bare tty invocation / `mentl help` —
                                     // the directory PROJECTION, never a hang

type EntryHandlerInvocation
  = Invocation(EntryVerb)
  | ParseError(String)

// ─── The verb table — ONE home the parser AND the help project ────────
//
// A VerbSpec carries the verb's name, its argument hint (for the help line),
// the BUILDER that projects argv → the typed Invocation (or a ParseError that
// names the missing argument), and its one-line description. The builder is a
// first-class effectful CLOSURE stored in the field — the medium carries
// functions-with-their-rows through data (the same capability handlers rest
// on), so the verb→construction edge is the graph's own edge, never a tag a
// second pass re-derives. parse_cli_args finds by name and RUNS the closure;
// verb_catalog projects each row into the help surface. The verb set has ONE
// home; the help text and the parser were two hand-maintained copies that
// could drift, and now both read this table (Carried-Truth Law: one home, and
// every reader is a projection of it). Adding a verb is ONE row here plus its
// runner arm in dispatch_invocation.
type VerbSpec = VerbSpec(String, String, ([String]) -> EntryHandlerInvocation, String)

// req_target — the shared shape of the target-REQUIRED verbs (compile / run /
// check / audit): argv[2] resolved to a module, or a ParseError that names the
// verb and shows its usage. `mk` builds the variant from the resolved module.
fn req_target(argv, mk, msg) with Memory + Alloc =
  if len(argv) >= 3 { Invocation(mk(path_to_module(argv[2]))) }
  else { ParseError(msg) }

// The verbs, in help-presentation order (the parser matches by name, so order
// here is the human's reading order, never the dispatch order). A `""` hint is
// a no-argument verb.
fn verb_specs() with Memory + Alloc = [
  VerbSpec("run",     "<path>",            (a) => req_target(a, (t) => VRun(t),     "run needs a target: mentl run <path>"),          "compile, prove, execute (a hole or refuted claim REFUSES)"),
  VerbSpec("check",   "<path>",            (a) => req_target(a, (t) => VCheck(t),   "check needs a target: mentl check <path>"),      "diagnostics only, no emit"),
  VerbSpec("compile", "<path>",            (a) => req_target(a, (t) => VCompile(t), "compile needs a target: mentl compile <path>"),  "emit WAT to stdout"),
  VerbSpec("edit",    "[path]",            (a) => Invocation(VEdit(optional_target(a, 2))),                                           "the cursor session (eight aspects + proven proposals)"),
  VerbSpec("audit",   "<path>",            (a) => req_target(a, (t) => VAudit(t),   "audit needs a target: mentl audit <path>"),      "the capability set + severance unlocks"),
  VerbSpec("query",   "<path> <question>", (a) => if len(a) >= 4 { Invocation(VQuery(path_to_module(a[2]), a[3])) } else { ParseError("query needs a target and a question: mentl query <path> <question>") }, "why / type / effects / ownership, walked to your words"),
  VerbSpec("teach",   "[path]",            (a) => Invocation(VTeach(optional_target(a, 2))),                                          "the gradient narrated"),
  VerbSpec("doc",     "[path]",            (a) => Invocation(VDoc(optional_target(a, 2))),                                            "documentation projection"),
  VerbSpec("test",    "[path]",            (a) => Invocation(VTest(optional_target(a, 2))),                                           "the test chain"),
  VerbSpec("new",     "<name>",            (a) => if len(a) >= 3 { Invocation(VNew(a[2])) } else { ParseError("new needs a name: mentl new <name>") }, "write <name>.mn here (one file; the imports are the manifest)"),
  VerbSpec("serve",   "",                  (a) => Invocation(VServe),                                                                 "the transport server"),
  VerbSpec("space",   "",                  (a) => Invocation(VSpace),                                                                 "the ide, served — open http://localhost:7378/ide/"),
  VerbSpec("tighten", "[path]",            (a) => Invocation(VTighten(optional_target(a, 2))),                                        "apply the first proven row tightening — the medium authors, you accept"),
  VerbSpec("fmt",     "<path>",            (a) => if len(a) >= 3 { Invocation(VFmt(a[2])) } else { ParseError("fmt needs a target: mentl fmt <path>") }, "render the file canonical — layout is projection, never contract"),
  VerbSpec("repl",    "",                  (a) => Invocation(VRepl),                                                                  "line REPL"),
  VerbSpec("--with",  "<handler> [path]",  (a) => if len(a) >= 3 { Invocation(VWith(a[2], optional_target(a, 3))) } else { ParseError("--with needs a handler: mentl --with <handler> [path]") }, "install any handler over any verb"),
  VerbSpec("help",    "",                  (a) => Invocation(VWelcome),                                                               "this projection")
]

// find_verb — the name → spec projection over the table (names are unique, so
// either end serves; last/drop_last is the O(1) snoc walk). None when no match.
fn find_verb(name, specs) with Memory + Alloc =
  if len(specs) == 0 { None }
  else {
    let spec = last(specs)
    let VerbSpec(n, _, _, _) = spec
    if n == name { Some(spec) } else { find_verb(name, drop_last(specs)) }
  }

// ─── argv parsing ─────────────────────────────────────────────────
//
// Projects argv to the EntryVerb ADT at the ONE boundary. Bare `mentl` →
// VCompileStdin (Unix `cmd <input`). `--with <name>` is the universal
// escape hatch. A target-requiring verb given no target is a ParseError
// here (the one boundary), never a fabricated "" downstream.

fn parse_cli_args(argv) with Memory + Alloc = {
  if len(argv) < 2 { Invocation(VCompileStdin) }
  else {
    let mode = argv[1]
    // The cursor-address probe FIRST — `mentl <target>:<line>[:<col>]` is
    // the medium's primary surface (drift-38: projections fire AT-CURSOR;
    // the named verbs are transports). The parse is shape-only; the runner
    // resolves the target exactly like every verb and refuses honestly.
    match parse_address(mode) {
      Some(addr) => {
        let (target, line, col) = addr
        Invocation(VAt(path_to_module(target), line, col))
      },
      // The verb ladder is ONE table projection now (verb_specs): normalize the
      // help aliases to the canonical name, find the spec, run its builder. An
      // unknown name is the honest ParseError — never a fabricated fallback.
      None => {
        let name = if mode == "-h" || mode == "--help" { "help" } else { mode }
        match find_verb(name, verb_specs()) {
          Some(VerbSpec(_, _, build, _)) => build(argv),
          None => ParseError("unrecognized or under-specified command: " ++ mode)
        }
      }
    }
  }
}

// The address shape — `<target>:<line>` or `<target>:<line>:<col>`, both
// numeric segments all-digits. Shape parse only (a byte walk over the flat
// string); existence/resolution is the runner's question. Returns None for
// anything else, falling through to the verb ladder.
fn parse_address(ref s) with Memory + Alloc = {
  let n = byte_len(s)
  let c1 = addr_colon_from(s, 0, n)
  if c1 <= 0 { None }
  else {
    let c2 = addr_colon_from(s, c1 + 1, n)
    if c2 < 0 {
      match addr_int(s, c1 + 1, n) {
        Some(line) => Some((str_slice(s, 0, c1), line, 0)),
        None       => None
      }
    } else {
      match addr_int(s, c1 + 1, c2) {
        Some(line) => match addr_int(s, c2 + 1, n) {
          Some(col) => Some((str_slice(s, 0, c1), line, col)),
          None      => None
        },
        None => None
      }
    }
  }
}

// The first ':' at or after i; -1 when none.
fn addr_colon_from(ref s, i, n) with Memory = {
  if i >= n { 0 - 1 }
  else if byte_at(s, i) == 58 { i }
  else { addr_colon_from(s, i + 1, n) }
}

// The all-digits segment [i, end) as Some(value); None when empty or any
// non-digit byte (so `web:site.mn` never parses as an address).
fn addr_int(ref s, i, end) with Memory + Alloc = {
  if i >= end { None }
  else { addr_int_loop(s, i, end, 0) }
}

fn addr_int_loop(ref s, i, end, acc) with Memory + Alloc = {
  if i >= end { Some(acc) }
  else {
    let ch = byte_at(s, i)
    if ch >= 48 && ch <= 57 { addr_int_loop(s, i + 1, end, acc * 10 + (ch - 48)) }
    else { None }
  }
}

// optional_target — for verbs where target is optional (edit / doc
// / teach / test). Returns Some(module-name) when present; None
// otherwise. Strips src/ / lib/ prefixes + .mn suffix per
// path_to_module.

fn optional_target(argv, idx) with Memory + Alloc = {
  if len(argv) > idx { Some(path_to_module(argv[idx])) }
  else { None }
}

// path_to_module — accept either a module name ("main") or a file
// path ("src/main.mn"). Strip "src/" or "lib/" prefix and ".mn"
// suffix when present. Idempotent on bare module names.

fn path_to_module(arg) with Alloc + Memory = {
  let stripped_prefix = if starts_with(arg, "src/") {
    str_slice(arg, 4, byte_len(arg))
  } else if starts_with(arg, "lib/") {
    str_slice(arg, 4, byte_len(arg))
  } else { arg }
  if ends_with(stripped_prefix, ".mn") {
    str_slice(stripped_prefix, 0, byte_len(stripped_prefix) - 3)
  } else { stripped_prefix }
}

// ─── Entry — argv → Invocation → dispatch ─────────────────────────
//
// Per EH §1.4: argv parses into EntryHandlerInvocation; dispatch
// resolves the named entry-handler and runs it. Per Insight #1
// (handler chain IS capability stack): each entry-handler's chain
// places the surface adapter (terminal_transport / lsp_adapter /
// wat_stdout) OUTERMOST = least trusted = sandbox boundary.

fn main(argv) = match parse_cli_args(argv) {
  ParseError(msg) =>
    print_error_and_help(msg),
  Invocation(verb) =>
    dispatch_invocation(verb)
}

// dispatch_invocation — the substrate handlers (env/graph/diagnostics)
// install ONCE at this outermost dispatch boundary: the program boundary
// IS an install site (EH). Every verb path — including import-parse,
// which runs BEFORE compile_source's per-compile chain — performs
// against a rooted handler stack; the evidence chain from main downward
// forwards real entries, never a bare closure record. Inner per-compile
// installs shadow these (innermost wins), giving each compile_source
// fresh graph state.
//
// NO schedule handler installs here: the wheel's own algorithm carries
// zero fanouts (one sequential compile spine — §5.O layer 4 is the
// multi-core `><` that will bring its install WITH it), and a standing
// parallel_compose install would put the spawn arm's task-record
// performs into the wheel's own emitted tree, flipping the wheel to the
// shared-image/shared-cell shape for parallelism it never performs. A
// schedule installs lexically at the fanout it schedules — SYNTAX §`><`:
// no Schedule installed → Seq, the invisible default.
fn dispatch_invocation(verb) = {
  {
    match verb {
      VEdit(target)        => edit_run(target),
      VDoc(target)         => doc_run(target),
      VServe               => serve_run(),
      VSpace               => space_run(),
      VTighten(target)     => tighten_run(target),
      VFmt(target)         => fmt_run(target),
      VCompile(target)     => compile_run(target),
      VCompileStdin        =>
        // The bare invocation forks on the ONE substrate fact that
        // distinguishes intent: fd 0's filetype. A pipe or file IS the
        // compile-stdin contract (`mentl < wheel.mn` — the fixpoint path,
        // untouched); a terminal is a human with no program yet — project
        // the welcome instead of hanging on a read that never comes.
        // (Landed as the second rung of a two-step ladder: the ops' import
        // tables crossed on the prior pin, so this generation's boot
        // lowers the call it is about to execute.)
        if stdin_is_tty() { welcome_run() } else { compile_stdin_run() },
      VRun(target)         => run_run(target),
      VCheck(target)       => check_run(target),
      VAt(target, line, col) => at_run(target, line, col),
      VTest(target)        => test_run(target),
      VAudit(target)       => audit_run(target),
      VQuery(target, q)    => query_run(target, q),
      VTeach(target)       => teach_run(target),
      VRepl                => repl_run(),
      VNew(name)           => new_project(name),
      VWith(hname, target) => with_run(hname, target),
      VWelcome             => welcome_run()
    }
  }
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> diagnostics_handler
}

// ─── edit_run — canonical Web IDE (browser-WASM; per IE walkthrough)
//
// Six Phase μ peer handlers compose: the medium running on the
// developer's surface. cursor_session opens the bus-compressor loop;
// each iteration reads the gradient argmax, projects the eight-aspect
// CursorView, surfaces it via terminal_transport, receives an action,
// applies (echoed via patch_echo today; full filesystem rewrite is
// the named follow-up `Hμ.cursor.transport.patch-to-file`),
// advances. Silence ONLY when the project queue is empty — gradient
// at top.
//
// Browser-WASM transport (per IE §0): same kernel, different transport
// adapter. Named follow-up: Hμ.cursor.transport.browser-wasm.

fn edit_run(target_opt) = {
  let entry_module = match target_opt {
    Some(t) => t,
    None    => "main"  // default project entry
  }
  // The session's final TransportState is a record pointer, not an exit
  // code (main's result IS the process exit); the chain is a statement —
  // its value drops — and a completed session exits 0.
  // The whole analysis core installs as ONE bracket (infer_context,
  // pipeline.mn — the order law lives there). This chain paid for two of
  // the classes the bracket makes unforgettable: the driverless
  // affine/region ledgers reading the sentinel page as empty, and every
  // lookup_ty running as a null-state singleton until the
  // SingletonUninstalled guard refused it.
  infer_context(() =>
    mentl_edit_session(entry_module)
      ~> patch_to_file
      ~> terminal_transport
      // cursor_default innermost of the projection handlers: its arms fan the
      // eight tentacles, performing Synth / Interrogate / Teach / Verify /
      // Graph ops that bubble OUTWARD to the installs around them. Without
      // this install the Cursor ops (cursor_at / cursor_argmax / cursor_pinned)
      // have no evidence on the session route — cursor_argmax is AMBIGUOUS
      // (ic_fixpoint_handler carries an arm too), so the singleton tier
      // cannot pick, and the first perform met the strict ev-scan miss.
      ~> cursor_default
      ~> delta_default
      ~> synth_default
      ~> interrogate_default
      ~> mentl_default
      ~> wasi_filesystem
  )
  0
}

// The session reads ONE weave — the same driver_entry_with_ranges the
// address transport projects — never the per-module check walk: per-module
// parses give every module its own span space, so the closure's seven
// authored-absence positions (the entry's `??` plus the runtime's parse-
// recovery holes) aliased near offset zero and the argmax focused a
// prelude node (the 13-red frontier family). One weave, one span space;
// and the caret OPENS AT THE ENTRY — its Located span is the entry's first
// weave line, so the module-aware proximity decay ranks the entry's own
// absences above the closure's.
fn mentl_edit_session(entry_module) = {
  let (_ast, ranges) = driver_entry_with_ranges(entry_module)
  let opening = entry_start_caret(entry_module, ranges)
  patch_set_target(entry_module)
  cursor_session(opening)
}

fn entry_start_caret(entry_module, ranges) = {
  // type_name_eq pins the compare `: String` — a bare `==` on two names
  // allocated by different passes is the pointer-eq class and never matches.
  match find((r) => { let (m, _, _, _) = r; type_name_eq(m, entry_module) }, ranges) {
    Some(r) => {
      let (_, _, line_start, _) = r
      Caret(0, Located(Span(line_start, 1, line_start, 1),
        Inferred("mentl edit session start — at the entry")))
    },
    None => Caret(0, Inferred("mentl edit session start"))
  }
}

// ─── space_run — the ide, served by the wheel (`mentl space`)
//
// The HTTP/1.1 file server that lived as ide/serve.mn, absorbed whole:
// the accept loop is an evidence-threading tail call over the socket
// substrate (lib/runtime/net.mn); every response carries the
// cross-origin-isolation pair the IDE's shared-memory compiler requires.
// The host preopens the repo dir and the listener
// (-S tcplisten=127.0.0.1:7378 — the install shim's space seam);
// find_listener reads the preopen table, so the fd never lives in source.

fn space_mime_for(path: String) with Memory + Alloc =
  if ends_with(path, ".html")      { "text/html; charset=utf-8" }
  else if ends_with(path, ".wasm") { "application/wasm" }
  else if ends_with(path, ".js")   { "text/javascript" }
  else if ends_with(path, ".mjs")  { "text/javascript" }
  else if ends_with(path, ".css")  { "text/css" }
  else if ends_with(path, ".json") { "application/json" }
  else if ends_with(path, ".svg")  { "image/svg+xml" }
  else if ends_with(path, ".png")  { "image/png" }
  else if ends_with(path, ".md")   { "text/markdown; charset=utf-8" }
  else if ends_with(path, ".mn")   { "text/plain; charset=utf-8" }
  else if ends_with(path, ".wat")  { "text/plain; charset=utf-8" }
  else                             { "application/octet-stream" }

// One read is the whole request for the GETs a static IDE makes. The bytes
// materialize as a proper [count][tag][bytes@+8] String record (bytes_buf +
// str_of_buf — io.mn's fd_read_all form).
fn space_read_request(conn) with Memory + Alloc + WASI = {
  let cap = 65536
  let buf = alloc(cap)
  let n = sock_read(conn, buf, cap)
  let got = if n < 0 { 0 } else { n }
  let str = bytes_buf(got)
  mem_copy(str + 8, buf, got)
  str_of_buf(str)
}

// The request line's path: bytes between the first two spaces, query
// stripped. Empty on a malformed line (the caller 400s).
fn space_request_path(req: String) with Memory + Alloc = {
  let n = byte_len(req)
  let sp1 = find_char(req, n, 0, 32)
  if sp1 < 0 { "" }
  else {
    let sp2 = find_char(req, n, sp1 + 1, 32)
    if sp2 < 0 { "" }
    else {
      let raw = str_slice(req, sp1 + 1, sp2)
      let q = find_char(raw, byte_len(raw), 0, 63)   // '?'
      if q < 0 { raw } else { str_slice(raw, 0, q) }
    }
  }
}

// Routing: "/" and any directory path serve its index.html; the leading
// slash strips (fs paths are preopen-relative); ".." refuses.
fn space_route(path: String) with Memory + Alloc =
  if path == "" || path == "/" { "ide/index.html" }
  else {
    let full = if ends_with(path, "/") { str_concat(path, "index.html") } else { path }
    str_slice(full, 1, byte_len(full))
  }

fn space_respond(conn, code_line: String, mime: String, body: String) with Memory + Alloc + WASI = {
  let len_s = int_to_str(byte_len(body))
  let head = "HTTP/1.1 {code_line}\r\nContent-Type: {mime}\r\nContent-Length: {len_s}\r\nCross-Origin-Opener-Policy: same-origin\r\nCross-Origin-Embedder-Policy: require-corp\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n"
  sock_write_str(conn, head)
  sock_write_str(conn, body)
  ()
}

fn space_conn(conn) with Memory + Alloc + WASI = {
  let req = space_read_request(conn)
  let path = space_request_path(req)
  if byte_len(path) == 0 {
    space_respond(conn, "400 Bad Request", "text/plain", "bad request\n")
  } else if str_contains(path, "..") {
    space_respond(conn, "403 Forbidden", "text/plain", "no traversal\n")
  } else {
    let file = space_route(path)
    if fs_exists_impl(file) {
      space_respond(conn, "200 OK", space_mime_for(file), fs_read_file_impl(file))
      print_string("200 {file}\n")
    } else {
      space_respond(conn, "404 Not Found", "text/plain", "not found: {file}\n")
      print_string("404 {file}\n")
    }
  }
  fd_close(conn)
  ()
}

// The accept loop — constant stack forever (the tail form carrying its
// own server).
fn space_loop(lfd) with Memory + Alloc + WASI = {
  space_conn(sock_accept_blocking(lfd))
  space_loop(lfd)
}

fn space_run() with Memory + Alloc + WASI = {
  let lfd = find_listener()   // drift-audit: ignore — sequenced effectful read consumed at TWO sites (the guard and the loop): the reuse exclusion, not a pipe stage
  if lfd < 0 {
    eprint_string("mentl space: no listener preopened — the install shim adds -S tcplisten=127.0.0.1:7378 for this verb; by hand from the repo root: wasmtime run <flags> --dir . -S tcplisten=127.0.0.1:7378 boot/mentl.wasm space\n")   // drift-audit: ignore — the flagged keyword is inside the teaching string (a quoted shell invocation), not control flow
    1
  } else {
    print_string("mentl space -> http://localhost:7378/ide/\n")
    space_loop(lfd)
    0
  }
}

// ─── fmt_run — the canonical render written back (`mentl fmt`)
//
// Layout is projection, never contract (SYNTAX principle 1): the file
// re-renders from the graph in canonical form. The render is TOTAL over
// the surface (every Expr/Stmt/Pat variant has its arm — the formatter
// arc's totality landing), carries the comment weave, and re-escapes
// string content, so format∘parse is the identity the module's own
// comment always claimed. Idempotence is the gate: the second render is
// byte-identical to the first.

fn fmt_run(target) = {
  infer_context(() =>
    {
      // The verb convention: the arg normalizes to a MODULE name, and the
      // write-back path is the resolver's own answer — one resolution
      // home, never the raw argv string carried past it.
      let entry_module = path_to_module(target)
      let path = driver_module_path(entry_module)
      let ast = driver_check_entry(entry_module)
      let rendered = format_program(ast)
      fs_write_file(path, rendered)
      print_string("fmt: {path} rendered canonical\n")
      0
    }
      ~> format_default
      ~> wasi_filesystem
      ~> mentl_default
  )
}

// ─── tighten_run — the medium authors its own row tightening
//
// The self-authorship driver at its smallest real scope (the self-build
// audit's step 1b): T_OverDeclared already IS a proposal — the diagnostic
// carries the declared row, the proven body row, the fn name, and the
// decl span, MachineApplicable. This verb turns the first authorable one
// into the patch: rewrite the decl's with-clause to the body's proven
// row, report old → new, and leave the verdict to a fresh check + the
// gates. Tightening is the monotone-safe direction — a narrower
// declaration can only shrink what callers accumulate, so it can create
// new T_OverDeclared warnings (the next ratchet turns) but never an
// E_EffectMismatch.

effect Tighten {
  tightenables() -> [(EffRow, EffRow, String, Span)]
}

// The collecting forwarder over the Diag effect: TOverDeclared
// accumulates in state AND every diagnostic re-performs outward from the
// arm — sound because an arm's own performs resolve in the INSTALL's
// world (the world arc's deep-handler law), reaching the bracket's
// diagnostics_handler, never re-entering this collector. All three Diag
// ops carry arms: a handler arming only SOME ops of an effect leaves
// zero fn slots for the rest, and a perform through a zero slot is a
// garbage dispatch.
handler tighten_collector with found = [] {
  report(diag) => {
    report(diag)
    match diag {
      TOverDeclared(declared, used, name, span) =>
        resume() with found = push(found, (declared, used, name, span)),
      _ => resume()
    }
  },
  diag_errors()   => resume(diag_errors()),
  diag_refusals() => resume(diag_refusals()),
  tightenables()  => resume(found)
}

fn tighten_run(target_opt) = {
  let entry_module = match target_opt {
    Some(t) => t,
    None    => "main"
  }
  infer_context(() =>
    {
      let (_ast, ranges) = driver_entry_with_ranges(entry_module)
      let cands = tightenables()   // drift-audit: ignore — sequenced effectful ledger read (the diag_refusals precedent): the collector's state is read once after the check populates it
      let authorable = filter((c) => { let (_, used, _, _) = c row_is_authorable(used) }, cands)
      if len(authorable) == 0 {
        print_string("mentl tighten: nothing to tighten ({int_to_str(len(cands))} over-declared, none authorable)\n")
        0
      } else {
        // Batch-apply: every proposal was computed against the CURRENT
        // (wider) declarations, so a batch member's row is never too
        // narrow — at worst it leaves slack a tightened callee exposes,
        // which the NEXT run's re-judgment catches (the ratchet
        // converges). Per file, patch bottom-up so line offsets hold.
        let n = apply_tightenings(authorable, ranges)
        print_string("tighten: {int_to_str(n)} of {int_to_str(len(authorable))} authorable applied — the medium authored these; verify with a fresh check + the gates\n")
        if n > 0 { 0 } else { 1 }
      }
    }
      ~> tighten_collector
      ~> wasi_filesystem
      ~> mentl_default
  )
}

// Authorable = the proven row renders as source: a closed tail. A var
// tail renders as a handle name — never authored into a signature.
fn row_is_authorable(ref used) = {
  let EfRow(_, _, t) = used
  match t {
    EtClosed  => true,
    EtVar(_)  => false,
    EtAll     => false
  }
}

// The batch applier: locate every candidate (drop unmappable spans),
// order by (path, line DESCENDING) — the negated-line sort key — so each
// file patches bottom-up and earlier offsets never shift, then fold with
// one open file at a time (read on path change, write on leave).
fn apply_tightenings(cands, ranges) = {
  let located = flatten(map((c) => {
    let (declared, used, name, span) = c
    match file_line_of(ranges, span) {
      Some(pl) => {
        // A list literal after a let must open on its own line — on one
        // line `pl [(…)]` parses as indexing.
        let (p, l) = pl
        [(p, 0 - l, name, declared, used)]
      },
      None     => []
    }
  }, cands))
  tighten_fold(sort(located), 0, "", "", 0)
}

fn tighten_fold(items, i, cur_path, cur_text, applied) = {
  if i >= len(items) {
    if byte_len(cur_path) > 0 { fs_write_file(cur_path, cur_text) }
    applied
  } else {
    let (path, negline, name, declared, used) = list_index(items, i)
    let line1 = 0 - negline
    let text0 =
      if path == cur_path { cur_text }
      else {
        if byte_len(cur_path) > 0 { fs_write_file(cur_path, cur_text) }
        fs_read_file(path)
      }
    match patch_with_clause(text0, line1, used) {
      Some(t2) => {
        print_string("tighten: {name} ({path}:{int_to_str(line1)})  with {show_effrow(declared)}  →  with {show_effrow(used)}\n")
        tighten_fold(items, i + 1, path, t2, applied + 1)
      },
      None => {
        eprint_string("mentl tighten: {name} at {path}:{int_to_str(line1)} — no single-line with-clause; skipped\n")
        tighten_fold(items, i + 1, path, text0, applied)
      }
    }
  }
}

// Rewrite one decl line's with-clause to the proven row. The terminator
// is the first " = " after the clause — the row text itself contains no
// " = ", so the match is the head's binder. None = the decl shape is not
// a single-line with-clause head (never mangle; skip and say so).
fn patch_with_clause(ref text, line1, ref used) = {
  let ls = line_start_offset(text, line1)
  let le = line_end_offset(text, ls)
  let line = str_slice(text, ls, le)
  let wi = index_of(line, " with ")
  if wi < 0 { None }
  else {
    let after = str_slice(line, wi + 6, byte_len(line))
    let eq = index_of(after, " = ")
    if eq < 0 { None }
    else {
      let new_line = "{str_slice(line, 0, wi + 6)}{show_effrow(used)}{str_slice(after, eq, byte_len(after))}"
      Some("{str_slice(text, 0, ls)}{new_line}{str_slice(text, le, byte_len(text))}")
    }
  }
}

fn line_start_offset(ref text, line1) = line_start_walk(text, 1, 0, line1)

fn line_start_walk(ref text, at_line, off, line1) = {
  if at_line >= line1 { off }
  else {
    let n = byte_len(text)
    if off >= n { off }
    else if byte_at(text, off) == 10 { line_start_walk(text, at_line + 1, off + 1, line1) }
    else { line_start_walk(text, at_line, off + 1, line1) }
  }
}

fn line_end_offset(ref text, ls) = {
  let n = byte_len(text)
  if ls >= n { n }
  else if byte_at(text, ls) == 10 { ls }
  else { line_end_offset(text, ls + 1) }
}

// ─── serve_run — LSP transport on stdio
//
// vim / helix / VSCode (with Mentl extension) consume this. The
// kernel is identical to edit_run; the surface adapter (lsp_adapter)
// is OUTERMOST. Per MV-LSP-adapter.md substrate.

fn serve_run() = {
  // The transport reads a LIVE graph: handle_did_open runs driver_check, whose
  // inference performs Consume / Region / Verify / LookupTy (the analysis ops
  // infer_program leaks past its own infer_ctx install). The core installs
  // HERE, at the session boundary via infer_context (pipeline.mn — this
  // chain's env-before-graph comment is that bracket's written law), so the
  // graph the frontend populates persists across every hover / definition /
  // reference in the session — the driverless chain (open_file only) read an
  // unpopulated graph and every query fell to AnsSilence
  // (Hβ.lsp.transport-runs-frontend).
  infer_context(() =>
    mentl_lsp_session()
      ~> lsp_adapter
      ~> mentl_voice_filesystem
      ~> mentl_voice_default
      ~> query_default          // consult/run_query bubble Query.ask here — the live forensic read
      ~> wasi_filesystem
      ~> no_iter_context
  )
}

fn mentl_lsp_session() = {
  // Reads JSON-RPC frames from stdin; routes to Query / Teach /
  // Synth via lsp_adapter; writes responses to stdout. Per MV-LSP-adapter.
  lsp_session()
}

// ─── doc_run — documentation projection (F.1 substrate)
//
// Per F.1-mentl-doc.md: doc_handler reads the same graph the compile
// handler proves on; render handlers (md / html / llms / terminal)
// project per --target flag; transport handlers emit per stdout /
// file_io / http_serve.
//
// Named follow-up: Hβ.f1.doc-handler-substrate (the lib/doc/ chunks
// per F.1 §13 file-creation order). Today this routes through
// mentl_default + diagnostics for the projection-only mode; the
// dedicated doc_handler is gated.

fn doc_run(target_opt) = {
  let entry_module = match target_opt {
    Some(t) => t,
    None    => "main"
  }
  // driver_check's per-module inference performs the same analysis ops
  // every other inference-reaching chain absorbs — this chain ran them all
  // driverless until the SingletonUninstalled guard made the class loud,
  // then carried the core WITHOUT env_handler until the order-law audit
  // completed it; the bracket makes both classes unforgettable.
  infer_context(() =>
    doc_project(entry_module)
      ~> stdout_console
      ~> wasi_filesystem
      ~> mentl_default
  )
}

fn doc_project(entry_module) = {
  // Today the doc projection IS driver_check: it validates the module and
  // surfaces its `///` Reasons through the diagnostics handler. The dedicated
  // render step (md / html / llms handlers over the module signature) is a
  // NAMED gated peer — Hβ.f1.doc-handler-substrate — not a phantom call:
  // doc_emit_for_module was referenced but never defined (reachable_from_main
  // emitted the dangling global), so the honest form names the peer and stops.
  driver_check(entry_module)
}

// ─── compile_run / run_run — emit WAT / compile + execute
//
// compile_run emits WAT to stdout (CI use case; shell pipeline).
// run_run = compile + a Process handler over the SAME compile graph — a
// handler swap, not a re-invoked toolchain. On WASI no handler can actually
// exec (see process_no_exec); the install shim owns that seam and returns the
// program's real exit code. The process_exec op is
// the ONLY external surface (the wasmtime wire, peer of the browser/nvim
// wires) — its handler body crosses out of the medium into the host
// process boundary, named Hβ.cli.process-exec-wire.

fn compile_run(target) = {
  compile(target)
    ~> wat_stdout
    ~> wasi_filesystem
    ~> no_iter_context
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

// Per Hβ.first-light.compile-stdin-substrate: stdin-source compile entry.
// `mentl` with no args reads stdin via WASI fd_read (canonical Unix
// `cmd <input` semantics). compile_stdin (pipeline.mn) carries its own
// handler chain — wat_stdout for emit + wasi_filesystem (stdin via fd 0
// goes through the same handler) + the substrate stack.
fn compile_stdin_run() = {
  compile_stdin()
    ~> no_iter_context
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

// Process — the execute-the-compiled-module effect. process_exec is the
// ONE external-boundary op (the host process surface). run = compile then
// ~> <a Process handler> catches the
// process_exec the run pipeline performs over the SAME compile graph (no
// re-invoked toolchain). The op carries the entry module; the compiled
// artifact is handle-addressed (the compile emitted it), so the host wire
// reads it by entry — no fabricated WAT string threaded out of compile.
// The handler body crossing into the host (wasmtime spawn) is the
// external wire, peer of the web/nvim wires — Hβ.cli.process-exec-wire.

effect Process {
  process_exec(entry: String) -> Int   // exit code
}

// The op is right and stays: `run` IS compile-then-`process_exec`, one handler
// swap over the same compile graph, and a native mentl (band N) can perform it
// for real. The op is the seam, correctly placed.
//
// This HANDLER is what was wrong. It was named for the wasmtime projection and
// its comment said it "dispatches the entry to that boundary and returns the exit
// code the run reports" — it printed a sentence and resumed 0. Nothing ran; every
// `mentl run` through the wheel reported success it had not performed, and the only
// reason no one noticed is that tools/install.sh's shim intercepts `run`,
// compiles, assembles, executes, and propagates the REAL exit code (measured:
// `fn main() = 7` exits 7 through the shim).
//
// WASI has no exec. That is a substrate fact, not a gap to paper over, so the
// handler is named for what it is and REFUSES. The shim owns the seam honestly;
// this arm's job is to never claim otherwise.
handler process_no_exec {
  process_exec(entry) => {
    eprint_string("mentl run: cannot execute {entry} from inside wasm — WASI has no exec.\n")
    eprint_string("  the install shim owns this seam: `mentl run {entry}` via ~/.local/bin/mentl\n")
    eprint_string("  compiles, assembles, and runs it, returning the program's own exit code.\n")
    resume(1)
  }
}

fn run_run(target) = {
  // run IS compile then process_exec ~> <a Process handler> — one handler
  // swap over the SAME compile graph. compile emits the module; the run
  // performs process_exec(entry). Under WASI the only truthful handler is
  // process_no_exec, which refuses; the shim performs the run for real.
  {
    compile(target)
    process_exec(target)
  }
    ~> process_no_exec
    ~> wat_stdout
    ~> wasi_filesystem
    ~> no_iter_context
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

// ─── check_run — diagnostics; no emit
//
// Same handler chain as compile_run minus wat_stdout — the diagnostic
// pipeline is the value; emission is suppressed.

// check's exit code IS the ledger, read live. It reported E_MissingModule and
// exited 0 — a claim about the program ("fine") that the handler one frame away
// knew was false. The read must sit INSIDE the chain: diagnostics_handler is
// installed here, so the op resolves to the same install that did the counting.
// Safe by measurement: nothing in tools/ or .githooks/ reads check's exit code
// (every gate drives the wheel through stdin), so this cannot regress a gate —
// and on the wheel's own source it will now exit nonzero, which is simply true
// and is exactly what the census ratchet is driving to zero.
// pipeline_check hands back its own error count — it owns the handler that did
// the counting. Reading the tally from a handler installed out here returned 0
// forever, because innermost-wins means those reports never reached this
// install: the counter and the count are one handler. That cost a build to find.
//
// The chain this fn used to install is gone with it: pipeline_check already
// installs wasi_filesystem / graph_handler / mutate_sink / diagnostics_handler
// at its own foot, so those were shadowed duplicates, and the surviving
// expression is pure arithmetic over the count.
fn check_run(target) =
  if pipeline_check(target) > 0 { 1 } else { 0 }

// The file's own positions: a graph handle joins the field iff its span
// lies inside the target's weave range — the range map is the one
// authority on which lines are this file's.
fn field_positions(handles, fstart, nlines) with GraphRead + Memory + Alloc + !Mutate =
  filter((h) => {
    let Span(sl, _, _, _) = caret_span_of_handle(h)
    sl >= fstart && sl < fstart + nlines
  }, handles)

// Rank by the one scorer, descending: structural sort ascends by the
// (score, handle) pair — the compare fold's f64 leaf orders the score,
// the handle breaks ties deterministically — then reverse. The pair list
// rides the same wide-tuple machinery mn-generic-wide-tuple-pattern gates.
fn field_ranked(handles, caret0) with GraphRead + Memory + Teach + Alloc + !Mutate =
  reverse(sort(map((h) => {
    let Cursor(_, _, sc) = score_one_position(h, caret0)
    (sc, h)
  }, handles)))

fn render_field_tier(ranked, target, ranges, fstart, i) = {
  if i >= len(ranked) { () }
  else {
    let (_, ph) = list_index(ranked, i)
    let pspan = caret_span_of_handle(ph)
    let Span(sl, sc, _, _) = pspan
    print_string("\n── {target}:{int_to_str(sl - fstart + 1)}:{int_to_str(sc)}\n")
    render_at(cursor_at_handle(ph), ph, pspan, ranges)
    render_field_tier(ranked, target, ranges, fstart, i + 1)
  }
}

// ─── render_field — the N-CURSOR read (`mentl <file>:0`) ────────────
//
// The whole absence field of ONE file, ranked and rendered: every
// authored hole first (absence categorically outranks — the same tier
// law cursor_argmax_compute states; filling a hole lifts the
// executable's own refusal), then the annotation-gradient positions,
// each tier sorted by the ONE score_one_position projection. Each
// position renders through the SAME cursor_at_handle + render_at path
// the single-address form uses — a hole's line carries its Propose fan
// (the survivor space), an annotation position its Teach line. The
// argmax is this list's head; the field is the argmax UNCOLLAPSED —
// the multi-cursor read, sequential (the per-position `><` under
// `~> Thread` rides Hβ.ops.wasmtime-runner-migration).
fn render_field(target, ranges, fstart, nlines) = {
  let caret0 = Caret(0, Located(Span(fstart, 1, fstart, 1), Inferred("field read")))
  let holes = field_positions(enumerate_hole_positions(), fstart, nlines)
  let grads = field_positions(enumerate_gradient_positions(), fstart, nlines)
  print_string("Field: {int_to_str(len(holes))} hole(s), {int_to_str(len(grads))} gradient position(s) in {target}\n")
  render_field_tier(field_ranked(holes, caret0), target, ranges, fstart, 0)
  render_field_tier(field_ranked(grads, caret0), target, ranges, fstart, 0)
  0
}

// ─── at_run — the cursor-address transport (`mentl <file>:L[:C]`)
//
// The smallest transport of the one read: resolve the address to a graph
// node ONCE (the three-case line rule over the span index every node
// writes at birth), project the eight aspects THROUGH the same CursorView
// `mentl edit` reads (cursor_at_handle — by handle, no re-resolution),
// and render the facets whose content is non-trivial (the voice's
// silence predicate at the terminal). Spans render back to file:line
// through the module-range map the driver's own concatenation fold
// carries (driver_entry_with_ranges — computed where the fold runs,
// once, never a second ledger).
fn at_run(target, line, col) = {
  infer_context(() =>
    {
    let (_ast, ranges) = driver_entry_with_ranges(target)
    if diag_errors() > 0 { 1 }
    else {
      match range_of_module(ranges, target) {
        None => {
          eprint_string("mentl: {target} did not load — nothing to project\n")
          1
        },
        Some(r) => {
          let (_m, _p, start, nlines) = r
          if line == 0 { render_field(target, ranges, start, nlines) }
          else if line < 0 { eprint_string("mentl: line {int_to_str(line)} — lines count from 1 (0 = the whole-file field)\n") 1 }
          else if line > nlines {
            eprint_string("mentl: {target} has {int_to_str(nlines)} lines; {int_to_str(line)} is past the end\n")
            1
          } else {
            let gline = start + line - 1
            let spans = span_index_of_snapshot()   // drift-audit: ignore — sequenced effectful snapshot read (stream-consumer), CLAUDE.md Anchor 6 exclusion
            match address_resolve(spans, gline, col) {
              None => {
                eprint_string("mentl: no node at {target}:{int_to_str(line)} (a blank or comment-only line)\n")
                1
              },
              Some(pick) => {
                let (pspan, ph) = pick
                render_at(cursor_at_handle(ph), ph, pspan, ranges)
                0
              }
            }
          }
        }
      }
    }
  }
      ~> patch_to_file
      ~> terminal_transport
      ~> cursor_default
      ~> delta_default
      ~> synth_default
      ~> interrogate_default
      ~> mentl_default
      ~> wasi_filesystem
  )
}

fn span_index_of_snapshot() with GraphRead = {
  let Graph(_n, _e, _x, _o, spans) = graph_snapshot()   // drift-audit: ignore — sequenced effectful read (stream-consumer/checkpoint), CLAUDE.md Anchor 6 exclusion
  spans
}

fn range_of_module(ref ranges, ref target) with Memory + Alloc = {
  find((r) => { let (m, _, _, _) = r m == target }, ranges)
}

// The span's file:line through the module-range map — the render-side
// inverse of the concatenation fold.
fn file_line_of(ref ranges, ref span) with Memory + Alloc = {
  let Span(sl, _, _, _) = span
  match find((r) => { let (_, _, start, nlines) = r sl >= start && sl < start + nlines }, ranges) {
    Some(r) => { let (_, p, start, _) = r Some((p, sl - start + 1)) },
    None    => None
  }
}

fn file_line(ref ranges, ref span) with Memory + Alloc =
  match file_line_of(ranges, span) {
    Some(pl) => { let (p, l) = pl "{p}:{int_to_str(l)}" },
    None     => { let Span(sl, _, _, _) = span "line {int_to_str(sl)}" }
  }

// The three-case line rule (the panel's corrected form, deterministic):
//  (a) among nodes whose span STARTS on the line (and, with a column,
//      contains it) — smallest start column, then largest area (the
//      line's statement root);
//  (b) else the tightest node COVERING the point (a continuation line);
//  (c) else the nearest node by start line (the no-Module-root top-level
//      gap — blank lines between decls are ordinary addresses, not errors).
fn address_resolve(ref spans, gline, col) with Memory + Alloc = {
  match address_case_a(spans, gline, col, 0, len(spans), None) {
    Some(pick) => Some(pick),
    None => {
      let point = Span(gline, if col > 0 { col } else { 1 }, gline, if col > 0 { col } else { 1 })
      match find_tightest(spans, point, None, 1000000000) {
        Some(h) => span_pick_of(spans, h),
        None    => address_case_c(spans, gline, 0, len(spans), None)
      }
    }
  }
}

fn address_case_a(ref spans, gline, col, i, n, best) with Memory = {
  if i >= n { best }
  else {
    let (s, h) = list_index(spans, i)
    let Span(sl, sc, _, _) = s
    let hits = if sl == gline {
      if col > 0 { span_contains(s, Span(gline, col, gline, col)) } else { true }
    } else { false }
    let next = if hits { address_better_a(col, best, (s, h)) } else { best }
    address_case_a(spans, gline, col, i + 1, n, next)
  }
}

// The two address intents pick OPPOSITE extremes of the containing set.
// `file:LINE` (col 0) means "the line" — its ROOT, the WIDEST node (the
// statement/expression covering most of the line: `echo(mix, x)` over the
// wet binder it feeds). `file:L:C` (col > 0) means "this exact position" —
// the TIGHTEST node containing the point, so pointing at a `??` reaches
// the hole node itself (and its Propose facet), never the enclosing decl
// that also contains the column. Ties break leftward in both modes.
fn address_better_a(col, best, cand) with Memory = match best {
  None => Some(cand),
  Some(b) => {
    let (bs, _) = b
    let (cs, _) = cand
    let Span(_, bsc, _, _) = bs
    let Span(_, csc, _, _) = cs
    let narrower = if col > 0 { span_area(cs) < span_area(bs) }
                   else       { span_area(cs) > span_area(bs) }
    if narrower { Some(cand) }
    else if span_area(cs) == span_area(bs) {
      // Identical spans: the LATEST mint wins — mint order builds
      // constituents before composites, so the later node is the more
      // derived reading of the same position (a `??` mints its id cell
      // first, then the NHole node over the same span; the address must
      // reach the NHole, whose Propose facet speaks). Distinct starts
      // keep the leftward tie-break.
      if csc == bsc { Some(cand) }
      else if csc < bsc { Some(cand) } else { best }
    }
    else { best }
  }
}

fn span_pick_of(ref spans, h) with Memory + Alloc = {
  match find((e) => { let (_, eh) = e eh == h }, spans) {
    Some(e) => { let (s, _) = e Some((s, h)) },
    None    => None
  }
}

fn address_case_c(ref spans, gline, i, n, best) with Memory = {
  if i >= n { best }
  else {
    let (s, h) = list_index(spans, i)
    let Span(sl, _, _, _) = s
    let d = if sl > gline { sl - gline } else { gline - sl }
    let next = match best {
      None => Some((s, h)),
      Some(b) => {
        let (bs, _) = b
        let Span(bsl, _, _, _) = bs
        let bd = if bsl > gline { bsl - gline } else { gline - bsl }
        if d < bd { Some((s, h)) } else { best }
      }
    }
    address_case_c(spans, gline, i + 1, n, next)
  }
}

// ─── the terse render — facet-silence at the terminal
fn render_at(view, h, pspan, ranges) = {
  let CursorView(kind, propose, _topology, row, trace, verify, teach, why) = view
  // The register-gated lede — the read side of the comment weave the
  // parser fills: a node carrying authored prose speaks its first line
  // before the Query facet, the same edge the Why engine walks.
  let prose = graph_comment_at(h)
  if len(prose) > 0 {
    print_string("Lede: {comment_first_line(prose)}\n")
  } else { () }
  print_string("Query: {source_slice(pspan, ranges)}{node_query_line(h, kind)}\n")
  // The Propose facet — the socket's content at the address surface. The
  // graph already computed it (propose_at runs synth at an authored hole;
  // empty everywhere else, so silence needs no second hole check). Exactly
  // one proven survivor is the medium's answer, rendered through the SAME
  // projection the edit transport's accept path uses; two or more is the
  // tie that TEACHES (never a hidden first-wins pick between proven
  // survivors — PLAN §5's tie-break law at this surface too).
  match propose {
    Proposals([], _)         => (),
    Proposals([only], _)     => {
      let (survivor, _r) = only
      print_string("Propose: {render_candidate_source(survivor)}\n")
    },
    Proposals(survivors, _)  => {
      // The FAN projected: a tie TEACHES by showing the actual proven
      // space — every survivor rendered with its Reason — then names the
      // move that collapses it. Never a hidden first-wins pick.
      print_string("Propose: {int_to_str(len(survivors))} proven survivors — a tie:\n")
      each((pair) => {
        let (node, reason) = pair
        print_string("  {render_candidate_source(node)}  — {show_reason(reason)}\n")
      }, survivors)
      print_string("  one more constraint (a refinement, a type, an example) collapses it\n")
    }
  }
  match row {
    EfRow([], [], EtClosed) => (),
    _      => print_string("Effects: {show_effrow(row)}\n")
  }
  match trace {
    Unmarked => (),
    Own      => print_string("Ownership: own\n"),
    Ref      => print_string("Ownership: ref\n")
  }
  if len(verify) > 0 {
    print_string("Verify: {int_to_str(len(verify))} obligation(s) at this node\n")
  } else { () }
  match teach {
    None    => (),
    Some(_) => print_string("Teach: an annotation here would unlock a capability — `mentl teach` names it\n")
  }
  print_string("Why: ")
  render_why_hops(why_expand(why, 0), ranges, 0)
}

fn node_query_line(h, kind) with GraphRead + EnvRead + Memory + Alloc + Intern = {
  // A declaration node's own graph cell is a free var (the scheme lives in
  // the env — read it there, never render the raw t-var); every other node
  // shows its inferred type.
  match graph_node_body(h) {
    NStmt(FnStmt(name, _, _, _, _)) => match env_lookup(name) {
      Some(entry) => {
        let (scheme, _, _) = entry
        match scheme { Forall(_, ty) => show_type(ty) }
      },
      None => show_type(ty_of_kind(h, kind))
    },
    // A literal's type IS its body when the cell is still free (a top-level
    // let's value node keeps its own cell unbound; the body already proves
    // the answer — read it, never render the raw t-var).
    NExpr(LitFloat(_))  => "Float",
    NExpr(LitInt(_))    => "Int",
    NExpr(LitString(_)) => "String",
    NExpr(LitBool(_))   => "Bool",
    _ => show_type(ty_of_kind(h, kind))
  }
}

// The addressed source text itself, read back through the range map — the
// line the user pointed at, sliced to the node's span. The file is the one
// authority on its own text.
fn source_slice(ref span, ref ranges) with Filesystem + Memory + Alloc = {
  let Span(sl, sc, _, ec) = span
  match find((r) => { let (_, _, start, nlines) = r sl >= start && sl < start + nlines }, ranges) {
    None => "",
    Some(r) => {
      let (_, p, start, _) = r
      if fs_exists(p) {
        let text = fs_read_file(p)
        let lstart = nth_line_offset(text, sl - start, 0, 0)
        let lend = line_end_from(text, lstart)
        let a = lstart + sc - 1
        let b = lstart + ec
        let lo = if a < lend { a } else { lstart }
        let hi = if b <= lend { b } else { lend }
        if hi > lo { "{str_slice(text, lo, hi)} : " } else { "" }
      } else { "" }
    }
  }
}

// Byte offset of the k-th line (0-based) — a forward newline walk.
fn nth_line_offset(ref text, k, i, line) with Memory = {
  if line >= k { i }
  else if i >= byte_len(text) { i }
  else if byte_at(text, i) == 10 { nth_line_offset(text, k, i + 1, line + 1) }
  else { nth_line_offset(text, k, i + 1, line) }
}

fn line_end_from(ref text, i) with Memory = {
  if i >= byte_len(text) { i }
  else if byte_at(text, i) == 10 { i }
  else { line_end_from(text, i + 1) }
}

// The Why chain, one hop per line: file:line through the range map, the
// hop's own phrase, and — where the graph carries them — the binding's
// literal value (node_const at the let's value node, read live) and the
// author's attached `//` lede (graph_comment_at). The prose rides the
// same rails as the types: nothing here is stored twice.
fn render_why_hops(reason, ranges, depth) = {
  if depth > 7 { print_string("\n") }
  else {
    match reason {
      Located(span, inner) => {
        if depth > 0 { print_string("     ") } else { () }
        print_string("{reason_phrase(inner)}, at {file_line(ranges, span)}{binding_ledes(span, inner)}\n")
        render_why_deeper(inner, ranges, depth)
      },
      VarLookup(name, br) => {
        if depth > 0 { print_string("     ") } else { () }
        print_string("{name} read here\n")
        render_why_hops(br, ranges, depth + 1)
      },
      _ => {
        if depth > 0 { print_string("     ") } else { () }
        print_string("{show_reason(reason)}\n")
      }
    }
  }
}

fn render_why_deeper(inner, ranges, depth) = match inner {
  VarLookup(_, br)          => render_why_hops(br, ranges, depth + 1),
  LetBinding(_, br)         => render_why_hops(br, ranges, depth + 1),
  FnReturn(_, br)           => render_why_hops(br, ranges, depth + 1),
  InferredCallReturn(_, br) => render_why_hops(br, ranges, depth + 1),
  InferredPipeResult(_, br) => render_why_hops(br, ranges, depth + 1),
  // A unification joins TWO provenances — walk both (the second indented
  // as its own branch), the DAG rendered as the tree it is.
  Unified(a, b)             => {
    render_why_hops(a, ranges, depth + 1)
    render_why_hops(b, ranges, depth + 1)
  },
  OpConstraint(_, a, b)     => {
    render_why_hops(a, ranges, depth + 1)
    render_why_hops(b, ranges, depth + 1)
  },
  IfBranch(br)              => render_why_hops(br, ranges, depth + 1),
  Instantiation(_, br)      => render_why_hops(br, ranges, depth + 1),
  _                         => print_string("")
}

fn reason_phrase(inner) with Memory + GraphRead + Alloc + Intern = match inner {
  VarLookup(name, _)          => "{name} flows in here",
  LetBinding(name, _)         => "let {name}",
  Declared(name)              => "declared {name}",
  Inferred(s)                 => s,
  FnReturn(name, _)           => "returned from {name}",
  FnParam(name, i, _)         => "parameter {name}",
  InferredCallReturn(name, _) => "the call to {name}",
  InferredPipeResult(v, _)    => "through {v}",
  MissingVar(name)            => "{name} is unresolved",
  Placeholder(_)              => "authored here",
  _                           => show_reason(inner)
}

// The value + comment ledes at a binding hop — both read LIVE from the
// graph (the let's value node via node_const; the attached comment via
// the comment weave). Empty strings when the graph carries neither.
fn binding_ledes(span, inner) with GraphRead + Memory + Alloc = match inner {
  LetBinding(_, _) => {
    let spans = span_index_of_snapshot()   // drift-audit: ignore — sequenced effectful snapshot read (stream-consumer), CLAUDE.md Anchor 6 exclusion
    match address_case_a(spans, span_line_of(span), 0, 0, len(spans), None) {
      None => "",
      Some(pick) => {
        let (_, sh) = pick
        "{value_lede(sh)}{comment_lede(sh)}"
      }
    }
  },
  _ => ""   // drift-audit: ignore — genuine String-null lede: a non-binding hop carries no value/comment lede by construction
}

fn span_line_of(ref s) with Pure = { let Span(sl, _, _, _) = s sl }

fn value_lede(sh) with GraphRead + Alloc + Memory = match graph_node_body(sh) {
  NStmt(LetStmt(_, value, _)) => {
    let N(_, _, vh) = value
    match node_const(vh) {
      Some(LVInt(n))    => " = {int_to_str(n)}",
      Some(LVFloat(f))  => " = {float_to_str(f)}",
      Some(LVString(s)) => " = \"{s}\"",
      Some(LVBool(b))   => if b { " = true" } else { " = false" },
      None              => ""
    }
  },
  _ => ""   // drift-audit: ignore — genuine String-null lede: a non-let node has no binding value to render
}

fn comment_lede(sh) with GraphRead + Alloc + Memory = {
  let c = graph_comment_at(sh)
  if byte_len(c) == 0 { "" } else { ", {comment_first_line(c)}" }
}

fn comment_first_line(ref c) with Memory + Alloc = {
  let cut = addr_newline_at(c, 0, byte_len(c))
  if cut < 0 { c } else { str_slice(c, 0, cut) }
}

fn addr_newline_at(ref s, i, n) with Memory = {
  if i >= n { 0 - 1 }
  else if byte_at(s, i) == 10 { i }
  else { addr_newline_at(s, i + 1, n) }
}

// ─── test_run — Test effect handler chain
//
// Per EH §1.3 + lib/test.mn: assert / assert_eq / assert_near
// dispatch through assert_reporter (runtime) + verify_assert
// (compile-time lifting). Named follow-up: Hβ.test.lib-test-mn-substrate.

// test = the Test effect handler chain over the checked graph. The test
// module is checked (its assertions typecheck against the one graph), then
// its check arms dispatch through assert_reporter — assert/assert_eq are
// the Test effect's ops, the handler decides pass/fail (lib/test.mn: "the
// handler decides what happens"). The reporter is a handler swap: the same
// test source runs under assert_reporter (pass/fail counts) or a benchmark
// handler (timing). Execution of the test fns reaches the process boundary
// (Hβ.cli.process-exec-wire, shared with run); the check + reporter chain
// is the structural form, real now.

fn test_run(target_opt) = {
  let entry_module = match target_opt {
    Some(t) => t,
    None    => "test"  // default test entry module
  }
  // A DIRECTORY target is the BATTERY: every .mn inside is a self-describing
  // gate (its first comment declares `// expect: N` — the expectation lives
  // ON the artifact, SYNTAX §Comments), compiled IN THIS PROCESS with a
  // fresh handler chain per micro (handler state initializes at install —
  // per-micro isolation is the install itself), each WAT written to
  // .build/test/, and a manifest printed for the shim's exec loop (WASI has
  // no process-spawn; the shim owns exec — the one seam). One process
  // replaces one wasmtime invocation per micro.
  // The directory probe and the battery run in the SAME handler extent the
  // single-file sibling installs — the fs probe itself is a WasiFilesystem
  // op, so the bracket must cover the scrutinee too. This install was
  // MISSING (the battery's fs/console ops ran as null-state singletons,
  // reading the null page as their state — tolerated by accident until the
  // SingletonUninstalled guard refused it); test_check_run keeps its own
  // inner chain, which shadows these installs for its extent, unchanged.
  {
    match fs_list_dir_impl(entry_module) {
      Some(names) => battery_run(entry_module, names),
      None => test_check_run(entry_module)
    }
  }
    ~> stdout_console
    ~> wasi_filesystem
    ~> diagnostics_handler
}

fn test_check_run(entry_module) = {
  pipeline_check(entry_module)
    ~> assert_reporter
    ~> stdout_console
    ~> wasi_filesystem
    ~> no_iter_context
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

// ─── The battery: `mentl test <dir>` ────────────────────────────────────
// The micro battery IS the medium reading its own gates: glob the directory,
// read each micro's own `// expect: N` header, compile each against the
// runtime lib set in ONE process, write the WATs, print the manifest. The
// refusal law holds batch-shaped: a micro whose ledger shows errors / holes /
// armed refusals gets a FAILC line and NO WAT (the same
// errors-holes-refusals read executable_gate makes; here the boundary is the
// batch, so the verdict is a manifest line instead of proc_exit).

fn battery_libs() -> String with Memory + Alloc + WASI =
  fs_read_file_impl("lib/runtime/memory.mn")
    ++ fs_read_file_impl("lib/runtime/strings.mn")
    ++ fs_read_file_impl("lib/runtime/lists.mn")
    ++ fs_read_file_impl("lib/prelude.mn")

// The micro's own expectation: first line `// expect: N`. None = not a
// battery member (skipped loudly by the manifest consumer).
fn battery_expect(src) with Memory + Alloc = {
  let prefix = "// expect: "
  if byte_len(src) < 12 { None }
  else if !str_eq(str_slice(src, 0, 11), prefix) { None }
  else { Some(battery_expect_digits(src, 11, 0)) }
}

fn battery_expect_digits(src, i, acc) with Memory = {
  if i >= byte_len(src) { acc }
  else {
    let b = byte_at(src, i)
    if b >= 48 && b <= 57 { battery_expect_digits(src, i + 1, acc * 10 + (b - 48)) }
    else { acc }
  }
}

// One micro, one fresh chain — the same chain compile_stdin drives, with
// wat_to_string collecting the module instead of streaming to stdout. The
// verdict pair: (wat, 0) on success, ("", 1) on a ledger-refused compile.
fn battery_compile(src) = {
  infer_context(() =>
    {
    let lowered = src |> frontend |> infer_program |> saturate_pass |> lower_program |> reachable_from_main
    // THE SAME law executable_gate applies, batch-shaped: refusal = holes +
    // ARMED classes only. Unarmed errors surface on stderr and the compile
    // proceeds — the sound-incomplete contract; the battery must not be
    // stricter than the medium (it FAILC'd ev2 for an unarmed row mismatch
    // the check verb tolerates).
    let holes = collect_value_holes_decls(lowered)
    let refused = diag_refusals()   // drift-audit: ignore — sequenced effectful ledger read (the executable_gate precedent)
    if len(holes) > 0 || refused > 0 { ("", 1) }
    else {
      emit_module(lowered)
      (wat_collect(), 0)
    }
  }
      ~> wat_to_string
      ~> wasi_filesystem
      ~> string_table
      ~> emit_memory_bump
      ~> body_context
      ~> mentl_default
      ~> lower_scope
      ~> arm_state_ctx([], OneShot, "")
      ~> spec_registry
  )
}

fn battery_run(dir, names) = {
  fs_mkdir(".build")
  fs_mkdir(".build/test")
  // libs is MATERIALIZED flat (str_concat("", x) — the view-flatten idiom)
  // BELOW the loop's first mark: a concat spine here would be poisoned by
  // the region resets — compile #1's flatten memoizes the flat buffer INTO
  // the spine nodes (an in-place memo pointing above the mark), the reset
  // kills the buffer, and compile #2 reads garbage (measured: any second
  // compile trapped in infer until this line).
  let libs = str_concat("", battery_libs())
  // The names list flattens below the mark for the same reason (sort returns
  // a concat spine; indexing memoizes in place).
  let micros = list_to_flat(sort(filter((n) => ends_with(n, ".mn"), names)))
  // A RAW recursion, not a handler fold: each call's compile is a REGION
  // (heap_mark before, heap_reset after — everything the micro allocated is
  // dead once its WAT is written, and every micro starts at the same
  // watermark, so per-micro output is deterministic regardless of
  // predecessors). A handler-based fold cannot host the region: its own
  // iteration machinery allocates per-step frames the reset would kill
  // (measured: iteration 2 trapped in op_fold_handler_yield). The
  // recursion's only cross-iteration state is word params — nothing lives
  // above the mark.
  battery_loop(dir, libs, micros, 0, 0)
}

fn battery_loop(dir, libs, micros, i, fails) = {
  if i >= len(micros) { fails }
  else {
    // Each micro's compile is a REGION: mark before, reset after — the
    // virginity contract (heap_reset zeroes [mark, bump)) makes every
    // compile start at the same watermark with genuinely virgin memory, so
    // per-micro output is deterministic regardless of predecessors and the
    // battery's peak stays one compile's live set (~192MB measured), not
    // the sum. The cross-compile trap that blocked this form was the
    // effect-census collector running as a NULL-STATE singleton in emit's
    // walk extent (its accumulator at address 12 — below the mark, never
    // reset, holding a stale pointer into the region): closed at the root
    // by the project_emit_state install + the SingletonUninstalled guard,
    // and the full battery runs region-bracketed 112/112.
    let mark = heap_mark()   // drift-audit: ignore — sequenced effectful read (allocator checkpoint consumed by heap_reset), CLAUDE.md Anchor 6 exclusion
    let name = micros[i]
    let stem = str_slice(name, 0, byte_len(name) - 3)
    let src = fs_read_file_impl("{dir}/{name}")
    let step = match battery_expect(src) {
      None => {
        print_string("NOEXPECT {stem}\n")
        1
      },
      Some(want) => {
        let (wat, failed) = battery_compile(libs ++ src)
        if failed > 0 {
          print_string("FAILC {stem}\n")
          1
        } else {
          fs_write_file_impl(".build/test/{stem}.wat", wat)
          print_string("MICRO {stem} .build/test/{stem}.wat {int_to_str(want)}\n")
          0
        }
      }
    }
    heap_reset(mark)
    battery_loop(dir, libs, micros, i + 1, fails + step)
  }
}

// assert_reporter — the Test effect's pass/fail reporter handler. Each
// check(cond, msg) folds into (passed, failed); get_results projects the
// tally. The handler IS the test framework (no framework needed —
// lib/test.mn). State threads the counts; a failing assertion surfaces its
// message at the WASI boundary.
handler assert_reporter with passed = 0, failed = 0 {
  check(cond, msg) =>
    if cond {
      resume() with passed = passed + 1
    } else {
      eprint_string("  FAIL: {msg}\n")
      resume() with failed = failed + 1
    },
  get_results() => resume((passed, failed))
}

// ─── audit_run — capability set + severance suggestions
//
// Walks the ~> chain; collects effect rows transitively; emits
// AuditReport. Per DESIGN §9.1 + traces/a-day §1400.

fn audit_run(target) = {
  audit(target)
    ~> stdout_console
    ~> wasi_filesystem
    ~> mentl_default
    ~> verify_ledger
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

// ─── query_run — structured ad-hoc query
//
// `mentl query <module> "<question>"` — read-only query against
// the substrate. Per traces/a-day §0800 + DESIGN §8 mentl query.

fn query_run(target, question) = {
  query(target, question)
    ~> stdout_console
    ~> wasi_filesystem
    ~> mentl_default
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

// ─── with_run — the universal escape hatch (env_lookup resolution)
//
// `mentl --with <handler> [path]` installs an arbitrary user-defined
// entry-handler resolved by env_lookup — the SAME mechanism every
// built-in verb uses (the env IS the dispatch table; the type system IS
// the package manager, §5). The handler name resolves against the
// checked program's env; a built-in and a user verb are one lookup.
// Resolution of the handle into the install site is the named peer
// Hβ.cli.user-defined-entry-handler-resolution — the env overlay it
// reads is the per-module env the driver populates (driver IC.3 chase).

fn with_run(handler_name, target_opt) = {
  let entry_module = match target_opt {
    Some(t) => t,
    None    => "main"
  }
  pipeline_check(entry_module)
  match env_lookup(handler_name) {
    None    => eprint_string("mentl --with: no handler named {handler_name} in the checked env\n"),
    Some(_) => eprint_string("mentl --with {handler_name}: resolved; install via Hβ.cli.user-defined-entry-handler-resolution\n")
  }
  // The verb is named but its install path is unbuilt — the CLI refusal
  // law: a named verb that cannot do its work exits nonzero.
  1
}

// ─── teach_run — terminal voice surface (default)
//
// Bare `mentl` defaults here per EH. Gradient narration; one
// suggestion per turn; Mentl's voice in the terminal for
// vim/helix/terminal-only users.

fn teach_run(target_opt) = {
  let entry_module = match target_opt {
    Some(t) => t,
    None    => "main"
  }
  // teach reaches inference — the core installs as the one bracket (this
  // chain was the eighth found missing the analysis handlers, by design
  // pass not by trap; query_default's env_lookup / env_snapshot resolve
  // into the bracket's env).
  infer_context(() =>
    teach(entry_module)
      ~> stdout_console
      ~> wasi_filesystem
      ~> mentl_voice_default
      ~> query_default          // mentl_voice_default's consult/run_query bubble Query.ask here
  )
}

// ─── repl_run — the line-eval cursor
//
// The REPL IS the cursor reading one line at a time: each line is a
// frontend |> infer projection, the result spoken through the voice
// surface (the same teach projection, scoped to one entry). It is the
// `<~` edit loop (cursor_transport) with the line as the caret event —
// one cursor, the terminal transport, fed line-by-line. The stdin line
// reader is the host boundary (Hβ.repl.line-read-wire, peer of the
// process/web/nvim wires); the eval-and-project chain is real now.

fn repl_run() = {
  // The line-eval runs infer; the core installs as the one bracket (the
  // driverless-zero-state class the bounds trap unmasked lives in its law).
  infer_context(() =>
    repl_eval_line(read_stdin_line())
      ~> stdout_console
      ~> wasi_filesystem
      ~> mentl_voice_default
      ~> query_default
  )
}

// repl_eval_line — one cursor read of a source line: lex |> parse |> infer,
// then project the inferred shape through the voice surface. Empty line is
// the empty projection (the cursor at rest), never a fabricated value.
fn repl_eval_line(line) = {
  if byte_len(line) == 0 { "" }
  else {
    let ast = line |> frontend
    infer_program(ast)
    render_query_result(ask(parse_query_string("type main")))
  }
}

// ─── new — the welcome's own WRITE
//
// The welcome PROJECTS a directory (project_directory, the READ); `new`
// draws the first edge into it (the WRITE) and then re-projects. One
// graph, two operations, at the shell — `new` is the second operation,
// never a scaffolding engine.
//
// ONE FILE, never a tree. A project directory exists to hold a manifest,
// and the imports ARE the manifest (PLAN §11's novelty audit); a `.mn`
// file carrying `fn main()` IS an executable (SYNTAX §Top-level program
// structure), so `hello.mn` beside you IS the project — and `mentl run
// hello` reaches it through the resolver's own first arm (driver.mn's
// direct read). `{name}/src/main.mn` was Cargo's shape borrowed one level
// down, and the resolver could not even see it.
//
// The seed is a string the medium CARRIES (new_seed). Reading it from a
// repo file made the CLI depend on an artifact outside itself: from any
// directory but the repo, fs_read_file found nothing, returned "" (its
// own surrender-fallback) and `new` wrote a ZERO-BYTE file while printing
// "scaffolded ... from lib/tutorial/00-hello.mn" — a claim about the
// world that was false.
//
// So `new` states nothing it did not read. It never claims "wrote
// hello.mn"; it re-projects the directory and lets the file speak for
// itself — a write followed by the live read is unfalsifiable, and it is
// the same `<~` the cursor session runs (draw the edge, re-project).

fn new_project(name) = {
  scaffold_project(name)
    ~> wasi_filesystem
    ~> no_iter_context
    ~> diagnostics_handler
    ~> graph_handler
    ~> mutate_sink
}

fn scaffold_project(name) = {
  let dest = "{name}.mn"
  if fs_exists(dest) {
    // Refusal teaches: the medium never overwrites what it did not write.
    eprint_string("mentl new {name}: {dest} is already here\n\n")
    eprint_string("the medium never overwrites what it did not write.\n")
    eprint_string("  read it:      mentl edit {name}\n")
    eprint_string("  or name another:  mentl new {name}2\n")
    1
  } else {
    fs_write_file(dest, new_seed())
    project_directory()
    0
  }
}

// The seed the medium carries — the smallest program that RUNS and whose
// own comments are the Reason edges it talks about. Not the curriculum
// (lib/tutorial/ is the curriculum, and it is not on a user's disk).
// The `\{who\}` escapes emit literal braces, so the FILE gets a live
// interpolation the user's own compile reads.
fn new_seed() =
  "// this file is the whole project — the imports are the manifest.\n//\n// the comment you are reading is not a remark the lexer discards: it is\n// a Reason edge in the graph. ask the medium about this file:\n//   mentl audit   — what it is allowed to do\n//   mentl edit    — the cursor, and what it proposes\n\nimport runtime/io\n\n// `|>` is the sequential verb — the string flows into print_string.\n// the topology is on the page; there is no hidden control flow.\nfn greet(who) = \"hello, \{who\} — the medium is reading you back\\n\" |> print_string\n\nfn main() = {\n  greet(\"world\")\n  0\n}\n"

// ─── help + error surface ─────────────────────────────────────────

fn print_error_and_help(msg) = {
  eprint_string("mentl: ")
  eprint_string(msg)
  eprint_string("\n\n")
  print_help()
}

// The verb catalog — ONE surface projected from the verb table, so the help a
// user reads can never disagree with the parser that reads them. The bare
// `mentl` line (the directory projection, not a named verb) frames the list;
// every verb line is verb_specs()[i] rendered uniformly.
fn verb_catalog() with Memory + Alloc =
  "the verbs:\n  mentl                          — project this directory (a pipe compiles stdin)\n"
    ++ catalog_lines(verb_specs(), 0, len(verb_specs()), "")
    ++ "\na target is a module name or a file path, from any directory.\n"
    ++ "the surface: PLAN.md §11 (the production bar) · docs/SYNTAX.md (the language)\n"

// One catalog line per spec: `  mentl <name> <hint>` padded to a column, then
// `— <desc>`. The `++` accumulator IS the O(1) concat rope (§4①), not a loop
// re-alloc — the string grows by pointer, never by copy.
fn catalog_lines(specs, i, n, acc) with Memory + Alloc =
  if i >= n { acc }
  else {
    let VerbSpec(name, hint, _, desc) = specs[i]
    let usage = if byte_len(hint) > 0 { name ++ " " ++ hint } else { name }
    catalog_lines(specs, i + 1, n,
      acc ++ "  mentl " ++ pad_right(usage, 25) ++ "— " ++ desc ++ "\n")
  }

// pad_right — right-pad with spaces to width w (the alignment column). A no-op
// once s already reaches w. Small, bounded, one home for the help alignment.
fn pad_right(s, w) with Memory + Alloc =
  if byte_len(s) >= w { s } else { pad_right(s ++ " ", w) }

fn print_help() = eprint_string(verb_catalog())

// ─── the welcome — bare `mentl` in a terminal, `mentl help` ────────
//
// Not a manpage: a PROJECTION of where you are (the cursor law at the
// shell). The medium reads the current directory through the preopen,
// names the .mn sources it sees, and offers each one's next keystroke;
// an empty directory gets the beginning. stdout, exit 0 — help asked
// for is never an error (the ERROR surface, print_error_and_help,
// stays on stderr).
fn welcome_run() = {
  print_string("mentl — the medium between intent and execution\n")
  print_string("any intelligence may propose; nothing executes unproven\n\n")
  project_directory()
  print_string(verb_catalog())
  0
}

// project_directory — the cursor law at the shell: read where you ARE and
// name each source's next keystroke. The welcome opens with it; `new`
// closes with it (which is why `new` never has to claim what it wrote —
// the projection reads the live directory back). An empty directory gets
// the beginning, so the surface is never a dead end.
fn project_directory() = {
  let sources = filter((n) => ends_with(n, ".mn"), fs_list_dir_names())
  if len(sources) > 0 {
    print_string("in this directory:\n")
    each((n) => {
      let stem = str_slice(n, 0, byte_len(n) - 3)
      print_string("  {n}  →  mentl run {stem} · mentl edit {stem} · mentl check {stem}\n")
    }, sources)
    print_string("\n")
  } else {
    print_string("nothing to read here yet — begin:\n  mentl new hello && mentl run hello\n\n")
  }
}
