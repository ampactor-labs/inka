// parser.mn — recursive descent, builds types.mn Nodes directly (spec 03)
//
// The parser produces types.mn's Node ADT directly. No intermediate
// "parser AST." Every construction performs graph_fresh_ty(
// Placeholder(span)) to mint a handle at parse time — inference
// binds the handle once the expression's type is known (one-walk
// HM). Every node has a full Span (spec 03 non-negotiable).
//
// Declares: with GraphWrite + Diagnostic.
// Errors follow Hazel: a parse failure emits report(...) and plants
// an NHole; parsing continues. Ten syntax errors → ten holes.

import types
import graph
import lexer

// Handle minting and node wrapping

fn fresh_handle(span: ValidSpan) = {
  let h = graph_fresh_ty(Placeholder(span))
  graph_index_span(span, h)
  h
}

// Every node is born here: mint its handle, edge-link its body into the
// one graph (graph_register_node at the handle), and wrap it. The body is
// registered AND carried in N — one heap object, two references (the AST
// projection in N, the graph weave keyed by handle), never a copy — so
// resolving the handle (graph_node_body) reads the same body the tree holds.
fn mint_node(body, span: ValidSpan) = {
  let h = fresh_handle(span)
  graph_register_node(h, body)
  N(body, span, h)
}

fn nexpr(e, span: ValidSpan) = mint_node(NExpr(e), span)
fn nstmt(s, span: ValidSpan) = mint_node(NStmt(s), span)
fn npat(p, span: ValidSpan)  = mint_node(NPat(p), span)
fn nhole(id, span: ValidSpan) = mint_node(NHole(id), span)

// Token navigation
// Tokens are typed: `Tok(TokenKind, Span)`. Helpers extract payload
// or compare kinds. Per SYNTAX.md, dispatch uses exhaustive match
// on TokenKind variants — no string equality at parse time.

// kind_at returns the TokenKind variant at position pos (or TEof if past end).
fn kind_at(ref tokens, pos) = {
  if pos >= len(tokens) { TEof }
  else { token_kind(tokens[pos]) }
}

// span_at returns the span of the token at position pos.
fn span_at(ref tokens, pos) = {
  if pos >= len(tokens) { span_zero() }
  else { token_span(tokens[pos]) }
}

// kind_eq compares two TokenKind values for variant identity. Used
// at the few sites where dispatch needs a passed-in kind value;
// most sites just pattern-match directly via `match kind_at(...)`.
/// Constructor identity IS the value word. Every nullary TokenKind compiles
/// to a distinct sentinel (HB: "the value-level tag is the discriminant"),
/// and `==` is structural — type-dispatched at emit to `i32.eq` for an ADT
/// operand. The kernel proves variant identity; the comparison reads it.
/// `at` only ever compares against nullary kind literals, so value-word
/// equality IS constructor equality.
fn kind_eq(a, b) with Pure = a == b

// at: predicate form of kind_eq for a position-and-expected pair.
fn at(ref tokens, pos, kind) = kind_eq(kind_at(tokens, pos), kind)

// A comment is graph content attached at the decl / block-statement boundary
// (parse_stmt / parse_block_body collect-and-attach BEFORE these skips run). At
// every OTHER position — interior of a match / record / handler-arm list — the
// comment's home is the enclosing block (SYNTAX.md Comments: "or, with none, the
// enclosing block"), so the fine-grained list parsers pass over it as layout,
// exactly as they pass over TNewline. Per-interior-position attachment to the
// enclosing block is the positive-form refinement Hβ.parser.interior-comment-
// to-enclosing-block.
fn skip_ws(ref tokens, pos) = {
  match kind_at(tokens, pos) {
    TNewline    => skip_ws(tokens, pos + 1),
    TComment(_) => skip_ws(tokens, pos + 1),
    _           => pos
  }
}

fn skip_sep(ref tokens, pos) = {
  match kind_at(tokens, pos) {
    TSemicolon  => skip_sep(tokens, pos + 1),
    TNewline    => skip_sep(tokens, pos + 1),
    TComment(_) => skip_sep(tokens, pos + 1),
    _           => pos
  }
}

// show_token_kind: human-readable name for diagnostics.
fn show_token_kind(k) with Pure = match k {
  TFn => "fn", TLet => "let", TIf => "if", TElse => "else",
  TMatch => "match", TType => "type", TEffect => "effect",
  THandle => "handle", THandler => "handler", TWith => "with",
  TResume => "resume", TPerform => "perform",
  TImport => "import", TWhere => "where",
  TOwn => "own", TRef => "ref", TPure => "Pure",   // drift-audit: ignore — human-facing token-display rendering, not effect keying; tracked for item 11.B token-rendering normalization
  TTrue => "true", TFalse => "false",
  TIdent(s) => s,
  TIntLit(_) => "<int>", TFloatLit(_) => "<float>", TStringLit(_) => "<string>",
  TComment(_) => "<comment>",
  TStringPart(_) => "<string-part>",
  TStringSplice  => "<string-splice>",
  TEqEq => "==", TBangEq => "!=", TLtEq => "<=", TGtEq => ">=",   // drift-audit: ignore — TokenKind→display-text rendering for diagnostics; not runtime comparison; tracked for item 11.B token-rendering normalization
  TArrow => "->", TFatArrow => "=>", TPlusPlus => "++",
  TPipeGt => "|>", TLtPipe => "<|", TGtLt => "><",
  TTildeGt => "~>", TLtTilde => "<~",
  TAndAnd => "&&", TOrOr => "||",
  TLParen => "(", TRParen => ")",
  TLBrace => "\{", TRBrace => "\}",
  TLBracket => "[", TRBracket => "]",
  TComma => ",", TDot => ".", TColon => ":", TSemicolon => ";",
  TPlus => "+", TMinus => "-", TStar => "*", TSlash => "/", TPercent => "%",
  TEq => "=", TLt => "<", TGt => ">", TBang => "!",
  TAmp => "&",
  TPipe => "|", TAt => "@", THole => "??",
  TNewline => "<newline>", TEof => "<eof>"
}

/// expect: consume `kind`, or emit a Located P_ExpectedToken and recover.
/// Productive-under-error (SYNTAX.md: diagnostics are teaching surfaces with
/// coordinates + a Quick Fix) — on a mismatch the parser NARRATES the missing
/// token (expected vs found, at the found token's span, MachineApplicable
/// insert) and returns pos UNCHANGED so the surrounding production re-syncs
/// from where it stood (no token swallowed). The .mn LEADS the seed: a silent
/// expect was the no-diagnostic surrender shaped to the disposable hand-WAT
/// arbiter (the named anti-pattern "never shape the .mn to the seed"); the
/// ultimate form is MORE truth — the Why projection walks the P_ExpectedToken
/// Reason back to this site. The recover-position is identical to the old
/// behavior, so the parse TREE is byte-identical; only the diagnostic edge is
/// added (the seed, downstream, simply does not emit it).
fn expect(ref tokens, pos, kind) =
  if at(tokens, pos, kind) { pos + 1 }
  else {
    report(PExpectedToken("expected `{show_token_kind(kind)}`, found `{show_token_kind(kind_at(tokens, pos))}`", span_at(tokens, pos)))
    pos
  }

// Payload extractors — return defaults if the kind doesn't match.
// Most call sites should pattern-match directly via `match
// kind_at(tokens, pos) { TIdent(s) => …, TIntLit(n) => …, … }`;
// these helpers are for the few sites (e.g., parse_fn extracting
// the function name after dispatching past TFn) where the parent
// has already verified the variant and just needs the payload.
fn ident_at(ref tokens, pos) = {
  match kind_at(tokens, pos) {
    TIdent(s) => s,
    _         => ""
  }
}

fn int_at(ref tokens, pos) = {
  match kind_at(tokens, pos) {
    TIntLit(n) => n,
    _       => 0
  }
}

fn float_at(ref tokens, pos) = {
  match kind_at(tokens, pos) {
    TFloatLit(f) => f,
    _         => 0.0
  }
}

fn string_at(ref tokens, pos) = {
  match kind_at(tokens, pos) {
    TStringLit(s) => s,
    _          => ""
  }
}

// Operator precedence — THE canonical table, per SYNTAX.md §Precedence.
// Higher number = tighter binding. The same literal integers appear in
// SYNTAX.md and the seed ($op_prec, parser_infra.wat) — one table,
// three projections, zero translation.
//
// The one law of `~>`: precedence 1, the loosest binary operator
// (sharing the floor with nothing — verbs tier above it). The handler
// at the foot of a chain governs everything to its left; parenthesize
// `(stage ~> h)` to narrow. Layout is NEVER semantics — block vs
// inline on the page is the formatter's projection.

fn op_prec(k) with Pure = match k {
  TTildeGt   => 1,
  TLtPipe    => 2,
  TGtLt      => 2,
  TLtTilde   => 2,
  TPipeGt    => 3,
  TOrOr      => 4,
  TAndAnd    => 5,
  TEqEq      => 6,
  TBangEq    => 6,
  TLt        => 7,
  TGt        => 7,
  TLtEq      => 7,
  TGtEq      => 7,
  TPlusPlus  => 8,
  TPlus      => 9,
  TMinus     => 9,
  TStar      => 10,
  TSlash     => 10,
  TPercent   => 10,
  _          => 0
}

/// Pipe-verb token → PipeKind. One token, one kind — `~>` is PTee
/// always; scope is precedence's job, layout is the formatter's.
fn op_to_pipe_kind(k) with Pure = match k {
  TTildeGt => Some(PTee),
  TPipeGt  => Some(PForward),
  // `<|` and `><` are ONE PFanout topology; the glyph authors the
  // ownership aspect (FanShare = one ref-borrowed input; FanDistribute
  // = N owned inputs). The surface keeps both glyphs; ownership CHECKS
  // coherence (own through `<|` → E_OwnershipViolation; the cursor
  // projects the glyph from the inferred ownership at fmt). The verb
  // contributes ZERO execution facts — schedule is a `~>` handler.
  TLtPipe  => Some(PFanout(FanShare)),
  TGtLt    => Some(PFanout(FanDistribute)),
  TLtTilde => Some(PFeedback),
  _        => None
}

/// Map a binop `TokenKind` to `Some(BinOp)`, or `None` if `k` is not
/// a binop-producing token. Caller matches `Some`/`None` explicitly;
/// `None` at that site is unreachable (caller has already filtered via
/// `op_prec(k) > 0` + `op_to_pipe_kind == None`), but the
/// unreachability is expressed at the call site — not fabricated here
/// via a wildcard arm.
///
/// Future form (named peer 11.B.1.R): refinement-typed parameter
///   `fn op_to_binop(k) -> BinOp where is_binop_token(k)`
/// exercises primitive #6 and eliminates the `Option` entirely.
fn op_to_binop(k) with Pure = match k {
  TPlus      => Some(BAdd),
  TMinus     => Some(BSub),
  TStar      => Some(BMul),
  TSlash     => Some(BDiv),
  TPercent   => Some(BMod),
  TPlusPlus  => Some(BConcat),
  TEqEq      => Some(BEq),
  TBangEq    => Some(BNe),
  TLt        => Some(BLt),
  TGt        => Some(BGt),
  TLtEq      => Some(BLe),
  TGtEq      => Some(BGe),
  TAndAnd    => Some(BAnd),
  TOrOr      => Some(BOr),
  _          => None
}

// Program — top-level loop

/// Buffer-pattern helper for recursive parse loops. Each parse loop
/// allocates an initial buffer, threads `(buf, count)` through tail-
/// recursion, and slices at the end. O(N) total allocation per loop
/// regardless of element count.
fn push_node(own buf, count, node) = {
  let extended = list_extend_to(buf, count + 1)
  let written  = list_set(extended, count, node)
  (written, count + 1)
}

fn parse_program(ref tokens) = {
  let buf = make_list(16)
  let (final_buf, final_count, _) = parse_stmt_list(tokens, 0, buf, 0)
  slice(final_buf, 0, final_count)
}

fn parse_stmt_list(ref tokens, pos, own buf, count) = {
  // skip_seps_only (not skip_ws/skip_sep) so a leading comment reaches
  // parse_stmt's TComment arm to be collected-and-attached — never skipped as
  // layout at the decl boundary.
  let p = skip_seps_only(tokens, pos)
  if at(tokens, p, TEof) { (buf, count, p) }
  else {
    let (stmt, next) = parse_stmt(tokens, p)
    let (b1, c1) = push_node(buf, count, stmt)
    parse_stmt_list(tokens, skip_seps_only(tokens, next), b1, c1)
  }
}

// Statements

fn parse_stmt(ref tokens, pos) = match kind_at(tokens, pos) {
  TFn       => parse_fn(tokens, pos + 1),
  TLet      => parse_let(tokens, pos + 1),
  TType     => parse_type_decl(tokens, pos + 1),
  TEffect   => parse_effect_decl(tokens, pos + 1),
  THandler  => parse_handler_decl(tokens, pos + 1),
  TImport   => parse_import(tokens, pos + 1),
  // A comment is graph content (SYNTAX.md Comments): collect the contiguous
  // // run, parse the following declaration, and attach the joined prose to
  // that decl's handle in the comment weave (graph_attach_comment) — the Why
  // engine / formatter / cursor project it live. No wrapper node: the comment
  // edge holds the prose, the decl node is returned directly. With no following
  // decl (EOF), the orphan surfaces P_OrphanDocstring — never discarded.
  TComment(first_line) => {
    let comment_span = span_at(tokens, pos)
    let (full_text, p) = collect_comment(tokens, pos + 1, first_line)
    let p2 = skip_sep(tokens, p)
    if at(tokens, p2, TEof) {
      report(POrphanDocstring(comment_span))
      (nstmt(ExprStmt(nexpr(LitUnit, comment_span)), comment_span), p2)
    } else {
      let (inner_stmt, p3) = parse_stmt(tokens, p2)
      let N(_, _, h) = inner_stmt
      graph_attach_comment(h, full_text)
      (inner_stmt, p3)
    }
  },
  _         => {
    let start_span = span_at(tokens, pos)
    let (expr, next) = parse_expr(tokens, pos)
    (nstmt(ExprStmt(expr), start_span), next)
  }
}

// Skip only line separators (newline / semicolon) — NOT comments. collect_comment
// needs this so the contiguous // run is gathered line-by-line; skip_sep (which
// passes over comments as layout) would swallow the next comment before the run
// could fold it in.
fn skip_seps_only(ref tokens, pos) = {
  match kind_at(tokens, pos) {
    TSemicolon => skip_seps_only(tokens, pos + 1),
    TNewline   => skip_seps_only(tokens, pos + 1),
    _          => pos
  }
}

// Concatenate the contiguous // run into one comment String. One intervening
// newline keeps the run; any other token (incl. a non-comment after a blank
// line) ends it.
fn collect_comment(ref tokens, pos, own acc) = {
  let p = skip_seps_only(tokens, pos)
  match kind_at(tokens, p) {
    TComment(next_line) =>
      collect_comment(tokens, p + 1,
        "{acc}\n{next_line}"),
    _ => (acc, p)
  }
}

/// Parse `fn name(params) [-> retty] [with effects] = body`.
fn parse_fn(ref tokens, pos) = {
  let start = span_at(tokens, pos)
  let name = ident_at(tokens, pos)
  let p = expect(tokens, pos + 1, TLParen)
  let (params, dlets, p2) = parse_fn_params(tokens, p)

  let p3 = skip_ws(tokens, p2)
  let (ret_node, p4) =
    if at(tokens, p3, TArrow) {
      parse_type_expr(tokens, skip_ws(tokens, p3 + 1))
    } else {
      (nexpr(LitUnit, start), p3)
    }

  let p5 = skip_ws(tokens, p4)
  let (effs, p6) =
    if at(tokens, p5, TWith) {
      parse_effect_list(tokens, skip_ws(tokens, p5 + 1))
    } else {
      ([], p5)
    }

  let p7 = skip_ws(tokens, p6)
  let p8 = if at(tokens, p7, TEq) { p7 + 1 } else { p7 }
  let (raw_body, p9) = parse_body(tokens, skip_ws(tokens, p8))
  // Fold any destructure-param bindings into the body — a destructure param
  // IS the same match projection a destructuring `let` is.
  let body = bind_param_destructures(dlets, raw_body, start)

  // The authored intent row IS the FnStmt's effs field on the node —
  // read live by QIntentOf / oracle intent_weight via graph_node_body.
  // No parallel intent_index ledger to write (Carried-Truth).
  let stmt_node = nstmt(FnStmt(name, params, ret_node, effs, body), start)
  (stmt_node, p9)
}

/// A param-name token: TIdent or the contextual keywords
/// own/ref/handle (SYNTAX.md — contextual keywords are idents outside
/// keyword-role position; #117 class). Pure structural match — no
/// string, no .len-on-call (the canonical projection mirroring seed
/// $ident_at_p; one predicate, both call sites).
fn is_param_name_tok(ref tokens, p) = match kind_at(tokens, p) {
  TIdent(_) => true,
  TOwn      => true,
  TRef      => true,
  THandle   => true,
  _         => false
}

/// Lexeme of an ident-shaped token: TIdent payload, or the contextual
/// keyword's spelling (own/ref/handle). The canonical contextual-ident
/// LEXEME projection (paired with is_param_name_tok, the Bool gate) —
/// mirrors seed $ident_at_p (TIdent payload; THandle→"handle",
/// TOwn→"own", TRef→"ref"). "" = not an ident-shaped token (seed-
/// canonical null; surfaces downstream, not a masked ADT). Used for
/// record-field names: SYNTAX.md §572 admits keyword-named fields
/// (s.handle, e.with, r.ref) — record construction is symmetric.
fn ident_or_kw_at(ref tokens, p) = match kind_at(tokens, p) {
  TIdent(s) => s,
  TOwn      => "own",
  TRef      => "ref",
  THandle   => "handle",
  _         => ""
}

/// Does a real param start at p? TIdent → yes. `own`/`ref` → yes ONLY
/// when a param name follows (`own x`); a bare `own`/`ref` (next is
/// `)`/`,`/`:`/`with`) is NOT a param start — seed parity: seed
/// parse_one_param returns null there → parse_fn_params `br $done`,
/// the param-list terminates (verified empirically: `fn f(own)` → 0
/// params; `fn f(own,b)` → 0 params; `fn f(a,own)` → [a]).
fn param_starts_here(ref tokens, p) = match kind_at(tokens, p) {
  TIdent(_) => true,
  TOwn      => is_param_name_tok(tokens, skip_ws(tokens, p + 1)),
  TRef      => is_param_name_tok(tokens, skip_ws(tokens, p + 1)),
  _         => false
}

/// Advance to the token after the next TRParen. Param lists are flat
/// (no nested parens), so a linear scan is exact. TEof-bounded
/// (substrate-honest, like the seed's skip_to_eq_or_brace bound).
fn skip_to_rparen(ref tokens, p) =
  if at(tokens, p, TRParen) { p + 1 }
  else if at(tokens, p, TEof) { p }
  else { skip_to_rparen(tokens, p + 1) }

/// Advance to (not past) the next TLBrace. For handler `with !E` /
/// `with E [+ E]` effect-row guards, which the seed skips to the arms
/// block. Structural effect-row extraction is the seed's own named
/// post-L1 peer Hβ.parser-handler-effect-row-record; effects are
/// WAT-invisible so skip-vs-parse is byte-equivalent at L1. TEof-
/// bounded, mirrors skip_to_rparen.
fn skip_to_lbrace(ref tokens, p) =
  if at(tokens, p, TLBrace) { p }
  else if at(tokens, p, TEof) { p }
  else { skip_to_lbrace(tokens, p + 1) }

// Returns (params, destructure-lets, pos). The lets are the prepend-bindings
// for any destructuring params (empty when all params are bare names);
// parse_fn / the lambda paths fold them into the body via
// bind_param_destructures, so a destructure param IS the same match projection
// a destructuring let is.
fn parse_fn_params(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) { ([], [], p + 1) }
  else if !param_starts_here(tokens, p) {
    // Bare own/ref (no name follows) — seed parse_one_param returns
    // null → param-list terminates here; tokens to `)` discarded
    // (seed skip_to_eq_or_brace). 0 params; pos past `)`.
    ([], [], skip_to_rparen(tokens, p))
  } else {
    let (first, fl, p2) = parse_one_param(tokens, p)
    let (b1, c1) = push_node(make_list(4), 0, first)
    let (lb1, lc1) = push_opt_let(make_list(4), 0, fl)
    let (final_buf, final_count, lbuf, lcount, final_pos) =
      parse_params_tail(tokens, p2, b1, c1, lb1, lc1)
    (slice(final_buf, 0, final_count), slice(lbuf, 0, lcount), final_pos)
  }
}

/// Push an Option(let) into the lets buffer-counter: Some appends, None is a
/// no-op (the buffer is unchanged). The parallel of push_node for the optional
/// prepend-bindings a destructure param yields.
fn push_opt_let(own buf, count, opt) = match opt {
  Some(letstmt) => push_node(buf, count, letstmt),
  None          => (buf, count)
}

fn parse_params_tail(ref tokens, pos, own buf, count, own lbuf, lcount) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TComma) {
    let pn = skip_ws(tokens, p + 1)
    if !param_starts_here(tokens, pn) {
      // Bare own/ref after `,` — list terminates (seed parity:
      // `fn f(a, own)` → [a], rest discarded to `)`).
      (buf, count, lbuf, lcount, skip_to_rparen(tokens, pn))
    } else {
      let (next, nl, p2) = parse_one_param(tokens, pn)
      let (b1, c1) = push_node(buf, count, next)
      let (lb1, lc1) = push_opt_let(lbuf, lcount, nl)
      parse_params_tail(tokens, p2, b1, c1, lb1, lc1)
    }
  } else {
    (buf, count, lbuf, lcount, expect(tokens, p, TRParen))
  }
}

// One parameter: a bare name (degenerate) or a destructure pattern
// (`{name, age}` / `[h, ...t]` / `(a, b)` — SYNTAX.md §«Function declarations»,
// §«Anonymous functions»). A destructure param desugars at fn entry to a
// fresh-named param plus a `let <pat> = <fresh>` prepended to the body (the
// SAME projection desugar_block gives a destructuring let). Returns
// (TParam, Option(prepend-let), pos): the let is None for a bare name.
fn parse_one_param(ref tokens, pos) = {
  let (own_marker, p) = match kind_at(tokens, pos) {
    TOwn => (Own, skip_ws(tokens, pos + 1)),
    TRef => (Ref, skip_ws(tokens, pos + 1)),
    _    => (Unmarked, pos)
  }

  // A pattern-shaped param starts with `{` / `[` / `(` — parse the full Pat
  // and desugar it to (fresh param, prepend-let). The own/ref marker rides on
  // the fresh param (the whole destructured value carries the ownership).
  let psp = span_at(tokens, p)
  if at(tokens, p, TLBrace) || at(tokens, p, TLBracket) || at(tokens, p, TLParen) {
    let (pat, p_pat) = parse_pat(tokens, p)
    let fresh = fresh_param_name(psp)
    let param = TParam(fresh, TVar(fresh_handle(psp)), own_marker, own_marker, None)
    let bind = nstmt(LetStmt(pat, nexpr(VarRef(fresh), psp)), psp)
    (param, Some(bind), p_pat)
  } else {
    let name = ident_at(tokens, p)
    let p2 = skip_ws(tokens, p + 1)
    // Optional `: Ty` annotation (the Intent Boundary), then optional
    // `= default` (SYNTAX.md §«Default parameter values»). The default
    // expr is parser-minted graph content; it rides in the TParam's
    // default slot to its one home, evaluated in the callee's scope when
    // a call omits the arg edge.
    let (ty, p_ty) =
      if at(tokens, p2, TColon) {
        parse_type_ty(tokens, skip_ws(tokens, p2 + 1))
      } else {
        (TVar(fresh_handle(span_at(tokens, p))), p2)
      }
    let p_after_ty = skip_ws(tokens, p_ty)
    if at(tokens, p_after_ty, TEq) {
      let (default_expr, p_def) = parse_expr(tokens, skip_ws(tokens, p_after_ty + 1))
      (TParam(name, ty, own_marker, own_marker, Some(default_expr)), None, p_def)
    } else {
      (TParam(name, ty, own_marker, own_marker, None), None, p_ty)
    }
  }
}

// Effect rows use the full Boolean algebra `+ - & ! Pure` per SYNTAX.md
// §«Named effect rows» (`with E1 + !E2 & E3 - E4`). `!` is the per-term
// negation flag; `+ - &` are the connectives joining each term to the
// row accumulated to its left. The first term carries EcUnion (joining
// onto the EfPure base = itself). Each entry is (EffName, negated,
// EConn); infer folds the list applying each connective via the
// existing union_row / diff_row / inter_row algebra (build_declared_row)
// — the parser names the topology, infer reads the algebra live.
fn parse_effect_list(ref tokens, pos) =
  parse_effect_list_from(tokens, pos, EcUnion)

fn parse_effect_list_from(ref tokens, pos, conn) = {
  let (name, negated, p) = parse_one_effect(tokens, pos)
  let entry = (name, negated, conn)
  let p2 = skip_ws(tokens, p)
  let next_conn =
    if at(tokens, p2, TPlus)       { Some(EcUnion) }
    else if at(tokens, p2, TMinus) { Some(EcDiff) }
    else if at(tokens, p2, TAmp)   { Some(EcInter) }
    else                           { None }
  match next_conn {
    Some(c) => {
      let (rest, p3) = parse_effect_list_from(tokens, skip_ws(tokens, p2 + 1), c)
      ([entry] ++ rest, p3)
    },
    None => ([entry], p2)
  }
}

/// Parse a single effect entry — bare `IO`, negated `!IO`,
/// parameterized `Sample(44100)`, or negated parameterized
/// `!Sample(44100)`. Args are scalar literals (int/float/string);
/// identifier / expression args land in a v2 walkthrough.
fn parse_one_effect(ref tokens, pos) = {
  let (negated, p) =
    if at(tokens, pos, TBang) { (true, pos + 1) }
    else { (false, pos) }
  // `Pure` lexes to TPure (a reserved word) — it IS the union identity, so the
  // parser emits the EPure EffName directly. build_declared_row maps it to
  // EfPure; the EPure variant replaces the old string-keyed Pure term (drift-3).   // drift-audit: ignore — describes the dissolution
  if at(tokens, p, TPure) {
    (EPure, negated, p + 1)
  } else {
    let name = ident_at(tokens, p)
    let p1 = p + 1
    let p2 = skip_ws(tokens, p1)
    if at(tokens, p2, TLParen) {
      let (args, p3) = parse_eff_args(tokens, skip_ws(tokens, p2 + 1))
      (EParameterized(name, args), negated, p3)
    } else {
      (ENamed(name), negated, p1)
    }
  }
}

fn parse_eff_args(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) { ([], p + 1) }
  else {
    let buf = make_list(2)
    let (first, p2) = parse_one_eff_arg(tokens, p)
    let (b1, c1) = push_node(buf, 0, first)
    let (final_buf, final_count, final_pos) =
      parse_eff_args_tail(tokens, p2, b1, c1)
    (slice(final_buf, 0, final_count), final_pos)
  }
}

fn parse_eff_args_tail(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TComma) {
    let (next, p2) = parse_one_eff_arg(tokens, skip_ws(tokens, p + 1))
    let (b1, c1) = push_node(buf, count, next)
    parse_eff_args_tail(tokens, p2, b1, c1)
  } else {
    (buf, count, expect(tokens, p, TRParen))
  }
}

fn parse_one_eff_arg(ref tokens, pos) = match kind_at(tokens, pos) {
  // Scalar literals are the CONSTANT-FOLDED PROJECTION of the operand node —
  // the literal the AST already holds, folded for value-distinct row equality.
  TIntLit(n)     => (EAInt(n), pos + 1),
  TFloatLit(f)   => (EAFloat(f), pos + 1),
  TStringPart(s) => (EAString(s), pos + 1),
  // A non-literal argument (`Clock(monotonic)`, `Sample(rate)`) is an operand
  // Node — minted into the one graph as a VarRef and carried by HANDLE
  // (EANode), resolved live via graph_node_body (the PExpr-dissolution
  // precedent). The old EEffArgNotLiteral surrender is DELETED: a parameterized
  // effect over a bound name is first-class, not an error.
  TIdent(name)   => {
    let sp = span_at(tokens, pos)
    let N(_, _, h) = nexpr(VarRef(name), sp)
    (EANode(h), pos + 1)
  },
  _              => {
    report(EEffArgNotLiteral(span_at(tokens, pos)))
    (EAInt(0), pos + 1)
  }
}

/// Parse `let pat [: ty] = expr`.
fn parse_let(ref tokens, pos) = {
  let start = span_at(tokens, pos)
  let (pat, p) = parse_pat(tokens, pos)
  let p2 = skip_ws(tokens, p)
  let p3 = if at(tokens, p2, TColon) {
    let (_, p_ty) = parse_type_ty(tokens, skip_ws(tokens, p2 + 1))
    skip_ws(tokens, p_ty)
  } else { p2 }
  let p4 = expect(tokens, p3, TEq)
  let (val, p5) = parse_expr(tokens, skip_ws(tokens, p4))
  (nstmt(LetStmt(pat, val), start), p5)
}

/// Parse `type X = V1 | V2(fields) | ...` or `type X = T where P`.
fn parse_type_decl(ref tokens, pos) = {
  let start = span_at(tokens, pos)
  let name = ident_at(tokens, pos)
  let p = skip_ws(tokens, pos + 1)
  let p2 = if at(tokens, p, TEq) { skip_ws(tokens, p + 1) } else { p }

  let base_val = ident_at(tokens, p2)
  let probe = skip_ws(tokens, p2 + 1)
  if at(tokens, probe, TWhere) {
    let (base_ty, _p3) = parse_type_ty(tokens, p2)
    let (pred, p4) = parse_predicate(tokens, skip_ws(tokens, probe + 1))
    (nstmt(RefineStmt(name, base_ty, pred), start), p4)
  } else if at(tokens, p2, TLBrace) {
    // H2.3 nominal record: `type Person = {name: String, age: Int}`.
    // Single-variant type whose body is the record. Reuse
    // parse_record_type_fields so the field-sort invariant matches
    // structural records exactly.
    let (flds, _rest_var, p3) = parse_record_type_fields(tokens, skip_ws(tokens, p2 + 1))
    let sorted = sort_record_type_fields(flds)
    // A nominal record is closed by definition — its name IS the brand,
    // so an open rest is meaningless here; the closed TRecord is the body.
    let body = TRecord(sorted)
    let variant = (name, [body])     // single variant named after the type
    (nstmt(TypeDefStmt(name, [variant]), start), p3)
  } else {
    // Transparent alias vs ADT (SYNTAX.md §«Type aliases»): a RHS that is
    // a single type-expression with no `|`-alternation is a transparent
    // alias (`type Port = Int`, `type Bytes = [Int]`, `type H = Option(Int)`);
    // a `|` after the first term marks a multi-variant ADT. A trailing
    // row operator (`+ - &`) is the named-effect-row form (out of this
    // form's scope) — left to parse_variants unchanged. Parse the RHS as
    // a type and read the terminator live; the token decides, never a
    // line-count or a pre-commitment.
    let (alias_ty, p_alias) = parse_type_ty(tokens, p2)
    let term = skip_ws(tokens, p_alias)
    if at(tokens, term, TPipe) || at(tokens, term, TPlus)
       || at(tokens, term, TMinus) || at(tokens, term, TAmp) {
      let (variants, p3) = parse_variants(tokens, p2)
      (nstmt(TypeDefStmt(name, variants), start), p3)
    } else {
      (nstmt(AliasStmt(name, alias_ty), start), p_alias)
    }
  }
}

fn parse_variants(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TEof) {
    // EOF inside variant declarations — halt with the empty list
    // and emit ONE diagnostic per the unclosed-construct discipline.
    // Without this, ident_at returns "" + recursion fabricates an
    // empty-named variant list that lower/infer would walk into
    // garbage paths. Drift mode 9 refused: empty-name variant IS
    // structurally NOT what the source said.
    report(PUnclosedConstruct("unexpected end of input inside type-decl variants; expected a variant name or `|`", span_at(tokens, p)))
    ([], p)
  } else {
    let vname = ident_at(tokens, p)
    let p2 = p + 1
    let (fields, p3) =
      if at(tokens, p2, TLParen) {
        parse_variant_fields(tokens, skip_ws(tokens, p2 + 1))
      } else {
        ([], p2)
      }
    let variant = (vname, fields)
    let p4 = skip_ws(tokens, p3)
    if at(tokens, p4, TPipe) {
      let (rest, p5) = parse_variants(tokens, skip_ws(tokens, p4 + 1))
      ([variant] ++ rest, p5)
    } else {
      ([variant], p4)
    }
  }
}

fn parse_variant_fields(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) { ([], p + 1) }
  else {
    let (ty, p2) = parse_type_ty(tokens, p)
    let p3 = skip_ws(tokens, p2)
    if at(tokens, p3, TComma) {
      let (rest, p4) = parse_variant_fields(tokens, skip_ws(tokens, p3 + 1))
      ([ty] ++ rest, p4)
    } else {
      ([ty], expect(tokens, p3, TRParen))
    }
  }
}

/// Parse `effect X { op(args) -> ret }`. Resume discipline is
/// INFERRED from each handler arm body (no annotation in the
/// effect declaration); see types.mn:ResumeDiscipline.
fn parse_effect_decl(ref tokens, pos) = {
  let start = span_at(tokens, pos)
  let name = ident_at(tokens, pos)
  let p = expect(tokens, skip_ws(tokens, pos + 1), TLBrace)
  let (ops, p2) = parse_effect_ops(tokens, skip_ws(tokens, p))
  (nstmt(EffectDeclStmt(name, ops), start), p2)
}

fn parse_effect_ops(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRBrace) || at(tokens, p, TEof) { ([], p + 1) }
  else if !is_param_name_tok(tokens, p) {
    // Not an op-name here — e.g. a TComment preceding the op. An op is not a
    // top-level decl handle in the comment weave, so the comment is not attached
    // here; it advances past. Seed parity: $parse_effect_ops null-recovery
    // (protocol_parser_fabrication_substrate) — advance past the token, skip
    // separators, retry. TEof above bounds the recursion.
    parse_effect_ops(tokens, skip_sep(tokens, p + 1))
  } else {
    let op_name = ident_at(tokens, p)
    let p2 = expect(tokens, skip_ws(tokens, p + 1), TLParen)
    let (param_tys, p3) = parse_op_params(tokens, skip_ws(tokens, p2))
    let p4 = skip_ws(tokens, p3)
    let (ret_ty, p5) =
      if at(tokens, p4, TArrow) {
        parse_type_ty(tokens, skip_ws(tokens, p4 + 1))
      } else {
        (TUnit, p4)
      }
    let p6 = skip_sep(tokens, p5)
    let (rest, p7) = parse_effect_ops(tokens, p6)
    ([(op_name, param_tys, ret_ty)] ++ rest, p7)
  }
}

/// Parse a single op-param: either bare `Type` (positional) or
/// `name: Type` (named — SYNTAX.md §678 `print(msg: String)`). Skips
/// the optional `<ident> :` prefix; returns the parsed Ty + new pos.
/// Per Hβ.parser.effect-op-typed-arg-substrate (2026-05-10): the wheel
/// parser accepts both forms; the seed-side substrate already does the
/// same via the `if at p2 TColon` check at parse_one_param shape, so
/// this stays SYNTAX.md-aligned.
fn parse_op_param_one(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  // peek `<ident> :` — if present, skip the name + colon and parse the
  // type. is_param_name_tok is the canonical pure-structural projection
  // (TIdent + contextual kw); it replaces `ident_at(tokens, p).len > 0`
  // — `.len`-on-a-call-result mis-evaluates in compiled mentl2 (the
  // same construct behind the #154 O2 regression; broader audit is the
  // named peer Hβ.parser.len-on-call-result-miscompile-audit).
  let after_ws = skip_ws(tokens, p + 1)
  let is_ident_here = is_param_name_tok(tokens, p)
  let typed_form = is_ident_here && at(tokens, after_ws, TColon)
  if typed_form {
    parse_type_ty(tokens, skip_ws(tokens, after_ws + 1))
  } else {
    parse_type_ty(tokens, p)
  }
}

fn parse_op_params(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) { ([], p + 1) }
  else {
    let (ty, p2) = parse_op_param_one(tokens, p)
    let p3 = skip_ws(tokens, p2)
    if at(tokens, p3, TComma) {
      let (rest, p4) = parse_op_params(tokens, skip_ws(tokens, p3 + 1))
      ([ty] ++ rest, p4)
    } else {
      ([ty], expect(tokens, p3, TRParen))
    }
  }
}

/// Parse `handler X[(config_params)] [with field = init [, ...]] { arms }`
/// per SYNTAX.md §"Handler declarations" — three optional sections before arms:
///   - config-params `(p1, p2, ...)` closure-captured at install site
///   - state `with field = init [, ...]` per-arm-scope mutable bindings
///   - arms `{ op_name(args) => body, ... }` op handler bodies
///
/// Per Hβ.first-light.handler-config-state-substrate (2026-05-06):
/// config + state extracted at parse time so infer/lower can bind them
/// in arm scope. Reuses parse_arg_names (line 668) for config-params
/// and parse_handler_state_fields (below) for the state clause.
/// Eight: Graph (HandlerDeclStmt carries config+state lists). Handler
/// (Pure parse). Verb (|> through ident → optional config → optional
/// state → arms). Row (Memory + Alloc for AST). Ownership (ref tokens;
/// own per fresh nstmt). Refinement (Stmt where stmt_well_formed(self)).
/// Gradient (bottom: name only; top: full surface). Reason (span +
/// Declared(name)). Drift refused: 7 (no parallel arrays — config and
/// state are separate concerns with distinct shapes); 9 (config + state
/// land whole, not deferred).
fn parse_handler_decl(ref tokens, pos) = {
  let start = span_at(tokens, pos)
  let name = ident_at(tokens, pos)
  let p_after_name = skip_ws(tokens, pos + 1)
  // Optional `(config_params)` — closure-captured at install site.
  let (config, p_after_config) = if at(tokens, p_after_name, TLParen) {
    parse_arg_names(tokens, skip_ws(tokens, p_after_name + 1))
  } else { ([], p_after_name) }
  // Optional `with` clause. Seed parser_handler.wat $parse_handler_state
  // disambiguation:
  //   with !E              — effect-row guard (SYNTAX.md §904-912)
  //   with E [+ E]         — effect-row (IDENT not followed by `=`)
  //   with f = init [, ..] — state-init
  // Effect-row → skip to the arms `{`, empty state. Structural row
  // extraction is the seed's OWN named post-L1 peer
  // Hβ.parser-handler-effect-row-record (effects are WAT-invisible;
  // skip == parse at L1 byte-faithfulness — not drift 9).
  let (state, p_after_state) =
    if at(tokens, skip_ws(tokens, p_after_config), TWith) {
      let p_w = skip_ws(tokens, p_after_config)
      let p_with = skip_ws(tokens, p_w + 1)
      if at(tokens, p_with, TBang) {
        ([], skip_to_lbrace(tokens, p_with))
      } else if is_param_name_tok(tokens, p_with) &&
                !at(tokens, skip_ws(tokens, p_with + 1), TEq) {
        ([], skip_to_lbrace(tokens, p_with))
      } else {
        parse_handler_state_fields(tokens, p_with)
      }
    } else { ([], p_after_config) }
  let p_open = expect(tokens, skip_ws(tokens, p_after_state), TLBrace)
  let (arms, p_close) = parse_handler_arms(tokens, skip_ws(tokens, p_open))
  (nstmt(HandlerDeclStmt(name, "", config, state, arms), start), p_close)
}

/// Parse `field = init [, field = init]*` until TLBrace. Each state
/// entry is a record `{name, init}` per Ω.5 record-shape discipline
/// (drift mode 7 refusal — no (names_list, inits_list) parallel arrays).
/// Reuses parse_expr for inits.
fn parse_handler_state_fields(ref tokens, pos) = {
  let name = ident_at(tokens, pos)
  let p_eq = expect(tokens, skip_ws(tokens, pos + 1), TEq)
  let (init, p_after_init) = parse_expr(tokens, skip_ws(tokens, p_eq))
  let field = {name: name, init: init}
  let p_next = skip_ws(tokens, p_after_init)
  if at(tokens, p_next, TComma) {
    let (rest, p_end) = parse_handler_state_fields(tokens, skip_ws(tokens, p_next + 1))
    ([field] ++ rest, p_end)
  } else {
    ([field], p_next)
  }
}

/// Parse `field = init [, field = init]*` for a `resume(v) with ...`
/// clause. Distinct terminator from parse_handler_state_fields: a comma
/// is a field separator ONLY when followed by `IDENT =`. A comma
/// followed by anything else is the match-arm separator (consumed by
/// parse_handler_arms via skip_sep), so the list ends BEFORE it.
/// Canonical predicate mirrors seed bootstrap/src/parser_compound.wat
/// $parse_resume_state_updates — the arbiter, since pass-2 proves it.
/// Same {name, init} record shape as parse_handler_state_fields (drift
/// 7 refused); a separate fn, not a context flag (drift 8 refused —
/// mirrors the seed's $parse_handler_state / $parse_resume_state_updates
/// two-function split).
fn parse_resume_state_updates(ref tokens, pos) = {
  let name = ident_at(tokens, pos)
  let p_eq = expect(tokens, skip_ws(tokens, pos + 1), TEq)
  let (init, p_after_init) = parse_expr(tokens, skip_ws(tokens, p_eq))
  let field = {name: name, init: init}
  let p_next = skip_ws(tokens, p_after_init)
  if at(tokens, p_next, TComma) {
    let p_la = skip_ws(tokens, p_next + 1)
    match kind_at(tokens, p_la) {
      TIdent(_) =>
        if at(tokens, skip_ws(tokens, p_la + 1), TEq) {
          let (rest, p_end) = parse_resume_state_updates(tokens, p_la)
          ([field] ++ rest, p_end)
        } else {
          ([field], p_next)
        },
      _ => ([field], p_next)
    }
  } else {
    ([field], p_next)
  }
}

fn parse_handler_arms(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRBrace) { ([], p + 1) }
  else if at(tokens, p, TEof) { ([], p) }
  else if !is_param_name_tok(tokens, p) {
    // Non-ident at arm start (e.g., `///` doc-comment preceding the arm,
    // or stray tokens). Seed parity: $parse_handler_arm returns null when
    // $ident_at_p returns null → arm loop terminates. Doc-comment
    // attachment inside handler blocks is a named post-L1 peer
    // (Hβ.parser.handler-arm-doc-attachment); for now, skip the token
    // and retry — same discipline as parse_effect_ops (line 693-700).
    parse_handler_arms(tokens, skip_sep(tokens, p + 1))
  } else {
    let op_name = ident_at(tokens, p)
    let p2 = expect(tokens, skip_ws(tokens, p + 1), TLParen)
    let (args, p3) = parse_arg_names(tokens, skip_ws(tokens, p2))
    let p4 = expect(tokens, skip_ws(tokens, p3), TFatArrow)
    let (body, p5) = parse_expr(tokens, skip_ws(tokens, p4))
    // Arm separator IS the match-arm separator — handler arms mirror
    // parse_match_arms (seed parser_handler.wat $parse_handler_arms
    // asserts this mirror). Optional `,` between arms (SYNTAX.md:862
    // shows trailing-comma form); skip_ws absorbs newline-separated
    // arms. Converges the prior skip_sep divergence to the canonical
    // sibling idiom.
    let p5b = skip_ws(tokens, p5)
    let p6 = if at(tokens, p5b, TComma) { p5b + 1 } else { p5b }
    let (rest, p7) = parse_handler_arms(tokens, skip_ws(tokens, p6))
    // Per Ω.5 frame-record discipline + H1.4 future wiring,
    // arms are records keyed by field name. New fields (e.g.,
    // arm_fn_idx for handler arm fn indexing) land additively.
    let arm = {args: args, body: body, op_name: op_name}
    ([arm] ++ rest, p7)
  }
}

fn parse_arg_names(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) { ([], p + 1) }
  else {
    let name = ident_at(tokens, p)
    let p2 = skip_ws(tokens, p + 1)
    if at(tokens, p2, TComma) {
      let (rest, p3) = parse_arg_names(tokens, skip_ws(tokens, p2 + 1))
      ([name] ++ rest, p3)
    } else {
      ([name], expect(tokens, p2, TRParen))
    }
  }
}

/// Parse `import path/to/module`.
fn parse_import(ref tokens, pos) = {
  let start = span_at(tokens, pos)
  let (path, p) = parse_import_path(tokens, pos, "")
  (nstmt(ImportStmt(path), start), p)
}

fn parse_import_path(ref tokens, pos, own acc) = {
  let name = ident_at(tokens, pos)
  let joined = acc ++ name
  let p = pos + 1
  if at(tokens, p, TSlash) {
    parse_import_path(tokens, p + 1, "{joined}/")
  } else {
    (joined, p)
  }
}

// Expressions — precedence-climbing

fn parse_expr(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  let span = span_at(tokens, p)
  // Let-expression at expression-top. Seed parity: the seed's parse_expr
  // handles `let` as an expression form (let X = Y; Z or let X = Y\n Z).
  // This enables braceless fn bodies with let-chains:
  //   fn f(x) -> Int with Pure = let y = x; y
  // The let-expression parses binding + continuation (after ; or newline).
  if at(tokens, p, TLet) {
    parse_let_expr(tokens, p + 1, span)
  // `handle { body } with h` is the redundant spelling of `(body) ~> h`
  // (SYNTAX.md §«Installation», E_RedundantHandleBlock): `~>` is the ONE
  // install verb, drawing the one install edge to the handler's node.
  // parse_handle parses the body, requires `with H`, and produces the
  // identical PipeExpr(PTee, body, H) graph — there is no block-form vs
  // pipe-form, one verb one edge. The keyword is recognized at
  // expression-top (not operand level): `x == handle { ... }` treats
  // `handle` as a VarRef, the `{` belonging to the enclosing block.
  } else if at(tokens, p, THandle) && at(tokens, skip_ws(tokens, p + 1), TLBrace) {
    parse_handle(tokens, p + 1, span)
  } else {
    parse_binop(tokens, p, 1)
  }
}

// Let-expression in expression position. Desugars to BlockExpr:
//   let PAT = VAL; BODY  →  BlockExpr([LetStmt(PAT, VAL), ExprStmt(BODY)])
// This reuses the existing BlockExpr infrastructure (lowerer, inferrer,
// emitter all handle it). Chained lets nest naturally:
//   let a = 1; let b = 2; a + b
//   → BlockExpr([LetStmt(a, 1), ExprStmt(BlockExpr([LetStmt(b, 2), ExprStmt(a+b)]))])
// Seed parity: parser_expr.wat $parse_let_expr.
fn parse_let_expr(ref tokens, pos, start_span) = {
  let (pat, p) = parse_pat(tokens, pos)
  let p2 = skip_ws(tokens, p)
  let p3 = if at(tokens, p2, TColon) {
    let (_, p_ty) = parse_type_ty(tokens, skip_ws(tokens, p2 + 1))
    skip_ws(tokens, p_ty)
  } else { p2 }
  let p4 = expect(tokens, p3, TEq)
  let (val, p5) = parse_expr(tokens, skip_ws(tokens, p4))
  // Continuation: after the value, skip separator (; or newline) and
  // parse the body expression.
  let p6 = skip_sep(tokens, p5)
  let (body, p7) = parse_expr(tokens, p6)
  // Desugar: wrap as BlockExpr([LetStmt(pat, val)], body)
  // BlockExpr takes (stmts, final_expr) — the let is a statement,
  // body is the final expression value of the block.
  let let_stmt = nstmt(LetStmt(pat, val), start_span)
  (nexpr(desugar_block([let_stmt], body, start_span), start_span), p7)
}

fn parse_binop(ref tokens, pos, min_prec) = {
  let (left, p) = parse_postfix(tokens, pos)
  binop_loop(tokens, left, p, min_prec)
}

fn binop_loop(ref tokens, left, pos, min_prec) = {
  let p = skip_ws(tokens, pos)
  let k = kind_at(tokens, p)
  let prec = op_prec(k)
  if prec >= min_prec && prec > 0 {
    let op_span = span_at(tokens, p)
    // Per Hβ.parser.binop-skip-ws-after-op (seed parser_expr.wat:41-45):
    // skip TNewlines AFTER the operator before the right operand.
    // `a == b() &&\n  c` had the right-recursion start at p+1 (the
    // trailing newline) → parse_primary truncates the chain. Newlines
    // around a binop are transparent in BOTH directions (SYNTAX.md —
    // layout is never semantics; the table is the only scope law).
    let (right, p2) = parse_binop(tokens, skip_ws(tokens, p + 1), prec + 1)
    let N(_, left_span, _) = left
    let combined_span = span_join(left_span, op_span)
    let node = match op_to_pipe_kind(k) {
      Some(pk) => nexpr(PipeExpr(pk, left, right), combined_span),
      None     => match op_to_binop(k) {
        Some(bo) => nexpr(BinOpExpr(bo, left, right), combined_span),
        None     => {
          // Unreachable per caller invariant: op_prec(k) > 0 and
          // op_to_pipe_kind returned None together imply k
          // IS a binop token. ICE rather than fabricate a BinOp —
          // if this ever fires, op_prec and op_to_binop have
          // drifted out of sync.
          report(EInternalInvariant("op_to_binop returned None for token with op_prec > 0", op_span))   // drift-audit: ignore
          nexpr(BinOpExpr(BAdd, left, right), combined_span)
        }
      }
    }
    binop_loop(tokens, node, p2, min_prec)
  } else {
    (left, p)
  }
}

/// Postfix: call, field access, indexing.
fn parse_postfix(ref tokens, pos) = {
  let (e, p) = parse_primary(tokens, pos)
  postfix_loop(tokens, e, p)
}

fn postfix_loop(ref tokens, e, pos) = match kind_at(tokens, pos) {
  TLParen => {
    let (args, p2) = parse_call_args(tokens, skip_ws(tokens, pos + 1))
    let N(_, start_span, _) = e
    let end_span = span_at(tokens, p2 - 1)
    postfix_loop(tokens,
      nexpr(CallExpr(e, args), span_join(start_span, end_span)),
      p2)
  },
  // Subscript `xs[i]` per SYNTAX.md:611-632 + #139. The parser
  // produces IndexExpr(receiver, index) as a semantic AST node;
  // infer dispatches on the receiver's chase-deep Ty:
  //   T[A] → list_index runtime call
  //   TTuple → compile-time slot from constant index
  //   TRecord-by-int-key → record_get
  // The prior eager fold to CallExpr(VarRef("list_index")) at parse
  // time committed the dispatch before infer knew the receiver's
  // shape — drift mode 9. Refinements on the index elide the
  // runtime bounds check via gradient ascent (peer Hβ.emit.refinement-
  // elide-bounds).
  TLBracket => {
    let (idx_expr, p2) = parse_expr(tokens, skip_ws(tokens, pos + 1))
    let p3 = expect(tokens, skip_ws(tokens, p2), TRBracket)
    let N(_, start_span, _) = e
    let end_span = span_at(tokens, p3 - 1)
    postfix_loop(tokens,
      nexpr(IndexExpr(e, idx_expr), span_join(start_span, end_span)),
      p3)
  },
  TDot => {
    let field = ident_at(tokens, pos + 1)
    let N(_, start_span, _) = e
    let field_span = span_at(tokens, pos + 1)
    postfix_loop(tokens,
      nexpr(FieldExpr(e, field), span_join(start_span, field_span)),
      pos + 2)
  },
  TLBrace => {
    // H2.3 nominal record literal: `Person{name: "Morgan", ...}`.
    // The brace must immediately follow a type-name VarRef (no
    // whitespace between — postfix_loop is called with pos at the
    // very next token). Type names are capitalized; lowercase
    // identifiers fall through and the brace stays a separate
    // construct (block at expr position, not a record literal).
    let N(body, start_span, _) = e
    let is_named_record = match body {
      NExpr(VarRef(name)) =>
        byte_len(name) > 0 &&
        first_char_code(name) >= 65 &&
        first_char_code(name) <= 90,
      _ => false
    }
    if is_named_record {
      let type_name = match body {
        NExpr(VarRef(n)) => n,
        _                => ""
      }
      let (sorted, p2) = parse_named_record_body(tokens, pos + 1)
      let end_span = span_at(tokens, p2 - 1)
      postfix_loop(tokens,
        nexpr(NamedRecordExpr(type_name, sorted), span_join(start_span, end_span)),
        p2)
    } else { (e, pos) }
  },
  // No postfix suffix here. `<` is ALWAYS comparison (TLt) — angle-bracket
  // generics are retired everywhere (the case rule IS the declaration; types
  // apply with parens). The parser has ONE precedence table + productive-
  // under-error, so a stale `f<T>(args)` keystroke parses as the comparison
  // chain the precedence table draws, and the general unexpected-token /
  // type-mismatch diagnostic teaches in context — NOT a Rust-specific
  // balanced-`<...>` lookahead. A bespoke recognizer per foreign syntax does
  // not scale (the owner's point); the general diagnostic path is the one home.
  _ => (e, pos)
}

/// Parse the body of a nominal record literal — same shape as
/// `parse_record_fields` but invoked from a different surface
/// (postfix-suffix vs primary). Sorts fields by name at parse time
/// to maintain the substrate-wide invariant.
fn parse_named_record_body(ref tokens, pos) = {
  let buf = make_list(4)
  let (final_buf, final_count, p) = parse_record_fields(tokens, pos, buf, 0)
  let sorted = sort_record_fields(slice(final_buf, 0, final_count))
  (sorted, p)
}

// Labeled call arguments (`f(x = a, y = b)` — SYNTAX.md §«Labeled call
// arguments») are the parameter-list-AS-product surface: a call may
// construct its arg product positionally, by field, or mixed — the SAME
// machinery as a record literal. A `name =` at a call site parses as a
// LabeledArg(name, value) carrying the product-field name; resolve_call_args
// (types.mn, the one read both infer + lower call) reorders these to
// positional against the callee's declared param names (E_UnknownArgLabel on
// a miss) and fills absent fields with their param defaults. The label rides
// ON the arg node, so the 23 CallExpr consumers that just walk a Node list are
// untouched — the wrapper is resolved away before infer_expr / lower_expr.
fn parse_call_args(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) { ([], p + 1) }
  else {
    let (arg, p2) = parse_one_call_arg(tokens, p)
    let p3 = skip_ws(tokens, p2)
    if at(tokens, p3, TComma) {
      let (rest, p4) = parse_call_args(tokens, skip_ws(tokens, p3 + 1))
      ([arg] ++ rest, p4)
    } else {
      ([arg], expect(tokens, p3, TRParen))
    }
  }
}

/// One call argument: a labeled `name = value` (LabeledArg) when an ident is
/// immediately followed by `=` (not `==`), else a positional expression. The
/// `name =` lookahead is the product-field-naming surface; the value parses as
/// an ordinary expression. (`==` is comparison — a positional arg `a == b`.)
fn parse_one_call_arg(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  match kind_at(tokens, p) {
    TIdent(name) => {
      let p_eq = skip_ws(tokens, p + 1)
      if at(tokens, p_eq, TEq) {
        let span = span_at(tokens, p)
        let (val, p2) = parse_expr(tokens, skip_ws(tokens, p_eq + 1))
        (nexpr(LabeledArg(name, val), span), p2)
      } else {
        parse_expr(tokens, p)
      }
    },
    _ => parse_expr(tokens, p)
  }
}

// Primary expressions

fn parse_primary(ref tokens, pos) = {
  let span = span_at(tokens, pos)
  match kind_at(tokens, pos) {
    TIntLit(n)      => (nexpr(LitInt(n), span), pos + 1),
    TFloatLit(f)    => (nexpr(LitFloat(f), span), pos + 1),
    TStringLit(s)   => (nexpr(LitString(s), span), pos + 1),
    TStringPart(s) => parse_string_interpolation(tokens, pos + 1, s, span),
    TTrue        => (nexpr(LitBool(true), span), pos + 1),
    TFalse       => (nexpr(LitBool(false), span), pos + 1),
    TIdent(name) => {
      // SYNTAX.md:1417, 1599 — E_NotAKeyword: user typed a non-Mentl
      // keyword from another language. Mentl uses verb forms (iterate,
      // perform, resume) per substrate. Parse continues with VarRef
      // (the name binds normally; infer surfaces missing-variable at
      // infer time). Diagnostic gives the user the gradient toward
      // Mentl idiom.
      if is_foreign_keyword(name) {
        report(ENotAKeyword(name, span))
      } else { () }
      (nexpr(VarRef(name), span), pos + 1)
    },
    THole        => {
      let id = fresh_handle(span)
      (nhole(id, span), pos + 1)
    },
    TLParen      => parse_paren_or_tuple(tokens, pos + 1, span),
    TLBracket    => parse_list_literal(tokens, pos + 1, span),
    TLBrace      => parse_brace_expr(tokens, pos + 1, span),
    TIf          => parse_if(tokens, pos + 1, span),
    TMatch       => parse_match(tokens, pos + 1, span),
    THandle      =>
      // Seed parity: $ident_at_p always maps THandle→"handle" (VarRef)
      // at the operand level. Handle-expression dispatch lives at
      // parse_expr (expression top), not here in parse_primary. This
      // prevents `if x == handle { 1 }` from consuming the then-block
      // as a handle body — the `{` is the if's then-block, not a
      // handle-expr body.
      (nexpr(VarRef("handle"), span), pos + 1),
    // `own`/`ref` are contextual keywords (ownership prefixes in
    // param position only); in expression position they are idents
    // (`match own { }`, `= ref`). Exact #117 THandle-arm clone; seed
    // parity ($ident_at_p maps TOwn→"own"/TRef→"ref" — the seed parses
    // `match own {}` as a VarRef scrutinee, verified empirically).
    TOwn         => (nexpr(VarRef("own"), span), pos + 1),
    TRef         => (nexpr(VarRef("ref"), span), pos + 1),
    // `handler` is a contextual keyword (handler declarations in
    // parse_stmt); in expression position it is an ident
    // (`return handler`, `handler` as param name). Same treatment as
    // THandle/TOwn/TRef — seed $ident_at_p maps THandler→"handler".
    THandler     => (nexpr(VarRef("handler"), span), pos + 1),
    TPerform     => parse_perform(tokens, pos + 1, span),
    TResume      => parse_resume(tokens, pos + 1, span),
    TPipe        => {
      // SYNTAX.md:307-315 — E_LambdaFence: pipe-fenced params syntax is // drift-audit: ignore
      // REJECTED. Canonical is parenthesized-params + fat-arrow body. // drift-audit: ignore
      // Parse continues via parse_lambda; the diagnostic surfaces the
      // Quick-Fix rewrite.
      report(ELambdaFence(span))
      parse_lambda(tokens, pos + 1, span)
    },
    // SYNTAX.md §148-190 + §317-322: anonymous lambda via the fn-keyword // drift-audit: ignore
    // is REJECTED (E_RedundantFnOnLambda). The fn-keyword is reserved
    // on named declarations; anonymous lambdas use parenthesized params
    // + fat-arrow body. Parse continues; diagnostic surfaces Quick-Fix.
    TFn          => {
      report(ERedundantFnOnLambda(span))
      let p = skip_ws(tokens, pos + 1)
      let p2 = expect(tokens, p, TLParen)
      let (params, dlets, p3) = parse_fn_params(tokens, p2)
      let p4 = expect(tokens, skip_ws(tokens, p3), TFatArrow)
      let (raw_body, p5) = parse_body(tokens, skip_ws(tokens, p4))
      let body = bind_param_destructures(dlets, raw_body, span)
      (nexpr(LambdaExpr(params, body), span), p5)
    },
    TMinus       => {
      let (inner, p) = parse_postfix(tokens, pos + 1)
      (nexpr(UnaryOpExpr(UNeg, inner), span), p)
    },
    TBang        => {
      let (inner, p) = parse_postfix(tokens, pos + 1)
      (nexpr(UnaryOpExpr(UNot, inner), span), p)
    },
    // SYNTAX.md:324-329 — E_LambdaAsOrOr: the double-pipe at expression
    // start position is the logical-OR token (TOrOr), not a zero-arg
    // lambda. Canonical zero-arg lambda is `() => body`. Parse continues
    // as `() => <next-expr>` per the Quick-Fix.
    TOrOr        => {
      report(ELambdaAsOrOr(span))
      let (body, p) = parse_expr(tokens, pos + 1)
      (nexpr(LambdaExpr([], body), span), p)
    },
    // SYNTAX.md:1593 — E_OrphanHandlerAttach: the tee-arrow at expression
    // start position has no preceding chain. Quick-Fix shape per spec:
    // delete the tee-arrow OR supply a body. Parser recovery: emit
    // diagnostic, return hole, advance past the tee-arrow token.
    TTildeGt     => {
      report(EOrphanHandlerAttach(span))
      let id = fresh_handle(span)
      (nhole(id, span), pos + 1)
    },
    _ => {
      report(PUnexpectedToken("unexpected token: {show_token_kind(kind_at(tokens, pos))}", span))
      let id = fresh_handle(span)
      (nhole(id, span), pos + 1)
    }
  }
}

// ─── Destructuring parameters = param-as-pattern (SYNTAX.md §«Anonymous
// functions», §«Function declarations») ──────────────────────────────────
//
// A param IS a Pat; `({name, age})` / `((a, b))` / `([h, ...t])` bind a
// PRecord/PTuple/PList at the parameter. The ultimate form is byte-identical to
// a destructuring `let`: the param desugars at fn ENTRY to a fresh-named param
// plus a `let <pat> = <fresh>` prepended to the body — the SAME projection
// desugar_block turns a destructuring let into a `match`. ONE pattern machinery
// at let-bind AND param-bind; no new infer/lower path, no TParam shape change.

/// A unique parameter name for a desugared destructure slot — keyed on the
/// pattern's fresh handle so it never collides with a source name.
fn fresh_param_name(span: ValidSpan) = "__dp{int_to_str(fresh_handle(span))}"

/// Convert a parsed expr (a lambda param, already parsed as an expression) to a
/// pattern: a record/tuple/list literal IS the corresponding destructure
/// pattern; a bare var is PVar; anything else is PWild (productive-under-error).
fn expr_to_pat(e) = {
  let N(eb, _, _) = e
  match eb {
    NExpr(VarRef(nm))           => if nm == "_" { PWild } else { PVar(nm) },
    NExpr(MakeRecordExpr(flds))  => PRecord(sort_pat_fields(record_fields_to_pat(flds))),
    NExpr(MakeTupleExpr(elems))  => PTuple(map(expr_to_pat, elems)),
    NExpr(MakeListExpr(elems))   => PList(map(expr_to_pat, elems), None),
    _                            => PWild
  }
}

/// Record literal fields `[(name, value_node)]` → pattern fields
/// `[(name, sub_pat)]` — the value node's pattern (field punning `{x}` parses
/// as `x: x`, so the sub-pat is the value's pattern).
fn record_fields_to_pat(flds) =
  map((f) => { let (nm, v) = f; (nm, expr_to_pat(v)) }, flds)

/// A param drawn from a Pat: PVar is the bare-name degenerate (no desugar);
/// any destructure pattern yields a fresh-named param plus the prepend-let
/// `let <pat> = <fresh>` that binds it at fn entry. Returns (TParam, Option(let)).
fn pat_param_and_let(pat, span: ValidSpan) = match pat {
  PVar(nm) => (TParam(nm, TVar(fresh_handle(span)), Unmarked, Unmarked, None), None),
  PWild    => (TParam("_", TVar(fresh_handle(span)), Unmarked, Unmarked, None), None),
  _ => {
    let fresh = fresh_param_name(span)
    let param = TParam(fresh, TVar(fresh_handle(span)), Unmarked, Unmarked, None)
    let bind = nstmt(LetStmt(pat, nexpr(VarRef(fresh), span)), span)
    (param, Some(bind))
  }
}

/// Prepend the collected destructure-let bindings to a body and run them
/// through desugar_block — so each `let <pat> = <fresh>` becomes the same
/// `match` a destructuring let would. No lets → the body is untouched
/// (byte-identical to a fn whose params are all bare names).
fn bind_param_destructures(lets, body, span: ValidSpan) =
  if len(lets) == 0 { body }
  else { nexpr(desugar_block(lets, body, span), span) }

/// Convert a list of parsed expr nodes (paren-lambda params) into a TParam list
/// PLUS the destructure-let bindings — each elem's pattern (expr_to_pat) drives
/// pat_param_and_let, so `((x, y)) => …` / `({a, b}) => …` bind their pattern at
/// fn entry. Parallel buffer-counter build (params + lets); returns
/// (params, lets).
fn exprs_to_params(elems, i, n, own buf, count, own lbuf, lcount) = {
  if i >= n { (slice(buf, 0, count), slice(lbuf, 0, lcount)) }
  else {
    let e = list_index(elems, i)
    let N(_, esp, _) = e
    let (param, opt_let) = pat_param_and_let(expr_to_pat(e), esp)
    let (b1, c1) = push_node(buf, count, param)
    let (lb1, lc1) = push_opt_let(lbuf, lcount, opt_let)
    exprs_to_params(elems, i + 1, n, b1, c1, lb1, lc1)
  }
}

fn parse_paren_or_tuple(ref tokens, pos, start_span) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) {
    // `()` — zero-arg lambda `() => body` (SYNTAX.md canonical) when
    // `=>` follows, else unit. One `=>`-peek mechanism across arities
    // 0/1/N (seed parser_compound drift-6 closure).
    let p_after = skip_ws(tokens, p + 1)
    if at(tokens, p_after, TFatArrow) {
      let (body, pb) = parse_expr(tokens, skip_ws(tokens, p_after + 1))
      (nexpr(LambdaExpr([], body), start_span), pb)
    } else {
      (nexpr(LitUnit, start_span), p + 1)
    }
  } else {
    let (first, p2) = parse_expr(tokens, p)
    let p3 = skip_ws(tokens, p2)
    if at(tokens, p3, TComma) {
      let buf = make_list(4)
      let (b1, c1) = push_node(buf, 0, first)
      let (final_buf, final_count, final_pos) =
        parse_tuple_tail(tokens, skip_ws(tokens, p3 + 1), b1, c1)
      let p_after = skip_ws(tokens, final_pos)
      if at(tokens, p_after, TFatArrow) {
        // `(e1, e2, ...) => body` — multi-param lambda; the parsed
        // tuple-elems reinterpret as params (seed parity:
        // parser_compound $parse_lambda_from_paren_multi).
        let elems = slice(final_buf, 0, final_count)
        let (params, dlets) =
          exprs_to_params(elems, 0, final_count, make_list(4), 0, make_list(4), 0)
        let (raw_body, pb) = parse_expr(tokens, skip_ws(tokens, p_after + 1))
        let body = bind_param_destructures(dlets, raw_body, start_span)
        (nexpr(LambdaExpr(params, body), start_span), pb)
      } else {
        (nexpr(MakeTupleExpr(slice(final_buf, 0, final_count)), start_span), final_pos)
      }
    } else {
      let p4 = expect(tokens, p3, TRParen)
      let p_after = skip_ws(tokens, p4)
      if at(tokens, p_after, TFatArrow) {
        // `(e) => body` — single-param lambda; `first` reinterprets
        // as the param. A destructure (`({x,y}) => …`) binds its pattern at
        // entry via the same prepend-let machinery.
        let N(_, fsp, _) = first
        let (param, opt_let) = pat_param_and_let(expr_to_pat(first), fsp)
        let (raw_body, pb) = parse_expr(tokens, skip_ws(tokens, p_after + 1))
        let body = bind_param_destructures(
          match opt_let { Some(l) => [l], None => [] }, raw_body, start_span)
        (nexpr(LambdaExpr([param], body), start_span), pb)
      } else {
        (first, p4)
      }
    }
  }
}

fn parse_tuple_tail(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) { (buf, count, p + 1) }
  else {
    let (elem, p2) = parse_expr(tokens, p)
    let (b1, c1) = push_node(buf, count, elem)
    let p3 = skip_ws(tokens, p2)
    if at(tokens, p3, TComma) {
      parse_tuple_tail(tokens, skip_ws(tokens, p3 + 1), b1, c1)
    } else {
      (b1, c1, expect(tokens, p3, TRParen))
    }
  }
}

// String interpolation per SYNTAX.md:1137-1187. Lexer (src/lexer.mn:262-309)
// tokenizes `"prefix{expr}suffix"` as:
//   TStringPart("prefix"), TStringSplice, <expr tokens>, TStringPart("suffix")
// where the closing `}` is consumed by lex_from (no terminator token). Multi-
// splice strings cascade the same alternation. Plain `"foo"` emits just
// TStringPart("foo") with no following splice.
//
// parse_string_interpolation enters with pos AFTER the first TStringPart and
// first_chunk holding its content. Loop: if next is TStringSplice, parse the
// inner expression via parse_expr (terminates naturally at TStringPart, the
// next non-operator-continuation), consume the next TStringPart for the
// trailing literal chunk, fold into a str_concat chain.
//
// Substrate: desugars to nested CallExpr(VarRef("str_concat"), [a, b]) — no
// new AST variant. Plain non-interpolated strings stay as bare LitString
// (single fragment, no splice → loop terminates immediately, returns
// nexpr(LitString(first_chunk), span)).
fn parse_string_interpolation(ref tokens, pos, first_chunk, start_span) = {
  // Per #138 — interpolation is a SEMANTIC AST node (MakeStringExpr)
  // carrying alternating literal-fragments + splice-exprs. The prior
  // eager-str_concat-fold drift committed result shape at parse time;
  // the new form lets infer narrow (Show-able splice check) and the
  // gradient teach constant-foldable splices at the cursor's read.
  //
  // If the lexer emitted no TStringSplice after the literal prefix, the
  // interpolation degenerates to a bare LitString. Adjacent TStringPart tokens
  // are normal for a multi-line `"""..."""` body (the lexer flushes one part
  // per line as it strips the common indent), so coalesce them before
  // deciding whether the string is interpolating.
  let (prefix, p0) = consume_string_parts(tokens, pos, first_chunk)
  if at(tokens, p0, TStringSplice) {
    let first_node = nexpr(LitString(prefix), start_span)
    let buf = make_list(4)
    let (b1, c1) = push_node(buf, 0, first_node)
    let (final_buf, final_count, final_pos) =
      parse_string_interpolation_loop(tokens, p0, b1, c1, start_span)
    (nexpr(MakeStringExpr(slice(final_buf, 0, final_count)), start_span), final_pos)
  } else {
    (nexpr(LitString(prefix), start_span), p0)
  }
}

fn parse_string_interpolation_loop(ref tokens, pos, own buf, count, start_span) = {
  if at(tokens, pos, TStringSplice) {
    let (splice_expr, p2) = parse_expr(tokens, pos + 1)
    // After the splice expression, the lexer emits TRBrace as the
    // splice terminator (lexer.mn:230-235). Consume it before looking
    // for the next TStringPart chunk. Seed parity: $parse_string_expr
    // expects and skips the terminating `}` at offset+1 past the inner
    // expression.
    let p2b = if at(tokens, p2, TRBrace) { p2 + 1 } else { p2 }
    let (next_chunk, p3) = consume_string_parts(tokens, p2b, "")
    let next_chunk_node = nexpr(LitString(next_chunk), start_span)
    let (b1, c1) = push_node(buf, count, splice_expr)
    let (b2, c2) = push_node(b1, c1, next_chunk_node)
    parse_string_interpolation_loop(tokens, p3, b2, c2, start_span)
  } else { (buf, count, pos) }
}

// After a TStringSplice's inner expression, the next token must be one or more
// TStringPart chunks. More than one chunk is normal in a multi-line
// `"""..."""` body, where the lexer flushes one part per line. Returns
// (coalesced_chunk, advanced_pos).
fn consume_string_parts(ref tokens, pos, acc) = match kind_at(tokens, pos) {
  TStringPart(s) => consume_string_parts(tokens, pos + 1, acc ++ s),
  _              => (acc, pos)
}

fn parse_list_literal(ref tokens, pos, start_span) = {
  let buf = make_list(4)
  let (final_buf, final_count, p) = parse_list_elems(tokens, pos, buf, 0)
  (nexpr(MakeListExpr(slice(final_buf, 0, final_count)), start_span), p)
}

fn parse_list_elems(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRBracket) { (buf, count, p + 1) }
  else {
    let (elem, p2) = parse_expr(tokens, p)
    let (b1, c1) = push_node(buf, count, elem)
    let p3 = skip_ws(tokens, p2)
    if at(tokens, p3, TComma) {
      parse_list_elems(tokens, skip_ws(tokens, p3 + 1), b1, c1)
    } else {
      (b1, c1, expect(tokens, p3, TRBracket))
    }
  }
}

/// Disambiguate `{`: record literal vs block. Per SYNTAX.md, after the
/// opening brace + whitespace, an `Identifier` followed by `:` (typed
/// field) or `,`/`}` (puned field) signals a record literal.
/// Anything else is a block. Lookahead is bounded to two tokens past
/// the brace — no backtracking, no ambiguity that escapes the parser.
fn parse_brace_expr(ref tokens, pos, start_span) = {
  let p = skip_ws(tokens, pos)
  // A record literal opens with an ident-shaped field name (incl. the
  // contextual keywords own/ref/handle — SYNTAX.md §572, #117 class)
  // followed by `:` / `,` / `}`. Canonical projection is_param_name_tok
  // (the Bool gate) extends the discrimination uniformly; otherwise a
  // block. `{ handle: handle, ... }` was mis-read as a block → `:`
  // unexpected.
  if at_ellipsis(tokens, p) {
    // `{...base, f: v}` — non-destructive record update (SYNTAX.md
    // §«Record update»). The leading spread is unambiguous: a block
    // never opens with `...`.
    parse_record_update(tokens, p, start_span)
  } else if is_param_name_tok(tokens, p) {
    let p2 = skip_ws(tokens, p + 1)
    match kind_at(tokens, p2) {
      TColon  => parse_record_literal(tokens, pos, start_span),
      TComma  => parse_record_literal(tokens, pos, start_span),
      TRBrace => parse_record_literal(tokens, pos, start_span),
      _       => parse_block_expr(tokens, pos, start_span)
    }
  } else {
    parse_block_expr(tokens, pos, start_span)
  }
}

// `{...base, f: v, ...}` → RecordUpdateExpr(base, sorted_override_fields).
// The spread base is parsed as an expression; the remaining fields parse
// through the same parse_record_fields machinery as a plain record
// literal and sort identically. Non-destructive: lower copies base's
// fields then overwrites/adds the listed ones (the base is read, never
// mutated). One spread per literal — the canonical form leads with it.
fn parse_record_update(ref tokens, pos, start_span) = {
  let after_dots = skip_ws(tokens, pos + 3)
  let (base, p_base) = parse_expr(tokens, after_dots)
  let p_after = skip_ws(tokens, p_base)
  // Override fields follow a comma; a bare `{...base}` is a pure copy
  // (no overrides) closing at `}`.
  if at(tokens, p_after, TComma) {
    let buf = make_list(4)
    let (final_buf, final_count, p) =
      parse_record_fields(tokens, skip_ws(tokens, p_after + 1), buf, 0)
    let sorted = sort_record_fields(slice(final_buf, 0, final_count))
    (nexpr(RecordUpdateExpr(base, sorted), start_span), p)
  } else {
    (nexpr(RecordUpdateExpr(base, []), start_span), expect(tokens, p_after, TRBrace))
  }
}

/// Record literal: `{name: expr, age: expr, ...}` or with field
/// puning `{name, age}` ≡ `{name: name, age: age}`. Fields sort by
/// name at parse time so downstream sees one canonical layout.
fn parse_record_literal(ref tokens, pos, start_span) = {
  let buf = make_list(4)
  let (final_buf, final_count, p) = parse_record_fields(tokens, pos, buf, 0)
  let sorted = sort_record_fields(slice(final_buf, 0, final_count))
  (nexpr(MakeRecordExpr(sorted), start_span), p)
}

fn parse_record_fields(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRBrace) { (buf, count, p + 1) }
  else {
    // Contextual-keyword field names (handle/own/ref) resolve to their
    // spelling — SYNTAX.md §572; canonical ident_or_kw_at projection.
    let name = ident_or_kw_at(tokens, p)
    let name_span = span_at(tokens, p)
    let p1 = p + 1
    let p2 = skip_ws(tokens, p1)
    let (value, p3) =
      if at(tokens, p2, TColon) {
        parse_expr(tokens, skip_ws(tokens, p2 + 1))
      } else {
        // Field puning: {name} desugars to {name: name}.
        (nexpr(VarRef(name), name_span), p1)
      }
    let (b1, c1) = push_node(buf, count, (name, value))
    let p4 = skip_ws(tokens, p3)
    if at(tokens, p4, TComma) {
      parse_record_fields(tokens, skip_ws(tokens, p4 + 1), b1, c1)
    } else {
      (b1, c1, expect(tokens, p4, TRBrace))
    }
  }
}

/// Insertion sort by field name. N≤~16 in practice; insertion is the
/// natural shape and keeps the parser dependency-free.
fn sort_record_fields(fields) = {
  sort_record_fields_loop(fields, 0, len(fields), [])
}

fn sort_record_fields_loop(fields, i, n, own acc) = {
  if i >= n { acc }
  else {
    sort_record_fields_loop(fields, i + 1, n,
      record_field_insert(acc, list_index(fields, i)))
  }
}

fn record_field_insert(sorted, entry) = {
  let (name, _) = entry
  let n = len(sorted)
  let pos = record_field_find_pos(sorted, name, 0, n)
  if pos < n {
    let buf = make_list(n + 1)
    let prefix = list_copy_into(sorted, buf, 0, pos)
    let with_ins = list_set(prefix, pos, entry)
    record_field_copy_suffix(sorted, with_ins, pos, pos, n)
  } else {
    let buf = make_list(n + 1)
    let copied = list_copy_into(sorted, buf, 0, n)
    list_set(copied, n, entry)
  }
}

fn record_field_find_pos(sorted, name, i, n) = {
  if i >= n { n }
  else {
    let (existing, _) = list_index(sorted, i)
    if str_lt(existing, name) {
      record_field_find_pos(sorted, name, i + 1, n)
    } else { i }
  }
}

fn record_field_copy_suffix(src, dst, src_idx, dst_idx, n) = {
  if src_idx >= n { dst }
  else {
    record_field_copy_suffix(
      src, list_set(dst, dst_idx + 1, list_index(src, src_idx)),
      src_idx + 1, dst_idx + 1, n
    )
  }
}

fn parse_block_expr(ref tokens, pos, start_span) = {
  let buf = make_list(8)
  let (final_buf, final_count, final_e, p) = parse_block_body(tokens, pos, buf, 0)
  (nexpr(desugar_block(slice(final_buf, 0, final_count), final_e, start_span), start_span), p)
}

fn parse_block_body(ref tokens, pos, own buf, count) = {
  // skip_ws passes over block-interior comments as layout — their home is the
  // enclosing block (SYNTAX.md Comments), and forcing them through parse_stmt
  // here would corrupt a comment-before-final-expr block's semantics (the final
  // value expr would become an ExprStmt and the block would return unit).
  // Per-block-item attachment is the refinement Hβ.parser.interior-comment-to-
  // enclosing-block; top-level decl comments attach via parse_stmt_list.
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRBrace) {
    let start = span_at(tokens, p)
    (buf, count, nexpr(LitUnit, start), p + 1)
  } else if at(tokens, p, TEof) {
    // Unclosed block at EOF — emit ONE diagnostic + halt with
    // synthetic LitUnit final-expr at EOF span. Mirrors
    // parse_match_arms's TEof arm per Hβ.parser.unclosed-construct-
    // eof-recovery. Without this branch the loop would re-enter
    // parse_expr at EOF, get an NError at the same position, and
    // recurse forever (each iteration emitting one P_ExpectedToken
    // diagnostic, exhausting heap).
    let start = span_at(tokens, p)
    report(PUnclosedConstruct("unexpected end of input inside block; expected `\}` to close", start))
    (buf, count, nexpr(LitUnit, start), p)
  } else {
    let is_decl = match kind_at(tokens, p) {
      TLet => true,
      TFn  => true,
      _    => false
    }
    if is_decl {
      let (stmt, p2) = parse_stmt(tokens, p)
      let (b1, c1) = push_node(buf, count, stmt)
      parse_block_body(tokens, skip_sep(tokens, p2), b1, c1)
    } else {
      let (expr, p2) = parse_expr(tokens, p)
      let p3 = skip_ws(tokens, p2)
      if at(tokens, p3, TRBrace) {
        (buf, count, expr, p3 + 1)
      } else {
        let start = span_at(tokens, p)
        let (b1, c1) = push_node(buf, count, nstmt(ExprStmt(expr), start))
        parse_block_body(tokens, skip_sep(tokens, p3), b1, c1)
      }
    }
  }
}

/// `let pat = v; rest` IS `match v { pat => rest }`. A destructuring let in a
/// block is the match projection wearing let's syntax — split the block at the
/// first one, wrapping the remainder (and final) as its single match arm, so the
/// node is born a `match` and INFERENCE types it (lowering merely projects it).
/// PVar/PWild/PLit lets stay direct, so `LetStmt` carries only PVar by
/// construction. The audit: a let-destructure RE-DERIVES match; unify it INTO
/// match at the node's birth, never re-derive it downstream.
/// (protocol_one_graph_two_operations.)
fn desugar_block(stmts, final_e, span) = match find_destructure_let(stmts, 0) {
  None    => BlockExpr(stmts, final_e),
  Some(i) => {
    let N(NStmt(LetStmt(pat, v)), lsp, _) = list_index(stmts, i)
    let rest_stmts = slice(stmts, i + 1, len(stmts))
    // The arm body is exactly what follows the destructure — a bare final when
    // nothing intervenes, else the desugared remainder. No redundant block.
    let arm_body = if len(rest_stmts) == 0 { final_e }
                   else { nexpr(desugar_block(rest_stmts, final_e, lsp), lsp) }
    let m = MatchExpr(v, [(pat, arm_body)])
    // A destructure at the head IS the match (no empty-prefix block); otherwise
    // the prefix stmts carry the match as their final. Byte-for-byte a
    // hand-written `match`.
    if i == 0 { m } else { BlockExpr(slice(stmts, 0, i), nexpr(m, lsp)) }
  }
}

fn find_destructure_let(stmts, i) =
  if i >= len(stmts) { None }
  else {
    match list_index(stmts, i) {
      N(NStmt(LetStmt(pat, _)), _, _) =>
        if is_destructure_pat(pat) { Some(i) } else { find_destructure_let(stmts, i + 1) },
      _ => find_destructure_let(stmts, i + 1)
    }
  }

fn is_destructure_pat(pat) = match pat {
  PVar(_)     => false,
  PWild       => false,
  PLit(_)     => false,
  PTuple(_)   => true,
  PCon(_, _)  => true,
  PList(_, _) => true,
  PRecord(_)  => true
}

fn parse_if(ref tokens, pos, span: ValidSpan) = {
  let (cond, p) = parse_expr(tokens, pos)
  let p2 = skip_ws(tokens, p)
  let (then_e, p3) =
    if at(tokens, p2, TLBrace) {
      parse_block_expr(tokens, p2 + 1, span_at(tokens, p2))
    } else {
      parse_expr(tokens, p2)
    }
  let p4 = skip_ws(tokens, p3)
  if at(tokens, p4, TElse) {
    let p5 = skip_ws(tokens, p4 + 1)
    let (else_e, p6) =
      if at(tokens, p5, TIf) {
        parse_if(tokens, p5 + 1, span_at(tokens, p5))
      } else if at(tokens, p5, TLBrace) {
        parse_block_expr(tokens, p5 + 1, span_at(tokens, p5))
      } else {
        parse_expr(tokens, p5)
      }
    (nexpr(IfExpr(cond, then_e, else_e), span), p6)
  } else {
    (nexpr(IfExpr(cond, then_e, nexpr(LitUnit, span)), span), p4)
  }
}

fn parse_match(ref tokens, pos, span: ValidSpan) = {
  let (scrutinee, p) = parse_expr(tokens, pos)
  let p2 = expect(tokens, skip_ws(tokens, p), TLBrace)
  let buf = make_list(4)
  let (final_buf, final_count, p3) =
    parse_match_arms(tokens, skip_ws(tokens, p2), buf, 0)
  (nexpr(MatchExpr(scrutinee, slice(final_buf, 0, final_count)), span), p3)
}

fn parse_match_arms(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  match kind_at(tokens, p) {
    TRBrace => (buf, count, p + 1),
    TEof    => unclosed_eof(tokens, p, "match arms", buf, count),
    _       => {
      let (pat, p2) = parse_pat_alt(tokens, p)
      let p3 = expect(tokens, skip_ws(tokens, p2), TFatArrow)
      let (body, p4) = parse_expr(tokens, skip_ws(tokens, p3))
      let p5 = skip_ws(tokens, p4)
      let p6 = if at(tokens, p5, TComma) { p5 + 1 } else { p5 }
      let (b1, c1) = push_node(buf, count, (pat, body))
      parse_match_arms(tokens, skip_ws(tokens, p6), b1, c1)
    }
  }
}

/// Pattern alternation at the match-arm grammar (SYNTAX.md §1605:
/// `|` is TPipe — variant separator in `type` body + pattern
/// alternation in match arm body). One pat, then a TPipe loop;
/// single-branch stays the bare pat (no degenerate PAlt — walkthrough
/// §7 "Single-branch alternation").
fn parse_pat_alt(ref tokens, pos) = {
  let (first, p) = parse_pat(tokens, pos)
  if at(tokens, skip_ws(tokens, p), TPipe) {
    let (branches, p2) = parse_pat_alt_branches(tokens, p, [first], 1)
    (PAlt(branches), p2)
  } else {
    (first, p)
  }
}

fn parse_pat_alt_branches(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TPipe) {
    let (next, p2) = parse_pat(tokens, skip_ws(tokens, p + 1))
    let (b1, c1) = push_node(buf, count, next)
    parse_pat_alt_branches(tokens, p2, b1, c1)
  } else {
    (slice(buf, 0, count), p)
  }
}

// Substrate-honest EOF terminator for nested parser loops. Emits
// ONE diagnostic (not the infinite per-iteration emit-and-retry
// drift pattern), returns the accumulated buf+count at the EOF
// position so the caller's chain unwinds cleanly. Every nested
// loop (parse_call_args, parse_match_arms, parse_record_fields,
// parse_variants, etc.) uses this at its TEof arm. Top-level
// parse_stmt_list's TEof is NOT routed here — top-level EOF is
// the natural terminator, not an unclosed construct.
//
// Per protocol_no_silent_fallback.md: the diagnostic IS the
// substrate-honest projection of "unexpected EOF inside <construct>",
// with span at EOF and applicability MaybeIncorrect (the developer's
// intent is unrecoverable without more input).
fn unclosed_eof(ref tokens, p, construct, own buf, count) = {
  report(PUnclosedConstruct("unexpected end of input inside {construct}; the construct was never closed", span_at(tokens, p)))
  (buf, count, p)
}

// `handle { body } with h` is the redundant spelling of `(body) ~> h`
// (SYNTAX.md §«Installation», E_RedundantHandleBlock). `~>` is the ONE
// install verb — it draws the one install edge to handler `h`'s node;
// the handler's state and arms live at the handler DECLARATION, never at
// the install site. So this parses the body, requires the `with H`
// install clause, and produces the IDENTICAL PipeExpr(PTee, body, H)
// graph that `(body) ~> H` produces — by no-redundant-form (Governing
// Principle 2) there is no second AST node, no block-form-vs-pipe-form
// choice. The double-`with` `handle {…} with h with s = 0 {…}` spelling
// (inline state-init + arms) dissolves with the keyword: it only existed
// to feed a separate HandleExpr node that re-derived the row absorption
// `~>` already carries (the Carried-Truth violation, now deleted).
fn parse_handle(ref tokens, pos, span: ValidSpan) = {
  let p = skip_ws(tokens, pos)
  let (body, p2) =
    if at(tokens, p, TLBrace) {
      parse_block_expr(tokens, p + 1, span_at(tokens, p))
    } else {
      parse_expr(tokens, p)
    }
  let p3 = skip_ws(tokens, p2)
  let p_with = expect(tokens, p3, TWith)
  let (handler, p4) = parse_expr(tokens, skip_ws(tokens, p_with))
  report(ERedundantHandleBlock(span_join(span, span_at(tokens, p4 - 1))))
  (nexpr(PipeExpr(PTee, body, handler), span), p4)
}

fn parse_perform(ref tokens, pos, span: ValidSpan) = {
  // SYNTAX.md §«Invoking effect operations»: an effect op is a BARE CALL;
  // `perform` is format-lifted (E_RedundantPerform, MachineApplicable). The
  // env binding proves op-ness (EffectOpScheme) and the op's TFun row carries
  // Closed[eff] definitionally, so the CallExpr path infers and lowers the op
  // exactly as `op(args)` does — the bare call is the one form that survives.
  // PerformExpr is dissolved: `perform op(args)` produces the SAME CallExpr
  // node a bare `op(args)` does, never a parallel AST node (Carried-Truth).
  let op_span = span_at(tokens, pos)
  let op_name = ident_at(tokens, pos)
  let p = expect(tokens, skip_ws(tokens, pos + 1), TLParen)
  let (args, p2) = parse_call_args(tokens, skip_ws(tokens, p))
  report(ERedundantPerform(span_join(span, span_at(tokens, p2 - 1))))
  (nexpr(CallExpr(nexpr(VarRef(op_name), op_span), args),
         span_join(span, span_at(tokens, p2 - 1))), p2)
}

fn parse_resume(ref tokens, pos, span: ValidSpan) = {
  let p = expect(tokens, skip_ws(tokens, pos), TLParen)
  // SYNTAX.md:766-777 — for ops returning `()`, `resume()` is the
  // canonical form (No-Redundant-Form + Parameters-ARE-Tuples). When
  // `(` is immediately followed by `)`, the resumed value is unit.
  // Synthetic LitUnit at the resume span mirrors the implicit-else
  // LitUnit synthesis (parser.mn IfExpr arm). Two-arm structural
  // disambiguation (TRParen-immediate vs expr) — not multi-arm
  // form-classification, so not parser-eager-form drift.
  let p_arg = skip_ws(tokens, p)
  let (val, p2) =
    if at(tokens, p_arg, TRParen) {
      (nexpr(LitUnit, span), p_arg)
    } else {
      parse_expr(tokens, p_arg)
    }
  let p3 = expect(tokens, skip_ws(tokens, p2), TRParen)
  // Hβ.first-light.resume-with-state-mutation: `resume(val) with field =
  // expr [, field = expr]*` captures state_updates as list of
  // {name, init} records — same shape as handler state-fields. Lower's
  // ResumeExpr arm threads these as state-record store-backs preceding
  // the LReturn, so handler state actually mutates across resume calls.
  let p_with = skip_ws(tokens, p3)
  let (state_updates, p4) = if at(tokens, p_with, TWith) {
    parse_resume_state_updates(tokens, skip_ws(tokens, p_with + 1))
  } else { ([], p3) }
  (nexpr(ResumeExpr(val, state_updates), span), p4)
}

fn parse_lambda(ref tokens, pos, span: ValidSpan) = {
  let buf = make_list(4)
  let (final_buf, final_count, p) = parse_lambda_params(tokens, pos, buf, 0)
  let (body, p2) = parse_expr(tokens, skip_ws(tokens, p))
  (nexpr(LambdaExpr(slice(final_buf, 0, final_count), body), span), p2)
}

fn parse_lambda_params(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TPipe) { (buf, count, p + 1) }
  else {
    let name = ident_at(tokens, p)
    let h = fresh_handle(span_at(tokens, p))
    let param = TParam(name, TVar(h), Unmarked, Unmarked, None)
    let (b1, c1) = push_node(buf, count, param)
    let p2 = skip_ws(tokens, p + 1)
    if at(tokens, p2, TComma) {
      parse_lambda_params(tokens, skip_ws(tokens, p2 + 1), b1, c1)
    } else {
      (b1, c1, expect(tokens, p2, TPipe))
    }
  }
}

fn parse_body(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TLBrace) {
    // Per Hβ.parser.fn-body-pipe-continuation (#125; seed
    // parser_fn.wat:319-341 canonical): a brace body is the LEFT
    // operand of any trailing pipe chain — `{ ... } ~> h1 ~> h2` is
    // ONE PipeExpr, not a block with a dangling `~>`.
    // parse_block_expr_checked alone returns the BlockExpr and loses
    // every trailing `~>` (perform sites then fall to LConst(0); the
    // orphaned `~>` surfaces as E_OrphanHandlerAttach). Feed the block
    // into binop_loop to absorb the chain while keeping the brace-
    // context diagnostics parse_block_expr_checked emits. Converges
    // the brace path to the seed's "route through parse_expr ALWAYS".
    let (block, p_block) =
      parse_block_expr_checked(tokens, p + 1, span_at(tokens, p))
    binop_loop(tokens, block, p_block, 1)
  } else {
    // SYNTAX.md «Function declarations»: braces are required EXACTLY when the
    // body is a BlockExpr (it introduces let-bindings/statements) — NEVER keyed
    // on line count. A single expression, even a multi-line if/match/pipe chain,
    // needs no braces. So a braceless body IS one expression: parse_expr is the
    // whole story, nothing is emitted. (A braceless body that introduces
    // statements is a parse error at the statement keyword; E_BlockNeedsBraces
    // is the recovery diagnostic there — peer Hβ.parser.block-needs-braces.)
    parse_expr(tokens, p)
  }
}

// Wrapper around parse_block_expr that emits E_RedundantBraces when braces wrap
// a non-BlockExpr body (no statements) — keyed on BlockExpr-SHAPE, NEVER on line
// count (SYNTAX.md «Redundant braces»: the trigger is "braces enclose a body
// that introduces no let-bindings/statements", regardless of line count).
fn parse_block_expr_checked(ref tokens, pos, start_span) = {
  let (block_node, p_end) = parse_block_expr(tokens, pos, start_span)
  if is_empty_block(block_node) {
    report(ERedundantBraces(span_join(start_span, span_at(tokens, p_end - 1))))
  } else { () }
  (block_node, p_end)
}

// "Is this Node an empty BlockExpr (a `{ final_expr }` with no statements)?"
// Returns Bool — false is the identity-preserve value for non-BlockExpr
// shapes (a non-block is correctly "not an empty block"). Avoids the
// drift class of `_ => <fabricated int sentinel>` per CLAUDE.md red-flag
// "no `_ => <fabricated value>` over a load-bearing ADT".
fn is_empty_block(node) = {
  let N(body, _, _) = node
  match body {
    NExpr(e) => is_empty_block_expr(e),
    _        => false
  }
}

// SYNTAX.md:1599 — names that look like keywords from other languages
// (Python / JS / C / Rust) but aren't Mentl keywords. Mentl's
// substrate uses verbs (iterate / perform / resume / pipe operators),
// not statement keywords. Emit E_NotAKeyword on these as a teaching
// surface toward Mentl idiom. The string literals below ARE the
// detection target — drift-audit suppress is the residue form.
fn is_foreign_keyword(name) =
  name == "for" ||      // drift-audit: ignore
  name == "while" ||    // drift-audit: ignore
  name == "loop" ||     // drift-audit: ignore
  name == "break" ||    // drift-audit: ignore
  name == "continue" || // drift-audit: ignore
  name == "return"      // drift-audit: ignore

fn is_empty_block_expr(e) = match e {
  BlockExpr(stmts, _) => len(stmts) == 0,
  _                   => false
}

// Patterns

fn parse_pat(ref tokens, pos) = {
  match kind_at(tokens, pos) {
    TIdent(v) => {
      if v == "_" { (PWild, pos + 1) }
      else {
        let first_code = first_char_code(v)
        if first_code >= 65 && first_code <= 90 {
          // Capitalized identifier — constructor pattern
          let p2 = pos + 1
          if at(tokens, p2, TLParen) {
            let (sub, p3) = parse_pat_args(tokens, skip_ws(tokens, p2 + 1))
            (PCon(v, sub), p3)
          } else {
            (PCon(v, []), p2)
          }
        } else {
          (PVar(v), pos + 1)
        }
      }
    },
    TIntLit(n)    => (PLit(LVInt(n)), pos + 1),
    TFloatLit(f)  => (PLit(LVFloat(f)), pos + 1),
    TStringPart(s) => (PLit(LVString(s)), pos + 1),
    TTrue      => (PLit(LVBool(true)), pos + 1),
    TFalse     => (PLit(LVBool(false)), pos + 1),
    TLParen    => {
      let (sub, p) = parse_pat_args(tokens, skip_ws(tokens, pos + 1))
      (PTuple(sub), p)
    },
    TLBracket  => {
      let (sub, rest, p) = parse_pat_list_args(tokens, skip_ws(tokens, pos + 1))
      (PList(sub, rest), p)
    },
    TLBrace    => {
      let (flds, p) = parse_pat_record_fields(tokens, skip_ws(tokens, pos + 1))
      (PRecord(sort_pat_fields(flds)), p)
    },
    _ => {
      report(PUnexpectedToken("unexpected token in pattern position", span_at(tokens, pos)))
      (PWild, pos + 1)
    }
  }
}

/// Parse `{name, age}` or `{name: sub_pat, age: sub_pat}`. Field
/// puning is the default — `{name}` ≡ `{name: PVar("name")}`.
fn parse_pat_record_fields(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRBrace) { ([], p + 1) }
  else {
    let name = ident_at(tokens, p)
    let p1 = p + 1
    let p2 = skip_ws(tokens, p1)
    let (sub_pat, p3) =
      if at(tokens, p2, TColon) {
        parse_pat(tokens, skip_ws(tokens, p2 + 1))
      } else {
        (PVar(name), p1)
      }
    let p4 = skip_ws(tokens, p3)
    if at(tokens, p4, TComma) {
      let (rest, p5) = parse_pat_record_fields(tokens, skip_ws(tokens, p4 + 1))
      ([(name, sub_pat)] ++ rest, p5)
    } else {
      ([(name, sub_pat)], expect(tokens, p4, TRBrace))
    }
  }
}

fn sort_pat_fields(fields) = {
  sort_record_fields_loop(fields, 0, len(fields), [])
}

fn parse_pat_args(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) { ([], p + 1) }
  else {
    let (pat, p2) = parse_pat(tokens, p)
    let p3 = skip_ws(tokens, p2)
    if at(tokens, p3, TComma) {
      let (rest, p4) = parse_pat_args(tokens, skip_ws(tokens, p3 + 1))
      ([pat] ++ rest, p4)
    } else {
      ([pat], expect(tokens, p3, TRParen))
    }
  }
}

fn parse_pat_list_args(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRBracket) { ([], None, p + 1) }
  else if at_ellipsis(tokens, p) {
    let name_pos = skip_ws(tokens, p + 3)
    let rest_name = ident_at(tokens, name_pos)
    let p_after_name = skip_ws(tokens, name_pos + 1)
    // `..._` accepts any remaining tail WITHOUT binding it (the discard
    // convention, SYNTAX.md §«Pattern syntax»): a rest name of `_` is the
    // no-bind rest, distinct from `...rest`'s named binder. None ≠ a
    // binder named "_".
    let rest = if rest_name == "_" { None } else { Some(rest_name) }
    ([], rest, expect(tokens, p_after_name, TRBracket))
  }
  else {
    let (pat, p2) = parse_pat(tokens, p)
    let p3 = skip_ws(tokens, p2)
    if at(tokens, p3, TComma) {
      let (rest_pats, rest_name, p4) = parse_pat_list_args(tokens, skip_ws(tokens, p3 + 1))
      ([pat] ++ rest_pats, rest_name, p4)
    } else {
      ([pat], None, expect(tokens, p3, TRBracket))
    }
  }
}

fn at_ellipsis(ref tokens, pos) =
  at(tokens, pos, TDot) &&
  at(tokens, pos + 1, TDot) &&
  at(tokens, pos + 2, TDot)

// Per Hβ.first-light.first-char-code-via-byte-at: chars/char_code aren't
// defined in the wheel runtime; byte_at is the substrate-honest primitive.
// Strings are length-prefixed; byte_at(s, 0) reads s[0] as i32 directly.
fn first_char_code(s) = {
  if byte_len(s) == 0 { 0 }
  else { byte_at(s, 0) }
}

// Type expressions

fn parse_type_ty(ref tokens, pos) = match kind_at(tokens, pos) {
  TIdent(v) => {
    let base_pos = pos + 1
    let base = if v == "Int"        { TInt }
               else if v == "Float"  { TFloat }
               else if v == "String" { TString }
               else if v == "Bool"   { TName("Bool", []) }
               else if v == "Unit"   { TUnit }
               else                        { TName(v, []) }
    // Parens application — the one-application-syntax law: types
    // apply like effects apply (`Sample(44100)`) and values apply
    // (`f(x)`). `Option(Int)` rewraps a TName base with args.
    // Unambiguous: no expression context exists in type position.
    // Primitives (TInt etc.) take no args; per protocol_no_silent_
    // fallback the args are discarded but the parse advances cleanly.
    if at(tokens, base_pos, TLParen) {
      let (args, p_after) = parse_type_args(tokens, skip_ws(tokens, base_pos + 1))
      let typed = match base {
        TName(name, _) => TName(name, args),
        _              => base
      }
      (typed, p_after)
    } else { (base, base_pos) }
  },
  TLParen => {
    let p = skip_ws(tokens, pos + 1)
    if at(tokens, p, TRParen) { (TUnit, p + 1) }
    else {
      let (first, p2) = parse_type_ty(tokens, p)
      let p3 = skip_ws(tokens, p2)
      if at(tokens, p3, TComma) {
        let buf = make_list(4)
        let (b1, c1) = push_node(buf, 0, first)
        let (final_buf, final_count, p4) =
          parse_type_ty_tail(tokens, skip_ws(tokens, p3 + 1), b1, c1)
        (TTuple(slice(final_buf, 0, final_count)), p4)
      } else {
        (first, expect(tokens, p3, TRParen))
      }
    }
  },
  TLBrace => {
    // Structural record type `{name: Ty, age: Ty}` (closed) or open
    // `{name: Ty, ...}` / `{name: Ty, ...R}` (accepts any record with AT
    // LEAST these fields — SYNTAX.md §«Row polymorphism»). Sorted at
    // parse; an open rest mints a fresh row var and the field set becomes
    // a TRecordOpen (mk_record_open canonicalizes the fields with the
    // row var); closed stays TRecord.
    let (flds, rest_var, p) = parse_record_type_fields(tokens, skip_ws(tokens, pos + 1))
    let sorted = sort_record_type_fields(flds)
    let ty = match rest_var {
      Some(v) => mk_record_open(sorted, v),
      None    => TRecord(sorted)
    }
    (ty, p)
  },
  TLBracket => {
    // List type `[T]` → TList(T) — the canonical list-type notation
    // (SYNTAX.md:691 `type Bytes = [Int]`). The seed parses it; this arm
    // closes the wheel-parser fidelity gap (`[String]` in main.mn's
    // Invocation ctor desynced into the silent `_ => TUnit` fallback →
    // P_UnexpectedToken at pass-2). One element type, then `]`.
    let (elem, p) = parse_type_ty(tokens, skip_ws(tokens, pos + 1))
    (TList(elem), expect(tokens, skip_ws(tokens, p), TRBracket))
  },
  _ => {
    report(PUnexpectedToken("unexpected token in type position — expected a type", span_at(tokens, pos)))
    (TUnit, pos + 1)
  }
}

fn parse_type_ty_tail(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) { (buf, count, p + 1) }
  else {
    let (ty, p2) = parse_type_ty(tokens, p)
    let (b1, c1) = push_node(buf, count, ty)
    let p3 = skip_ws(tokens, p2)
    if at(tokens, p3, TComma) {
      parse_type_ty_tail(tokens, skip_ws(tokens, p3 + 1), b1, c1)
    } else {
      (b1, c1, expect(tokens, p3, TRParen))
    }
  }
}

// Parse comma-separated type arguments terminated by TRParen. Caller
// has already consumed the opening TLParen. Returns ([Ty], pos-after).
// Used for type application `Name(T1, T2, ...)`.
fn parse_type_args(ref tokens, pos) = {
  let buf = make_list(4)
  let (final_buf, final_count, p) = parse_type_args_loop(tokens, pos, buf, 0)
  (slice(final_buf, 0, final_count), p)
}

fn parse_type_args_loop(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) { (buf, count, p + 1) }
  else {
    let (ty, p2) = parse_type_ty(tokens, p)
    let (b1, c1) = push_node(buf, count, ty)
    let p3 = skip_ws(tokens, p2)
    if at(tokens, p3, TComma) {
      parse_type_args_loop(tokens, skip_ws(tokens, p3 + 1), b1, c1)
    } else {
      (b1, c1, expect(tokens, p3, TRParen))
    }
  }
}

// Parse a structural record type's field list, recognizing an optional
// trailing open-row rest `...` / `...R` (SYNTAX.md §«Row polymorphism»).
// Returns (fields, rest_var, pos-after-`}`): rest_var is Some(row-handle)
// for an open record (accepts any record with AT LEAST these fields),
// None for a closed one. `...` mints a fresh anonymous row var; `...R`
// binds the row var name R (the reuse of R across sites within one
// signature is a named-row-var environment threaded through type-parse —
// the structural peer Hβ.parser.named-row-var-reuse; here both mint a
// fresh row var). The downstream substrate (TRecordOpen, unify_types'
// row-poly arms) is already built; this parse closes the surface.
fn parse_record_type_fields(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRBrace) { ([], None, p + 1) }
  else if at_ellipsis(tokens, p) {
    // `...` or `...R` rest — the open-row marker. A name after the three
    // dots binds the row var (R); absent = anonymous. Both mint a fresh
    // row-var handle; consume to the closing `}`.
    let after_dots = p + 3
    let named = match kind_at(tokens, after_dots) {
      TIdent(_) => true,
      _         => false
    }
    let p_rest = if named { after_dots + 1 } else { after_dots }
    let row_var = fresh_handle(span_at(tokens, p))
    ([], Some(row_var), expect(tokens, skip_ws(tokens, p_rest), TRBrace))
  } else {
    let name = ident_at(tokens, p)
    let p1 = expect(tokens, p + 1, TColon)
    let (ty, p2) = parse_type_ty(tokens, skip_ws(tokens, p1))
    let p3 = skip_ws(tokens, p2)
    if at(tokens, p3, TComma) {
      let (rest, rest_var, p4) = parse_record_type_fields(tokens, skip_ws(tokens, p3 + 1))
      ([(name, ty)] ++ rest, rest_var, p4)
    } else {
      ([(name, ty)], None, expect(tokens, p3, TRBrace))
    }
  }
}

fn sort_record_type_fields(fields) = {
  sort_record_type_fields_loop(fields, 0, len(fields), [])
}

fn sort_record_type_fields_loop(fields, i, n, own acc) = {
  if i >= n { acc }
  else {
    sort_record_type_fields_loop(fields, i + 1, n,
      record_field_insert(acc, list_index(fields, i)))
  }
}

fn parse_type_expr(ref tokens, pos) = {
  let (ty, p) = parse_type_ty(tokens, pos)
  let span = span_at(tokens, pos)
  // Mint a node carrying the REAL annotation Ty (NTypeAnn) — the source wrote
  // a return type, so the graph holds that type live (Carried-Truth). infer's
  // FnStmt arm reads it back and unifies the inferred body return against it
  // (present = a CONSTRAINT, E_TypeMismatch on violation; SYNTAX.md «Return
  // type omission»). Never the old dummy LitUnit that discarded the parsed Ty.
  (mint_node(NTypeAnn(ty), span), p)
}

// Predicates — minimal (expressions after `where`)

fn parse_predicate(ref tokens, pos) = {
  // Per T1.3 refinement-types-with-predicate-capture: parse the
  // predicate body as a generic expression via parse_expr, then
  // walk the resulting AST and project to the Predicate ADT. The
  // expression form admits comparisons (`<`, `<=`, `==`), logical
  // composition (`&&`, `||`, `!`), and fn application
  // (`even(self)`, `bytes_valid_utf8(self)`). `self` in the body
  // refers to the value being refined; node_to_predicate reads each
  // operand node LIVE (no PExpr copy).
  //
  // W_RedundantWhere narration: if the resulting Predicate is the
  // literal PTrue (no constraint), emit the gradient hint per
  // SYNTAX.md:1604-1611 — the where-clause adds nothing.
  let (expr_node, p) = parse_expr(tokens, pos)
  let N(_, span, _) = expr_node
  let pred = node_to_predicate(expr_node, span)
  match pred {
    PTrue => report(WRedundantWhere(span)),
    _     => ()
  }
  (pred, p)
}

// Project a predicate-body AST node to the Predicate ADT, carrying each
// operand node's HANDLE — every node is registered in the one graph at
// construction (mint_node), so graph_node_body resolves its Expr live and
// the predicate holds the edge, not a copy. A comparison carries its two
// operand handles; `>`/`>=` normalize to `<`/`<=` with swapped operands;
// `&&`/`||`/`!` compose recursively; ANY other boolean expression (a
// refinement call, a bare bool var) IS its graph node — PBoolNode(handle),
// read live. No lossy fallback.
fn node_to_predicate(node, span: ValidSpan) = {
  let N(body, _, _) = node
  match body {
    NExpr(BinOpExpr(BEq, l, r))     => compare_pred(BEq, l, r),
    NExpr(BinOpExpr(BLt, l, r))     => compare_pred(BLt, l, r),
    NExpr(BinOpExpr(BLe, l, r))     => compare_pred(BLe, l, r),
    NExpr(BinOpExpr(BGt, l, r))     => compare_pred(BLt, r, l),
    NExpr(BinOpExpr(BGe, l, r))     => compare_pred(BLe, r, l),
    NExpr(BinOpExpr(BAnd, l, r))    => PAnd(node_to_predicate(l, span), node_to_predicate(r, span)),
    NExpr(BinOpExpr(BOr, l, r))     => POr(node_to_predicate(l, span), node_to_predicate(r, span)),
    NExpr(UnaryOpExpr(UNot, inner)) => PNot(node_to_predicate(inner, span)),
    NExpr(LitBool(true))            => PTrue,
    _                               => PBoolNode(node_handle(node))
  }
}

// A comparison carries its two operand handles (resolved live via graph_node_body).
fn compare_pred(op, l, r) = PCompare(op, node_handle(l), node_handle(r))

