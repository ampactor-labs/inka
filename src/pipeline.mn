// pipeline.mn — the compiler's spine (spec 04 · 05 · 06 · 10)
//
// One file; five entry points; each a `|>` + `~>` topology. The `|>`
// chain IS the stages. The `~>` chain IS the capability stack —
// outermost least trusted, innermost most empowered. The shape of
// this file IS the compiler's architecture.
//
//   compile(src)  →  WAT bytes
//   check(src)    →  diagnostics (no lowering, no emit)
//   query(src,q)  →  structured answer
//   teach(src)    →  gradient recommendation
//   audit(src)    →  capability set + severance suggestions
//
// Each route shares the same substrate handlers — graph, env,
// diagnostics, lookup_ty_graph — and adds route-specific ones.
// Source is never re-inferred across routes; the graph is one.
//
// This file declares two handlers it OWNS:
//   env_handler         — scoped binding stack (spec 04)
//   lookup_ty_graph     — bridge GraphRead → LookupTy (spec 05)
//   diagnostics_handler — stderr diagnostic routing (spec 06)
//
// Every other handler is imported from its owner module:
//   graph_handler       → graph.mn
//   verify_ledger       → verify.mn
//   mentl_default       → mentl.mn
//   query_default       → query.mn
//   affine_ledger       → own.mn
//   clock_real, tick_real, sample_real, deadline_real → clock.mn

import graph
import types
import effects
import infer
import lower
import backends/wasm
import lexer
import parser
import own
import verify
import mentl
import query
import dsp/clock
import cache
import driver

// The spine — entry points as |> + ~> topology
// Read top-to-bottom: source flows DOWN through `|>`; handlers wrap
// OUTWARD through `~>`. Outermost handler is the sandbox boundary.
//
// IC.4: compile / check now route through driver_check when invoked
// with an entry-MODULE name (incremental). The legacy single-source
// entry compile/check_source remain for tests that pass a raw
// source string. The driver path consults .kai caches via FS;
// every module either loads cached entries or re-infers + writes
// fresh cache.

fn compile(entry_module) = {
  {
    // driver_check_entry infers the deps DAG + the entry ONCE and returns
    // the entry's already-typed AST — compile lowers that live graph, no
    // second fs_read / frontend / infer_program (Carried-Truth: the entry
    // is proven once and read live, never re-derived).
    entry_module |> driver_check_entry |> saturate_pass |> lower_program |> emit_module
  }
    ~> wat_stdout
    ~> wasi_filesystem       // FS — per-file byte I/O for driver / cache
    ~> string_table          // W5 — compile-time interned string offsets
    ~> emit_memory_bump      // swap for emit_memory_arena to prove surface
    ~> body_context          // H1 — per-fn-body emit metadata
    ~> mentl_default
    ~> affine_ledger
    ~> region_tracker        // I12 — region-escape ledger (substrate prep)
    ~> verify_ledger
    ~> lower_scope
    ~> arm_state_default
    ~> lookup_ty_graph
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> parallel_compose
    ~> wasi_threads
    ~> diagnostics_handler
}

// Per Hβ.first-light.compile-stdin-substrate (2026-05-09): canonical
// stdin-source compile path. Per Unix vocabulary `mentl compile -`
// reads source from stdin. Skips driver_check + fs_read_file (no
// module-graph; no path); reads the entire stdin via read_stdin
// (lib/runtime/io.mn:83 — fd_read loop with grow-on-headroom buffer);
// pipes through frontend → lower_program → emit_module. Same handler
// chain as compile() — emission to stdout via wat_stdout, all the
// substrate handlers attached.
//
// L1 fixpoint requires this path: seed compiles wheel → mentl2.wat;
// mentl2 reads stdin (the wheel input) → emits mentl3.wat. Both passes
// produce byte-identical output when the wheel-source emit is
// deterministic AND substrate-aligned across seed + wheel.
fn compile_stdin() = {
  read_stdin() |> frontend |> infer_program |> saturate_pass |> lower_program |> emit_module
}
    ~> wat_stdout
    ~> wasi_filesystem
    ~> string_table
    ~> emit_memory_bump
    ~> body_context
    ~> mentl_default
    ~> affine_ledger
    ~> region_tracker
    ~> verify_ledger
    ~> lower_scope
    ~> arm_state_default
    ~> lookup_ty_graph
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> parallel_compose
    ~> wasi_threads
    ~> diagnostics_handler

fn pipeline_check(entry_module) = {
  driver_check(entry_module)
    ~> wasi_filesystem
    ~> mentl_default
    ~> affine_ledger
    ~> verify_ledger
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> parallel_compose
    ~> wasi_threads
    ~> diagnostics_handler
}

// Legacy single-source entry — for tests that pass raw source
// without filesystem layout. No caching; full re-infer each call.
fn compile_source(source) = {
  source
    |> frontend
    |> infer_program
    |> lower_program
    |> emit_module
    ~> wat_stdout
    ~> string_table
    ~> emit_memory_bump
    ~> body_context
    ~> mentl_default
    ~> affine_ledger
    ~> region_tracker
    ~> verify_ledger
    ~> lower_scope
    ~> arm_state_default
    ~> lookup_ty_graph
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> parallel_compose
    ~> wasi_threads
    ~> diagnostics_handler
}

fn check_source(source) = {
  source
    |> frontend
    |> infer_program
    ~> mentl_default
    ~> affine_ledger
    ~> verify_ledger
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> parallel_compose
    ~> wasi_threads
    ~> diagnostics_handler
}

fn query(source, question) = {
  {
    let ast = source |> frontend
    infer_program(ast)
    let q = parse_query_string(question)
    let result = ask(q)
    render_query_result(result)
  }
    ~> query_default
    ~> mentl_default
    ~> verify_ledger
    ~> lookup_ty_graph
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> parallel_compose
    ~> wasi_threads
    ~> diagnostics_handler
}

fn teach(source) = {
  {
    let ast = source |> frontend
    infer_program(ast)
    let gradients = collect_gradients(ast)
    render_gradients(gradients)
  }
    ~> mentl_default
    ~> verify_ledger
    ~> lookup_ty_graph
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> parallel_compose
    ~> wasi_threads
    ~> diagnostics_handler
}

fn audit(source) = {
  {
    let ast = source |> frontend
    infer_program(ast)
    let entries = collect_fn_rows(ast)
    render_audit(entries)
  }
    ~> mentl_default
    ~> verify_ledger
    ~> lookup_ty_graph
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> parallel_compose
    ~> wasi_threads
    ~> diagnostics_handler
}

// ─── cursor_session_batch — `<|` fanout from one source to four projections ──
//
// One source borrowed (read-only) to four cursor projections — check
// surfaces diagnostics; teach surfaces gradient steps; query answers
// structured questions; audit surfaces capability-severance suggestions.
// All four read the SAME inferred graph; the AST is borrowed via `<|`
// to each branch; outputs tuple together.
//
// `<|` here proves the cursor's eight-aspect projection AT THE
// PIPELINE level: a single edit triggers four canonical surfaces
// simultaneously — exactly what `mentl edit` does at the IDE layer.
// The seed parser handles `<|` per Hβ.first-light.handle-expr-with-
// clause-substrate; the lower-side parallelism dispatches via the
// Thread effect handler installed upstream (single-thread sequential
// default; WasiThreads spawn in production per
// protocol_parallelism_symmetry.md).
//
// Renamed from `cursor_session` 2026-05-07 to disambiguate from
// `cursor_session` (cursor_transport.mn) — that one opens the bus-
// compressor loop with a Caret; this one runs the four batch
// projections from one source string. Different shapes; same family.
//
// Drift refused: 9 (no deferred surface — all four bodied here);
// 6 (none of the surfaces is primitive special-case; uniform branches);
// 7 (output is a 4-tuple, not parallel-arrays).

fn cursor_session_batch(source) = {
  let (diagnostics, gradients, audit_report, query_default_view) =
    source
      <| (
        (s) => check_source(s),
        (s) => teach(s),
        (s) => audit(s),
        (s) => query(s, "type main")
      )
  CursorSessionResult(diagnostics, gradients, audit_report, query_default_view)
}

type CursorSessionResult
  = CursorSessionResult({
      diagnostics:        String,
      gradients:          String,
      audit_report:       String,
      query_default_view: String
    })

// ─── Multi-module compilation — `parallel_map` over a module list ────
//
// `compile_pair_modules` (binary special-case) was erased per
// `feedback_fully_as_early.md`: when the driver's topological-layer
// par-walk lands (`Hβ.driver.level-set-par-walk` peer), each
// dep-independent layer composes as `parallel_map(compile, layer)`
// directly. `parallel_compose` handler in main's `~>` chain dispatches
// each module's compile to a separate thread; render targets attach
// via `~>` to the per-module wat output. Drift 6 erasure.

// ─── ic_compile_loop — `<~` feedback closing on queue stability ───────
//
// Build IS the `<~` loop closing at fixpoint (PLAN §2). Every source
// change bumps the graph epoch at the outermost commit (graph_mutated,
// graph.mn); project_queue_merger re-projects the oracle queue live
// (memoized by that epoch — one re-projection per real change); the
// cursor surfaces the highest-priority residue. The cycle converges when
// the projection stops changing — the project at the gradient's top.
//
// `<~` runs under IC — the Iterate-class context SYNTAX.md §`<~`
// requires (an iteration-resume effect, not a Mutate event). The graph
// epoch IS the one cache; there is no separate cache layer. project_-
// queue_merger handles the OracleQuery ops the surfaces (voice) perform.
//
// This composition exhibits ALL FIVE verbs at the project level:
//   |>  source through frontend |> infer_program |> ... |> emit
//   <|  source borrowed to four surface projections (cursor_session)
//   ><  multi-module parallel composition
//   ~>  handler stack — diagnostics outermost, project_queue_merger
//        projecting the queue over the checked program
//   <~  IC fixpoint closing on queue stability (memoized by graph epoch)
//
// `mentl edit` IS this loop running. There is no separate `compile`
// — the edit IS the compile IS the projection IS the loop closing.

fn ic_compile_loop(initial_entry) with IC + !Mutate = {
  initial_entry
    |> driver_check
    ~> project_queue_merger
      <~ accumulate(empty_queue())
}

// frontend — lex |> parse

fn frontend(source) = {
  source
    |> lex
    |> parse_program
}

// env_handler — scoped binding stack (spec 04)
// Peer of graph_handler. One writer (inference). Scoping via
// mark-and-truncate: enter pushes len(entries); exit truncates to
// that mark. Functional; no mutable pointers.

handler env_handler with entries = [], scopes = [] {

  env_lookup(name) =>
    resume(env_find(entries, name)),

  env_snapshot() =>
    resume(Env(entries)),

  env_extend(name, scheme, reason, kind) =>
    resume()
      with entries = [(name, scheme, reason, kind)] ++ entries,

  env_scope_enter() =>
    resume()
      with scopes = [len(entries)] ++ scopes,

  env_scope_exit() =>
    if len(scopes) == 0 { resume() }
    else {
      let mark = list_head(scopes)
      resume()
        with entries = take_last(entries, mark),
             scopes = list_tail(scopes)
    }
}

fn env_find(entries, name: String) = {
  if len(entries) == 0 { None }
  else {
    let (k, scheme, reason, kind) = list_head(entries)
    if k == name { Some((scheme, reason, kind)) }
    else { env_find(list_tail(entries), name) }
  }
}

fn take_last(lst, n) = {
  if len(lst) <= n { lst }
  else { take_last(list_tail(lst), n) }
}

// body_context — H1 emit-time per-fn-body metadata
// Set at emit_fn_body entry; read by LEvPerform's offset arithmetic
// (offset = 8 + 4*captures + 4*slot_idx within __state) and by any
// future evidence-aware emit site. Each fn-body emission resets the
// state via set_*; reads return the most recent set.

handler body_context with captures = 0, evidence = [] {
  current_body_captures()    => resume(captures),
  set_body_captures(n)       => resume() with captures = n,
  current_body_evidence()    => resume(evidence),
  set_body_evidence(ev)      => resume() with evidence = ev
}

// wasi_filesystem — FS substrate (IC prerequisite)
// Four-arm stateless handler delegating to runtime/io.mn primitives.
// Grants Filesystem capability to IC's cache layer. Installed in
// `compile`'s ~> chain between wat_stdout and the compiler-internal
// handlers — fs stays a driver-level capability, not something the
// compiler's own code accidentally reaches for.
//
// Audit implications: a function that doesn't reach fs_* ops proves
// `with !Filesystem`; audit-driven linker severance drops path_open
// / fd_close / path_create_directory / path_filestat_get imports
// from that binary. DESIGN.md 10.3 capability severance realized.

handler wasi_filesystem {
  fs_exists(path)                => resume(fs_exists_impl(path)),
  fs_read_file(path)             => resume(fs_read_file_impl(path)),
  fs_write_file(path, bytes)     => {
    fs_write_file_impl(path, bytes)
    resume()
  },
  fs_mkdir(path)                 => {
    fs_mkdir_impl(path)
    resume()
  },
  // FX.A.basics arms (per FX walkthrough §2.2)
  fs_open(path)                  => resume(fs_open_impl(path)),
  fs_close(fd)                   => {
    fs_close_impl(fd)
    resume()
  },
  fs_unlink(path)                => resume(fs_unlink_impl(path)),
  fs_rename(old_p, new_p)        => resume(fs_rename_impl(old_p, new_p))
}

// lookup_ty_graph — GraphRead → LookupTy bridge (spec 05)
// The ONLY LookupTy handler in Phase 1. Declares GraphRead
// (inherited from the outer graph_handler). Unresolved handles emit
// E_UnresolvedType; error holes emit a sentinel that lowering/emit translates
// to a WASM unreachable trap.

handler lookup_ty_graph {

  lookup_ty(h) => {
    let GNode(kind, reason) = graph_chase(h)
    match kind {
      NBound(t)        => resume(t),
      NErrorHole(_)    => resume(TName("ERROR_HOLE", [])),
      NFree(epoch) => {
        // Carry the handle, read its span LIVE. The node's Reason already
        // proves WHERE this handle was minted (its caret) — reporting at
        // span_zero discards the truth the graph holds. The Why projection in
        // proto form: a diagnostic positions itself by the graph, not 0:0.
        report(EUnresolvedType(h, epoch, caret_span_from_reason(reason)))
        resume(TName("UNRESOLVED", []))
      },
      NRowBound(_)     => resume(TUnit),
      NRowFree(_)      => resume(TUnit)
    }
  }
}

// diagnostics_handler — stderr routing (spec 06)
// The sandbox boundary. Outermost in every route. Declares
// `with !Diagnostic` so its own arms cannot recursively perform
// report — structural gate via spec 01's algebra.

handler diagnostics_handler {

  report(diag) => {
    // Every surface is a PROJECTION of the one DiagKind — source, code,
    // severity-class, message, span, applicability are read live, never
    // copied. The stderr line and the IDE hover are the same graph read.
    eprint_string("{diag_source(diag)}: {diag_code(diag)} {diag_kind(diag)}: {diag_message(diag)} at {show_span(diag_span(diag))}\n")
    resume()
  }
}

// FreshHandle — two handlers, same function
// Inference mints via graph_fresh_ty (stored in graph); query mints
// display ids (ephemeral, for rendering). Both satisfy FreshHandle.

handler fresh_for_inference {
  mint(reason) => {
    let h = graph_fresh_ty(reason)
    resume(h)
  }
  mint_row(reason) => {
    let h = graph_fresh_row(reason)
    resume(h)
  }
}

handler fresh_for_query with next_display = 0 {
  mint(_reason) =>
    resume(next_display)
      with next_display = next_display + 1
  mint_row(_reason) =>
    resume(next_display)
      with next_display = next_display + 1
}

// Collection helpers — consumed by teach / audit

// Per-fn gradient projection. Each FnStmt's teach_gradient is
// independent of siblings (no shared state mutation among reads).
// parallel_map dispatches via the Thread effect handler; on a multi-
// core host with parallel_compose installed, the N functions' gradients
// compute on N threads. Same source, handler swap.
fn collect_gradients(ast) = {
  ast
    |> parallel_map((node) => {
         let N(body, _, handle) = node
         match body {
           NStmt(FnStmt(name, _, _, _, _)) =>
             [(name, teach_gradient(handle))],
           _ => []
         }
       })
    |> flatten
}

fn render_gradients(gradients) = {
  if len(gradients) == 0 {
    "All functions are at maximum annotation density.\n"
  } else {
    gradients
      |> map((entry) => {
           let (name, result) = entry
           "{name}: {render_gradient_result(result)}\n"
         })
      |> fold("", (acc, line) => acc ++ line)
  }
}

fn render_gradient_result(result) = match result {
  None => "(no next-step annotation suggested)",
  Some(suggestion) => {
    let AnnotationSuggestion(_kind, ann_text, unlocks, _reason) = suggestion
    "→ add {ann_text} to unlock {join_unlock_labels(unlocks)}"
  }
}

fn join_unlock_labels(labels) with Pure = {
  if len(labels) == 0 { "(no capabilities)" }
  else {
    let first = head(labels)
    let rest = tail(labels)
    fold(rest, first, (acc, label) => acc ++ ", " ++ label)
  }
}

// Per-fn audit projection. Each FnStmt's row + capability set is
// independently computable from its handle's graph state. parallel_map
// dispatches via Thread; spatial dispatch lights up cores per N fns.
fn collect_fn_rows(ast) = {
  ast
    |> parallel_map((node) => {
         let N(body, _, handle) = node
         match body {
           NStmt(FnStmt(name, _, _, _, _)) =>
             [build_audit_report(name, lookup_ty(handle))],
           _ => []
         }
       })
    |> flatten
}

// H5: AuditReport record per fn — the structured projection Mentl's
// IDE surfaces (Proof Lens, Gradient ghost text, JSON export). Each
// field is independently introspectable; the record shape lets new
// metadata land additively (per CLAUDE.md insight 9).
//
// Fields (sorted alphabetically per parser invariant):
//   fn_name     — the function's identifier
//   reached     — effects the body actually performs ([EffName])
//   row_str     — pre-rendered row for terminal output
//   severable   — effects NOT in body that could be added as !E
//                 ([EffName], each unlocking capabilities)
//   unlocks     — capabilities gained from severing every severable
fn build_audit_report(fn_name, ty) = {
  let body_row = extract_row(ty)
  let reached = row_names(body_row)
  let severable = severance_candidates(reached)
  let unlocks = severance_unlocks(severable)
  {fn_name: fn_name, reached: reached, row_str: show_effrow(body_row),   // drift-audit: ignore — drift-1 heuristic false-positive on record field punning where field name matches value identifier; record literal, not vtable
   severable: severable, unlocks: unlocks}
}

// Severance candidates: the canonical effects (Alloc / IO / Network)
// that the body does NOT perform. Adding `!E` for each unlocks a
// capability without breaking the row.
fn severance_candidates(reached) = {
  let canonical = [ENamed("Alloc"), ENamed("IO"), ENamed("Network")]   // drift-audit: ignore — real drift 8 (EffName should have EAlloc/EIO/ENetwork variants); tracked for item 11.B EffName refactor
  filter_not_in(canonical, reached, 0, len(canonical), [])
}

fn filter_not_in(candidates, present, i, n, acc) = {
  if i >= n { acc }
  else {
    let c = list_index(candidates, i)
    let next = if name_in_list(present, c) { acc }
               else { acc ++ [c] }   // drift-audit: ignore — real drift 11 on small canonical-3-effect list; buffer-counter conversion requires adding Memory+Alloc to fn row rippling through audit walk; tracked for item 11.B buffer-counter sweep
    filter_not_in(candidates, present, i + 1, n, next)
  }
}

fn name_in_list(names, target) = {
  name_in_list_loop(names, target, 0, len(names))
}

fn name_in_list_loop(names, target, i, n) = {
  if i >= n { false }
  else if list_index(names, i) == target { true }   // structural fold-eq, not the hand-rolled twin
  else { name_in_list_loop(names, target, i + 1, n) }
}

fn severance_unlocks(severable) = {
  severance_unlocks_loop(severable, 0, len(severable), [])
}

fn severance_unlocks_loop(severable, i, n, acc) = {
  if i >= n { acc }
  else {
    let caps = capabilities_for_severance(list_index(severable, i))
    severance_unlocks_loop(severable, i + 1, n, acc ++ caps)
  }
}

// Terminal renderer over AuditReport records — reads fields by name.
// JSON / IDE-projection renderers are peer functions on the same
// record (one substrate, multiple projections per CLAUDE.md insight 8).
fn render_audit(entries) = {
  if len(entries) == 0 { "" }
  else {
    let report = list_head(entries)
    let header = "{report.fn_name} : {report.row_str}\n"
    let severance_section =
      if len(report.severable) == 0 { "" }
      else {
        "  severable: {show_list(report.severable, show_eff_name, " + ")} — unlocks {show_list(report.unlocks, show_capability, ", ")}\n"
      }
    "{header}{severance_section}{render_audit(list_tail(entries))}"
  }
}

// Query rendering — delegates to query.mn for Question parsing

fn render_query_result(result) = match result {
  QRType(ty, reason) => "→ {show_type(ty)}\n  Reason: {show_reason(reason)}",
  QRUnresolved(entries) => "→ {int_to_str(len(entries))} unresolved entries",
  QRChain(hops) => "→ {int_to_str(len(hops))} hops in chain",
  QREffects(row) => "→ {show_effrow(row)}",
  QROwnership(params) => "→ {int_to_str(len(params))} params",
  QRWhy(reason) =>
    show_reason(reason),
  QRVerifyDebt(obligations) => "→ {int_to_str(len(obligations))} verification obligations pending",
  QRFlowLabel(label, reason) =>
    "→ {show_flow_label(label)}\n  Reason: {show_reason(reason)}",
  QRError(msg) => "error: {msg}"
}

// show_flow_label — defined in types.mn alongside flow_join/flow_le.

// The query surface is a tiny grammar: <verb> [arg]. The query strings are
// unavoidable external input (like LSP method strings, lsp.mn classify_method)
// — projected to the QueryVerb ADT at ONE boundary (classify_query_verb),
// downstream ADT-only. build_question reads the verb structurally and pairs it
// with its argument arity; no nested string-literal cascade scattered across
// arities (drift 8). An ill-formed query is QUnknown(q) — the honest Silence,
// never a fabricated Question.

type QueryVerb
  = QVType | QVEffects | QVOwnership | QVWhy | QVRefs | QVProvider
  | QVUnresolved | QVVerification | QVFlow | QVUnknownVerb

fn classify_query_verb(w) with Pure = {
  if      w == "type"         { QVType }
  else if w == "effects"      { QVEffects }
  else if w == "ownership"    { QVOwnership }
  else if w == "why"          { QVWhy }
  else if w == "refs"         { QVRefs }
  else if w == "provider"     { QVProvider }
  else if w == "unresolved"   { QVUnresolved }
  else if w == "verification" { QVVerification }
  else if w == "flow"         { QVFlow }
  else                        { QVUnknownVerb }
}

fn parse_query_string(q) = {
  match split(q, " ") {
    []       => QUnknown(q),
    [w0]     => build_question(classify_query_verb(w0), "", q),
    [w0, w1] => build_question(classify_query_verb(w0), w1, q),
    _        => build_question(classify_query_verb(query_head(split(q, " "))),
                               query_last(split(q, " ")), q)
  }
}

// build_question — pair the classified verb with its argument. Nullary verbs
// (unresolved/verification) ignore the arg; unary verbs carry it. A verb whose
// arity its arg cannot satisfy projects to QUnknown(raw) — the honest unknown.
fn build_question(verb, arg, raw) with Pure = match verb {
  QVUnresolved   => QUnresolved,
  QVVerification => QVerifyDebt,
  QVType         => QTypeOf(arg),
  QVEffects      => QEffects(arg),
  QVOwnership    => QOwnership(arg),
  QVWhy          => QWhy(arg),
  QVRefs         => QRefsOf(arg),
  QVProvider     => QHandlerProvider(arg),
  QVFlow         => QFlowOf(arg),
  QVUnknownVerb  => QUnknown(raw)
}

fn query_head(ws) with Pure = if len(ws) == 0 { "" } else { list_head(ws) }

fn query_last(ws) with Pure =
  if len(ws) == 0 { "" } else { list_index(ws, len(ws) - 1) }
