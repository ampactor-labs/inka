// pipeline.mn — the compiler's spine (spec 04 · 05 · 06 · 10)
//
// One file; five entry points; each a `|>` + `~>` topology. The `|>`
// chain IS the stages. The `~>` chain IS the capability stack —
// outermost least trusted, innermost most empowered. The shape of
// this file IS the compiler's architecture.
//
//   compile(src)  →  WAT bytes
//   check(src)    →  diagnostics (no lowering, no emit)
//   query(src,q)  →  structured answer
//   teach(src)    →  gradient recommendation
//   audit(src)    →  capability set + severance suggestions
//
// Each route shares the same substrate handlers — graph, env,
// diagnostics, lookup_ty_graph — and adds route-specific ones.
// Source is never re-inferred across routes; the graph is one.
//
// This file declares two handlers it OWNS:
//   env_handler         — scoped binding stack (spec 04)
//   lookup_ty_graph     — bridge GraphRead → LookupTy (spec 05)
//   diagnostics_handler — stderr diagnostic routing (spec 06)
//
// Every other handler is imported from its owner module:
//   graph_handler       → graph.mn
//   verify_ledger       → verify.mn
//   mentl_default       → mentl.mn
//   query_default       → query.mn
//   affine_ledger       → own.mn
//   clock_real, tick_real, sample_real, deadline_real → clock.mn

import graph
import types
import effects
import infer
import lower
import backends/wasm
import lexer
import parser
import own
import verify
import mentl
import query
import dsp/clock
import driver

// The spine — entry points as |> + ~> topology
// Read top-to-bottom: source flows DOWN through `|>`; handlers wrap
// OUTWARD through `~>`. Outermost handler is the sandbox boundary.
//
// IC.4: compile / check now route through driver_check when invoked
// with an entry-MODULE name. The single-source entry compile/
// check_source remain for tests that pass a raw source string. The
// driver path reads module sources via FS and infers each in
// dependency order; within-run incrementality IS the epoch cursor
// (§2 cached-cursor mode), and cross-run skip is the image-persist
// peer (Hβ.persist.module-image-cache).

fn compile(entry_module) = {
  {
    // driver_check_entry infers the deps DAG + the entry ONCE and returns
    // the entry's already-typed AST — compile lowers that live graph, no
    // second fs_read / frontend / infer_program (Carried-Truth: the entry
    // is proven once and read live, never re-derived).
    entry_module |> driver_compile_entry |> saturate_pass |> lower_program |> reachable_from_main |> executable_gate |> emit_module
  }
    ~> wat_stdout
    ~> wasi_filesystem       // FS — per-file byte I/O for driver / cache
    ~> string_table          // W5 — compile-time interned string offsets
    ~> emit_memory_bump      // swap for emit_memory_arena to prove surface
    ~> body_context          // H1 — per-fn-body emit metadata
    ~> mentl_default
    ~> affine_ledger
    ~> region_tracker        // I12 — region-escape ledger (substrate prep)
    ~> verify_ledger
    ~> lower_scope
    ~> arm_state_ctx([], OneShot, "")
    ~> lookup_ty_graph
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> parallel_compose
    ~> wasi_threads
    ~> diagnostics_handler
}

// Per Hβ.first-light.compile-stdin-substrate (2026-05-09): canonical
// stdin-source compile path. Per Unix vocabulary `mentl compile -`
// reads source from stdin. Skips driver_check + fs_read_file (no
// module-graph; no path); reads the entire stdin via read_stdin
// (lib/runtime/io.mn:83 — fd_read loop with grow-on-headroom buffer);
// pipes through frontend → lower_program → emit_module. Same handler
// chain as compile() — emission to stdout via wat_stdout, all the
// substrate handlers attached.
//
// L1 fixpoint requires this path: seed compiles wheel → mentl2.wat;
// mentl2 reads stdin (the wheel input) → emits mentl3.wat. Both passes
// produce byte-identical output when the wheel-source emit is
// deterministic AND substrate-aligned across seed + wheel.
// THE EXECUTABLE GATE (SYNTAX §«Partial application» — a hole is productive,
// never executable; §0's "nothing executes unproven" at its honest scope).
// Runs BETWEEN reachability and emit — wat_stdout streams every emit
// immediately, so the refusal must precede the first one; refusing here
// leaves stdout with ZERO WAT bytes. Two reads, one law each:
//   HOLES REFUSE. An authored value-position hole surviving in the
//   reachable tree (collect_value_holes_decls — call-arg holes became
//   partial params, pipe holes were spliced, so survival IS value-position;
//   a hole in pruned dead code never reaches this walk) reports
//   E_UnresolvedHole at its authored span and the compile exits 1 —
//   diagnostics on stderr, no module. Typed absence is not a value.
//   HONEST DEBT SURFACES — and compiles. V_Pending is the sound-incomplete
//   NORMAL state (§4/§5: undecidable residue accrues, never assume-true);
//   the wheel's own self-compile carries obligations that are structurally
//   undecidable without the SMT handler swap, so refusing on pending would
//   refuse the medium itself (the fleet's measured refutation of the
//   blanket form). The ledger projects one summary diagnostic; the
//   per-entry projections stay query/edit surfaces.
// `check` never routes here — the productive surfaces admit holes; only an
// EXECUTABLE refuses to exist around one.
fn executable_gate(lowered) = {
  report_verify_debt(verify_debt())   // drift-audit: ignore — sequenced effectful ledger read, projected before emit
  let holes = collect_value_holes_decls(lowered)
  // The ARMED classes, read LIVE off the ledger the diagnostics handler keeps
  // (diag_refuses names them; a class arms only when the wheel's own census of it
  // is zero, so this can never refuse the medium). The hole gate was this law
  // with one arm; these are its others. Productive at the walk, refusing at the
  // boundary — SYNTAX's "a hole is productive, never executable", generalized.
  let refused = diag_refusals()   // drift-audit: ignore — sequenced effectful ledger read, guarding the emit (the verify_debt read above is the same shape)
  if len(holes) == 0 && refused == 0 { lowered }
  else {
    report_holes(holes, 0)
    if refused > 0 {
      eprint_string("mentl: refusing to emit — {int_to_str(refused)} claim(s) the medium could not discharge\n")
    }
    proc_exit(1)
    // proc_exit never returns (the emit appends unreachable after it);
    // the tail value only closes the type of the branch.
    lowered
  }
}

fn report_holes(holes, i) =
  if i >= len(holes) { () }
  else {
    let h = list_index(holes, i)
    // The weave span — the parse truth authored_hole itself proved; the
    // reason-chain span is clobbered by the binder's unification.
    report(EUnresolvedHole(h, parse_span_of(h)))
    report_holes(holes, i + 1)
  }

fn compile_stdin() = {
  read_stdin() |> frontend |> infer_program |> saturate_pass |> lower_program |> reachable_from_main |> executable_gate |> emit_module
}
    ~> wat_stdout
    ~> wasi_filesystem
    ~> string_table
    ~> emit_memory_bump
    ~> body_context
    ~> mentl_default
    ~> affine_ledger
    ~> region_tracker
    ~> verify_ledger
    ~> lower_scope
    ~> arm_state_ctx([], OneShot, "")
    ~> lookup_ty_graph
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> parallel_compose
    ~> wasi_threads
    ~> diagnostics_handler

// pipeline_check returns its own ERROR COUNT, because it owns the handler that
// does the counting (the diagnostics_handler at the foot of this chain).
//
// The read has to live HERE, and finding that out cost a build: check_run tried
// to read diag_errors() from its own outer install and always got 0. That is
// innermost-wins working exactly as documented — every report performed inside
// this chain is caught by THIS handler, so the outer one never sees them and its
// tally is honestly zero. The count and the counter are one handler; a reader
// outside the install is reading a different ledger.
fn pipeline_check(entry_module) = {
  {
    driver_check(entry_module)
    diag_errors()
  }
    ~> wasi_filesystem
    ~> mentl_default
    ~> affine_ledger
    // The region ops infer_fn performs (check_escape at every return) need
    // their handler in CHECK mode too — this chain lacked the install, so
    // every region op ran DRIVERLESS with a zero state record, and
    // region_index_get(0, …) read the zero-filled sentinel page as an empty
    // bucket: check "worked" on garbage until list_index's bounds trap
    // unmasked it (the probe: idx=0 len=0). Check runs the same analyses as
    // compile; its chain installs the same analysis handlers.
    ~> region_tracker
    ~> verify_ledger
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> parallel_compose
    ~> wasi_threads
    ~> diagnostics_handler
}

// Legacy single-source entry — for tests that pass raw source
// without filesystem layout. No caching; full re-infer each call.
fn compile_source(source) = {
  source
    |> frontend
    |> infer_program
    |> lower_program
    |> reachable_from_main
    |> executable_gate
    |> emit_module
    ~> wat_stdout
    ~> string_table
    ~> emit_memory_bump
    ~> body_context
    ~> mentl_default
    ~> affine_ledger
    ~> region_tracker
    ~> verify_ledger
    ~> lower_scope
    ~> arm_state_ctx([], OneShot, "")
    ~> lookup_ty_graph
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> parallel_compose
    ~> wasi_threads
    ~> diagnostics_handler
}

fn check_source(source) = {
  source
    |> frontend
    |> infer_program
    ~> mentl_default
    ~> affine_ledger
    // Same law as pipeline_check: infer_fn performs region ops, so every
    // infer-reaching chain installs region_tracker — driverless region ops
    // read a zero state record (the sentinel page masked it until the
    // bounds trap; the edit-session fixtures were this chain's proof).
    ~> region_tracker
    ~> verify_ledger
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> parallel_compose
    ~> wasi_threads
    ~> diagnostics_handler
}

fn query(entry_module, question) = {
  {
    // driver_check_entry loads the module + its deps, infers ONCE, and
    // hands back the entry's typed AST — the same load compile/check
    // use. So `mentl query lib/foo "why bar"` reads the REAL graph, not
    // the module NAME parsed as source (Carried-Truth: the driver
    // already resolved+typed it; re-frontend-ing a name re-derived
    // nothing and mis-parsed "tutorial/foo" as two variable refs).
    let ast = driver_check_entry(entry_module)
    let q = parse_query_string(question)
    ask(q) |> render_query_result |> print_string
  }
    ~> wasi_filesystem       // driver_check_entry's fs_read — handled in-chain, as compile/check do
    ~> query_default
    ~> mentl_default
    ~> affine_ledger
    ~> region_tracker
    ~> verify_ledger
    ~> arm_state_ctx([], OneShot, "")
    ~> lookup_ty_graph
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> parallel_compose
    ~> wasi_threads
    ~> diagnostics_handler
}

// analyze_fns — the shared analysis-verb cursor: load+check the module,
// project each fn decl with `project(name, handle)`, render, print. audit
// and teach ARE this cursor at two projections — the check handler chain and the
// load → map_fn_stmts → render → print skeleton lived twice, byte-identical
// but for the project/render pair (Carried-Truth: one home now). query
// stays separate: it ASKS a question, not a per-fn walk.
fn analyze_fns(entry_module, project, render) = {
  {
    let ast = driver_check_entry(entry_module)
    map_fn_stmts(ast, project) |> render |> print_string
  }
    ~> wasi_filesystem       // driver_check_entry's fs_read — handled in-chain, as compile/check do
    ~> mentl_default
    ~> affine_ledger
    ~> region_tracker
    ~> verify_ledger
    ~> arm_state_ctx([], OneShot, "")
    ~> lookup_ty_graph
    ~> env_handler
    ~> graph_handler
    ~> mutate_sink
    ~> parallel_compose
    ~> wasi_threads
    ~> diagnostics_handler
}

fn teach(entry_module) =
  analyze_fns(entry_module, (name, handle) => (name, teach_gradient(handle)), render_gradients)

fn audit(entry_module) =
  analyze_fns(entry_module, (name, handle) => build_audit_report(name, lookup_ty(handle)), render_audit)

// ─── cursor_session_batch — `<|` fanout from one source to four projections ──
//
// One source borrowed (read-only) to four cursor projections — check
// surfaces diagnostics; teach surfaces gradient steps; query answers
// structured questions; audit surfaces capability-severance suggestions.
// All four read the SAME inferred graph; the AST is borrowed via `<|`
// to each branch; outputs tuple together.
//
// `<|` here proves the cursor's eight-aspect projection AT THE
// PIPELINE level: a single edit triggers four canonical surfaces
// simultaneously — exactly what `mentl edit` does at the IDE layer.
// The seed parser handles `<|` per Hβ.first-light.handle-expr-with-
// clause-substrate; the lower-side parallelism dispatches via the
// Thread effect handler installed upstream (single-thread sequential
// default; WasiThreads spawn in production per
// protocol_parallelism_symmetry.md).
//
// Renamed from `cursor_session` 2026-05-07 to disambiguate from
// `cursor_session` (cursor_transport.mn) — that one opens the bus-
// compressor loop with a Caret; this one runs the four batch
// projections from one source string. Different shapes; same family.
//
// Drift refused: 9 (no deferred surface — all four bodied here);
// 6 (none of the surfaces is primitive special-case; uniform branches);
// 7 (output is a 4-tuple, not parallel-arrays).

fn cursor_session_batch(source) = {
  let (diagnostics, gradients, audit_report, query_default_view) =
    source
      <| (
        (s) => check_source(s),
        (s) => teach(s),
        (s) => audit(s),
        (s) => query(s, "type main")
      )
  CursorSessionResult({diagnostics, gradients, audit_report, query_default_view})
}

type CursorSessionResult
  = CursorSessionResult({
      diagnostics:        String,
      gradients:          String,
      audit_report:       String,
      query_default_view: String
    })

// ─── Multi-module compilation — map over a module list ──────────────
//
// `compile_pair_modules` (binary special-case) was erased per
// `feedback_fully_as_early.md`: the driver's topological-layer walk
// (`Hβ.driver.level-set-par-walk`, layer partition live in driver.mn)
// composes each dep-independent layer as `map(compile, layer)`; the
// multi-core half is a `><` fanout under `~> Thread` at the layer
// site (Hβ.lower.schedule-specialized-callee). Render targets attach
// via `~>` to the per-module wat output. Drift 6 erasure.

// ─── ic_compile_loop — `<~` feedback closing on queue stability ───────
//
// Build IS the `<~` loop closing at fixpoint (PLAN §2). Every source
// change bumps the graph epoch at the outermost commit (graph_mutated,
// graph.mn); project_queue_merger re-projects the oracle queue live
// (memoized by that epoch — one re-projection per real change); the
// cursor surfaces the highest-priority residue. The cycle converges when
// the projection stops changing — the project at the gradient's top.
//
// `<~` runs under IC — the Iterate-class context SYNTAX.md §`<~`
// requires (an iteration-resume effect, not a Mutate event). The graph
// epoch IS the one cache; there is no separate cache layer. project_-
// queue_merger handles the OracleQuery ops the surfaces (voice) perform.
//
// This composition exhibits ALL FIVE verbs at the project level:
//   |>  source through frontend |> infer_program |> ... |> emit
//   <|  source borrowed to four surface projections (cursor_session)
//   ><  multi-module parallel composition
//   ~>  handler stack — diagnostics outermost, project_queue_merger
//        projecting the queue over the checked program
//   <~  IC fixpoint closing on queue stability (memoized by graph epoch)
//
// `mentl edit` IS this loop running. There is no separate `compile`
// — the edit IS the compile IS the projection IS the loop closing.

fn ic_compile_loop(initial_entry) with IC + !Mutate = {
  initial_entry
    |> driver_check
    ~> project_queue_merger
      <~ accumulate(empty_queue())
}

// frontend — lex |> parse

fn frontend(source) = {
  source
    |> lex
    |> parse_program
}

// env_handler — scoped binding stack (spec 04)
// Peer of graph_handler. One writer (inference). Scoping via
// mark-and-truncate: enter pushes len(entries); exit truncates to
// that mark. Functional; no mutable pointers.

// FLAT-BUFFER env (the graph handler's own substrate pattern: "flat
// buffer + length counter, not a linked list"). The snoc-chain form
// scanned via last/drop_last — a 16-byte slice mint PER STEP over
// 2,500+ entries, at EVERY name resolution, with top-level names
// (pre-registered first) always at full scan depth: the env was the
// infer phase's dominant allocator. Now: extend = one write + count
// bump (amortized-doubling growth); scope-exit = count := mark, O(1),
// no truncation walk; lookup = a backward index-walk over the flat
// buffer, ZERO allocation. Shadowing is position, exactly as before.
// ── O(1) env resolution — the str_hash-bucket index (§5.O layer 2) ──────────
// A binding is an edge env_extend DREW; env_find_flat RE-DERIVES it by a backward
// by-name linear scan — O(n²) over the compile, the convergent hot path (§5.O).
// The index reads the edge in O(1): a 4096-bucket str_hash array over the flat
// buffer, each bucket a prepended list of (name, position). env_resolve returns
// the first LIVE (position < count) binding — env_find_flat's latest-wins result,
// byte-identical, O(1) amortized. Carried-Truth: read the handle, never re-scan.
fn env_index_new() with Memory + Alloc = list_filled(4096, [])

fn env_index_add(idx, name: String, pos) with Memory + Alloc = {
  let b = i32_and(str_hash(name), 4095)
  list_set(idx, b, [(name, pos)] ++ list_index(idx, b))
}

// The first (name, pos) with pos < count — the latest LIVE binding position, or
// -1. Prepended latest-first, so index 0 is the newest.
fn env_bucket_pos(ref bucket, name: String, count, i, n) with Memory = {
  if i >= n { -1 }
  else {
    let (bn, pos) = list_index(bucket, i)
    if pos < count && bn == name { pos }
    else { env_bucket_pos(bucket, name, count, i + 1, n) }
  }
}

// Resolve via the index; re-validate against the BUFFER name, because scope_exit
// can reuse a position and stale a bucket entry — fall back to the linear scan
// for that rare case (byte-identical either way).
fn env_resolve(ref buf, count, ref idx, name: String) with Memory = {
  let b = i32_and(str_hash(name), 4095)
  let bucket = list_index(idx, b)
  let pos = env_bucket_pos(bucket, name, count, 0, len(bucket))
  if pos < 0 { None }
  else {
    let (bn, scheme, reason, kind) = list_index(buf, pos)
    if bn == name { Some((scheme, reason, kind)) }
    else { env_find_flat(buf, count, name) }
  }
}

// The TYPE-position read. One env, one namespace of entries; the KIND is the
// namespace discriminator (an effect decl and a type alias may share a name —
// `effect Sample` + `type Sample = Float where …` are both canonical). A type
// position (quantify_ctor_ty — every annotation surface) wants the newest
// TYPE-BEARING entry: an alias-schemed Forall (the only transparent kind) or a
// nominal record's RecordSchemeKind. The plain lookup returns the newest entry
// of ANY kind, so a later-registered effect decl shadows the alias and the
// annotation bakes a bare nominal TName that never unifies with its base.
fn env_entry_is_type(ref scheme, ref kind) with Pure =
  match scheme {
    Forall(_, TAlias(_, _)) => true,
    _ => match kind { RecordSchemeKind(_) => true, _ => false }
  }

fn env_bucket_type_pos(ref buf, ref bucket, name: String, count, i, n) with Memory = {
  if i >= n { -1 }
  else {
    let (bn, pos) = list_index(bucket, i)
    if pos < count && bn == name {
      let (en, scheme, _, kind) = list_index(buf, pos)
      if en == name && env_entry_is_type(scheme, kind) { pos }
      else { env_bucket_type_pos(buf, bucket, name, count, i + 1, n) }
    }
    else { env_bucket_type_pos(buf, bucket, name, count, i + 1, n) }
  }
}

fn env_resolve_type(ref buf, count, ref idx, name: String) with Memory = {
  let b = i32_and(str_hash(name), 4095)
  let bucket = list_index(idx, b)
  let pos = env_bucket_type_pos(buf, bucket, name, count, 0, len(bucket))
  if pos < 0 { None }
  else {
    let (_, scheme, reason, kind) = list_index(buf, pos)
    Some((scheme, reason, kind))
  }
}

handler env_handler with entries_buf = make_list(1024), entries_count = 0, scopes = [], index = env_index_new() {

  env_lookup(name) =>
    resume(env_resolve(entries_buf, entries_count, index, name)),

  env_lookup_type(name) =>
    resume(env_resolve_type(entries_buf, entries_count, index, name)),

  env_snapshot() =>
    // Snapshots copy the live prefix — rare (module boundaries), and a
    // snapshot that aliased the mutable buffer would be the stale-read lie.
    resume(Env(slice(entries_buf, 0, entries_count))),

  env_extend(name, scheme, reason, kind) => {
    let grown =
      if entries_count >= len(entries_buf) {
        list_copy_into(entries_buf, make_list(len(entries_buf) * 2), 0, entries_count)
      } else { entries_buf }
    resume()
      with entries_buf = list_set(grown, entries_count, (name, scheme, reason, kind)),
           entries_count = entries_count + 1,
           index = env_index_add(index, name, entries_count)
  },

  env_scope_enter() =>
    resume()
      with scopes = scopes ++ [entries_count],   // drift-audit: ignore — O(1) mark push, one per scope enter, popped by scope exit

  env_scope_exit() =>
    if len(scopes) == 0 { resume() }
    else {
      let mark = last(scopes)
      resume()
        with entries_count = mark,
             scopes = drop_last(scopes)
    }
}

fn env_find_flat(ref buf, count, name: String) = {
  if count == 0 { None }
  else {
    let (k, scheme, reason, kind) = list_index(buf, count - 1)
    if k == name { Some((scheme, reason, kind)) }
    else { env_find_flat(buf, count - 1, name) }
  }
}

// body_context — H1 emit-time per-fn-body metadata
// Set at emit_fn_body entry; read by LEvPerform's offset arithmetic
// (offset = 8 + 4*captures + 4*slot_idx within __state) and by any
// future evidence-aware emit site. Each fn-body emission resets the
// state via set_*; reads return the most recent set.

handler body_context with captures = 0, evidence = [] {
  current_body_captures()    => resume(captures),
  set_body_captures(n)       => resume() with captures = n,
  current_body_evidence()    => resume(evidence),
  set_body_evidence(ev)      => resume() with evidence = ev
}

// wasi_filesystem — FS substrate (IC prerequisite)
// Four-arm stateless handler delegating to runtime/io.mn primitives.
// Grants Filesystem capability to the driver's module reads. Installed in
// `compile`'s ~> chain between wat_stdout and the compiler-internal
// handlers — fs stays a driver-level capability, not something the
// compiler's own code accidentally reaches for.
//
// Audit implications: a function that doesn't reach fs_* ops proves
// `with !Filesystem`; audit-driven linker severance drops path_open
// / fd_close / path_create_directory / path_filestat_get imports
// from that binary. DESIGN.md 10.3 capability severance realized.

handler wasi_filesystem {
  fs_exists(path)                => resume(fs_exists_impl(path)),
  fs_read_file(path)             => resume(fs_read_file_impl(path)),
  fs_write_file(path, bytes)     => {
    fs_write_file_impl(path, bytes)
    resume()
  },
  fs_mkdir(path)                 => {
    fs_mkdir_impl(path)
    resume()
  },
  // FX.A.basics arms (per FX walkthrough §2.2)
  fs_open(path)                  => resume(fs_open_impl(path)),
  fs_close(fd)                   => {
    fs_close_impl(fd)
    resume()
  },
  fs_unlink(path)                => resume(fs_unlink_impl(path)),
  fs_rename(old_p, new_p)        => resume(fs_rename_impl(old_p, new_p))
}

// lookup_ty_graph — GraphRead → LookupTy bridge (spec 05)
// The ONLY LookupTy handler in Phase 1. Declares GraphRead
// (inherited from the outer graph_handler). Free and error-hole handles
// resume TVar(h) — the honest word floor every consumer reads; a width a
// site genuinely needs detonates at emit's loud floors, never here.

handler lookup_ty_graph {

  lookup_ty(h) => {
    let GNode(kind, reason) = graph_chase(h)
    match kind {
      NBound(t)        => resume(t),
      // An error hole / free var resumes TVar(h) — CARRY THE HANDLE. The
      // prior TName("ERROR_HOLE")/TName("UNRESOLVED") sentinels fabricated
      // a NOMINAL type for a node the graph proves is unresolved: every
      // downstream type-directed read then trusted the lie — the eq
      // dispatch minted a structural-sum helper $eq_nUNRESOLVED that read
      // a raw Int operand as a variant pointer (memory at address 44100 as
      // a tag word). TVar(h) is the truth: repr_of reads the word floor,
      // fold_sig reads "i", eq reads word identity — the honest
      // productive-under-error floor at every consumer, no second sentinel
      // channel. (A quantified var's == at a GENERIC body is word identity
      // by the same floor; the type-directed eq for a generic operand at
      // its instantiated width is the evidence-passing band —
      // Hβ.emit.generic-boundary-repr-coercion.)
      NErrorHole(_)    => resume(TVar(h)),
      // A free var read at lower is NOT an error — it is a legal quantified
      // parameter of a reachable generic declaration (generalize's Forall is
      // the graph's own proof; `fn ident(x) = x` called from main carries
      // one), and repr_of floors it to the honest word by design. The per-read
      // report here re-derived "free = error" against that proof — 182
      // false diagnostics on a clean runtime-lib compile, the whole
      // frontier-gate debt class. A GENUINELY stuck width still detonates
      // at emit's loud comment-marked floors (field-offset-unprovable, the
      // ft mismatch), at the site that actually needs the width — the
      // consumer owns the refusal, never the read.
      NFree(_)         => resume(TVar(h)),
      NRowBound(_)     => resume(TUnit),
      NRowFree(_)      => resume(TUnit)
    }
  }
}

// diagnostics_handler — stderr routing (spec 06)
// The sandbox boundary. Outermost in every route. Declares
// `with !Diagnostic` so its own arms cannot recursively perform
// report — structural gate via spec 01's algebra.

handler diagnostics_handler with errors = 0, refusals = 0 {

  report(diag) => {
    // Every surface is a PROJECTION of the one DiagKind — source, code,
    // severity-class, message, span, applicability are read live, never
    // copied. The stderr line and the IDE hover are the same graph read.
    eprint_string("{diag_source(diag)}: {diag_code(diag)} {diag_kind(diag)}: {diag_message(diag)} at {show_span(diag_span(diag))}\n")
    // The tally IS the projection continued. This arm saw every diagnostic and
    // dropped its severity on the floor, so `mentl check` on a missing module
    // printed the error and exited 0, and a program with a live E_TypeMismatch
    // emitted 77 lines of WAT. The verdict was here the whole time; the exit
    // code re-derived it as success.
    if diag_severity(diag) == SError {
      if diag_refuses(diag) {
        resume() with errors = errors + 1, refusals = refusals + 1
      } else {
        resume() with errors = errors + 1
      }
    } else {
      resume()
    }
  }

  diag_errors()   => resume(errors)
  diag_refusals() => resume(refusals)
}

// FreshHandle — two handlers, same function
// Inference mints via graph_fresh_ty (stored in graph); query mints
// display ids (ephemeral, for rendering). Both satisfy FreshHandle.

handler fresh_for_inference {
  mint(reason) => {
    let h = graph_fresh_ty(reason)
    resume(h)
  }
  mint_row(reason) => {
    let h = graph_fresh_row(reason)
    resume(h)
  }
}

handler fresh_for_query with next_display = 0 {
  mint(_reason) =>
    resume(next_display)
      with next_display = next_display + 1
  mint_row(_reason) =>
    resume(next_display)
      with next_display = next_display + 1
}

// Collection helpers — consumed by teach / audit

// Per-fn gradient projection. Each FnStmt's teach_gradient is
// independent of siblings (no shared state mutation among reads);
// map's tail loop walks them. N-core gradients are a `><` under its
// own `~> Thread` at this site (Hβ.lower.schedule-specialized-callee).
// map_fn_stmts — project every top-level FnStmt to `project(name, handle)`,
// dropping non-fn nodes. The ONE cursor walk over the module's fn decls;
// audit and teach are two projections of it (Carried-Truth: the walk lived
// twice, byte-identical but for the projection — one home now).
fn map_fn_stmts(ast, project) = {
  ast
    |> map((node) => {
         let N(body, _, handle) = node
         match body {
           NStmt(FnStmt(name, _, _, _, _)) => [project(name, handle)],
           _                               => []
         }
       })
    |> flatten
}

fn render_gradients(gradients) = {
  if len(gradients) == 0 {
    "All functions are at maximum annotation density.\n"
  } else {
    gradients
      |> map((entry) => {
           let (name, result) = entry
           "{name}: {render_gradient_result(result)}\n"
         })
      |> str_concat_all
  }
}

fn render_gradient_result(result) = match result {
  None => "(no next-step annotation suggested)",
  Some(suggestion) => {
    let AnnotationSuggestion(_kind, ann_text, unlocks, _reason) = suggestion
    "→ add {ann_text} to unlock {join_unlock_labels(unlocks)}"
  }
}

fn join_unlock_labels(labels) with Memory = {
  if len(labels) == 0 { "(no capabilities)" }
  else {
    let first = head(labels)
    let rest = rest(labels)
    fold(first, (acc, label) => acc ++ ", " ++ label, rest)
  }
}

// H5: AuditReport record per fn — the structured projection Mentl's
// IDE surfaces (Proof Lens, Gradient ghost text, JSON export). Each
// field is independently introspectable; the record shape lets new
// metadata land additively (per CLAUDE.md insight 9).
//
// Fields (sorted alphabetically per parser invariant):
//   fn_name     — the function's identifier
//   reached     — effects the body actually performs ([EffName])
//   row_str     — pre-rendered row for terminal output
//   severable   — effects NOT in body that could be added as !E
//                 ([EffName], each unlocking capabilities)
//   unlocks     — capabilities gained from severing every severable
//
// A TUPLE, not a record: render_audit reads these fields inside a map
// lambda, and a structural record's fields floor "field offset
// unprovable" there (map's lambda param doesn't inherit the list element
// type, and the wheel lowers no nominal record PATTERN to prove it — §7
// field-offset class). Positional destructure is provable with no type
// flow, exactly as teach's [(name, result)] tuples are.
fn build_audit_report(fn_name, ty) = {
  let body_row = extract_row(ty)
  let reached = row_names(body_row)
  let severable = severance_candidates(reached)
  let unlocks = severance_unlocks(severable)
  (fn_name, reached, show_effrow(body_row), severable, unlocks)
}

// Severance candidates: the canonical effects (Alloc / IO / Network)
// that the body does NOT perform. Adding `!E` for each unlocks a
// capability without breaking the row.
fn severance_candidates(reached) = {
  let canonical = [ENamed("Alloc"), ENamed("IO"), ENamed("Network")]   // drift-audit: ignore — real drift 8 (EffName should have EAlloc/EIO/ENetwork variants); tracked for item 11.B EffName refactor
  filter_not_in(canonical, reached, 0, len(canonical), [])
}

fn filter_not_in(candidates, present, i, n, acc) = {
  if i >= n { acc }
  else {
    let c = list_index(candidates, i)
    let next = if name_in_list(present, c) { acc }
               else { acc ++ [c] }   // drift-audit: ignore — real drift 11 on small canonical-3-effect list; buffer-counter conversion requires adding Memory+Alloc to fn row rippling through audit walk; tracked for item 11.B buffer-counter sweep
    filter_not_in(candidates, present, i + 1, n, next)
  }
}

fn name_in_list(names, target) = {
  name_in_list_loop(names, target, 0, len(names))
}

fn name_in_list_loop(names, target, i, n) = {
  if i >= n { false }
  else if list_index(names, i) == target { true }   // structural fold-eq, not the hand-rolled twin
  else { name_in_list_loop(names, target, i + 1, n) }
}

fn severance_unlocks(severable) = {
  severance_unlocks_loop(severable, 0, len(severable), [])
}

fn severance_unlocks_loop(severable, i, n, acc) = {
  if i >= n { acc }
  else {
    let caps = capabilities_for_severance(list_index(severable, i))
    severance_unlocks_loop(severable, i + 1, n, acc ++ caps)
  }
}

// Terminal renderer over AuditReport records — reads fields by name.
// JSON / IDE-projection renderers are peer functions on the same
// record (one substrate, multiple projections per CLAUDE.md insight 8).
fn render_audit(entries) = {
  entries
    |> map((report) => {
         // Positional destructure — provable with no type flow, where a
         // record field read floors in a map lambda (see build_audit_report).
         let (fn_name, reached, row_str, severable, unlocks) = report
         let header = "{fn_name} : {row_str}\n"
         let severance_section =
           if len(severable) == 0 { "" }
           else {
             "  severable: {show_list(severable, show_eff_name, " + ")} — unlocks {show_list(unlocks, show_capability, ", ")}\n"
           }
         "{header}{severance_section}"
       })
    |> str_concat_all
}

// Query rendering — delegates to query.mn for Question parsing

fn render_query_result(result) = match result {
  QRType(ty, reason) => "→ {show_type(ty)}\n  Reason: {show_reason(reason)}",
  QRIntent(effs) => {
    let terms = effs |> map((entry) => {
      let (name, negated, conn) = entry
      let sign = if negated { "!" } else { "" }
      let symbol = match conn { EcUnion => "+", EcDiff => "-", EcInter => "&" }
      "{symbol}{sign}{show_eff_name(name)}"
    })
    "→ {str_concat_all(terms)}"
  },
  QRUnresolved(entries) => "→ {int_to_str(len(entries))} unresolved entries",
  QRChain(hops) => "→ {int_to_str(len(hops))} hops in chain",
  QREffects(row) => "→ {show_effrow(row)}",
  QROwnership(params) => "→ {int_to_str(len(params))} params",
  QRWhy(reason) =>
    show_reason(reason),
  QRRefs(spans) => "→ {int_to_str(len(spans))} reference(s)",
  QRVerifyDebt(obligations) => "→ {int_to_str(len(obligations))} verification obligations pending",
  QRHandlerProvider(provider) => match provider {
    Some(name) => "→ handled by {name}",
    None       => "→ no handler installed"
  },
  QRFlowLabel(label, reason) =>
    "→ {show_flow_label(label)}\n  Reason: {show_reason(reason)}",
  QRError(msg) => "error: {msg}"
}

// show_flow_label — defined in types.mn alongside flow_label_join/flow_le.

// The query surface is a tiny grammar: <verb> [arg]. The query strings are
// unavoidable external input (like LSP method strings, lsp.mn classify_method)
// — projected to the QueryVerb ADT at ONE boundary (classify_query_verb),
// downstream ADT-only. build_question reads the verb structurally and pairs it
// with its argument arity; no nested string-literal cascade scattered across
// arities (drift 8). An ill-formed query is QUnknown(q) — the honest Silence,
// never a fabricated Question.

type QueryVerb
  = QVType | QVEffects | QVOwnership | QVWhy | QVRefs | QVProvider
  | QVUnresolved | QVVerification | QVFlow | QVUnknownVerb

fn classify_query_verb(w: String) with Pure = {
  if      w == "type"         { QVType }
  else if w == "effects"      { QVEffects }
  else if w == "ownership"    { QVOwnership }
  else if w == "why"          { QVWhy }
  else if w == "refs"         { QVRefs }
  else if w == "provider"     { QVProvider }
  else if w == "unresolved"   { QVUnresolved }
  else if w == "verification" { QVVerification }
  else if w == "flow"         { QVFlow }
  else                        { QVUnknownVerb }
}

fn parse_query_string(q) = {
  // split returns a slice VIEW; the list-pattern match assumes the flat
  // [len][elems] contract, so flatten once before matching (§7 face 13)
  // — and read words ONCE, never re-split per arm (Carried-Truth).
  let words = list_to_flat(split(q, " "))
  match words {
    []       => QUnknown(q),
    [w0]     => build_question(classify_query_verb(w0), "", q),
    [w0, w1] => build_question(classify_query_verb(w0), w1, q),
    _        => build_question(classify_query_verb(query_head(words)),
                               query_last(words), q)
  }
}

// build_question — pair the classified verb with its argument. Nullary verbs
// (unresolved/verification) ignore the arg; unary verbs carry it. A verb whose
// arity its arg cannot satisfy projects to QUnknown(raw) — the honest unknown.
fn build_question(verb, arg, raw) with Pure = match verb {
  QVUnresolved   => QUnresolved,
  QVVerification => QVerifyDebt,
  QVType         => QTypeOf(arg),
  QVEffects      => QEffects(arg),
  QVOwnership    => QOwnership(arg),
  QVWhy          => QWhy(arg),
  QVRefs         => QRefsOf(arg),
  QVProvider     => QHandlerProvider(arg),
  QVFlow         => QFlowOf(arg),
  QVUnknownVerb  => QUnknown(raw)
}

// The verb is the FIRST word (`<verb> [arg]` — the documented query
// grammar); the prior read of last(ws) made every 3+-word query's verb
// and argument the SAME final word.
fn query_head(ws) with Memory = if len(ws) == 0 { "" } else { head(ws) }

fn query_last(ws) with Memory =
  if len(ws) == 0 { "" } else { list_index(ws, len(ws) - 1) }
