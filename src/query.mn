// query.mn — forensic substrate for the live graph (spec 08)
//
// `mentl query` is the read-only projection of the inference result.
// No mutations. No side effects. Every question reads through
// GraphRead + EnvRead; write attempts fail at handler install
// via spec 01's subsumption gate. The forensic substrate is airtight
// by type.
//
// Every LSP method (Arc F.2) is a Question variant over this same
// effect. There is no separate LSP substrate. JSON-RPC is the
// transport; tentacles are already here.
import types

import graph

import effects

// The structural census (Hβ.query.structural-census — PLAN §11 Phase 0.3):
// ONE projection taking a structural shape, answering count + located
// sites over the program weave — the question the medium could not ask of
// its own source ("how many of my functions are anonymous?", "how much of
// this file is ><?") without grep on emitted WAT (three filed mentl-skips
// in one audit). The shapes serve the named consumers: anonymity (raw
// CsAnonymous, plus the tier's two conviction shapes CsEta and
// CsEffectfulLambda — Phase 2.5 ratchets on the convictions), verb-shape
// (CsVerb carries the PipeKind itself, classified at the grammar boundary
// through show_pipe_kind — the one glyph projection, never a second
// table), and iteration-shape (CsIterationCostume — the audit tier's
// detector living HERE, the census its home, the audit a reader).
type CensusShape = CsAnonymous | CsVerb(PipeKind) | CsEta | CsEffectfulLambda | CsIterationCostume

// Sum type covering every forensic question `mentl query` can pose.
// Each variant corresponds to one `ask(Q)` arm in `query_default`.
type Question
  // "type of NAME"
  = QTypeOf(String)
  // "type at L:C"
  | QTypeAt(Span)
  // "intent of handle N"
  | QIntentOf(Int)
  // every handle that chases to NFree
  | QUnresolved
  // "subst trace for handle N"
  | QSubstChain(Int)
  // "effects of NAME"
  | QEffects(String)
  // "ownership of NAME"
  | QOwnership(String)
  // "why NAME" — walks reason DAG
  | QWhy(String)
  // "refs of NAME" — for rename
  | QRefsOf(String)
  // "verification" — pending obligations
  | QVerifyDebt
  // "which handler provides OP"
  // QFlowOf — the IFC tentacle (§4⑥). Reads the existing graph — TRefined,
  // TName, and the row's absent set — to classify NAME's FlowLabel without any
  // new graph state. The security classification IS already in the type;
  // this is the projection that names it. Novel: no other language exposes
  // IFC as a read of its existing type system. `mentl query flow key` answers
  // "what does the graph already know about key's sensitivity?"
  | QHandlerProvider(String)
  | QFlowOf(String)
  // "census <shape>" — count + sites of a structural shape in the weave
  | QCensus(CensusShape)
  | QUnknown(String)

type QueryResult
  = QRType(Ty, Reason)
  | QRIntent([(EffName, Bool, EConn)])
  // [(name, ty, free-tvars)]
  | QRUnresolved([(String, Ty, [Ty])])
  // [(handle, GNode)]
  | QRChain([(Int, GNode)])
  | QREffects(EffRow)
  | QROwnership([TParam])
  | QRWhy(Reason)
  | QRRefs([Span])
  | QRVerifyDebt([(Span, Predicate, Reason)])
  | QRHandlerProvider(Option(String))
  // IFC projection — the FlowLabel the type already proves
  | QRFlowLabel(FlowLabel, Reason)
  // census label + the located sites (count = len)
  | QRCensus(String, [Span])
  | QRError(String)

// The single-op effect that routes every forensic question through
// `query_default`. LSP methods (Arc F.2) are `Question` variants
// over this same effect — no separate LSP substrate.
effect Query {
  ask(Question) -> QueryResult
}

// Read-only projection over the live graph and env. No handler-local
// state; all data arrives through `GraphRead + EnvRead`. Pure
// observation — write attempts fail at handler install via the row
// subsumption gate.
handler query_default {
  ask(q) => match q {
    QTypeOf(name) => match env_lookup(name) {
      None => resume(QRError("not found: {name}")),
      Some(entry) => match entry {
        (scheme, reason, _kind) => match scheme {
          Forall(_, ty) => resume(QRType(chase_type_deep(ty), reason)),
        },
      },
    },
    QTypeAt(span) => // One live cursor read: tightest enclosing span → handle → the node's
    // bound type, chased deep. No throwaway TName("Unknown") chase — the
    // graph_chase below IS the live read; an unbound node's type IS its own
    // TVar (the chase terminated there), so the projection is total over the
    // NodeKind without a fabricated "Unresolved" name.
    match graph_snapshot() {
      Graph(_, span_index) => match find_tightest(span_index, span, None, 999999999) {
        None => resume(QRError("no enclosing span found in AST index")),
        Some(handle) => match graph_chase(handle) {
          GNode(kind, reason) => match kind {
            NBound(ty) => resume(QRType(chase_type_deep(ty), reason)),
            NFree(_) => resume(QRType(TVar(handle), reason)),
            NRowBound(_) => resume(QRType(TVar(handle), reason)),
            NRecordRowBound(_) => resume(QRType(TVar(handle), reason)),
            NRowFree(_) => resume(QRType(TVar(handle), reason)),
            NErrorHole(_) => resume(QRType(TVar(handle), reason)),
          },
        },
      },
    },
    QIntentOf(handle) => // The authored intent row is a field on the FnStmt node the handle
    // names — read it LIVE (graph_node_body), never a parallel
    // intent ledger re-found by scan (Carried-Truth). A non-fn node
    // carries no authored intent.
    match graph_node_body(handle) {
      NStmt(FnStmt(_, _, _, effs, _)) => resume(QRIntent(effs)),
      _ => // drift-audit: ignore
      resume(QRError("no authored intent at handle {int_to_str(handle)}")),
    },
    QUnresolved => match env_snapshot() {
      Env(entries) => resume(QRUnresolved(find_unresolved(entries))),
    },
    QSubstChain(handle) => resume(QRChain(walk_chain(handle, 0))),
    QEffects(name) => match env_lookup(name) {
      None => resume(QRError("not found: {name}")),
      Some(entry) => match entry {
        (scheme, _, _) => match scheme {
          Forall(_, ty) => match chase_type_deep(ty) {
            TFun(_, _, row) => resume(QREffects(row)),
            _ => resume(QRError("{name} is not a function")),
          },
        },
      },
    },
    QOwnership(name) => match env_lookup(name) {
      None => resume(QRError("not found: {name}")),
      Some(entry) => match entry {
        (scheme, _, _) => match scheme {
          Forall(_, ty) => match chase_type_deep(ty) {
            TFun(params, _, _) => resume(QROwnership(params)),
            _ => resume(QRError("{name} is not a function")),
          },
        },
      },
    },
    QWhy(name) => match env_lookup(name) {
      None => resume(QRError("not found: {name}")),
      Some(entry) => match entry {
        (_, reason, _) => // Walk the reason to ROOT — why_expand chases each Fresh(id) through
        // the graph to its resolved reason, so intent is walkable, not a chain
        // ending in dangling unification vars. The engine existed (mentl.mn:437)
        // and only why_from_handle called it; the CLI `why` now performs it too.
        resume(QRWhy(why_expand(reason, 0))),
      },
    },
    QRefsOf(name) => // Every reference to NAME is a VarRef node in the one graph (the parser
    // wrote each use into the program weave). refs-of is the projection of
    // the inbound use-edges: scan the weave for NExpr(VarRef(name)) and
    // collect each node's span — read live, never an "AST index required"
    // surrender. This IS rename: the [Span] is exactly the edit set.
    resume(QRRefs(refs_of_name(name))),
    QVerifyDebt => {
      let debt = verify_debt()
      resume(QRVerifyDebt(debt))
    },
    QHandlerProvider(op_name) => // The handler stack IS graph content (PLAN §2 — "the handler chain IS
    // the capability stack"): each handler decl is a HandlerDeclStmt in the
    // weave whose arms name the ops it provides. Which handler provides OP is
    // the decl whose arms include an arm for OP — read live, never a
    // "requires active inference context" surrender. None when no handler
    // provides the op.
    resume(QRHandlerProvider(handler_providing_op(op_name))),
    QFlowOf(name) => // The IFC tentacle: read the FlowLabel the type system already proves
    // for NAME, without any new graph state. The classification comes from:
    //   - TRefined: a refinement predicate whose name contains secret / classified
    //   - TName: a nominal type whose name signals sensitivity (SecretKey, Token, etc.)
    //   - the absent set in the fn's row: `with !IO + !Network` proves the fn cannot
    //     route its output to public-observable sinks — that IS the Secret label.
    // This is a pure read over the existing graph. The graph IS the IFC mechanism.
    match env_lookup(name) {
      None => resume(QRError("not found: {name}")),
      Some(entry) => match entry {
        (scheme, reason, _kind) => match scheme {
          Forall(_, ty) => {
            let label = query_flow_label(chase_type_deep(ty))
            resume(QRFlowLabel(label, reason))
          },
        },
      },
    },
    QCensus(shape) => resume(QRCensus(census_label(shape), census_sites(shape))),
    QUnknown(q) => resume(QRError("unknown query: {q}")),
  },
}

fn chase_type_deep(ref ty) with !Mutate = match ty {
  TVar(h) => match graph_chase(h) {
    GNode(kind, _) => match kind {
      NBound(inner) => chase_type_deep(inner),
      _ => ty,
    },
  },
  TList(elem) => TList(chase_type_deep(elem)),
  TTuple(elems) => TTuple(chase_list_deep(elems)),
  TFun(params, ret, eff) => TFun(chase_params_deep(params), chase_type_deep(ret), eff),
  TName(name, args) => TName(name, chase_list_deep(args)),
  TRecord(fields) => TRecord(chase_fields_deep(fields)),
  TRecordOpen(fields, v) => mk_record_open(chase_fields_deep(fields), v),
  TRefined(base, pred) => TRefined(chase_type_deep(base), pred),
  TCont(input, answer, disc, world) => TCont(chase_type_deep(input), chase_type_deep(answer), disc, world),
  TAlias(name, inner) => TAlias(name, chase_type_deep(inner)),
  _ => ty,
}

// Order-preserving BY the vocabulary form (Hβ.query.param-render-reversed's
// root): the last/drop_last-prepend walks rebuilt every list REVERSED, so
// `type of pair` answered `(beta, alpha)` for a declared (alpha, beta) —
// the voice lying about order at the exact projection that must replace
// reading the source. map preserves; declaration order is the truth. This
// private deep-chase family is one of the nineteen Ty descents the
// traversal-is-a-handler peer consolidates; its one home arrives there.
fn chase_list_deep(ref tys) with !Mutate = map(chase_type_deep, tys)

fn chase_params_deep(ref params) with !Mutate =
  map((p) => param_with_ty(p, chase_type_deep(param_ty(p))), params)

fn chase_fields_deep(ref fields) with !Mutate = map(
  (field) => match field {
    (name, ty) => (name, chase_type_deep(ty)),
  },
  fields
)

// Collect all env entries whose type still chases to a free `TVar`.
// Returned by `QUnresolved` — the set of names with incomplete types
// after inference, in env order (the reversing walk was the
// param-render-reversed class's fourth face).
fn find_unresolved(ref entries) with !Mutate = entries |> filter((entry) => match entry {
  (_, scheme, _, _) => match scheme {
    Forall(_, ty) => has_free_tvar(ty),
  },
}) |> map((entry) => match entry {
  (name, scheme, _, _) => match scheme {
    Forall(_, ty) => (name, ty, []),
  },
})

fn has_free_tvar(ref ty) with !Mutate = match ty {
  TVar(h) => match graph_chase(h) {
    GNode(kind, _) => match kind {
      NFree(_) => true,
      NBound(inner) => has_free_tvar(inner),
      _ => false,
    },
  },
  TList(elem) => has_free_tvar(elem),
  TTuple(elems) => has_free_tvar_list(elems),
  TFun(params, ret, _) => has_free_tvar(ret) || has_free_tvar_params(params),
  TName(_, args) => has_free_tvar_list(args),
  TRecord(fields) => has_free_tvar_fields(fields),
  TRecordOpen(fields, _) => has_free_tvar_fields(fields),
  TRefined(base, _) => has_free_tvar(base),
  TCont(input, answer, _, _) => has_free_tvar(input) || has_free_tvar(answer),
  TAlias(_, inner) => has_free_tvar(inner),
  _ => false,
}

fn has_free_tvar_list(ref tys) with !Mutate =
  if len(tys) == 0 { false } else { has_free_tvar(last(tys)) || has_free_tvar_list(drop_last(tys)) }

fn has_free_tvar_params(ref params) with !Mutate = if len(params) == 0 {
  false
} else {
  has_free_tvar(param_ty(last(params))) || has_free_tvar_params(drop_last(params))
}

fn has_free_tvar_fields(ref fields) with !Mutate = if len(fields) == 0 {
  false
} else {
  match last(fields) {
    (_, ty) => has_free_tvar(ty) || has_free_tvar_fields(drop_last(fields)),
  }
}

// Walk every substitution hop from a starting handle to its terminal.
// Returned by `QSubstChain` — useful for tracing cross-module `TVar`
// resolution.
fn walk_chain(handle, depth) with !Mutate = if depth > 50 || handle < 0 {
  []
} else {
  let node = graph_chase(handle)
  match node {
    GNode(kind, _) => match kind {
      NBound(ty) => match ty {
        TVar(next) => [(handle, node)] ++ walk_chain(next, depth + 1),
        _ => [(handle, node)],
      },
      _ => [(handle, node)],
    },
  }
}

// ─── Live use-edge projection — refs-of (rename) ───────────────────
//
// Every reference to NAME is a VarRef node the parser wrote into the program
// weave. refs_of_name walks the weave and collects the span of each
// NExpr(VarRef(name)) — the inbound use-edge set, read live. No AST side-index.
fn refs_of_name(name) with GraphRead + !Mutate + Alloc + Memory = match graph_snapshot() {
  Graph(next, _) => collect_var_ref_spans(name, 0, next, make_list(0)),
}

// Tail walk with an accumulator — the prior non-tail form's stack depth
// was the whole handle space, so a DAG-scale graph exhausted the call
// stack the first time the refs facet ran against a full compile.
fn collect_var_ref_spans(name, i, n, acc) with GraphRead + Memory + Alloc + !Mutate = if i >= n {
  acc
} else {
  match graph_node_body(i) {
    NExpr(VarRef(ref_name)) => if ref_name == name {
      // A zero span is a synthetic mint (a pre-registration ghost),
      // not a source site — the located answer skips it. A span already
      // collected is the SAME source site re-minted by a later judgment
      // generation (the converged rounds re-parse; one reference
      // rendered four times before this dedup) — the reference's
      // identity is its source location, so it enters once.
      let sp = span_of_handle(i)
      if sp == span_zero() || span_in(acc, sp, 0) {
        collect_var_ref_spans(name, i + 1, n, acc)
      } else {
        collect_var_ref_spans(name, i + 1, n, push(acc, sp))
      }
    } else {
      collect_var_ref_spans(name, i + 1, n, acc)
    },
    _ => collect_var_ref_spans(name, i + 1, n, acc),
  }
}

fn span_in(ref acc, ref sp, i) with Memory + Alloc =
  if i >= len(acc) { false } else { if acc[i] == sp { true } else { span_in(acc, sp, i + 1) } }

// ─── The structural census — count + sites of a shape in the weave ──
//
// The same walk refs_of_name runs (every node once, span-deduped —
// re-parsed judgment generations mint one source site many times), with
// the membership read from the shape. A membership predicate's false arm
// is the read's honest complement over NodeBody, not a fabricated value.
fn census_label(shape) with Pure = match shape {
  CsAnonymous => "anonymous fn(s)",
  CsVerb(k) => "{show_pipe_kind(k)} site(s)",
  CsEta => "eta-wrapper(s)",
  CsEffectfulLambda => "effectful lambda(s)",
  CsIterationCostume => "iteration-costume fn(s)",
}

fn census_sites(shape) with GraphRead + !Mutate + Alloc + Memory = match graph_snapshot() {
  Graph(next, _) => census_walk(shape, 0, next, make_list(0)),
}

// The weave walk's span is the node's OWN (raw) reason — the parse site.
// span_of_handle CHASES to the union-find root, which conflates a node's
// identity with its type-class representative: a `<~` node's chase lands
// on the continuation-boundary cell (bound with a bare Inferred), answers
// span_zero, and the census skipped every feedback site as synthetic —
// the 2.0 dig's true root, found after the eq itself measured TRUE
// (3 vs 3) on the pair the divergence hypothesis had accused.
fn span_of_node_raw(handle) with GraphRead + !Mutate + Memory + Alloc =
  span_of_reason(graph_reason_at(handle))

fn census_walk(shape, i, n, acc) with GraphRead + Memory + Alloc + !Mutate = if i >= n {
  acc
} else {
  if census_matches(shape, i, graph_node_body(i)) {
    let sp = span_of_node_raw(i)
    if sp == span_zero() || span_in(acc, sp, 0) {
      census_walk(shape, i + 1, n, acc)
    } else {
      census_walk(shape, i + 1, n, push(acc, sp))
    }
  } else {
    census_walk(shape, i + 1, n, acc)
  }
}

// The annotations are Intent Boundaries carrying the eq proof: without
// them the kinds' `==` floored to pointer i32.eq (the documented
// pointer-eq-on-names class, here on an ADT — PFeedback's two
// construction sites compared unequal while a match on either side
// dispatched PFeedback true; measured [CW] `<~ vs <~` → false). The
// handle rides beside the body: the judgment shapes read the graph at
// the site (the lambda's judged row, the fn's own self-calls), where
// the syntactic shapes read the body alone.
fn census_matches(shape: CensusShape, h, body: NodeBody) with GraphRead + !Mutate + Alloc + Memory = match shape {
  CsAnonymous => match body {
    NExpr(LambdaExpr(_, _)) => true,
    _ => false,
  },
  CsVerb(k) => match body {
    NExpr(PipeExpr(pk, _, _)) => pk == k,
    _ => false,
  },
  CsEta => match body {
    NExpr(LambdaExpr(params, lbody)) => lambda_is_eta(params, lbody),
    _ => false,
  },
  CsEffectfulLambda => match body {
    NExpr(LambdaExpr(params, lbody)) => !lambda_is_eta(params, lbody) && lambda_carries_row(h),
    _ => false,
  },
  CsIterationCostume => match body {
    NStmt(FnStmt(_, _, _, _, _)) => recursion_shape_of(h),
    _ => false,
  },
}

// ── the one total child projection — the weave's tree edge ──────────
//
// expr_child_handles — the type-handles of an Expr's direct child Nodes.
// One arm per Expr variant that carries children (the row algebra over
// the value space — H6 exhaustive); leaf literals carry none.
fn expr_child_handles(e) with Alloc + Memory = match e {
  BinOpExpr(_, l, r) => [node_handle(l), node_handle(r)],
  UnaryOpExpr(_, n) => [node_handle(n)],
  CallExpr(f, args) => [node_handle(f)] ++ map(node_handle, args),
  LambdaExpr(_, body) => [node_handle(body)],
  IfExpr(c, t, f) => [node_handle(c), node_handle(t), node_handle(f)],
  BlockExpr(stmts, fin) => // order-free: membership test only
  [node_handle(fin)] ++ map(node_handle, stmts),
  MatchExpr(scrut, arms) => // an arm's BODY is a child node — dropping the arms left the
  // projection partial and tree containment blind below any match
  // (the enclosing-decl guard's measured hole).
  [node_handle(scrut)] ++ map(
    (arm) => match arm {
      (_, b) => node_handle(b),
    },
    arms
  ),
  ResumeExpr(v, updates) => // A resume-with update is the parser's {name, init} record — the handle
  // lives on its init edge (record_field_handle's exact sibling).
  [node_handle(v)] ++ map(record_field_handle, updates),
  MakeListExpr(elems) => map(node_handle, elems),
  MakeTupleExpr(elems) => map(node_handle, elems),
  MakeRecordExpr(fields) => // Record LITERALS carry the parser's (name, value) tuples
  // (parse_record_fields); only resume updates are {name, init} records.
  map(tuple_field_handle, fields),
  RecordUpdateExpr(base, flds) => [node_handle(base)] ++ map(tuple_field_handle, flds),
  NamedRecordExpr(_, flds) => map(tuple_field_handle, flds),
  IndexExpr(recv, idx) => [node_handle(recv), node_handle(idx)],
  MakeStringExpr(frags) => map(node_handle, frags),
  FieldExpr(recv, _) => [node_handle(recv)],
  PipeExpr(_, l, r) => [node_handle(l), node_handle(r)],
  LabeledArg(_, v) => // the labeled value is a child node
  [node_handle(v)],
  _ => // LitInt/LitFloat/LitString/LitBool/LitUnit/VarRef/ExprPlaceholder — no child Nodes
  [],
}

// The field IS the parser's {name, init} record — read the init edge by
// name (the tuple destructure read a record as positions and met Node).
fn record_field_handle(field) with Pure = node_handle(field.init)

fn tuple_field_handle(field) with Pure = match field {
  (_, v) => node_handle(v),
}

// stmt_child_handles — expr_child_handles' Stmt sibling (the projection
// made TOTAL, Hβ.cursor.enclosing-decl-edge's dep): the VALUE-position
// child nodes of a statement. Type-level carriers (a variant's or op's
// comment node, an import, a refinement's predicate) hold no value
// holes and contribute none.
fn stmt_child_handles(s) with Alloc + Memory = match s {
  LetStmt(_pat, value, ann) => match ann {
    N(NTypeAnn(_), _, _) => // the annotation channel is a child only when it IS one: the absent
    // form ALIASES the value node (the parser's no-fresh-mint sentinel,
    // all three LetStmt mints), so listing the alias double-visits every
    // unannotated let's value subtree — measured as count_var_uses
    // doubling through statement-position lets. Same read infer makes
    // (its NTypeAnn arm skips a non-annotation node).
    [node_handle(value), node_handle(ann)],
    _ => [node_handle(value)],
  },
  FnStmt(_name, _params, _ret, _effs, body) => [node_handle(body)],
  ExprStmt(e) => [node_handle(e)],
  HandlerDeclStmt(_hname, _ename, _config, states, arms) => map(record_field_handle, states) ++ map(arm_body_handle, arms),
  TypeDefStmt(_, _) => [],
  EffectDeclStmt(_, _, _) => [],
  ImportStmt(_) => [],
  RefineStmt(_, _, _) => [],
  AliasStmt(_, _) => [],
}

fn arm_body_handle(arm) with Pure = node_handle(arm.body)

// body_child_handles — the ONE total child projection over NodeBody:
// tree walks (containment, the enclosing-decl descent) read this,
// never a per-altitude copy.
fn body_child_handles(body) with Alloc + Memory = match body {
  NExpr(e) => expr_child_handles(e),
  NStmt(s) => stmt_child_handles(s),
  NPat(_) => [],
  NHole(_) => [],
  NModule(_) => [],
  NTypeAnn(_) => [],
}

// ── the tier detectors — the census IS their home ────────────────────
//
// The audit tiers (oracle.mn: anonymity_shape_of per fn; pipeline.mn's
// renderer) READ these; the census counts them over the whole weave.
// One detector, two projections — the per-fn narration and the
// count+sites answer — never two classifiers (PLAN §11 Phase 2.5).
//
// ITERATION IS TOPOLOGY (Morgan's interrogation, 2026-07-30 — the law
// SYNTAX declared at birth: no loop keywords; iteration is |> stages,
// <~ cycles, Iterate handlers). A self-call that threads an
// INCREMENTED INDEX over the fn's own parameter is the imperative loop
// written in recursion's costume — name-keyed re-entry where a derived
// fold/each/iterate serves. The read is structural over the one total
// child projection: a CallExpr of the fn's OWN name with any argument
// `p + 1` / `1 + p` over a parameter — the index-threading signature
// (a structural fold's self-call recurses on CHILDREN, never on an
// incremented counter, so derived-fold-shaped recursion never fires).
fn recursion_shape_of(fn_handle) with GraphRead + Alloc + Memory = match graph_node_body(fn_handle) {
  NStmt(FnStmt(name, params, _, _, body)) => self_call_increments(node_handle(body), name, params |> map(param_name)),
  _ => false,
}

fn self_call_increments(h, name: String, pnames) with GraphRead + Alloc + Memory = {
  let body = graph_node_body(h)
  let here = match body {
    NExpr(CallExpr(callee, args)) => callee_names(callee, name) && (args |> any((a) => arg_is_increment(a, pnames))),
    _ => false,
  }
  here || (body_child_handles(body) |> any((c) => self_call_increments(c, name, pnames)))
}

fn callee_names(callee, name: String) with GraphRead = match graph_node_body(node_handle(callee)) {
  NExpr(VarRef(n)) => n == name,
  _ => false,
}

fn arg_is_increment(arg, pnames) with GraphRead + Alloc + Memory = match graph_node_body(node_handle(arg)) {
  NExpr(BinOpExpr(BAdd, l, r)) => param_plus_one(l, r, pnames) || param_plus_one(r, l, pnames),
  _ => false,
}

fn param_plus_one(a, b, pnames) with GraphRead + Alloc + Memory = match graph_node_body(node_handle(a)) {
  NExpr(VarRef(n)) => list_contains_str(pnames, n) && match graph_node_body(node_handle(b)) {
    NExpr(LitInt(1)) => true,
    _ => false,
  },
  _ => false,
}

fn list_contains_str(xs, target: String) with Memory = match xs {
  [] => false,
  [h, ...t] => if h == target { true } else { list_contains_str(t, target) },
}

// The eta test reads the body's OWN shape: exactly CallExpr(VarRef(g),
// args) with g resolving OUTSIDE the params (a param-named callee has
// no site-independent name to pass) and args ≡ the params in order.
fn lambda_is_eta(params, lbody) with GraphRead + Alloc + Memory = match graph_node_body(node_handle(lbody)) {
  NExpr(CallExpr(callee, args)) => match graph_node_body(node_handle(callee)) {
    NExpr(VarRef(g)) => {
      let pnames = params |> map(param_name)
      !list_contains_str(pnames, g) && args_mirror_params(args, pnames)
    },
    _ => false,
  },
  _ => false,
}

fn args_mirror_params(args, pnames) with GraphRead + Alloc + Memory =
  len(args) == len(pnames) && (range(0, len(args)) |> all((i) => arg_is_var(args[i], pnames[i])))

fn arg_is_var(a, n: String) with GraphRead = match graph_node_body(node_handle(a)) {
  NExpr(VarRef(v)) => v == n,
  _ => false,
}

// A lambda that PERFORMS: its judged TFun row resolves to present
// names (resolve_row follows bound row edges, so effects living behind
// an EtOpen var are read, not missed). Nothing present — including an
// open polymorphic tail at a HOF boundary — stays silent: pure
// vocabulary never narrates.
fn lambda_carries_row(h) with GraphRead + !Mutate + Alloc + Memory = match graph_chase(h) {
  GNode(NBound(TFun(_, _, row)), _) => match resolve_row(row) {
    EfRow(present, _, _) => len(present) > 0,
  },
  _ => false,
}

// span_of_handle — the node's source span, read live from its Reason chain
// (the parser/infer wrote Located(span, _) at the node). One graph_chase, the
// span peeled from the located reason — no parallel span-index re-lookup.
fn span_of_handle(handle) with GraphRead + !Mutate + Memory + Alloc = match graph_chase(handle) {
  GNode(_, reason) => span_of_reason(reason),
}

fn span_of_reason(reason) with Memory + Alloc = match reason {
  Located(sp, _) => sp,
  _ => span_zero(),
}

// ─── Live install-edge projection — which handler provides OP ──────
//
// Each handler decl is a HandlerDeclStmt in the weave whose arms name the ops
// it provides (the handler chain IS the capability stack, PLAN §2). Scan the
// weave for the decl whose arms include OP; project its handler name.
fn handler_providing_op(op_name) with GraphRead + !Mutate + Memory + Alloc = match graph_snapshot() {
  Graph(next, _) => scan_handler_for_op(op_name, 0, next),
}

fn scan_handler_for_op(op_name, i, n) with GraphRead + !Mutate + Memory + Alloc = if i >= n {
  None
} else {
  match graph_node_body(i) {
    NStmt(HandlerDeclStmt(hname, _eff, _cfg, _state, arms)) => if arms_include_op(arms, op_name) { Some(hname) } else { scan_handler_for_op(op_name, i + 1, n) },
    _ => scan_handler_for_op(op_name, i + 1, n),
  }
}

fn arms_include_op(arms, op_name) with Memory + Alloc = if len(arms) == 0 {
  false
} else {
  let arm = last(arms)
  if arm.op_name == op_name { true } else { arms_include_op(drop_last(arms), op_name) }
}

// ─── Span → name — the inverse use-edge read (goto/rename anchor) ──
//
// The tightest node enclosing a span is a VarRef whose name the parser wrote
// live; name_at_span reads it (one find_tightest + one graph_node_body), the
// inverse of refs_of_name. None when the span encloses no identifier. This is
// the resolution goto-definition / find-references start from — read live, no
// position→symbol side-index.
fn name_at_span(span) with GraphRead + !Mutate + Memory + Alloc = match graph_snapshot() {
  Graph(_, span_index) => match find_tightest(span_index, span, None, 999999999) {
    None => None,
    Some(handle) => match graph_node_body(handle) {
      NExpr(VarRef(name)) => Some(name),
      _ => None,
    },
  },
}

// defining_span_of — the span where NAME is bound, read from its env entry's
// Reason (the parser/infer wrote Located(span,_) at the binding). The graph
// already proved where each name lives; goto-definition follows that edge, it
// does not re-scan. None when the name is unbound or its reason is unlocated.
fn defining_span_of(name) with EnvRead + !Mutate + Memory + Alloc = match env_lookup(name) {
  None => None,
  Some(entry) => match entry {
    (_, reason, _) => match reason {
      Located(sp, _) => Some(sp),
      _ => None,
    },
  },
}

// ─── Span Index Search (Arc F.2) ───────────────────────────────────
// The param is BARE Span — the demand law's dual face (never demand a
// proof the body doesn't use): the area fold is total arithmetic over
// the four fields, and the former ValidSpan param converted every
// bare-span caller into ceremony debt (seven obligations at the
// address tie-break alone, measured 2026-07-30) while the proof was
// never read.
fn span_area(s) with Pure = match s {
  Span(sl, sc, el, ec) => if sl == el { ec - sc } else { (el - sl) * 1000 + ec - sc },
}

fn find_tightest(ref idx, target, best_h, best_area) with Memory + Alloc = if len(idx) == 0 {
  best_h
} else {
  match last(idx) {
    (s, h) => if span_contains(s, target) {
      let area = span_area(s)
      if area < best_area {
        find_tightest(drop_last(idx), target, Some(h), area)
      } else {
        find_tightest(drop_last(idx), target, best_h, best_area)
      }
    } else {
      find_tightest(drop_last(idx), target, best_h, best_area)
    },
  }
}

// ── DAG-homed here (the import-truth sweep, 2026-07-23): each fn below
// moved from a module DOWNSTREAM of its users so every user reaches it
// through a forward import edge — the manifest tells the truth.
fn why_expand(reason, depth) = if depth > 20 {
  reason
} else {
  match reason {
    Located(span, inner) => Located(span, why_expand(inner, depth + 1)),
    Unified(a, b) => Unified(why_expand(a, depth + 1), why_expand(b, depth + 1)),
    OpConstraint(op, l, r) => OpConstraint(op, why_expand(l, depth + 1), why_expand(r, depth + 1)),
    VarLookup(name, inner) => VarLookup(name, why_expand(inner, depth + 1)),
    FnReturn(name, inner) => FnReturn(name, why_expand(inner, depth + 1)),
    FnParam(name, idx, inner) => FnParam(name, idx, why_expand(inner, depth + 1)),
    MatchBranch(a, b) => MatchBranch(why_expand(a, depth + 1), why_expand(b, depth + 1)),
    ListElement(inner) => ListElement(why_expand(inner, depth + 1)),
    IfBranch(inner) => IfBranch(why_expand(inner, depth + 1)),
    LetBinding(name, inner) => LetBinding(name, why_expand(inner, depth + 1)),
    Instantiation(name, inner) => Instantiation(name, why_expand(inner, depth + 1)),
    Fresh(id) => match graph_chase(id) {
      GNode(_, resolved) => match resolved {
        Fresh(_) => reason,
        _ => why_expand(resolved, depth + 1),
      },
    },
    _ => reason,
  }
}

// Fill a typed hole with THE sole proven survivor from the Synth chain,
// returned WITH its Reason. The allowed row is the Context's — the
// enclosing decl's AUTHORED constraint (re-deriving it from the hole's
// own type was the wrong-row-source class's second instance). Exactly one
// survivor is the medium's answer; two or more is the tie that TEACHES —
// indexing [0] was a hidden first-wins ranking, a guess between proven
// survivors the tie-break law forbids (PLAN §5).

