// query.mn — forensic substrate for the live graph (spec 08)
//
// `mentl query` is the read-only projection of the inference result.
// No mutations. No side effects. Every question reads through
// GraphRead + EnvRead; write attempts fail at handler install
// via spec 01's subsumption gate. The forensic substrate is airtight
// by type.
//
// Every LSP method (Arc F.2) is a Question variant over this same
// effect. There is no separate LSP substrate. JSON-RPC is the
// transport; tentacles are already here.

import types
import graph
import effects

// Sum type covering every forensic question `mentl query` can pose.
// Each variant corresponds to one `ask(Q)` arm in `query_default`.
type Question
  = QTypeOf(String)          // "type of NAME"
  | QTypeAt(Span)            // "type at L:C"
  | QIntentOf(Int)           // "intent of handle N"
  | QUnresolved              // every handle that chases to NFree
  | QSubstChain(Int)         // "subst trace for handle N"
  | QEffects(String)         // "effects of NAME"
  | QOwnership(String)       // "ownership of NAME"
  | QWhy(String)             // "why NAME" — walks reason DAG
  | QRefsOf(String)          // "refs of NAME" — for rename
  | QVerifyDebt              // "verification" — pending obligations
  | QHandlerProvider(String) // "which handler provides OP"
  // QFlowOf — the IFC tentacle (§4⑥). Reads the existing graph — TRefined,
  // TName, and EfNeg in the EffRow — to classify NAME's FlowLabel without any
  // new graph state. The security classification IS already in the type;
  // this is the projection that names it. Novel: no other language exposes
  // IFC as a read of its existing type system. `mentl query flow key` answers
  // "what does the graph already know about key's sensitivity?"
  | QFlowOf(String)
  | QUnknown(String)

// Predicate: is this question a why-walk? Every non-QWhy variant is
// honestly false — predicate semantics, not a fabricated value.
fn question_is_why(q) with Pure = match q {
  QWhy(_) => true,
  _       => false
}

type QueryResult
  = QRType(Ty, Reason)
  | QRIntent([(EffName, Bool, EConn)])
  | QRUnresolved([(String, Ty, [Ty])]) // [(name, ty, free-tvars)]
  | QRChain([(Int, GNode)]) // [(handle, GNode)]
  | QREffects(EffRow)
  | QROwnership([TParam])
  | QRWhy(Reason)
  | QRRefs([Span])
  | QRVerifyDebt([(Span, Predicate, Reason)])
  | QRHandlerProvider(Option(String))
  | QRFlowLabel(FlowLabel, Reason)  // IFC projection — the FlowLabel the type already proves
  | QRError(String)

// The single-op effect that routes every forensic question through
// `query_default`. LSP methods (Arc F.2) are `Question` variants
// over this same effect — no separate LSP substrate.
effect Query {
  ask(Question) -> QueryResult
}

// Read-only projection over the live graph and env. No handler-local
// state; all data arrives through `GraphRead + EnvRead`. Pure
// observation — write attempts fail at handler install via the row
// subsumption gate.
handler query_default {

  ask(q) => match q {

    QTypeOf(name) =>
      match env_lookup(name) {
        None => resume(QRError("not found: {name}")),
        Some(entry) => {
          let (scheme, reason, _kind) = entry
          let Forall(_, ty) = scheme
          resume(QRType(chase_type_deep(ty), reason))
        }
      },

    QTypeAt(span) => {
      // One live cursor read: tightest enclosing span → handle → the node's
      // bound type, chased deep. No throwaway TName("Unknown") chase — the
      // graph_chase below IS the live read; an unbound node's type IS its own
      // TVar (the chase terminated there), so the projection is total over the
      // NodeKind without a fabricated "Unresolved" name.
      let Graph(_, _, _, _, span_index) = graph_snapshot()
      match find_tightest(span_index, span, None, 999999999) {
        None => resume(QRError("no enclosing span found in AST index")),
        Some(handle) => {
          let GNode(kind, reason) = graph_chase(handle)
          match kind {
            NBound(ty)    => resume(QRType(chase_type_deep(ty), reason)),
            NFree(_)      => resume(QRType(TVar(handle), reason)),
            NRowBound(_)  => resume(QRType(TVar(handle), reason)),
            NRowFree(_)   => resume(QRType(TVar(handle), reason)),
            NErrorHole(_) => resume(QRType(TVar(handle), reason))
          }
        }
      }
    },

    QIntentOf(handle) =>
      // The authored intent row is a field on the FnStmt node the handle
      // names — read it LIVE (graph_node_body), never a parallel
      // intent_index re-found by scan (Carried-Truth). A non-fn node
      // carries no authored intent.
      match graph_node_body(handle) {
        NStmt(FnStmt(_, _, _, effs, _)) => resume(QRIntent(effs)),
        _ => resume(QRError("no authored intent at handle {int_to_str(handle)}")) // drift-audit: ignore
      },

    QUnresolved => {
      let Env(entries) = env_snapshot()
      resume(QRUnresolved(find_unresolved(entries)))
    },

    QSubstChain(handle) =>
      resume(QRChain(walk_chain(handle, 0))),

    QEffects(name) =>
      match env_lookup(name) {
        None => resume(QRError("not found: {name}")),
        Some(entry) => {
          let (scheme, _, _) = entry
          let Forall(_, ty) = scheme
          match chase_type_deep(ty) {
            TFun(_, _, row) => resume(QREffects(row)),
            _ => resume(QRError("{name} is not a function"))
          }
        }
      },

    QOwnership(name) =>
      match env_lookup(name) {
        None => resume(QRError("not found: {name}")),
        Some(entry) => {
          let (scheme, _, _) = entry
          let Forall(_, ty) = scheme
          match chase_type_deep(ty) {
            TFun(params, _, _) => resume(QROwnership(params)),
            _ => resume(QRError("{name} is not a function"))
          }
        }
      },

    QWhy(name) =>
      match env_lookup(name) {
        None => resume(QRError("not found: {name}")),
        Some(entry) => {
          let (_, reason, _) = entry
          // Walk the reason to ROOT — why_expand chases each Fresh(id) through
          // the graph to its resolved reason, so intent is walkable, not a chain
          // ending in dangling unification vars. The engine existed (mentl.mn:437)
          // and only why_from_handle called it; the CLI `why` now performs it too.
          resume(QRWhy(why_expand(reason, 0)))
        }
      },

    QRefsOf(name) =>
      // Every reference to NAME is a VarRef node in the one graph (the parser
      // wrote each use into the program weave). refs-of is the projection of
      // the inbound use-edges: scan the weave for NExpr(VarRef(name)) and
      // collect each node's span — read live, never an "AST index required"
      // surrender. This IS rename: the [Span] is exactly the edit set.
      resume(QRRefs(refs_of_name(name))),

    QVerifyDebt => {
      let debt = verify_debt()   // drift-audit: ignore — sequenced effectful read (stream-consumer/checkpoint), CLAUDE.md Anchor 6 exclusion
      resume(QRVerifyDebt(debt))
    },

    QHandlerProvider(op_name) =>
      // The handler stack IS graph content (PLAN §2 — "the handler chain IS
      // the capability stack"): each handler decl is a HandlerDeclStmt in the
      // weave whose arms name the ops it provides. Which handler provides OP is
      // the decl whose arms include an arm for OP — read live, never a
      // "requires active inference context" surrender. None when no handler
      // provides the op.
      resume(QRHandlerProvider(handler_providing_op(op_name))),

    QFlowOf(name) =>
      // The IFC tentacle: read the FlowLabel the type system already proves
      // for NAME, without any new graph state. The classification comes from:
      //   - TRefined: a refinement predicate naming secrecy (is_secret / is_classified)
      //   - TName: a nominal type whose name signals sensitivity (SecretKey, Token, etc.)
      //   - EfNeg in the fn's EffRow: `with !IO + !Network` proves the fn cannot
      //     route its output to public-observable sinks — that IS the Secret label.
      // This is a pure read over the existing graph. The graph IS the IFC mechanism.
      match env_lookup(name) {
        None =>
          resume(QRError("not found: {name}")),
        Some(entry) => {
          let (scheme, reason, _kind) = entry
          let Forall(_, ty) = scheme
          let label = query_flow_label(chase_type_deep(ty))
          resume(QRFlowLabel(label, reason))
        }
      },

    QUnknown(q) =>
      resume(QRError("unknown query: {q}"))
  }
}

// query_flow_label — the IFC projection (§4⑥).
// Reads FlowLabel from the Ty the graph already holds; no new state.
//
//   TRefined  — pred |> predicate_flow_label; join with base's label
//   TName     — follow env to the TypeDecl's predicate (graph-native; no string matching)
//   TFun      — row  |> row_flow_label (EfNeg IS the non-interference proof)
//   TList     — elem |> query_flow_label (label propagates through containers)
//   TTuple    — elems |> map |> fold(Public, flow_label_join)
//   TRecord   — fields |> map |> fold(Public, flow_label_join)
//   _         — Public (open-world default; unannotated = observable)
//
// H6: exhaustive over all 14 Ty constructors.
// GraphRead + EnvRead: predicate_flow_label follows PBoolNode handles into graph;
// TName arm follows the type's env entry to read its predicate.

fn query_flow_label(ref ty) with GraphRead + EnvRead = match ty {
  TRefined(base, pred) =>
    flow_label_join(pred |> predicate_flow_label, query_flow_label(base)),
  TName(name, _) =>
    // Follow the type's env entry to its TypeDecl predicate — graph-native.
    // A nominal type with a refinement predicate (e.g. `type SecretKey = Bytes
    // where is_classified(self)`) carries its IFC classification in that predicate.
    // No string matching: the graph's env entry IS the source of truth.
    match env_lookup(name) {
      None      => Public,  // unknown type: open-world default
      Some(entry) => {
        let (scheme, _, _) = entry
        let Forall(_, ty) = scheme
        match ty {
          TAlias(_, TRefined(_, pred)) => predicate_flow_label(pred),
          TRefined(_, pred)            => predicate_flow_label(pred),
          _                            => Public  // non-refined nominal: Public
        }
      }
    },
  TFun(_, _, row) =>
    row |> row_flow_label,
  TAlias(_, inner) =>
    inner |> query_flow_label,
  TList(elem) =>
    elem |> query_flow_label,
  TTuple(elems) =>
    elems
      |> map((e) => query_flow_label(e))
      |> fold(Public, (acc, lbl) => flow_label_join(acc, lbl)),
  TRecord(fields) =>
    fields
      |> map((f) => { let (_, fty) = f; query_flow_label(fty) })
      |> fold(Public, (acc, lbl) => flow_label_join(acc, lbl)),
  TRecordOpen(fields, _) =>
    fields
      |> map((f) => { let (_, fty) = f; query_flow_label(fty) })
      |> fold(Public, (acc, lbl) => flow_label_join(acc, lbl)),
  TCont(input, answer, _, _) =>
    flow_label_join(query_flow_label(input), query_flow_label(answer)),
  TInt     => Public,
  TFloat   => Public,
  TString  => Public,
  TUnit    => Public,
  TVar(_)  => Public     // unresolved: open-world default (no proof = observable)
}

// predicate_flow_label — classify a Predicate's flow sensitivity.
// PBoolNode follows the handle into the graph to read the actual call node.
// A predicate call to a function whose name signals secrecy (is_classified,
// is_secret, is_sensitive) raises the label. This reads the AUTHORED name
// from the graph — not re-deriving, reading what the graph holds.
// H6: exhaustive over all 8 Predicate variants (7 + PFlowLe).
fn predicate_flow_label(ref pred) with GraphRead = match pred {
  PTrue              => Public,
  PCompare(_, _, _)  => Public,   // numeric comparison: not a secrecy annotation
  PPatternMatch(_,_) => Public,   // match-narrowing: not a secrecy signal
  PNot(_)            => Public,   // negation of secret IS NOT secret (non-monotone)
  PFlowLe(a, _)      => a,        // the predicate itself carries the src label
  PAnd(a, b)         => flow_label_join(predicate_flow_label(a), predicate_flow_label(b)),
  POr(a, b)          => flow_label_join(predicate_flow_label(a), predicate_flow_label(b)),
  PBoolNode(h)       =>
    // Follow the handle into the graph — read the actual call node's callee name.
    // The callee name IS the authored intent; reading it is reading the graph.
    match graph_node_body(h) {
      NExpr(CallExpr(callee, _)) => {
        let N(cbody, _, _) = callee
        match cbody {
          NExpr(VarRef(fname)) =>
            if str_contains(fname, "secret") || str_contains(fname, "classified")
                 || str_contains(fname, "sensitive") { Secret }
            else { Public },
          _ => Public
        }
      },
      _ => Public
    }
}

// row_flow_label — the EfNeg in a function's row IS the non-interference proof.
// `with !IO + !Network` proves the function cannot route output to public sinks.
// EfSub(a, b) = effect subtraction: removing effects from a row never ADDS
// restriction, so the result is Public (conservative: the subtracted restriction
// is unknown). EfInter intersects rows; if either side is restricted, the
// intersection may be too. H6: exhaustive over all 6 EffRow variants.
fn row_flow_label(ref row) with Pure = match row {
  EfNeg(_)      => Secret,  // !E negation: proved absence of observable effect
  EfInter(a, b) => flow_label_join(row_flow_label(a), row_flow_label(b)),
  EfSub(_, _)   => Public,  // subtraction: removing effects, not restricting; conservative
  EfOpen(_, _)  => Public,
  EfClosed(_)   => Public,
  EfPure        => Public   // Pure IS observable-safe (no effects at all)
}



// Resolve every `TVar` transitively through the graph. Every query
// that returns a `Ty` calls this so the user sees the resolved shape,
// never raw handles.
fn chase_type_deep(ref ty) with !Mutate = match ty {
  TVar(h) => {
    let GNode(kind, _) = graph_chase(h)
    match kind {
      NBound(inner) => chase_type_deep(inner),
      _             => ty
    }
  },
  TList(elem)            => TList(chase_type_deep(elem)),
  TTuple(elems)          => TTuple(chase_list_deep(elems)),
  TFun(params, ret, eff) =>
    TFun(chase_params_deep(params), chase_type_deep(ret), eff),
  TName(name, args)      => TName(name, chase_list_deep(args)),
  TRecord(fields)        => TRecord(chase_fields_deep(fields)),
  TRecordOpen(fields, v) => mk_record_open(chase_fields_deep(fields), v),
  TRefined(base, pred)   => TRefined(chase_type_deep(base), pred),
  TCont(input, answer, disc, world) =>
    TCont(chase_type_deep(input), chase_type_deep(answer), disc, world),
  TAlias(name, inner)    => TAlias(name, chase_type_deep(inner)),
  _                      => ty
}

fn chase_list_deep(ref tys) with !Mutate = {
  if len(tys) == 0 { [] }
  else {
    [chase_type_deep(last(tys))]
      ++ chase_list_deep(drop_last(tys))
  }
}

fn chase_params_deep(ref params) with !Mutate = {
  if len(params) == 0 { [] }
  else {
    let p = last(params)
    [param_with_ty(p, chase_type_deep(param_ty(p)))]
      ++ chase_params_deep(drop_last(params))
  }
}

fn chase_fields_deep(ref fields) with !Mutate = {
  if len(fields) == 0 { [] }
  else {
    let (name, ty) = last(fields)
    [(name, chase_type_deep(ty))]
      ++ chase_fields_deep(drop_last(fields))
  }
}

// Collect all env entries whose type still chases to a free `TVar`.
// Returned by `QUnresolved` — the set of names with incomplete types
// after inference.
fn find_unresolved(ref entries) with !Mutate = {
  if len(entries) == 0 { [] }
  else {
    let (name, scheme, _reason, _kind) = last(entries)
    let Forall(_, ty) = scheme
    let rest = find_unresolved(drop_last(entries))
    if has_free_tvar(ty) { [(name, ty, [])] ++ rest }
    else { rest }
  }
}

fn has_free_tvar(ref ty) with !Mutate = match ty {
  TVar(h) => {
    let GNode(kind, _) = graph_chase(h)
    match kind {
      NFree(_)      => true,
      NBound(inner) => has_free_tvar(inner),
      _             => false
    }
  },
  TList(elem)            => has_free_tvar(elem),
  TTuple(elems)          => has_free_tvar_list(elems),
  TFun(params, ret, _)   =>
    has_free_tvar(ret) || has_free_tvar_params(params),
  TName(_, args)         => has_free_tvar_list(args),
  TRecord(fields)        => has_free_tvar_fields(fields),
  TRecordOpen(fields, _) => has_free_tvar_fields(fields),
  TRefined(base, _)      => has_free_tvar(base),
  TCont(input, answer, _, _) => has_free_tvar(input) || has_free_tvar(answer),
  TAlias(_, inner)       => has_free_tvar(inner),
  _                      => false
}

fn has_free_tvar_list(ref tys) with !Mutate = {
  if len(tys) == 0 { false }
  else {
    has_free_tvar(last(tys))
      || has_free_tvar_list(drop_last(tys))
  }
}

fn has_free_tvar_params(ref params) with !Mutate = {
  if len(params) == 0 { false }
  else {
    has_free_tvar(param_ty(last(params))) || has_free_tvar_params(drop_last(params))
  }
}

fn has_free_tvar_fields(ref fields) with !Mutate = {
  if len(fields) == 0 { false }
  else {
    let (_, ty) = last(fields)
    has_free_tvar(ty) || has_free_tvar_fields(drop_last(fields))
  }
}

// Walk every substitution hop from a starting handle to its terminal.
// Returned by `QSubstChain` — useful for tracing cross-module `TVar`
// resolution.
fn walk_chain(handle, depth) with !Mutate = {
  if depth > 50 || handle < 0 { [] }
  else {
    let node = graph_chase(handle)
    let GNode(kind, _) = node
    match kind {
      NBound(ty) => match ty {
        TVar(next) => [(handle, node)] ++ walk_chain(next, depth + 1),
        _          => [(handle, node)]
      },
      _ => [(handle, node)]
    }
  }
}

// ─── Live use-edge projection — refs-of (rename) ───────────────────
//
// Every reference to NAME is a VarRef node the parser wrote into the program
// weave. refs_of_name walks the weave and collects the span of each
// NExpr(VarRef(name)) — the inbound use-edge set, read live. No AST side-index.

fn refs_of_name(name) with GraphRead + !Mutate = {
  let Graph(_, _, next, _, _) = graph_snapshot()
  collect_var_ref_spans(name, 0, next)
}

fn collect_var_ref_spans(name, i, n) with GraphRead + !Mutate = {
  if i >= n { [] }
  else {
    let rest = collect_var_ref_spans(name, i + 1, n)
    match graph_node_body(i) {
      NExpr(VarRef(ref_name)) =>
        if ref_name == name { [span_of_handle(i)] ++ rest } else { rest },
      _ => rest
    }
  }
}

// span_of_handle — the node's source span, read live from its Reason chain
// (the parser/infer wrote Located(span, _) at the node). One graph_chase, the
// span peeled from the located reason — no parallel span-index re-lookup.
fn span_of_handle(handle) with GraphRead + !Mutate = {
  let GNode(_, reason) = graph_chase(handle)
  span_of_reason(reason)
}

fn span_of_reason(reason) with Pure = match reason {
  Located(sp, _) => sp,
  _              => span_zero()
}

// ─── Live install-edge projection — which handler provides OP ──────
//
// Each handler decl is a HandlerDeclStmt in the weave whose arms name the ops
// it provides (the handler chain IS the capability stack, PLAN §2). Scan the
// weave for the decl whose arms include OP; project its handler name.

fn handler_providing_op(op_name) with GraphRead + !Mutate = {
  let Graph(_, _, next, _, _) = graph_snapshot()
  scan_handler_for_op(op_name, 0, next)
}

fn scan_handler_for_op(op_name, i, n) with GraphRead + !Mutate = {
  if i >= n { None }
  else {
    match graph_node_body(i) {
      NStmt(HandlerDeclStmt(hname, _eff, _cfg, _state, arms)) =>
        if arms_include_op(arms, op_name) { Some(hname) }
        else { scan_handler_for_op(op_name, i + 1, n) },
      _ => scan_handler_for_op(op_name, i + 1, n)
    }
  }
}

fn arms_include_op(arms, op_name) with Pure = {
  if len(arms) == 0 { false }
  else {
    let arm = last(arms)
    if arm.op_name == op_name { true }
    else { arms_include_op(drop_last(arms), op_name) }
  }
}

// ─── Span → name — the inverse use-edge read (goto/rename anchor) ──
//
// The tightest node enclosing a span is a VarRef whose name the parser wrote
// live; name_at_span reads it (one find_tightest + one graph_node_body), the
// inverse of refs_of_name. None when the span encloses no identifier. This is
// the resolution goto-definition / find-references start from — read live, no
// position→symbol side-index.

fn name_at_span(span) with GraphRead + !Mutate = {
  let Graph(_, _, _, _, span_index) = graph_snapshot()
  match find_tightest(span_index, span, None, 999999999) {
    None         => None,
    Some(handle) => match graph_node_body(handle) {
      NExpr(VarRef(name)) => Some(name),
      _                   => None
    }
  }
}

// defining_span_of — the span where NAME is bound, read from its env entry's
// Reason (the parser/infer wrote Located(span,_) at the binding). The graph
// already proved where each name lives; goto-definition follows that edge, it
// does not re-scan. None when the name is unbound or its reason is unlocated.

fn defining_span_of(name) with GraphRead + !Mutate = {
  match env_lookup(name) {
    None        => None,
    Some(entry) => {
      let (_, reason, _) = entry
      match reason {
        Located(sp, _) => Some(sp),
        _              => None
      }
    }
  }
}

// ─── Span Index Search (Arc F.2) ───────────────────────────────────

fn span_area(s: ValidSpan) with Pure = {
  let Span(sl, sc, el, ec) = s
  if sl == el { ec - sc }
  else { ((el - sl) * 1000) + ec - sc }
}

// The MINT span of a handle — the reverse read of the span_index weave
// (fresh_handle writes (span, handle) at every mint). A node's REASON span
// can be overwritten by a later bind (a hole's reason becomes its binder's
// "declared as ..."), so a patch target must read the weave, never the
// reason. O(n) scan at felt cadence (once per accepted action); the O(1)
// form is the handle-indexed span weave (the §5.O name-is-handle sibling).
fn parse_span_of(handle) with GraphRead + !Mutate = {
  let Graph(_, _, _, _, span_index) = graph_snapshot()
  match find((pair) => { let (_, h) = pair h == handle }, span_index) {
    Some(pair) => { let (span, _) = pair span },
    None       => span_zero()
  }
}

fn find_tightest(ref idx, target, best_h, best_area) with Pure = {
  if len(idx) == 0 { best_h }
  else {
    let (s, h) = last(idx)
    if span_contains(s, target) {
      let area = span_area(s)
      if area < best_area {
        find_tightest(drop_last(idx), target, Some(h), area)
      } else {
        find_tightest(drop_last(idx), target, best_h, best_area)
      }
    } else {
      find_tightest(drop_last(idx), target, best_h, best_area)
    }
  }
}
