// query.mn — forensic substrate for the live graph (spec 08)
//
// `mentl query` is the read-only projection of the inference result.
// No mutations. No side effects. Every question reads through
// GraphRead + EnvRead; write attempts fail at handler install
// via spec 01's subsumption gate. The forensic substrate is airtight
// by type.
//
// Every LSP method (Arc F.2) is a Question variant over this same
// effect. There is no separate LSP substrate. JSON-RPC is the
// transport; tentacles are already here.

import types
import graph
import effects

/// Sum type covering every forensic question `mentl query` can pose.
/// Each variant corresponds to one `ask(Q)` arm in `query_default`.
type Question
  = QTypeOf(String)          // "type of NAME"
  | QTypeAt(Span)            // "type at L:C"
  | QIntentOf(Int)           // "intent of handle N"
  | QUnresolved              // every handle that chases to NFree
  | QSubstChain(Int)         // "subst trace for handle N"
  | QEffects(String)         // "effects of NAME"
  | QOwnership(String)       // "ownership of NAME"
  | QWhy(String)             // "why NAME" — walks reason DAG
  | QRefsOf(String)          // "refs of NAME" — for rename
  | QVerifyDebt              // "verification" — pending obligations
  | QHandlerProvider(String) // "which handler provides OP"
  | QUnknown(String)

// Predicate: is this question a why-walk? Every non-QWhy variant is
// honestly false — predicate semantics, not a fabricated value.
fn question_is_why(q) with Pure = match q {
  QWhy(_) => true,
  _       => false
}

type QueryResult
  = QRType(Ty, Reason)
  | QRIntent(List)           // [(EffName, Bool)]
  | QRUnresolved(List)       // [(name, Ty, List)]
  | QRChain(List)            // [(handle, GNode)]
  | QREffects(EffRow)
  | QROwnership(List)        // [TParam]
  | QRWhy(Reason)
  | QRRefs(List)             // [Span]
  | QRVerifyDebt(List)       // [(Span, Predicate, Reason)]
  | QRHandlerProvider(Option)// Option(String)
  | QRError(String)

/// The single-op effect that routes every forensic question through
/// `query_default`. LSP methods (Arc F.2) are `Question` variants
/// over this same effect — no separate LSP substrate.
effect Query {
  ask(Question) -> QueryResult
}

/// Read-only projection over the live graph and env. No handler-local
/// state; all data arrives through `GraphRead + EnvRead`. Pure
/// observation — write attempts fail at handler install via the row
/// subsumption gate.
handler query_default {

  ask(q) => match q {

    QTypeOf(name) =>
      match env_lookup(name) {
        None => resume(QRError("not found: {name}")),
        Some(entry) => {
          let (scheme, reason, _kind) = entry
          let Forall(_, ty) = scheme
          resume(QRType(chase_type_deep(ty), reason))
        }
      },

    QTypeAt(span) => {
      // One live cursor read: tightest enclosing span → handle → the node's
      // bound type, chased deep. No throwaway TName("Unknown") chase — the
      // graph_chase below IS the live read; an unbound node's type IS its own
      // TVar (the chase terminated there), so the projection is total over the
      // NodeKind without a fabricated "Unresolved" name.
      let Graph(_, _, _, _, span_index) = graph_snapshot()
      match find_tightest(span_index, span, None, 999999999) {
        None => resume(QRError("no enclosing span found in AST index")),
        Some(handle) => {
          let GNode(kind, reason) = graph_chase(handle)
          match kind {
            NBound(ty)    => resume(QRType(chase_type_deep(ty), reason)),
            NFree(_)      => resume(QRType(TVar(handle), reason)),
            NRowBound(_)  => resume(QRType(TVar(handle), reason)),
            NRowFree(_)   => resume(QRType(TVar(handle), reason)),
            NErrorHole(_) => resume(QRType(TVar(handle), reason))
          }
        }
      }
    },

    QIntentOf(handle) =>
      // The authored intent row is a field on the FnStmt node the handle
      // names — read it LIVE (graph_node_body), never a parallel
      // intent_index re-found by scan (Carried-Truth). A non-fn node
      // carries no authored intent.
      match graph_node_body(handle) {
        NStmt(FnStmt(_, _, _, effs, _)) => resume(QRIntent(effs)),
        _ => resume(QRError("no authored intent at handle {int_to_str(handle)}")) // drift-audit: ignore
      },

    QUnresolved => {
      let Env(entries) = env_snapshot()
      resume(QRUnresolved(find_unresolved(entries)))
    },

    QSubstChain(handle) =>
      resume(QRChain(walk_chain(handle, 0))),

    QEffects(name) =>
      match env_lookup(name) {
        None => resume(QRError("not found: {name}")),
        Some(entry) => {
          let (scheme, _, _) = entry
          let Forall(_, ty) = scheme
          match chase_type_deep(ty) {
            TFun(_, _, row) => resume(QREffects(row)),
            _ => resume(QRError("{name} is not a function"))
          }
        }
      },

    QOwnership(name) =>
      match env_lookup(name) {
        None => resume(QRError("not found: {name}")),
        Some(entry) => {
          let (scheme, _, _) = entry
          let Forall(_, ty) = scheme
          match chase_type_deep(ty) {
            TFun(params, _, _) => resume(QROwnership(params)),
            _ => resume(QRError("{name} is not a function"))
          }
        }
      },

    QWhy(name) =>
      match env_lookup(name) {
        None => resume(QRError("not found: {name}")),
        Some(entry) => {
          let (_, reason, _) = entry
          resume(QRWhy(reason))
        }
      },

    QRefsOf(name) =>
      // Every reference to NAME is a VarRef node in the one graph (the parser
      // wrote each use into the program weave). refs-of is the projection of
      // the inbound use-edges: scan the weave for NExpr(VarRef(name)) and
      // collect each node's span — read live, never an "AST index required"
      // surrender. This IS rename: the [Span] is exactly the edit set.
      resume(QRRefs(refs_of_name(name))),

    QVerifyDebt => {
      let debt = verify_debt()   // drift-audit: ignore — sequenced effectful read (stream-consumer/checkpoint), CLAUDE.md Anchor 6 exclusion
      resume(QRVerifyDebt(debt))
    },

    QHandlerProvider(op_name) =>
      // The handler stack IS graph content (PLAN §2 — "the handler chain IS
      // the capability stack"): each handler decl is a HandlerDeclStmt in the
      // weave whose arms name the ops it provides. Which handler provides OP is
      // the decl whose arms include an arm for OP — read live, never a
      // "requires active inference context" surrender. None when no handler
      // provides the op.
      resume(QRHandlerProvider(handler_providing_op(op_name))),

    QUnknown(q) =>
      resume(QRError("unknown query: {q}"))
  }
}

/// Resolve every `TVar` transitively through the graph. Every query
/// that returns a `Ty` calls this so the user sees the resolved shape,
/// never raw handles.
fn chase_type_deep(ref ty) with !Mutate = match ty {
  TVar(h) => {
    let GNode(kind, _) = graph_chase(h)
    match kind {
      NBound(inner) => chase_type_deep(inner),
      _             => ty
    }
  },
  TList(elem)            => TList(chase_type_deep(elem)),
  TTuple(elems)          => TTuple(chase_list_deep(elems)),
  TFun(params, ret, eff) =>
    TFun(chase_params_deep(params), chase_type_deep(ret), eff),
  TName(name, args)      => TName(name, chase_list_deep(args)),
  TRecord(fields)        => TRecord(chase_fields_deep(fields)),
  TRecordOpen(fields, v) => mk_record_open(chase_fields_deep(fields), v),
  TRefined(base, pred)   => TRefined(chase_type_deep(base), pred),
  TCont(ret, disc, world) => TCont(chase_type_deep(ret), disc, world),
  TAlias(name, inner)    => TAlias(name, chase_type_deep(inner)),
  _                      => ty
}

fn chase_list_deep(ref tys) with !Mutate = {
  if len(tys) == 0 { [] }
  else {
    [chase_type_deep(list_head(tys))]
      ++ chase_list_deep(list_tail(tys))
  }
}

fn chase_params_deep(ref params) with !Mutate = {
  if len(params) == 0 { [] }
  else {
    let TParam(name, ty, auth, res, default) = list_head(params)
    [TParam(name, chase_type_deep(ty), auth, res, default)]
      ++ chase_params_deep(list_tail(params))
  }
}

fn chase_fields_deep(ref fields) with !Mutate = {
  if len(fields) == 0 { [] }
  else {
    let (name, ty) = list_head(fields)
    [(name, chase_type_deep(ty))]
      ++ chase_fields_deep(list_tail(fields))
  }
}

/// Collect all env entries whose type still chases to a free `TVar`.
/// Returned by `QUnresolved` — the set of names with incomplete types
/// after inference.
fn find_unresolved(ref entries) with !Mutate = {
  if len(entries) == 0 { [] }
  else {
    let (name, scheme, _reason, _kind) = list_head(entries)
    let Forall(_, ty) = scheme
    let rest = find_unresolved(list_tail(entries))
    if has_free_tvar(ty) { [(name, ty, [])] ++ rest }
    else { rest }
  }
}

fn has_free_tvar(ref ty) with !Mutate = match ty {
  TVar(h) => {
    let GNode(kind, _) = graph_chase(h)
    match kind {
      NFree(_)      => true,
      NBound(inner) => has_free_tvar(inner),
      _             => false
    }
  },
  TList(elem)            => has_free_tvar(elem),
  TTuple(elems)          => has_free_tvar_list(elems),
  TFun(params, ret, _)   =>
    has_free_tvar(ret) || has_free_tvar_params(params),
  TName(_, args)         => has_free_tvar_list(args),
  TRecord(fields)        => has_free_tvar_fields(fields),
  TRecordOpen(fields, _) => has_free_tvar_fields(fields),
  TRefined(base, _)      => has_free_tvar(base),
  TCont(ret, _, _)       => has_free_tvar(ret),
  TAlias(_, inner)       => has_free_tvar(inner),
  _                      => false
}

fn has_free_tvar_list(ref tys) with !Mutate = {
  if len(tys) == 0 { false }
  else {
    has_free_tvar(list_head(tys))
      || has_free_tvar_list(list_tail(tys))
  }
}

fn has_free_tvar_params(ref params) with !Mutate = {
  if len(params) == 0 { false }
  else {
    let TParam(_, ty, _, _, _) = list_head(params)
    has_free_tvar(ty) || has_free_tvar_params(list_tail(params))
  }
}

fn has_free_tvar_fields(ref fields) with !Mutate = {
  if len(fields) == 0 { false }
  else {
    let (_, ty) = list_head(fields)
    has_free_tvar(ty) || has_free_tvar_fields(list_tail(fields))
  }
}

/// Walk every substitution hop from a starting handle to its terminal.
/// Returned by `QSubstChain` — useful for tracing cross-module `TVar`
/// resolution.
fn walk_chain(handle, depth) with !Mutate = {
  if depth > 50 || handle < 0 { [] }
  else {
    let node = graph_chase(handle)
    let GNode(kind, _) = node
    match kind {
      NBound(ty) => match ty {
        TVar(next) => [(handle, node)] ++ walk_chain(next, depth + 1),
        _          => [(handle, node)]
      },
      _ => [(handle, node)]
    }
  }
}

// ─── Live use-edge projection — refs-of (rename) ───────────────────
//
// Every reference to NAME is a VarRef node the parser wrote into the program
// weave. refs_of_name walks the weave and collects the span of each
// NExpr(VarRef(name)) — the inbound use-edge set, read live. No AST side-index.

fn refs_of_name(name) with GraphRead + !Mutate = {
  let Graph(_, _, next, _, _) = graph_snapshot()
  collect_var_ref_spans(name, 0, next)
}

fn collect_var_ref_spans(name, i, n) with GraphRead + !Mutate = {
  if i >= n { [] }
  else {
    let rest = collect_var_ref_spans(name, i + 1, n)
    match graph_node_body(i) {
      NExpr(VarRef(ref_name)) =>
        if ref_name == name { [span_of_handle(i)] ++ rest } else { rest },
      _ => rest
    }
  }
}

// span_of_handle — the node's source span, read live from its Reason chain
// (the parser/infer wrote Located(span, _) at the node). One graph_chase, the
// span peeled from the located reason — no parallel span-index re-lookup.
fn span_of_handle(handle) with GraphRead + !Mutate = {
  let GNode(_, reason) = graph_chase(handle)
  span_of_reason(reason)
}

fn span_of_reason(reason) with Pure = match reason {
  Located(sp, _) => sp,
  _              => span_zero()
}

// ─── Live install-edge projection — which handler provides OP ──────
//
// Each handler decl is a HandlerDeclStmt in the weave whose arms name the ops
// it provides (the handler chain IS the capability stack, PLAN §2). Scan the
// weave for the decl whose arms include OP; project its handler name.

fn handler_providing_op(op_name) with GraphRead + !Mutate = {
  let Graph(_, _, next, _, _) = graph_snapshot()
  scan_handler_for_op(op_name, 0, next)
}

fn scan_handler_for_op(op_name, i, n) with GraphRead + !Mutate = {
  if i >= n { None }
  else {
    match graph_node_body(i) {
      NStmt(HandlerDeclStmt(hname, _eff, _cfg, _state, arms)) =>
        if arms_include_op(arms, op_name) { Some(hname) }
        else { scan_handler_for_op(op_name, i + 1, n) },
      _ => scan_handler_for_op(op_name, i + 1, n)
    }
  }
}

fn arms_include_op(arms, op_name) with Pure = {
  if len(arms) == 0 { false }
  else {
    let arm = list_head(arms)
    if arm.op_name == op_name { true }
    else { arms_include_op(list_tail(arms), op_name) }
  }
}

// ─── Span Index Search (Arc F.2) ───────────────────────────────────

fn span_area(s: ValidSpan) with Pure = {
  let Span(sl, sc, el, ec) = s
  if sl == el { ec - sc }
  else { ((el - sl) * 1000) + ec - sc }
}

fn find_tightest(ref idx, target, best_h, best_area) with Pure = {
  if len(idx) == 0 { best_h }
  else {
    let (s, h) = list_head(idx)
    if span_contains(s, target) {
      let area = span_area(s)
      if area < best_area {
        find_tightest(list_tail(idx), target, Some(h), area)
      } else {
        find_tightest(list_tail(idx), target, best_h, best_area)
      }
    } else {
      find_tightest(list_tail(idx), target, best_h, best_area)
    }
  }
}

