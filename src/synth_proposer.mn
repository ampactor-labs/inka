fn cursor_session_with_full_phaseu(initial_caret)
    with Surface + GraphRead + CursorRead + Delta + Synth + Interrogate + Teach + !Mutate + EnvWrite + LookupTy + RegionTrack + Consume + Diagnostic + EnvRead + GraphWrite + Memory + Alloc = {
  cursor_session(initial_caret)
    ~> delta_default
    ~> synth_default
    ~> interrogate_default
}

