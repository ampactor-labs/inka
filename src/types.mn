// types.mn — THE vocabulary of Mentl
//
// Every ADT the compiler names. Every effect signature every module
// shares. This file is bedrock — it imports nothing; every other
// module imports it. Its surface is the narrowest possible surface
// that empowers every peer.
//
// ─── The empowerment contract ──────────────────────────────────────
// types.mn owns ONLY shared vocabulary. Every foreign-owned ADT lives
// at its natural owner:
//
//   graph.mn (spec 00)   → chase / occurs / trail revert / graph_handler
//   effects.mn (spec 01) → row algebra (normalize / subsumes / unify)
//   clock.mn (spec 11)   → Clock / Tick / Sample / Deadline + IterContext
//   own.mn (spec 07)     → affine_ledger handler arms, escape check
//   verify.mn (spec 02)  → verify_ledger handler arms
//   mentl.mn (spec 09)   → Annotation / Capability / Explanation / Patch
//                          / Context / Candidate + Teach + Synth + mentl_default
//   query.mn (spec 08)   → Question / QueryResult + query_default handler
//
// TVar(id) is a HANDLE into Graph. There is no apply(subst, ty).
// Graph chase (perform graph_chase) replaces any subst-apply pattern.
// The graph IS the subst.


// HEAP_BASE = 4096 — substrate invariant (HB / nullary-sentinel).
// The bump allocator's $heap_ptr starts at 1048576 (1 MiB).
// Sentinel values for nullary ADT variants live in [0, HEAP_BASE);
// every heap allocation is ≥ HEAP_BASE. Mixed-variant match
// dispatch in backends/wasm.mn uses this threshold to discriminate
// sentinel from pointer. Bool is the canonical example:
// `type Bool = False | True` — False=0, True=1, both sentinels.

type Ty
  = TInt
  | TFloat
  | TString
  | TUnit
  | TList(Ty)
  | TTuple(List)
  | TFun(List, Ty, EffRow)        // params: List[TParam], return, effects
  | TVar(Int)                     // handle into Graph
  | TName(String, List)           // nominal type + type args (Bool lives here)
  | TRecord(List)                 // [(name, Ty)]
  | TRecordOpen(List, Int)        // fields + row-variable handle
  | TRefined(Ty, Predicate)       // refinement type (Verify discharges)
  | TCont(Ty, ResumeDiscipline)   // handler continuation type
  | TAlias(String, Ty)            // RN.1 — authored alias name (e.g. "Port") wrapping resolved type

// ─── Ownership (spec 02 · spec 07) ─────────────────────────────────
// Every function parameter wraps Ty with an Ownership marker.
// Inference fills unmarked parameters; Own/Ref are explicit commitments.

type TParam
  = TParam(String, Ty, Ownership, Ownership, Option(Node))
                                   // name, ty, authored, resolved, default
                                   // OW.2 — authored = what developer typed (Own/Ref/Unmarked)
                                   //        resolved = what infer_ownership determined
                                   // default = Some(expr_node) when the param has a
                                   //   trailing `= expr` (SYNTAX.md §«Default parameter
                                   //   values»); None otherwise. The default node lives
                                   //   in the graph (parser-minted); lower fills an
                                   //   absent call-site arg edge by projecting it in the
                                   //   callee's scope — the default has ONE home (this
                                   //   slot) and one eval context (the callee). A
                                   //   defaulted slot leaves a DefaultReason edge.

type Ownership
  = Unmarked     // compiler decides (default)
  | Own          // affine: consumed at use (performs Consume)
  | Ref          // borrowed: cannot escape return position

// ─── Resume discipline (spec 02 · Affect POPL 2025) ────────────────
// Continuations discriminated at the type level so handler elimination
// (spec 05) and multi-shot × arena (Arc F.4) have the type hook. The
// discipline is INFERRED from each handler arm body — the infer pass
// counts resume call sites under control-flow analysis (loops /
// recursion → MultiShot; single-branch single-call → OneShot;
// branch-disjoint single-call → OneShot; gradient-undecided →
// Either) and attaches the result to the EffectOpScheme. There is
// no @resume= annotation; the body IS the contract per
// protocol_cursor_is_the_substrate.md.

type ResumeDiscipline
  = OneShot
  | MultiShot
  | Either

// ─── Scheme (spec 04) — let-generalization ─────────────────────────
// Forall(quantified_handles, body_type). A monomorphic binding is
// Forall([], ty). env_lookup returns Option<(Scheme, Reason)>.

type Scheme
  = Forall(List, Ty)

// SchemeKind discriminates env entries by their CONSTRUCTION ORIGIN.
// Same Scheme shape, three different downstream stories: lower
// dispatches on this — FnScheme → LCall/LSuspend, ConstructorScheme
// → LMakeVariant with a known tag_id, EffectOpScheme → LPerform with
// the declaring effect already attributed. The graph stores the
// distinction directly rather than re-deriving it from type shape.
//
// ConstructorScheme(tag_id, total_variants):
//   tag_id is this variant's ordinal within its declaring type
//     (0-based, deterministic from declaration order).
//   total_variants is the count over the declaring type — enables
//     pattern-exhaustiveness as a graph read at infer_match_arms.
//
// EffectOpScheme(effect_name) is the declaring effect's name.
// `perform op_name(args)` reads this to know which effect this op
// participates in without re-inspecting the row.
//
// EffectDeclKind(op_names) is the effect declaration itself.
// `env_lookup("Iterate")` reads this to know the effect's ops
// (["yield", "result"]) — the graph carries effect→ops so
// derive_ev_slots can produce per-op evidence at call sites,
// and the Cursor can project effect structure at any position.
//
type SchemeKind
  = FnScheme                                     // tag 0
  | ConstructorScheme(TagId, Int)                // tag 1
  | EffectOpScheme(String)                       // tag 2
  | RecordSchemeKind(List)                       // tag 3 — [(field_name, ty)]
  | EffectDeclKind(List)                         // tag 5 — [op_name: String]  (cache byte 5; byte 4 retired with the dissolved capability)
  | HandlerKind(String, Int, List, List, List)   // tag 6 — (handled_ename, residual_row_handle, config, state, arms)
  // HandlerKind (tag 6) is the full handler-effect type AND the handler's
  // identity: a handler is
  // (a ! E+r) ⟿ (a ! R+r) — it REMOVES the handled effect (handled_ename) AND
  // ADDS its arms' residual row (residual_row_handle, a live row var, config-
  // polymorphic). `~>` reads it: row(expr ~> h) = (row(expr) − E) ⊕ R. Without R
  // the handler-attachment can't transform the row and every map/for_each loses
  // the effects performed in its arms (protocol_handler_effect_typing).
  // ONE-GRAPH: the binding also carries the decl's (config, state, arms) — the
  // env NAMES the handler's node, so lower reads its arms/state LIVE here and
  // projects on demand (no registry, no pre-register pass). These are references
  // to the parsed decl (the one home), never copies. (config/state/arms are not
  // cache-serialized — live-only; cross-file handler caching reconstructs them
  // from the decl, peer Hβ.cache.handler-decl-from-source, post-L1.)

// The Boolean algebra lives as functions in effects.mn; the ADT
// lives here so every module that speaks types can speak rows.
// After normalization every row is one of EfPure / EfClosed / EfOpen.
// EfNeg / EfSub / EfInter are intermediate forms that reduce away.

type EffRow
  = EfPure                          // identity: no effects
  | EfClosed(List)                  // sorted, deduped [EffName]
  | EfOpen(List, Int)               // known [EffName] + row-variable handle
  | EfNeg(EffRow)                   // !E — any effect not in E
  | EfSub(EffRow, EffRow)           // E - F — always reduces to E & !F
  | EfInter(EffRow, EffRow)         // E & F — set intersection

// Effect names carry optional install-time arguments. The `with IO`
// declaration is an ENamed wrapping the name IO; `with Sample(44100)`
// is EParameterized wrapping Sample plus [EAInt(44100)]. Two
// parameterized rows match only when both NAME and ARGS coincide —
// Sample(44100) ≠ Sample(48000). The distinction lives at the type
// level only; emit erases the args.
//
// EffArg covers scalar literal arguments. Identifier / expression
// arguments (`Clock(monotonic)`) are a v2 extension — out of scope
// for the H3.1 substrate landing.

type EffName
  = ENamed(String)
  | EParameterized(String, List)    // name + [EffArg]

type EffArg
  = EAInt(Int)
  | EAFloat(Float)
  | EAString(String)
  | EAType(Ty)                     // type payload — the effect's op payload type
                                   // (Iterate(a)). Flows performer→handler at the
                                   // install; unified, not value-compared. Emit erases.

// The Boolean connective joining a surface effect term to the row
// accumulated to its left — the topology the surface `+ - &` draws
// (SYNTAX.md §«Named effect rows»: full algebra `+ - & ! Pure`).
// `!` is the per-term `negated` flag, not a connective. The first
// term carries EcUnion (joining onto the EfPure base = itself). The
// fold reads the existing effects.mn algebra live (union_row /
// diff_row / inter_row) — the parser names the connective, infer
// applies it; no row is re-derived.
type EConn
  = EcUnion                        // `+` — set union
  | EcDiff                         // `-` — set difference (E - F = E & !F)
  | EcInter                        // `&` — set intersection

// Substrate owned by graph.mn. The ADTs live here because every
// consumer of the graph names them — Read/Write/Speculate effects,
// chase return type, trail mutations, overlay tags.

type NodeKind
  = NBound(Ty)          // resolved — chase terminates; delivers Ty
  | NFree(Int)          // unresolved — epoch at allocation time
  | NRowBound(EffRow)   // resolved effect row
  | NRowFree(Int)       // unresolved effect row variable
  | NErrorHole(Reason)  // inference observed failure (Hazel marked hole)

type GNode
  = GNode(NodeKind, Reason)   // every node carries its justification

type Graph
  = Graph(
      List,    // nodes: flat array indexed by handle
      Int,     // epoch: bumps on every bind
      Int,     // next: next fresh allocation
      List,    // overlays: [(module_name, [handle])]
      List,    // span_index: [(ValidSpan, Int)] for Mentl QTypeAt queries
      List     // intent_index: [(Int, [EffName])] for QIntentOf — authored intent rows
    )

// Trail mutations — append during forward execution, walk backwards
// on rollback. Powers Mentl's speculative oracle (spec 09).

type Mutation
  = MSetNode(Int, GNode)    // handle, old_node (before overwrite)
  | MSetRow(Int, GNode)     // handle, old_node (row variant)
  | MFreshNode(Int)         // handle allocated (undo = shrink)

// 14 variants, one per operator form in SYNTAX.md's operator
// precedence table. Exhaustive set; add a variant here AND update
// every downstream match (parser op_to_binop, infer_binop,
// emit_binop) — H6's discipline applied at the AST layer. Drift
// mode 8 (string-keyed-when-structured) is closed by this ADT:
// `op: String` becomes `op: BinOp` everywhere an operator is
// dispatched on, and `OpConstraint`'s Reason-label stringifies via
// binop_to_str at the Reason-rendering boundary only.
//
// BinOpKind factors the 14 variants into 4 behavior classes used
// by infer_binop for type-class dispatch. Two orthogonal axes:
// BinOp carries operator identity (for Reason/emit); BinOpKind
// carries semantic behavior (for inference rules).

type BinOp
  = BAdd | BSub | BMul | BDiv | BMod          // arithmetic (5)
  | BEq  | BNe  | BLt  | BGt  | BLe  | BGe    // comparison (6)
  | BAnd | BOr                                 // boolean (2)
  | BConcat                                    // seq_concat over the unified sequence kind (1)

// UnaryOp — the two unary operators per SYNTAX.md operator table
// (line 1119): unary `-` and unary `!`. Mirrors BinOp's ADT discipline;
// the value-level tag is the discriminant (HB drift-6 closure: every
// nullary variant compiles to sentinel via "the heap has one story").
// Seed transcription maps to integer sentinels in the 160-179 reserved
// region (mirror of BinOp's 140-153 region).
type UnaryOp
  = UNeg                                       // unary `-` per SYNTAX.md
  | UNot                                       // unary `!` per SYNTAX.md

type BinOpKind
  = BKArith    // +, -, *, /, %
  | BKCmp      // ==, !=, <, >, <=, >=
  | BKBool     // &&, ||
  | BKConcat   // ++

fn binop_kind(op) with Pure = match op {
  BAdd    => BKArith,
  BSub    => BKArith,
  BMul    => BKArith,
  BDiv    => BKArith,
  BMod    => BKArith,
  BEq     => BKCmp,
  BNe     => BKCmp,
  BLt     => BKCmp,
  BGt     => BKCmp,
  BLe     => BKCmp,
  BGe     => BKCmp,
  BAnd    => BKBool,
  BOr     => BKBool,
  BConcat => BKConcat
}

fn binop_to_str(op) with Pure = match op {
  BAdd    => "+",
  BSub    => "-",
  BMul    => "*",
  BDiv    => "/",
  BMod    => "%",
  BEq     => "==",   // drift-audit: ignore — BinOp→canonical-string rendering for Reason labels; NOT runtime string compare. Centralizes the only "==" string-literal site in the compiler (parser op_string / infer classify_binop / wasm emit_binop no longer carry it post-11.B.1).
  BNe     => "!=",
  BLt     => "<",
  BGt     => ">",
  BLe     => "<=",
  BGe     => ">=",
  BAnd    => "&&",
  BOr     => "||",
  BConcat => "++"
}

// Every graph node and every unification records a Reason. Mentl's
// teach_why (spec 09) walks this DAG. Full provenance falls out.

type Reason
  = Declared(String)
  | Inferred(String)
  | Fresh(Int)
  | OpConstraint(String, Reason, Reason)
  | VarLookup(String, Reason)
  | FnReturn(String, Reason)
  | FnParam(String, Int, Reason)
  | MatchBranch(Reason, Reason)
  | ListElement(Reason)
  | IfBranch(Reason)
  | LetBinding(String, Reason)
  | Unified(Reason, Reason)
  | Instantiation(String, Reason)
  | UnifyFailed(Ty, Ty)
  | Placeholder(Span)
  | BinOpPlaceholder(BinOp)
  | MissingVar(String)
  | Refinement(Predicate, Predicate)
  | Located(Span, Reason)      // spec I13 — site-annotated reasoning edge
  // RX.2 — high-intent structured variants (replacing mechanism-speak strings)
  | InferredCallReturn(String, Reason)   // callee_name, inner — "return of call to 'process'"
  | InferredPipeResult(String, Reason)   // pipe_verb ("|>", "~>", "<~"), inner — verb identity in Why chain
  | FreshInContext(Int, String)          // handle, context_name — "fresh in 'process'" not "fresh 42"
  | DefaultReason(String, Span)          // a param defaulted from `= expr` at the
                                         // decl_site — the Why projection at a
                                         // defaulted call slot walks here ("`ratio`
                                         // defaulted to its declaration; annotate to
                                         // pin"). SYNTAX.md §«Default parameter values».


// Caret — the user's text-attention position. ONE input among many to
// Cursor's argmax computation. Updated by the editor's transport
// handler on every focus event (mouse, keyboard, drag-select, arrow
// keys). The caret biases the gradient argmax via proximity weighting;
// it does NOT define the cursor.
//
// (Renamed from MV-mentl-voice.md:373's `Cursor(Handle, Reason)` per
// Hμ-cursor.md §2.2 — the previous name conflated the user's text
// position with the gradient's argmax, which is drift mode 5 by
// SUBSTRATE.md §I "The Heap Has One Story" applied to handler-state
// shape.)

type Caret
  = Caret(Handle, Reason)

// Cursor — the gradient's global argmax over the live graph at the
// moment of query. Cursor is attention, not position. The text-caret
// biases the locus via proximity weighting; the caret does NOT define
// the locus. `impact` carries the argmax score: 0.0 for "no
// suggestion" / fully-annotated positions; positive finite for ranked
// auto-argmax; 1e308 sentinel for developer-pinned `??` positions per
// Hμ-cursor.md §6.
//
// See SUBSTRATE.md §VI "Cursor: The Gradient's Global Argmax" and
// `protocol_cursor_is_argmax.md`.

type Cursor
  = Cursor(Handle, Reason, Float)

// SuggestionKind — exhaustive ADT for the axis of an annotation
// suggestion. Drift 8 closure: never a string flag; always tagged
// dispatch. Per GR-gradient-delta.md §3.2 promotion to live.

type SuggestionKind
  = SuggestEffectRow
  | SuggestOwnership
  | SuggestRefinement
  | SuggestReturnType

// AnnotationSuggestion — promoted from GR-gradient-delta.md §3.2
// (was shape-only) to live ADT. teach_gradient (mentl.mn) returns
// Option(AnnotationSuggestion); CursorView.teach reads the suggestion.
//
// Fields:
//   kind        — which axis (effect-row / ownership / refinement / return)
//   annotation  — literal source text to add (e.g., "with Pure")
//   unlocks     — capability labels unlocked (e.g., ["CMemoize", "CCompileTimeEval"])
//   reason      — why the suggestion is highest-leverage at the position

type AnnotationSuggestion
  = AnnotationSuggestion(SuggestionKind, String, List, Reason)

// PipeContext — surrounding pipe topology at a position.
// CursorView.topology reads the context. Reuses existing PipeKind for
// the InsidePipe variant. Per Hμ-cursor.md §2.1 + §4.

type PipeContext
  = NoPipe
  | InsidePipe(PipeKind)
  | StartingPipe
  | EndingPipe

// CursorView — what cursor_default projects at the cursor's handle.
// Each field is one of the eight kernel primitives, read off the
// graph at the cursor's position. Eight aspects of one read.
//
//   query    — primitive #1 (Graph)            — what's bound here (NodeKind)
//   propose  — primitive #2 (Handlers)         — Synth's candidates
//   topology — primitive #3 (Five verbs)       — pipe context at the site
//   row      — primitive #4 (Effect algebra)   — gating row
//   trace    — primitive #5 (Ownership)        — own/ref/inferred (existing ADT)
//   verify   — primitive #6 (Refinement)       — pending obligations
//   teach    — primitive #7 (Gradient)         — one next-step (or None)
//   why      — primitive #8 (HM + Reasons)     — walkable Reason chain
//
// Annotation is mentl.mn's existing ADT (8 variants APure/ANotAlloc/...).
// Predicate is at types.mn:568.

type CursorView
  = CursorView(NodeKind, List, PipeContext, EffRow, Ownership, List, Option, Reason)
                              // query   propose  topology     row     trace      verify  teach    why


type Span
  = Span(Int, Int, Int, Int)    // start_line, start_col, end_line, end_col

fn span_join(a, b) with Pure = {
  let Span(sl, sc, _, _) = a
  let Span(_, _, el, ec) = b
  Span(sl, sc, el, ec)
}

fn span_eq(a, b) with Pure = {
  let Span(asl, asc, ael, aec) = a
  let Span(bsl, bsc, bel, bec) = b
  asl == bsl && asc == bsc && ael == bel && aec == bec
}

// Closed-interval overlap on line numbers. Sufficient for the
// proximity-tier classification; column-precise comparison is
// peer-handle territory.
fn span_overlaps(a, b) with Pure = {
  let Span(asl, _asc, ael, _aec) = a
  let Span(bsl, _bsc, bel, _bec) = b
  ael >= bsl && bel >= asl
}

fn span_zero() with Pure = Span(0, 0, 0, 0)

// Inference + Verify ledger discharges obligations at construction
// sites. Runtime-erased. Failed discharge surfaces as V_Pending or
// V_Failed diagnostic with the predicate and the failing expression
// span.

type Handle = Int where 0 <= self
type TagId = Int where 0 <= self && self <= 255
type ValidOffset = Int where 0 <= self
type NonEmptyList = List where len(self) > 0

fn span_valid(s) with Pure = {
  let Span(sl, sc, el, ec) = s
  sl >= 0 && sc >= 0 && el >= sl && (el > sl || ec >= sc)
}

type ValidSpan = Span where span_valid(self)

fn span_contains(outer, inner) with Pure = {
  let Span(osl, osc, oel, oec) = outer
  let Span(isl, isc, iel, iec) = inner
  (osl < isl || (osl == isl && osc <= isc))
    && (oel > iel || (oel == iel && oec >= iec))
}

// Tokens are the lexer's output; the parser's input. The wrapper
// pattern mirrors AST nodes: structured value + positional metadata.
// `N(NodeBody, Span, Int)` for nodes; `Tok(TokenKind, Span)` for
// tokens. Same shape, two layers. Accessors are uniform across both.
//
// TokenKind enumerates the 64 lexical forms specified in SYNTAX.md
// — 19 keywords, 7 identifiers/literals (with payload), 14 two-char
// operators, 22 single-char operators/punctuation, 2 layout. The
// parser dispatches via exhaustive `match Tok(kind, _) { … }`;
// adding a TokenKind variant fails compilation across every match
// site until the variant is handled (H6's discipline at the lexical
// layer).

type Token = Tok(TokenKind, Span)

type TokenKind
  // ─── Keywords (20) ───────────────────────────────────────────────
  = TFn | TLet | TIf | TElse | TMatch | TType
  | TEffect | THandle | THandler | TWith
  | TResume | TPerform

  | TImport | TWhere
  | TOwn | TRef | TPure
  | TTrue | TFalse

  // ─── Identifiers and literals (7) ────────────────────────────────
  | TIdent(String)
  | TIntLit(Int)
  | TFloatLit(Float)
  | TStringLit(String)
  | TComment(String)                // // — every comment is graph content,
                                    //   attached to the next decl / enclosing node
  | TStringPart(String)             // literal chunk of a "..." string
                                    //   (amendment C brace-interpolation)
  | TStringSplice                   // marks the start of a {expr} splice;
                                    //   followed by ordinary tokens then
                                    //   TRBrace (re-used) closes it

  // ─── Two-character operators (14) ────────────────────────────────
  | TEqEq | TBangEq | TLtEq | TGtEq          // comparison
  | TArrow | TFatArrow                       // -> and =>
  | TPlusPlus                                // ++ concat
  | TPipeGt | TLtPipe | TGtLt | TTildeGt | TLtTilde   // five verbs
  | TAndAnd | TOrOr                          // logical

  // ─── Single-character operators and punctuation (23) ─────────────
  | TLParen | TRParen | TLBrace | TRBrace | TLBracket | TRBracket
  | TComma | TDot | TColon | TSemicolon
  | TPlus | TMinus | TStar | TSlash | TPercent
  | TEq | TLt | TGt | TBang
  | TAmp                            // `&` — effect-row intersection (EfInter);
                                    // the surface of the Boolean row algebra's `&`
                                    // (SYNTAX.md §«Named effect rows»). `&&` is the
                                    // distinct TAndAnd (logical and); maximal munch
                                    // lexes `&&` before a bare `&` reaches here.
  | TPipe | TTilde | TAt | THole

  // ─── Layout / structural (2) ─────────────────────────────────────
  | TNewline                        // statement separator; transparent around binops (layout is never semantics)
  | TEof                            // end of input — always last

// Token accessors — uniform with N-pattern accessors.

fn token_kind(t) with Pure = let Tok(k, _) = t; k
fn token_span(t) with Pure = let Tok(_, s) = t; s

// Every expression site is an N(body, span, handle). The handle is
// allocated at parse time via graph_fresh_ty(Placeholder(span)) and
// populated during inference. No null handle. No sentinel zero.
// Type resolution is always a live chase via LookupTy — never a
// cached Ty field.

type Node
  = N(NodeBody, Span, Int)   // body, span, TypeHandle

fn span_of_node(node) = {
  let N(_, span, _) = node
  span
}

type NodeBody
  = NExpr(Expr)
  | NStmt(Stmt)
  | NPat(Pat)
  | NHole(Int)               // Hazel marked hole — inference populates with reason
  // Synthetic module entity — one per source file. An orphan module-level
  // comment attaches to this handle in the comment weave (graph_attach_comment);
  // decls lists every top-level Handle so F.1's doc_handler and render_index can
  // walk the module without re-parsing source.
  | NModule({path: String, decls: List, span: Span})

// ─── Expr (spec 03) ────────────────────────────────────────────────

type Expr
  = LitInt(Int)
  | LitFloat(Float)
  | LitString(String)
  | LitBool(Bool)
  | LitUnit
  | VarRef(String)
  | BinOpExpr(BinOp, Node, Node)
  | UnaryOpExpr(UnaryOp, Node)
  | CallExpr(Node, List)
  | LambdaExpr(List, Node)         // params: List[TParam], body
  | IfExpr(Node, Node, Node)
  | BlockExpr(List, Node)          // stmts, final expr
  | MatchExpr(Node, List)          // scrutinee, arms
  | PerformExpr(String, List)      // op name, args
  | ResumeExpr(Node, List)         // value, state updates
  | MakeListExpr(List)
  | MakeTupleExpr(List)
  | MakeRecordExpr(List)           // [(field_name: String, value: Node)] — sorted at parse
  | RecordUpdateExpr(Node, List)   // {...base, f: v, ...} — non-destructive update:
                                   // copy base's fields, overwrite/add the listed
                                   // [(name, value)] (sorted). base is owned-read,
                                   // not mutated (SYNTAX.md §«Record update»). One
                                   // spread base per literal; the override fields
                                   // are the same product-field machinery as
                                   // MakeRecordExpr.
  | NamedRecordExpr(String, List)  // type_name + sorted fields — nominal record literal
  | IndexExpr(Node, Node)          // `xs[i]` semantic AST — receiver, index.
                                   // Infer dispatches on receiver's type:
                                   // TList → list_index (runtime); TTuple →
                                   // compile-time slot from constant index;
                                   // TRecord by int-key → record_get. The eager
                                   // parse-time fold to CallExpr(VarRef("list_index"))
                                   // was drift mode 9 (eager-form-commitment) —
                                   // it committed the dispatch before infer knew
                                   // the receiver's shape. Per #139.
  | MakeStringExpr(List)           // string interpolation fragments — Node list
                                   // where each Node is either NExpr(LitString(s))
                                   // for literal chunks OR an arbitrary expression
                                   // node for a splice. Semantic-preserving form
                                   // per #138; parser produces this instead of an
                                   // eager str_concat fold so infer can narrow
                                   // (each splice must be Showable) and the
                                   // gradient can teach which splices are constant
                                   // (foldable at compile time) per Mentl-ultimate
                                   // string-substrate discipline.
  | FieldExpr(Node, String)
  | PipeExpr(PipeKind, Node, Node) // |> <| >< ~> <~
  | ExprPlaceholder                // ? — parser spawns NHole

// ─── The five verbs (spec 10) ──────────────────────────────────────
// Shape IS the computation graph. Formatter (a handler) emits
// sequential ops at left edge; convergent ops at indented center.

// ~> has ONE precedence (1, the loosest binary operator — SYNTAX.md
// §Precedence): the handler at the foot of a chain governs everything
// to its left; parenthesize to narrow. Layout is never semantics —
// block vs inline on the page is the formatter's projection of the
// same PTee node.
type PipeKind
  = PForward      // |>   converge — transparent wire
  | PDiverge      // <|   fanout — borrows input to all branches
  | PCompose      // ><   parallel compose — independent inputs, tupled
  | PTee          // ~>   handler-attach — governs the whole chain to its left
  | PFeedback     // <~   feedback — closes cycle under ambient clock

// FeedbackSpec (spec I10) — the RHS shape of `<~`. Recognized by
// inference to desugar the feedback verb into a stateful handler
// capturing previous output as state. Three variants cover the
// DESIGN Ch 6 DSP/control surface: a Z^-1 delay line, a
// state-carrying closure, and a digital filter of N taps.
type FeedbackSpec
  = FbState(Ty)                   // typed state cell; RHS is a carrier
  | FbDelay(Int)                  // unit-delay lookback of N samples
  | FbFilter(Int, List)           // N-tap filter with coefficient list

// Region (spec I12) — Tofte-Talpin region identity for escape
// analysis. Each `handle ... with mem_arena` scope produces a
// region; values allocated inside the region carry that region as a
// tag. A value cannot escape the scope that outlives its region —
// the return-position check uses region identity, not pointer
// reachability, making the analysis O(1) per return edge.
//
// The Region ADT is a pair: a unique region id (fresh per
// arena install) and the span where the region was installed.
// Span tracking lets escape diagnostics point at the ORIGINAL
// region site rather than the escape attempt alone.
type Region
  = Region(Int, Span)

// RegionTrack (spec I12) — intercepts alloc sites to tag each value
// with its originating region; checks values at return sites for
// escape. Today's effect shape is substrate-prep: arms wire into
// the Alloc effect surface (which surfaces with full W5 arena
// semantics and the existing Consume ownership ledger). The
// region_tracker handler lives in own.mn — region_enter pushes a
// fresh Region id onto a stack; region_exit pops; tag_alloc stamps
// the current-top region onto an alloc return; check_escape
// compares a returned value's region against the ambient region
// on fn return.
fn mk_tok(kind, sl, sc, el, ec) with Pure = Tok(kind, Span(sl, sc, el, ec))
effect RegionTrack {
  region_enter(Span) -> Int
  region_exit(Int) -> ()
  tag_alloc(Int) -> ()
  tag_alloc_join(Int, List) -> ()
                                                  // value_handle, field_handles —
                                                  // tag with the deepest (innermost)
                                                  // region across (current, fields).
                                                  // Used by record/variant construction.
  check_escape(Int, Span) -> ()
  current_region() -> Int
}

// StringTable (spec W5) — compile-time interned string literals.
// emit_module collects every LString in the lowered program, assigns
// each unique literal a 4-byte-aligned offset in the string-data
// region (0x10000..0x100000), and emits `(data ...)` segments. At
// LString emit time, `string_offset(s)` returns the interned offset;
// the generated WAT is `(i32.const <offset>)` with zero runtime
// construction. `set_string_entries` is called once by emit_module
// after collection to populate the handler's state.
effect StringTable {
  string_offset(String) -> Int
  set_string_entries(List) -> ()
}

// Evidence (spec W4) — runtime witness of an effect-to-handler-arm
// binding. A polymorphic function that performs `op_name` dispatches
// via an evidence slot: the caller threads the evidence record into
// the callee via `__state`, and the callee loads the arm's fn_idx
// from slot `slot_idx` and invokes it through call_indirect.
//
// DESIGN Ch 4 "handler IS state" — closure captures and evidence
// slots are both frozen handler state, projections of the same
// underlying record. `__state`'s layout:
//   offset 0        : fn_ptr (i32, table index)
//   offset 4        : capture_count (i32)
//   offset 8+4*i    : capture_i          (for i in 0..capture_count)
//   offset 8+4*C+4*j: evidence_j_fn_idx  (for j in 0..ev_count, C = capture_count)
// The body's ev_count and capture_count are known at emit time;
// LEvPerform's offset arithmetic is compile-time-resolved.
type Evidence
  = Ev(String, Int)   // op_name, slot_idx — the slot in __state where
                      // the arm's fn_idx was written by the caller.

// ─── BodyContext (H1) ──────────────────────────────────────────────
// Per-fn-body emit-time metadata: how many captures the body's
// closure has (the fence between captures and evidence in __state)
// and the body's evidence shape (which ops resolve through which
// slots). Set at emit_fn_body entry; read by LEvPerform's offset
// arithmetic and any future evidence-aware emit site.

effect BodyContext {
  current_body_captures() -> Int
  set_body_captures(Int) -> ()
  current_body_evidence() -> List
  set_body_evidence(List) -> ()
}

// ─── Stmt (spec 03) ────────────────────────────────────────────────

type Stmt
  = LetStmt(Pat, Node)
  | FnStmt(String, List, Node, List, Node)
                           // name, params (TParam), retty, effects, body
  | TypeDefStmt(String, List)
                           // name, type args, variants
  | EffectDeclStmt(String, List)
                           // effect name, ops (each is (op_name, param_tys, ret_ty);
                           // ResumeDiscipline is inferred at handler-decl time
                           // from each arm body, not declared on the effect op)
  | HandlerDeclStmt(String, String, List, List({init: Node, name: String}), List)
                           // handler name, effect name, config-params, state-fields, arms
                           // config: [String] — closure-captured at install site
                           // state:  List<{name: String, init: Node}> — per-arm scope; updates via `resume(...) with f = e`
                           // The state element type is CARRIED in the ADT field
                           // (not bare `List`) so `.name`/`.init` resolve to sorted
                           // offsets at lower-time — never field-offset-resolution's
                           // silent offset-0 fabrication on an erased element type.
                           // arms:   List<{args, body, op_name}>
                           // Per Hβ.first-light.handler-config-state-substrate (2026-05-06):
                           // config + state extracted at parse time; bound in arm scope at infer + lower
  | ExprStmt(Node)
  | ImportStmt(String)
  | RefineStmt(String, Ty, Predicate)
                           // type X = T where P — nominal refinement
  | AliasStmt(String, Ty)
                           // type X = T — transparent alias (no `where`, RHS a
                           // single type-expression, not a record literal, not a
                           // `|`-alternation). Infer registers TAlias(X, T); X and
                           // T unify transparently (SYNTAX.md §«Type aliases»). The
                           // authored name travels in the TAlias for Reason chains.

// ─── Pat (spec 03) ─────────────────────────────────────────────────

type Pat
  = PVar(String)
  | PWild
  | PLit(LitValue)
  | PCon(String, List)
  | PTuple(List)
  | PList(List, Option)    // prefix pats, optional rest name (`...rest`)
  | PRecord(List)           // [(fieldname, Pat)]
  | PAlt(List)              // pat_1 | pat_2 | ... — any branch matches; branches
                            // bind the same names with unifiable types (SYNTAX.md
                            // §"Pattern alternation — rule")

type LitValue
  = LVInt(Int)
  | LVFloat(Float)
  | LVString(String)
  | LVBool(Bool)

// Decidable shape. Verify discharges: ledger (Phase 1) accumulates;
// verify_smt (Arc F.1) routes by theory — Z3 / cvc5 / Bitwuzla.

type Predicate
  = PTrue
  | PCompare(BinOp, Int, Int)    // op over two operand node HANDLES — graph_node_body resolves each Expr live; the AST lives in the graph, the predicate carries the edge
  | PAnd(Predicate, Predicate)
  | POr(Predicate, Predicate)
  | PNot(Predicate)
  | PBoolNode(Int)               // predicate IS a bool expr node, by handle (a boolean call or bare bool var folds in here)
  | PPatternMatch(Pat, Int)      // scrutinee node handle matches pat — match-narrowing

// PExpr is GONE: its leaves (PSelf/PInt/PEVar/PApp) were a lossy COPY of the
// expression the AST node already holds (`node_to_pexpr` re-derived it with a
// `_ => PEVar("?")` surrender). The predicate now carries the live operand Node
// and Verify reads its Expr live — carry the handle, read live, delete the copy.


type Option
  = None
  | Some(a)

// Scoped bindings via push/pop mark. Env is never passed as argument.
// Every read performs env_lookup; every write performs env_extend.
// Entries are 4-tuples (name, Scheme, Reason, SchemeKind) — SchemeKind
// carries construction-origin metadata that lower dispatches on.

type Env
  = Env(List)   // [(name, Scheme, Reason, SchemeKind)]

effect EnvRead {
  env_lookup(String) -> Option
  env_snapshot() -> Env
}

effect EnvWrite {
  env_extend(String, Scheme, Reason, SchemeKind) -> ()
  env_scope_enter() -> ()
  env_scope_exit() -> ()
}

// The Read/Write split IS the "one writer" invariant. Inference
// declares both; lowering, query, display declare Read only.
// A perform graph_bind in a read-only handler is a type error at
// handler install — caught structurally, never shipped to runtime.
//
// graph_push_checkpoint / graph_rollback are the speculative surface:
// Mentl's oracle captures the trail length, tries a tentative patch,
// rolls back to restore. Trail-based; O(M) where M is mutations.

effect GraphRead {
  graph_chase(Int) -> GNode
  graph_chase_handle(Int) -> Int    // the canonical ROOT handle of a TVar chain (union-find find)
  graph_epoch() -> Int
  graph_next() -> Int                 // the fresh-handle counter — the node-space bound for saturation
  graph_reason_edge(Int, Int) -> Reason
  graph_snapshot() -> Graph
  graph_push_checkpoint() -> Int
  graph_node_body(Int) -> NodeBody    // resolve a node's body by its handle from the parallel program weave — every AST node is registered there at construction (NHole if absent)
  graph_comment_at(Int) -> String     // resolve a node's parse-attached comment prose from the parallel comment weave (empty string if absent); the Why engine / formatter / cursor project it
}

effect GraphWrite {
  graph_fresh_ty(Reason) -> Handle
  graph_fresh_row(Reason) -> Handle
  graph_register_node(Int, NodeBody) -> ()    // edge-link a node's body into the one graph at its handle (the parallel program weave); resolves via graph_node_body
  graph_attach_comment(Int, String) -> ()      // attach parse-collected comment prose to a node's handle (the parallel comment weave); resolves via graph_comment_at — a comment is graph content
  graph_bind(Int, Ty, Reason) -> ()
  graph_bind_row(Int, EffRow, Reason) -> ()
  graph_fork(String) -> ()
  graph_rollback(Int) -> ()
  graph_index_span(ValidSpan, Int) -> ()
  // Per Hβ.first-light.graph-index-intent-effect-decl: graph_handler's
  // arm graph_index_intent (graph.mn:240) was undeclared in any effect.
  // parse_fn at parser.mn:396 perform-calls it. Infer couldn't ground
  // → handle's Ty = TError-hole → emit_lconst's TError-hole branch
  // produced (unreachable) → mentl2 trapped on parse_fn for any input
  // containing `fn`. Effect decl IS the substrate-honest residue.
  graph_index_intent(Int, List) -> ()
}

// Every perform report names a code whose docs/errors/<CODE>.md entry
// exists. applicability ∈ { MachineApplicable, MaybeIncorrect }.
// The !Diagnostic gate lives on the handler, not the effect.

effect Diagnostic {
  report(String, String, String, String, Span, String) -> ()
  // source, code, kind, msg, span, applicability
}

/// Universal short-circuit / early return.
/// Flattens the "Option Monad" into the topological pipeline.
/// `abort` is inferred OneShot despite `-> !`: OneShot's semantics
/// is "at most once" (zero ≤ 1) and "continuation on stack, no
/// heap capture" — both true for a handler arm that never calls
/// resume. The infer pass counts zero resume sites in `catch_abort`-
/// shape arms and produces `OneShot` (count ≤ 1 → OneShot).
effect Abort {
  abort() -> !
}

/// Mutation capability marker.
/// !Mutate on a function proves read-only access to all parameters.
/// Vale-style region-freeze: "N parallel readers, no writers" through
/// the same Boolean algebra that proves !Alloc and !IO.
/// Mutate carries the graph_mutated event — performed by graph_handler
/// at the OUTERMOST commit boundary so the IC fixpoint (the oracle's
/// project_queue_merger, src/oracle.mn) re-projects only on real graph
/// state changes. Speculative writes between graph_push_checkpoint /
/// graph_rollback never reach this op — Mentl's own oracle would
/// otherwise subscribe to her speculations and recursively explore
/// forever.
///
/// epoch — graph epoch at which the mutation committed. The epoch IS the
/// one cache key: the IC projection memoizes by it, re-deriving the queue
/// only when the epoch bumps (PLAN §2: read live is the meaning, cached
/// by epoch is the mechanism).
/// Mutation — MSetNode | MSetRow | MFreshNode (per the Mutation type at
/// src/types.mn:163). The event carries enough for the projection to
/// re-derive over the changed graph (Q-2 (B) scope: transitive dependents
/// via Reason chain).

effect Mutate {
  graph_mutated(Int, Mutation) -> ()
}

// The ONLY route from a TypeHandle to a resolved Ty. Delegates to
// graph_chase. No cache. No staleness. Every observer reads live.

effect LookupTy {
  lookup_ty(Int) -> Ty
}

// Inference mints via graph_fresh_ty; query mints display ids. One
// function, two handlers, different semantics for the same op.

effect FreshHandle {
  mint(Reason) -> Int
  mint_row(Reason) -> Int
}

// Tracks the stack of (locals, captures) frames so VarRef can resolve
// to LLocal / LUpval / LGlobal at lower time. LambdaExpr computes its
// captures via collect_free_vars + ls_resolve in the OUTER frame,
// then ls_enter_frame with (params, captures). Body lowering
// dispatches every VarRef through ls_resolve. Closure heap records
// materialize from the captures_exprs list in LMakeClosure.

type Resolution
  = RLocal          // name is a local of the current frame — emit references $<name>
  | RUpval(Int)     // name is captured at slot; emit offset-loads from __state
  | RGlobal         // top-level name — emit references $<name> as a global

// `ls_resolve` returns (Resolution, type_handle) where type_handle is
// the type handle the local was BOUND with (via ls_bind_local). For
// captured names (RUpval) the handle is the local's own handle from
// the enclosing frame — the LowExpr describing the captured value's
// type. RGlobal returns the var-ref's enclosing handle (caller-side
// fallback). This is the W7 + A1 capture-handle correctness fix.

effect LowerScope {
  ls_enter_frame(String, List, List, List, List) -> ()  // fn_name, locals_names, locals_handles, captures_names, captures_handles
  ls_exit_frame() -> ()
  ls_bind_local(String, Int) -> Int  // append (name, handle); returns slot
  ls_resolve(String) -> (Resolution, Int)
  ls_register_globals(List) -> ()
  ls_outer_fn_name() -> String  // closest enclosing named-fn frame; "" for top-level
  ls_push_scope() -> Int  // checkpoint = current frame's local count
  ls_pop_scope(Int) -> ()  // truncate frame locals back to checkpoint
}

// Every refinement unification performs verify(span, pred, reason).
// verify_ledger accumulates (V_Pending); verify_smt discharges (E_RefinementRejected on
// reject). Handler swap; source code unchanged.

effect Verify {
  verify(Span, Predicate, Reason) -> ()
  verify_debt() -> List
}

// Every use of an own-parameter performs consume(name, span).
// affine_ledger enforces linearity; declares with !Consume so its
// own arms cannot recurse through consume. Structural gate.
//
// Branching ops (W2) implement the `><` / `<|` branching ledger:
// at branch_enter, the handler stashes `used` as a base; branch_divider
// captures the delta since base, stashes it in the frame, resets used
// to base; branch_exit captures the final branch's delta, pairwise-
// checks collisions (same name consumed in two branches →
// E_OwnershipViolation), unions all deltas into used, pops the frame.

effect Consume {
  consume(String, Span) -> ()
  branch_enter() -> ()
  branch_divider(Span) -> ()
  branch_exit(Span) -> ()
}

// Four ops cover the incremental-compilation cache layer (.kai
// read/write, mkdir, exists). Operates relative to a preopen fd
// (wasmtime's --dir=. grants preopen fd 3 by convention).
//
// Row semantics: `with Filesystem` declares the function MAY touch
// the filesystem. `with !Filesystem` PROVES it does not — audit-
// driven linker severance can drop path_open / fd_close / etc.
// imports from binaries with proven !Filesystem.
//
// v1 takes preopen fd 3 as implicit. Parameterization via
// `with Filesystem("/workspace")` (H3.1 parameterized effects)
// lands when audit-driven permission scopes become meaningful.
//
// Returns bytes as a flat Mentl String (length prefix + bytes) —
// same shape as read_stdin for uniform downstream handling.

effect Filesystem {
  // ─── Original 4 ops (FS walkthrough; commit 1debfdc) ──────────
  fs_exists(String) -> Bool
  fs_read_file(String) -> String
  fs_write_file(String, String) -> ()
  fs_mkdir(String) -> ()

  // ─── FX.A.basics extension ops (FX walkthrough §1) ────────────
  // Cover the FileHandle-shaped surface Mentl-voice's Interact ops
  // need. Returns are domain-free (Int fd / Bool errno); ADT
  // projection (FileHandle / TreeEntry) lifted to mentl_voice_filesystem
  // handler per FX walkthrough §3.1.
  //
  // fs_list_dir lands separately as FX.A.dirent (dirent record parsing
  // is its own focused sub-handle).

  fs_open(String) -> Int
  fs_close(Int) -> ()
  fs_unlink(String) -> Bool
  fs_rename(String, String) -> Bool
}

// Every show_* that renders a Ty chases TVars through graph_chase.
// A raw handle only appears when chase terminates on NFree/NRowFree —
// the query layer reads that as "unresolved at epoch e." No cached
// display. Same discipline as lowering: live observer, never mirror.

fn show_type(ref ty) with GraphRead + !Mutate = {
  match ty {
    TInt    => "Int",
    TFloat  => "Float",
    TString => "String",
    TUnit   => "()",
    TList(elem) => "List({show_type(elem)})",
    TTuple(elems) => "({show_list(elems, show_type, ", ")})",
    TFun(params, ret, row) =>
      "({show_list(params, show_tparam, ", ")}) -> {show_type(ret)}{show_row_suffix(row)}",
    TVar(id) => show_handle(id),
    TName(name, args) =>
      "{name}{show_type_args(args)}",
    TRecord(fields) => "\{ {show_list(fields, show_field, ", ")} \}",
    TRecordOpen(fields, v) =>
      "\{ {show_list(fields, show_field, ", ")} | {show_handle(v)} \}",
    TRefined(base, pred) => "{show_type(base)} where {show_predicate(pred)}",
    TCont(ret, disc) => "Cont({show_type(ret)}, {show_discipline(disc)})",
    // RN.1 — show the alias name (intent), not the resolved type
    TAlias(name, _) => name
  }
}

// show_handle — the live-chase projection. Resolved handles show the
// bound type; free handles show the raw handle with allocation epoch
// so query can surface "unresolved at epoch e"; error holes show the
// failure reason inline.

fn show_handle(h) with GraphRead + !Mutate = {
  let node = perform graph_chase(h)
  match node {
    GNode(NBound(ty), _)      => show_type(ty),
    GNode(NRowBound(row), _)  => show_effrow(row),
    GNode(NFree(epoch), _)    => "t{int_to_str(h)}@e{int_to_str(epoch)}",
    GNode(NRowFree(epoch), _) => "r{int_to_str(h)}@e{int_to_str(epoch)}",
    GNode(NErrorHole(reason), _) => "!hole[{show_reason(reason)}]"
  }
}

fn show_tparam(ref tp) with GraphRead + !Mutate = {
  let TParam(name, ty, authored, resolved, _) = tp
  let base = "{name}: {show_type(ty)}"
  match authored {
    Unmarked => match resolved {
      Unmarked => base,
      _        => "{base}{show_ownership(resolved)} — inferred"
    },
    _ => "{base}{show_ownership(authored)} — declared"
  }
}

fn show_ownership(o) with Pure = {
  match o {
    Unmarked => "",
    Own      => " own",
    Ref      => " ref"
  }
}

fn show_discipline(d) with Pure = {
  match d {
    OneShot   => "OneShot",
    MultiShot => "MultiShot",
    Either    => "Either"
  }
}

fn show_field(ref field) with GraphRead + !Mutate = {
  let (name, ty) = field
  "{name}: {show_type(ty)}"
}

fn show_type_args(ref args) with GraphRead + !Mutate = {
  if len(args) == 0 { "" }
  else { "({show_list(args, show_type, ", ")})" }
}

fn show_row_suffix(ref row) with GraphRead + !Mutate = {
  match row {
    EfPure => "",
    _      => " with {show_effrow(row)}"
  }
}

fn show_effrow(ref row) with GraphRead + !Mutate = {
  match row {
    EfPure            => "Pure",   // drift-audit: ignore — human-facing rendering string for diagnostics/show; not an effect-keyed lookup; tracked for item 11.B effect-rendering normalization
    EfClosed(names)   => show_list(names, show_eff_name, " + "),
    EfOpen(names, v)  =>
      if len(names) == 0 { show_handle(v) }
      else { "{show_list(names, show_eff_name, " + ")} + {show_handle(v)}" },
    EfNeg(inner)  => "!{show_effrow(inner)}",
    EfSub(a, b)   => "{show_effrow(a)} - {show_effrow(b)}",
    EfInter(a, b) => "{show_effrow(a)} & {show_effrow(b)}"
  }
}

fn show_eff_name(ref name) with !Mutate = match name {
  ENamed(n)               => n,
  EParameterized(n, args) => "{n}({show_list(args, show_eff_arg, ", ")})"
}

fn show_eff_arg(ref arg) with !Mutate = match arg {
  EAInt(n)    => int_to_str(n),
  EAFloat(_)  => "<float>",
  EAString(s) => "\"{s}\"",
  EAType(_)   => "<type>"
}

fn show_predicate(ref pred) with GraphRead = {
  match pred {
    PTrue      => "true",
    PCompare(op, a, b) => "{show_pred_operand(a)} {show_cmp_op(op)} {show_pred_operand(b)}",
    PAnd(a, b) => "{show_predicate(a)} && {show_predicate(b)}",
    POr(a, b)  => "{show_predicate(a)} || {show_predicate(b)}",
    PNot(p)    => "!{show_predicate(p)}",
    PBoolNode(n) => show_pred_operand(n),
    PPatternMatch(_, n) => "{show_pred_operand(n)} matches _"
  }
}

fn show_cmp_op(ref op) with !Mutate = match op {
  BEq => "==",
  BLt => "<",
  BLe => "<=",
  _   => "?"
}

// Resolve a predicate operand HANDLE to its Expr live and render it.
fn show_pred_operand(handle) with GraphRead = {
  match perform graph_node_body(handle) {
    NExpr(VarRef(name)) => name,
    NExpr(LitInt(n))    => int_to_str(n),
    NExpr(LitFloat(f))  => float_to_str(f),
    NExpr(LitString(s)) => "\"{s}\"",
    NExpr(CallExpr(callee, _)) => "{show_callee_name(callee)}(...)",
    _                   => "<expr>"
  }
}

fn show_callee_name(ref callee) with !Mutate = {
  let N(cbody, _, _) = callee
  match cbody {
    NExpr(VarRef(n)) => n,
    _                => "_"
  }
}

fn show_reason(ref reason) with GraphRead + !Mutate = {
  match reason {
    Declared(name)             => "declared as {name}",
    Inferred(ctx)              => "inferred from {ctx}",
    Fresh(id)                  => "fresh {show_handle(id)}",
    OpConstraint(op, l, r)     => "operator {op} constrains {show_reason(l)} with {show_reason(r)}",
    VarLookup(name, inner)     => "lookup {name} → {show_reason(inner)}",
    FnReturn(name, inner)      => "return of {name} → {show_reason(inner)}", // drift-audit: ignore — "return of" is a Reason rendering string, not a control keyword
    FnParam(name, idx, inner)  => "param {int_to_str(idx)} of {name} → {show_reason(inner)}",
    MatchBranch(a, b)          => "match branch: {show_reason(a)} ~ {show_reason(b)}",
    ListElement(inner)         => "list element: {show_reason(inner)}",
    IfBranch(inner)            => "if branch: {show_reason(inner)}",
    LetBinding(name, inner)    => "let {name} = {show_reason(inner)}",
    Unified(a, b)              => "{show_reason(a)} unified with {show_reason(b)}",
    Instantiation(name, inner) => "instantiate {name} → {show_reason(inner)}",
    UnifyFailed(ta, tb)        => "cannot unify {show_type(ta)} with {show_type(tb)}",
    Placeholder(span)          => "placeholder at {show_span(span)}",
    BinOpPlaceholder(op)       => "binop {binop_to_str(op)}",
    MissingVar(name)           => "unbound variable: {name}",
    Refinement(p, q)           => "refinement: {show_predicate(p)} ∧ {show_predicate(q)}",
    Located(span, inner)       => "at {show_span(span)}: {show_reason(inner)}",
    // RX.2 — high-intent structured variants
    InferredCallReturn(callee, inner) => "call to '{callee}' → {show_reason(inner)}",
    InferredPipeResult(verb, inner)   => "{verb} pipe → {show_reason(inner)}",
    FreshInContext(id, ctx)           => "fresh {show_handle(id)} in '{ctx}'",
    DefaultReason(pname, span)        => "{pname} defaulted at {show_span(span)}"
  }
}

fn show_span(ref span) with !Mutate = {
  let Span(sl, sc, el, ec) = span
  "{int_to_str(sl)}:{int_to_str(sc)}-{int_to_str(el)}:{int_to_str(ec)}"
}

fn show_scheme(ref sch) with GraphRead + !Mutate = {
  let Forall(vars, ty) = sch
  if len(vars) == 0 { show_type(ty) }
  else { "∀{show_list(vars, show_handle, " ")}. {show_type(ty)}" }
}

fn show_pipe_kind(pk) with Pure = {
  match pk {
    PForward    => "|>",
    PDiverge    => "<|",
    PCompose    => "><",
    PTee        => "~>",
    PFeedback   => "<~"
  }
}


fn show_list(ref items, ref render, ref sep) with !Mutate = {
  if len(items) == 0 { "" }
  else if len(items) == 1 { render(list_head(items)) }
  else {
    render(list_head(items))
      |> str_concat(sep)
      |> str_concat(show_list(list_tail(items), render, sep))
  }
}


fn mono(ty) with Pure = Forall([], ty)
