// verify.mn — refinement obligation ledger + decidable-subset
//             compile-time discharge (spec 02 · spec 06)
//
// verify_ledger is the substrate-level Verify handler. It accumulates
// every obligation (span, predicate, reason) without solving — code
// compiles; obligations are visible, countable, queryable via
// `mentl query verification`. Real solving is a sibling handler
// (verify_smt, dispatching to Z3 / cvc5 / Bitwuzla) installed by
// post-cascade Arc F.1; the swap surface IS the thesis. Source
// unchanged across the swap; the ~> chain names which handler
// discharges obligations at any given pipeline route.
//
// Per primitive #6 (refinement types), the wheel-canonical handler
// discharges ITS DECIDABLE SUBSET at compile time before deferring to
// the ledger. Predicates whose leaves are constants (PInt / PFloat /
// PString) decide to Some(true) | Some(false) via predicate_decide;
// proven-true predicates produce no debt; proven-false predicates emit
// E_RefinementRejected immediately at the construction site;
// undecidable predicates (PVar / PApp / PCall reachable through the
// recursion) fall through to the ledger as before. The Arc F.1 swap
// to verify_smt narrows the undecidable set further; the discharge
// path stays identical.

import types

/// Discharges the decidable subset compile-time; defers the rest to
/// the ledger. The simplest demonstration that the handler-swap
/// thesis works on the compiler's own core: the gap between "ledger
/// only" and "full SMT solver" is hosted by the handler mechanism
/// itself. Swap for `verify_smt` (Arc F.1) with zero source changes —
/// the swap targets the undecidable arm; the decidable arm here stays
/// load-bearing across the swap.
handler verify_ledger with debt = [] {

  verify(span, predicate, reason) =>
    match predicate_decide(predicate) {
      Some(true)  => resume(),
      Some(false) => {
        report_refinement_rejected(predicate, span, reason)
        resume()
      },
      None        =>
        resume()
          with debt = [(span, predicate, reason)] ++ debt
    },

  verify_debt() =>
    resume(debt)
}

/// Compile-time decidable discharge. Returns Some(true) when the
/// predicate proves true on its constant operands alone; Some(false)
/// when it proves false; None at the undecidable boundary (a variable,
/// a call, a compound expr) — defers to ledger or solver. Pure.
///
/// A PCompare is decidable iff BOTH operand nodes are literal constants
/// (read LIVE via node_const, never a PExpr copy); litval_compare folds
/// them — cross-kind equality is Some(false) (type mismatch is a
/// stronger refusal than undecidable), cross-kind ordering is None.
/// PAnd / POr / PNot recurse with three-valued short-circuit.
fn predicate_decide(ref pred) with GraphRead = match pred {
  PTrue              => Some(true),
  PCompare(op, l, r) => compare_decide(op, l, r),
  PAnd(a, b)         => and_decide(predicate_decide(a), predicate_decide(b)),
  POr(a, b)          => or_decide(predicate_decide(a), predicate_decide(b)),
  PNot(inner)        => not_decide(predicate_decide(inner)),
  PBoolNode(_)       => None,        // a bool expr node — the SMT tier resolves it live
  PPatternMatch(_, _) => None        // match-narrowing — the SMT tier evaluates
}

/// A comparison decides at compile time iff BOTH operand handles resolve
/// to literal constants; otherwise None (defer to the solver).
fn compare_decide(op, lh, rh) with GraphRead = match node_const(lh) {
  Some(lv) => match node_const(rh) {
    Some(rv) => litval_compare(op, lv, rv),
    None     => None
  },
  None => None
}

/// Resolve an operand HANDLE to its literal value, reading the Expr LIVE
/// from the graph (graph_node_body) — Some for a compile-time constant,
/// None otherwise. Carry the handle, read live.
fn node_const(handle) with GraphRead = match perform graph_node_body(handle) {
  NExpr(LitInt(n))    => Some(LVInt(n)),
  NExpr(LitFloat(f))  => Some(LVFloat(f)),
  NExpr(LitString(s)) => Some(LVString(s)),
  NExpr(LitBool(b))   => Some(LVBool(b)),
  _                   => None
}

/// Fold a comparison over two constant operand values.
fn litval_compare(ref op, ref a, ref b) with Pure = match op {
  BEq => litval_eq(a, b),
  BLt => litval_lt(a, b),
  BLe => litval_le(a, b),
  _   => None
}

/// Equality over constants. Same-kind compares; cross-kind is Some(false)
/// (different-kind constants are unequal — a stronger refusal than None).
fn litval_eq(ref a, ref b) with Pure = match a {
  LVInt(na)    => match b { LVInt(nb) => Some(na == nb), LVFloat(_) => Some(false), LVString(_) => Some(false), LVBool(_) => Some(false) },
  LVFloat(fa)  => match b { LVInt(_) => Some(false), LVFloat(fb) => Some(fa == fb), LVString(_) => Some(false), LVBool(_) => Some(false) },
  LVString(sa) => match b { LVInt(_) => Some(false), LVFloat(_) => Some(false), LVString(sb) => Some(sa == sb), LVBool(_) => Some(false) },
  LVBool(ba)   => match b { LVInt(_) => Some(false), LVFloat(_) => Some(false), LVString(_) => Some(false), LVBool(bb) => Some(ba == bb) }
}

/// Strict order over numeric constants; strings/bools carry no order
/// here (None — defer); cross-kind numeric is None.
fn litval_lt(ref a, ref b) with Pure = match a {
  LVInt(na)    => match b { LVInt(nb) => Some(na < nb), LVFloat(_) => None, LVString(_) => None, LVBool(_) => None },
  LVFloat(fa)  => match b { LVInt(_) => None, LVFloat(fb) => Some(fa < fb), LVString(_) => None, LVBool(_) => None },
  LVString(_)  => None,
  LVBool(_)    => None
}

fn litval_le(ref a, ref b) with Pure = match a {
  LVInt(na)    => match b { LVInt(nb) => Some(na <= nb), LVFloat(_) => None, LVString(_) => None, LVBool(_) => None },
  LVFloat(fa)  => match b { LVInt(_) => None, LVFloat(fb) => Some(fa <= fb), LVString(_) => None, LVBool(_) => None },
  LVString(_)  => None,
  LVBool(_)    => None
}

/// Conjunction with three-valued short-circuit. Some(false) on either
/// branch decides the conjunction false regardless; Some(true) on both
/// decides true; mixed Some(true) + None defers to None (the unknown
/// branch is still load-bearing); Some(true) + Some(true) is the only
/// fully-decidable true.
fn and_decide(ref ea, ref eb) with Pure = match ea {
  Some(false) => Some(false),
  Some(true)  => match eb {
    Some(false) => Some(false),
    Some(true)  => Some(true),
    None        => None
  },
  None        => match eb {
    Some(false) => Some(false),
    Some(true)  => None,
    None        => None
  }
}

fn or_decide(ref ea, ref eb) with Pure = match ea {
  Some(true)  => Some(true),
  Some(false) => match eb {
    Some(true)  => Some(true),
    Some(false) => Some(false),
    None        => None
  },
  None        => match eb {
    Some(true)  => Some(true),
    Some(false) => None,
    None        => None
  }
}

fn not_decide(ref e) with Pure = match e {
  Some(true)  => Some(false),
  Some(false) => Some(true),
  None        => None
}

/// Compile-time refusal at the construction site. The verifier proved
/// the predicate false from constant inputs alone — the construction
/// is invariant-violating by literal evidence. Span is the call site;
/// reason carries the predicate-as-Why for the chain-walker.
fn report_refinement_rejected(ref pred, ref span, ref reason) with !Mutate = {
  perform report(
    "verify", "E_RefinementRejected", "error",
    "refinement predicate proven false at compile time: {show_predicate(pred)}",
    span, "MaybeIncorrect"
  )
}

/// Emit a single diagnostic summarising pending verification debt.
/// Called at compile end by the driver. Zero debt → no diagnostic.
fn report_verify_debt(debt) = {
  if len(debt) == 0 { () }
  else {
    perform report("verify", "V_Pending", "VerificationPending",
      "{int_to_str(len(debt))} verification obligations pending",
      span_zero(), "MaybeIncorrect")
  }
}

/// Classify verification debt by predicate shape. Consumed by
/// `mentl query verification` so the developer sees at a glance
/// which proof classes are pending.
fn debt_by_kind(debt) = map((entry) => {
  let (span, pred, reason) = entry
  (classify_predicate(pred), span, reason)
}, debt)

fn classify_predicate(pred) with Pure = match pred {
  PTrue        => "trivial",
  PNot(_)      => "negation",
  PAnd(_, _)   => "conjunction",
  POr(_, _)    => "disjunction",
  PCompare(_, _, _) => "comparison",
  PBoolNode(_) => "graph-deferred",
  PPatternMatch(_, _) => "match-narrowing"
}

type SmtResult
  = SmtSat(String)
  | SmtUnsat
  | SmtUnknown

effect SmtSolver {
  smt_solve(String) -> SmtResult
}

handler verify_smt with witnesses = [] {

  verify(span, predicate, reason) =>
    match predicate_decide(predicate) {
      Some(true)  => resume(),
      Some(false) => {
        report_refinement_rejected(predicate, span, reason)
        resume()
      },
      None        =>
        match perform smt_solve(predicate_to_smt_lib(predicate)) {
          SmtSat(witness) =>
            resume()
              with witnesses = [(span, predicate, witness)] ++ witnesses,
          SmtUnsat => {
            report_refinement_rejected(predicate, span, reason)
            resume()
          },
          SmtUnknown =>
            resume()
        }
    },

  verify_debt() =>
    resume([])
}

fn predicate_to_smt_lib(ref pred) with Memory + Alloc = {
  "(assert {predicate_to_smt(pred)})\n(check-sat)"
}

fn predicate_to_smt(ref pred) with GraphRead + Memory + Alloc = match pred {
  PTrue              => "true",
  PCompare(op, l, r) => "({smt_cmp_op(op)} {handle_to_smt(l)} {handle_to_smt(r)})",
  PAnd(a, b)         => smt_logop("and", a, b),
  POr(a, b)          => smt_logop("or", a, b),
  PNot(inner)        => "(not {predicate_to_smt(inner)})",
  PBoolNode(n)       => handle_to_smt(n),
  PPatternMatch(_, n) => handle_to_smt(n)
}

fn smt_cmp_op(ref op) with Pure = match op {
  BEq => "=",
  BLt => "<",
  BLe => "<=",
  _   => "="
}

fn smt_logop(ref op, ref a, ref b) with GraphRead + Memory + Alloc = {
  "({op} {predicate_to_smt(a)} {predicate_to_smt(b)})"
}

/// Resolve an operand HANDLE to its Expr (graph_node_body) and render it.
fn handle_to_smt(handle) with GraphRead + Memory + Alloc = {
  body_to_smt(perform graph_node_body(handle))
}

/// Render a nested operand NODE (a call's argument) as an SMT term.
fn node_to_smt(ref node) with Memory + Alloc = {
  let N(body, _, _) = node
  body_to_smt(body)
}

fn body_to_smt(body) with Memory + Alloc = match body {
  NExpr(LitInt(n))    => int_to_str(n),
  NExpr(LitFloat(_))  => "0.0",
  NExpr(LitString(s)) => "\"{s}\"",
  NExpr(VarRef(name)) => name,
  NExpr(CallExpr(callee, args)) => smt_node_call(callee, args),
  _                   => "true"
}

fn smt_node_call(ref callee, ref args) with Memory + Alloc = {
  let N(cbody, _, _) = callee
  let fname = match cbody {
    NExpr(VarRef(n)) => n,
    _                => "_"
  }
  "({fname}{smt_args(args, 0, len(args))})"
}

fn smt_args(ref args, i, n) with Memory + Alloc = {
  if i >= n { "" }
  else {
    " {node_to_smt(list_index(args, i))}{smt_args(args, i + 1, n)}"
  }
}
