// CROWN modal (§11 6.3's crucible sweep): the TEE'S ADD HALF, sound
// dual — the arm's F is DECLARED by the installing fn (F + !E): the
// masked E is absorbed at the install, the arm's F rides the composite
// row honestly, and the license for F never collides with the negation
// of E. Expect NO E_EffectMismatch.
effect E { op() -> Int }
effect F { fop() -> Int }
handler h { op() => resume(fop()) }
fn work() = op()
fn f() with F + !E = (work()) ~> h
fn main() = 0
