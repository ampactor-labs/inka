// The fmt row/retty/handler fixture — the census's blockers 1, 2, and 4
// seen RED on the pre-fix boot: the signed with-clause rendered as the
// literal text «invalid-effect» (the triples fed to the row constructor
// as bare EffNames), the handler decl trapped in render_handler_arms
// (open-record field reads), and the authored -> Int silently vanished
// (the discarded retty binder).
effect Ping { ping() -> Int }

effect Pong { pong_op() -> Int }

handler ponger with n = 40 {
  ping() => resume(n + 2)
}

fn probe() -> Int with Ping + !Pong = ping()

// Rung 3's face: a bare-expression if-branch renders its braces EXACTLY
// once (pre-fix the render double-wrapped the parsed BlockExpr and the
// inner braces re-parsed as the record pun — a value silently became a
// record).
fn clampish(n) -> Int = if n > 0 { n } else { 0 }

fn main() = (probe() ~> ponger) + clampish(0 - 5)
