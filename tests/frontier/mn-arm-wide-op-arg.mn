// The arm-wide-op-arg gate (Hβ.emit.arm-wide-arg-face): a handler arm
// may READ a wide op argument. The perform boxes every wide arg into a
// cell (emit_args_word — the arm fn's ABI is floor words, shared between
// the floor and every twin), while the arm's own signature is projected
// from its param repr, so an arm that USES a Float arg declares
// `(param $g.f64 f64)` and meets the pushed cell pointer:
// `expected [i32, f64] but got [i32, i32]`, refused at assemble. An arm
// that IGNORES the same arg floors to i32 and matches the cell by
// accident — which is why the class hid behind the unused case.
//
// The pair: `set_gain` reads its wide arg, `set_trim` ignores one.
// Expect exit 11 (10 + 1).
type Gain = Float where 0.0 <= self

effect Mix {
  gain_read(g: Gain) -> Int
  gain_ignored(t: Gain) -> Int
}

handler mixer {
  gain_read(g) => if g <= 1.0 { resume(10) } else { resume(0) },
  gain_ignored(t) => resume(1),
}

fn run() with Mix = {
  let a = gain_read(0.5)
  let b = gain_ignored(0.25)
  a + b
}

fn main() = (run()) ~> mixer
