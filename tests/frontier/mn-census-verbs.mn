// The structural census's gate fixture (Hβ.query.structural-census —
// PLAN §11 Phase 0.3): one site per countable shape at a KNOWN line, so
// the frontier leg asserts each census answer contains this file's own
// located site (link-robust — the census walks the whole judged weave,
// so absolute counts ride the link set; the fixture's line is the
// invariant). All five verbs count, `<~` included since the raw-reason
// span read landed (the walk reads the node's OWN parse site, never the
// chased root's reason — Hβ.eq.pipekind-match-eq-divergence's record).
fn inc(x) = x + 1
fn fwd(x) = x |> inc
fn dup(x) = (x) <| (inc, inc)
fn par(a, b) = (a |> inc) >< (b |> inc)
fn tee(x) = inc(x) ~> ticker
fn lam(x) = pick((a) => a + 1, x)
fn fb(x) = x <~ inc(1)
fn pick(f, x) = f(x)
effect Tick {
  tick() -> Int
}
handler ticker {
  tick() => resume(1),
}
fn main() = 0
fn eta_site(xs) = map((x) => inc(x), xs)
fn rowed_site(xs) = map((x) => x + tick(), xs) ~> ticker
fn walk_site(xs, i, n) = if i >= n { 0 } else { walk_site(xs, i + 1, n) }
fn wz_site(v) = match v { 1 => 5, _ => 0 } // drift-audit: ignore — the census gate's own deliberate specimen of the shape it counts
fn fm_site(b) = b || true // drift-audit: ignore — the census gate's own deliberate specimen of the shape it counts
fn println(s: String) = 0
fn report(d) = d
fn pir_site(x: String) = report(println(x)) // drift-audit: ignore — the census gate's own deliberate specimen of the shape it counts
fn wf_site(v) = match v { 1 => "one", _ => "Pure" } // drift-audit: ignore — the census gate's own deliberate specimen of the shape it counts
