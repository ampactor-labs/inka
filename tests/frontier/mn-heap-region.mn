// The region verbs (Alloc's heap_mark/heap_reset — the arena's first grain,
// §5.O layer 3): mark the bump pointer, allocate, reset — the next alloc
// returns the SAME address the reclaimed one had (the region's memory reclaimed, O(1)). RED
// (E_MissingVariable on the ops) on any boot before the substrate landing.
fn main() with Memory + Alloc = {
  let a = alloc(8)
  let m = heap_mark()   // drift-audit: ignore — sequenced effectful read (the mark IS the live bump pointer, read before the region body)
  let b = alloc(8)
  heap_reset(m)
  let c = alloc(8)
  if c == b { 42 } else { 1 }
}
