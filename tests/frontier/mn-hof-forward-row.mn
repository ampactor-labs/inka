// The t-sort discriminator suite (2026-08-07, the under-publish dig's
// crucible-to-be): which shape mints a fn-param's row position as a
// type-sort cell and publishes a bare row? Measured through the
// a13918ee pin: sl is LOSSY (bare t-sort row, no presents — the
// caller-before-callee read of the prereg scheme); sb, sc, sd, se,
// and sf are HONEST (Memory + Alloc + connected r-sort rows). The
// gate leg lands with the fix: sl's row must equal sf's.

// A — show_list's exact shape: entry + index-recursive worker, fn-arg 2nd.
fn sl(items, render, sep) = sl_from(items, render, sep, 0, len(items))

fn sl_from(items, render, sep, i, n) = if i >= n {
  ""
} else if i + 1 >= n {
  render(items[i])
} else {
  render(items[i]) ++ sep ++ sl_from(items, render, sep, i + 1, n)
}

// B — single index-recursive fn, fn-arg 2nd, no entry split.
fn sb(items, render, i, n) = if i >= n {
  ""
} else {
  render(items[i]) ++ sb(items, render, i + 1, n)
}

// C — fn-arg FIRST, index-recursive.
fn sc(render, items, i, n) = if i >= n {
  ""
} else {
  render(items[i]) ++ sc(render, items, i + 1, n)
}

// D — non-recursive, fn-arg applied once.
fn sd(render, x) = render(x) ++ "!"

// E — bare forwarder to a BACKWARD callee (sb declared above): honest,
// so the loss keys on decl order, not the bare-call body shape.
fn se(items, render) = sb(items, render, 0, len(items))

// F — forwarder to the forward worker with a charge of its own beside
// the call: honest, killing the forward-ness-alone story (sf is judged
// after the worker in the walk; sl before it).
fn sf(items, render) = sl_from(items, render, ";", 0, len(items)) ++ "!"

fn main() = {
  let r = (n) => "{n}"
  sl([1], r, ",") ++ sb([1], r, 0, 1) ++ sc(r, [1], 0, 1) ++ sd(r, 2) ++ se([1], r) ++ sf([1], r)
}
