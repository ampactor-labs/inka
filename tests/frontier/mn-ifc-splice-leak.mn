// The DCC gate's LEAK face (§11 Phase 7, Hβ.ifc.dcc-noninterference-gate):
// a classified value spliced into a string refuses — the splice carries
// the value's label THROUGH the ShowExpr wrap (the wrapper binds String;
// reading the wrapper's type classified every splice Public and silently
// discharged the obligation — the regression this gate's first probe
// caught). Expect E_RefinementRejected at the splice.
type Vault = String where classified(self)
fn classified(s) = true
fn getpw() -> Vault = "hunter2"
fn leak() = {
  let pw = getpw()
  "msg: {pw}"
}
fn main() = 0
