// expect: 12
// BANKED RED (Hβ.lower.install-config-capture-read): an install-config
// argument that references a CLOSURE CAPTURE reads 0 — the install-init
// emission resolves locals but not captures, so the arm writes to fd 0
// and the file stays empty (measured exit 0 today; 12 when the init
// path rides the same capture-resolution ladder ordinary exprs use).
// The let-local control shape is wat_to_file's documented caveat; this
// fixture graduates to a registered leg with the root fix.
import runtime/io

effect Out {
  put(s: String)
}

handler to_fd(fd) {
  put(s) => {
    fd_write_bytes(fd, str_payload(s), byte_len(s))
    resume()
  }
}

// A second handler for the op keeps put() on the evidence walk — the
// dispatch shape the wheel's own wat_emit takes with three sinks.
handler to_void {
  put(s) => resume()
}

fn ctx(body) with Memory + Alloc = body()

fn main() with WASI + Memory + Alloc = {
  let fd = fs_create_impl("/tmp/config-capture-probe.txt")
  // fd is a CAPTURE of this thunk, referenced ONLY in the install's
  // config args — the failing shape.
  ctx(() => { put("hello ") put("world\n") } ~> to_fd(fd))
  fs_close_impl(fd)
  proc_exit(byte_len(fs_read_file_impl("/tmp/config-capture-probe.txt")))
}
