// expect: 42
// The sequence-of-struct fold leaves' eq faces (registered frontier
// leg; RED on the pre-leaf boot: exit 7): structural == over a
// sequence whose element is a
// PRODUCT (top-level and record-field), a NESTED LIST, and
// COMPUTED strings (literal interning masked the [String] face — two
// "ab" literals share one data-section pointer, so only runtime-built
// bytes expose the pointer compare). Before the generated walkers,
// every structural element face fell to $list_eq's per-element word
// compare — pointer identity standing in for structural equality, the
// exact silent fallback SYNTAX's eq law forbids.
fn main() = {
  let top = if [(1, 2, 3)] == [(1, 2, 3)] { 1 } else { 0 }
  let field = {
    let a = {pairs: [(4, 5)]}
    let b = {pairs: [(4, 5)]}
    if a == b { 1 } else { 0 }
  }
  let nested = if [[1, 2], [3]] == [[1, 2], [3]] { 1 } else { 0 }
  let strs = {
    let built = ["a" ++ "b", "c"]
    if built == ["ab", "c"] { 1 } else { 0 }
  }
  let refuses = if [(1, 2)] == [(1, 9)] { 0 } else { 1 }
  if top + field + nested + strs + refuses == 5 { 42 } else { 7 }
}
