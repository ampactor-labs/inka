// The intent ranker's contract: the fan orders survivors by LOCAL
// INTENT read from the graph — a name already USED near the hole
// outranks a nearer-declared but unused sibling. kerning is declared
// AFTER width so enumeration order alone would surface kerning first;
// the use edge at banner's first line lifts width above it.
fn kerning() -> Int with Pure = 2
fn width() -> Int with Pure = 40
fn banner() -> Int with Pure = {
  let pad = width() / 10
  let total = ?? + pad
  total
}
fn main() = banner()
