// The tie-ranking crucible (Hβ.teach.severance-vocabulary-from-link's
// last half): equal-leverage generic severances rank by link PREVALENCE,
// never by env enumeration order. Rare is declared and performed FIRST
// (enumeration order would propose !Rare); Common is performed by three
// fns (prevalence proposes !Common). main performs only Noise, so both
// severances are provable and the winner exposes the ranking.
effect Rare {
  rare_op() -> Int
}

effect Common {
  common_op() -> Int
}

effect Noise {
  noise_op() -> Int
}

fn r1() with Rare = rare_op()

fn c1() with Common = common_op()

fn c2() with Common = common_op()

fn c3() with Common = common_op()

fn main() with Noise = noise_op()
