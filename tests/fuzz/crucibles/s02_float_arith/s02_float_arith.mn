// A Float hole feeding float arithmetic. The synth vocabulary has float seeds
// (0.0, 1.0), but enumerating them through the Propose facet traps the medium:
// `indirect call type mismatch` in enumerate_float_literals — an f64 candidate
// dispatched through an all-i32 $ft (the named-but-open Hbeta.emit.float-evidence-ft
// class, PLAN §7 residue). main stays Int so this graduates to clean-run once
// the float $ft gap closes.

fn main() = {
  let k: Float = ??
  if k * 2.0 < 3.0 { 1 } else { 0 }
}
