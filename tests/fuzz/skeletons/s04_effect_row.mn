// fuzz-shape: effect-row
// fuzz-expect: clean-run
// A hole under a negative effect-row constraint. The candidate vocabulary has
// four zero-arg functions returning Seven; only pure_seven satisfies choose's
// `!Network` gate (the other three reach Network directly, transitively, and
// through a higher-order call). The row prunes to one survivor, the medium
// fills pure_seven(), and main returns 7.

type Seven = Int where self == 7

effect Network {
  ping()
}

fn pure_seven() -> Seven with Pure = 7

fn direct_network() -> Seven with Network = {
  ping()
  pure_seven()
}

fn transitive_network() -> Seven with Network = direct_network()

fn call_zero(f) = f()

fn higher_order_network() -> Seven with Network =
  call_zero(() => {
    ping()
    pure_seven()
  })

fn choose() -> Seven with !Network = ??

fn main() = choose()
