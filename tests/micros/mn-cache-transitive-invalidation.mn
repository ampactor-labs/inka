// W26 gate — transitive cache invalidation: a cache hit is a LIVE projection
// of the import DAG's current hash-set, not a module-only snapshot.
//
// The ultimate form (what the WHEEL now does, src/cache.mn cache_is_hit +
// src/driver.mn driver_check_module): a module is CLEAN iff
//   1. compiler_version matches, AND
//   2. the module's own source hash matches, AND
//   3. every dep's CURRENT hash (read live from disk via
//      driver_collect_dep_hashes over kai.imports) EQUALS the hash recorded
//      when the .kai was written (kai.imports_hashes == current_dep_hashes,
//      one structural list `==`).
// Before this, cache_is_hit checked ONLY (1)+(2) — a changed dependency left
// this module reporting HIT, installing a stale env (the transitive-
// invalidation gap). This surpasses Salsa/Bazel transitive-digest by reading
// dep freshness from the one hash-set the graph already proved.
//
// This proxy proves the HIT/MISS decision in seed-supported constructs (Int
// comparison — the same length-then-element shape structural list `==` lowers
// to). The live wheel form reads the hashes off disk (Filesystem) and compares
// the recorded vs current hash LISTS with one `==`; the seed cannot run fs I/O
// in a WASI-free micro, so the gate exercises the DECISION (own-hash equal AND
// each dep-hash equal → clean; any mismatch → dirty) on in-line hash values.
// Named peer when the seed runs the driver end-to-end:
// Hβ.seed.cache-transitive-invalidation.
//
// Expected exit 70:
//   clean_match  (own ok + every dep hash unchanged)  => 10
//   own_changed  (own hash differs)                   =>  0 (correctly dirty)
//   dep_changed  (one dep hash differs)               => 20 (correctly dirty)
//   all_changed  (own + dep both differ)              => 40 (correctly dirty)
//   10 + 20 + 40 = 70

// is_clean — the cache_is_hit decision over a 3-dep hash-set: own-hash equal
// AND each recorded dep hash structurally equal to its current hash. (The
// element-wise conjunction IS what `recorded_list == current_list` lowers to:
// length-then-element recursion, SYNTAX.md §Equality operator.)
fn deps_equal(r0, r1, r2, c0, c1, c2) =
  r0 == c0 && r1 == c1 && r2 == c2

fn is_clean(own_r, own_c, r0, r1, r2, c0, c1, c2) = {
  if own_r == own_c {
    if deps_equal(r0, r1, r2, c0, c1, c2) { 1 } else { 0 }
  } else {
    0
  }
}

fn main(q) = {
  // Recorded at cache-write: own=900, deps=(111, 222, 333).
  // Clean: own matches AND every dep hash unchanged → HIT.
  let clean_match = if is_clean(900, 900, 111, 222, 333, 111, 222, 333) == 1 { 10 } else { 0 }
  // Own source changed → MISS even with deps unchanged.
  let own_changed = if is_clean(900, 901, 111, 222, 333, 111, 222, 333) == 1 { 0 } else { 0 }
  // A dependency's source changed (middle hash differs) → transitive MISS.
  let dep_changed = if is_clean(900, 900, 111, 222, 333, 111, 999, 333) == 1 { 0 } else { 20 }
  // Own AND a dep both changed → MISS.
  let all_changed = if is_clean(900, 901, 111, 222, 333, 111, 999, 333) == 1 { 0 } else { 40 }
  clean_match + own_changed + dep_changed + all_changed
}
