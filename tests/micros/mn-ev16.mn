// expect: 18
// Handler-record evidence capture: a STATEFUL handler's arm performs
// a Tier-2 effect (two decls of `note` force evidence dispatch). The
// record is [_, nstate=1, k@8, arm@12, captured_ev@16]; the arm's
// perform must read the captured entry at the post-arms fence — the
// graph_handler/graph_mutated shape. Before the capture substrate the
// arm read its own state slot k as the entry and chained garbage.
effect Ea { opa() -> Int }
effect Eb { note(n: Int) -> Int }

handler hb with seen = 10 {
  note(n) => resume(seen + n) with seen = seen + n
}

handler hb_alt {
  note(n) => resume(n)
}

handler ha with k = 5 {
  opa() => {
    let w = note(3)
    resume(w + k)
  }
}

fn deep() = opa()

fn main(q) = {
  deep()
    ~> ha
    ~> hb
}

// Expected exit 18: note(3) through hb -> 10+3 = 13; 13 + k(5) = 18.
