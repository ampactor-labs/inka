// Three chained handlers; the op served by the MIDDLE one is
// performed from a NESTED function, not the staged one — the
// m2 fresh_ph shape: parse fns deep below the chain's stage
// performing graph ops served mid-chain.
effect Ea { opa() -> Int }
effect Eb { opb() -> Int }
effect Ec { opc() -> Int }

handler ha { opa() => resume(1) }
handler hb { opb() => resume(20) }
handler hc { opc() => resume(300) }

fn deep() = perform opb()
fn deeper() = deep() + perform opa()

fn stage(x) = x + deeper()

fn main(q) = {
  stage(0)
    ~> ha
    ~> hb
    ~> hc
}

// Expected exit 21 (opb=20 via the MIDDLE handler + opa=1 via the
// INNERMOST, both performed from nested fns two frames below the
// staged expression).
