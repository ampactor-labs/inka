// A fanout tuple's PROVEN f64 element types must flow through the let-tuple
// pattern into the binders — the pattern CONSTRAINS the scrutinee, never
// re-binds it (a clobber left a and b free: the tuple writer stored f64 at
// width-summed offsets while the pattern reader floored to word loads — the
// split-truth miscompile this micro pins). Bare a + b, no grounding use.
fn widen(x) = float_of_int(x) * 15.0

fn main() = {
  let (a, b) = 2 <| (widen, widen)
  float_to_int(a + b)
}
