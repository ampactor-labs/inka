// EXACT lookup_tag shape (first-light blocker): a field-access lambda through the
// HOF `find`, over an ANNOTATED concrete-record list. tag.handle must resolve to
// offset 0 (handle < install_span < region_id alphabetically). Expect 7.
fn pick(ref tags: [{handle: Int, region_id: Int}], h) with !Mutate =
  find((tag) => tag.handle == h, tags)

fn main(q) = match pick([{handle: 7, region_id: 1}, {handle: 9, region_id: 2}], 7) {
  Some(t) => t.region_id + 6,
  None    => 0
}
