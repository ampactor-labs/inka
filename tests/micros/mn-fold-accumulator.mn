// expect: 4
// fold-accumulator — the handler config/state/result seam.
// `fold([], (acc, xs) => acc ++ xs, xss)` must carry one accumulator type
// through init, f's first arg, f's return, handler state, and result().
fn myflat(xss) = fold([], (acc, xs) => acc ++ xs, xss)

fn main() = {
  let xs = myflat([[1], [2, 3]])
  list_index(xs, 0) + list_index(xs, 2)
}
