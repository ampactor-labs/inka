// expect: 42
// mn-higher-order-effect-builtin-state — the -multi-state repro + a make_list
// STATE INIT (a Memory/Alloc-effecting init, like map_collector's `buf =
// make_list(16)`), but the arm stays pure-Int (does NOT touch buf). Pins whether
// the Memory effect in the handler's STATE INIT breaks the config param's
// user-effect residual propagation. Probe: compile with the list runtime and grep
// stderr for `use_each_Env2` (the row-leak line); its presence = use_each's row
// lost Env2 = the bug REPRODUCED. This is the minimal reproducer of the real
// higher-order-effect trap (peer Hbeta.infer.residual-var-survives-builtin-coeffects).

effect Env2 { lookup2(k) -> Int }

handler env2_handler {
  lookup2(k) => resume(k + 40)
}

effect Step {
  emit(v) -> ()
  done() -> Int
}

handler collect(g) with acc = 0, buf = make_list(4) {
  emit(v) => {
    let r = g(v)
    resume() with acc = acc + r
  },
  done() => resume(acc)
}

fn source(v, n) with Step = if n > 0 { emit(v); source(v, n - 1) }

fn apply_each(g, v) = { source(v, 1); done() } ~> collect(g)

fn use_each(v) = apply_each((x) => lookup2(x), v)

fn run() = { use_each(2) } ~> env2_handler

fn main(q) = run()
