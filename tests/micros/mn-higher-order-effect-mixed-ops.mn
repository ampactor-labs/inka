// mn-higher-order-effect-mixed-ops — a handler that MIXES a separately-declared op
// (emit, from effect Yield) with a SELF-DEFINED op (result, no effect decl), the
// handled op performed Tier-2 (one fn-call deep in `source`). Edge case: the seed
// assigns the self-defined op to the sibling's effect, colliding at slot 0 under
// Tier-2 dispatch -> the arm region overwrites emit with result -> trap. NOT on
// the higher-order-effect path (prelude collectors don't mix); peer
// Hbeta.lower.mixed-declared-selfdefined-handler-ops. Expected exit 42 = g(2).

effect Env2 { lookup2(k) -> Int }

handler env2_handler {
  lookup2(k) => resume(k + 40)
}

effect Yield { emit(v) -> () }

handler collect(g) with total = 0 {
  emit(v) => {
    let r = g(v)
    resume() with total = total + r
  },
  result() => resume(total)
}

fn source(v, n) with Yield = if n > 0 { emit(v); source(v, n - 1) }

fn apply_each(g, v) = { source(v, 1); result() } ~> collect(g)

fn run() = { apply_each((x) => perform lookup2(x), 2) } ~> env2_handler

fn main(q) = run()
