// mn-higher-order-effect-two-op — mirrors the prelude's map exactly: a TWO-OP
// declared effect (emit slot 0 + done slot 1), one handler covering both, emit
// performed Tier-2 (one fn-call deep in `source`, like iterate_from) and done
// performed Tier-1 (lexically in the installing body, like map's `result()`).
// This is the real shape with declared ops (no undeclared-arm collision). PASSES
// -> multi-arm Tier-2 evidence dispatch is correct.
// Expected exit 42 = g(2) = 2 + 40 (one emit), done returns accumulated total.

effect Env2 { lookup2(k) -> Int }

handler env2_handler {
  lookup2(k) => resume(k + 40)
}

effect Step {
  emit(v) -> ()
  done() -> Int
}

handler collect(g) with total = 0 {
  emit(v) => {
    let r = g(v)
    resume() with total = total + r
  },
  done() => resume(total)
}

fn source(v, n) with Step = if n > 0 { emit(v); source(v, n - 1) }

fn apply_each(g, v) = { source(v, 1); done() } ~> collect(g)

fn run() = { apply_each((x) => lookup2(x), 2) } ~> env2_handler

fn main(q) = run()
