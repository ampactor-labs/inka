// mn-hoeff4 — adds the `iterate` indirection: the handled op (emit/yield) is
// performed inside a SEPARATE recursive function `source` (mirroring iterate_from),
// not directly in apply_each's body. Isolates whether the break is performing
// the handled op one fn-call deep. Expected exit 42 = g(2) = 2 + 40 (n=1).

effect Env2 { lookup2(k) -> Int }

handler env2_handler {
  lookup2(k) => resume(k + 40)
}

effect Yield { emit(v) -> () }

handler collect(g) with total = 0 {
  emit(v) => {
    let r = g(v)
    resume() with total = total + r
  },
  result() => resume(total)
}

fn source(v, n) with Yield = if n > 0 { emit(v); source(v, n - 1) }

fn apply_each(g, v) = { source(v, 1); result() } ~> collect(g)

fn run() = { apply_each((x) => perform lookup2(x), 2) } ~> env2_handler

fn main(q) = run()
