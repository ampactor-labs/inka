// expect: 42
// The image bracket's counting pair (arena step 2a-i,
// Hβ.perf.per-decl-arena): image_enter/image_exit bound an extent whose
// allocations belong to the IMAGE — in this pin they only move the
// depth global (the allocator forks at 2b from the census the depth
// makes possible). Pre-landing this refused (image_enter unbound, the
// armed E_MissingVariable).
fn main(q) = {
  image_enter()
  let p = ialloc(16)
  store_i32(p, 42)
  image_exit()
  load_i32(p)
}
