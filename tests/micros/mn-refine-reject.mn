// VALUE-PROOF (R2) — the REJECT path: a refined let with an INVALID constant is
// rejected at compile time. `1.5` violates `self <= 1.0`; subst_self binds
// self=1.5, predicate_decide proves Some(false), verify emits E_RefinementRejected
// at the value span. Productive-under-error: the program still compiles (exit 0),
// so this is asserted on STDERR (grep E_RefinementRejected), never a micro exit.
type Sample = Float where -1.0 <= self && self <= 1.0

fn main(q) = {
  let bad: Sample = 1.5
  42
}
