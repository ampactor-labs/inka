// band B S2 RATCHET + the dormant A4 gate — a yield crossing a DRIVERLESS
// install (the refuter's xinst finding). The k1 yield inside
// `{ pick() + 3 } ~> mycatch` exits the bracket as a flagged dummy; the
// `+ 10` remainder and the re-install are NOT in the k. Pre-S2 the
// enclosing arithmetic computed on the dummy SILENTLY (9 where deep-handler
// semantics say 29 — the loud-floor law violated); S2 wraps the
// non-propagating driverless install whole, so the crossing traps at the
// comment-marked floor.
//   TODAY: exit 134 (the loud floor).
//   A4 (re-install-in-k — driverless-only descent, the remainder
//   re-establishing the install around the hole): flips to 29
//   (a = k(1) = 14, b = k(2) = 15). This crucible re-pins at 29 in that
//   commit; Hβ.lower.stateful-install-crossing-yield stays the stateful
//   floor.
effect Choice {
  pick() -> Int
}

effect Abort {
  abort() -> Option
}

handler mycatch {
  abort() => None
}

handler twice {
  pick() => {
    let a = resume(1)
    let b = resume(2)
    a + b
  }
}

fn body() with Choice = ({ pick() + 3 } ~> mycatch) + 10

fn main() = { body() } ~> twice
