// Probe: does a `<~ delay(1)` filter site LEAK state across independent calls?
// Filter a constant-1 signal (output rises toward 1), THEN filter a zeros
// signal. If the site's state global resets per pass, the zeros output is all
// 0.0 -> sum 0. If it leaks, the zeros output starts near 1.0 and decays -> sum > 0.

effect Sample { sample_rate() -> Int }
effect IterContext { iter_context() -> Bool }
handler iterate_context { iter_context() => resume(True) }

fn lp_step(x: Float, a: Float) -> Float with Sample =
  ((prev) => a * x + (1.0 - a) * prev) <~ delay(1)

fn filter_loop(xs, a: Float, i: Int, n: Int, out) with Sample + Memory = {
  if i >= n { out }
  else { filter_loop(xs, a, i + 1, n, list_set(out, i, lp_step(xs[i], a))) }
}

fn const_sig(v: Float, out, i: Int, n: Int) with Memory = {
  if i >= n { out }
  else { const_sig(v, list_set(out, i, v), i + 1, n) }
}

fn sum_loop(xs, i: Int, n: Int, acc: Float) with Memory = {
  if i >= n { acc }
  else { sum_loop(xs, i + 1, n, acc + xs[i]) }
}

fn run(n: Int) with Sample + Memory + Alloc = {
  let ones = const_sig(1.0, make_list(n), 0, n)
  let zeros = const_sig(0.0, make_list(n), 0, n)
  let fa = filter_loop(ones, 0.5, 0, n, make_list(n))
  let fb = filter_loop(zeros, 0.5, 0, n, make_list(n))
  let sb = sum_loop(fb, 0, n, 0.0)
  // discrete verdict: leak (zeros-pass output nonzero) -> 7; reset -> 3
  let abs_sb = if sb < 0.0 { 0.0 - sb } else { sb }
  if abs_sb > 0.001 { 7 } else { 3 }
}

fn main() = {
  { run(16) } ~> iterate_context
}
