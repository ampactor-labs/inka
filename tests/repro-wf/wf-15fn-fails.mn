// Self-contained proof: the filter-based comodulogram (signal.mn's demod) +
// the needed cfc primitives inlined, linked with math ONLY (no cfc co-link, so
// the cfc+signal wide-emit trigger is absent). Proves the Mentl EXECUTION of the
// pipeline matches oracle.py (argmax flat 10, strong coupling).

// ---- read_recording (from cfc.mn) ----
fn fill_recording(strs, num: Int, out, i: Int, w: Int) with Memory + Alloc = {
  if i >= num { slice(out, 0, w) }
  else {
    let line = str_concat("", list_index(strs, i))
    if byte_len(line) == 0 { fill_recording(strs, num, out, i + 1, w) }
    else {
      let written = list_set(out, w, parse_float(line))
      fill_recording(strs, num, written, i + 1, w + 1)
    }
  }
}
fn read_recording(path) with Memory + Alloc + WASI = {
  let strs = lines(fs_read_file_impl(path))
  fill_recording(strs, len(strs), make_list(len(strs)), 0, 0)
}

// ---- mvl + matrix readers (from cfc.mn) ----
fn mvl_loop(phases, amps, i: Int, n: Int, sc: Float, ss: Float) -> Float with Memory = {
  if i >= n { sqrt(sc * sc + ss * ss) / float_of_int(n) }
  else {
    let p = list_index(phases, i)
    let a = list_index(amps, i)
    mvl_loop(phases, amps, i + 1, n, sc + a * cos(p), ss + a * sin(p))
  }
}
fn mvl(phases, amps) -> Float with Memory = mvl_loop(phases, amps, 0, len(phases), 0.0, 0.0)

fn fill_row(low_cols, high_cols, li: Int, num_high: Int, out, hi: Int) with Memory + Alloc = {
  if hi >= num_high { out }
  else {
    let phases = list_index(low_cols, li)
    let amps = list_index(high_cols, hi)
    fill_row(low_cols, high_cols, li, num_high, list_set(out, hi, mvl(phases, amps)), hi + 1)
  }
}
fn fill_matrix(low_cols, high_cols, num_low: Int, num_high: Int, out, li: Int) with Memory + Alloc = {
  if li >= num_low { out }
  else {
    let row = fill_row(low_cols, high_cols, li, num_high, make_list(num_high), 0)
    fill_matrix(low_cols, high_cols, num_low, num_high, list_set(out, li, row), li + 1)
  }
}
fn matrix_get(matrix, li: Int, hi: Int) with Memory = list_index(list_index(matrix, li), hi)
fn argmax_scan(matrix, num_low: Int, num_high: Int, k: Int, total: Int, best_k: Int, best_v: Float) with Memory = {
  if k >= total { best_k }
  else {
    let li = k / num_high
    let hi = k - li * num_high
    let v = matrix_get(matrix, li, hi)
    if v > best_v { argmax_scan(matrix, num_low, num_high, k + 1, total, k, v) }
    else { argmax_scan(matrix, num_low, num_high, k + 1, total, best_k, best_v) }
  }
}
fn comodulogram_argmax(matrix, num_low: Int, num_high: Int) with Memory =
  argmax_scan(matrix, num_low, num_high, 0, num_low * num_high, 0, 0.0 - 1.0)

// ---- signal.mn's demodulation comodulogram ----
fn demod_fill(xs, freq: Int, sr: Int, a: Float, warm: Int, n: Int, want_phase, i: Int, w: Int, i_st: Float, q_st: Float, out) with Memory = {
  if i >= n { out }
  else {
    let th = two_pi() * float_of_int(freq) * float_of_int(i) / float_of_int(sr)
    let ni = a * (xs[i] * cos(th)) + (1.0 - a) * i_st
    let nq = a * (xs[i] * sin(th)) + (1.0 - a) * q_st
    if i < warm { demod_fill(xs, freq, sr, a, warm, n, want_phase, i + 1, w, ni, nq, out) }
    else {
      let v = if want_phase { atan2(nq, ni) } else { sqrt(ni * ni + nq * nq) }
      demod_fill(xs, freq, sr, a, warm, n, want_phase, i + 1, w + 1, ni, nq, list_set(out, w, v))
    }
  }
}
fn demod_column(xs, freq: Int, sr: Int, a: Float, warm: Int, want_phase) with Memory + Alloc = {
  let n = len(xs)
  demod_fill(xs, freq, sr, a, warm, n, want_phase, 0, 0, 0.0, 0.0, make_list(n - warm))
}
fn demod_columns_loop(xs, freqs, sr: Int, a: Float, warm: Int, want_phase, nf: Int, out, fi: Int) with Memory + Alloc = {
  if fi >= nf { out }
  else {
    let col = demod_column(xs, list_index(freqs, fi), sr, a, warm, want_phase)
    demod_columns_loop(xs, freqs, sr, a, warm, want_phase, nf, list_set(out, fi, col), fi + 1)
  }
}
fn demod_columns(xs, freqs, sr: Int, a: Float, warm: Int, want_phase) with Memory + Alloc =
  demod_columns_loop(xs, freqs, sr, a, warm, want_phase, len(freqs), make_list(len(freqs)), 0)
fn pac_comodulogram(xs, sr: Int, low_freqs, high_freqs, a: Float, warm: Int) with Memory + Alloc = {
  let low_cols = demod_columns(xs, low_freqs, sr, a, warm, true)
  let high_cols = demod_columns(xs, high_freqs, sr, a, warm, false)
  fill_matrix(low_cols, high_cols, len(low_freqs), len(high_freqs), make_list(len(low_freqs)), 0)
}

fn main() with Memory + Alloc + WASI = {
  let signal = read_recording("/tmp/mentl-signal-recording.txt")
  let matrix = pac_comodulogram(signal, 512, [4, 6, 8, 10], [30, 40, 50, 60], 0.15, 256)
  let flat = comodulogram_argmax(matrix, 4, 4)
  if flat == 10 { 42 } else { flat }
}
