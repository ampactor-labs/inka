// Minimal repro: a single wide (Float-accumulator) recursive fn that calls
// atan2 in its loop. Every param/accumulator is annotated `: Float` / `: Int`,
// and atan2/atan/atan_series in math.mn are themselves fully annotated. Linked
// with math ONLY. It STILL traps `call stack exhausted` in wf$atan_series — the
// fully-annotated math series fn recursing infinitely through its wide-face
// wrapper. Not the monomorphization floor (nothing is unannotated); a
// wide-face-wrapper / static-closure table-resolution defect.
fn phase_sum(i: Int, n: Int, acc: Float) -> Float with Pure = {
  if i >= n { acc }
  else {
    let t = float_of_int(i) / 64.0
    let re = cos(t)
    let im = sin(t)
    phase_sum(i + 1, n, acc + atan2(im, re))
  }
}
fn main() = {
  let s = phase_sum(0, 200, 0.0)
  if s > 0.0 - 1000.0 { 42 } else { 1 }
}
