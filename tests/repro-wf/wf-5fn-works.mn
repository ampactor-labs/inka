// Repro (math-only, inline signal, NO cfc, NO file I/O): a modest set of
// FULLY-ANNOTATED wide (Float-accumulator) recursive fns computing a small
// demodulation comodulogram. Every float param/accumulator is annotated, and
// math.mn's cos/sin/sqrt/atan2/*_series are themselves fully annotated. It STILL
// traps `call stack exhausted` inside a fully-annotated math series fn recursing
// through its wide-face wrapper. A single wide fn calling atan2 (see minrepro.mn)
// runs fine — the trap appears only once enough wide fns are present, i.e. it is
// a wide-face-wrapper / static-closure table-index resolution defect that scales
// with the wide-fn count, NOT the monomorphization floor (nothing is unannotated).

fn sig_at(n: Int, sr: Int) -> Float with Pure = {
  let t = float_of_int(n) / float_of_int(sr)
  let low = cos(two_pi() * 8.0 * t)
  0.5 * low + (1.0 + 0.8 * low) * sin(two_pi() * 50.0 * t) + 0.1 * sin(two_pi() * 13.0 * t)
}
fn build(out, i: Int, n: Int, sr: Int) with Memory = {
  if i >= n { out } else { build(list_set(out, i, sig_at(i, sr)), i + 1, n, sr) }
}

fn demod_fill(xs, freq: Int, sr: Int, a: Float, warm: Int, n: Int, want_phase, i: Int, w: Int, i_st: Float, q_st: Float, out) with Memory = {
  if i >= n { out }
  else {
    let th = two_pi() * float_of_int(freq) * float_of_int(i) / float_of_int(sr)
    let ni = a * (xs[i] * cos(th)) + (1.0 - a) * i_st
    let nq = a * (xs[i] * sin(th)) + (1.0 - a) * q_st
    if i < warm { demod_fill(xs, freq, sr, a, warm, n, want_phase, i + 1, w, ni, nq, out) }
    else {
      let v = if want_phase { atan2(nq, ni) } else { sqrt(ni * ni + nq * nq) }
      demod_fill(xs, freq, sr, a, warm, n, want_phase, i + 1, w + 1, ni, nq, list_set(out, w, v))
    }
  }
}
fn demod_column(xs, freq: Int, sr: Int, a: Float, warm: Int, want_phase) with Memory + Alloc = {
  let n = len(xs)
  demod_fill(xs, freq, sr, a, warm, n, want_phase, 0, 0, 0.0, 0.0, make_list(n - warm))
}
fn mvl_loop(ph, am, i: Int, n: Int, sc: Float, ss: Float) -> Float with Memory = {
  if i >= n { sqrt(sc * sc + ss * ss) / float_of_int(n) }
  else { mvl_loop(ph, am, i + 1, n, sc + list_index(am, i) * cos(list_index(ph, i)), ss + list_index(am, i) * sin(list_index(ph, i))) }
}

fn main() with Memory + Alloc = {
  let sig = build(make_list(1024), 0, 1024, 512)
  let phase = demod_column(sig, 8, 512, 0.15, 128, true)
  let amp = demod_column(sig, 50, 512, 0.15, 128, false)
  let coupling = mvl_loop(phase, amp, 0, len(phase), 0.0, 0.0)
  if coupling > 0.05 { 42 } else { 1 }
}
