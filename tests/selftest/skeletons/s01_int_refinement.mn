// selftest-shape: int-refinement
// selftest-expect: clean-run
// An Int hole narrowed by a refinement to exactly one survivor. Synthesis
// seeds 0, 1, -1; the `0 < self` predicate rejects 0 and -1, so the medium
// fills `1` with no guess. main returns choose() -> exit 1.

type Positive = Int where 0 < self

fn choose() -> Positive with Pure = ??

fn main() = choose()
